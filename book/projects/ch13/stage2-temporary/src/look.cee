/// What the program was asked to do.
struct Config<region r> {
    query: StringView<r>;
    path: StringView<r>;
    ignoreCase: bool;
}

/// The ways a run can fail.
enum LookError {
    MissingQuery,
    MissingPath,
    NotUtf8,
    @from Io(IoError),
    @from Memory(AllocError),
}

/// The configuration, from the program's arguments and its environment.
fn configure() -> Result<Config<static>, LookError> {
    let query = match (Process.argument(1)) {
        Some(text) => text,
        null => { return Err(LookError.MissingQuery); }
    };
    let path = match (Process.argument(2)) {
        Some(text) => text,
        null => { return Err(LookError.MissingPath); }
    };
    let ignoreCase = Environment.variable("LOOKFOR_IGNORE_CASE").isSome();
    return Ok(Config { query: query, path: path, ignoreCase: ignoreCase });
}

/// The whole file's bytes.
fn readAll(path: StringView) -> Result<Vector<u8>, LookError> {
    var file = File.open(path)?;
    var bytes = Vector<u8>.create();
    var buffer = [0u8; 4096];
    loop {
        let n = file.read(mut buffer[..])?;
        if (n == 0) {
            break;
        }
        bytes.extend(buffer[0..n])?;
    }
    return Ok(bytes);
}

/// Whether `line` contains `query`, taking `A` to `Z` and `a` to `z` as the same letters.
fn containsIgnoreCase(line: StringView, query: StringView) -> bool {
    if (query.length > line.length) {
        return false;
    }
    let bytes = line.bytes();
    for (start in 0..line.length - query.length + 1) {
        if (bytes[start..start + query.length].equalsIgnoreAsciiCase(query.bytes())) {
            return true;
        }
    }
    return false;
}

/// The lines of a text that a test accepts, one at a time.
struct Matches<region r> {
    lines: TextSplit<r>;
    matches: borrow(r) fn(StringView) -> bool;
}

impl<region r> Matches<r> {
    /// The next line that the test accepts, or null when the text has no more.
    fn next(borrow mut this) -> StringView<r>? {
        loop {
            match (this.lines.next()) {
                Some(line) => {
                    if (this.matches(line)) {
                        return line;
                    }
                }
                null => { return null; }
            }
        }
    }
}

/// The lines of `text` that `matches` accepts, in order.
fn search<region r>(text: StringView<r>, matches: borrow(r) fn(StringView) -> bool) -> Matches<r> {
    return Matches { lines: text.split("\n"), matches: matches };
}

/// Reads the file, searches it and prints the lines found. The result is how many lines it printed.
fn run(config: borrow Config) -> Result<usize, LookError> {
    let bytes = readAll(config.path)?;
    let text = match (StringView.fromUtf8(bytes.view())) {
        Some(text) => text,
        null => { return Err(LookError.NotUtf8); }
    };
    let found = if (config.ignoreCase) {
        search(text, (line) => containsIgnoreCase(line, config.query))
    } else {
        search(text, (line) => line.contains(config.query))
    };
    var count: usize = 0;
    for (line in found) {
        Console.writeLine(line);
        count += 1;
    }
    return Ok(count);
}

@test
fn findsOneLine() -> Result<void, TestFailure> {
    let text = "one fish\ntwo fish\nred herring\n";
    var found = search(text, (line) => line.contains("red"));
    Check.equalText("red herring", found.next() ?? "")?;
    Check.isTrue(found.next().isNull(), "one line only")?;
    return Ok();
}

@test
fn caseMatters() -> Result<void, TestFailure> {
    let text = "Red sky\nred herring\nblue moon\n";
    var found = search(text, (line) => line.contains("red"));
    Check.equalText("red herring", found.next() ?? "")?;
    Check.isTrue(found.next().isNull(), "one line only")?;
    return Ok();
}

@test
fn caseIgnored() -> Result<void, TestFailure> {
    let text = "Red sky\nred herring\nblue moon\n";
    var found = search(text, (line) => containsIgnoreCase(line, "rEd"));
    Check.equalText("Red sky", found.next() ?? "")?;
    Check.equalText("red herring", found.next() ?? "")?;
    Check.isTrue(found.next().isNull(), "two lines only")?;
    return Ok();
}
