interface Shape {
    fn area(borrow this) -> u64;
    fn grow(borrow mut this, by: u64);
}

struct Square {
    side: u64;
}

struct Rect {
    w: u64;
    h: u64;
}

impl Shape for Square {
    fn area(borrow this) -> u64 => this.side * this.side;
    fn grow(borrow mut this, by: u64) {
        this.side += by;
    }
}

impl Shape for Rect {
    fn area(borrow this) -> u64 => this.w * this.h;
    fn grow(borrow mut this, by: u64) {
        this.w += by;
    }
}

fn total(shapes: borrow Vector<Box<dyn Shape>>) -> u64 {
    var sum: u64 = 0;
    for (shape in shapes) {
        sum += shape.area();
    }
    return sum;
}

fn main() {
    var shapes = Vector<Box<dyn Shape>>.create();
    var seed: u64 = 12345;
    var first: usize = 0;
    var found = false;
    for (i in 0..1000u64) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        if (seed / 65536 % 2 == 0) {
            if (!found) {
                first = shapes.length;
                found = true;
            }
            shapes.push(Box.create(Square { side: i % 7 })!)!;
        } else {
            shapes.push(Box.create(Rect { w: i % 5, h: 3 })!)!;
        }
    }
    var sum: u64 = 0;
    for (pass in 0..200000u64) {
        sum += total(shapes);
        shapes[first].grow(pass % 2);
    }
    Console.writeLine(sum);
}
