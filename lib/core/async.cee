// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Async tasks in every profile (type-system.md §40.4, ADR 0031, ADR 0039): errors, timers, cancellation, the joins of
// Async.race and Async.all, and AsyncSignal, over the executor's ceesafe_async_* (runtime/hosted/ceesafe_rt_async.c).
// In the freestanding profile the executor runs over its environment's hooks (ceesafe_env_*, profiles.md §4.2), so
// what waits here waits there too. I/O for tasks is lib/std's (hosted only).

extern "C" {
    @effects()
    fn ceesafe_async_now() -> u64;
    @effects()
    fn ceesafe_async_wait_until(deadline: u64);
    @effects()
    fn ceesafe_async_status() -> u32;
    @effects()
    fn ceesafe_async_shield_enter(ms: u64);
    @effects()
    fn ceesafe_async_shield_leave();
    @effects()
    fn ceesafe_async_signal_take(signal: *mut void) -> bool;
    @effects()
    fn ceesafe_async_signal_forget(signal: *mut void);
    @effects()
    fn ceesafe_async_signal_raise(signal: *mut void);
    @effects()
    fn ceesafe_async_set_init(set: *mut void, limit: u32, error: *mut void);
    @effects()
    fn ceesafe_async_set_admit(set: *mut void, wait: bool) -> u32;
    @effects()
    fn ceesafe_async_set_done(set: *mut void) -> bool;
    @effects()
    fn ceesafe_async_set_cancel(set: *mut void);
    @effects()
    fn ceesafe_async_set_oom(set: *mut void) -> bool;
}

/// Why an async operation failed (type-system.md §40.4, §40.7).
public enum AsyncError {
    Cancelled,
    TimedOut,
    Io(IoError),
}

/// Time for tasks: the monotonic clock in milliseconds.
public struct Timer {
    /// Milliseconds on the monotonic clock, from an arbitrary start.
    /// Safety: ceesafe_async_now only reads the clock.
    public fn now() -> u64 => unsafe { ceesafe_async_now() };

    /// Waits at least `ms` milliseconds without blocking the thread: other tasks run meanwhile.
    /// Safety: ceesafe_async_wait_until only records the deadline for the executor.
    /// A cancelled task's sleep returns `Err(AsyncError.Cancelled)` at once (type-system.md §40.7).
    public async fn sleep(ms: u64) -> Result<void, AsyncError> {
        let start = Timer.now();
        let deadline = if (ms > 0xFFFFFFFFFFFFFFFF - start) 0xFFFFFFFFFFFFFFFF else start + ms;
        loop {
            AsyncLeaf.status()?;
            if (Timer.now() >= deadline) {
                return Ok();
            }
            unsafe { ceesafe_async_wait_until(deadline); }
            await Async.park();
        }
    }
}

/// What `Async.isCancelled()` and `Async.checkpoint(cancelled)` call (type-system.md §40.4).
public struct AsyncControl<E> {
    /// Whether the current task is cancelled and not shielded.
    /// Safety: ceesafe_async_status only reads the executor's state.
    public fn isCancelled() -> bool => unsafe { ceesafe_async_status() } == 1;

    /// `Async.shield`'s start (type-system.md §40.7).
    /// Safety: it only counts the current task's shields.
    public fn enterShield(ms: u64) {
        unsafe { ceesafe_async_shield_enter(ms); }
    }

    /// `Async.shield`'s end.
    /// Safety: it only counts the current task's shields, after enterShield.
    public fn leaveShield() {
        unsafe { ceesafe_async_shield_leave(); }
    }

    /// `Err(cancelled)` if the current task is cancelled and not shielded, else `Ok`.
    public fn checkpoint(cancelled: E) -> Result<void, E> {
        if (AsyncControl<E>.isCancelled()) {
            return Err(cancelled);
        }
        return Ok();
    }
}

/// The library's own steps for its waiting operations: not for programs (type-system.md §40.4).
public struct AsyncLeaf {
    /// Err(Cancelled) if the current task is cancelled, Err(TimedOut) if its shield's time is up (type-system.md §40.7).
    /// Safety: ceesafe_async_status only reads the executor's state.
    public fn status() -> Result<void, AsyncError> {
        let status = unsafe { ceesafe_async_status() };
        if (status == 1) {
            return Err(AsyncError.Cancelled);
        }
        if (status == 2) {
            return Err(AsyncError.TimedOut);
        }
        return Ok();
    }
}

/// `Async.race`'s result (type-system.md §40.4): the child that returned `Ok` first (0 or 1), its value, and the
/// other's value if it also returned `Ok` before it saw its cancellation.
public struct Raced<T> {
    public winner: u32;
    public value: T;
    public other: T?;
}

/// What `Async.race` returns once both children have: `first` is the one that returned first, which decides.
struct AsyncRaceJoin<T, E> {
    fn settle(first: u32, a: Result<T, E>, b: Result<T, E>) -> Result<Raced<T>, E> {
        if (first == 0) {
            return AsyncRaceJoin<T, E>.decide(0, a, b);
        }
        return AsyncRaceJoin<T, E>.decide(1, b, a);
    }

    fn decide(index: u32, early: Result<T, E>, late: Result<T, E>) -> Result<Raced<T>, E> {
        match (early) {
            Ok(value) => {
                let other: T? = match (late) {
                    Ok(w) => Some(w),
                    Err(_) => null,
                };
                return Ok(Raced { winner: index, value: value, other: other });
            }
            Err(e) => { return Err(e); }
        }
    }
}

/// `Async.timeout` and `Async.deadline` (type-system.md §40.4, ADR 0046): the deadline, the deadline child (the join's
/// second, beside the body), and the result once both have returned.
struct AsyncTimeoutJoin<T, E> {
    /// The deadline `ms` milliseconds from now, saturated.
    fn after(ms: u64) -> u64 {
        let start = Timer.now();
        return if (ms > 0xFFFFFFFFFFFFFFFF - start) 0xFFFFFFFFFFFFFFFF else start + ms;
    }

    /// Returns `Ok` once the clock reaches `at`, or `Err(Cancelled)` if the task is cancelled first: the body
    /// returned, or the caller was cancelled.
    /// Safety: ceesafe_async_wait_until only records the deadline for the executor.
    async fn until(at: u64) -> Result<void, AsyncError> {
        loop {
            AsyncLeaf.status()?;
            if (Timer.now() >= at) {
                return Ok();
            }
            unsafe { ceesafe_async_wait_until(at); }
            await Async.park();
        }
    }

    /// The body decides when it returned first, or when the deadline child did not reach the deadline (the caller was
    /// cancelled). After the deadline, a late `Ok` is kept and any `Err` is `timedOut` (ADR 0046 §3.2).
    fn settle(first: u32, body: Result<T, E>, deadline: Result<void, AsyncError>, timedOut: E) -> Result<T, E> {
        if (first == 0) {
            return body;
        }
        // No `Ok` payload is bound, so T may be void (bug B6: `Ok(value)` was invalid for Result<void, E>).
        let reached = match (deadline) {
            Ok() => true,
            Err(_) => false,
        };
        let failed = match (body) {
            Err(_) => true,
            _ => false,
        };
        if (reached && failed) {
            return Err(timedOut);
        }
        return body;
    }
}

/// What `Async.all` returns once both children have: the first error in the order they returned, else `Ok`.
struct AsyncAllJoin<E> {
    fn settle(first: u32, a: Result<void, E>, b: Result<void, E>) -> Result<void, E> {
        if (first == 0) {
            return AsyncAllJoin<E>.decide(a, b);
        }
        return AsyncAllJoin<E>.decide(b, a);
    }

    fn decide(early: Result<void, E>, late: Result<void, E>) -> Result<void, E> {
        match (early) {
            Err(e) => { return Err(e); }
            Ok() => { return late; }
        }
    }
}

/// A task set's record (ADR 0053 §3.4): the runtime's ceesafe_task_set, then the slot where a child's first error is
/// copied. It lives in the frame of AsyncTasks.run's task, which never moves.
struct TaskSetRecord<E> {
    words: [u64; 12];
    first: Result<void, E>;
}

/// The set `Async.tasks`' body is given (ADR 0053 §3.1). The body, and the functions it passes the set to, start
/// children with `await set.spawn(async move () => …)`, which waits while the set's limit of children run, and
/// `set.trySpawn(async move () => …)`, which is false instead. A child owns what it captures: no loans, so it cannot
/// capture the set (N0349). The calls are the checker's (src/check/async.cee): these are the steps it joins.
@noncopy // the one handle of its record
public struct TaskSet<E: Copy> {
    private record: *mut void;
    private oom: E;

    /// Waits until a child may start: 0, or 2 once the set or this task is cancelled (the child is then not started).
    /// Safety: the record outlives the set, which the body holds by borrow while AsyncTasks.run waits for it.
    async fn room(borrow this) -> u32 {
        loop {
            let admitted = unsafe { ceesafe_async_set_admit(this.record, true) };
            if (admitted != 1) {
                return admitted;
            }
            await Async.park(); // a returning child wakes this task
        }
    }

    /// 0 if a child may start now, 1 while the limit run, 2 once cancelled.
    /// Safety: as room.
    fn tryRoom(borrow this) -> u32 => unsafe { ceesafe_async_set_admit(this.record, false) };

    fn recordOf(borrow this) -> *mut void => this.record;

    /// `spawn`'s result for the start's code: 0 started; else (full and cancelled, or no frame) `Err(oom)`.
    async fn spawned(borrow this, code: u32) -> Result<void, E> {
        if (code == 0) {
            return Ok();
        }
        return Err(this.oom);
    }

    /// `trySpawn`'s result: whether the child started.
    fn started(borrow this, code: u32) -> bool => code == 0;
}

/// `await Async.tasks(limit, oom, async (set) => …)` (ADR 0053): `Async.tasksIn` with the system heap.
public struct AsyncTasks<E: Copy> {
    @effectsOf(body)
    public async fn run(
        limit: u32,
        oom: E,
        body: borrow mut fn(borrow TaskSet<E>) -> Result<void, E>,
    ) -> Result<void, E> => await AsyncTasksIn<E, SystemHeap>.run(SystemHeap {}, limit, oom, body);
}

/// `await Async.tasksIn(alloc, limit, oom, async (set) => …)` (ADR 0053): the body runs in the awaiting task, as the
/// set's owner, with the set; then every child it started is waited for. The children's tasks and frames come from
/// `alloc`'s allocator type. The result is the body's error, else the first child's, else `oom` if a child's frame
/// could not be allocated, else Ok. The body's error cancels the children; a child's error cancels no sibling.
public struct AsyncTasksIn<E: Copy, A> {
    /// Safety: the record is this frame's, which outlives every child: the set waits for them before it returns.
    @effectsOf(body)
    public async fn run(
        alloc: A,
        limit: u32,
        oom: E,
        body: borrow mut fn(borrow TaskSet<E>) -> Result<void, E>,
    ) -> Result<void, E> {
        var record = TaskSetRecord<E> { words: [0u64; 12], first: Ok() };
        let raw = borrow mut record.words as *mut [u64; 12] as *mut void;
        unsafe { ceesafe_async_set_init(raw, limit, borrow mut record.first as *mut Result<void, E> as *mut void); }
        Async.setAllocator(raw, alloc); // the children's frames from A's adapters (c-backend.md §3a)
        let set = TaskSet<E> { record: raw, oom: oom };
        let result = body(borrow set);
        match (result) {
            Err(_) => { unsafe { ceesafe_async_set_cancel(raw); } }
            Ok() => {}
        }
        while (!unsafe { ceesafe_async_set_done(raw) }) {
            await Async.park(); // the last child wakes this task
        }
        match (result) {
            Err(e) => { return Err(e); }
            Ok() => {}
        }
        match (record.first) {
            Err(e) => { return Err(e); }
            Ok() => {}
        }
        if (unsafe { ceesafe_async_set_oom(raw) }) {
            return Err(oom);
        }
        return Ok();
    }
}

/// A one-shot wake-up from anywhere, to a task (ADR 0039): `await signal.wait()` parks the task until `signal.raise()`.
/// `raise` has no effects, so an interrupt handler (`@context(irq)`) or another thread may call it, the way a driver
/// tells the task waiting for its device. A raise before the wait is kept: the wait then returns at once. One task
/// waits on a signal at a time.
@noncopy // one signal, shared: a copy would never be raised
public struct AsyncSignal {
    private words: [u64; 4]; // the runtime's record: raised, the waiting task, its executor, a raise in progress

    /// A signal not raised.
    public fn create() -> AsyncSignal => AsyncSignal { words: [0u64; 4] };

    /// The same as create, in a static's initialiser (type-system.md §39.4): `static READY: AsyncSignal =
    /// AsyncSignal.constant();`, which an interrupt handler can raise.
    @constant
    public fn constant() -> AsyncSignal => AsyncSignal { words: [0u64; 4] };

    /// Raises the signal: the task waiting on it, if any, runs again.
    /// Safety: the runtime changes the record atomically, and only wakes the task it names.
    @effects()
    public fn raise(borrow this) {
        unsafe { ceesafe_async_signal_raise(this.record()); }
    }

    /// Waits until the signal is raised, then lowers it. A cancelled task returns `Err(AsyncError.Cancelled)` and no
    /// longer waits (type-system.md §40.7).
    /// Safety: the record names this task only while it waits here; ceesafe_async_signal_forget takes it out.
    public async fn wait(borrow this) -> Result<void, AsyncError> {
        loop {
            match (AsyncLeaf.status()) {
                Ok() => {}
                Err(e) => {
                    unsafe { ceesafe_async_signal_forget(this.record()); }
                    return Err(e);
                }
            }
            if (unsafe { ceesafe_async_signal_take(this.record()) }) {
                return Ok();
            }
            await Async.park();
        }
    }

    fn record(borrow this) -> *mut void => borrow this.words as *[u64; 4] as *mut [u64; 4] as *mut void;
}
