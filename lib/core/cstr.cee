// lib/core: C strings (ADR 0087 §2.4, type-system.md §22.3). `c"…"` is a `CStr<static>`; `CStr.fromBytesWithNul`
// makes one from bytes that end in their only NUL. Bundled with ceesafec and part of every package.

/// A view of UTF-8 text with a NUL byte after its end, valid for region `r` as a `StringView<r>` is: what a C
/// function taking a `const char *` needs. Copy; a field of this type needs a region parameter, as a view's does.
public struct CStr<region r> {
    private text: StringView<r>; // the text, without the NUL
    private bytes: Slice<r, u8>; // the text and its NUL, which is its only one

    /// Bytes ending in a NUL that is their only one, as valid UTF-8 text before it; else null.
    public fn fromBytesWithNul(b: Slice<r, u8>) -> CStr<r>? {
        if (b.length == 0 || b[b.length - 1] != 0) {
            return null;
        }
        for (k in 0..(b.length - 1)) {
            if (b[k] == 0) {
                return null;
            }
        }
        return match (StringView.fromUtf8(b[..(b.length - 1)])) {
            Some(text) => CStr { text: text, bytes: b },
            null => null,
        };
    }

    /// The C string at `p` (ADR 0122): the bytes up to its first NUL, counted here, when they are UTF-8 text; else
    /// null. A null `p` gives null too.
    /// Safety: `p` is null, or points to bytes that end in a NUL and that are neither changed nor freed while the
    /// result, or a view taken from it, is used.
    public unsafe fn fromPtr(p: *CChar) -> CStr<r>? {
        if (p.isNull()) {
            return null;
        }
        let start = p as *u8;
        var n: usize = 0;
        while (unsafe { start.add(n).read() } != 0) {
            n += 1;
        }
        let b: Slice<r, u8> = unsafe { Slice.fromRaw(start, n + 1) };
        return match (StringView.fromUtf8(b[..n])) {
            Some(text) => CStr { text: text, bytes: b },
            null => null,
        };
    }

    /// The address of the first byte, for C: the text is followed by its NUL.
    public fn ptr(borrow this) -> *CChar => this.bytes.ptr as *CChar;

    /// The text, without the NUL.
    public fn view(borrow this) -> StringView<r> => this.text;

    /// The text's length in bytes, without the NUL.
    public fn length(borrow this) -> usize => this.text.length;

    /// The text and its NUL: `length + 1` bytes.
    public fn bytesWithNul(borrow this) -> Slice<r, u8> => this.bytes;
}
