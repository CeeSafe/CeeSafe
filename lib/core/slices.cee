// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// lib/core: methods of slices and vectors that take closures (type-system.md §36.4). Bundled with ceesafec and part of
// every package. `s.sortBy(cmp)` is `SliceAlgorithms<T>.sortBy(s, cmp)`, and so on; `v.retain(keep)` is
// `SliceAlgorithms<T>.retain` on the vector's elements, then `v.truncate` to the count it returns.

/// The two parts of a slice that `splitAt` divides (type-system.md §16.5): the elements before the split, and from it on.
public struct SliceHalves<region r, T> {
    public left: Slice<r, T>;
    public right: Slice<r, T>;
}

/// The two parts of a mutable slice that `splitAtMut` divides: disjoint, so both may be written at once.
public struct SliceHalvesMut<region r, T> {
    public left: SliceMut<r, T>;
    public right: SliceMut<r, T>;
}

/// Splitting a slice in two (type-system.md §16.5): `s.splitAt(mid)` is `SliceSplitting<T>.splitAt(s, mid)`. The
/// struct's region ties the halves to the slice they come from; it has no fields and is never made.
public struct SliceSplitting<region r, T> {
    /// The elements before `mid`, and from `mid` on; panics if `mid` is past the end.
    public fn splitAt(s: Slice<r, T>, mid: usize) -> SliceHalves<r, T> =>
        SliceHalves { left: s[..mid], right: s[mid..] };

    /// As splitAt, for a mutable slice: two mutable slices that do not overlap.
    /// Safety: slicing `s[mid..]` checks `mid` against the length (it panics past the end), so `[0, mid)` and
    /// `[mid, length)` are inside `s` and disjoint, and each is lent for as long as `s` is.
    public fn splitAtMut(s: SliceMut<r, T>, mid: usize) -> SliceHalvesMut<r, T> {
        let length = s.length;
        let tail = s[mid..].length;
        let start = s.ptr as *mut T;
        return SliceHalvesMut {
            left: unsafe { SliceMut.fromRaw(start, length - tail) },
            right: unsafe { SliceMut.fromRaw(start.add(length - tail), tail) },
        };
    }
}

/// The algorithms over a slice of `T`, as static functions: the struct has no fields and is never made.
public struct SliceAlgorithms<T> {
    /// Orders `s` so that `cmp` of each element and the next is at most zero, for a consistent `cmp`. Not stable.
    /// An introsort (ADR 0057): quicksort with a median-of-three pivot and a partition without a branch on `cmp`'s
    /// result, the elements equal to an earlier pivot set aside at once, insertion sort for short runs, and heapsort
    /// past a depth of 2·log₂ n, so O(n log n) calls of `cmp` in the worst case. A slice that is one ascending run is
    /// left as it is, and one strictly descending run is reversed. Allocates nothing; the shorter side is sorted
    /// first, so at most 64 ranges wait. An inconsistent `cmp` leaves some permutation of `s`.
    @effectsOf(cmp)
    public fn sortBy(s: SliceMut<T>, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        let length = s.length;
        if (length < 2) {
            return;
        }
        // One run from the start: ascending is sorted already, strictly descending is sorted by reversing it.
        var run: usize = 1;
        if (cmp(borrow s[1], borrow s[0]) < 0) {
            while (run < length && cmp(borrow s[run], borrow s[run - 1]) < 0) {
                run += 1;
            }
            if (run == length) {
                var i: usize = 0;
                while (i < length / 2) {
                    s.swap(i, length - 1 - i);
                    i += 1;
                }
                return;
            }
        } else {
            while (run < length && cmp(borrow s[run], borrow s[run - 1]) >= 0) {
                run += 1;
            }
            if (run == length) {
                return;
            }
        }
        var depth: u32 = 0;
        var n = length;
        while (n > 1) {
            depth += 2;
            n = n >> 1;
        }
        SliceAlgorithms<T>.introsort(s, 0, length, depth, cmp);
    }

    /// Sorts `s[lo..hi]`, with `depth` partitions left before heapsort takes over. Iterative, so that an async
    /// instance's frame has a size (ADR 0037 §3.7): the longer side of each partition waits while the shorter is
    /// sorted, the order the recursion had, so at most log₂ n ranges wait at once (64 for any length).
    /// Every range but one starting at 0 starts just after an earlier pivot, which is at most each of its elements:
    /// when the new pivot is not above that one, the elements not above the pivot all equal it, and are done.
    @effectsOf(cmp)
    fn introsort(s: SliceMut<T>, lo: usize, hi: usize, depth: u32, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        var lows = [0usize; 64];
        var highs = [0usize; 64];
        var depths = [0u32; 64];
        var waiting: usize = 0;
        var low = lo;
        var high = hi;
        var left = depth;
        loop {
            while (high - low > 16) {
                if (left == 0) {
                    SliceAlgorithms<T>.heapsort(s, low, high, cmp);
                    low = high;
                    break;
                }
                left -= 1;
                SliceAlgorithms<T>.pivot(s, low, high, cmp);
                if (low > 0 && cmp(borrow s[low - 1], borrow s[high - 1]) >= 0) {
                    low = SliceAlgorithms<T>.partitionEqual(s, low, high, cmp) + 1;
                    continue;
                }
                let p = SliceAlgorithms<T>.partition(s, low, high, cmp);
                if (p - low < high - p) {
                    lows[waiting] = p + 1;
                    highs[waiting] = high;
                    depths[waiting] = left;
                    high = p;
                } else {
                    lows[waiting] = low;
                    highs[waiting] = p;
                    depths[waiting] = left;
                    low = p + 1;
                }
                waiting += 1;
            }
            SliceAlgorithms<T>.insertion(s, low, high, cmp);
            if (waiting == 0) {
                return;
            }
            waiting -= 1;
            low = lows[waiting];
            high = highs[waiting];
            left = depths[waiting];
        }
    }

    /// Moves the median of `s[lo]`, the middle element and `s[hi - 1]` to `s[hi - 1]`, the pivot's place while
    /// partitioning (`s[lo..hi]` has at least 3 elements).
    @effectsOf(cmp)
    fn pivot(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        let last = hi - 1;
        let mid = lo + (hi - lo) / 2;
        if (cmp(borrow s[mid], borrow s[lo]) < 0) { s.swap(mid, lo); }
        if (cmp(borrow s[last], borrow s[mid]) < 0) {
            s.swap(last, mid);
            if (cmp(borrow s[mid], borrow s[lo]) < 0) { s.swap(mid, lo); }
        }
        s.swap(mid, last);
    }

    /// Partitions `s[lo..hi]` around the pivot at `s[hi - 1]`; returns the pivot's index. Everything before it
    /// compares below the pivot, nothing after it does. Without a branch on `cmp`'s result: each element is swapped
    /// with `s[store]` (itself, or one not below the pivot), and `store` advances when it was below.
    @effectsOf(cmp)
    fn partition(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) -> usize {
        let last = hi - 1;
        var store = lo;
        for (i in lo..last) {
            let below: usize = if (cmp(borrow s[i], borrow s[last]) < 0) 1 else 0;
            s.swap(i, store);
            store += below;
        }
        s.swap(store, last);
        return store;
    }

    /// As partition, with the elements not above the pivot before it.
    @effectsOf(cmp)
    fn partitionEqual(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) -> usize {
        let last = hi - 1;
        var store = lo;
        for (i in lo..last) {
            let notAbove: usize = if (cmp(borrow s[last], borrow s[i]) >= 0) 1 else 0;
            s.swap(i, store);
            store += notAbove;
        }
        s.swap(store, last);
        return store;
    }

    /// Insertion sort of `s[lo..hi]`, by adjacent swaps.
    @effectsOf(cmp)
    fn insertion(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        for (i in lo + 1..hi) {
            var j = i;
            while (j > lo && cmp(borrow s[j], borrow s[j - 1]) < 0) {
                s.swap(j, j - 1);
                j -= 1;
            }
        }
    }

    /// Heapsort of `s[lo..hi]`: a max-heap, then the largest moved to the end, one at a time.
    @effectsOf(cmp)
    fn heapsort(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        let n = hi - lo;
        var start = n / 2;
        while (start > 0) {
            start -= 1;
            SliceAlgorithms<T>.siftDown(s, lo, start, n, cmp);
        }
        var end = n;
        while (end > 1) {
            end -= 1;
            s.swap(lo, lo + end);
            SliceAlgorithms<T>.siftDown(s, lo, 0, end, cmp);
        }
    }

    /// Restores the heap property below `root` in the heap `s[base..base + n]`.
    @effectsOf(cmp)
    fn siftDown(s: SliceMut<T>, base: usize, root: usize, n: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        var parent = root;
        while (2 * parent + 1 < n) {
            var child = 2 * parent + 1;
            if (child + 1 < n && cmp(borrow s[base + child], borrow s[base + child + 1]) < 0) {
                child += 1;
            }
            if (cmp(borrow s[base + parent], borrow s[base + child]) >= 0) {
                return;
            }
            s.swap(base + parent, base + child);
            parent = child;
        }
    }

    /// Calls `visit` on each element, in index order.
    @effectsOf(visit)
    public fn forEach(s: Slice<T>, visit: borrow mut fn(borrow T)) {
        for (i in 0..s.length) { visit(borrow s[i]); }
    }

    /// Does `test` return true for some element? Stops at the first that does.
    @effectsOf(test)
    public fn any(s: Slice<T>, test: borrow mut fn(borrow T) -> bool) -> bool {
        for (i in 0..s.length) {
            if (test(borrow s[i])) { return true; }
        }
        return false;
    }

    /// Does `test` return true for every element? Stops at the first that does not.
    @effectsOf(test)
    public fn all(s: Slice<T>, test: borrow mut fn(borrow T) -> bool) -> bool {
        for (i in 0..s.length) {
            if (!test(borrow s[i])) { return false; }
        }
        return true;
    }

    /// Moves the elements for which `keep` returns true to the front, in order, calling it once on each element in
    /// index order; returns how many there are. `v.retain(keep)` then truncates the vector to that length.
    @effectsOf(keep)
    public fn retain(s: SliceMut<T>, keep: borrow mut fn(borrow T) -> bool) -> usize {
        var kept: usize = 0;
        for (i in 0..s.length) {
            if (keep(borrow s[i])) {
                s.swap(kept, i);
                kept += 1;
            }
        }
        return kept;
    }
}

/// `v.insert(at, x)`, `v.remove(at)` and `v.swapRemove(at)` (ADR 0075 §2.12). The index is checked at the call, so a
/// panic names the program's line: `at <= length` for `insert`, `at < length` for the others. The elements move by
/// `swap`, so they may be of any type. A vector's allocator is `SystemHeap` or `FailingAllocator` (type-system.md
/// §23.1); the `…Failing` functions are the latter's.
public struct VectorEditing<T> {
    /// Puts `x` at `at`, moving the elements from `at` on one place up. O(length - at). If growing fails, `v` is
    /// unchanged and `x` is destroyed.
    public fn insert(v: borrow mut Vector<T>, at: usize, x: T) -> Result<void, AllocError> {
        v.push(x)?;
        let s = v.viewMut();
        var i = s.length - 1;
        while (i > at) {
            s.swap(i, i - 1);
            i -= 1;
        }
        return Ok();
    }

    /// Takes the element at `at` out, moving the later elements one place down. O(length - at).
    public fn remove(v: borrow mut Vector<T>, at: usize) -> T {
        let length = v.length;
        {
            let s = v.viewMut();
            var i = at;
            while (i + 1 < length) {
                s.swap(i, i + 1);
                i += 1;
            }
        }
        return v.pop()!;
    }

    /// Takes the element at `at` out and puts the last element in its place. O(1); the order is not kept.
    public fn swapRemove(v: borrow mut Vector<T>, at: usize) -> T {
        let last = v.length - 1;
        {
            let s = v.viewMut();
            s.swap(at, last);
        }
        return v.pop()!;
    }

    /// `insert` for a vector of `FailingAllocator`.
    public fn insertFailing(v: borrow mut Vector<T, FailingAllocator>, at: usize, x: T) -> Result<void, AllocError> {
        v.push(x)?;
        let s = v.viewMut();
        var i = s.length - 1;
        while (i > at) {
            s.swap(i, i - 1);
            i -= 1;
        }
        return Ok();
    }

    /// `remove` for a vector of `FailingAllocator`.
    public fn removeFailing(v: borrow mut Vector<T, FailingAllocator>, at: usize) -> T {
        let length = v.length;
        {
            let s = v.viewMut();
            var i = at;
            while (i + 1 < length) {
                s.swap(i, i + 1);
                i += 1;
            }
        }
        return v.pop()!;
    }

    /// `swapRemove` for a vector of `FailingAllocator`.
    public fn swapRemoveFailing(v: borrow mut Vector<T, FailingAllocator>, at: usize) -> T {
        let last = v.length - 1;
        {
            let s = v.viewMut();
            s.swap(at, last);
        }
        return v.pop()!;
    }
}
