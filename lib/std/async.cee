// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Async I/O (type-system.md §40.4, ADR 0031): console output, sockets and files for tasks, over the hosted runtime's
// ceesafe_async_* (runtime/hosted/ceesafe_rt_async.c). Each one that waits registers what wakes the task, then parks.
// Hosted only. Timers, cancellation, the joins and AsyncSignal are lib/core's async.cee, in every profile (ADR 0039).

extern "C" {
    @effects()
    fn ceesafe_async_wait_writable(fd: i32);
    @effects()
    fn ceesafe_async_write(fd: i32, bytes: *u8, length: u64) -> i64;
    @effects()
    fn ceesafe_async_wait_readable(fd: i32);
    @effects()
    fn ceesafe_async_tcp_listen(address: *u8, length: u64, port: u16) -> i64;
    @effects()
    fn ceesafe_async_tcp_port(fd: i32) -> i64;
    @effects()
    fn ceesafe_async_tcp_accept(fd: i32) -> i64;
    @effects()
    fn ceesafe_async_tcp_connect(address: *u8, length: u64, port: u16) -> i64;
    @effects()
    fn ceesafe_async_tcp_connected(fd: i32) -> i64;
    @effects()
    fn ceesafe_async_read(fd: i32, buffer: *mut u8, length: u64) -> i64;
    @effects()
    fn ceesafe_async_send(fd: i32, bytes: *u8, length: u64) -> i64;
    @effects()
    fn ceesafe_async_shutdown_write(fd: i32) -> i64;
    @effects()
    fn ceesafe_async_close(fd: i32);
    @effects(sleep)
    fn ceesafe_async_poll(fds: *i32, events: *u32, ready: *mut u32, count: u64, timeout: i64) -> i64;
    @effects()
    fn ceesafe_async_op_read(op: *mut void, fd: i32, buffer: *mut u8, length: u64) -> i64;
    @effects()
    fn ceesafe_async_op_send(op: *mut void, fd: i32, bytes: *u8, length: u64) -> i64;
    @effects()
    fn ceesafe_async_op_accept(op: *mut void, fd: i32) -> i64;
    @effects()
    fn ceesafe_async_op_connect(op: *mut void, address: *u8, length: u64, port: u16) -> i64;
    @effects()
    fn ceesafe_async_op_connect_at(op: *mut void, family: u32, bytes: *u8, port: u16, scope: u32) -> i64;
    @effects()
    fn ceesafe_async_tcp_listen_at(family: u32, bytes: *u8, port: u16, scope: u32, backlog: u32, flags: u32) -> i64;
    @effects()
    fn ceesafe_async_tcp_connect_at(family: u32, bytes: *u8, port: u16, scope: u32) -> i64;
    @effects()
    fn ceesafe_async_socket_name(fd: i32, peer: u32, bytes: *mut u8, scope: *mut u32) -> i64;
    @effects()
    fn ceesafe_async_socket_option(fd: i32, option: u32, value: i64) -> i64;
    @effects()
    fn ceesafe_async_shutdown_read(fd: i32) -> i64;
    @effects()
    fn ceesafe_async_op_cancel(op: *mut void) -> bool;
    @effects()
    fn ceesafe_async_msg_part(op: *mut void, index: u32, bytes: *u8, length: u64);
    @effects()
    fn ceesafe_async_op_sendv(op: *mut void, fd: i32, count: u32) -> i64;
    @effects()
    fn ceesafe_async_op_sendfile(op: *mut void, socket: i32, file: *void, offset: u64, length: u64) -> i64;
    @effects()
    fn ceesafe_file_read_at(file: *void, buffer: *mut u8, length: u64, offset: u64) -> i64;
    @effects()
    fn ceesafe_async_udp_bind(
        family: u32,
        bytes: *u8,
        port: u16,
        scope: u32,
        flags: u32,
        sendBuffer: u32,
        receiveBuffer: u32,
    ) -> i64;
    @effects()
    fn ceesafe_async_msg_send_to(
        op: *mut void,
        socketFamily: u32,
        family: u32,
        bytes: *u8,
        port: u16,
        scope: u32,
        fromFamily: u32,
        fromBytes: *u8,
        ecn: u32,
        segment: u32,
    );
    @effects()
    fn ceesafe_async_op_sendmsg(op: *mut void, fd: i32, count: u32) -> i64;
    @effects()
    fn ceesafe_async_op_recvmsg(op: *mut void, fd: i32, buffer: *mut u8, length: u64) -> i64;
    @effects()
    fn ceesafe_async_msg_address(op: *mut void, which: u32, bytes: *mut u8, scope: *mut u32) -> i64;
    @effects()
    fn ceesafe_async_msg_flags(op: *mut void) -> u32;
    @effects()
    fn ceesafe_async_udp_send(
        fd: i32,
        data: *u8,
        length: u64,
        socketFamily: u32,
        family: u32,
        bytes: *u8,
        port: u16,
        scope: u32,
    ) -> i64;
    @effects()
    fn ceesafe_async_udp_recv(
        fd: i32,
        buffer: *mut u8,
        length: u64,
        bytes: *mut u8,
        scope: *mut u32,
        info: *mut u32,
    ) -> i64;
}

/// Console output for tasks: in order with Console's, and never blocking the thread (ADR 0031 §3.5).
public struct AsyncConsole {
    /// Writes `text` to standard output.
    public async fn write(text: StringView) -> Result<void, AsyncError> => await AsyncIo.writeAll(1, text.bytes());

    /// Writes `text` and a newline to standard output.
    public async fn writeLine(text: StringView) -> Result<void, AsyncError> {
        await AsyncIo.writeAll(1, text.bytes())?;
        return await AsyncIo.writeAll(1, "\n".bytes());
    }

    /// Writes `text` to standard error.
    public async fn writeError(text: StringView) -> Result<void, AsyncError> =>
        await AsyncIo.writeAll(2, text.bytes());
}

/// lib/std's own steps for its waiting I/O: not for programs (type-system.md §40.4).
struct AsyncIo {
    /// Writes every byte to `fd`, a step of at most PIPE_BUF bytes whenever it is writable, parking until it is.
    /// Safety: the pointer and length are the slice's, read by the runtime during the call only.
    async fn writeAll(fd: i32, bytes: Slice<u8>) -> Result<void, AsyncError> {
        var done: usize = 0;
        while (done < bytes.length) {
            AsyncLeaf.status()?; // a cancelled task writes no further step (type-system.md §40.7)
            let rest = bytes[done..];
            let written = unsafe { ceesafe_async_write(fd, rest.ptr, rest.length as u64) };
            if (written < 0) {
                return Err(AsyncError.Io(AsyncIo.ioError(written)));
            }
            if (written == 0) {
                unsafe { ceesafe_async_wait_writable(fd); }
                await Async.park();
            } else {
                done += truncate<usize>(written); // 0 < written <= PIPE_BUF
            }
        }
        return Ok();
    }

    /// The IoError for a negated errno (HostServices.hostError's rule).
    fn ioError(code: i64) -> IoError => HostServices.hostError(code);
}

/// The runtime's "not ready yet" (CEE_ASYNC_WOULD_BLOCK, rt.h): the task waits for readiness and tries again.
fn wouldBlock() -> i64 => -9223372036854775807 - 1;

/// One socket operation of a task (ADR 0035): the runtime's record (`ceesafe_async_op`), in the task's frame, which
/// never moves, so a buffer lent to the kernel outlives its use; and, once the task is cancelled with the operation in
/// flight, why it is leaving, while it waits for the kernel to finish.
struct AsyncOp {
    words: [u64; 24];
    leaving: AsyncError?;

    fn create() -> AsyncOp => AsyncOp { words: [0u64; 24], leaving: null };

    /// The record, for the runtime.
    fn raw(borrow mut this) -> *mut void => borrow mut this.words as *mut [u64; 24] as *mut void;

    /// Before each step: Err if the task is cancelled (or its shield's time is up) and nothing is in flight, so it
    /// may leave now; Ok to step on, also while the kernel finishes an operation the task abandoned.
    /// Safety: the record is this operation's; ceesafe_async_op_cancel only asks the kernel to stop it.
    fn check(borrow mut this) -> Result<void, AsyncError> {
        if (this.leaving != null) {
            return Ok();
        }
        match (AsyncLeaf.status()) {
            Ok() => { return Ok(); }
            Err(e) => {
                if (unsafe { ceesafe_async_op_cancel(this.raw()) }) {
                    this.leaving = Some(e); // in flight: wait for the kernel, then leave (type-system.md §40.7)
                    return Ok();
                }
                return Err(e);
            }
        }
    }

    /// A completed step's result as the operation's: a value, kept even if the task was cancelled meanwhile (no
    /// value is lost, §40.7); an error is the cancellation's if the task was leaving, else the I/O error.
    fn result(borrow this, r: i64) -> Result<i64, AsyncError> {
        if (r >= 0) {
            return Ok(r);
        }
        return match (this.leaving) {
            Some(e) => Err(e),
            null => Err(AsyncError.Io(AsyncIo.ioError(r))),
        };
    }

    fn pending() -> i64 => -9223372036854775807; // CEE_ASYNC_PENDING
}

/// A message operation of a task (ADR 0045): a vectored send now, a datagram later. The runtime's larger record
/// (`ceesafe_async_msg_op`), which holds the parts the kernel reads while the operation is in flight; the rest is
/// `AsyncOp`'s.
struct AsyncMsgOp {
    words: [u64; 64];
    leaving: AsyncError?;

    fn create() -> AsyncMsgOp => AsyncMsgOp { words: [0u64; 64], leaving: null };

    /// The record, for the runtime.
    fn raw(borrow mut this) -> *mut void => borrow mut this.words as *mut [u64; 64] as *mut void;

    /// `parts`' non-empty parts into the record, before the first step; how many.
    /// Safety: the runtime reads each pointer and length during its call only; the bytes stay borrowed by the
    /// caller until the operation is complete, which the caller's frame outlives.
    fn fill(borrow mut this, parts: borrow IoParts) -> u32 {
        var filled: u32 = 0;
        for (i in 0..parts.count()) {
            let part = parts.part(i);
            if (part.length > 0) {
                unsafe { ceesafe_async_msg_part(this.raw(), filled, part.ptr, part.length as u64); }
                filled += 1;
            }
        }
        return filled;
    }

    /// As `AsyncOp.check`.
    /// Safety: the record is this operation's; ceesafe_async_op_cancel only asks the kernel to stop it.
    fn check(borrow mut this) -> Result<void, AsyncError> {
        if (this.leaving != null) {
            return Ok();
        }
        match (AsyncLeaf.status()) {
            Ok() => { return Ok(); }
            Err(e) => {
                if (unsafe { ceesafe_async_op_cancel(this.raw()) }) {
                    this.leaving = Some(e);
                    return Ok();
                }
                return Err(e);
            }
        }
    }

    /// As `AsyncOp.result`.
    fn result(borrow this, r: i64) -> Result<i64, AsyncError> {
        if (r >= 0) {
            return Ok(r);
        }
        return match (this.leaving) {
            Some(e) => Err(e),
            null => Err(AsyncError.Io(AsyncIo.ioError(r))),
        };
    }
}

/// A TCP listener for tasks (type-system.md §40.4): `accept` parks the task until a connection arrives. Its socket is
/// non-blocking; the drop closes it.
@noncopy
public struct AsyncTcpListener {
    private fd: i32;

    /// Listens on `address` (IPv4 or IPv6 text, without a zone) and `port` (0: any free port), with
    /// `ListenOptions.defaults()`.
    /// Safety: the runtime reads the address only during the call.
    public fn bind(address: StringView, port: u16) -> Result<AsyncTcpListener, IoError> {
        let r = unsafe { ceesafe_async_tcp_listen(address.ptr, address.length as u64, port) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        return Ok(AsyncTcpListener { fd: truncate<i32>(r) });
    }

    /// Listens on `address` with `options` (ADR 0044 §3.2).
    /// Safety: the runtime reads the address only during the call.
    public fn bindWith(address: SocketAddress, options: ListenOptions) -> Result<AsyncTcpListener, IoError> {
        let raw = RawAddress.of(address);
        let r = unsafe { ceesafe_async_tcp_listen_at(
            raw.family,
            borrow raw.bytes as *[u8; 16] as *u8,
            raw.port,
            raw.scope,
            options.backlog,
            options.flags(),
        ) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        return Ok(AsyncTcpListener { fd: truncate<i32>(r) });
    }

    /// The address it listens on.
    public fn localAddress(borrow this) -> Result<SocketAddress, IoError> => RawAddress.name(this.fd, 0);

    /// The port it listens on.
    /// Safety: the descriptor is this listener's.
    public fn port(borrow this) -> Result<u16, IoError> {
        let r = unsafe { ceesafe_async_tcp_port(this.fd) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        return Ok(truncate<u16>(r));
    }

    /// The next connection; the task parks until one arrives.
    /// Safety: the descriptor is this listener's; a new one becomes the stream's.
    public async fn accept(borrow this) -> Result<AsyncTcpStream, AsyncError> {
        var op = AsyncOp.create();
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_accept(op.raw(), this.fd) };
            if (r != AsyncOp.pending()) {
                return Ok(AsyncTcpStream { fd: truncate<i32>(op.result(r)?) });
            }
            await Async.park();
        }
    }

    /// Safety: the descriptor is closed once, here.
    drop {
        unsafe { ceesafe_async_close(this.fd); }
    }
}

/// A TCP stream for tasks (type-system.md §40.4): `read` and `write` park the task until the socket is ready. Its
/// socket is non-blocking; the drop closes it.
@noncopy
public struct AsyncTcpStream {
    private fd: i32;

    /// Connects to `address` (IPv4 or IPv6 text, without a zone) and `port`; the task parks until the connection is
    /// made or refused.
    /// Safety: the runtime reads the address only during the call; the descriptor becomes the stream's at once, so an
    /// error closes it.
    public async fn connect(address: StringView, port: u16) -> Result<AsyncTcpStream, AsyncError> {
        var op = AsyncOp.create();
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_connect(op.raw(), address.ptr, address.length as u64, port) };
            if (r != AsyncOp.pending()) {
                return Ok(AsyncTcpStream { fd: truncate<i32>(op.result(r)?) }); // the record held the socket till now
            }
            await Async.park();
        }
    }

    /// Connects to `address` (ADR 0044 §3.3); the task parks until the connection is made or refused.
    /// Safety: the runtime reads the address only during each step; the descriptor becomes the stream's at once.
    public async fn connectTo(address: SocketAddress) -> Result<AsyncTcpStream, AsyncError> {
        let raw = RawAddress.of(address);
        var op = AsyncOp.create();
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_connect_at(
                op.raw(),
                raw.family,
                borrow raw.bytes as *[u8; 16] as *u8,
                raw.port,
                raw.scope,
            ) };
            if (r != AsyncOp.pending()) {
                return Ok(AsyncTcpStream { fd: truncate<i32>(op.result(r)?) });
            }
            await Async.park();
        }
    }

    /// TCP_NODELAY: send small writes at once instead of gathering them (Nagle's algorithm off).
    public fn setNoDelay(borrow this, on: bool) -> Result<void, IoError> =>
        RawAddress.option(this.fd, 1, if (on) 1 else 0);

    /// SO_KEEPALIVE: probe an idle connection, after `idleSeconds` of quiet (0: the system's time); null: off.
    public fn setKeepAlive(borrow this, idleSeconds: u32?) -> Result<void, IoError> => match (idleSeconds) {
        Some(s) => RawAddress.option(this.fd, 2, s as i64),
        null => RawAddress.option(this.fd, 2, -1),
    };

    /// SO_SNDBUF: the kernel's send buffer, in bytes (it may round the size, and Linux doubles it).
    public fn setSendBuffer(borrow this, bytes: u32) -> Result<void, IoError> =>
        RawAddress.option(this.fd, 3, bytes as i64);

    /// SO_RCVBUF: the kernel's receive buffer, in bytes (as setSendBuffer).
    public fn setRecvBuffer(borrow this, bytes: u32) -> Result<void, IoError> =>
        RawAddress.option(this.fd, 4, bytes as i64);

    /// SO_LINGER: how long the close waits for unsent data, in seconds; 0 makes the close reset the connection;
    /// null restores the default (the close returns at once and the kernel sends the rest).
    public fn setLinger(borrow this, seconds: u32?) -> Result<void, IoError> => match (seconds) {
        Some(s) => RawAddress.option(this.fd, 5, s as i64),
        null => RawAddress.option(this.fd, 5, -1),
    };

    /// The peer's address (an IPv4 peer of a dual-stack listener as V4).
    public fn peerAddress(borrow this) -> Result<SocketAddress, IoError> => RawAddress.name(this.fd, 1);

    /// This end's address.
    public fn localAddress(borrow this) -> Result<SocketAddress, IoError> => RawAddress.name(this.fd, 0);

    /// Ends this side's reading: what arrives afterwards is discarded, and a read returns 0.
    /// Safety: the descriptor is this stream's.
    public fn shutdownRead(borrow this) -> Result<void, IoError> {
        let r = unsafe { ceesafe_async_shutdown_read(this.fd) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        return Ok();
    }

    /// Reads into `buffer`: the count, 0 at the end of the stream; the task parks until there is something to read.
    /// Safety: the runtime writes at most the buffer's length, during the call only.
    public async fn read(borrow this, buffer: SliceMut<u8>) -> Result<usize, AsyncError> {
        var op = AsyncOp.create();
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_read(op.raw(), this.fd, buffer.ptr, buffer.length as u64) };
            if (r != AsyncOp.pending()) {
                return Ok(truncate<usize>(op.result(r)?));
            }
            await Async.park();
        }
    }

    /// Writes every byte; the task parks whenever the socket cannot take more.
    /// Safety: the runtime reads at most the slice's length, during the call only.
    public async fn write(borrow this, bytes: Slice<u8>) -> Result<void, AsyncError> {
        var done: usize = 0;
        while (done < bytes.length) {
            var op = AsyncOp.create();
            loop {
                op.check()?;
                let rest = bytes[done..];
                let r = unsafe { ceesafe_async_op_send(op.raw(), this.fd, rest.ptr, rest.length as u64) };
                if (r != AsyncOp.pending()) {
                    done += truncate<usize>(op.result(r)?);
                    break;
                }
                await Async.park();
            }
        }
        return Ok();
    }

    /// Sends from `parts` in one step (ADR 0045 §3.2): the task parks until the socket takes at least one byte, and the
    /// result is how many it took, which may stop inside any part. Empty parts send nothing and return 0.
    public async fn writeVectored(borrow this, parts: borrow IoParts) -> Result<usize, AsyncError> =>
        await AsyncSockets.sendVectored(this.fd, parts);

    /// Sends every byte of `parts`, in as many steps as the socket needs.
    public async fn writeAllVectored(borrow this, parts: borrow IoParts) -> Result<void, AsyncError> {
        var sent: usize = 0;
        let total = parts.totalLength();
        while (sent < total) {
            let rest = parts.after(sent);
            sent += await AsyncSockets.sendVectored(this.fd, borrow rest)?;
        }
        return Ok();
    }

    /// Sends from `file` at `offset`, at most `length` bytes, in one step (ADR 0051): the task parks until the socket
    /// takes at least one byte, and the result is how many went, 0 if the file ends at `offset`. The file's own position
    /// is neither used nor moved, so one file may be sent on several streams at once. Where the system cannot send a
    /// file (ceesafe_async_op_sendfile's CEE_ASYNC_NO_SENDFILE), the step reads at most 64 KiB at `offset` on a worker
    /// thread and writes them: the same results, through a copy.
    /// Safety: the runtime reads the file's descriptor during the call only, and lends the kernel no buffer.
    public async fn sendFile(borrow this, file: borrow File, offset: u64, length: u64) -> Result<u64, AsyncError> {
        if (length == 0) {
            return Ok(0);
        }
        var op = AsyncOp.create();
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_sendfile(op.raw(), this.fd, file as *File as *void, offset, length) };
            if (r == AsyncTcpStream.noSendFile()) {
                return await this.copyFile(file, offset, length);
            }
            if (r != AsyncOp.pending()) {
                return Ok(truncate<u64>(op.result(r)?));
            }
            await Async.park();
        }
    }

    /// Sends `length` bytes of `file` from `offset`, in as many steps as the socket needs. If the file ends first, the
    /// result is `Io(InvalidInput)`, with the bytes before its end sent.
    public async fn sendFileAll(borrow this, file: borrow File, offset: u64, length: u64) -> Result<void, AsyncError> {
        var sent: u64 = 0;
        while (sent < length) {
            let n = await this.sendFile(file, offset + sent, length - sent)?;
            if (n == 0) {
                return Err(AsyncError.Io(IoError.InvalidInput));
            }
            sent += n;
        }
        return Ok();
    }

    fn noSendFile() -> i64 => -9223372036854775806; // CEE_ASYNC_NO_SENDFILE

    /// sendFile's copy: at most 64 KiB read at `offset` on a worker thread, then written whole.
    /// Safety: ceesafe_file_read_at writes at most the buffer's length, during the call only.
    async fn copyFile(borrow this, file: borrow File, offset: u64, length: u64) -> Result<u64, AsyncError> {
        let size: u64 = if (length > 65536) 65536 else length;
        var buffer = match (Vector<u8>.withCapacity(size as usize)) {
            Ok(v) => v,
            Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }
        };
        for (k in 0..size) {
            match (buffer.push(0)) {
                Ok() => {}
                Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); } // not reached: the room is there
            }
        }
        let target = buffer.viewMut();
        let r = await Async.blocking(
            () => unsafe { ceesafe_file_read_at(file as *File as *void, target.ptr, target.length as u64, offset) },
        );
        if (r < 0) {
            return Err(AsyncError.Io(AsyncIo.ioError(r)));
        }
        let got = truncate<usize>(r);
        let filled = buffer.view();
        await this.write(filled[0..got])?;
        return Ok(got as u64);
    }

    /// Ends this side's writing, so the peer reads the end of the stream.
    /// Safety: the descriptor is this stream's.
    public fn shutdownWrite(borrow this) -> Result<void, IoError> {
        let r = unsafe { ceesafe_async_shutdown_write(this.fd) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        return Ok();
    }

    /// Safety: the descriptor is closed once, here.
    drop {
        unsafe { ceesafe_async_close(this.fd); }
    }
}

/// A UDP socket for tasks (ADR 0050): datagrams sent whole or not at all, and received one at a time, a longer one than
/// the buffer reported as truncated. `sendTo` and `recvFrom` are the common case; `sendMsg` and `recvMsg` add the
/// local address, ECN bits and segments that QUIC needs.
public struct AsyncUdpSocket {
    private fd: i32;
    private family: u32; // 4 or 6: an IPv4 destination of an IPv6 socket is sent IPv4-mapped
    private port: u16;   // the bound port, for `UdpReceived.to`

    /// A socket bound to `address` (port 0: the system chooses), with `options`.
    /// Safety: the runtime reads the address only during the call; the descriptor becomes the socket's at once, so an
    /// error closes it.
    public fn bind(address: SocketAddress, options: UdpOptions) -> Result<AsyncUdpSocket, IoError> {
        let raw = RawAddress.of(address);
        let r = unsafe { ceesafe_async_udp_bind(
            raw.family,
            borrow raw.bytes as *[u8; 16] as *u8,
            raw.port,
            raw.scope,
            options.flags(),
            options.sendBuffer,
            options.recvBuffer,
        ) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        var socket = AsyncUdpSocket { fd: truncate<i32>(r), family: raw.family, port: raw.port };
        if (raw.port == 0) {
            socket.port = match (RawAddress.name(socket.fd, 0)?) {
                SocketAddress.V4(_, p) => p,
                SocketAddress.V6(_, p, _) => p,
            };
        }
        return Ok(socket);
    }

    /// The address it is bound to.
    public fn localAddress(borrow this) -> Result<SocketAddress, IoError> => RawAddress.name(this.fd, 0);

    /// Sends `bytes` as one datagram to `to`: whole, or not at all (a datagram too long for the path is
    /// `Io(InvalidInput)`). An empty slice sends an empty datagram.
    public async fn sendTo(borrow this, bytes: Slice<u8>, to: SocketAddress) -> Result<void, AsyncError> {
        let parts = IoParts.of(bytes);
        await this.sendOnce(borrow parts, to, null, 0, 0)?;
        return Ok();
    }

    /// Waits for one datagram, into `buffer`.
    public async fn recvFrom(borrow this, buffer: SliceMut<u8>) -> Result<Datagram, AsyncError> {
        let r = await this.recvMsg(buffer)?;
        return Ok(Datagram { length: r.length, from: r.from, truncated: r.truncated });
    }

    /// Sends `message` (ADR 0050 §3.1): one datagram of its parts, or with `segmentSize` > 0 datagrams of that many
    /// bytes each, the last one shorter, in one call where the system can (Linux's UDP_SEGMENT) and one by one
    /// elsewhere. The result is the bytes sent: always whole segments. If a segment fails after others went, the result
    /// is the bytes of those before it; if the first fails, its error.
    public async fn sendMsg(borrow this, message: borrow UdpMessage) -> Result<usize, AsyncError> {
        let total = message.parts.totalLength();
        let size = message.segmentSize as usize;
        if (size == 0 || total <= size) {
            let r = await this.sendOnce(borrow message.parts, message.to, message.from, message.ecn, 0)?;
            return Ok(truncate<usize>(r));
        }
        let together = await this.sendOnce(
            borrow message.parts,
            message.to,
            message.from,
            message.ecn,
            message.segmentSize,
        )?;
        if (together >= 0) {
            return Ok(truncate<usize>(together));
        }
        var sent: usize = 0;
        while (sent < total) {
            let rest = message.parts.after(sent);
            let piece = rest.upTo(size);
            match (await this.sendOnce(borrow piece, message.to, message.from, message.ecn, 0)) {
                Ok(_) => { sent += piece.totalLength(); }
                Err(e) => { return if (sent == 0) Err(e) else Ok(sent); }
            }
        }
        return Ok(sent);
    }

    /// Waits for one datagram, into `buffer`, with what `UdpOptions` asked to be reported about it.
    /// Safety: the runtime writes at most the buffer's length; the buffer stays borrowed until the operation is
    /// complete, which this frame outlives (an operation abandoned by a cancellation is waited for, §40.7).
    public async fn recvMsg(borrow this, buffer: SliceMut<u8>) -> Result<UdpReceived, AsyncError> {
        var op = AsyncMsgOp.create();
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_recvmsg(op.raw(), this.fd, buffer.ptr, buffer.length as u64) };
            if (r != AsyncOp.pending()) {
                let length = truncate<usize>(op.result(r)?);
                return this.received(mut op, length);
            }
            await Async.park();
        }
    }

    fn noSegments() -> i64 => -9223372036854775805; // CEE_ASYNC_NO_SEGMENTS

    /// One send of `parts` (with `segment` > 0, as segments in one call): the bytes sent, or -1 where the system cannot
    /// send them so (the caller then sends the segments one by one).
    /// Safety: the runtime reads the addresses during the call only; the parts stay borrowed until the operation is
    /// complete, which this frame outlives.
    async fn sendOnce(
        borrow this,
        parts: borrow IoParts,
        to: SocketAddress,
        from: SocketAddress?,
        ecn: u8,
        segment: u16,
    ) -> Result<i64, AsyncError> {
        var op = AsyncMsgOp.create();
        let count = op.fill(parts);
        let target = RawAddress.of(to);
        let source = match (from) {
            Some(a) => RawAddress.of(a),
            null => RawAddress { family: 0, bytes: [0u8; 16], port: 0, scope: 0 },
        };
        unsafe {
            ceesafe_async_msg_send_to(
                op.raw(),
                this.family,
                target.family,
                borrow target.bytes as *[u8; 16] as *u8,
                target.port,
                target.scope,
                source.family,
                borrow source.bytes as *[u8; 16] as *u8,
                ecn as u32,
                segment as u32,
            );
        }
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_sendmsg(op.raw(), this.fd, count) };
            if (r == AsyncUdpSocket.noSegments()) {
                return Ok(-1);
            }
            if (r != AsyncOp.pending()) {
                return op.result(r);
            }
            await Async.park();
        }
    }

    /// A completed receive's addresses and flags, from the record.
    /// Safety: the runtime writes the 16 bytes and the scope during each call only.
    fn received(borrow this, op: borrow mut AsyncMsgOp, length: usize) -> Result<UdpReceived, AsyncError> {
        var bytes = [0u8; 16];
        var scope: u32 = 0;
        let peer = unsafe { ceesafe_async_msg_address(
            op.raw(),
            0,
            borrow mut bytes as *mut [u8; 16] as *mut u8,
            borrow mut scope as *mut u32,
        ) };
        if (peer < 0) {
            return Err(AsyncError.Io(IoError.Unsupported));
        }
        let from = RawAddress.decode(peer, bytes, scope);
        let local = unsafe { ceesafe_async_msg_address(
            op.raw(),
            1,
            borrow mut bytes as *mut [u8; 16] as *mut u8,
            borrow mut scope as *mut u32,
        ) };
        // A local address's port field is 0: the socket's port is added.
        let to: SocketAddress? = if (local < 0) null else Some(
            RawAddress.decode(local + this.port as i64, bytes, scope),
        );
        let flags = unsafe { ceesafe_async_msg_flags(op.raw()) };
        return Ok(UdpReceived {
            length: length,
            truncated: (flags & 1) != 0,
            from: from,
            to: to,
            ecn: truncate<u8>((flags >> 8) & 3),
        });
    }

    /// Safety: the descriptor is closed once, here.
    drop {
        unsafe { ceesafe_async_close(this.fd); }
    }
}

/// The non-blocking socket calls under AsyncTcpListener and AsyncTcpStream, one at a time, on descriptors: a value
/// >= 0, `wouldBlock()`, or a negated errno. For code that runs its own wait loop, as the interpreter does; programs use
/// the async types, which own their descriptors.
public struct AsyncSockets {
    public fn wouldBlock() -> i64 => -9223372036854775807 - 1;

    /// Safety: the runtime reads the address during the call only.
    public fn listen(address: StringView, port: u16) -> i64 =>
        unsafe { ceesafe_async_tcp_listen(address.ptr, address.length as u64, port) };

    /// Safety: on a descriptor the runtime only asks the kernel.
    public fn port(fd: i32) -> i64 => unsafe { ceesafe_async_tcp_port(fd) };

    /// Safety: as port.
    public fn accept(fd: i32) -> i64 => unsafe { ceesafe_async_tcp_accept(fd) };

    /// Safety: as listen.
    public fn connect(address: StringView, port: u16) -> i64 =>
        unsafe { ceesafe_async_tcp_connect(address.ptr, address.length as u64, port) };

    /// Safety: as port.
    public fn connected(fd: i32) -> i64 => unsafe { ceesafe_async_tcp_connected(fd) };

    /// Safety: the runtime writes at most the buffer's length, during the call only.
    public fn read(fd: i32, buffer: SliceMut<u8>) -> i64 =>
        unsafe { ceesafe_async_read(fd, buffer.ptr, buffer.length as u64) };

    /// Safety: the runtime reads at most the slice's length, during the call only.
    public fn send(fd: i32, bytes: Slice<u8>) -> i64 =>
        unsafe { ceesafe_async_send(fd, bytes.ptr, bytes.length as u64) };

    /// Safety: as port.
    public fn shutdownWrite(fd: i32) -> i64 => unsafe { ceesafe_async_shutdown_write(fd) };

    /// ADR 0044's calls on descriptors, for the interpreter's models: a listener at an address's fields (`bytes`
    /// has 16, of which IPv4 uses 4), with a backlog and rt.h's CEE_LISTEN_* flags.
    /// Safety: the runtime reads the 16 bytes during the call only (checked: fewer is -EINVAL).
    public fn listenAt(family: u32, bytes: Slice<u8>, port: u16, scope: u32, backlog: u32, flags: u32) -> i64 {
        if (bytes.length < 16) {
            return -22;
        }
        return unsafe { ceesafe_async_tcp_listen_at(family, bytes.ptr, port, scope, backlog, flags) };
    }

    /// A connection started to an address's fields, as `connect`.
    /// Safety: as listenAt.
    public fn connectAt(family: u32, bytes: Slice<u8>, port: u16, scope: u32) -> i64 {
        if (bytes.length < 16) {
            return -22;
        }
        return unsafe { ceesafe_async_tcp_connect_at(family, bytes.ptr, port, scope) };
    }

    /// The socket's own (`peer` 0) or its peer's (1) address: its 16 bytes and scope written; (family << 16) | port,
    /// or a negated errno.
    /// Safety: the runtime writes 16 bytes (checked) and the scope during the call only.
    public fn name(fd: i32, peer: u32, bytes: SliceMut<u8>, scope: borrow mut u32) -> i64 {
        if (bytes.length < 16) {
            return -22;
        }
        return unsafe { ceesafe_async_socket_name(fd, peer, bytes.ptr, scope as *mut u32) };
    }

    /// Sets rt.h's CEE_SOCKET_OPTION_* `option` to `value`: 0 or a negated errno.
    /// Safety: as port.
    public fn setOption(fd: i32, option: u32, value: i64) -> i64 =>
        unsafe { ceesafe_async_socket_option(fd, option, value) };

    /// Safety: as port.
    public fn shutdownRead(fd: i32) -> i64 => unsafe { ceesafe_async_shutdown_read(fd) };

    /// One vectored send on a descriptor (ADR 0045 §3.2): the task parks until the socket takes at least one byte;
    /// the count may stop inside any part. Empty parts send nothing and return 0.
    /// Safety: the parts stay borrowed until the operation completes, and its record is in this task's frame.
    public async fn sendVectored(fd: i32, parts: borrow IoParts) -> Result<usize, AsyncError> {
        var op = AsyncMsgOp.create();
        let count = op.fill(parts);
        if (count == 0) {
            return Ok(0);
        }
        loop {
            op.check()?;
            let r = unsafe { ceesafe_async_op_sendv(op.raw(), fd, count) };
            if (r != AsyncOp.pending()) {
                return Ok(truncate<usize>(op.result(r)?));
            }
            await Async.park();
        }
    }

    /// A UDP socket bound to the address's fields (ADR 0050), with UdpOptions' flags and the buffer sizes: the
    /// descriptor, or a negated errno.
    /// Safety: the runtime reads the 16 address bytes during the call only.
    public fn udpBind(
        family: u32,
        bytes: Slice<u8>,
        port: u16,
        scope: u32,
        flags: u32,
        sendBuffer: u32,
        receiveBuffer: u32,
    ) -> i64 {
        if (bytes.length < 16) {
            return -22; // EINVAL
        }
        return unsafe { ceesafe_async_udp_bind(family, bytes.ptr, port, scope, flags, sendBuffer, receiveBuffer) };
    }

    /// One datagram of `data` to the address's fields, from a socket of `socketFamily`: the count, `wouldBlock()`, or
    /// a negated errno.
    /// Safety: the runtime reads the data and the 16 address bytes during the call only.
    public fn udpSend(
        fd: i32,
        data: Slice<u8>,
        socketFamily: u32,
        family: u32,
        bytes: Slice<u8>,
        port: u16,
        scope: u32,
    ) -> i64 {
        if (bytes.length < 16) {
            return -22; // EINVAL
        }
        return unsafe { ceesafe_async_udp_send(
            fd,
            data.ptr,
            data.length as u64,
            socketFamily,
            family,
            bytes.ptr,
            port,
            scope,
        ) };
    }

    /// One datagram into `buffer`: its length there, `wouldBlock()`, or a negated errno; the peer's 16 bytes and scope,
    /// and in `info` (family << 24) | (truncated << 16) | port.
    /// Safety: the runtime writes at most the buffer's length and 16 address bytes, during the call only.
    public fn udpRecv(
        fd: i32,
        buffer: SliceMut<u8>,
        bytes: SliceMut<u8>,
        scope: borrow mut u32,
        info: borrow mut u32,
    ) -> i64 {
        if (bytes.length < 16) {
            return -22; // EINVAL
        }
        return unsafe { ceesafe_async_udp_recv(
            fd,
            buffer.ptr,
            buffer.length as u64,
            bytes.ptr,
            scope as *mut u32,
            info as *mut u32,
        ) };
    }

    /// An interface's index by name (an IPv6 zone), 0 if there is none (lib/std's net.cee declares the call).
    /// Safety: the runtime reads the name during the call only.
    public fn interfaceIndex(name: Slice<u8>) -> u32 =>
        unsafe { ceesafe_interface_index(name.ptr, name.length as u64) };

    /// Safety: as port.
    public fn close(fd: i32) {
        unsafe { ceesafe_async_close(fd); }
    }

    /// Waits up to `timeout` ms (-1: no limit) for any descriptor: `events[k]` 1 readable, 2 writable; `ready[k]`
    /// receives each one's readiness. The count ready, 0 on timeout, or a negated errno.
    /// Safety: the three slices have `fds.length` elements (checked), read and written during the call only.
    public fn poll(fds: Slice<i32>, events: Slice<u32>, ready: SliceMut<u32>, timeout: i64) -> i64 {
        if (events.length != fds.length || ready.length != fds.length) {
            return -22; // EINVAL
        }
        return unsafe { ceesafe_async_poll(fds.ptr, events.ptr, ready.ptr, fds.length as u64, timeout) };
    }
}

/// Files for tasks (type-system.md §40.4): a regular file is always ready to the kernel's readiness calls, so each
/// operation runs on a worker thread (Async.blocking) while the task waits.
public struct AsyncFiles {
    /// Opens `path` for reading.
    public async fn open(path: StringView) -> Result<File, AsyncError> {
        match (await Async.blocking(() => File.open(path))) {
            Ok(file) => { return Ok(file); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Opens `path` for reading if it is a regular file (ADR 0078 §3): never waits on a FIFO; `IsDirectory` for a
    /// directory, `InvalidInput` for anything else that is not a regular file.
    public async fn openRegular(path: StringView) -> Result<File, AsyncError> {
        match (await Async.blocking(() => File.openRegular(path))) {
            Ok(file) => { return Ok(file); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// The open file's last modification time, read from the file (ADR 0078 §3).
    public async fn modified(file: borrow mut File) -> Result<UnixTime, AsyncError> {
        match (await Async.blocking(() => file.modified())) {
            Ok(t) => { return Ok(t); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// What the open file is, read from the file (ADR 0078 §3).
    public async fn kind(file: borrow mut File) -> Result<PathKind, AsyncError> {
        match (await Async.blocking(() => file.kind())) {
            Ok(k) => { return Ok(k); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Creates or truncates `path` for writing.
    public async fn create(path: StringView) -> Result<File, AsyncError> {
        match (await Async.blocking(() => File.create(path))) {
            Ok(file) => { return Ok(file); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Reads into `buffer`: the count, 0 at the end of the file.
    public async fn read(file: borrow mut File, buffer: SliceMut<u8>) -> Result<usize, AsyncError> {
        match (await Async.blocking(() => file.read(mut buffer))) {
            Ok(n) => { return Ok(n); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Writes every byte.
    public async fn write(file: borrow mut File, bytes: Slice<u8>) -> Result<void, AsyncError> {
        match (await Async.blocking(() => file.write(bytes))) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }
    /// Opens an existing `path` for reading and writing (ADR 0075 §2.1).
    public async fn openReadWrite(path: StringView) -> Result<File, AsyncError> {
        match (await Async.blocking(() => File.openReadWrite(path))) {
            Ok(file) => { return Ok(file); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Opens `path` for reading and writing, creating it if missing; never truncates (ADR 0075 §2.1).
    public async fn openOrCreate(path: StringView) -> Result<File, AsyncError> {
        match (await Async.blocking(() => File.openOrCreate(path))) {
            Ok(file) => { return Ok(file); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Creates `path` for reading and writing; `AlreadyExists` if it exists (ADR 0075 §2.1).
    public async fn createNew(path: StringView) -> Result<File, AsyncError> {
        match (await Async.blocking(() => File.createNew(path))) {
            Ok(file) => { return Ok(file); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// One read at `offset` into `buffer`: the count, 0 at or past the end (ADR 0075 §2.1).
    public async fn readAt(file: borrow mut File, buffer: SliceMut<u8>, offset: u64) -> Result<usize, AsyncError> {
        match (await Async.blocking(() => file.readAt(mut buffer, offset))) {
            Ok(n) => { return Ok(n); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// The file's length in bytes (ADR 0075 §2.1).
    public async fn length(file: borrow mut File) -> Result<u64, AsyncError> {
        match (await Async.blocking(() => file.length())) {
            Ok(n) => { return Ok(n); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Writes every byte at `offset` (ADR 0075 §2.1).
    public async fn writeAt(file: borrow mut File, bytes: Slice<u8>, offset: u64) -> Result<void, AsyncError> {
        match (await Async.blocking(() => file.writeAt(bytes, offset))) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Makes the data, and the metadata needed to read it, durable (ADR 0075 §2.1). After a failure the durable contents are unknown.
    public async fn syncData(file: borrow mut File) -> Result<void, AsyncError> {
        match (await Async.blocking(() => file.syncData())) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// `syncData` with all metadata (ADR 0075 §2.1).
    public async fn syncAll(file: borrow mut File) -> Result<void, AsyncError> {
        match (await Async.blocking(() => file.syncAll())) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Truncates or zero-extends the file to `length` bytes (ADR 0075 §2.1).
    public async fn setLength(file: borrow mut File, length: u64) -> Result<void, AsyncError> {
        match (await Async.blocking(() => file.setLength(length))) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Renames `from` to `to`, atomically replacing it (ADR 0075 §2.1).
    public async fn rename(from: StringView, to: StringView) -> Result<void, AsyncError> {
        match (await Async.blocking(() => File.rename(from, to))) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }

    /// Makes a directory's entries durable (ADR 0075 §2.1).
    public async fn syncDirectory(path: StringView) -> Result<void, AsyncError> {
        match (await Async.blocking(() => Directory.sync(path))) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(AsyncError.Io(e)); }
        }
    }
}

/// A SocketAddress's fields as the runtime takes them (ADR 0044 §3.1: rt.h's ceesafe_endpoint), and the calls that
/// read an address or set an option on a descriptor.
struct RawAddress {
    family: u32;
    bytes: [u8; 16];
    port: u16;
    scope: u32;

    fn of(a: SocketAddress) -> RawAddress => match (a) {
        SocketAddress.V4(v4, p) => {
            var bytes = [0u8; 16];
            for (k in 0..4usize) {
                bytes[k] = v4[k];
            }
            return RawAddress { family: 4, bytes: bytes, port: p, scope: 0 };
        }
        SocketAddress.V6(v6, p, s) => RawAddress { family: 6, bytes: v6, port: p, scope: s },
    };

    /// The address the runtime packed as (family << 16) | port, with its 16 bytes and scope.
    fn decode(packed: i64, bytes: [u8; 16], scope: u32) -> SocketAddress {
        let p = truncate<u64>(packed);
        let port = truncate<u16>(p & 65535);
        if ((p >> 16) == 4) {
            return SocketAddress.V4([bytes[0], bytes[1], bytes[2], bytes[3]], port);
        }
        return SocketAddress.V6(bytes, port, scope);
    }

    /// The descriptor's own (`peer` 0) or its peer's address.
    /// Safety: the runtime writes the 16 bytes and the scope during the call only.
    fn name(fd: i32, peer: u32) -> Result<SocketAddress, IoError> {
        var bytes = [0u8; 16];
        var scope: u32 = 0;
        let r = unsafe { ceesafe_async_socket_name(
            fd,
            peer,
            borrow mut bytes as *mut [u8; 16] as *mut u8,
            borrow mut scope as *mut u32,
        ) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        let packed = truncate<u64>(r); // r >= 0 here
        let port = truncate<u16>(packed & 65535);
        if ((packed >> 16) == 4) {
            return Ok(SocketAddress.V4([bytes[0], bytes[1], bytes[2], bytes[3]], port));
        }
        return Ok(SocketAddress.V6(bytes, port, scope));
    }

    /// Safety: the runtime only sets the option on the descriptor.
    fn option(fd: i32, option: u32, value: i64) -> Result<void, IoError> {
        let r = unsafe { ceesafe_async_socket_option(fd, option, value) };
        if (r < 0) {
            return Err(AsyncIo.ioError(r));
        }
        return Ok();
    }
}
