// Bluetooth printers (ADR 0177; type-system.md §26.19): a byte stream to a paired printer's serial port (Classic) or
// to a nearby printer's write characteristic (Low Energy).

extern "C" {
    @effects(sleep, alloc)
    fn ceesafe_bluetooth_list(scan: u32, milliseconds: u32, out: *mut (*u8)) -> i64;
    @effects()
    fn ceesafe_bluetooth_free(list: *u8);
    @effects(sleep, alloc)
    fn ceesafe_bluetooth_open(transport: u32, address: *u8, length: u64) -> i64;
    @effects(sleep)
    fn ceesafe_bluetooth_write(link: i64, bytes: *u8, length: u64) -> i32;
    @effects(sleep)
    fn ceesafe_bluetooth_close(link: i64);
}

/// How a device is reached: Classic Bluetooth's serial port (RFCOMM, the Serial Port Profile), or Bluetooth Low
/// Energy (a GATT characteristic that takes writes).
public enum BluetoothTransport {
    Classic,
    LowEnergy,
}

/// Why a Bluetooth call failed.
public enum BluetoothError {
    /// The system has no such Bluetooth: Classic on iOS; every call on Linux and FreeBSD (for now) and under
    /// `ceesafec run --interp`; a machine with no adapter.
    Unsupported,
    /// The adapter is switched off.
    Off,
    /// The user refused the program Bluetooth, or (iOS, a bundled macOS app) the program does not say why it uses it.
    Denied,
    /// The device is not paired, or not in range.
    NotFound,
    /// The device would not connect: another holds it, or it is not a printer.
    Refused,
    /// The link broke.
    Lost,
    /// Memory or the system's handles ran out.
    Resources,
}

/// A printer the system knows (paired) or found (a scan).
public struct BluetoothDevice {
    /// As the system shows it; may be empty for a Low Energy device that advertises none.
    public name: String;
    /// The system's id for it: "00:11:22:AA:BB:CC", or on Apple's systems for a Low Energy device a UUID.
    public address: String;
    public transport: BluetoothTransport;
}

/// The printers a program can reach (ADR 0177). Every call blocks until done and may be made from any thread: a
/// windowed program makes them off its UI thread.
///
/// ```
/// let printers = Bluetooth.pairedPrinters()?;          // Android, macOS, Windows
/// var link = BluetoothLink.open(printers[0])?;
/// link.write(receipt.view())?;                          // ESC/POS bytes
/// ```
public struct Bluetooth {
    /// The paired devices that offer a serial port (Classic), in the system's order. Android, macOS and Windows;
    /// `Unsupported` on iOS, which lets no program use Classic Bluetooth's serial port.
    public fn pairedPrinters() -> Result<Vector<BluetoothDevice>, BluetoothError> => Bluetooth.list(0, 0);

    /// The Low Energy devices in range that advertise a printer's service (`18F0`, `FF00`, or
    /// `E7810A71-73AE-499D-8C15-FAA9AEF0C3F2`), found within `milliseconds`. Every system; on iOS the only way to find
    /// a printer.
    public fn scanPrinters(milliseconds: u32) -> Result<Vector<BluetoothDevice>, BluetoothError> =>
        Bluetooth.list(1, milliseconds);

    fn errorOf(code: i64) -> BluetoothError => match (code) {
        2 => BluetoothError.Off,
        3 => BluetoothError.Denied,
        4 => BluetoothError.NotFound,
        5 => BluetoothError.Refused,
        6 => BluetoothError.Lost,
        7 => BluetoothError.Resources,
        _ => BluetoothError.Unsupported,
    };

    /// Safety: the runtime gives a list it allocated, `length` bytes of records (a transport byte, `C` or `L`, then the
    /// address and the name, each ended by a zero byte), which is copied and given back to it here.
    fn list(scan: u32, milliseconds: u32) -> Result<Vector<BluetoothDevice>, BluetoothError> {
        var list = 0 as *u8;
        let length = unsafe { ceesafe_bluetooth_list(scan, milliseconds, borrow mut list as *mut (*u8)) };
        if (length < 0) {
            return Err(Bluetooth.errorOf(0 - length));
        }
        var devices = Vector<BluetoothDevice>.create();
        if (length == 0) {
            return Ok(devices);
        }
        let bytes = unsafe { Slice.fromRaw(list, truncate<usize>(length)) };
        let decoded = Bluetooth.decode(bytes, mut devices);
        unsafe { ceesafe_bluetooth_free(list); }
        if (!decoded) {
            return Err(BluetoothError.Resources);
        }
        return Ok(devices);
    }

    /// The records of `bytes` into `devices`; false when memory ran out or a record is not one.
    fn decode(bytes: Slice<u8>, devices: borrow mut Vector<BluetoothDevice>) -> bool {
        var at: usize = 0;
        while (at < bytes.length) {
            let transport = if (bytes[at] == 'L' as u8) BluetoothTransport.LowEnergy else BluetoothTransport.Classic;
            at += 1;
            let address = match (Bluetooth.field(bytes, mut at)) {
                Some(a) => a,
                null => { return false; }
            };
            let name = match (Bluetooth.field(bytes, mut at)) {
                Some(n) => n,
                null => { return false; }
            };
            match (devices.push(BluetoothDevice { name: name, address: address, transport: transport })) {
                Ok() => {}
                Err(_) => { return false; }
            }
        }
        return true;
    }

    /// The text from `at` to the next zero byte, which `at` is moved past.
    fn field(bytes: Slice<u8>, at: borrow mut usize) -> String? {
        var end: usize = at;
        while (end < bytes.length && bytes[end] != 0) {
            end += 1;
        }
        if (end >= bytes.length) {
            return null;
        }
        let text = StringView.fromUtf8(bytes[at..end]) ?? "";
        at = end + 1;
        return match (String.from(text)) {
            Ok(s) => Some(s),
            Err(_) => null,
        };
    }
}

/// A connection to a printer (ADR 0177): bytes written in order, each `write` returning once the system has taken
/// them (Low Energy: once the printer has acknowledged them, where its characteristic acknowledges writes). Dropping
/// it closes it.
@noncopy
public struct BluetoothLink {
    private link: i64;

    /// Connects to `device`: Classic, to its Serial Port Profile's channel; Low Energy, to the first characteristic of
    /// a printer's service that takes writes.
    /// Safety: the runtime reads the address during the call; the link it gives is kept and given back once (drop).
    public fn open(device: borrow BluetoothDevice) -> Result<BluetoothLink, BluetoothError> {
        let transport: u32 = match (device.transport) {
            BluetoothTransport.Classic => 0,
            BluetoothTransport.LowEnergy => 1,
        };
        let address = device.address.view();
        let link = unsafe { ceesafe_bluetooth_open(transport, address.ptr, address.length as u64) };
        if (link < 0) {
            return Err(Bluetooth.errorOf(0 - link));
        }
        return Ok(BluetoothLink { link: link });
    }

    /// Writes `bytes`, all of them, in order.
    /// Safety: the link is the runtime's, open until drop; the runtime reads the bytes during the call.
    public fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, BluetoothError> {
        if (bytes.length == 0) {
            return Ok();
        }
        let code = unsafe { ceesafe_bluetooth_write(this.link, bytes.ptr, bytes.length as u64) };
        if (code != 0) {
            return Err(Bluetooth.errorOf((0 - code) as i64));
        }
        return Ok();
    }

    /// Safety: the link is the one the runtime gave, given back once.
    drop {
        unsafe { ceesafe_bluetooth_close(this.link); }
    }
}
