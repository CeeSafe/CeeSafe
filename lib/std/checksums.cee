// Checksums and hashes (ADR 0075 §2.5): CRC-32, CRC-32C, CRC-64/NVME, Adler-32 (ADR 0196), MD5, SHA-1, SHA-256 and
// HMAC-SHA-256, in pure CeeSafe. Each is incremental (`create`, `update`, `finish`) and has a one-call `of`. The CRC tables and the round
// constants are in checksum_tables.cee, which tools/gen_checksums.py writes. The CRCs are table-driven, slicing-by-8.
// Crc32c and Crc32 use the CPU's instructions where the runtime finds them (ADRs 0089 and 0194), with the same results
// and the same API.

extern "C" {
    @effects()
    fn ceesafe_crc32c_available() -> u32;
    @effects()
    fn ceesafe_crc32c_update(crc: u32, bytes: *u8, length: u64) -> u32;
    @effects()
    fn ceesafe_crc32_available() -> u32;
    @effects()
    fn ceesafe_crc32_update(crc: u32, bytes: *u8, length: u64) -> u32;
}

/// CRC-32 (IEEE 802.3, ISO-HDLC: polynomial 0x04C11DB7, reflected, initial value and final XOR all ones), the checksum
/// of the S3 `x-amz-checksum-crc32` header, gzip, zip and PNG, and zlib's `crc32`. `Crc32.of("123456789".bytes())` is
/// 0xCBF43926.
public struct Crc32 {
    state: u32; // the register, before the final XOR

    /// A checksum of no bytes yet.
    public fn create() -> Crc32 => Crc32 { state: 0xFFFFFFFF };

    /// Feeds `bytes`: through the CPU where the runtime has a path for it (the CRC extension's `crc32x` on AArch64,
    /// carry-less multiply folding on x86-64; ADR 0194 §2.3), as many bytes as that path takes at a time, else, and
    /// for the rest, eight at a time through the slicing tables, then one at a time.
    /// Safety: the runtime reads at most the slice's length, during the call only, and keeps no pointer.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        var c = this.state;
        var i: usize = 0;
        let n = bytes.length;
        let step = unsafe { ceesafe_crc32_available() } as usize;
        if (step != 0 && n >= step) {
            i = n - n % step;
            c = unsafe { ceesafe_crc32_update(c, bytes.ptr, i as u64) };
        }
        while (n - i >= 8) {
            let lo = c ^ bytes.readLE<u32>(i);
            let hi = bytes.readLE<u32>(i + 4);
            c = CRC32_SLICES[7 * 256 + (lo & 0xFF) as usize] ^ CRC32_SLICES[6 * 256 + ((lo >> 8) & 0xFF) as usize] ^
                CRC32_SLICES[5 * 256 + ((lo >> 16) & 0xFF) as usize] ^ CRC32_SLICES[4 * 256 + (lo >> 24) as usize] ^
                CRC32_SLICES[3 * 256 + (hi & 0xFF) as usize] ^ CRC32_SLICES[2 * 256 + ((hi >> 8) & 0xFF) as usize] ^
                CRC32_SLICES[256 + ((hi >> 16) & 0xFF) as usize] ^ CRC32_SLICES[(hi >> 24) as usize];
            i += 8;
        }
        while (i < n) {
            c = CRC32_SLICES[((c ^ bytes[i] as u32) & 0xFF) as usize] ^ (c >> 8);
            i += 1;
        }
        this.state = c;
    }

    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> u32 => this.state ^ 0xFFFFFFFF;

    /// The checksum of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> u32 {
        var c = Crc32.create();
        c.update(bytes);
        return c.finish();
    }
}

/// CRC-32C (Castagnoli: polynomial 0x1EDC6F41, reflected, initial value and final XOR all ones), the checksum of
/// iSCSI, ext4, Btrfs and the S3 `x-amz-checksum-crc32c` header. `Crc32c.of("123456789".bytes())` is 0xE3069283.
public struct Crc32c {
    state: u32; // the register, before the final XOR

    /// A checksum of no bytes yet.
    public fn create() -> Crc32c => Crc32c { state: 0xFFFFFFFF };

    /// Feeds `bytes`: through the CPU's CRC-32C instruction where it has one (SSE4.2 on x86-64, the CRC extension on
    /// AArch64; ADR 0089), else eight at a time through the slicing tables, then the rest one at a time.
    /// Safety: the runtime reads at most the slice's length, during the call only, and keeps no pointer.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        if (unsafe { ceesafe_crc32c_available() } != 0) {
            this.state = unsafe { ceesafe_crc32c_update(this.state, bytes.ptr, bytes.length as u64) };
            return;
        }
        var c = this.state;
        var i: usize = 0;
        let n = bytes.length;
        while (n - i >= 8) {
            let lo = c ^ bytes.readLE<u32>(i);
            let hi = bytes.readLE<u32>(i + 4);
            c = CRC32C_SLICES[7 * 256 + (lo & 0xFF) as usize] ^ CRC32C_SLICES[6 * 256 + ((lo >> 8) & 0xFF) as usize] ^
                CRC32C_SLICES[5 * 256 + ((lo >> 16) & 0xFF) as usize] ^ CRC32C_SLICES[4 * 256 + (lo >> 24) as usize] ^
                CRC32C_SLICES[3 * 256 + (hi & 0xFF) as usize] ^ CRC32C_SLICES[2 * 256 + ((hi >> 8) & 0xFF) as usize] ^
                CRC32C_SLICES[256 + ((hi >> 16) & 0xFF) as usize] ^ CRC32C_SLICES[(hi >> 24) as usize];
            i += 8;
        }
        while (i < n) {
            c = CRC32C_SLICES[((c ^ bytes[i] as u32) & 0xFF) as usize] ^ (c >> 8);
            i += 1;
        }
        this.state = c;
    }

    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> u32 => this.state ^ 0xFFFFFFFF;

    /// The checksum of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> u32 {
        var c = Crc32c.create();
        c.update(bytes);
        return c.finish();
    }
}

/// CRC-64/NVME (polynomial 0xAD93D23594C93659, reflected, initial value and final XOR all ones), the checksum of the
/// S3 `x-amz-checksum-crc64nvme` header. `Crc64Nvme.of("123456789".bytes())` is 0xAE8B14860A799888.
public struct Crc64Nvme {
    state: u64; // the register, before the final XOR

    /// A checksum of no bytes yet.
    public fn create() -> Crc64Nvme => Crc64Nvme { state: 0xFFFFFFFFFFFFFFFF };

    /// Feeds `bytes`: eight at a time through the slicing tables, then the rest one at a time.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        var c = this.state;
        var i: usize = 0;
        let n = bytes.length;
        while (n - i >= 8) {
            let w = c ^ bytes.readLE<u64>(i);
            c = CRC64_NVME_SLICES[7 * 256 + (w & 0xFF) as usize] ^
                CRC64_NVME_SLICES[6 * 256 + ((w >> 8) & 0xFF) as usize] ^
                CRC64_NVME_SLICES[5 * 256 + ((w >> 16) & 0xFF) as usize] ^
                CRC64_NVME_SLICES[4 * 256 + ((w >> 24) & 0xFF) as usize] ^
                CRC64_NVME_SLICES[3 * 256 + ((w >> 32) & 0xFF) as usize] ^
                CRC64_NVME_SLICES[2 * 256 + ((w >> 40) & 0xFF) as usize] ^
                CRC64_NVME_SLICES[256 + ((w >> 48) & 0xFF) as usize] ^ CRC64_NVME_SLICES[(w >> 56) as usize];
            i += 8;
        }
        while (i < n) {
            c = CRC64_NVME_SLICES[((c ^ bytes[i] as u64) & 0xFF) as usize] ^ (c >> 8);
            i += 1;
        }
        this.state = c;
    }

    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> u64 => this.state ^ 0xFFFFFFFFFFFFFFFF;

    /// The checksum of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> u64 {
        var c = Crc64Nvme.create();
        c.update(bytes);
        return c.finish();
    }
}

/// Adler-32 (RFC 1950 §8.2), zlib's checksum: two sums modulo 65521, the second of the first's running values, as
/// `(b << 16) | a`. `Adler32.of("123456789".bytes())` is 0x091E01DE. It is weak for short inputs and no hash: it is
/// here for the zlib format (ADR 0196).
public struct Adler32 {
    a: u32; // 1 plus the bytes, modulo 65521
    b: u32; // the sum of `a` after each byte, modulo 65521

    /// A checksum of no bytes yet (1).
    public fn create() -> Adler32 => Adler32 { a: 1, b: 0 };

    /// Feeds `bytes`: in runs of 5,552, the most for which neither sum can pass 2^32 before it is reduced, eight
    /// bytes at a time and then the rest one at a time.
    @effects()
    public fn update(borrow mut this, bytes: Slice<u8>) {
        var a = this.a;
        var b = this.b;
        var i: usize = 0;
        let n = bytes.length;
        while (i < n) {
            let end = if (n - i > 5552) i + 5552 else n;
            while (end - i >= 8) {
                a += bytes[i] as u32;
                b += a;
                a += bytes[i + 1] as u32;
                b += a;
                a += bytes[i + 2] as u32;
                b += a;
                a += bytes[i + 3] as u32;
                b += a;
                a += bytes[i + 4] as u32;
                b += a;
                a += bytes[i + 5] as u32;
                b += a;
                a += bytes[i + 6] as u32;
                b += a;
                a += bytes[i + 7] as u32;
                b += a;
                i += 8;
            }
            while (i < end) {
                a += bytes[i] as u32;
                b += a;
                i += 1;
            }
            a %= 65521;
            b %= 65521;
        }
        this.a = a;
        this.b = b;
    }

    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> u32 => (this.b << 16) | this.a;

    /// The checksum of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> u32 {
        var c = Adler32.create();
        c.update(bytes);
        return c.finish();
    }
}

/// MD5 (RFC 1321): a 16-byte digest. **MD5 is broken as a signature**: collisions are cheap to make, so it must
/// never authenticate anything or stand for a value an attacker chooses. It is here for S3 ETags and `Content-MD5`
/// only, which detect accidental corruption. For anything else use Sha256 or HmacSha256.
public struct Md5 {
    state: [u32; 4];
    block: [u8; 64]; // a partial block of `used` bytes
    used: usize;
    length: u64; // bytes fed, modulo 2^64

    /// A digest of no bytes yet.
    public fn create() -> Md5 => Md5 {
        state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476],
        block: [0u8; 64],
        used: 0,
        length: 0,
    };

    /// Compresses the 64 bytes at `at` of `data` into `state` (RFC 1321 §3.4).
    fn compress(state: borrow mut [u32; 4], data: Slice<u8>, at: usize) {
        let block = data[at..at + 64];
        var m = [0u32; 16];
        for (k in 0..16usize) {
            m[k] = block.readLE<u32>(4 * k);
        }
        var a = state[0];
        var b = state[1];
        var c = state[2];
        var d = state[3];
        for (i in 0..16usize) {
            let f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
            let s: u32 = match (i & 3) {
                0 => 7,
                1 => 12,
                2 => 17,
                _ => 22,
            };
            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[i]);
            a = d;
            d = c;
            c = b;
            b = b.wrappingAdd(t.rotateLeft(s));
        }
        for (i in 16..32usize) {
            let f = (d & b) | ((d ^ 0xFFFFFFFF) & c);
            let s: u32 = match (i & 3) {
                0 => 5,
                1 => 9,
                2 => 14,
                _ => 20,
            };
            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[(5 * i + 1) & 15]);
            a = d;
            d = c;
            c = b;
            b = b.wrappingAdd(t.rotateLeft(s));
        }
        for (i in 32..48usize) {
            let f = b ^ c ^ d;
            let s: u32 = match (i & 3) {
                0 => 4,
                1 => 11,
                2 => 16,
                _ => 23,
            };
            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[(3 * i + 5) & 15]);
            a = d;
            d = c;
            c = b;
            b = b.wrappingAdd(t.rotateLeft(s));
        }
        for (i in 48..64usize) {
            let f = c ^ (b | (d ^ 0xFFFFFFFF));
            let s: u32 = match (i & 3) {
                0 => 6,
                1 => 10,
                2 => 15,
                _ => 21,
            };
            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[(7 * i) & 15]);
            a = d;
            d = c;
            c = b;
            b = b.wrappingAdd(t.rotateLeft(s));
        }
        state[0] = state[0].wrappingAdd(a);
        state[1] = state[1].wrappingAdd(b);
        state[2] = state[2].wrappingAdd(c);
        state[3] = state[3].wrappingAdd(d);
    }

    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        let n = bytes.length;
        var k: usize = 0;
        this.length = this.length.wrappingAdd(n as u64);
        if (this.used > 0) {
            while (this.used < 64 && k < n) {
                this.block[this.used] = bytes[k];
                this.used += 1;
                k += 1;
            }
            if (this.used < 64) {
                return;
            }
            Md5.compress(mut this.state, this.block[..], 0);
            this.used = 0;
        }
        while (n - k >= 64) {
            Md5.compress(mut this.state, bytes, k);
            k += 64;
        }
        while (k < n) {
            this.block[this.used] = bytes[k];
            this.used += 1;
            k += 1;
        }
    }

    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> [u8; 16] {
        var h = Md5 { state: this.state, block: this.block, used: this.used, length: this.length };
        let bits = this.length.wrappingMul(8);
        var pad = [0u8; 72];
        pad[0] = 0x80;
        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;
        for (k in 0..8usize) {
            pad[zeros + k] = truncate<u8>(bits >> (8 * k as u64));
        }
        h.update(pad[..zeros + 8]);
        var digest = [0u8; 16];
        for (k in 0..4usize) {
            digest[..].writeLE(4 * k, h.state[k]);
        }
        return digest;
    }

    /// The digest of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> [u8; 16] {
        var h = Md5.create();
        h.update(bytes);
        return h.finish();
    }
}

/// SHA-1 (FIPS 180-4 §6.1): a 20-byte digest. **SHA-1 is broken for collisions** (SHAttered, 2017): two inputs with
/// the same digest can be made, so it must never sign, authenticate or name a value an attacker chooses. It is here
/// for the protocols that name it: S3's `x-amz-checksum-sha1`, the WebSocket handshake, Git's object ids. For anything
/// else use Sha256, or HmacSha256 for a code under a key.
public struct Sha1 {
    state: [u32; 5];
    block: [u8; 64]; // a partial block of `used` bytes
    used: usize;
    length: u64; // bytes fed, modulo 2^64

    /// A digest of no bytes yet.
    public fn create() -> Sha1 => Sha1 {
        state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0],
        block: [0u8; 64],
        used: 0,
        length: 0,
    };

    /// Compresses the 64 bytes at `at` of `data` into `state` (FIPS 180-4 §6.1.2).
    fn compress(state: borrow mut [u32; 5], data: Slice<u8>, at: usize) {
        let block = data[at..at + 64];
        var w = [0u32; 80];
        for (t in 0..16usize) {
            w[t] = block.readBE<u32>(4 * t);
        }
        for (t in 16..80usize) {
            w[t] = (w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]).rotateLeft(1);
        }
        var a = state[0];
        var b = state[1];
        var c = state[2];
        var d = state[3];
        var e = state[4];
        for (t in 0..20usize) {
            let f = (b & c) | ((b ^ 0xFFFFFFFF) & d); // Ch
            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0x5A827999).wrappingAdd(w[t]);
            e = d;
            d = c;
            c = b.rotateLeft(30);
            b = a;
            a = x;
        }
        for (t in 20..40usize) {
            let f = b ^ c ^ d; // Parity
            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0x6ED9EBA1).wrappingAdd(w[t]);
            e = d;
            d = c;
            c = b.rotateLeft(30);
            b = a;
            a = x;
        }
        for (t in 40..60usize) {
            let f = (b & c) | (b & d) | (c & d); // Maj
            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0x8F1BBCDC).wrappingAdd(w[t]);
            e = d;
            d = c;
            c = b.rotateLeft(30);
            b = a;
            a = x;
        }
        for (t in 60..80usize) {
            let f = b ^ c ^ d; // Parity
            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0xCA62C1D6).wrappingAdd(w[t]);
            e = d;
            d = c;
            c = b.rotateLeft(30);
            b = a;
            a = x;
        }
        state[0] = state[0].wrappingAdd(a);
        state[1] = state[1].wrappingAdd(b);
        state[2] = state[2].wrappingAdd(c);
        state[3] = state[3].wrappingAdd(d);
        state[4] = state[4].wrappingAdd(e);
    }

    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        let n = bytes.length;
        var k: usize = 0;
        this.length = this.length.wrappingAdd(n as u64);
        if (this.used > 0) {
            while (this.used < 64 && k < n) {
                this.block[this.used] = bytes[k];
                this.used += 1;
                k += 1;
            }
            if (this.used < 64) {
                return;
            }
            Sha1.compress(mut this.state, this.block[..], 0);
            this.used = 0;
        }
        while (n - k >= 64) {
            Sha1.compress(mut this.state, bytes, k);
            k += 64;
        }
        while (k < n) {
            this.block[this.used] = bytes[k];
            this.used += 1;
            k += 1;
        }
    }

    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> [u8; 20] {
        var h = Sha1 { state: this.state, block: this.block, used: this.used, length: this.length };
        let bits = this.length.wrappingMul(8);
        var pad = [0u8; 72];
        pad[0] = 0x80;
        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;
        for (k in 0..8usize) {
            pad[zeros + k] = truncate<u8>(bits >> (8 * (7 - k) as u64));
        }
        h.update(pad[..zeros + 8]);
        var digest = [0u8; 20];
        for (k in 0..5usize) {
            digest[..].writeBE(4 * k, h.state[k]);
        }
        return digest;
    }

    /// The digest of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> [u8; 20] {
        var h = Sha1.create();
        h.update(bytes);
        return h.finish();
    }
}

/// SHA-256 (FIPS 180-4): a 32-byte digest.
public struct Sha256 {
    state: [u32; 8];
    block: [u8; 64]; // a partial block of `used` bytes
    used: usize;
    length: u64; // bytes fed, modulo 2^64

    /// Its state and partial block set to zero, in a way the C compiler keeps (ADR 0194 §2.1, ADR 0197 §2.2): for a
    /// digest that absorbed a key.
    fn wipe(borrow mut this) {
        Secret.wipe(mut this);
    }

    /// A digest of no bytes yet.
    public fn create() -> Sha256 => Sha256 {
        state: [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19],
        block: [0u8; 64],
        used: 0,
        length: 0,
    };

    /// Compresses the 64 bytes at `at` of `data` into `state` (FIPS 180-4 §6.2.2).
    fn compress(state: borrow mut [u32; 8], data: Slice<u8>, at: usize) {
        let block = data[at..at + 64];
        var w = [0u32; 64];
        for (t in 0..16usize) {
            w[t] = block.readBE<u32>(4 * t);
        }
        for (t in 16..64usize) {
            let x = w[t - 15];
            let y = w[t - 2];
            let s0 = x.rotateRight(7) ^ x.rotateRight(18) ^ (x >> 3);
            let s1 = y.rotateRight(17) ^ y.rotateRight(19) ^ (y >> 10);
            w[t] = w[t - 16].wrappingAdd(s0).wrappingAdd(w[t - 7]).wrappingAdd(s1);
        }
        var a = state[0];
        var b = state[1];
        var c = state[2];
        var d = state[3];
        var e = state[4];
        var f = state[5];
        var g = state[6];
        var h = state[7];
        for (t in 0..64usize) {
            let s1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25);
            let choice = (e & f) ^ ((e ^ 0xFFFFFFFF) & g);
            let t1 = h.wrappingAdd(s1).wrappingAdd(choice).wrappingAdd(SHA256_ROUNDS[t]).wrappingAdd(w[t]);
            let s0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            h = g;
            g = f;
            f = e;
            e = d.wrappingAdd(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrappingAdd(s0.wrappingAdd(majority));
        }
        state[0] = state[0].wrappingAdd(a);
        state[1] = state[1].wrappingAdd(b);
        state[2] = state[2].wrappingAdd(c);
        state[3] = state[3].wrappingAdd(d);
        state[4] = state[4].wrappingAdd(e);
        state[5] = state[5].wrappingAdd(f);
        state[6] = state[6].wrappingAdd(g);
        state[7] = state[7].wrappingAdd(h);
    }

    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        let n = bytes.length;
        var k: usize = 0;
        this.length = this.length.wrappingAdd(n as u64);
        if (this.used > 0) {
            while (this.used < 64 && k < n) {
                this.block[this.used] = bytes[k];
                this.used += 1;
                k += 1;
            }
            if (this.used < 64) {
                return;
            }
            Sha256.compress(mut this.state, this.block[..], 0);
            this.used = 0;
        }
        while (n - k >= 64) {
            Sha256.compress(mut this.state, bytes, k);
            k += 64;
        }
        while (k < n) {
            this.block[this.used] = bytes[k];
            this.used += 1;
            k += 1;
        }
    }

    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> [u8; 32] {
        var h = Sha256 { state: this.state, block: this.block, used: this.used, length: this.length };
        let bits = this.length.wrappingMul(8);
        var pad = [0u8; 72];
        pad[0] = 0x80;
        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;
        for (k in 0..8usize) {
            pad[zeros + k] = truncate<u8>(bits >> (8 * (7 - k) as u64));
        }
        h.update(pad[..zeros + 8]);
        var digest = [0u8; 32];
        for (k in 0..8usize) {
            digest[..].writeBE(4 * k, h.state[k]);
        }
        return digest;
    }

    /// The digest of `bytes`, in one call.
    public fn of(bytes: Slice<u8>) -> [u8; 32] {
        var h = Sha256.create();
        h.update(bytes);
        return h.finish();
    }
}

/// HMAC-SHA-256 (RFC 2104, FIPS 198-1): a 32-byte message authentication code under a key of any length. A key longer
/// than SHA-256's 64-byte block is first replaced by its SHA-256. Compare two codes in constant time, not with an
/// early exit, where an attacker can time the comparison.
public struct HmacSha256 {
    inner: Sha256;      // fed the inner padded key, then the message
    outerKey: [u8; 64]; // the key, padded to a block, XOR 0x5C

    /// A code under `key` of no bytes yet.
    public fn create(key: Slice<u8>) -> HmacSha256 {
        var padded = [0u8; 64];
        if (key.length > 64) {
            let digest = Sha256.of(key);
            for (k in 0..32usize) {
                padded[k] = digest[k];
            }
        } else {
            for (k in 0..key.length) {
                padded[k] = key[k];
            }
        }
        var innerKey = [0u8; 64];
        var outerKey = [0u8; 64];
        for (k in 0..64usize) {
            innerKey[k] = padded[k] ^ 0x36;
            outerKey[k] = padded[k] ^ 0x5C;
        }
        var inner = Sha256.create();
        inner.update(innerKey[..]);
        let mac = HmacSha256 { inner: inner, outerKey: outerKey };
        // The key's copies here, wiped (ADR 0194 §2.1, G34): the code keeps only its own.
        Secret.wipe(mut padded);
        Secret.wipe(mut innerKey);
        Secret.wipe(mut outerKey);
        inner.wipe();
        return mac;
    }

    /// A second code with the same key and the bytes fed so far, to feed apart. A code is not copied by `=`, since
    /// its drop wipes its key (ADR 0194 §2.1).
    public fn clone(borrow this) -> HmacSha256 => HmacSha256 { inner: this.inner, outerKey: this.outerKey };

    /// Feeds `bytes` of the message.
    public fn update(borrow mut this, bytes: Slice<u8>) {
        this.inner.update(bytes);
    }

    /// The code of the bytes fed so far. It does not change the state: more bytes may be fed after it.
    public fn finish(borrow this) -> [u8; 32] {
        var inner = this.inner.finish();
        var outer = Sha256.create();
        outer.update(this.outerKey[..]);
        outer.update(inner[..]);
        let code = outer.finish();
        Secret.wipe(mut inner);
        outer.wipe(); // it absorbed the padded key
        return code;
    }

    /// The code of `bytes` under `key`, in one call.
    public fn of(key: Slice<u8>, bytes: Slice<u8>) -> [u8; 32] {
        var h = HmacSha256.create(key);
        h.update(bytes);
        return h.finish();
    }

    /// The key's state wiped when the code is dropped (ADR 0194 §2.1, G34): the padded key XOR 0x5C, and the inner
    /// digest that absorbed it XOR 0x36.
    drop {
        this.inner.wipe();
        Secret.wipe(mut this.outerKey);
    }
}
