// Ciphers (ADR 0135): AES-256-GCM, authenticated encryption in place. Where the CPU has AES and carry-less multiply
// instructions (AES-NI and PCLMULQDQ on x86-64, the AES extension on AArch64) the runtime runs them; elsewhere, and in
// the interpreter, the code below runs: the same cipher with no table indexed by a secret, the S-box as a circuit over
// the bits of 64 bytes at once and GHASH as a shift-and-add multiply with masks in place of branches. Both give the
// same bytes. And ConstantTime.equal, a comparison whose time does not depend on where two slices differ.

extern "C" {
    @effects()
    fn ceesafe_aes256gcm_available() -> u32;
    @effects()
    fn ceesafe_aes256gcm_expand(key: *u8, schedule: *mut u8);
    @effects()
    fn ceesafe_aes256gcm_seal(
        schedule: *u8,
        nonce: *u8,
        aad: *u8,
        aadLength: u64,
        data: *mut u8,
        length: u64,
        tag: *mut u8,
    );
    @effects()
    fn ceesafe_aes256gcm_open(
        schedule: *u8,
        nonce: *u8,
        aad: *u8,
        aadLength: u64,
        data: *mut u8,
        length: u64,
        tag: *u8,
    ) -> u32;
}

/// The most bytes one call seals or opens: GCM's limit for one nonce, 2^36 - 32. (A function: a library's constant
/// would be listed in every program's HIR.)
fn aesGcmMostBytes() -> u64 => 68719476704;

/// AES-256 in Galois/Counter Mode: `seal` encrypts a buffer in place and returns a 16-byte tag over it and over
/// associated data that is authenticated and not encrypted; `open` checks the tag and decrypts, or refuses.
///
/// **A nonce must never be used twice with one key.** Two messages sealed under the same key and nonce give away the
/// XOR of their texts and let tags be forged. Use a counter that never repeats under the key, or a key made for one
/// message; `Random.fill` gives keys. The value holds the expanded key, and wipes it when it is dropped.
public struct Aes256Gcm {
    // With the CPU's instructions: the 15 round keys and four powers of the GHASH key, as the runtime wrote them.
    // Without: the round keys, and the GHASH key in `h0` and `h1`.
    schedule: [u8; 304];
    h0: u64;
    h1: u64;
    hardware: bool;

    /// A cipher for `key`; null unless the key is 32 bytes.
    /// Safety: the runtime reads 32 bytes of the key and writes the 304 of the schedule, during the call only.
    public fn create(key: Slice<u8>) -> Aes256Gcm? {
        if (key.length != 32) { return null; }
        var c = Aes256Gcm { schedule: [0u8; 304], h0: 0, h1: 0, hardware: false };
        if (unsafe { ceesafe_aes256gcm_available() } != 0) {
            c.hardware = true;
            hardExpand(key, mut c.schedule[..]);
            return c;
        }
        softExpand(mut c, key);
        return c;
    }

    /// Encrypts `data` in place under `nonce` and returns the tag of `associated` and the ciphertext. Panics if
    /// `data` is longer than 2^36 - 32 bytes, GCM's limit for one nonce.
    /// Safety: the runtime reads the schedule, the nonce's 12 bytes and the associated data, reads and writes
    /// `data`'s length, and writes the tag's 16 bytes, during the call only.
    public fn seal(borrow this, nonce: [u8; 12], associated: Slice<u8>, data: SliceMut<u8>) -> [u8; 16] {
        if (data.length as u64 > aesGcmMostBytes()) {
            panic("Aes256Gcm seals at most 2^36 - 32 bytes under one nonce");
        }
        if (!this.hardware) {
            softCtr(this, borrow nonce, data);
            return softTag(this, borrow nonce, associated, data);
        }
        var tag = [0u8; 16];
        hardSeal(this.schedule[..], nonce[..], associated, data, mut tag[..]);
        return tag;
    }

    /// Checks `tag` against `associated` and the ciphertext `data`, in time that does not depend on where they
    /// differ. True, and `data` decrypted in place, when the tag is theirs; false, and `data` zeroed, when it is not:
    /// nothing of a text that was changed is given back. Panics as `seal` does for a longer `data`.
    /// Safety: as `seal`; the tag's 16 bytes are read.
    public fn open(
        borrow this,
        nonce: [u8; 12],
        associated: Slice<u8>,
        data: SliceMut<u8>,
        tag: [u8; 16],
    ) -> bool {
        if (data.length as u64 > aesGcmMostBytes()) {
            panic("Aes256Gcm opens at most 2^36 - 32 bytes under one nonce");
        }
        if (this.hardware) {
            return unsafe { ceesafe_aes256gcm_open(
                this.schedule[..].ptr,
                nonce[..].ptr,
                associated.ptr,
                associated.length as u64,
                data.ptr,
                data.length as u64,
                tag[..].ptr,
            ) } != 0;
        }
        let expected = softTag(this, borrow nonce, associated, data);
        if (!ConstantTime.equal(expected[..], tag[..])) {
            for (i in 0..data.length) { data[i] = 0; }
            return false;
        }
        softCtr(this, borrow nonce, data);
        return true;
    }

    drop {
        for (i in 0..304) { this.schedule[i] = 0; }
        this.h0 = 0;
        this.h1 = 0;
    }
}

/// Comparisons for secrets.
public struct ConstantTime {
    /// Whether two slices hold the same bytes, in time that depends on their lengths only: every byte is compared,
    /// wherever the first difference is. For tags, digests and tokens, where `==` would tell an attacker how much of a
    /// guess was right. Slices of different lengths are different.
    public fn equal(a: Slice<u8>, b: Slice<u8>) -> bool {
        if (a.length != b.length) { return false; }
        var diff: u8 = 0;
        for (i in 0..a.length) { diff = diff | (a[i] ^ b[i]); }
        return diff == 0;
    }
}

// ---- With the CPU's instructions ----

/// Safety: the runtime reads 32 bytes of the key and writes the 304 of the schedule, during the call only.
fn hardExpand(key: Slice<u8>, schedule: SliceMut<u8>) {
    unsafe { ceesafe_aes256gcm_expand(key.ptr, schedule.ptr); }
}

/// Safety: the runtime reads the schedule's 304 bytes, the nonce's 12 and the associated data, reads and writes
/// `data`'s length, and writes the tag's 16 bytes, during the call only.
fn hardSeal(schedule: Slice<u8>, nonce: Slice<u8>, associated: Slice<u8>, data: SliceMut<u8>, tag: SliceMut<u8>) {
    unsafe {
        ceesafe_aes256gcm_seal(
            schedule.ptr,
            nonce.ptr,
            associated.ptr,
            associated.length as u64,
            data.ptr,
            data.length as u64,
            tag.ptr,
        );
    }
}

// ---- Without the CPU's instructions ----

/// The key schedule of AES-256 into `k`, and the GHASH key, the zero block encrypted.
fn softExpand(k: borrow mut Aes256Gcm, key: Slice<u8>) {
    for (i in 0..32) { k.schedule[i] = key[i]; }
    let rcon = [0x01u8, 0x02u8, 0x04u8, 0x08u8, 0x10u8, 0x20u8, 0x40u8];
    var box = [0u8; 64];
    for (i in 8..60) {
        var t = [k.schedule[i * 4 - 4], k.schedule[i * 4 - 3], k.schedule[i * 4 - 2], k.schedule[i * 4 - 1]];
        if (i % 4 == 0) {
            // SubWord by the circuit, after RotWord for the first word of each key.
            if (i % 8 == 0) { t = [t[1], t[2], t[3], t[0]]; }
            for (j in 0..4) { box[j] = t[j]; }
            softSubBytes(mut box);
            for (j in 0..4) { t[j] = box[j]; }
            if (i % 8 == 0) { t[0] = t[0] ^ rcon[i / 8 - 1]; }
        }
        for (j in 0..4) { k.schedule[i * 4 + j] = k.schedule[i * 4 - 32 + j] ^ t[j]; }
    }
    var zero = [0u8; 64];
    softEncrypt4(k, mut zero);
    for (i in 0..8) {
        k.h0 = (k.h0 << 8) | (zero[i] as u64);
        k.h1 = (k.h1 << 8) | (zero[8 + i] as u64);
    }
    for (i in 0..64) { box[i] = 0; }
}

/// SubBytes of 64 bytes at once: bit `b` of byte `i` is bit `i` of plane `b`, and the S-box is Boyar and Peralta's
/// circuit over the eight planes.
fn softSubBytes(bytes: borrow mut [u8; 64]) {
    var q = [0u64; 8];
    for (i in 0..64) {
        let v = bytes[i] as u64;
        for (b in 0..8) { q[b] = q[b] | (((v >> (b as u64)) & 1) << (i as u64)); }
    }
    let ones: u64 = 0xFFFFFFFFFFFFFFFF;
    let x0 = q[7];
    let x1 = q[6];
    let x2 = q[5];
    let x3 = q[4];
    let x4 = q[3];
    let x5 = q[2];
    let x6 = q[1];
    let x7 = q[0];
    let y14 = x3 ^ x5;
    let y13 = x0 ^ x6;
    let y9 = x0 ^ x3;
    let y8 = x0 ^ x5;
    let t0 = x1 ^ x2;
    let y1 = t0 ^ x7;
    let y4 = y1 ^ x3;
    let y12 = y13 ^ y14;
    let y2 = y1 ^ x0;
    let y5 = y1 ^ x6;
    let y3 = y5 ^ y8;
    let t1 = x4 ^ y12;
    let y15 = t1 ^ x5;
    let y20 = t1 ^ x1;
    let y6 = y15 ^ x7;
    let y10 = y15 ^ t0;
    let y11 = y20 ^ y9;
    let y7 = x7 ^ y11;
    let y17 = y10 ^ y11;
    let y19 = y10 ^ y8;
    let y16 = t0 ^ y11;
    let y21 = y13 ^ y16;
    let y18 = x0 ^ y16;
    let t2 = y12 & y15;
    let t3 = y3 & y6;
    let t4 = t3 ^ t2;
    let t5 = y4 & x7;
    let t6 = t5 ^ t2;
    let t7 = y13 & y16;
    let t8 = y5 & y1;
    let t9 = t8 ^ t7;
    let t10 = y2 & y7;
    let t11 = t10 ^ t7;
    let t12 = y9 & y11;
    let t13 = y14 & y17;
    let t14 = t13 ^ t12;
    let t15 = y8 & y10;
    let t16 = t15 ^ t12;
    let t17 = t4 ^ t14;
    let t18 = t6 ^ t16;
    let t19 = t9 ^ t14;
    let t20 = t11 ^ t16;
    let t21 = t17 ^ y20;
    let t22 = t18 ^ y19;
    let t23 = t19 ^ y21;
    let t24 = t20 ^ y18;
    let t25 = t21 ^ t22;
    let t26 = t21 & t23;
    let t27 = t24 ^ t26;
    let t28 = t25 & t27;
    let t29 = t28 ^ t22;
    let t30 = t23 ^ t24;
    let t31 = t22 ^ t26;
    let t32 = t31 & t30;
    let t33 = t32 ^ t24;
    let t34 = t23 ^ t33;
    let t35 = t27 ^ t33;
    let t36 = t24 & t35;
    let t37 = t36 ^ t34;
    let t38 = t27 ^ t36;
    let t39 = t29 & t38;
    let t40 = t25 ^ t39;
    let t41 = t40 ^ t37;
    let t42 = t29 ^ t33;
    let t43 = t29 ^ t40;
    let t44 = t33 ^ t37;
    let t45 = t42 ^ t41;
    let z0 = t44 & y15;
    let z1 = t37 & y6;
    let z2 = t33 & x7;
    let z3 = t43 & y16;
    let z4 = t40 & y1;
    let z5 = t29 & y7;
    let z6 = t42 & y11;
    let z7 = t45 & y17;
    let z8 = t41 & y10;
    let z9 = t44 & y12;
    let z10 = t37 & y3;
    let z11 = t33 & y4;
    let z12 = t43 & y13;
    let z13 = t40 & y5;
    let z14 = t29 & y2;
    let z15 = t42 & y9;
    let z16 = t45 & y14;
    let z17 = t41 & y8;
    let t46 = z15 ^ z16;
    let t47 = z10 ^ z11;
    let t48 = z5 ^ z13;
    let t49 = z9 ^ z10;
    let t50 = z2 ^ z12;
    let t51 = z2 ^ z5;
    let t52 = z7 ^ z8;
    let t53 = z0 ^ z3;
    let t54 = z6 ^ z7;
    let t55 = z16 ^ z17;
    let t56 = z12 ^ t48;
    let t57 = t50 ^ t53;
    let t58 = z4 ^ t46;
    let t59 = z3 ^ t54;
    let t60 = t46 ^ t57;
    let t61 = z14 ^ t57;
    let t62 = t52 ^ t58;
    let t63 = t49 ^ t58;
    let t64 = z4 ^ t59;
    let t65 = t61 ^ t62;
    let t66 = z1 ^ t63;
    let s0 = t59 ^ t63;
    let s6 = t56 ^ t62 ^ ones;
    let s7 = t48 ^ t60 ^ ones;
    let t67 = t64 ^ t65;
    let s3 = t53 ^ t66;
    let s4 = t51 ^ t66;
    let s5 = t47 ^ t65;
    let s1 = t64 ^ s3 ^ ones;
    let s2 = t55 ^ t67 ^ ones;
    let out = [s7, s6, s5, s4, s3, s2, s1, s0];
    for (i in 0..64) {
        var v: u64 = 0;
        for (b in 0..8) { v = v | (((out[b] >> (i as u64)) & 1) << (b as u64)); }
        bytes[i] = truncate<u8>(v);
    }
}

/// A byte times x in AES's field: the reduction by a mask, not a branch.
fn softXtime(b: u8) -> u8 {
    let v = b as u32;
    return truncate<u8>(((v << 1) & 0xFF) ^ (0x1B * (v >> 7)));
}

/// The rounds of AES-256 on four blocks at once, in place.
fn softEncrypt4(k: borrow Aes256Gcm, s: borrow mut [u8; 64]) {
    for (i in 0..64) { s[i] = s[i] ^ k.schedule[i % 16]; }
    var t = [0u8; 64];
    for (round in 1..15) {
        softSubBytes(s);
        // ShiftRows: row r of each block moves r columns to the left.
        for (i in 0..64) {
            let block = i / 16;
            let column = (i % 16) / 4;
            let row = i % 4;
            t[i] = s[block * 16 + ((column + row) % 4) * 4 + row];
        }
        if (round < 14) {
            // MixColumns: each column times the fixed polynomial.
            for (c in 0..16) {
                let a0 = t[c * 4];
                let a1 = t[c * 4 + 1];
                let a2 = t[c * 4 + 2];
                let a3 = t[c * 4 + 3];
                let all = a0 ^ a1 ^ a2 ^ a3;
                s[c * 4] = a0 ^ all ^ softXtime(a0 ^ a1);
                s[c * 4 + 1] = a1 ^ all ^ softXtime(a1 ^ a2);
                s[c * 4 + 2] = a2 ^ all ^ softXtime(a2 ^ a3);
                s[c * 4 + 3] = a3 ^ all ^ softXtime(a3 ^ a0);
            }
        } else {
            for (i in 0..64) { s[i] = t[i]; }
        }
        for (i in 0..64) { s[i] = s[i] ^ k.schedule[round * 16 + i % 16]; }
    }
}

/// GHASH's state: a field element as two words, the block's first eight bytes in `a`.
struct SoftHash {
    a: u64;
    b: u64;
}

/// Adds a block (16 bytes at `at`, or fewer padded with zeros) to the state and multiplies by the key: 128 steps,
/// each adding the multiplicand under a mask and shifting it with the reduction under another.
fn softHashBlock(y: borrow mut SoftHash, k: borrow Aes256Gcm, bytes: Slice<u8>, at: usize, length: usize) {
    var xa: u64 = 0;
    var xb: u64 = 0;
    for (i in 0..8) {
        let p = if (i < length) bytes[at + i] as u64 else 0;
        let q = if (8 + i < length) bytes[at + 8 + i] as u64 else 0;
        xa = (xa << 8) | p;
        xb = (xb << 8) | q;
    }
    xa = xa ^ y.a;
    xb = xb ^ y.b;
    let ones: u64 = 0xFFFFFFFFFFFFFFFF;
    var za: u64 = 0;
    var zb: u64 = 0;
    var va = k.h0;
    var vb = k.h1;
    var step: u64 = 0;
    while (step < 128) {
        let word = if (step < 64) xa else xb;
        let bit = (word >> (63 - step % 64)) & 1;
        let mask = ones * bit;
        za = za ^ (va & mask);
        zb = zb ^ (vb & mask);
        let carry = ones * (vb & 1);
        vb = (vb >> 1) | (va << 63);
        va = (va >> 1) ^ (0xE100000000000000 & carry);
        step += 1;
    }
    y.a = za;
    y.b = zb;
}

fn softHash(y: borrow mut SoftHash, k: borrow Aes256Gcm, bytes: Slice<u8>) {
    var at: usize = 0;
    while (at < bytes.length) {
        let n = if (bytes.length - at < 16) bytes.length - at else 16;
        softHashBlock(y, k, bytes, at, n);
        at += 16;
    }
}

/// Four counter blocks from `counter` on, encrypted.
fn softStream(k: borrow Aes256Gcm, nonce: borrow [u8; 12], counter: u32, out: borrow mut [u8; 64]) {
    for (j in 0..4) {
        for (i in 0..12) { out[j * 16 + i] = nonce[i]; }
        let c = counter + truncate<u32>(j);
        out[j * 16 + 12] = truncate<u8>(c >> 24);
        out[j * 16 + 13] = truncate<u8>(c >> 16);
        out[j * 16 + 14] = truncate<u8>(c >> 8);
        out[j * 16 + 15] = truncate<u8>(c);
    }
    softEncrypt4(k, out);
}

/// Counter mode from counter 2 on, in place.
fn softCtr(k: borrow Aes256Gcm, nonce: borrow [u8; 12], data: SliceMut<u8>) {
    var stream = [0u8; 64];
    var counter: u32 = 2;
    var at: usize = 0;
    while (at < data.length) {
        softStream(k, nonce, counter, mut stream);
        let n = if (data.length - at < 64) data.length - at else 64;
        for (i in 0..n) { data[at + i] = data[at + i] ^ stream[i]; }
        counter += 4;
        at += 64;
    }
}

/// The tag of the associated data and the ciphertext.
fn softTag(k: borrow Aes256Gcm, nonce: borrow [u8; 12], associated: Slice<u8>, data: Slice<u8>) -> [u8; 16] {
    var y = SoftHash { a: 0, b: 0 };
    softHash(mut y, k, associated);
    softHash(mut y, k, data);
    var lengths = [0u8; 16];
    let aadBits = (associated.length as u64) * 8;
    let dataBits = (data.length as u64) * 8;
    for (i in 0..8) {
        lengths[i] = truncate<u8>(aadBits >> ((56 - i * 8) as u64));
        lengths[8 + i] = truncate<u8>(dataBits >> ((56 - i * 8) as u64));
    }
    softHashBlock(mut y, k, lengths[..], 0, 16);
    var mask = [0u8; 64];
    softStream(k, nonce, 1, mut mask);
    var tag = [0u8; 16];
    for (i in 0..8) {
        tag[i] = truncate<u8>(y.a >> ((56 - i * 8) as u64)) ^ mask[i];
        tag[8 + i] = truncate<u8>(y.b >> ((56 - i * 8) as u64)) ^ mask[8 + i];
    }
    return tag;
}
