// lib/std: lib/core's formatting helpers on a `String` (ADR 0087 §2.9): `s.appendHex(…)`, `s.appendOctal(…)`,
// `s.appendFixed(…)` and `s.appendPadded(…)`, through `Formatted`. Hosted only, since each formats into a vector first.
// And `s.appendChar(c)` and `s.appendUtf8(bytes)` (ADR 0138 §6), which need no vector.

impl AppendFormatted for String {
    fn appendHex(borrow mut this, value: u64, minWidth: u32, upper: bool) -> Result<void, AllocError> {
        var bytes = Vector<u8>.create();
        Formatted.hex(mut bytes, value, minWidth, upper)?;
        return this.append(StringView.fromUtf8(bytes.view())!);
    }

    fn appendOctal(borrow mut this, value: u64) -> Result<void, AllocError> {
        var bytes = Vector<u8>.create();
        Formatted.octal(mut bytes, value)?;
        return this.append(StringView.fromUtf8(bytes.view())!);
    }

    fn appendFixed(borrow mut this, value: f64, digits: u32) -> Result<void, AllocError> {
        var bytes = Vector<u8>.create();
        Formatted.fixed(mut bytes, value, digits)?;
        return this.append(StringView.fromUtf8(bytes.view())!);
    }

    fn appendPadded(
        borrow mut this,
        text: StringView,
        width: usize,
        align: TextAlign,
        fill: u32,
    ) -> Result<void, AllocError> {
        var bytes = Vector<u8>.create();
        Formatted.padded(mut bytes, text, width, align, fill)?;
        return this.append(StringView.fromUtf8(bytes.view())!);
    }
}

impl AppendText for String {
    fn appendChar(borrow mut this, c: u32) -> Result<bool, AllocError> {
        if (c >= 0x110000 || (c >= 0xD800 && c <= 0xDFFF)) {
            return Ok(false);
        }
        var encoded = [0u8; 4];
        var size: usize = 4;
        if (c < 0x80) {
            encoded[0] = truncate<u8>(c);
            size = 1;
        } else if (c < 0x800) {
            encoded[0] = truncate<u8>(0xC0 | (c >> 6));
            encoded[1] = truncate<u8>(0x80 | (c & 0x3F));
            size = 2;
        } else if (c < 0x10000) {
            encoded[0] = truncate<u8>(0xE0 | (c >> 12));
            encoded[1] = truncate<u8>(0x80 | ((c >> 6) & 0x3F));
            encoded[2] = truncate<u8>(0x80 | (c & 0x3F));
            size = 3;
        } else {
            encoded[0] = truncate<u8>(0xF0 | (c >> 18));
            encoded[1] = truncate<u8>(0x80 | ((c >> 12) & 0x3F));
            encoded[2] = truncate<u8>(0x80 | ((c >> 6) & 0x3F));
            encoded[3] = truncate<u8>(0x80 | (c & 0x3F));
        }
        // The bytes of a scalar value just encoded: well-formed, so the view is always there.
        this.append(StringView.fromUtf8(encoded[..size])!)?;
        return Ok(true);
    }

    fn appendUtf8(borrow mut this, bytes: Slice<u8>) -> Result<bool, AllocError> {
        match (StringView.fromUtf8(bytes)) {
            Some(text) => {
                this.append(text)?;
                return Ok(true);
            }
            null => { return Ok(false); }
        }
    }
}
