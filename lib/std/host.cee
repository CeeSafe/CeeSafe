// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Host services (type-system.md §26.7-§26.10, ADR 0028): running a program with its output captured, the kind of a
// path, directories, a fresh temporary directory, the working directory and the environment. Hosted only, over
// runtime/hosted/ceesafe_rt_io.c, whose calls return a value or a negated errno. `Process.capture` and `File.kind` are
// the checker's names for HostServices.capture and HostServices.kind.

extern "C" {
    @effects()
    fn ceesafe_clock_realtime(seconds: *mut i64, nanoseconds: *mut u32);
    @effects()
    fn ceesafe_clock_monotonic() -> u64;
    @effects()
    fn ceesafe_clock_local_offset(seconds: i64) -> i32;
    @effects()
    fn ceesafe_random_fill(out: *mut u8, length: u64) -> i64;
    @effects()
    fn ceesafe_host_env(name: *u8, length: u64, value: *mut (*u8), valueLength: *mut u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_path_kind(path: *u8, length: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_dir_create(path: *u8, length: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_dir_remove(path: *u8, length: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_dir_sync(path: *u8, length: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_space(path: *u8, length: u64, total: *mut u64, free: *mut u64, available: *mut u64) -> i64;
    @effects()
    fn ceesafe_host_open_files(current: *mut u64, maximum: *mut u64) -> i64;
    @effects()
    fn ceesafe_host_raise_open_files(to: u64, now: *mut u64) -> i64;
    @effects(alloc)
    fn ceesafe_signal_subscribe(channel: *mut void) -> i64;
    @effects()
    fn ceesafe_signal_unsubscribe(channel: *mut void);
    @effects(sleep)
    fn ceesafe_host_console_flush() -> i64;
    @effects(sleep)
    fn ceesafe_host_console_read_line(out: *mut u8, capacity: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_modified(path: *u8, length: u64, seconds: *mut i64, nanoseconds: *mut u32) -> i64;
    @effects(sleep)
    fn ceesafe_host_set_permissions(path: *u8, length: u64, mode: u32) -> i64;
    @effects(sleep)
    fn ceesafe_host_file_modified(file: *void, seconds: *mut i64, nanoseconds: *mut u32) -> i64;
    @effects(sleep)
    fn ceesafe_host_file_kind(file: *void) -> i64;
    @effects(sleep)
    fn ceesafe_host_rename(from: *u8, fromLength: u64, to: *u8, toLength: u64) -> i64;
    @effects(sleep, alloc)
    fn ceesafe_host_dir_open(path: *u8, length: u64, error: *mut i32) -> *mut void;
    @effects(sleep)
    fn ceesafe_host_dir_next(dir: *mut void, name: *mut (*u8), length: *mut u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_dir_close(dir: *mut void);
    @effects(sleep)
    fn ceesafe_host_temporary(buffer: *mut u8, capacity: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_app_data(name: *u8, length: u64, buffer: *mut u8, capacity: u64) -> i64;
    @effects(sleep)
    fn ceesafe_host_current(buffer: *mut u8, capacity: u64) -> i64;
    @effects(sleep, alloc)
    fn ceesafe_host_spawn(
        arguments: *void,
        count: u64,
        input: *u8,
        inputLength: u64,
        output: *u8,
        outputLength: u64,
        errors: *u8,
        errorsLength: u64,
    ) -> i64;
    @effects(alloc)
    fn ceesafe_host_child_start(arguments: *void, count: u64, streams: u32, handle: *mut u64) -> i64;
    @effects(alloc)
    fn ceesafe_host_child_start_with(
        arguments: *void,
        count: u64,
        streams: u32,
        handles: *u64,
        kinds: *u8,
        handed: u32,
        handle: *mut u64,
    ) -> i64;
    @effects()
    fn ceesafe_host_handover_hold(kind: u32, handle: u64) -> i64;
    @effects()
    fn ceesafe_host_handover_release(kind: u32, held: u64);
    @effects()
    fn ceesafe_host_handover_shutdown(held: u64) -> i64;
    @effects()
    fn ceesafe_host_inherited(kinds: *mut u8, capacity: u64) -> i64;
    @effects()
    fn ceesafe_host_inherited_take(place: u32, kind: u32, out: *mut u64) -> i64;
    @effects()
    fn ceesafe_host_child_poll(handle: u64, wait: u32) -> i64;
    @effects(sleep)
    fn ceesafe_host_child_wait(handle: u64) -> i64;
    @effects()
    fn ceesafe_host_child_signal(handle: u64, kill: u32) -> i64;
    @effects()
    fn ceesafe_host_child_forget(handle: u64, ended: u32);
    @effects()
    fn ceesafe_host_pid() -> i64;
    @effects(sleep)
    fn ceesafe_host_executable(buffer: *mut u8, capacity: u64) -> i64;
    @effects()
    fn ceesafe_io_kind(error: i32) -> u32;
}

/// What is at a path (`File.kind`, type-system.md §26.8).
public enum PathKind {
    File,
    Directory,
    Other,
}

/// A finished program's exit status and what it wrote (`Process.capture`, type-system.md §26.7).
public struct ProcessOutput {
    /// The exit status, or 128 plus the signal that ended it, as `Process.run` reports it.
    public status: i32;
    public stdout: Vector<u8>;
    public stderr: Vector<u8>;
}

/// What one of a child's standard streams is (`ChildOptions`, ADR 0169).
public enum ChildStream {
    /// The parent's.
    Inherit,
    /// Nothing: the null device.
    Null,
}

/// What a place of a handover holds (type-system.md §26.18, ADR 0173).
public enum InheritedKind {
    /// A TCP listener: `Inherited.listener`.
    Listener,
    /// A UDP socket: `Inherited.datagrams`.
    Datagrams,
    /// Shared memory: `Inherited.memory`.
    Memory,
}

/// What a child is to have of its parent's: listeners, UDP sockets and shared memory, in the order they are listed
/// (type-system.md §26.18, ADR 0173).
///
/// ```
/// var handover = Handover.create();
/// let socket = handover.listener(listener)?;       // place 0
/// let counters = handover.memory(shared)?;         // place 1
/// let child = Process.spawnWith(me.view(), arguments, ChildOptions.inherit(), handover)?;
/// ```
///
/// Listing a thing gives the handover a hold of its own on it, which it lets go of when it is dropped: the parent
/// keeps what it listed, may drop it, and one handover serves every child that is to have the same things. What
/// is shared is the thing itself: both processes accept from the one socket and map the one memory, and closing
/// it in one does not close it in the other. The child has nothing else of its parent's but the three standard
/// streams. At most 16 places.
@noncopy
public struct Handover {
    /// Each place: the runtime's hold on it, and its kind (1 a listener, 2 a UDP socket, 3 memory).
    private held: [u64; 16];
    private kinds: [u8; 16];
    private count: u32;

    /// A handover of nothing.
    public fn create() -> Handover => Handover { held: [0u64; 16], kinds: [0u8; 16], count: 0 };

    /// How many places it has.
    public fn length(borrow this) -> u32 => this.count;

    /// Safety: the runtime duplicates what `handle` names, or says why not.
    fn hold(borrow mut this, kind: u8, handle: u64) -> Result<u32, IoError> {
        if (this.count >= 16) {
            return Err(IoError.InvalidInput);
        }
        let held = unsafe { ceesafe_host_handover_hold(kind as u32, handle) };
        if (held < 0) {
            return Err(HostServices.hostError(held));
        }
        let at = this.count;
        this.held[at as usize] = truncate<u64>(held);
        this.kinds[at as usize] = kind;
        this.count = at + 1;
        return Ok(at);
    }

    /// Lists a TCP listener: its place. `InvalidInput` past 16 places.
    public fn listener(borrow mut this, listener: borrow AsyncTcpListener) -> Result<u32, IoError> =>
        this.hold(1, truncate<u64>(listener.descriptor() as i64));

    /// Lists a UDP socket: its place. `InvalidInput` past 16 places.
    public fn datagrams(borrow mut this, socket: borrow AsyncUdpSocket) -> Result<u32, IoError> =>
        this.hold(2, truncate<u64>(socket.descriptor() as i64));

    /// Lists shared memory: its place. `InvalidInput` past 16 places.
    public fn memory(borrow mut this, memory: borrow SharedMemory) -> Result<u32, IoError> =>
        this.hold(3, memory.held());

    /// Lets go of what it holds.
    /// Safety: each hold is the runtime's, given back once.
    drop {
        for (i in 0..this.count as usize) {
            unsafe { ceesafe_host_handover_release(this.kinds[i] as u32, this.held[i]); }
        }
    }
}

/// What this process was handed by the one that started it (type-system.md §26.18, ADR 0173): `Process.inherited()`.
///
/// ```
/// var given = Process.inherited();
/// let listener = given.listener(0)?;      // the same socket as the parent's
/// let shared = given.memory(1)?;          // the same memory
/// ```
///
/// Each place is taken once: asking again, for another kind, or past the end is `Err(IoError.NotFound)`. In a
/// program that was started with nothing handed over it is empty. A program this one starts is handed nothing of
/// it.
public struct Inherited {
    private places: u32;

    /// How many places there are.
    public fn count(borrow this) -> u32 => this.places;

    /// What place `place` holds; null if it is past the end or was taken.
    /// Safety: the runtime writes at most the 16 bytes of `kinds`.
    public fn kind(borrow this, place: u32) -> InheritedKind? {
        var kinds = [0u8; 16];
        let count = unsafe { ceesafe_host_inherited(borrow mut kinds[0] as *mut u8, 16) };
        if (place as i64 >= count || place >= 16) {
            return null;
        }
        return match (kinds[place as usize]) {
            1 => Some(InheritedKind.Listener),
            2 => Some(InheritedKind.Datagrams),
            3 => Some(InheritedKind.Memory),
            _ => null,
        };
    }

    /// Safety: the runtime writes the three words of `out`.
    fn take(place: u32, kind: u32) -> Result<[u64; 3], IoError> {
        var out = [0u64; 3];
        let status = unsafe { ceesafe_host_inherited_take(place, kind, borrow mut out[0] as *mut u64) };
        if (status < 0) {
            return Err(HostServices.hostError(status));
        }
        return Ok(out);
    }

    /// Takes the TCP listener at `place`.
    public fn listener(borrow mut this, place: u32) -> Result<AsyncTcpListener, IoError> {
        let out = Inherited.take(place, 1)?;
        return Ok(AsyncTcpListener.adopt(truncate<i32>(truncate<i64>(out[0]))));
    }

    /// Takes the UDP socket at `place`.
    public fn datagrams(borrow mut this, place: u32) -> Result<AsyncUdpSocket, IoError> {
        let out = Inherited.take(place, 2)?;
        return Ok(AsyncUdpSocket.adopt(
            truncate<i32>(truncate<i64>(out[0])),
            truncate<u32>(out[1]),
            truncate<u16>(out[2]),
        ));
    }

    /// Takes the shared memory at `place`.
    public fn memory(borrow mut this, place: u32) -> Result<SharedMemory, IoError> =>
        Ok(SharedMemory.adopt(Inherited.take(place, 3)?));
}

/// How `Process.spawn` starts a program (type-system.md §26.16, ADR 0169).
public struct ChildOptions {
    public input: ChildStream;
    public output: ChildStream;
    public error: ChildStream;

    /// The parent's three streams.
    public fn inherit() -> ChildOptions =>
        ChildOptions { input: ChildStream.Inherit, output: ChildStream.Inherit, error: ChildStream.Inherit };

    /// No input and no output: the null device for all three.
    public fn quiet() -> ChildOptions =>
        ChildOptions { input: ChildStream.Null, output: ChildStream.Null, error: ChildStream.Null };
}

/// How a child process ended (ADR 0169).
public enum ChildExit {
    /// It returned from `main` or called `Process.exit`: its status.
    Status(i32),
    /// A signal ended it (POSIX): its number. On Windows a child ended by `kill` is `Status(1)`.
    Signal(i32),
}

/// A program started by `Process.spawn` that runs beside this one: the parent's hold on it (type-system.md §26.16,
/// ADR 0169). Dropping it neither ends the child nor waits for it: a program that wants its children gone ends them.
@noncopy
public struct ChildProcess {
    private handle: u64;
    private pid: u64;
    /// The exit, once `poll` or `wait` has seen it: the system reports it once.
    private ended: ChildExit?;

    /// The system's id of the process.
    public fn id(borrow this) -> u64 => this.pid;

    /// How the child ended, if it has: at once, without waiting.
    /// Safety: the handle is the one the runtime gave for this child, which this value alone holds.
    public fn poll(borrow mut this) -> Result<ChildExit?, IoError> {
        if (this.ended.isSome()) {
            return Ok(this.ended);
        }
        let status = unsafe { ceesafe_host_child_poll(this.handle, 0) };
        return this.seen(status);
    }

    /// Waits for the child to end, blocking the thread. In async code, `poll` on a timer (N0295).
    /// Safety: as `poll`.
    public fn wait(borrow mut this) -> Result<ChildExit, IoError> {
        match (this.ended) {
            Some(exit) => { return Ok(exit); }
            null => {}
        }
        let status = unsafe { ceesafe_host_child_wait(this.handle) };
        return match (this.seen(status)?) {
            Some(exit) => Ok(exit),
            null => Err(IoError.Other(0)),
        };
    }

    /// Asks the child to end: SIGTERM, which a `ProcessSignals` subscription in the child receives as `Terminate`; on
    /// Windows, a console control event to its process group. Nothing, once its exit has been seen.
    /// Safety: as `poll`; a child whose exit was seen is never signalled, so an id the system has given to another
    /// process is not.
    public fn terminate(borrow this) -> Result<void, IoError> {
        if (this.ended.isSome()) {
            return Ok();
        }
        let status = unsafe { ceesafe_host_child_signal(this.handle, 0) };
        return if (status < 0) Err(HostServices.hostError(status)) else Ok();
    }

    /// Ends the child at once: SIGKILL; `TerminateProcess`. Nothing, once its exit has been seen.
    /// Safety: as `terminate`.
    public fn kill(borrow this) -> Result<void, IoError> {
        if (this.ended.isSome()) {
            return Ok();
        }
        let status = unsafe { ceesafe_host_child_signal(this.handle, 1) };
        return if (status < 0) Err(HostServices.hostError(status)) else Ok();
    }

    /// What the runtime's poll said: nothing yet, an exit (kept), or an error.
    fn seen(borrow mut this, status: i64) -> Result<ChildExit?, IoError> {
        if (status < 0) {
            return Err(HostServices.hostError(status));
        }
        if (status == 0) {
            return Ok(null);
        }
        let bits = truncate<u64>(status);
        let value = truncate<i32>(bits & 0xFFFFFFFF);
        let exit = if ((bits >> 32) == 2) ChildExit.Signal(value) else ChildExit.Status(value);
        this.ended = Some(exit);
        return Ok(this.ended);
    }

    /// Ends the hold. A child that still runs goes on, and the runtime forgets it when it has ended.
    /// Safety: as `poll`; the handle is not used after this.
    drop {
        unsafe { ceesafe_host_child_forget(this.handle, if (this.ended.isSome()) 1u32 else 0u32); }
    }
}

/// The environment the program started with (type-system.md §26.9).
public struct Environment {
    /// The value of the variable `name` as static text, or null if it is not set or not valid UTF-8.
    /// Safety: the runtime returns getenv's text, which stays valid and unchanged: CeeSafe has no way to change the
    /// environment (C code that calls setenv breaks this, as it does in C).
    public fn variable(name: StringView) -> StringView? {
        var value = 0 as *u8;
        var length: u64 = 0;
        let found = unsafe { ceesafe_host_env(
            name.ptr,
            name.length as u64,
            borrow mut value as *mut (*u8),
            borrow mut length as *mut u64,
        ) };
        if (found != 1) {
            return null;
        }
        let bytes = unsafe { Slice.fromRaw(value, truncate<usize>(length)) };
        return StringView.fromUtf8(bytes);
    }
}

/// The process's open-file limit (`ProcessLimits.openFiles`, ADR 0104). u64's maximum stands for "unlimited".
public struct OpenFileLimit {
    /// The soft limit: the most descriptors the process may hold now.
    public current: u64;
    /// The hard limit: the most `current` may be raised to without privilege.
    public maximum: u64;
}

/// Limits the system puts on the process (type-system.md §26.12, ADR 0104). Hosted only; the interpreter answers
/// `Unsupported`.
public struct ProcessLimits {
    /// The open-file limit: POSIX `getrlimit(RLIMIT_NOFILE)`. Windows' handles have no count limit: both are u64's
    /// maximum there.
    /// Safety: the runtime writes the two values during the call only.
    public fn openFiles() -> Result<OpenFileLimit, IoError> {
        var current: u64 = 0;
        var maximum: u64 = 0;
        let result = unsafe { ceesafe_host_open_files(borrow mut current as *mut u64, borrow mut maximum as *mut u64) };
        if (result < 0) {
            return Err(HostServices.hostError(result));
        }
        return Ok(OpenFileLimit { current: current, maximum: maximum });
    }

    /// Raises the soft open-file limit to `to`, at most the hard limit (and, on Apple systems, the kernel's
    /// `kern.maxfilesperproc`, or `OPEN_MAX` where an older release refuses more), and returns the soft limit
    /// afterwards. It never lowers it. A server calls it once at start: `ProcessLimits.raiseOpenFiles(u64.max)`.
    /// Safety: the runtime writes the value during the call only.
    public fn raiseOpenFiles(to: u64) -> Result<u64, IoError> {
        var now: u64 = 0;
        let result = unsafe { ceesafe_host_raise_open_files(to, borrow mut now as *mut u64) };
        if (result < 0) {
            return Err(HostServices.hostError(result));
        }
        return Ok(now);
    }
}

/// A request to the process from outside it (`ProcessSignals`, type-system.md §26.15, ADRs 0125 and 0140).
public enum ProcessSignal {
    /// The user's interrupt: POSIX `SIGINT` (Ctrl+C in a terminal); on Windows, Ctrl+C.
    Interrupt,
    /// A request to terminate: POSIX `SIGTERM` (`kill`, a service manager, a container's stop); on Windows,
    /// Ctrl+Break (which `ChildProcess.terminate` sends) and the console's close, logoff and shutdown.
    Terminate,
    /// POSIX `SIGHUP` (ADR 0140): the terminal went away, or, for a daemon, which has none, by convention a request
    /// to read its configuration again (`kill -HUP`, systemd's `ExecReload`). Windows has no such request, so it never
    /// comes there.
    Hangup,
}

/// The process's subscription to the requests to end it (type-system.md §26.15, ADR 0125). Before a program
/// subscribes, and after the subscription is dropped, such a request ends the process at once, as the system's
/// default does. While the subscription lives, each request is kept for the program instead: `poll` asks without
/// waiting, `wait` blocks a thread, and `waitAsync` parks a task (so `Async.race(server, signals.waitAsync())` is a
/// server's shutdown). There is one subscription for the process at a time; threads and tasks share it by
/// reference. Requests that arrive faster than they are taken are merged: up to eight are kept. `SIGHUP` is kept
/// as `Hangup` (ADR 0140), and no other signal is touched. Hosted only.
@noncopy
public struct ProcessSignals {
    private queue: Channel<u32>;

    /// Subscribes. `Err(IoError.AlreadyExists)` while another subscription lives, `Err(IoError.Unsupported)` where
    /// the system has no such requests.
    /// Safety: the runtime takes its own count of the channel, and gives it back when the subscription ends, which
    /// is this value's drop.
    public fn subscribe() -> Result<ProcessSignals, IoError> {
        let queue = match (Channel<u32>.create(8)) {
            Ok(q) => q,
            Err(_) => { return Err(IoError.OutOfMemory); }
        };
        let result = unsafe { ceesafe_signal_subscribe(queue.handle()) };
        if (result < 0) {
            return Err(HostServices.hostError(result));
        }
        return Ok(ProcessSignals { queue: queue });
    }

    /// The oldest request not yet taken, or `null` at once if there is none. It never waits, so async code may call
    /// it.
    public fn poll(borrow this) -> ProcessSignal? => match (this.queue.tryRecv()) {
        Some(n) => Some(ProcessSignals.named(n)),
        null => null,
    };

    /// Waits for a request, blocking the thread. In async code use `waitAsync` (N0295).
    public fn wait(borrow this) -> ProcessSignal {
        loop {
            match (this.queue.recv()) {
                Some(n) => { return ProcessSignals.named(n); }
                null => {} // the queue is never closed
            }
        }
    }

    /// Waits for a request, parking the task: other tasks run meanwhile. `Err(AsyncError.Cancelled)` if the task is
    /// cancelled first; a request is then still there for the next call.
    public async fn waitAsync(borrow this) -> Result<ProcessSignal, AsyncError> {
        loop {
            match (await this.queue.recvAsync()?) {
                Some(n) => { return Ok(ProcessSignals.named(n)); }
                null => {} // the queue is never closed
            }
        }
    }

    /// The runtime's value: 1 an interrupt, 2 a request to terminate, 3 a hangup.
    fn named(n: u32) -> ProcessSignal => if (n == 1) ProcessSignal.Interrupt else if (n == 3) ProcessSignal.Hangup
        else ProcessSignal.Terminate;

    /// Ends the subscription: the next request ends the process, as before it.
    /// Safety: the runtime ends the subscription only if it is this value's channel, which it holds a count of. In
    /// a process made by `fork` from one that had subscribed it is not, and nothing is ended.
    drop {
        unsafe { ceesafe_signal_unsubscribe(this.queue.handle()); }
    }
}

/// Directories (type-system.md §26.10).
/// A volume's bytes (`Directory.space`, ADR 0077).
public struct VolumeSpace {
    /// The volume's size.
    public total: u64;
    /// The bytes no file uses.
    public free: u64;
    /// The bytes this process may still write: at most `free`.
    public available: u64;
}

public struct Directory {
    /// Makes one directory; `AlreadyExists` if something is there already.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn create(path: StringView) -> Result<void, IoError> {
        let result = unsafe { ceesafe_host_dir_create(path.ptr, path.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// Removes an empty directory.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn remove(path: StringView) -> Result<void, IoError> {
        let result = unsafe { ceesafe_host_dir_remove(path.ptr, path.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// The bytes of the volume that holds `path` (ADR 0077): `total`, `free`, and `available` to this process, which
    /// is at most `free` where the system keeps a reserve for its administrator. POSIX `statvfs`; Windows
    /// `GetDiskFreeSpaceExA`. A storage engine stops writing before `available` runs out. The interpreter answers
    /// `Unsupported`.
    /// Safety: the runtime reads the path's bytes and writes the three values during the call only.
    public fn space(path: StringView) -> Result<VolumeSpace, IoError> {
        var total: u64 = 0;
        var free: u64 = 0;
        var available: u64 = 0;
        let result = unsafe { ceesafe_host_space(
            path.ptr,
            path.length as u64,
            borrow mut total as *mut u64,
            borrow mut free as *mut u64,
            borrow mut available as *mut u64,
        ) };
        if (result < 0) {
            return Err(HostServices.hostError(result));
        }
        return Ok(VolumeSpace { total: total, free: free, available: available });
    }

    /// Makes the directory's entries durable: the files created, renamed or removed in it survive a power cut once
    /// this returns (ADR 0075 §2.1). POSIX: `fsync` of the directory, `F_FULLFSYNC` on Apple systems. Windows journals
    /// directory entries and cannot flush a directory: there it checks the path is a directory and does nothing else.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn sync(path: StringView) -> Result<void, IoError> {
        let result = unsafe { ceesafe_host_dir_sync(path.ptr, path.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// The names in a directory, without `.` and `..`, sorted by byte value so programs stay deterministic. A name
    /// that is not valid UTF-8 is `InvalidInput`: skipping it could make a program miss a file without a word.
    /// Safety: the listing is closed on every path out (`defer`), and each name is copied before the next call
    /// reuses the runtime's buffer.
    public fn list(path: StringView) -> Result<Vector<String>, IoError> {
        var error: i32 = 0;
        let listing = unsafe { ceesafe_host_dir_open(path.ptr, path.length as u64, borrow mut error as *mut i32) };
        if (listing.isNull()) {
            return Err(HostServices.hostError(0 - (error as i64)));
        }
        defer {
            unsafe { ceesafe_host_dir_close(listing); }
        }
        var names = Vector<String>.create();
        loop {
            var name = 0 as *u8;
            var length: u64 = 0;
            let next = unsafe { ceesafe_host_dir_next(
                listing,
                borrow mut name as *mut (*u8),
                borrow mut length as *mut u64,
            ) };
            if (next == 0) {
                break;
            }
            if (next < 0) {
                return Err(HostServices.hostError(next));
            }
            let bytes = unsafe { Slice.fromRaw(name, truncate<usize>(length)) };
            let text = match (StringView.fromUtf8(bytes)) {
                Some(t) => t,
                null => { return Err(IoError.InvalidInput); }
            };
            let copy = HostServices.stringOrIoError(HostServices.copyText(text))?;
            HostServices.pushed(names.push(copy))?;
        }
        // An insertion sort rather than sortBy: an instance of lib/core's generic sort made here would be emitted in every
        // hosted program, used or not.
        for (i in 1..names.length) {
            var j = i;
            while (j > 0 && HostServices.compareText(names[j - 1], names[j]) > 0) {
                names.swap(j - 1, j);
                j -= 1;
            }
        }
        return Ok(names);
    }

    /// A new, empty directory that only this user can enter, under the platform's temporary directory. The caller
    /// removes it.
    /// Safety: the runtime writes at most the buffer's length.
    public fn temporary() -> Result<String, IoError> {
        var buffer = [0u8; 4096];
        let length = unsafe { ceesafe_host_temporary(borrow mut buffer[0] as *mut u8, 4096) };
        return HostServices.textOf(buffer, length);
    }

    /// The folder for this app's own data, kept from one run to the next, made if it is missing (ADR 0159). `name` is
    /// the app's folder name: `InvalidInput` when it is empty, holds a separator, or is "." or "..". macOS and iOS:
    /// `Library/Application Support/<name>` in the user's home (on iOS, the app's container); Windows:
    /// `%APPDATA%\<name>`; Android: `<name>` in the app's files folder; elsewhere `$XDG_DATA_HOME/<name>`, or
    /// `~/.local/share/<name>`. A phone's system may empty `Directory.temporary()`'s folder; this one it keeps.
    /// Safety: the runtime reads the name's bytes during the call only, and writes at most the buffer's length.
    public fn appData(name: StringView) -> Result<String, IoError> {
        var buffer = [0u8; 4096];
        let length = unsafe { ceesafe_host_app_data(
            name.ptr,
            name.length as u64,
            borrow mut buffer[0] as *mut u8,
            4096,
        ) };
        return HostServices.textOf(buffer, length);
    }

    /// The working directory.
    /// Safety: the runtime writes at most the buffer's length.
    public fn current() -> Result<String, IoError> {
        var buffer = [0u8; 4096];
        let length = unsafe { ceesafe_host_current(borrow mut buffer[0] as *mut u8, 4096) };
        return HostServices.textOf(buffer, length);
    }
}

/// A program's argument as the runtime's `cee_str` (a struct is laid out by C's rules, type-system §12; not @repr(C), which would put it in every program's ceesafe_exports.h).
/// Its length is `usize`, as `cee_str`'s is `cee_usize`: 4 bytes on a 32-bit target (ADR 0192 §2.3).
struct HostServicesText {
    ptr: *u8;
    len: usize;
}

/// The functions behind `Process.capture` and `File.kind`.
public struct HostServices {
    /// `Process.capture(program, arguments, input)` (type-system.md §26.7): runs `program`, found on `PATH`, with
    /// `arguments`, `input` as its standard input (empty if null), and returns its exit status and what it wrote to
    /// standard output and standard error. The streams go through files in a private temporary directory, removed
    /// before this returns, so a program that writes much to both cannot block (ADR 0028).
    public fn capture(
        program: StringView,
        arguments: borrow Vector<StringView>,
        input: Slice<u8>?,
    ) -> Result<ProcessOutput, IoError> {
        let directory = Directory.temporary()?;
        let result = HostServices.captureIn(directory.view(), program, arguments, input);
        HostServices.clean(directory.view());
        return result;
    }

    /// `Process.spawn(program, arguments, options)` (type-system.md §26.16, ADR 0169): starts `program`, found on
    /// `PATH`, with `arguments`, and returns: the child runs beside this program, with its environment and working
    /// directory, and the streams `options` says.
    /// Safety: the runtime reads the views during the call only, and writes the handle it gives.
    public fn spawn(
        program: StringView,
        arguments: borrow Vector<StringView>,
        options: ChildOptions,
    ) -> Result<ChildProcess, IoError> {
        var texts = Vector<HostServicesText>.create();
        HostServices.pushed(texts.push(unsafe { HostServicesText { ptr: program.ptr, len: program.length } }))?;
        for (argument in arguments) {
            HostServices.pushed(
                texts.push(unsafe { HostServicesText { ptr: argument.ptr, len: argument.length } }),
            )?;
        }
        let streams = HostServices.streamBits(options.input) | (HostServices.streamBits(options.output) << 2) |
            (HostServices.streamBits(options.error) << 4);
        var handle: u64 = 0;
        let pid = unsafe { ceesafe_host_child_start(
            texts.view().ptr as *void,
            texts.length as u64,
            streams,
            borrow mut handle as *mut u64,
        ) };
        if (pid < 0) {
            return Err(HostServices.hostError(pid));
        }
        return Ok(ChildProcess { handle: handle, pid: truncate<u64>(pid), ended: null });
    }

    /// `Process.spawnWith(program, arguments, options, handover)` (type-system.md §26.18, ADR 0173): `spawn`, and
    /// the child has what `handover` lists, which `Process.inherited()` gives it.
    /// Safety: as `spawn`; the runtime reads the handles and kinds during the call only.
    public fn spawnWith(
        program: StringView,
        arguments: borrow Vector<StringView>,
        options: ChildOptions,
        handover: borrow Handover,
    ) -> Result<ChildProcess, IoError> {
        var texts = Vector<HostServicesText>.create();
        HostServices.pushed(texts.push(unsafe { HostServicesText { ptr: program.ptr, len: program.length } }))?;
        for (argument in arguments) {
            HostServices.pushed(
                texts.push(unsafe { HostServicesText { ptr: argument.ptr, len: argument.length } }),
            )?;
        }
        let streams = HostServices.streamBits(options.input) | (HostServices.streamBits(options.output) << 2) |
            (HostServices.streamBits(options.error) << 4);
        let handles = handover.held;
        let kinds = handover.kinds;
        var handle: u64 = 0;
        let pid = unsafe { ceesafe_host_child_start_with(
            texts.view().ptr as *void,
            texts.length as u64,
            streams,
            borrow handles[0] as *u64,
            borrow kinds[0] as *u8,
            handover.count,
            borrow mut handle as *mut u64,
        ) };
        if (pid < 0) {
            return Err(HostServices.hostError(pid));
        }
        return Ok(ChildProcess { handle: handle, pid: truncate<u64>(pid), ended: null });
    }

    /// `Process.inherited()` (type-system.md §26.18, ADR 0173): what this process was handed.
    /// Safety: the runtime writes at most the 16 bytes of `kinds`.
    public fn inherited() -> Inherited {
        var kinds = [0u8; 16];
        let count = unsafe { ceesafe_host_inherited(borrow mut kinds[0] as *mut u8, 16) };
        return Inherited { places: if (count < 0) 0u32 else truncate<u32>(count) };
    }

    fn streamBits(stream: ChildStream) -> u32 => match (stream) {
        ChildStream.Inherit => 0,
        ChildStream.Null => 1,
    };

    /// `Process.id()` (ADR 0169): the system's id of this process.
    /// Safety: the runtime only asks the system.
    public fn id() -> u64 => truncate<u64>(unsafe { ceesafe_host_pid() });

    /// `Process.executable()` (ADR 0169): the path of the running program, to start it again.
    /// Safety: the runtime writes at most the buffer's 4096 bytes.
    public fn executable() -> Result<String, IoError> {
        var buffer = [0u8; 4096];
        let length = unsafe { ceesafe_host_executable(borrow mut buffer[0] as *mut u8, 4096) };
        return HostServices.textOf(buffer, length);
    }

    /// `File.kind(path)` (type-system.md §26.8): what is at `path`, following symbolic links, or null if nothing is.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn kind(path: StringView) -> Result<PathKind?, IoError> {
        let kind = unsafe { ceesafe_host_path_kind(path.ptr, path.length as u64) };
        return match (kind) {
            0 => Ok(null),
            1 => Ok(PathKind.File),
            2 => Ok(PathKind.Directory),
            _ => if (kind < 0) Err(HostServices.hostError(kind)) else Ok(PathKind.Other),
        };
    }

    /// `Console.flush()` (ADR 0077): writes what standard output holds buffered, so it survives the process being
    /// killed. Standard error is never buffered.
    /// Safety: the runtime only flushes the C library's standard output.
    public fn flush() {
        let _ = unsafe { ceesafe_host_console_flush() };
    }

    /// `Console.readLine(mut line)` (ADR 0106): reads the next line of standard input into `line`, replacing what it
    /// held, without the line's ending (`\n`, or `\r\n`). `Ok(true)` with a line, which may be empty; `Ok(false)` at
    /// the end of the input, with `line` empty. The input's last line needs no ending. Standard output is flushed
    /// before the program waits for input, so a prompt is seen first.
    /// Errors, each with `line` empty: `InvalidInput` for a line that is not UTF-8 (the line is consumed, and the
    /// next call reads the one after it), `OutOfMemory`, or the read's error.
    /// Standard input is read a block at a time; `Console.read` takes what a `readLine` left of its block first, so
    /// the two can be mixed.
    /// Safety: the runtime writes at most the chunk's length, during the call only.
    public fn readLine(line: borrow mut String) -> Result<bool, IoError> {
        line.clear();
        var chunk = [0u8; 4096];
        var longer = Vector<u8>.create(); // a line that did not fit one chunk, so far
        loop {
            let result = unsafe { ceesafe_host_console_read_line(borrow mut chunk[0] as *mut u8, 4096) };
            if (result < 0) {
                return Err(HostServices.hostError(result));
            }
            let count = truncate<usize>(result);
            if (count == 0) {
                // The end of the input: what came before it, if anything, is the last line.
                if (longer.length == 0) {
                    return Ok(false);
                }
                break;
            }
            let ended = chunk[count - 1] == '\n';
            if (ended && longer.length == 0) {
                HostServices.setLine(line, chunk[..count])?;
                return Ok(true);
            }
            HostServices.pushed(longer.extend(chunk[..count]))?;
            if (ended) {
                break;
            }
        }
        HostServices.setLine(line, longer.view())?;
        return Ok(true);
    }

    /// Appends `bytes` to the empty `line` without their line ending, if they are UTF-8.
    fn setLine(line: borrow mut String, bytes: Slice<u8>) -> Result<void, IoError> {
        var end = bytes.length;
        if (end > 0 && bytes[end - 1] == '\n') {
            end -= 1;
            if (end > 0 && bytes[end - 1] == '\r') {
                end -= 1;
            }
        }
        let text = match (StringView.fromUtf8(bytes[..end])) {
            Some(t) => t,
            null => { return Err(IoError.InvalidInput); }
        };
        return HostServices.pushed(line.append(text));
    }

    /// `File.modified(path)` (ADR 0077): when the file or directory at `path` was last modified, as a `UnixTime`
    /// (`stat`'s `st_mtime`, with nanoseconds where the system keeps them). The interpreter answers `Unsupported`.
    /// Safety: the runtime reads the path's bytes and writes the two values during the call only.
    public fn modified(path: StringView) -> Result<UnixTime, IoError> {
        var seconds: i64 = 0;
        var nanoseconds: u32 = 0;
        let result = unsafe { ceesafe_host_modified(
            path.ptr,
            path.length as u64,
            borrow mut seconds as *mut i64,
            borrow mut nanoseconds as *mut u32,
        ) };
        if (result < 0) {
            return Err(HostServices.hostError(result));
        }
        return Ok(UnixTime { seconds: seconds, nanoseconds: nanoseconds });
    }

    /// `File.setPermissions(path, mode)` (ADR 0077): POSIX `chmod`, the low 12 bits of `mode` (`0o640`: the owner
    /// reads and writes, the group reads). Windows has only a read-only attribute, set when the owner may not write.
    /// A file created by `File.createNew` and given its permissions before anything is written to it never holds data
    /// others could read. The interpreter answers `Unsupported`.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn setPermissions(path: StringView, mode: u32) -> Result<void, IoError> {
        let result = unsafe { ceesafe_host_set_permissions(path.ptr, path.length as u64, mode) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// `File.rename(from, to)` (ADR 0075 §2.1): gives the file at `from` the name `to`, atomically replacing a file
    /// there (POSIX `rename`; Windows `MoveFileExW` with `MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH`). The new
    /// name is durable once its directory is synced (`Directory.sync`).
    /// Safety: the runtime reads both paths' bytes during the call only.
    public fn rename(from: StringView, to: StringView) -> Result<void, IoError> {
        let result = unsafe { ceesafe_host_rename(from.ptr, from.length as u64, to.ptr, to.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// Safety: `texts` holds a view per argument and outlives the call; the runtime reads it and the paths during
    /// the call only.
    fn captureIn(
        directory: StringView,
        program: StringView,
        arguments: borrow Vector<StringView>,
        input: Slice<u8>?,
    ) -> Result<ProcessOutput, IoError> {
        let inPath = HostServices.stringOrIoError(HostServices.pathIn(directory, "in"))?;
        let outPath = HostServices.stringOrIoError(HostServices.pathIn(directory, "out"))?;
        let errPath = HostServices.stringOrIoError(HostServices.pathIn(directory, "err"))?;
        var file = File.create(inPath.view())?;
        match (input) {
            Some(bytes) => { file.write(bytes)?; }
            null => {}
        }
        var texts = Vector<HostServicesText>.create();
        HostServices.pushed(texts.push(unsafe { HostServicesText { ptr: program.ptr, len: program.length } }))?;
        for (argument in arguments) {
            HostServices.pushed(
                texts.push(unsafe { HostServicesText { ptr: argument.ptr, len: argument.length } }),
            )?;
        }
        let status = unsafe { ceesafe_host_spawn(
            texts.view().ptr as *void,
            texts.length as u64,
            inPath.view().ptr,
            inPath.length as u64,
            outPath.view().ptr,
            outPath.length as u64,
            errPath.view().ptr,
            errPath.length as u64,
        ) };
        if (status < 0) {
            return Err(HostServices.hostError(status));
        }
        return Ok(
            ProcessOutput {
                status: truncate<i32>(status),
                stdout: HostServices.readAll(outPath.view())?,
                stderr: HostServices.readAll(errPath.view())?,
            },
        );
    }

    /// Removes the three files and the directory, ignoring what is not there.
    fn clean(directory: StringView) {
        for (k in 0..3) {
            let name: StringView = match (k) {
                0 => "in",
                1 => "out",
                _ => "err",
            };
            match (HostServices.pathIn(directory, name)) {
                Ok(path) => { let removed = File.remove(path.view()); }
                Err(_) => {}
            }
        }
        let removed = Directory.remove(directory);
    }

    // The helpers below are this struct's, not lib/std's top-level names: every hosted package shares those, so a
    // top-level `pathIn` or `readAll` here would clash with a program's own (N0201; fixed after 0.4.0).

    /// The text of a runtime call that wrote `length` bytes into `buffer`, or its error.
    fn textOf(buffer: [u8; 4096], length: i64) -> Result<String, IoError> {
        if (length < 0) {
            return Err(HostServices.hostError(length));
        }
        let bytes = buffer;
        let text = match (StringView.fromUtf8(bytes[..truncate<usize>(length)])) {
            Some(t) => t,
            null => { return Err(IoError.InvalidInput); }
        };
        return HostServices.stringOrIoError(HostServices.copyText(text));
    }

    /// `directory/name`.
    fn pathIn(directory: StringView, name: StringView) -> Result<String, AllocError> {
        var path = String.create();
        path.append(directory)?;
        path.append("/")?;
        path.append(name)?;
        return Ok(path);
    }

    fn copyText(text: StringView) -> Result<String, AllocError> {
        var copy = String.create();
        copy.append(text)?;
        return Ok(copy);
    }

    fn stringOrIoError(result: Result<String, AllocError>) -> Result<String, IoError> => match (result) {
        Ok(value) => Ok(value),
        Err(_) => Err(IoError.OutOfMemory),
    };

    /// As stringOrIoError, for `void` results (a generic copy with T = void does not check, type-system.md §20.4).
    fn pushed(result: Result<void, AllocError>) -> Result<void, IoError> => match (result) {
        Ok() => Ok(),
        Err(_) => Err(IoError.OutOfMemory),
    };

    /// The whole file's bytes.
    fn readAll(path: StringView) -> Result<Vector<u8>, IoError> {
        var file = File.open(path)?;
        var bytes = Vector<u8>.create();
        var buffer = [0u8; 65536];
        loop {
            let n = file.read(mut buffer[..])?;
            if (n == 0) {
                break;
            }
            for (i in 0..n) {
                match (bytes.push(buffer[i])) {
                    Ok() => {}
                    Err(_) => { return Err(IoError.OutOfMemory); }
                }
            }
        }
        return Ok(bytes);
    }

    /// Byte-wise order of two strings: negative, zero or positive.
    fn compareText(a: borrow String, b: borrow String) -> i32 {
        let n = if (a.length < b.length) a.length else b.length;
        for (i in 0..n) {
            if (a[i] != b[i]) {
                return if (a[i] < b[i]) -1 else 1;
            }
        }
        return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;
    }

    /// The IoError for a negated errno from the runtime (its kinds are CEE_IO_* in rt.h, in IoError's variant order).
    /// Safety: ceesafe_io_kind only classifies the number.
    fn hostError(code: i64) -> IoError {
        let error = truncate<i32>(0 - code);
        return match (unsafe { ceesafe_io_kind(error) }) {
            0 => IoError.NotFound,
            1 => IoError.PermissionDenied,
            2 => IoError.AlreadyExists,
            3 => IoError.IsDirectory,
            4 => IoError.NotDirectory,
            5 => IoError.InvalidInput,
            6 => IoError.BrokenPipe,
            7 => IoError.ConnectionRefused,
            8 => IoError.AddressInUse,
            9 => IoError.OutOfMemory,
            11 => IoError.ConnectionReset,
            12 => IoError.ConnectionAborted,
            13 => IoError.NotConnected,
            14 => IoError.TimedOut,
            15 => IoError.HostUnreachable,
            16 => IoError.NetworkUnreachable,
            17 => IoError.AddressNotAvailable,
            18 => IoError.Unsupported,
            19 => IoError.HostNotFound,
            20 => IoError.StorageFull,
            21 => IoError.TooManyOpenFiles,
            _ => IoError.Other(error),
        };
    }
}

/// An open file's metadata (ADR 0078 §3), read from the file (`fstat`), not its path: it describes the file that is
/// read, even if another has been renamed into its place since it was opened. `f.modified()` and `f.kind()` are the
/// checker's names for FileMetadata.modified(f) and FileMetadata.kind(f).
public struct FileMetadata {
    /// `f.modified()`: when the open file was last modified, with nanoseconds where the system keeps them. The
    /// interpreter answers `Unsupported`, as for `File.modified(path)`.
    /// Safety: the runtime reads the file's descriptor and writes the two values during the call only.
    public fn modified(file: borrow File) -> Result<UnixTime, IoError> {
        var seconds: i64 = 0;
        var nanoseconds: u32 = 0;
        let result = unsafe { ceesafe_host_file_modified(
            file as *File as *void,
            borrow mut seconds as *mut i64,
            borrow mut nanoseconds as *mut u32,
        ) };
        if (result < 0) {
            return Err(HostServices.hostError(result));
        }
        return Ok(UnixTime { seconds: seconds, nanoseconds: nanoseconds });
    }

    /// `f.kind()`: what the open file is. A directory opened for reading is `Directory`; a device, FIFO or socket is
    /// `Other`.
    /// Safety: the runtime reads the file's descriptor during the call only.
    public fn kind(file: borrow File) -> Result<PathKind, IoError> {
        let kind = unsafe { ceesafe_host_file_kind(file as *File as *void) };
        return match (kind) {
            1 => Ok(PathKind.File),
            2 => Ok(PathKind.Directory),
            _ => if (kind < 0) Err(HostServices.hostError(kind)) else Ok(PathKind.Other),
        };
    }
}

/// A point in real time (ADR 0055): seconds since 1970-01-01T00:00:00Z, leap seconds not counted (POSIX time), negative
/// before it, and the nanoseconds after them.
public struct UnixTime {
    public seconds: i64;
    /// 0 to 999 999 999.
    public nanoseconds: u32;

    /// The milliseconds since 1970, rounded toward minus infinity (the nanoseconds are never negative).
    public fn millis(borrow this) -> i64 => this.seconds * 1000 + (this.nanoseconds / 1000000) as i64;
}

/// The system's real time (ADR 0055): the date, which may jump backward or forward (NTP, the user). Measure and wait
/// with `Timer`, whose monotonic clock never jumps. The interpreter answers 2000-01-01T00:00:00Z plus its virtual
/// clock, so its runs stay reproducible.
public struct Clock {
    /// Now.
    /// Safety: the runtime writes the two values during the call only.
    public fn now() -> UnixTime {
        var seconds: i64 = 0;
        var nanoseconds: u32 = 0;
        unsafe { ceesafe_clock_realtime(borrow mut seconds as *mut i64, borrow mut nanoseconds as *mut u32); }
        return UnixTime { seconds: seconds, nanoseconds: nanoseconds };
    }

    /// Now, in milliseconds since 1970.
    public fn unixMillis() -> i64 => Clock.now().millis();

    /// The seconds to add to UTC to get the local time at `at`, as the system's time zone gives it, daylight saving
    /// included (ADR 0153): 10800 for UTC+3, -18000 for New York in winter and -14400 in summer. 0 in the interpreter,
    /// so its runs stay reproducible, and where the system has no time zone.
    /// Safety: the runtime only reads the system's time zone.
    public fn localOffset(at: UnixTime) -> i32 => unsafe { ceesafe_clock_local_offset(at.seconds) };

    /// Nanoseconds on the monotonic clock, from an arbitrary start (ADR 0075 §2.6): for measuring durations and
    /// latencies, never for the date. It never decreases within a process (`CLOCK_MONOTONIC`; `CLOCK_UPTIME_RAW` on
    /// Apple systems; `QueryPerformanceCounter` on Windows). The interpreter answers its virtual clock.
    /// Safety: the runtime only reads the clock.
    public fn monotonicNanos() -> u64 => unsafe { ceesafe_clock_monotonic() };
}

/// Random bytes from the system's cryptographic source (ADR 0060): `getrandom` (or `/dev/urandom`) on Linux,
/// `arc4random_buf` on macOS and the BSDs, `BCryptGenRandom` on Windows; for keys, nonces, masks and tokens. Each call
/// reads the source, which is cheap enough to call per message. The interpreter answers a fixed sequence instead, so
/// its runs stay reproducible: its bytes are not secret.
public struct Random {
    /// Fills `into` with random bytes. `Err(Unsupported)` where the system has no source (CosmoOS userland); another
    /// error if the source fails, with `into` partly written. It has no effect, so async code and a `drop` block may
    /// call it.
    /// Safety: the runtime writes at most the slice's length, during the call only.
    public fn fill(into: SliceMut<u8>) -> Result<void, IoError> {
        let result = unsafe { ceesafe_random_fill(into.ptr, into.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// A random integer `r` with `0 <= r < n`, each value equally likely (ADR 0106): `Random.below(100)! + 1` is a
    /// number from 1 to 100. `Err(InvalidInput)` if `n` is 0, as no integer is below it; else `fill`'s error. It
    /// draws eight bytes with `fill`, and again while they fall in the part of the 64-bit range that would make
    /// some values likelier (less than one time in two, whatever `n`), so there is no modulo bias. In the
    /// interpreter it follows `fill`'s fixed sequence: the same numbers every run.
    public fn below(n: u64) -> Result<u64, IoError> {
        if (n == 0) {
            return Err(IoError.InvalidInput);
        }
        let excess = 0u64.wrappingSub(n) % n; // 2^64 mod n: that many low draws are refused
        var bytes = [0u8; 8];
        loop {
            Random.fill(mut bytes[..])?;
            var draw: u64 = 0;
            for (k in 0..8usize) {
                draw = draw | ((bytes[k] as u64) << (8 * k));
            }
            if (draw >= excess) {
                return Ok(draw % n);
            }
        }
    }
}
