// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Socket addresses (type-system.md §40.4, ADR 0044): IPv4 and IPv6 endpoints, their text, and a listener's options.
// Parsing and writing are pure CeeSafe; only an IPv6 zone given by an interface's name asks the runtime.

extern "C" {
    @effects()
    fn ceesafe_interface_index(name: *u8, length: u64) -> u32;
    @effects()
    fn ceesafe_dns_start(host: *u8, length: u64, port: u16) -> *mut void;
    @effects()
    fn ceesafe_dns_poll(lookup: *mut void) -> i32;
    @effects()
    fn ceesafe_dns_count(lookup: *mut void) -> u32;
    @effects()
    fn ceesafe_dns_address(lookup: *mut void, index: u32, bytes: *mut u8, family: *mut u32, scope: *mut u32);
    @effects()
    fn ceesafe_dns_end(lookup: *mut void);
}

/// An IPv4 or IPv6 endpoint: the address bytes in network order and the port; an IPv6 address also has its scope id
/// (0: none), which a link-local address needs to say which interface it is on.
public enum SocketAddress {
    V4([u8; 4], u16),
    V6([u8; 16], u16, u32),
}

/// What every SocketAddress answers (ADR 0044 §3.1).
public interface SocketEndpoint {
    /// The port.
    fn port(borrow this) -> u16;
    /// The same address with port `p`.
    fn withPort(borrow this, p: u16) -> SocketAddress;
    /// 127.0.0.0/8, or ::1.
    fn isLoopback(borrow this) -> bool;
    /// 0.0.0.0, or ::.
    fn isUnspecified(borrow this) -> bool;
    /// The text: `127.0.0.1:8080`, `[::1]:8080`, `[fe80::1%2]:8080`; IPv6 in RFC 5952's canonical form.
    fn write(borrow this, w: borrow mut TextWriter);
}

impl SocketEndpoint for SocketAddress {
    fn port(borrow this) -> u16 => match (this) {
        SocketAddress.V4(_, p) => p,
        SocketAddress.V6(_, p, _) => p,
    };

    fn withPort(borrow this, p: u16) -> SocketAddress => match (this) {
        SocketAddress.V4(a, _) => SocketAddress.V4(a, p),
        SocketAddress.V6(a, _, s) => SocketAddress.V6(a, p, s),
    };

    fn isLoopback(borrow this) -> bool => match (this) {
        SocketAddress.V4(a, _) => a[0] == 127,
        SocketAddress.V6(a, _, _) => SocketAddresses.allZero(a[..15]) && a[15] == 1,
    };

    fn isUnspecified(borrow this) -> bool => match (this) {
        SocketAddress.V4(a, _) => SocketAddresses.allZero(a[..]),
        SocketAddress.V6(a, _, _) => SocketAddresses.allZero(a[..]),
    };

    fn write(borrow this, w: borrow mut TextWriter) {
        match (this) {
            SocketAddress.V4(a, p) => {
                SocketAddresses.writeV4(w, a);
                w.byte(58);
                w.decimal(p as u64);
            }
            SocketAddress.V6(a, p, s) => {
                w.byte(91);
                SocketAddresses.writeV6(w, a);
                if (s != 0) {
                    w.byte(37);
                    w.decimal(s as u64);
                }
                w.text("]:");
                w.decimal(p as u64);
            }
        }
    }
}

/// The ways to make a SocketAddress: from text, and the well-known ones. (An enum has no functions of its own,
/// type-system.md §15.1, so they are here.)
public struct SocketAddresses {
    /// `a.b.c.d:port`, `[v6]:port` or `[v6%zone]:port`, where the zone is a number or an interface's name; null if
    /// the text is not one.
    public fn parse(text: StringView) -> SocketAddress? {
        let b = text.bytes();
        if (b.length > 0 && b[0] == 91) {
            var close: usize = 0;
            while (close < b.length && b[close] != 93) {
                close += 1;
            }
            if (close >= b.length || close + 1 >= b.length || b[close + 1] != 58) {
                return null;
            }
            let inner = b[1..close];
            return match (SocketAddresses.parsePort(b[close + 2..])) {
                Some(port) => SocketAddresses.parseV6Zoned(inner, port),
                null => null,
            };
        }
        var colon = b.length;
        for (i in 0..b.length) {
            if (b[i] == 58) {
                if (colon != b.length) {
                    return null; // IPv6 needs its brackets when a port follows
                }
                colon = i;
            }
        }
        if (colon == b.length) {
            return null;
        }
        var v4 = [0u8; 4];
        if (!SocketAddresses.parseV4(b[..colon], mut v4)) {
            return null;
        }
        return match (SocketAddresses.parsePort(b[colon + 1..])) {
            Some(port) => SocketAddress.V4(v4, port),
            null => null,
        };
    }

    /// An address without a port (`127.0.0.1`, `::1`, `fe80::1%2`, `fe80::1%en0`) and `port`; null if the text is not
    /// one.
    public fn parseIp(text: StringView, port: u16) -> SocketAddress? {
        let b = text.bytes();
        var v4 = [0u8; 4];
        if (SocketAddresses.parseV4(b, mut v4)) {
            return SocketAddress.V4(v4, port);
        }
        return SocketAddresses.parseV6Zoned(b, port);
    }

    public fn v4Any(port: u16) -> SocketAddress => SocketAddress.V4([0u8; 4], port);

    public fn v6Any(port: u16) -> SocketAddress => SocketAddress.V6([0u8; 16], port, 0);

    public fn v4Loopback(port: u16) -> SocketAddress => SocketAddress.V4([127u8, 0, 0, 1], port);

    public fn v6Loopback(port: u16) -> SocketAddress {
        var a = [0u8; 16];
        a[15] = 1;
        return SocketAddress.V6(a, port, 0);
    }

    fn allZero(b: Slice<u8>) -> bool {
        for (x in b) {
            if (x != 0) {
                return false;
            }
        }
        return true;
    }

    /// 1 to 5 decimal digits, at most 65535.
    fn parsePort(b: Slice<u8>) -> u16? {
        if (b.length == 0 || b.length > 5) {
            return null;
        }
        var v: u32 = 0;
        for (c in b) {
            if (c < 48 || c > 57) {
                return null;
            }
            v = v * 10 + (c - 48) as u32;
        }
        return if (v > 65535) null else truncate<u16>(v);
    }

    /// Dotted IPv4: four decimal parts of 1 to 3 digits without leading zeros, each at most 255.
    fn parseV4(b: Slice<u8>, out: borrow mut [u8; 4]) -> bool {
        var i: usize = 0;
        for (part in 0..4usize) {
            if (part > 0) {
                if (i >= b.length || b[i] != 46) {
                    return false;
                }
                i += 1;
            }
            var v: u32 = 0;
            var digits: u32 = 0;
            while (i < b.length && b[i] >= 48 && b[i] <= 57 && digits < 3) {
                v = v * 10 + (b[i] - 48) as u32;
                i += 1;
                digits += 1;
            }
            if (digits == 0 || v > 255 || (digits > 1 && b[i - digits as usize] == 48)) {
                return false; // no leading zeros: 010 would read as octal elsewhere
            }
            out[part] = truncate<u8>(v);
        }
        return i == b.length;
    }

    fn hexValue(c: u8) -> i32 {
        if (c >= 48 && c <= 57) {
            return (c - 48) as i32;
        }
        if (c >= 97 && c <= 102) {
            return (c - 87) as i32;
        }
        if (c >= 65 && c <= 70) {
            return (c - 55) as i32;
        }
        return -1;
    }

    /// IPv6 text (RFC 4291 §2.2): eight groups of up to four hex digits, at most one `::`, a dotted IPv4 last.
    fn parseV6(b: Slice<u8>, out: borrow mut [u8; 16]) -> bool {
        var groups = [0u16; 8];
        var count: usize = 0;
        var gap: usize = 9; // where `::` stands, 9 if there is none
        var i: usize = 0;
        if (b.length >= 2 && b[0] == 58 && b[1] == 58) {
            gap = 0;
            i = 2;
        } else if (b.length == 0 || b[0] == 58) {
            return false;
        }
        while (i < b.length) {
            let start = i;
            var v: u32 = 0;
            var digits: u32 = 0;
            while (i < b.length && SocketAddresses.hexValue(b[i]) >= 0 && digits < 5) {
                v = v * 16 + truncate<u32>(SocketAddresses.hexValue(b[i])); // 0 to 15 here
                i += 1;
                digits += 1;
            }
            if (i < b.length && b[i] == 46) {
                var v4 = [0u8; 4];
                if (count > 6 || !SocketAddresses.parseV4(b[start..], mut v4)) {
                    return false;
                }
                groups[count] = ((v4[0] as u16) << 8) | v4[1] as u16;
                groups[count + 1] = ((v4[2] as u16) << 8) | v4[3] as u16;
                count += 2;
                i = b.length;
                break;
            }
            if (digits == 0 || digits > 4 || count == 8) {
                return false;
            }
            groups[count] = truncate<u16>(v);
            count += 1;
            if (i == b.length) {
                break;
            }
            if (b[i] != 58) {
                return false;
            }
            i += 1;
            if (i < b.length && b[i] == 58) {
                if (gap != 9) {
                    return false;
                }
                gap = count;
                i += 1;
            } else if (i == b.length) {
                return false; // one trailing colon
            }
        }
        if (if (gap == 9) count != 8 else count > 7) {
            return false;
        }
        var at: usize = 0;
        for (k in 0..8usize) {
            var g: u16 = 0;
            if (gap == 9 || k < gap || k >= gap + (8 - count)) {
                g = groups[at];
                at += 1;
            }
            out[2 * k] = truncate<u8>(g >> 8);
            out[2 * k + 1] = truncate<u8>(g);
        }
        return true;
    }

    /// IPv6 with an optional `%zone`: a number, or an interface's name the runtime knows.
    /// Safety: the runtime reads the name during the call only.
    fn parseV6Zoned(b: Slice<u8>, port: u16) -> SocketAddress? {
        var end = b.length;
        for (i in 0..b.length) {
            if (b[i] == 37) {
                end = i;
                break;
            }
        }
        var a = [0u8; 16];
        if (!SocketAddresses.parseV6(b[..end], mut a)) {
            return null;
        }
        if (end == b.length) {
            return SocketAddress.V6(a, port, 0);
        }
        let zone = b[end + 1..];
        if (zone.length == 0) {
            return null;
        }
        var number: u64 = 0;
        var numeric = true;
        for (c in zone) {
            if (c < 48 || c > 57 || number > 429496729) {
                numeric = false;
                break;
            }
            number = number * 10 + (c - 48) as u64;
        }
        if (numeric && number <= 4294967295) {
            return SocketAddress.V6(a, port, truncate<u32>(number));
        }
        let index = unsafe { ceesafe_interface_index(zone.ptr, zone.length as u64) };
        return if (index == 0) null else SocketAddress.V6(a, port, index);
    }

    fn writeV4(w: borrow mut TextWriter, a: [u8; 4]) {
        for (k in 0..4usize) {
            if (k > 0) {
                w.byte(46);
            }
            w.decimal(a[k] as u64);
        }
    }

    /// RFC 5952 §4: lowercase hex without leading zeros, the longest run of two or more zero groups (the first of
    /// equal runs) as `::`; an IPv4-mapped address (::ffff:0:0/96) with its last 32 bits dotted (§5).
    fn writeV6(w: borrow mut TextWriter, a: [u8; 16]) {
        if (SocketAddresses.allZero(a[..10]) && a[10] == 255 && a[11] == 255) {
            w.text("::ffff:");
            var v4 = [0u8; 4];
            for (k in 0..4usize) {
                v4[k] = a[12 + k];
            }
            SocketAddresses.writeV4(w, v4);
            return;
        }
        var groups = [0u16; 8];
        for (k in 0..8usize) {
            groups[k] = ((a[2 * k] as u16) << 8) | a[2 * k + 1] as u16;
        }
        var bestStart: usize = 8;
        var bestLength: usize = 1; // a run must be at least two groups
        var k: usize = 0;
        while (k < 8) {
            if (groups[k] != 0) {
                k += 1;
                continue;
            }
            let start = k;
            while (k < 8 && groups[k] == 0) {
                k += 1;
            }
            if (k - start > bestLength) {
                bestStart = start;
                bestLength = k - start;
            }
        }
        var g: usize = 0;
        while (g < 8) {
            if (g == bestStart) {
                w.text("::");
                g += bestLength;
                continue;
            }
            if (g > 0 && g != bestStart + bestLength) {
                w.byte(58);
            }
            w.hex(groups[g] as u64, 0);
            g += 1;
        }
    }
}

/// How a listener is made (ADR 0044 §3.2). `defaults()`: the platform's largest backlog, the address reusable (as
/// the runtime always did), no port sharing, and dual stack for an IPv6 address.
public struct ListenOptions {
    /// The queue of connections not yet accepted; 0: the platform's largest (SOMAXCONN).
    public backlog: u32;
    /// SO_REUSEADDR: listen again at once on a port whose connections are still closing (POSIX; Windows: ignored).
    public reuseAddress: bool;
    /// SO_REUSEPORT: several listeners on one port, the kernel spreading the connections; refused where the platform
    /// has no such option (Windows: IoError.Unsupported).
    public reusePort: bool;
    /// IPV6_V6ONLY for an IPv6 address: false (dual stack) also accepts IPv4 peers, reported as V4.
    public v6Only: bool;

    public fn defaults() -> ListenOptions =>
        ListenOptions { backlog: 0, reuseAddress: true, reusePort: false, v6Only: false };

    /// The runtime's flags (rt.h's CEE_LISTEN_*).
    fn flags(borrow this) -> u32 =>
        (if (this.reuseAddress) 1u32 else 0) | (if (this.reusePort) 2u32 else 0) | (if (this.v6Only) 4u32 else 0);
}

/// A list of up to eight byte parts sent as one (ADR 0045 §3.1): an HTTP response's head and body, or a chunk's size
/// line, data and CRLF, in one system call and without a copy. It is a value built by copying, since a slice cannot be
/// an array element: `IoParts.of(head).then(body)`. Empty parts are allowed and send nothing.
public struct IoParts<region r> {
    private p0: Slice<r, u8>;
    private p1: Slice<r, u8>;
    private p2: Slice<r, u8>;
    private p3: Slice<r, u8>;
    private p4: Slice<r, u8>;
    private p5: Slice<r, u8>;
    private p6: Slice<r, u8>;
    private p7: Slice<r, u8>;
    private n: u32;

    /// One part.
    public fn of(part: Slice<r, u8>) -> IoParts<r> {
        let e = part[0..0];
        return IoParts { p0: part, p1: e, p2: e, p3: e, p4: e, p5: e, p6: e, p7: e, n: 1 };
    }

    /// These parts and `part` after them, or null when there are eight already.
    public fn then(this, part: Slice<r, u8>) -> IoParts<r>? {
        if (this.n >= 8) {
            return null;
        }
        return Some(IoParts {
            p0: this.p0,
            p1: if (this.n == 1) part else this.p1,
            p2: if (this.n == 2) part else this.p2,
            p3: if (this.n == 3) part else this.p3,
            p4: if (this.n == 4) part else this.p4,
            p5: if (this.n == 5) part else this.p5,
            p6: if (this.n == 6) part else this.p6,
            p7: if (this.n == 7) part else this.p7,
            n: this.n + 1,
        });
    }

    /// How many parts (0 to 8; 0 only from `after`).
    public fn count(borrow this) -> u32 => this.n;

    /// Part `i` (from 0); empty past the last.
    public fn part(this, i: u32) -> Slice<r, u8> {
        if (i >= this.n) {
            let first = this.p0;
            return first[0..0];
        }
        return match (i) {
            0 => this.p0,
            1 => this.p1,
            2 => this.p2,
            3 => this.p3,
            4 => this.p4,
            5 => this.p5,
            6 => this.p6,
            _ => this.p7,
        };
    }

    /// The number of bytes in every part.
    public fn totalLength(borrow this) -> usize {
        var total: usize = 0;
        for (i in 0..this.n) {
            total += this.part(i).length;
        }
        return total;
    }

    /// The bytes after the first `skip`, as parts: whole parts dropped, the part where byte `skip` falls cut. Empty
    /// (no parts) from `totalLength()` on. What a write loop sends after a partial send.
    public fn after(this, skip: usize) -> IoParts<r> {
        var k: u32 = 0;
        var left = skip;
        while (k < this.n && left >= this.part(k).length) {
            left -= this.part(k).length;
            k += 1;
        }
        let first = this.part(k);
        let cut = if (k < this.n) left else 0; // past the end: empty
        return IoParts {
            p0: first[cut..],
            p1: this.part(k + 1),
            p2: this.part(k + 2),
            p3: this.part(k + 3),
            p4: this.part(k + 4),
            p5: this.part(k + 5),
            p6: this.part(k + 6),
            p7: this.part(k + 7),
            n: this.n - k,
        };
    }
}

/// Name resolution for tasks (ADR 0048).
public struct AsyncDns {
    /// The addresses of `host`, each with `port`: both families, in the resolver's order, duplicates removed, never
    /// empty. A literal address is itself, at once. Otherwise the system's resolver runs on one of at most four
    /// resolver threads while the task waits; a cancelled task returns `Err(Cancelled)` at once, and the lookup is left
    /// to its thread. Errors are `AsyncError.Io`: `NotFound` (no such name), `TimedOut` (a temporary failure: try
    /// again), `InvalidInput` (an empty name, one over 253 bytes or with a NUL), `OutOfMemory`, `Unsupported` (no
    /// resolver: CosmoOS, the interpreter for names other than `localhost`).
    /// Safety: the runtime copies the name during the start; the lookup's record is the runtime's, ended once by
    /// `DnsLookup`'s drop, so no path leaves it or ends it twice.
    public async fn resolve(host: StringView, port: u16) -> Result<Vector<SocketAddress>, AsyncError> {
        var out = Vector<SocketAddress>.create();
        match (SocketAddresses.parseIp(host, port)) {
            Some(address) => {
                match (out.push(address)) {
                    Ok() => { return Ok(out); }
                    Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }
                }
            }
            null => {}
        }
        let name = host.bytes();
        var plain = name.length > 0 && name.length <= 253;
        for (b in name) {
            if (b == 0) {
                plain = false;
            }
        }
        if (!plain) {
            return Err(AsyncError.Io(IoError.InvalidInput));
        }
        let raw = unsafe { ceesafe_dns_start(name.ptr, name.length as u64, port) };
        if (raw.isNull()) {
            return Err(AsyncError.Io(IoError.OutOfMemory));
        }
        let lookup = DnsLookup { raw: raw };
        loop {
            AsyncLeaf.status()?; // cancelled: the drop leaves the lookup to its thread
            let r = unsafe { ceesafe_dns_poll(lookup.raw) };
            if (r == 1) {
                break;
            }
            if (r < 0) {
                return Err(AsyncError.Io(AsyncIo.ioError(r as i64)));
            }
            await Async.park();
        }
        let count = unsafe { ceesafe_dns_count(lookup.raw) };
        for (k in 0..count) {
            var bytes = [0u8; 16];
            var family: u32 = 0;
            var scope: u32 = 0;
            unsafe {
                ceesafe_dns_address(
                    lookup.raw,
                    k,
                    borrow mut bytes as *mut [u8; 16] as *mut u8,
                    borrow mut family as *mut u32,
                    borrow mut scope as *mut u32,
                );
            }
            let address = if (family == 4) SocketAddress.V4(
                [bytes[0], bytes[1], bytes[2], bytes[3]],
                port,
            ) else SocketAddress.V6(bytes, port, scope);
            match (out.push(address)) {
                Ok() => {}
                Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }
            }
        }
        return Ok(out);
    }
}

/// A lookup the runtime holds (ADR 0048 §3.3), ended exactly once, here.
@noncopy
struct DnsLookup {
    raw: *mut void;

    /// Safety: the record is this lookup's, and ended only here.
    drop {
        unsafe { ceesafe_dns_end(this.raw); }
    }
}
