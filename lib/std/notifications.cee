// Local notifications (ADR 0243; type-system.md §26.22): what a program tells its user while it is not on the screen,
// shown by the system: Android's NotificationManager, Apple's UNUserNotificationCenter.

extern "C" {
    @effects(sleep)
    fn ceesafe_notify_permission() -> i32;
    @effects(sleep)
    fn ceesafe_notify_show(id: *u8, idLength: u64, title: *u8, titleLength: u64, body: *u8, bodyLength: u64) -> i32;
    @effects(sleep)
    fn ceesafe_notify_clear(id: *u8, idLength: u64) -> i32;
}

/// Why a notification call failed.
public enum NotificationError {
    /// This system has no notifications CeeSafe posts: Windows, Linux, FreeBSD and CosmoOS (for now), a command-line
    /// program on macOS (no bundle), and `ceesafec run --interp`.
    Unsupported,
    /// The id, the title or the body is not one the system takes (`Notifications`).
    InvalidInput,
    /// The user refused the app's notifications, or turned them off.
    Denied,
    /// Anything else: an error of the system's.
    Failed,
}

/// The system's notifications (ADR 0243): each blocks until the system has it, and may be called from any thread but
/// the window's, whose run loop the system's answers need.
///
/// An `id` is 1 to 64 ASCII letters, digits, `.`, `-`, `_` and `:`; a `title` at most 256 bytes and a `body` at most
/// 4,096 bytes, neither with a zero byte.
///
/// ```
/// Notifications.requestPermission()?;                    // once, before the first
/// Notifications.show("chat:42", "Bob", "Are you there?")?;
/// Notifications.clear("chat:42")?;                       // read now
/// ```
///
/// Android: one channel named after the app, high importance; the app declares `POST_NOTIFICATIONS`. iOS, and a
/// bundled macOS app: `UNUserNotificationCenter`; nothing is shown while the app is in the foreground. A tap opens the
/// app. `CEESAFE_NOTIFICATIONS_DUMP=<file>` appends the calls to the file instead, natively on every system, for
/// tests. Under `ceesafec run --interp` every call is `Unsupported`.
public struct Notifications {
    /// Asks the user, once, whether the app may notify: `Ok` when it may, `Denied` when not.
    /// Safety: the runtime call takes no memory of the program's.
    public fn requestPermission() -> Result<void, NotificationError> {
        let code = unsafe { ceesafe_notify_permission() };
        return Notifications.resultOf(code);
    }

    /// Shows a notification, replacing the one shown with the same `id`.
    /// Safety: the runtime reads the views during the call only.
    public fn show(id: StringView, title: StringView, body: StringView) -> Result<void, NotificationError> {
        Notifications.checkId(id)?;
        if (title.length > 256 || body.length > 4096 || Notifications.hasZero(title) || Notifications.hasZero(body)) {
            return Err(NotificationError.InvalidInput);
        }
        let code = unsafe { ceesafe_notify_show(
            id.ptr,
            id.length as u64,
            title.ptr,
            title.length as u64,
            body.ptr,
            body.length as u64,
        ) };
        return Notifications.resultOf(code);
    }

    /// Removes the notification `id`; `Ok` when there is none.
    /// Safety: the runtime reads the view during the call only.
    public fn clear(id: StringView) -> Result<void, NotificationError> {
        Notifications.checkId(id)?;
        let code = unsafe { ceesafe_notify_clear(id.ptr, id.length as u64) };
        return Notifications.resultOf(code);
    }

    fn checkId(id: StringView) -> Result<void, NotificationError> {
        if (id.length == 0 || id.length > 64) {
            return Err(NotificationError.InvalidInput);
        }
        for (b in id.bytes()) {
            let letter = (b >= 'a' as u8 && b <= 'z' as u8) || (b >= 'A' as u8 && b <= 'Z' as u8);
            let digit = b >= '0' as u8 && b <= '9' as u8;
            if (!letter && !digit && b != '.' as u8 && b != '-' as u8 && b != '_' as u8 && b != ':' as u8) {
                return Err(NotificationError.InvalidInput);
            }
        }
        return Ok();
    }

    fn hasZero(text: StringView) -> bool {
        for (b in text.bytes()) {
            if (b == 0) {
                return true;
            }
        }
        return false;
    }

    /// The runtime's codes: 0 done, -2 Unsupported, -3 InvalidInput, -5 Denied, anything else Failed.
    fn resultOf(code: i32) -> Result<void, NotificationError> => match (code) {
        0 => Ok(),
        -2 => Err(NotificationError.Unsupported),
        -3 => Err(NotificationError.InvalidInput),
        -5 => Err(NotificationError.Denied),
        _ => Err(NotificationError.Failed),
    };
}
