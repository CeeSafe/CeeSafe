// Push tokens (ADR 0244; type-system.md §26.23): the token a server sends this device's push notifications to, from
// the system's push service: Apple's APNs on iOS.

extern "C" {
    @effects(sleep)
    fn ceesafe_push_token(out: *mut u8, capacity: u64) -> i64;
    @effects(sleep)
    fn ceesafe_push_extension_next(milliseconds: u32, out: *mut u8, capacity: u64, id: *mut u64) -> i64;
    @effects(sleep)
    fn ceesafe_push_extension_deliver(id: u64, title: *u8, titleLength: u64, body: *u8, bodyLength: u64) -> i32;
    @effects(sleep)
    fn ceesafe_push_group_folder(group: *u8, groupLength: u64, out: *mut u8, capacity: u64) -> i64;
}

/// Why no push token came.
public enum PushError {
    /// This system has no push service CeeSafe registers with: Android (for now), macOS, Windows, Linux, FreeBSD,
    /// CosmoOS, a program with no window, and `ceesafec run --interp`.
    Unsupported,
    /// The system refused: the app is not signed for push notifications (iOS's `aps-environment`), or the service
    /// could not be reached.
    Denied,
    /// Anything else: no answer in time, an error of the system's.
    Failed,
}

/// The push service a token is for.
public enum PushService {
    /// Apple's Push Notification service: a server sends to `api.push.apple.com`, or to the sandbox.
    Apns,
    /// Firebase Cloud Messaging.
    Fcm,
}

/// This device's token, and where a server sends to it.
public struct PushToken {
    public service: PushService;
    /// The token: for APNs the device token's bytes in hex.
    public token: String;
    /// For APNs: whether the build is a development one, whose pushes go to the sandbox (`api.sandbox.push.apple.com`).
    public sandbox: bool;
}

/// The system's push service (ADR 0244).
///
/// ```
/// let device = Push.register()?;          // once a run: the token may change
/// // send device.token (and device.sandbox) to the app's server
/// ```
///
/// iOS: the app registers with APNs (its signing must grant `aps-environment`: CeeUI's packer's `--push`) and the
/// token comes from Apple; the user's permission to show notifications is `Notifications.requestPermission`'s.
/// `CEESAFE_PUSH_TOKEN=<text>` is the token instead, natively on every system, for tests (`apns:HEX`,
/// `apns-sandbox:HEX` or `fcm:TOKEN`). Under `ceesafec run --interp` it is `Unsupported`.
public struct Push {
    /// Registers with the system's push service and returns this device's token. It blocks until the service answers
    /// (30 seconds at most) and may be called from any thread but the window's.
    /// Safety: the runtime writes at most the buffer's length.
    public fn register() -> Result<PushToken, PushError> {
        var buffer = [0u8; 1024];
        let length = unsafe { ceesafe_push_token(borrow mut buffer[0] as *mut u8, 1024) };
        if (length < 0) {
            return Err(match (length) {
                -2 => PushError.Unsupported,
                -5 => PushError.Denied,
                _ => PushError.Failed,
            });
        }
        let text = match (StringView.fromUtf8(buffer[0..truncate<usize>(length)])) {
            Some(t) => t,
            null => { return Err(PushError.Failed); }
        };
        var service = PushService.Apns;
        var sandbox = false;
        var at: usize = 0;
        if (text.startsWith("apns-sandbox:")) {
            sandbox = true;
            at = 13;
        } else if (text.startsWith("apns:")) {
            at = 5;
        } else if (text.startsWith("fcm:")) {
            service = PushService.Fcm;
            at = 4;
        } else {
            return Err(PushError.Failed);
        }
        let rest = text[at..];
        if (rest.length == 0) {
            return Err(PushError.Failed);
        }
        var token = String.create();
        match (token.append(rest)) {
            Ok() => {}
            Err(_) => { return Err(PushError.Failed); }
        }
        return Ok(PushToken { service: service, token: token, sandbox: sandbox });
    }
}

/// A push a notification service extension was handed (ADR 0246), to show as it is or rewritten (`deliver`).
public struct PushRequest {
    id: u64;
    /// The title and body the server sent (a content-free alert, for a messenger's end-to-end encrypted text).
    public title: String;
    public body: String;
    /// The push's payload, its `userInfo`, as JSON (the server's own keys beside `aps`).
    public payload: String;
}

/// A notification service extension's side of the system (ADR 0246): on iOS, a program built into the app's
/// `PlugIns/<name>.appex` (CeeUI's packer's `--extension`) runs its `main` while the extension lives and is handed each
/// push that carries `mutable-content` before the system shows it; it shows what `deliver` gives, or the push as it
/// came when the system's time (about 30 seconds) runs out. On Android (ADR 0263) the same program, packed beside the
/// app's (`--extension` with `--firebase`), is started by the app's Firebase service in a process of its own for a push
/// while the app is not running, and handed each push (its payload: the data as JSON); one not delivered within 8
/// seconds is shown as it came. Elsewhere, and in an app, `Unsupported`.
/// `CEESAFE_PUSH_REQUEST=<file>` is one push instead, on every system (its title, body and payload JSON on three
/// lines); a delivery is appended to `CEESAFE_NOTIFICATIONS_DUMP` as `deliver TITLE<TAB>BODY`.
///
/// ```
/// loop {
///     match (NotificationExtension.next(60000)?) {
///         Some(push) => { NotificationExtension.deliver(push, "Bob", "the decrypted text")?; }
///         null => {}
///     }
/// }
/// ```
public struct NotificationExtension {
    /// The next push, within `milliseconds`, or null when none came.
    /// Safety: the runtime writes at most the buffer's length, and the id.
    public fn next(milliseconds: u32) -> Result<PushRequest?, PushError> {
        var buffer = Vector<u8>.create();
        match (buffer.resize(65536, 0)) {
            Ok() => {}
            Err(_) => { return Err(PushError.Failed); }
        }
        var id: u64 = 0;
        let length = unsafe { ceesafe_push_extension_next(
            milliseconds,
            borrow mut buffer[0] as *mut u8,
            65536,
            borrow mut id as *mut u64,
        ) };
        if (length == 0) {
            return Ok(null);
        }
        if (length < 0) {
            return Err(if (length == -2) PushError.Unsupported else PushError.Failed);
        }
        let record = buffer.view()[0..truncate<usize>(length)];
        var parts: [usize; 2] = [0, 0];
        var found: usize = 0;
        for (i in 0..record.length) {
            if (record[i] == 0 && found < 2) {
                parts[found] = i;
                found += 1;
            }
        }
        if (found < 2) {
            return Err(PushError.Failed);
        }
        var request = PushRequest { id: id, title: String.create(), body: String.create(), payload: String.create() };
        let ok = request.title.append(StringView.fromUtf8(record[0..parts[0]]) ?? "").isOk() &&
            request.body.append(StringView.fromUtf8(record[(parts[0] + 1)..parts[1]]) ?? "").isOk() &&
            request.payload.append(StringView.fromUtf8(record[(parts[1] + 1)..record.length]) ?? "").isOk();
        if (!ok) {
            return Err(PushError.Failed);
        }
        return Ok(Some(request));
    }

    /// Shows the push with `title` (the push's own when empty) and `body`; `Failed` when its time already ran out
    /// (the system showed it as it came).
    /// Safety: the runtime reads the views during the call only.
    public fn deliver(request: borrow PushRequest, title: StringView, body: StringView) -> Result<void, PushError> {
        let code = unsafe { ceesafe_push_extension_deliver(
            request.id,
            title.ptr,
            title.length as u64,
            body.ptr,
            body.length as u64,
        ) };
        return if (code == 0) Ok() else if (code == -2) Err(PushError.Unsupported) else Err(PushError.Failed);
    }
}

/// An App Group's shared folder (ADR 0246): on Apple's systems the folder an app and its extensions both reach, for
/// the group they are signed with (`group.com.example.app`); on Android, which has no groups, the app's files folder,
/// which the app and its notification extension's process share (ADR 0263); null where there is none (not signed for
/// it, or another system).
public struct AppGroup {
    /// Safety: the runtime reads the name during the call only, and writes at most the buffer's length.
    public fn folder(group: StringView) -> String? {
        if (group.length == 0 || group.length > 255) {
            return null;
        }
        var buffer = [0u8; 2048];
        let length = unsafe { ceesafe_push_group_folder(
            group.ptr,
            group.length as u64,
            borrow mut buffer[0] as *mut u8,
            2048,
        ) };
        if (length <= 0) {
            return null;
        }
        var path = String.create();
        match (path.append(StringView.fromUtf8(buffer[0..truncate<usize>(length)]) ?? "")) {
            Ok() => {}
            Err(_) => { return null; }
        }
        return Some(path);
    }
}
