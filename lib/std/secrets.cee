// The system's secret store (ADR 0242; type-system.md §26.21): an app's tokens and keys where the system keeps them
// encrypted, readable by this app only: Apple's keychain, Android's Keystore, Windows' DPAPI.

extern "C" {
    @effects(sleep)
    fn ceesafe_secrets_read(app: *u8, appLength: u64, name: *u8, nameLength: u64, out: *mut u8, capacity: u64) -> i64;
    @effects(sleep)
    fn ceesafe_secrets_write(app: *u8, appLength: u64, name: *u8, nameLength: u64, value: *u8, length: u64) -> i32;
    @effects(sleep)
    fn ceesafe_secrets_remove(app: *u8, appLength: u64, name: *u8, nameLength: u64) -> i32;
    @effects(sleep)
    fn ceesafe_secrets_group_read(
        group: *u8,
        groupLength: u64,
        app: *u8,
        appLength: u64,
        name: *u8,
        nameLength: u64,
        out: *mut u8,
        capacity: u64,
    ) -> i64;
    @effects(sleep)
    fn ceesafe_secrets_group_write(
        group: *u8,
        groupLength: u64,
        app: *u8,
        appLength: u64,
        name: *u8,
        nameLength: u64,
        value: *u8,
        length: u64,
    ) -> i32;
    @effects(sleep)
    fn ceesafe_secrets_key(
        op: i32,
        app: *u8,
        appLength: u64,
        name: *u8,
        nameLength: u64,
        input: *u8,
        inputLength: u64,
        out: *mut u8,
        capacity: u64,
    ) -> i64;
    @effects(sleep)
    fn ceesafe_secrets_group_remove(
        group: *u8,
        groupLength: u64,
        app: *u8,
        appLength: u64,
        name: *u8,
        nameLength: u64,
    ) -> i32;
}

/// Why a call to the secret store failed.
public enum SecretError {
    /// This system has no store CeeSafe uses: Linux, FreeBSD and CosmoOS (for now), and `ceesafec run --interp`.
    Unsupported,
    /// The app's or the secret's name, or the value, is not one the store takes (`Secrets`).
    InvalidInput,
    /// The store cannot be read until the user unlocks the device or signs in.
    Locked,
    /// The system refused this program: an iOS app without its keychain entitlement, or the user refused macOS's
    /// prompt.
    Denied,
    /// Anything else: the Keystore's key is gone, a value no longer opens, an error of the system's.
    Failed,
}

/// The system's store for an app's secrets (ADR 0242): kept encrypted by the system, readable by this app only, and
/// never carried to another device. Every call blocks and may be made from any thread.
///
/// `app` names the app's own set, as `Directory.appData`'s name names its folder: not empty, no `/` or `\`, not `.`
/// or `..`, at most 128 bytes. A secret's `name` is 1 to 128 ASCII letters, digits, `.`, `-` and `_`, not `.` or
/// `..`.
///
/// ```
/// Secrets.write("Marivil", "token", token.bytes())?;
/// match (Secrets.read("Marivil", "token")?) {
///     Some(bytes) => {}  // kept since an earlier run
///     null => {}         // never written, or removed
/// }
/// ```
///
/// macOS and iOS: a keychain item (service `app`, account `name`), this device only, readable after the first
/// unlock. Android: sealed with an AES-256-GCM key in the Android Keystore, in the app's no-backup folder. Windows:
/// DPAPI, for the current user, in `%LOCALAPPDATA%\<app>\secrets`. `CEESAFE_SECRETS_DIR=<folder>` keeps them as plain
/// files in that folder instead, natively on every system, for tests. Under `ceesafec run --interp` every call is
/// `Unsupported`.
public struct Secrets {
    /// The largest value `Secrets.write` takes, in bytes (65,536): a store for keys and tokens, not documents.
    public fn valueLimit() -> usize => 65536;

    /// The secret `name` of `app`, or `null` when there is none.
    /// Safety: the runtime reads the names during the call only, and writes at most the buffer's length.
    public fn read(app: StringView, name: StringView) -> Result<Vector<u8>?, SecretError> {
        Secrets.check(app, name)?;
        var buffer = Vector<u8>.create();
        match (buffer.resize(Secrets.valueLimit(), 0)) {
            Ok() => {}
            Err(_) => { return Err(SecretError.Failed); }
        }
        let length = unsafe { ceesafe_secrets_read(
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
            borrow mut buffer[0] as *mut u8,
            Secrets.valueLimit() as u64,
        ) };
        if (length == -1) {
            return Ok(null);
        }
        if (length < 0) {
            return Err(Secrets.errorOf(length));
        }
        buffer.truncate(truncate<usize>(length));
        return Ok(Some(buffer));
    }

    /// Makes the secret `name` of `app`, or replaces it; a reader sees the old value or the new, never part of one.
    /// Safety: the runtime reads the names and the value during the call only.
    public fn write(app: StringView, name: StringView, value: Slice<u8>) -> Result<void, SecretError> {
        Secrets.check(app, name)?;
        if (value.length > Secrets.valueLimit()) {
            return Err(SecretError.InvalidInput);
        }
        let code = unsafe { ceesafe_secrets_write(
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
            value.ptr,
            value.length as u64,
        ) };
        if (code != 0) {
            return Err(Secrets.errorOf(code as i64));
        }
        return Ok();
    }

    /// Removes the secret `name` of `app`; `Ok` when there was none.
    /// Safety: the runtime reads the names during the call only.
    public fn remove(app: StringView, name: StringView) -> Result<void, SecretError> {
        Secrets.check(app, name)?;
        let code = unsafe { ceesafe_secrets_remove(app.ptr, app.length as u64, name.ptr, name.length as u64) };
        if (code != 0) {
            return Err(Secrets.errorOf(code as i64));
        }
        return Ok();
    }

    /// `read`, in the keychain group `group` shared with the app's extensions (ADR 0246): on Apple's systems an App
    /// Group (`group.com.example.app`) or a team-prefixed keychain group the app and its extensions are signed with;
    /// elsewhere the group changes nothing (an app's secrets are its own there). `group` is 1 to 256 bytes.
    /// Safety: the runtime reads the names during the call only, and writes at most the buffer's length.
    public fn readIn(group: StringView, app: StringView, name: StringView) -> Result<Vector<u8>?, SecretError> {
        Secrets.check(app, name)?;
        Secrets.checkGroup(group)?;
        var buffer = Vector<u8>.create();
        match (buffer.resize(Secrets.valueLimit(), 0)) {
            Ok() => {}
            Err(_) => { return Err(SecretError.Failed); }
        }
        let length = unsafe { ceesafe_secrets_group_read(
            group.ptr,
            group.length as u64,
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
            borrow mut buffer[0] as *mut u8,
            Secrets.valueLimit() as u64,
        ) };
        if (length == -1) {
            return Ok(null);
        }
        if (length < 0) {
            return Err(Secrets.errorOf(length));
        }
        buffer.truncate(truncate<usize>(length));
        return Ok(Some(buffer));
    }

    /// `write`, in the shared keychain group `group` (`readIn`).
    /// Safety: the runtime reads the names and the value during the call only.
    public fn writeIn(
        group: StringView,
        app: StringView,
        name: StringView,
        value: Slice<u8>,
    ) -> Result<void, SecretError> {
        Secrets.check(app, name)?;
        Secrets.checkGroup(group)?;
        if (value.length > Secrets.valueLimit()) {
            return Err(SecretError.InvalidInput);
        }
        let code = unsafe { ceesafe_secrets_group_write(
            group.ptr,
            group.length as u64,
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
            value.ptr,
            value.length as u64,
        ) };
        if (code != 0) {
            return Err(Secrets.errorOf(code as i64));
        }
        return Ok();
    }

    /// `remove`, in the shared keychain group `group` (`readIn`).
    /// Safety: the runtime reads the names during the call only.
    public fn removeIn(group: StringView, app: StringView, name: StringView) -> Result<void, SecretError> {
        Secrets.check(app, name)?;
        Secrets.checkGroup(group)?;
        let code = unsafe { ceesafe_secrets_group_remove(
            group.ptr,
            group.length as u64,
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
        ) };
        if (code != 0) {
            return Err(Secrets.errorOf(code as i64));
        }
        return Ok();
    }

    fn checkGroup(group: StringView) -> Result<void, SecretError> {
        if (group.length == 0 || group.length > 256) {
            return Err(SecretError.InvalidInput);
        }
        for (b in group.bytes()) {
            if (b == 0) {
                return Err(SecretError.InvalidInput);
            }
        }
        return Ok();
    }

    /// `InvalidInput` unless `app` and `name` are names the store takes.
    fn check(app: StringView, name: StringView) -> Result<void, SecretError> {
        if (app.length == 0 || app.length > 128 || app == "." || app == "..") {
            return Err(SecretError.InvalidInput);
        }
        for (b in app.bytes()) {
            if (b == '/' as u8 || b == '\\' as u8 || b == 0) {
                return Err(SecretError.InvalidInput);
            }
        }
        if (name.length == 0 || name.length > 128 || name == "." || name == "..") {
            return Err(SecretError.InvalidInput);
        }
        for (b in name.bytes()) {
            let letter = (b >= 'a' as u8 && b <= 'z' as u8) || (b >= 'A' as u8 && b <= 'Z' as u8);
            let digit = b >= '0' as u8 && b <= '9' as u8;
            if (!letter && !digit && b != '.' as u8 && b != '-' as u8 && b != '_' as u8) {
                return Err(SecretError.InvalidInput);
            }
        }
        return Ok();
    }

    /// The runtime's codes: -2 Unsupported, -3 InvalidInput, -4 Locked, -5 Denied, anything else Failed (-1, none, is
    /// the caller's).
    fn errorOf(code: i64) -> SecretError => match (code) {
        -2 => SecretError.Unsupported,
        -3 => SecretError.InvalidInput,
        -4 => SecretError.Locked,
        -5 => SecretError.Denied,
        _ => SecretError.Failed,
    };
}

/// How a new device key's hardware vouches for it (ADR 0275).
public enum KeyAttestation {
    /// None: an existing key, a key the system made in software, or a system without attestation.
    None,
    /// Android's key attestation: `DeviceKeyInfo.certificates`, the Keystore's chain (DER), the key's first, with
    /// the challenge inside the first certificate's attestation extension.
    AndroidKeyChain,
    /// Apple's App Attest: `DeviceKeyInfo.appAttest`, the attestation object (CBOR) of a new App Attest key over
    /// SHA-256(challenge || the device key's SPKI). The app needs the App Attest entitlement.
    AppleAppAttest,
}

/// A device key's public half and how it was found (ADR 0275).
public struct DeviceKeyInfo {
    /// The public half: a P-256 SubjectPublicKeyInfo, DER (91 bytes).
    public publicKey: Vector<u8>;
    /// Made by this call (an existing key otherwise).
    public created: bool;
    /// Held by hardware (the Secure Enclave, StrongBox or a TEE); null when the system was not asked (an existing
    /// key on Apple's systems).
    public hardware: bool?;
    public attestation: KeyAttestation;
    /// `AndroidKeyChain`'s certificates, the key's first.
    public certificates: Vector<Vector<u8>>;
    /// `AppleAppAttest`'s object.
    public appAttest: Vector<u8>;
}

/// A device's own signing key (ADR 0275; type-system.md §26.21): a P-256 key the system makes and keeps in hardware
/// where it can (the Secure Enclave, Android's StrongBox or TEE), whose private half never leaves it: it signs, and
/// its public half is what a server enrolls. Not bound to the user's presence: it signs in the background. Every call
/// blocks and may be made from any thread; `app` and `name` are as for `Secrets`.
///
/// ```
/// let key = DeviceKey.obtain("Marivil", "device", nonce.bytes())?;   // made the first time, attested then
/// let signature = DeviceKey.sign("Marivil", "device", payload)? ?? { return reenroll(); };
/// ```
///
/// macOS and iOS: the Secure Enclave, tagged "<app>.<name>", after the first unlock, this device only (a key in the
/// keychain where the Enclave cannot hold it: an unsigned macOS program, a simulator); a new key is attested with App
/// Attest where the app may. Android: the Android Keystore, alias "ceesafe.key.<app>.<name>", its attestation chain
/// carrying the challenge. Windows, Linux, FreeBSD, `CEESAFE_SECRETS_DIR` and the interpreter: `Unsupported`.
public struct DeviceKey {
    /// The key, made when there is none: a new key is attested over `challenge` (a server's nonce); an empty
    /// challenge asks for no attestation.
    /// Safety: the runtime reads the names and the challenge during the call, and writes at most the buffer's length.
    public fn obtain(app: StringView, name: StringView, challenge: Slice<u8>) -> Result<DeviceKeyInfo, SecretError> {
        var out = Vector<u8>.create();
        if (out.resize(65536, 0) is Err(_)) {
            return Err(SecretError.Failed);
        }
        let into = out.viewMut();
        let n = unsafe { ceesafe_secrets_key(
            0,
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
            challenge.ptr,
            challenge.length as u64,
            into.ptr,
            65536,
        ) };
        if (n < 0) {
            return Err(Secrets.errorOf(n));
        }
        let b = out.view()[0..truncate<usize>(n)];
        if (b.length < 7) {
            return Err(SecretError.Failed);
        }
        var info = DeviceKeyInfo {
            publicKey: Vector<u8>.create(),
            created: b[0] == 1,
            hardware: if (b[1] == 2) null else Some(b[1] == 1),
            attestation: KeyAttestation.None,
            certificates: Vector<Vector<u8>>.create(),
            appAttest: Vector<u8>.create(),
        };
        var at: usize = 3;
        let spki = DeviceKey.piece(b, mut at) ?? { return Err(SecretError.Failed); };
        info.publicKey = spki;
        if (b[2] == 1) {
            let count = DeviceKey.number(b, mut at) ?? { return Err(SecretError.Failed); };
            for (k in 0u32..count) {
                let certificate = DeviceKey.piece(b, mut at) ?? { return Err(SecretError.Failed); };
                if (info.certificates.push(certificate) is Err(_)) {
                    return Err(SecretError.Failed);
                }
            }
            info.attestation = KeyAttestation.AndroidKeyChain;
        } else if (b[2] == 2) {
            info.appAttest = DeviceKey.piece(b, mut at) ?? { return Err(SecretError.Failed); };
            info.attestation = KeyAttestation.AppleAppAttest;
        }
        return Ok(info);
    }

    /// The key's public half (SPKI, DER), or null when there is none. Never makes one.
    /// Safety: as obtain.
    public fn publicKey(app: StringView, name: StringView) -> Result<Vector<u8>?, SecretError> {
        return DeviceKey.call(1, app, name, Vector<u8>.create().view(), 256);
    }

    /// `message` signed with the key: ECDSA P-256 with SHA-256, DER; null when there is no key.
    /// Safety: as obtain.
    public fn sign(app: StringView, name: StringView, message: Slice<u8>) -> Result<Vector<u8>?, SecretError> {
        return DeviceKey.call(2, app, name, message, 256);
    }

    /// Removes the key (nothing when there is none).
    /// Safety: as obtain.
    public fn remove(app: StringView, name: StringView) -> Result<void, SecretError> {
        return match (DeviceKey.call(3, app, name, Vector<u8>.create().view(), 16)) {
            Ok(_) => Ok(),
            Err(e) => Err(e),
        };
    }

    /// Safety: as obtain.
    fn call(op: i32, app: StringView, name: StringView, input: Slice<u8>, capacity: usize)
        -> Result<Vector<u8>?, SecretError> {
        var out = Vector<u8>.create();
        if (out.resize(capacity, 0) is Err(_)) {
            return Err(SecretError.Failed);
        }
        let into = out.viewMut();
        let n = unsafe { ceesafe_secrets_key(
            op,
            app.ptr,
            app.length as u64,
            name.ptr,
            name.length as u64,
            input.ptr,
            input.length as u64,
            into.ptr,
            capacity as u64,
        ) };
        if (n == -1) {
            return Ok(null);
        }
        if (n < 0) {
            return Err(Secrets.errorOf(n));
        }
        var answer = Vector<u8>.create();
        for (b in out.view()[0..truncate<usize>(n)]) {
            if (answer.push(b) is Err(_)) {
                return Err(SecretError.Failed);
            }
        }
        return Ok(Some(answer));
    }

    /// A 4-byte big-endian number at `at`, which moves past it.
    fn number(b: Slice<u8>, at: borrow mut usize) -> u32? {
        if (at + 4 > b.length) {
            return null;
        }
        let v = ((b[at] as u32) << 24) | ((b[at + 1] as u32) << 16) | ((b[at + 2] as u32) << 8) | (b[at + 3] as u32);
        at += 4;
        return Some(v);
    }

    /// The bytes after a 4-byte length at `at`, which moves past them.
    fn piece(b: Slice<u8>, at: borrow mut usize) -> Vector<u8>? {
        let n = DeviceKey.number(b, mut at)? as usize;
        if (at + n > b.length) {
            return null;
        }
        var out = Vector<u8>.create();
        for (x in b[at..at + n]) {
            if (out.push(x) is Err(_)) {
                return null;
            }
        }
        at += n;
        return Some(out);
    }
}
