// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Shared state between threads (type-system.md §38.3, ADR 0016): Arc and Mutex, over the hosted runtime
// (runtime/hosted/ceesafe_rt_thread.c). Their unsafe code keeps ownership.md T1–T3. The atomics are in lib/core (ADR 0026).

extern "C" {
    @effects(alloc)
    fn ceesafe_mutex_create() -> *mut void;
    @effects(sleep)
    fn ceesafe_mutex_lock(m: *mut void);
    @effects()
    fn ceesafe_mutex_try_lock(m: *mut void) -> bool;
    @effects()
    fn ceesafe_mutex_unlock(m: *mut void);
    @effects()
    fn ceesafe_async_lock_held(kind: u32, lock: *mut void, flag: *mut u32);
    @effects()
    fn ceesafe_async_lock_released(lock: *mut void);
    @effects()
    fn ceesafe_panic_poisoned();
    @effects()
    fn ceesafe_mutex_destroy(m: *mut void);
    @effects(sleep)
    fn ceesafe_mutex_once_lock();
    @effects()
    fn ceesafe_mutex_once_unlock();
    @effects(sleep)
    fn ceesafe_thread_sleep(ms: u64);
    @effects()
    fn ceesafe_thread_cpu_count() -> u32;
}

/// Thread services that are not a thread's own (ADR 0222): `Thread.sleep(ms)` is the checker's name for
/// ThreadServices.sleep(ms), as `Console.flush()` is HostServices.flush().
public struct ThreadServices {
    /// `Thread.sleep(ms)`: the calling thread waits at least `ms` milliseconds; 0 returns at once. It blocks the
    /// thread, so an async function cannot call it (its effect is `sleep`): a task waits with `Timer.sleep(ms)`.
    /// Safety: the runtime only waits.
    public fn sleep(ms: u64) {
        unsafe { ceesafe_thread_sleep(ms); }
    }

    /// `Thread.cpuCount()`: how many CPUs this process may run on, at least 1 (ADR 0237): on Linux those in its
    /// affinity mask (so `taskset` and a container's cpuset count, a CPU-time quota does not), elsewhere the online
    /// ones. Asked of the system each time; it never waits. The interpreter runs one thread at a time and answers 1.
    /// Safety: the runtime only reads the system's count.
    public fn cpuCount() -> u32 => unsafe { ceesafe_thread_cpu_count() };
}

/// Mutual exclusion: the data is reached only through a guard, which one thread holds at a time.
@threadSafe
@noncopy
public struct Mutex<T: Send> {
    /// The platform lock's address, or 0 before the first use of a mutex made by `constant`.
    private raw: AtomicUSize;
    private data: RawCell<T>; // changed through the guard while the mutex is shared (type-system.md §41.1)
    /// 1 once an isolated task that held the lock trapped (ADR 0175 §2.6), until `heal`.
    private poisoned: AtomicU32;

    /// A mutex holding `data`; its platform lock is allocated.
    /// Safety: a null lock is reported, never stored.
    public fn create(data: T) -> Result<Mutex<T>, AllocError> {
        let raw = unsafe { ceesafe_mutex_create() };
        if (raw.isNull()) {
            return Err(AllocError.OutOfMemory);
        }
        return Ok(
            Mutex {
                raw: AtomicUSize.create(raw as usize),
                data: RawCell<T>.create(data),
                poisoned: AtomicU32.create(0),
            },
        );
    }

    /// A mutex holding `data`, as a static initialiser when `data` is one (type-system.md §39.4):
    /// `static TABLE: Mutex<Vector<u64>> = Mutex<Vector<u64>>.constant(Vector<u64>.empty());`. Its platform lock is
    /// allocated at its first use, where running out of memory panics: `create` reports it instead.
    @constant
    public fn constant(data: T) -> Mutex<T> =>
        Mutex { raw: AtomicUSize.constant(0), data: RawCell<T>.constant(data), poisoned: AtomicU32.constant(0) };

    /// The platform lock, made now if this mutex came from `constant` and was never used. Two threads that arrive
    /// together both make one, and the one that loses the exchange destroys its own.
    /// Safety: a lock is stored only once, never replaced, and destroyed only in drop or here before any use.
    fn lockHandle(borrow this) -> *mut void {
        let have = this.raw.load();
        if (have != 0) {
            return have as *mut void;
        }
        let made = unsafe { ceesafe_mutex_create() };
        if (made.isNull()) {
            panic("out of memory making a constant Mutex's lock");
        }
        match (this.raw.compareExchange(0, made as usize)) {
            Ok(_) => { return made; }
            Err(other) => {
                unsafe { ceesafe_mutex_destroy(made); }
                return other as *mut void;
            }
        }
    }

    /// Waits for the lock; the guard lends the data until it is dropped. It panics (`PanicKind.Poisoned`) if an
    /// isolated task that held the lock trapped (ADR 0175 §2.6): the data may break its invariant. `recover` is for
    /// code that can repair it.
    /// Safety: `raw` is the lock made in create, destroyed only in drop, when no guard can be live (B-rules).
    public fn lock(borrow this) -> MutexGuard<T> {
        unsafe { ceesafe_mutex_lock(this.lockHandle()); }
        if (this.poisoned.load() != 0) {
            unsafe {
                ceesafe_mutex_unlock(this.lockHandle());
                ceesafe_panic_poisoned();
            }
        }
        this.held();
        return MutexGuard { lock: this };
    }

    /// `lock`, whether or not the mutex is poisoned: `guard.poisoned()` says which, and `guard.heal()` clears the
    /// mark once the data is whole again.
    /// Safety: as `lock`.
    public fn recover(borrow this) -> MutexGuard<T> {
        unsafe { ceesafe_mutex_lock(this.lockHandle()); }
        this.held();
        return MutexGuard { lock: this };
    }

    /// `tryLock`, whether or not the mutex is poisoned: for async code, which cannot wait for a lock.
    /// Safety: as `tryLock`.
    public fn tryRecover(borrow this) -> MutexGuard<T>? {
        if (!unsafe { ceesafe_mutex_try_lock(this.lockHandle()) }) {
            return null;
        }
        this.held();
        return Some(MutexGuard { lock: this });
    }

    /// Tells the runtime that the running task holds the lock: if it is an isolated task that traps, the lock is
    /// poisoned and released.
    /// Safety: the flag is this mutex's, which outlives the guard that holds the lock.
    fn held(borrow this) {
        unsafe { ceesafe_async_lock_held(1, this.lockHandle(), borrow this.poisoned as *AtomicU32 as *mut u32); }
    }

    /// The guard if no thread holds the lock, else null, at once: it never waits (ADR 0112). The thread that holds
    /// the lock gets null too. It has no effect, so async code may call it.
    /// Safety: as `lock`; the guard exists only when the lock was taken.
    public fn tryLock(borrow this) -> MutexGuard<T>? {
        if (!unsafe { ceesafe_mutex_try_lock(this.lockHandle()) }) {
            return null;
        }
        if (this.poisoned.load() != 0) {
            unsafe {
                ceesafe_mutex_unlock(this.lockHandle());
                ceesafe_panic_poisoned();
            }
        }
        this.held();
        return Some(MutexGuard { lock: this });
    }

    /// Safety: no guard is live once the mutex can be dropped, so the lock is free.
    drop {
        let have = this.raw.load();
        if (have != 0) {
            unsafe { ceesafe_mutex_destroy(have as *mut void); }
        }
    }
}

/// Holding a Mutex: `data()` lends the protected value; dropping the guard unlocks.
public struct MutexGuard<region r, T: Send> {
    private lock: borrow(r) Mutex<T>;

    /// Safety: the guard holds the lock, so no other thread reaches the cell's contents, and the loan ends before the
    /// guard's drop (a RawCell's contents may change while the mutex is shared, §41.1).
    public fn data(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.lock.data.pointer()) };

    /// Whether an isolated task that held the lock trapped, and nothing has healed it since (ADR 0175 §2.6).
    public fn poisoned(borrow this) -> bool => this.lock.poisoned.load() != 0;

    /// Clears the mark: the data is whole again.
    public fn heal(borrow this) {
        this.lock.poisoned.store(0);
    }

    /// Safety: the guard took the lock in Mutex.lock and releases it once.
    drop {
        unsafe {
            ceesafe_async_lock_released(this.lock.lockHandle());
            ceesafe_mutex_unlock(this.lock.lockHandle());
        }
    }
}

struct ArcInner<T> {
    count: AtomicU64;
    value: T;
}

/// Shared ownership across threads: each clone is an owner, and the last owner's drop destroys the value.
@threadSafe
@noncopy
public struct Arc<T: Share> {
    private inner: *mut ArcInner<T>;

    /// Safety: the pointer comes from Box.intoRaw and is given back once, by the last owner's drop.
    public fn create(value: T) -> Result<Arc<T>, AllocError> {
        let boxed = Box.create(ArcInner { count: AtomicU64.create(1), value: value })?;
        return Ok(Arc { inner: Box.intoRaw(boxed) });
    }

    /// Another owner of the same value.
    /// Safety: this owner keeps the value alive while the count is raised.
    public fn clone(borrow this) -> Arc<T> {
        this.shared().count.fetchAdd(1);
        return Arc { inner: this.inner };
    }

    /// The shared value, for as long as this owner is borrowed.
    /// Safety: the value lives while any owner does; T is Share, so shared references to it may cross threads.
    public fn get(borrow this) -> borrow T => borrow this.shared().value;

    /// The value, to change in place, when this is its only owner (ADR 0224); null while another owner exists, which
    /// may be reading it on another thread. Values that several owners change go in a `Mutex`: `Arc<Mutex<T>>`.
    /// Safety: a count of one is this owner alone. No other owner can appear while it is borrowed exclusively, since
    /// only an owner makes another (`clone`, through a borrow of it), and Arc has no weak references. The load is
    /// sequentially consistent, so it is ordered after every earlier owner's drop, as the last owner's drop is.
    public fn getMut(borrow mut this) -> (borrow mut T)? {
        if (this.shared().count.load() != 1) {
            return null;
        }
        let inner: borrow mut ArcInner<T> = unsafe { Ptr.toBorrowMut(this.inner) };
        return Some(borrow mut inner.value);
    }

    /// Safety: as get.
    fn shared(borrow this) -> borrow ArcInner<T> => unsafe { Ptr.toBorrow(this.inner as *ArcInner<T>) };

    /// Safety: only the owner that brings the count from one to zero gives the box back.
    drop {
        if (this.shared().count.fetchSub(1) == 1) {
            let last: Box<ArcInner<T>> = unsafe { Box.fromRaw(this.inner) };
        }
    }
}

/// Why Thread.spawn failed: the thread, its record or its closure could not be allocated (type-system.md §38.2).
public enum SpawnError {
    Resources,
}

/// A value written at most once and then read from any thread (§38.3, ADR 0096): `OnceCell` (lib/core, §41.4) for
/// values that threads share. Empty at first, then full for as long as the lock is shared, lending `borrow T`. One
/// thread runs an initialiser at a time, under one lock for the process; a thread that finds a full cell reads it
/// with one atomic load and takes no lock. A full cell changes only through an exclusive borrow (`take`, `getMut`).
/// The state is one byte: 0 empty, 1 the initialiser is running, 2 full.
@threadSafe
@noncopy
public struct OnceLock<T: Send + Share> {
    private state: AtomicU8;
    private raw: RawCell<T?>;

    /// An empty cell.
    public fn create() -> OnceLock<T> => OnceLock { state: AtomicU8.create(0), raw: RawCell<T?>.create(null) };

    /// An empty cell, as a static initialiser (type-system.md §39.4): `static CONFIG: OnceLock<Config> =
    /// OnceLock<Config>.constant();`, filled once with `getOrInit` or `tryInit`.
    @constant
    public fn constant() -> OnceLock<T> => OnceLock { state: AtomicU8.constant(0), raw: RawCell<T?>.constant(null) };

    /// The value, or null while the cell is empty.
    public fn get(borrow this) -> borrow T? {
        if (this.state.load() != 2) {
            return null;
        }
        return this.contents().asBorrow();
    }

    /// The value; an empty cell runs `init` and stores its result first. Threads that arrive while another runs
    /// `init` wait for it and read its value. Panics if `init` asks this cell for its value ("cell initialised
    /// recursively").
    /// Safety: the write happens under the lock with the state 0 seen there, so no reference to the contents has
    /// been lent and no other thread writes; the old contents are null and need no drop. The lock is released on
    /// every path.
    public fn getOrInit(borrow this, init: borrow mut fn() -> T) -> borrow(this) T {
        if (this.state.load() != 2) {
            unsafe { ceesafe_mutex_once_lock(); }
            let state = this.state.load();
            if (state == 1) {
                unsafe { ceesafe_mutex_once_unlock(); }
                panic("cell initialised recursively");
            }
            if (state == 0) {
                // The process's once-lock is held, and the cell is half made: a trap in `init` in an isolated
                // task ends the process, as it always did (ADR 0175 §2.6).
                let critical = Critical.enter();
                this.state.store(1);
                let value = init();
                unsafe { this.raw.pointer().write(value); }
                this.state.store(2);
            }
            unsafe { ceesafe_mutex_once_unlock(); }
        }
        return this.contents().asBorrow()!;
    }

    /// Fills an empty cell from an initialiser that can fail: on `Err` the cell stays empty and the error is
    /// returned. A full cell is left as it is, and `init` does not run. `get` or `getOrInit` then lends the value.
    /// Panics as getOrInit.
    /// Safety: as getOrInit.
    public fn tryInit<E>(borrow this, init: borrow mut fn() -> Result<T, E>) -> Result<void, E> {
        if (this.state.load() == 2) {
            return Ok();
        }
        unsafe { ceesafe_mutex_once_lock(); }
        let state = this.state.load();
        if (state == 1) {
            unsafe { ceesafe_mutex_once_unlock(); }
            panic("cell initialised recursively");
        }
        if (state == 0) {
            let critical = Critical.enter(); // as getOrInit
            this.state.store(1);
            match (init()) {
                Ok(value) => {
                    unsafe { this.raw.pointer().write(value); }
                    this.state.store(2);
                }
                Err(error) => {
                    this.state.store(0);
                    unsafe { ceesafe_mutex_once_unlock(); }
                    return Err(error);
                }
            }
        }
        unsafe { ceesafe_mutex_once_unlock(); }
        return Ok();
    }

    /// Stores `value` in an empty cell. A cell that is full, or whose initialiser is running, gives the value back.
    /// Safety: as getOrInit.
    public fn set(borrow this, value: T) -> Result<void, T> {
        unsafe { ceesafe_mutex_once_lock(); }
        if (this.state.load() != 0) {
            unsafe { ceesafe_mutex_once_unlock(); }
            return Err(value);
        }
        unsafe { this.raw.pointer().write(value); }
        this.state.store(2);
        unsafe { ceesafe_mutex_once_unlock(); }
        return Ok();
    }

    /// The value, for as long as the cell is borrowed exclusively; null while the cell is empty.
    public fn getMut(borrow mut this) -> (borrow mut T)? => this.raw.getMut().asBorrowMut();

    /// The value, leaving the cell empty: no reference to it can be live while the cell is borrowed exclusively.
    /// Safety: the contents are read out and null written in their place, so they have one owner.
    public fn take(borrow mut this) -> T? {
        let p = this.raw.pointer();
        let old = unsafe { p.read() };
        unsafe { p.write(null); }
        this.state.store(0);
        return old;
    }

    /// The value, the cell consumed.
    public fn intoInner(this) -> T? => this.raw.intoInner();

    /// The contents as a shared reference.
    /// Safety: nothing writes the contents of a full cell while it is shared, and an empty cell's are null until the
    /// write that fills it, which happens before any reference from here is used again.
    fn contents(borrow this) -> borrow (T?) => unsafe { Ptr.toBorrow(this.raw.pointer() as *(T?)) };
}
