// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Native windows (type-system.md §26.13, ADR 0069): one window that shows premultiplied RGBA8 frames and reports the
// pointer, keys, typed text, the wheel, resizes and close requests. Hosted only, over
// runtime/hosted/ceesafe_rt_window.c: AppKit on macOS, Win32 on Windows, X11 on Linux, or an in-memory window that a
// script drives when CEESAFE_WINDOW_SCRIPT is set. A window the program draws itself, through the system's handles,
// is `WindowSurface.External` (ADR 0137). Text input through the system's input method, and the clipboard's text,
// are ADR 0141. Waiting for events without a tick, and waking a window from another thread, are ADR 0142; waiting for
// any of the program's windows is ADR 0145. Menus and the system's file dialogs are ADR 0146. Files dropped on a window
// are ADR 0150.

extern "C" {
    @effects(sleep, alloc)
    fn ceesafe_window_open(
        title: *u8,
        length: u64,
        width: u32,
        height: u32,
        surface: u32,
        error: *mut i32,
    ) -> *mut void;
    @effects()
    fn ceesafe_window_close(window: *mut void);
    @effects()
    fn ceesafe_window_native(window: *mut void, first: *mut u64, second: *mut u64) -> i32;
    @effects()
    fn ceesafe_window_poll(window: *mut void, fields: *mut i32, position: *mut f32) -> i32;
    @effects(sleep)
    fn ceesafe_window_present(window: *mut void, pixels: *u32, width: u32, height: u32) -> i32;
    @effects(sleep)
    fn ceesafe_window_present_changed(
        window: *mut void,
        pixels: *u32,
        width: u32,
        height: u32,
        boxes: *u32,
        count: u64,
    ) -> i32;
    @effects()
    fn ceesafe_window_size(window: *mut void, width: *mut u32, height: *mut u32);
    @effects()
    fn ceesafe_window_scale(window: *mut void, scale: *mut f32);
    @effects()
    fn ceesafe_window_set_cursor(window: *mut void, cursor: i32);
    @effects(sleep)
    fn ceesafe_window_set_title(window: *mut void, title: *u8, length: u64);
    @effects(sleep)
    fn ceesafe_window_wait(window: *mut void);
    @effects(sleep, alloc)
    fn ceesafe_window_set_text_input(window: *mut void, on: i32);
    @effects()
    fn ceesafe_window_set_text_area(window: *mut void, x: u32, y: u32, width: u32, height: u32);
    @effects()
    fn ceesafe_window_composition(window: *mut void, text: *mut (*u8), caret: *mut u64) -> u64;
    @effects(sleep, alloc)
    fn ceesafe_window_set_clipboard(window: *mut void, text: *u8, length: u64) -> i32;
    @effects(sleep, alloc)
    fn ceesafe_window_clipboard(window: *mut void, text: *mut (*u8)) -> i64;
    @effects(sleep)
    fn ceesafe_window_wait_event(window: *mut void, timeout: u32);
    @effects(sleep)
    fn ceesafe_window_wait_any(timeout: u32);
    @effects()
    fn ceesafe_window_waker(window: *mut void) -> u64;
    @effects()
    fn ceesafe_window_wake(id: u64);
    @effects(sleep, alloc)
    fn ceesafe_window_set_menu(window: *mut void, entries: *u8, length: u64) -> i32;
    @effects()
    fn ceesafe_window_menu_choice(window: *mut void) -> i64;
    @effects(sleep, alloc)
    fn ceesafe_window_dialog(
        window: *mut void,
        kind: i32,
        title: *u8,
        titleLength: u64,
        name: *u8,
        nameLength: u64,
        extensions: *u8,
        extensionsLength: u64,
        answer: *mut (*u8),
    ) -> i64;
    @effects()
    fn ceesafe_window_drop(window: *mut void, position: *mut f32, paths: *mut (*u8)) -> i64;
    @effects()
    fn ceesafe_window_drag_over(window: *mut void, position: *mut f32) -> u32;
}

/// Why a window could not be opened or drawn (§26.13).
public enum WindowError {
    /// No backend for this system, the interpreter, a size of 0 or over 16384, a `present` to a window opened with
    /// `WindowSurface.External`, a menu on X11 or one with an item before its first `addMenu` or over 4096 entries,
    /// a file dialog on a Linux system without `zenity` or `kdialog`, or a dialog's path that is not UTF-8.
    Unsupported,
    /// No window server: no `DISPLAY`, no X11 library, or a session without one.
    NoDisplay,
    /// Called on a thread other than the program's first.
    NotMainThread,
    /// The system refused, or the pixels do not cover the image.
    Resources,
}

/// Who draws a window's content (§26.13, ADR 0137).
public enum WindowSurface {
    /// The window shows the frames given to `present` and `presentChanged`.
    Frames,
    /// The program draws the content itself, with the system's GPU API on `nativeHandle()`; the runtime never paints
    /// it, and `present` and `presentChanged` are `WindowError.Unsupported`.
    External,
}

/// The system's own handles for a window (§26.13, ADR 0137), for `extern "C"` code that draws on it. They are
/// addresses as integers, which safe code cannot use; they are valid until the `Window` is dropped.
public enum WindowHandle {
    /// macOS: the `NSWindow` and its content `NSView`, which is layer-backed.
    AppKit(u64, u64),
    /// Windows: the `HWND` and the `HINSTANCE` that registered its class.
    Win32(u64, u64),
    /// Linux: the X11 `Display *` and the `Window` XID.
    Xlib(u64, u64),
    /// iOS (ADR 0154): the `UIWindow` and its view, whose layer is the content.
    UIKit(u64, u64),
    /// A scripted window (`CEESAFE_WINDOW_SCRIPT`), which has no system window.
    Scripted,
}

/// A window's content size in points.
public struct WindowSize {
    public width: u32;
    public height: u32;
}

/// A part of an image that changed (`Window.presentChanged`), in the image's pixels; or the text input area
/// (`Window.setTextInputArea`), in points from the content's top left.
public struct WindowBox {
    public x: u32;
    public y: u32;
    public width: u32;
    public height: u32;
}

/// A pointer button.
public enum WindowButton {
    Primary,
    Secondary,
    Middle,
}

/// The modifier keys held during a key event. `command` is ⌘ on macOS and the Windows key elsewhere.
public struct WindowModifiers {
    public shift: bool;
    public control: bool;
    public alt: bool;
    public command: bool;
}

/// A key (§26.13): the named keys a UI needs, letters and digits as `Character`, F1 to F12 as `Function`.
public enum WindowKey {
    Tab,
    Enter,
    Escape,
    Backspace,
    Delete,
    Left,
    Right,
    Up,
    Down,
    Home,
    End,
    PageUp,
    PageDown,
    Space,
    /// A letter (lowercase), a digit, or a punctuation key's unshifted character, on the layout in use.
    Character(u32),
    /// F1 to F12.
    Function(u8),
    /// The system's code for any other key.
    Other(u32),
}

/// The pointer's shape over the content.
public enum WindowCursor {
    Default,
    Pointer,
    Text,
    Crosshair,
    Grab,
    ResizeHorizontal,
    ResizeVertical,
}

/// What happened to a window (§26.13). Positions are points from the content's top left.
public enum WindowEvent {
    /// The user asked to close the window; it stays open until the `Window` is dropped.
    Closed,
    /// The content's size in points; also when only the scale changed, so the size in pixels did (ADR 0137).
    Resized(WindowSize),
    Focus(bool),
    /// x, y.
    PointerMoved(f32, f32),
    /// The button, whether it went down, x, y.
    PointerButton(WindowButton, bool, f32, f32),
    /// dx, dy in lines; positive dy scrolls up.
    Wheel(f32, f32),
    /// The key, whether it went down, whether it is the system's repeat, the modifiers.
    Key(WindowKey, bool, bool, WindowModifiers),
    /// A Unicode scalar the user typed, or that the input method committed.
    Text(u32),
    /// The input method's composition (`Window.composition`) or its caret changed, or the composition ended
    /// (ADR 0141).
    Composition,
}

/// Files dropped on a window (§26.13, ADR 0150): where, in points from the content's top left as pointer events are,
/// and the files' paths, absolute and UTF-8, at least one.
public struct WindowDrop {
    public x: f32;
    public y: f32;
    public paths: Vector<String>;
}

/// A drag of files over a window (§26.13, ADR 0150): where the pointer is, in points from the content's top left, and
/// how many files the drag holds.
public struct WindowDragOver {
    public x: f32;
    public y: f32;
    public count: u32;
}

/// Wakes a window from any thread or async task (§26.13, ADR 0142): `Window.waker()`. It is a plain value, Copy and
/// `Send`: the window's id in the runtime's list of open windows, never reused for another window.
public struct WindowWaker {
    id: u64;

    /// Makes the window's current `waitEvent`, `waitFrame` or `Window.waitAny` return promptly, or the next one at once.
    /// Wakes before the window waits again count as one. After the window was dropped, it does nothing. It has no
    /// effects, so a task or any thread may call it.
    /// Safety: the runtime looks the id up among the open windows, under its lock, and touches only a window it
    /// finds there.
    public fn wake(borrow this) {
        unsafe { ceesafe_window_wake(this.id); }
    }
}

/// A native window (§26.13): a move type that closes the window when dropped. It is used on the program's first
/// thread only.
public struct Window {
    raw: *mut void;

    /// Opens a resizable window of `width` × `height` points titled `title`, which shows the frames given to
    /// `present`: `openWith(title, width, height, WindowSurface.Frames)`.
    public fn open(title: StringView, width: u32, height: u32) -> Result<Window, WindowError> {
        return Window.openWith(title, width, height, WindowSurface.Frames);
    }

    /// Opens a resizable window of `width` × `height` points titled `title`, whose content `surface` says who draws
    /// (ADR 0137).
    /// Safety: the runtime reads the title's bytes during the call only, and the handle it returns is this window's
    /// until the drop closes it.
    public fn openWith(
        title: StringView,
        width: u32,
        height: u32,
        surface: WindowSurface,
    ) -> Result<Window, WindowError> {
        let code: u32 = match (surface) {
            WindowSurface.Frames => 0,
            WindowSurface.External => 1,
        };
        var error: i32 = 0;
        let raw = unsafe { ceesafe_window_open(
            title.ptr,
            title.length as u64,
            width,
            height,
            code,
            borrow mut error as *mut i32,
        ) };
        if (raw.isNull()) {
            return Err(Window.errorOf(error));
        }
        return Ok(Window { raw: raw });
    }

    /// The system's handles for this window (ADR 0137), valid until it is dropped. A program may draw through them
    /// and add layers or child surfaces, but must not close, release or re-parent the window, or replace its delegate
    /// or window procedure.
    /// Safety: the runtime writes the two handles, as integers.
    public fn nativeHandle(borrow this) -> WindowHandle {
        var first: u64 = 0;
        var second: u64 = 0;
        let kind = unsafe { ceesafe_window_native(
            this.raw,
            borrow mut first as *mut u64,
            borrow mut second as *mut u64,
        ) };
        return match (kind) {
            1 => WindowHandle.AppKit(first, second),
            2 => WindowHandle.Win32(first, second),
            3 => WindowHandle.Xlib(first, second),
            4 => WindowHandle.UIKit(first, second),
            _ => WindowHandle.Scripted,
        };
    }

    /// The next pending event, or null; it never blocks.
    /// Safety: the runtime writes four fields and two coordinates, the sizes of the arrays it is given.
    public fn nextEvent(borrow mut this) -> WindowEvent? {
        var fields = [0i32; 4];
        var position = [0.0f32; 2];
        let kind = unsafe { ceesafe_window_poll(
            this.raw,
            borrow mut fields[0] as *mut i32,
            borrow mut position[0] as *mut f32,
        ) };
        let x = position[0];
        let y = position[1];
        return match (kind) {
            1 => WindowEvent.Closed,
            2 => WindowEvent.Resized(WindowSize { width: truncate<u32>(fields[0]), height: truncate<u32>(fields[1]) }),
            3 => WindowEvent.Focus(fields[0] != 0),
            4 => WindowEvent.PointerMoved(x, y),
            5 => WindowEvent.PointerButton(Window.buttonOf(fields[0]), fields[1] != 0, x, y),
            6 => WindowEvent.Wheel(x, y),
            7 => WindowEvent.Key(
                Window.keyOf(fields[0]),
                fields[1] != 0,
                fields[2] != 0,
                Window.modifiersOf(fields[3]),
            ),
            8 => WindowEvent.Text(truncate<u32>(fields[0])),
            9 => WindowEvent.Composition,
            _ => null,
        };
    }

    /// Shows a `width` × `height` image of premultiplied RGBA8 pixels (bytes R, G, B, A), rows top to bottom, scaled
    /// to the content.
    /// Safety: the runtime reads `width × height` pixels, which `pixels` is checked to hold, during the call only.
    public fn present(borrow mut this, pixels: Slice<u32>, width: u32, height: u32) -> Result<void, WindowError> {
        if (width == 0 || height == 0 || (pixels.length as u64) < (width as u64) * (height as u64)) {
            return Err(WindowError.Resources);
        }
        let result = unsafe { ceesafe_window_present(this.raw, pixels.ptr, width, height) };
        return if (result < 0) Err(Window.errorOf(0 - result)) else Ok();
    }

    /// Like `present`, but only the pixels inside `changed` differ from the last frame presented (§26.13, ADR 0070):
    /// the window shows just those, which saves copying the rest. Without a last frame of this size, with a box
    /// outside the image, or with more than 64 boxes, it is `present`. An empty `changed` shows nothing new.
    /// Safety: the runtime reads `width × height` pixels, which `pixels` is checked to hold, and the boxes, during
    /// the call only.
    public fn presentChanged(
        borrow mut this,
        pixels: Slice<u32>,
        width: u32,
        height: u32,
        changed: Slice<WindowBox>,
    ) -> Result<void, WindowError> {
        if (width == 0 || height == 0 || (pixels.length as u64) < (width as u64) * (height as u64)) {
            return Err(WindowError.Resources);
        }
        if (changed.length > 64) {
            return this.present(pixels, width, height);
        }
        var flat = [0u32; 256];
        for (k in 0..changed.length) {
            flat[4 * k] = changed[k].x;
            flat[4 * k + 1] = changed[k].y;
            flat[4 * k + 2] = changed[k].width;
            flat[4 * k + 3] = changed[k].height;
        }
        let result = unsafe { ceesafe_window_present_changed(
            this.raw,
            pixels.ptr,
            width,
            height,
            borrow flat[0] as *u32,
            changed.length as u64,
        ) };
        return if (result < 0) Err(Window.errorOf(0 - result)) else Ok();
    }

    /// The content's size in points.
    /// Safety: the runtime writes the two sizes.
    public fn size(borrow this) -> WindowSize {
        var width: u32 = 0;
        var height: u32 = 0;
        unsafe { ceesafe_window_size(this.raw, borrow mut width as *mut u32, borrow mut height as *mut u32); }
        return WindowSize { width: width, height: height };
    }

    /// Pixels per point: 2.0 on a Retina display.
    /// Safety: the runtime writes the scale.
    public fn scale(borrow this) -> f32 {
        var scale: f32 = 1.0;
        unsafe { ceesafe_window_scale(this.raw, borrow mut scale as *mut f32); }
        return scale;
    }

    /// The pointer's shape while it is over the content.
    /// Safety: the runtime only reads the cursor's number.
    public fn setCursor(borrow mut this, cursor: WindowCursor) {
        let code: i32 = match (cursor) {
            WindowCursor.Default => 0,
            WindowCursor.Pointer => 1,
            WindowCursor.Text => 2,
            WindowCursor.Crosshair => 3,
            WindowCursor.Grab => 4,
            WindowCursor.ResizeHorizontal => 5,
            WindowCursor.ResizeVertical => 6,
        };
        unsafe { ceesafe_window_set_cursor(this.raw, code); }
    }

    /// Sets the title.
    /// Safety: the runtime reads the title's bytes during the call only.
    public fn setTitle(borrow mut this, title: StringView) {
        unsafe { ceesafe_window_set_title(this.raw, title.ptr, title.length as u64); }
    }

    /// Returns about 1/60 s after the previous call, or earlier when an event arrives or the window is woken
    /// (`WindowWaker`, ADR 0142).
    /// Safety: the runtime only waits on the window it was given.
    public fn waitFrame(borrow mut this) {
        unsafe { ceesafe_window_wait(this.raw); }
    }

    /// Sleeps until an event is queued (`nextEvent` would return one), the window is woken (`WindowWaker.wake`) since
    /// the last `waitEvent` or `waitFrame` returned, or `timeoutMs` milliseconds pass; 0 returns at once. Unlike
    /// `waitFrame` it does not tick, so an idle window uses no CPU. While it sleeps the window takes the system's
    /// events, so it repaints and answers the clipboard (ADR 0142).
    /// Safety: the runtime only waits on the window it was given.
    public fn waitEvent(borrow mut this, timeoutMs: u32) {
        unsafe { ceesafe_window_wait_event(this.raw, timeoutMs); }
    }

    /// Sleeps until any window the program has open has an event queued, any of them was woken since a wait on it
    /// last returned, or `timeoutMs` milliseconds pass; 0 returns at once. It takes every window's wake, and does not
    /// say which window is ready: drain each window's `nextEvent` after it returns. Like `waitEvent` it does not tick,
    /// and every window takes the system's events while it sleeps. With no window open, or on any thread but the
    /// program's first (which alone can have one), it sleeps for `timeoutMs` (ADR 0145).
    /// Safety: the runtime waits on the windows of its own list of open windows, on the program's first thread only.
    public fn waitAny(timeoutMs: u32) {
        unsafe { ceesafe_window_wait_any(timeoutMs); }
    }

    /// A handle that wakes this window from any thread or task (ADR 0142). It is Copy and `Send`, where `Window` is
    /// neither, and does nothing once the window is dropped.
    /// Safety: the runtime only reads the window's waker id.
    public fn waker(borrow this) -> WindowWaker {
        return WindowWaker { id: unsafe { ceesafe_window_waker(this.raw) } };
    }

    /// Turns the system's input method on for this window, when a text field has focus, or off (ADR 0141). While it is
    /// on, the input method may take keys: it composes text (`Composition` events, `composition()`) and commits it as
    /// `Text` events, and a key it takes gives no `Key` event. Turning it off ends a composition. Until the first call,
    /// the window takes text as it always did.
    /// Safety: the runtime only reads the flag.
    public fn setTextInput(borrow mut this, on: bool) {
        unsafe { ceesafe_window_set_text_input(this.raw, if (on) 1 else 0); }
    }

    /// Where the text being composed, or the caret, is: a box in points from the content's top left. The input method
    /// shows its candidates beside it (ADR 0141).
    /// Safety: the runtime only reads the four numbers.
    public fn setTextInputArea(borrow mut this, area: WindowBox) {
        unsafe { ceesafe_window_set_text_area(this.raw, area.x, area.y, area.width, area.height); }
    }

    /// The text the input method is composing, as of the last `Composition` event; empty when there is none
    /// (ADR 0141). The window owns it, and it changes only when `nextEvent` returns `Composition`.
    /// Safety: the runtime gives its copy of the composition, valid UTF-8 of the length it returns, which it replaces
    /// only in `nextEvent`, a `borrow mut` call that the returned view's loan of `this` rules out while the view lives.
    public fn composition(borrow this) -> StringView {
        var text = 0 as *u8;
        var caret: u64 = 0;
        let length = unsafe { ceesafe_window_composition(
            this.raw,
            borrow mut text as *mut (*u8),
            borrow mut caret as *mut u64,
        ) };
        if (length == 0) {
            return "";
        }
        let bytes = unsafe { Slice.fromRaw(text, truncate<usize>(length)) };
        return StringView.fromUtf8(bytes) ?? "";
    }

    /// The caret's byte offset in `composition()`, at a character's start (ADR 0141).
    /// Safety: the runtime writes the caret, and the text's address, which is not used.
    public fn compositionCaret(borrow this) -> usize {
        var text = 0 as *u8;
        var caret: u64 = 0;
        unsafe { ceesafe_window_composition(this.raw, borrow mut text as *mut (*u8), borrow mut caret as *mut u64); }
        return truncate<usize>(caret);
    }

    /// Puts `text` on the system's clipboard, replacing what it held (ADR 0141).
    /// Safety: the runtime copies the text's bytes during the call.
    public fn setClipboardText(borrow mut this, text: StringView) -> Result<void, WindowError> {
        let result = unsafe { ceesafe_window_set_clipboard(this.raw, text.ptr, text.length as u64) };
        return if (result < 0) Err(Window.errorOf(0 - result)) else Ok();
    }

    /// Shows `menu` as this window's menus (ADR 0146), replacing the ones it showed; an empty `Menu` removes them. The
    /// window keeps a copy: a later change to `menu` shows only when it is set again. macOS has one menu bar: it shows
    /// the application's menu (About, Hide, Hide Others, Show All, Quit) and then the menus of the window that set
    /// them last, until that window is dropped. Windows: the window's own menu bar. X11 has none: `Unsupported`.
    /// Safety: the runtime copies the entries' bytes, lib/std's encoding of the menu, during the call.
    public fn setMenu(borrow mut this, menu: borrow Menu) -> Result<void, WindowError> {
        let bytes = menu.entries.view();
        let result = unsafe { ceesafe_window_set_menu(this.raw, bytes.ptr, bytes.length as u64) };
        return if (result < 0) Err(Window.errorOf(0 - result)) else Ok();
    }

    /// The id of the next menu item the user chose in this window's menus, or null; it never blocks (ADR 0146). A
    /// queued choice ends `waitEvent`, `waitFrame` and `Window.waitAny`, as an event does.
    /// Safety: the runtime only returns a number: an id, or -1 for none.
    public fn nextMenuChoice(borrow mut this) -> u32? {
        let choice = unsafe { ceesafe_window_menu_choice(this.raw) };
        if (choice < 0) {
            return null;
        }
        return truncate<u32>(choice);
    }

    /// The next drop of files on this window, or null; it never blocks (ADR 0150). Drops are queued beside the events,
    /// in order, and a queued drop ends `waitEvent`, `waitFrame` and `Window.waitAny`, as an event does. A path that is
    /// not valid UTF-8, or that memory ran out for, is left out, and a drop with no path left is skipped. Only files
    /// are dropped: the window refuses a drag of text or other data, so the system shows no drop for it.
    /// Safety: the runtime writes the drop's position, and gives its copy of the paths, each followed by a zero byte,
    /// which it keeps until the next call; they are copied before this returns.
    public fn nextDrop(borrow mut this) -> WindowDrop? {
        loop {
            var position = [0.0f32; 2];
            var text = 0 as *u8;
            let length = unsafe { ceesafe_window_drop(
                this.raw,
                borrow mut position[0] as *mut f32,
                borrow mut text as *mut (*u8),
            ) };
            if (length < 0) {
                return null;
            }
            var paths = Vector<String>.create();
            if (length > 0) {
                let bytes = unsafe { Slice.fromRaw(text, truncate<usize>(length)) };
                var start: usize = 0;
                for (k in 0..bytes.length) {
                    if (bytes[k] == 0) {
                        match (StringView.fromUtf8(bytes[start..k])) {
                            Some(path) => {
                                match (String.from(path)) {
                                    Ok(copy) => { let _ = paths.push(copy); }
                                    Err(_) => {}
                                }
                            }
                            null => {}
                        }
                        start = k + 1;
                    }
                }
            }
            if (paths.length > 0) {
                return WindowDrop { x: position[0], y: position[1], paths: paths };
            }
        }
    }

    /// While a drag of files is over this window, where it is and how many files it holds; else null (ADR 0150). It
    /// is the window's state as of the last event the window took from the system: a change (the drag entering,
    /// moving or leaving) ends `waitEvent`, `waitFrame` and `Window.waitAny` as a wake does, so a program redraws its
    /// drop highlight after each wait. A drop ends the drag: the window then has none.
    /// Safety: the runtime only writes the position and returns the count, 0 for no drag.
    public fn dragOver(borrow this) -> WindowDragOver? {
        var position = [0.0f32; 2];
        let count = unsafe { ceesafe_window_drag_over(this.raw, borrow mut position[0] as *mut f32) };
        if (count == 0) {
            return null;
        }
        return WindowDragOver { x: position[0], y: position[1], count: count };
    }

    /// Appends the clipboard's text to `out`; false when the clipboard holds no text, its text is not valid UTF-8, or
    /// memory ran out (ADR 0141).
    /// Safety: the runtime gives its copy of the clipboard's text and its length, which it keeps until the next call;
    /// it is copied into `out` before this returns.
    public fn clipboardText(borrow mut this, out: borrow mut String) -> bool {
        var text = 0 as *u8;
        let length = unsafe { ceesafe_window_clipboard(this.raw, borrow mut text as *mut (*u8)) };
        if (length < 0) {
            return false;
        }
        if (length == 0) {
            return true;
        }
        let bytes = unsafe { Slice.fromRaw(text, truncate<usize>(length)) };
        return match (out.appendUtf8(bytes)) {
            Ok(valid) => valid,
            Err(_) => false,
        };
    }

    fn errorOf(code: i32) -> WindowError => match (code) {
        1 => WindowError.Unsupported,
        2 => WindowError.NoDisplay,
        3 => WindowError.NotMainThread,
        _ => WindowError.Resources,
    };

    fn buttonOf(code: i32) -> WindowButton => match (code) {
        1 => WindowButton.Secondary,
        2 => WindowButton.Middle,
        _ => WindowButton.Primary,
    };

    /// The runtime's key numbers (ceesafe_rt_window.c): 1-14 the named keys, 100 + n F(n), 0x10000 + c a character,
    /// 0x20000 + code any other key.
    fn keyOf(code: i32) -> WindowKey {
        if (code >= 0x20000) {
            return WindowKey.Other(truncate<u32>(code - 0x20000));
        }
        if (code >= 0x10000) {
            return WindowKey.Character(truncate<u32>(code - 0x10000));
        }
        if (code > 100 && code <= 112) {
            return WindowKey.Function(truncate<u8>(code - 100));
        }
        return match (code) {
            1 => WindowKey.Tab,
            2 => WindowKey.Enter,
            3 => WindowKey.Escape,
            4 => WindowKey.Backspace,
            5 => WindowKey.Delete,
            6 => WindowKey.Left,
            7 => WindowKey.Right,
            8 => WindowKey.Up,
            9 => WindowKey.Down,
            10 => WindowKey.Home,
            11 => WindowKey.End,
            12 => WindowKey.PageUp,
            13 => WindowKey.PageDown,
            14 => WindowKey.Space,
            _ => WindowKey.Other(truncate<u32>(code)),
        };
    }

    fn modifiersOf(code: i32) -> WindowModifiers {
        let bits = truncate<u32>(code);
        return WindowModifiers {
            shift: (bits & 1) != 0,
            control: (bits & 2) != 0,
            alt: (bits & 4) != 0,
            command: (bits & 8) != 0,
        };
    }

    /// Closes the window.
    /// Safety: the handle is this window's, and nothing uses it after the drop.
    drop {
        unsafe { ceesafe_window_close(this.raw); }
    }
}

/// A keyboard shortcut that a menu item shows (§26.13, ADR 0146). On macOS a shortcut of an enabled item chooses it,
/// and its key gives no `Key` event; on Windows it is the text after the item's title, and the key stays a `Key`.
/// `Other` keys, `Function` outside 1 to 12, and a `Character` that is not a printable scalar show none.
public struct MenuShortcut {
    public key: WindowKey;
    public modifiers: WindowModifiers;
}

/// A program's menus (§26.13, ADR 0146): top-level menus in order, each a list of items and separators, which
/// `Window.setMenu` shows. An item has an id the program chooses, which `Window.nextMenuChoice` gives back when the
/// user chooses it, a title, an optional shortcut, and whether it is enabled and checked. The titles are copied, so a
/// `Menu` owns everything it holds. There are no submenus.
public struct Menu {
    /// lib/std's encoding, which ceesafe_rt_window.c reads: per entry 16 bytes, the kind (1 a menu, 2 an item, 3 a
    /// separator), the flags (1 enabled, 2 checked), the shortcut's modifier bits, 0, then the id, the shortcut's key
    /// number (0 for none) and the title's length, each a little-endian u32, then the title's UTF-8 bytes.
    entries: Vector<u8>;

    /// An empty menu: `setMenu` with it removes a window's menus.
    public fn create() -> Menu {
        return Menu { entries: Vector<u8>.create() };
    }

    /// Starts a top-level menu titled `title`: the items added next are its own.
    public fn addMenu(borrow mut this, title: StringView) -> Result<void, AllocError> {
        return this.add(1, 1, 0, 0, title);
    }

    /// Adds an enabled, unchecked item to the last menu added; `setMenu` is `Unsupported` for an item before the
    /// first `addMenu`.
    public fn addItem(
        borrow mut this,
        id: u32,
        title: StringView,
        shortcut: MenuShortcut?,
    ) -> Result<void, AllocError> {
        var modifiers: u8 = 0;
        var key: u32 = 0;
        match (shortcut) {
            Some(s) => {
                key = Menu.keyNumber(s.key);
                modifiers = (if (s.modifiers.shift) 1u8 else 0u8) | (if (s.modifiers.control) 2u8 else 0u8) |
                    (if (s.modifiers.alt) 4u8 else 0u8) | (if (s.modifiers.command) 8u8 else 0u8);
            }
            null => {}
        }
        return this.addEntry(2, 1, modifiers, id, key, title);
    }

    /// Adds a separator line to the last menu added.
    public fn addSeparator(borrow mut this) -> Result<void, AllocError> {
        return this.add(3, 0, 0, 0, "");
    }

    /// Enables or disables every item with the id `id`. A disabled item is shown dimmed and cannot be chosen.
    public fn setEnabled(borrow mut this, id: u32, enabled: bool) {
        this.setFlag(id, 1, enabled);
    }

    /// Shows or hides a check mark beside every item with the id `id`.
    public fn setChecked(borrow mut this, id: u32, checked: bool) {
        this.setFlag(id, 2, checked);
    }

    fn add(
        borrow mut this,
        kind: u8,
        flags: u8,
        modifiers: u8,
        id: u32,
        title: StringView,
    ) -> Result<void, AllocError> {
        return this.addEntry(kind, flags, modifiers, id, 0, title);
    }

    /// One entry, or none when memory ran out: a failed push takes back what the entry had written.
    fn addEntry(
        borrow mut this,
        kind: u8,
        flags: u8,
        modifiers: u8,
        id: u32,
        key: u32,
        title: StringView,
    ) -> Result<void, AllocError> {
        let start = this.entries.length;
        match (this.writeEntry(kind, flags, modifiers, id, key, title)) {
            Ok() => { return Ok(); }
            Err(e) => {
                this.entries.truncate(start);
                return Err(e);
            }
        }
    }

    fn writeEntry(
        borrow mut this,
        kind: u8,
        flags: u8,
        modifiers: u8,
        id: u32,
        key: u32,
        title: StringView,
    ) -> Result<void, AllocError> {
        this.entries.reserve(16 + title.length)?;
        this.entries.push(kind)?;
        this.entries.push(flags)?;
        this.entries.push(modifiers)?;
        this.entries.push(0)?;
        this.entries.pushLE(id)?;
        this.entries.pushLE(key)?;
        this.entries.pushLE(truncate<u32>(title.length))?;
        this.entries.extend(title.bytes())?;
        return Ok();
    }

    fn setFlag(borrow mut this, id: u32, bit: u8, on: bool) {
        var at: usize = 0;
        while (at + 16 <= this.entries.length) {
            let length = this.entries.view().readLE<u32>(at + 12) as usize;
            if (this.entries[at] == 2 && this.entries.view().readLE<u32>(at + 4) == id) {
                let flags = this.entries[at + 1];
                this.entries[at + 1] = if (on) flags | bit else flags & (bit ^ 0xFF);
            }
            at = at + 16 + length;
        }
    }

    /// The runtime's key numbers (Window.keyOf's): 1-14 the named keys, 100 + n F(n), 0x10000 + c a character; 0 for
    /// a key no menu can show.
    fn keyNumber(key: WindowKey) -> u32 => match (key) {
        WindowKey.Tab => 1,
        WindowKey.Enter => 2,
        WindowKey.Escape => 3,
        WindowKey.Backspace => 4,
        WindowKey.Delete => 5,
        WindowKey.Left => 6,
        WindowKey.Right => 7,
        WindowKey.Up => 8,
        WindowKey.Down => 9,
        WindowKey.Home => 10,
        WindowKey.End => 11,
        WindowKey.PageUp => 12,
        WindowKey.PageDown => 13,
        WindowKey.Space => 14,
        WindowKey.Character(c) => if (c > 0x20 && c <= 0x10FFFF && (c < 0xD800 || c > 0xDFFF)) 0x10000 + c else 0,
        WindowKey.Function(n) => if (n >= 1 && n <= 12) 100 + (n as u32) else 0,
        WindowKey.Other(_) => 0,
    };
}

/// The system's file dialogs (§26.13, ADR 0146): modal, they return when the user answers. Paths are UTF-8 and
/// absolute. `extensions` is a comma-separated list of file name extensions without the dot, such as "png,jpg", which
/// the dialog offers alone; empty offers every file. The program's windows are not repainted by the program while a
/// dialog runs (the system shows their last frames). macOS: NSOpenPanel and NSSavePanel. Windows: IFileOpenDialog and
/// IFileSaveDialog, owned by `window`. Linux: `zenity`, or `kdialog`, found on `PATH`, else `Unsupported`.
public struct FileDialog {
    /// One existing file the user chose, or null when they cancelled.
    public fn openFile(
        window: borrow mut Window,
        title: StringView,
        extensions: StringView,
    ) -> Result<String?, WindowError> {
        var paths = Vector<String>.create();
        FileDialog.run(window, 0, title, "", extensions, mut paths)?;
        return Ok(paths.pop());
    }

    /// The existing files the user chose, one or more; empty when they cancelled.
    public fn openFiles(
        window: borrow mut Window,
        title: StringView,
        extensions: StringView,
    ) -> Result<Vector<String>, WindowError> {
        var paths = Vector<String>.create();
        FileDialog.run(window, 1, title, "", extensions, mut paths)?;
        return Ok(paths);
    }

    /// Where the user chose to save a file, the dialog's field starting as `suggestedName`, or null when they
    /// cancelled. The system asks before an existing file is chosen; the program writes the file.
    public fn saveFile(
        window: borrow mut Window,
        title: StringView,
        suggestedName: StringView,
        extensions: StringView,
    ) -> Result<String?, WindowError> {
        var paths = Vector<String>.create();
        FileDialog.run(window, 2, title, suggestedName, extensions, mut paths)?;
        return Ok(paths.pop());
    }

    /// One existing folder the user chose, or null when they cancelled.
    public fn chooseFolder(window: borrow mut Window, title: StringView) -> Result<String?, WindowError> {
        var paths = Vector<String>.create();
        FileDialog.run(window, 3, title, "", "", mut paths)?;
        return Ok(paths.pop());
    }

    /// Runs the dialog of `kind` (0 a file, 1 files, 2 save, 3 a folder) and appends its paths to `out`.
    /// Safety: the runtime reads the three texts during the call, and gives its copy of the answer, each path followed
    /// by a zero byte, which it keeps until the window's next dialog; the paths are copied before this returns.
    fn run(
        window: borrow mut Window,
        kind: i32,
        title: StringView,
        name: StringView,
        extensions: StringView,
        out: borrow mut Vector<String>,
    ) -> Result<void, WindowError> {
        var answer = 0 as *u8;
        let length = unsafe { ceesafe_window_dialog(
            window.raw,
            kind,
            title.ptr,
            title.length as u64,
            name.ptr,
            name.length as u64,
            extensions.ptr,
            extensions.length as u64,
            borrow mut answer as *mut (*u8),
        ) };
        if (length < 0) {
            return Err(Window.errorOf(truncate<i32>(0 - length)));
        }
        if (length == 0) {
            return Ok();
        }
        let bytes = unsafe { Slice.fromRaw(answer, truncate<usize>(length)) };
        var start: usize = 0;
        for (k in 0..bytes.length) {
            if (bytes[k] == 0) {
                let path = match (StringView.fromUtf8(bytes[start..k])) {
                    Some(p) => p,
                    null => { return Err(WindowError.Unsupported); }
                };
                let copy = match (String.from(path)) {
                    Ok(c) => c,
                    Err(_) => { return Err(WindowError.Resources); }
                };
                match (out.push(copy)) {
                    Ok() => {}
                    Err(_) => { return Err(WindowError.Resources); }
                }
                start = k + 1;
            }
        }
        return Ok();
    }
}
