// Async fns in C (c-backend.md §3a, ADR 0031 §3.6). An async fn F becomes a frame struct ceeAF_<F> holding its
// parameters, every local, one frame per await site and its result; ceeAI_<F>, which fills in the arguments; ceeAR_<F>,
// which runs F until it returns (true) or suspends (false); and ceeAT_<F>, the resume function as the runtime calls it.
// <F> is F's C function name. The resume function is always flat: inside it, each local's C name is defined as its
// frame field, so the statement emitter is shared with sync functions.

fn isAsyncNir(c: borrow Checker, n: borrow NirProgram, f: u32) -> bool => isAsyncFunction(c, nirFunctionSource(n, f));

/// `ceeAF_ceeF_name` and so on: an async item's name, from its function's C name.
fn appendAsyncName(
    c: borrow Checker,
    out: borrow mut Vector<u8>,
    prefix: StringView,
    function: u32,
) -> Result<void, AllocError> {
    appendText(out, prefix)?;
    return appendCFunctionName(c, out, function);
}

/// The suspension points of a statement: an awaited call, `Async.park()`, or the end of a scope.
fn isSuspension(n: borrow NirProgram, s: u32) -> bool {
    let r = statementRvalue(n, s);
    return r != none() &&
        (n.rvalueTasks[r as usize] == taskAwait() || builtinOf(n, r) == bfAsyncPark() ||
            builtinOf(n, r) == bfAsyncScopeWait() || builtinOf(n, r) == bfAsyncJoin() ||
            builtinOf(n, r) == bfAsyncBlocking() || builtinOf(n, r) == bfAsyncBoxed());
}

fn builtinArguments(n: borrow NirProgram, r: u32) -> Range => match (n.rvalues[r as usize]) {
    NirRvalue.Builtin(_, list) => list,
    _ => emptyRange(),
};

/// The constant argument `k` of a builtin (a site or a function), or none.
fn constArgument(n: borrow NirProgram, r: u32, k: u32) -> u32 {
    let list = builtinArguments(n, r);
    if (k >= list.count) {
        return none();
    }
    return match (n.operands[n.at(list, k) as usize]) {
        NirOperand.Const(v) => truncate<u32>(v.magnitude),
        _ => none(),
    };
}

/// The NIR function compiling HIR function `source`, or none.
fn asyncNirFunction(n: borrow NirProgram, source: u32) -> u32 {
    for (k in 0..n.functions.length) {
        if (n.functions[k].source == source && n.functions[k].variant == 0) {
            return truncate<u32>(k);
        }
    }
    return none();
}

/// The struct of scope `site`: the runtime's scope, then the first error, a Result<void, E> (c-backend.md §3a).
fn emitScopeStruct(e: borrow mut CEmitter, c: borrow Checker, site: u32, result: u32) -> Result<void, AllocError> {
    e.t("struct ceeAS_")?;
    e.d(site as u64)?;
    e.t(" { ceesafe_scope rt; ")?;
    appendCTypeName(c, mut e.buf, result)?;
    e.t(" error; };")?;
    return e.emit();
}

/// The child's thunk: runs it, and once it returns records an `Err` as its scope's first error (§40.5).
fn emitChildThunk(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    site: u32,
    child: u32,
) -> Result<void, AllocError> {
    let result = c.hir.functions[child as usize].returnType;
    e.t(if (e.split) "static CEE_UNUSED bool " else "static bool ")?; // split: in the header every unit includes
    appendAsyncName(c, mut e.buf, "ceeAC_", child)?;
    e.t("(void *frame, ceesafe_scope *scope) {")?;
    e.emit()?;
    e.t("    struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", child)?;
    e.t(" *f = (struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", child)?;
    e.t(" *)frame;")?;
    e.emit()?;
    e.t("    if (!")?;
    appendAsyncName(c, mut e.buf, "ceeAR_", child)?;
    e.t("(f)) return false;")?;
    e.emit()?;
    e.t("    struct ceeAS_")?;
    e.d(site as u64)?;
    e.t(" *s = (struct ceeAS_")?;
    e.d(site as u64)?;
    e.t(" *)(void *)scope;")?;
    e.emit()?;
    e.line("    if (f->cee_result.tag != 0) {")?;
    e.line("        if (!s->rt.failed) {")?;
    e.line("            s->rt.failed = true;")?;
    e.line("            s->error = f->cee_result;")?;
    if (c.types.needsDrop(result)) {
        e.line("        } else {")?;
        e.t("            ")?;
        appendDropGlueName(c, mut e.buf, result)?;
        e.t("(&f->cee_result); /* a later child's error, not the scope's */")?;
        e.emit()?;
    }
    e.line("        }")?;
    e.line("    }")?;
    e.line("    return true;")?;
    e.line("}")?;
    return Ok();
}

/// The awaited callee of statement `s`, or none.
fn awaitedCallee(n: borrow NirProgram, s: u32) -> u32 {
    let r = statementRvalue(n, s);
    if (r == none() || n.rvalueTasks[r as usize] != taskAwait()) {
        return none();
    }
    return match (n.rvalues[r as usize]) {
        NirRvalue.Call(callee, _) => callee,
        _ => none(),
    };
}

/// The join of `race` or `all` at `site`: the runtime's scope, which child returned first (2 for neither yet), both
/// results, and both children's tasks and frames (c-backend.md §3a).
fn emitJoinStruct(e: borrow mut CEmitter, c: borrow Checker, n: borrow NirProgram, r: u32) -> Result<void, AllocError> {
    let site = constArgument(n, r, 0);
    let first = constArgument(n, r, 2);
    let second = constArgument(n, r, 4);
    e.t("struct ceeAJ_")?;
    e.d(site as u64)?;
    e.t(" { ceesafe_scope rt; uint32_t first; ")?;
    for (k in 0..2u32) {
        appendCTypeName(c, mut e.buf, c.hir.functions[first as usize].returnType)?;
        e.t(" r")?;
        e.d(k as u64)?;
        e.t("; ")?;
    }
    e.t("ceesafe_task_slot t0, t1; struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", first)?;
    e.t(" f0; struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", second)?;
    e.t(" f1; };")?;
    return e.emit();
}

/// The join's two children run here: each result is kept, the first to return is noted, and the other child is
/// cancelled when the first returns (race) or when one returns an `Err` (all) (type-system.md §40.4).
fn emitJoinThunks(e: borrow mut CEmitter, c: borrow Checker, n: borrow NirProgram, r: u32) -> Result<void, AllocError> {
    let site = constArgument(n, r, 0);
    let isRace = constArgument(n, r, 1) == 1;
    for (k in 0..2u32) {
        let child = constArgument(n, r, 2 + 2 * k);
        e.t(if (e.split) "static CEE_UNUSED bool ceeAJ" else "static bool ceeAJ")?;
        e.d(site as u64)?;
        e.t("_")?;
        e.d(k as u64)?;
        e.t("(void *frame, ceesafe_scope *scope) {")?;
        e.emit()?;
        e.t("    struct ")?;
        appendAsyncName(c, mut e.buf, "ceeAF_", child)?;
        e.t(" *f = (struct ")?;
        appendAsyncName(c, mut e.buf, "ceeAF_", child)?;
        e.t(" *)frame;")?;
        e.emit()?;
        e.t("    if (!")?;
        appendAsyncName(c, mut e.buf, "ceeAR_", child)?;
        e.t("(f)) return false;")?;
        e.emit()?;
        e.t("    struct ceeAJ_")?;
        e.d(site as u64)?;
        e.t(" *j = (struct ceeAJ_")?;
        e.d(site as u64)?;
        e.t(" *)(void *)scope;")?;
        e.emit()?;
        e.t("    j->r")?;
        e.d(k as u64)?;
        e.t(" = f->cee_result;")?;
        e.emit()?;
        e.t("    if (j->first == 2u) j->first = ")?;
        e.d(k as u64)?;
        e.t("u;")?;
        e.emit()?;
        e.line(
            if (isRace) "    ceesafe_async_cancel(scope);" else "    if (f->cee_result.tag != 0) ceesafe_async_cancel(scope);",
        )?;
        e.line("    return true;")?;
        e.line("}")?;
    }
    return Ok();
}

fn emitFrameStruct(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    f: u32,
) -> Result<void, AllocError> {
    let source = nirFunctionSource(n, f);
    for (block in n.functions[f as usize].blocks.view()) {
        for (s in block.statements.view()) {
            let r = statementRvalue(n, s);
            if (r != none() && builtinOf(n, r) == bfAsyncJoin()) {
                emitJoinStruct(e, c, n, r)?;
            }
            if (r != none() && builtinOf(n, r) == bfAsyncBlocking()) {
                emitBlockingStruct(e, c, n, r)?;
            }
        }
    }
    let function = borrow n.functions[f as usize];
    e.t("struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t(" {")?;
    e.emit()?;
    e.line("    uint32_t cee_state;")?;
    let environment = c.hir.functions[source as usize].closureEnvironment;
    if (environment != none()) {
        // An async closure's own copy of its environment, taken when it starts (ADR 0033): the closure value it was
        // made from may be made again, by the next iteration of a loop, while this task runs.
        e.t("    ")?;
        appendCTypeName(c, mut e.buf, environment)?;
        e.t(" cee_env;")?;
        e.emit()?;
    }
    let inFrame = frameLocals(n, f)?;
    for (k in 0..truncate<u32>(function.locals.length)) {
        if (!inFrame[k as usize]) {
            continue; // a C local of the resume function
        }
        e.t("    ")?;
        appendCTypeName(c, mut e.buf, function.locals[k as usize].typ)?;
        e.t(" ")?;
        appendLocalName(c, mut e.buf, function, k)?;
        e.t(";")?;
        e.emit()?;
    }
    // A task waits at one suspension point at a time, so what each needs only while it waits (an awaited child's
    // frame, a join, a worker) shares one union (c-backend.md §3a). A scope's struct is its own field: it must be
    // zero when the scope's first child is spawned.
    var members = Vector<Vector<u8>>.create();
    var site: u32 = 0;
    for (block in function.blocks.view()) {
        for (s in block.statements.view()) {
            if (!isSuspension(n, s)) {
                continue;
            }
            site += 1;
            let r = statementRvalue(n, s);
            if (builtinOf(n, r) == bfAsyncBlocking()) {
                let blocking = constArgument(n, r, 0);
                var member = copyBytes("struct ceeAB_".bytes())?;
                appendDecimal(mut member, blocking as u64)?;
                appendText(mut member, " cee_b")?;
                appendDecimal(mut member, blocking as u64)?;
                members.push(member)?;
            }
            if (builtinOf(n, r) == bfAsyncJoin()) {
                let join = constArgument(n, r, 0);
                var member = copyBytes("struct ceeAJ_".bytes())?;
                appendDecimal(mut member, join as u64)?;
                appendText(mut member, " cee_j")?;
                appendDecimal(mut member, join as u64)?;
                members.push(member)?;
            }
            if (builtinOf(n, r) == bfAsyncScopeWait()) {
                let scope = constArgument(n, r, 0);
                e.t("    struct ceeAS_")?;
                e.d(scope as u64)?;
                e.t(" cee_s")?;
                e.d(scope as u64)?;
                e.t(";")?;
                e.emit()?;
            }
            if (builtinOf(n, r) == bfAsyncBoxed()) {
                var member = copyBytes("void *cee_x".bytes())?; // the boxed task's frame, from its allocator (§40.1)
                appendDecimal(mut member, site as u64)?;
                members.push(member)?;
            }
            let callee = awaitedCallee(n, s);
            if (callee != none()) {
                var member = copyBytes("struct ".bytes())?;
                appendAsyncName(c, mut member, "ceeAF_", callee)?;
                appendText(mut member, " cee_a")?;
                appendDecimal(mut member, site as u64)?;
                members.push(member)?;
            }
        }
    }
    if (members.length > 0) {
        e.line("    union {")?;
        for (member in members.view()) {
            e.t("        ")?;
            e.b(member.view())?;
            e.t(";")?;
            e.emit()?;
        }
        e.line("    } cee_u;")?;
    }
    let result = c.hir.functions[source as usize].returnType;
    if (!c.types.is(result, TypeKind.Void)) {
        e.t("    ")?;
        appendCTypeName(c, mut e.buf, result)?;
        e.t(" cee_result;")?;
        e.emit()?;
    }
    e.line("};")?;
    return Ok();
}

/// The frame structs, children before the frames that embed them, and the async prototypes; before the functions.
fn emitAsyncDeclarations(e: borrow mut CEmitter, c: borrow Checker, n: borrow NirProgram) -> Result<void, AllocError> {
    var asyncs = Vector<u32>.create();
    var pending = Vector<u32>.create();
    for (f in e.compiled.view()) {
        if (isAsyncNir(c, n, f)) {
            asyncs.push(f)?;
            pending.push(f)?;
        }
    }
    if (pending.length == 0) {
        return Ok();
    }
    for (f in asyncs.view()) {
        for (block in n.functions[f as usize].blocks.view()) {
            for (s in block.statements.view()) {
                let r = statementRvalue(n, s);
                if (r != none() && builtinOf(n, r) == bfAsyncScopeWait()) {
                    emitScopeStruct(e, c, constArgument(n, r, 0), n.rvalueTypes[r as usize])?;
                }
            }
        }
    }
    var done = Vector<u32>.create(); // HIR functions whose frames are defined
    while (pending.length > 0) {
        var progressed = false;
        var k: usize = 0;
        while (k < pending.length) {
            let f = pending[k];
            var ready = true;
            for (block in n.functions[f as usize].blocks.view()) {
                for (s in block.statements.view()) {
                    let callee = awaitedCallee(n, s);
                    if (callee != none() && !containsU32(done, callee)) {
                        ready = false;
                    }
                    let r = statementRvalue(n, s);
                    if (r != none() && builtinOf(n, r) == bfAsyncJoin() &&
                        (!containsU32(done, constArgument(n, r, 2)) || !containsU32(done, constArgument(n, r, 4)))) {
                        ready = false; // the join embeds both children's frames
                    }
                }
            }
            if (ready) {
                emitFrameStruct(e, c, n, f)?;
                emitFrameAsserts(e, c, n, f)?;
                done.push(nirFunctionSource(n, f))?;
                let last = pending.length - 1;
                pending.swap(k, last); // the order among ready frames does not matter
                pending.pop();
                progressed = true;
            } else {
                k += 1;
            }
        }
        if (!progressed) {
            // A cycle cannot reach the backend (N0343); emit the rest in order rather than loop.
            for (f in pending.view()) {
                emitFrameStruct(e, c, n, f)?;
                emitFrameAsserts(e, c, n, f)?;
            }
            pending.clear();
        }
    }
    for (f in asyncs.view()) {
        let source = nirFunctionSource(n, f);
        e.fnProto()?;
        e.t("void ")?;
        appendAsyncName(c, mut e.buf, "ceeAI_", source)?;
        e.t("(struct ")?;
        appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
        e.t(" *")?;
        let function = borrow n.functions[f as usize];
        for (k in 0..function.parameterCount) {
            e.t(", ")?;
            appendCTypeName(c, mut e.buf, function.locals[k as usize].typ)?;
        }
        e.t(");")?;
        e.emit()?;
        e.fnProto()?;
        e.t("bool ")?;
        appendAsyncName(c, mut e.buf, "ceeAR_", source)?;
        e.t("(struct ")?;
        appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
        e.t(" *);")?;
        e.emit()?;
        e.fnProto()?;
        e.t("bool ")?;
        appendAsyncName(c, mut e.buf, "ceeAT_", source)?;
        e.t("(void *);")?;
        e.emit()?;
        e.t(if (e.split) "extern const ceesafe_frame_info " else "static CEE_UNUSED const ceesafe_frame_info ")?;
        appendAsyncName(c, mut e.buf, "ceeAN_", source)?;
        e.t(";")?;
        e.emit()?;
    }
    for (f in asyncs.view()) {
        for (block in n.functions[f as usize].blocks.view()) {
            for (s in block.statements.view()) {
                let r = statementRvalue(n, s);
                if (r != none() && builtinOf(n, r) == bfAsyncSpawn()) {
                    emitChildThunk(e, c, n, constArgument(n, r, 0), constArgument(n, r, 1))?;
                }
                if (r != none() && builtinOf(n, r) == bfAsyncJoin()) {
                    emitJoinThunks(e, c, n, r)?;
                }
                if (r != none() && builtinOf(n, r) == bfAsyncBlocking()) {
                    emitBlockingThunk(e, c, n, r)?;
                }
            }
        }
    }
    return Ok();
}

fn emitAsyncFunction(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
) -> Result<void, AllocError> {
    e.function = f;
    e.inPlace.clear();
    inPlaceSites(c, n, f, mut e.inPlace)?;
    let source = nirFunctionSource(n, f);
    let nameStart = functionNameStart(c, source);
    let syntax = c.front.ast.functions[c.hir.functions[source as usize].syntax as usize];
    let function = borrow n.functions[f as usize];
    // The initialiser: a zeroed frame (state 0), then the arguments.
    mapTo(e, c, n, sources, nameStart, c.front.ast.idents[syntax.name as usize].end);
    e.fnPrefix()?;
    e.t("void ")?;
    appendAsyncName(c, mut e.buf, "ceeAI_", source)?;
    e.t("(struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t(" *cee_frame")?;
    for (k in 0..function.parameterCount) {
        e.t(", ")?;
        appendCTypeName(c, mut e.buf, function.locals[k as usize].typ)?;
        e.t(" ")?;
        appendLocalName(c, mut e.buf, function, k)?;
    }
    e.t(") {")?;
    e.emit()?;
    e.t("    *cee_frame = (struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t("){0};")?;
    e.emit()?;
    for (k in 0..function.parameterCount) {
        e.t("    cee_frame->")?;
        appendLocalName(c, mut e.buf, function, k)?;
        e.t(" = ")?;
        appendLocalName(c, mut e.buf, function, k)?;
        e.t(";")?;
        e.emit()?;
    }
    if (c.hir.functions[source as usize].closureEnvironment != none() && function.parameterCount > 0) {
        // Its own copy of the environment (ADR 0033): captures by value are this child's, and the closure value
        // it came from may be made again while it runs.
        e.t("    cee_frame->cee_env = *")?;
        appendLocalName(c, mut e.buf, function, 0)?;
        e.t(";")?;
        e.emit()?;
        e.t("    cee_frame->")?;
        appendLocalName(c, mut e.buf, function, 0)?;
        e.t(" = &cee_frame->cee_env;")?;
        e.emit()?;
    }
    e.line("}")?;
    // The thunk the runtime calls.
    e.fnPrefix()?;
    e.t("bool ")?;
    appendAsyncName(c, mut e.buf, "ceeAT_", source)?;
    e.t("(void *frame) { return ")?;
    appendAsyncName(c, mut e.buf, "ceeAR_", source)?;
    e.t("((struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t(" *)frame); }")?;
    e.emit()?;
    // The resume function.
    e.fnPrefix()?;
    e.t("bool ")?;
    appendAsyncName(c, mut e.buf, "ceeAR_", source)?;
    e.t("(struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t(" *cee_frame) {")?;
    e.emit()?;
    let inFrame = frameLocals(n, f)?;
    for (k in 0..truncate<u32>(function.locals.length)) {
        if (!inFrame[k as usize]) {
            // Not live across a suspension point: a C local, zero-initialised as a sync function's (§5).
            let t = function.locals[k as usize].typ;
            e.t("    CEE_UNUSED ")?;
            appendCTypeName(c, mut e.buf, t)?;
            e.t(" ")?;
            appendLocalName(c, mut e.buf, function, k)?;
            e.t(" = ")?;
            e.t(localZero(c, t))?;
            e.t(";")?;
            e.emit()?;
            continue;
        }
        e.t("#define ")?;
        appendLocalName(c, mut e.buf, function, k)?;
        e.t(" (cee_frame->")?;
        appendLocalName(c, mut e.buf, function, k)?;
        e.t(")")?;
        e.emit()?;
    }
    var states: u32 = 0;
    for (block in function.blocks.view()) {
        for (s in block.statements.view()) {
            if (isSuspension(n, s)) {
                states += 1;
            }
        }
    }
    e.line("    switch (cee_frame->cee_state) {")?;
    for (k in 1..states + 1) {
        e.t("    case ")?;
        e.d(k as u64)?;
        e.t("u: goto cee_resume_")?;
        e.d(k as u64)?;
        e.t(";")?;
        e.emit()?;
    }
    e.line("    default: break;")?;
    e.line("    }")?;
    e.inAsync = true;
    e.asyncState = 0;
    e.asyncStarts.clear();
    e.statementStart = nameStart;
    emitFlatBody(e, c, n, sources, f)?;
    e.inAsync = false;
    for (k in 0..truncate<u32>(function.locals.length)) {
        if (!inFrame[k as usize]) {
            continue;
        }
        e.t("#undef ")?;
        appendLocalName(c, mut e.buf, function, k)?;
        e.emit()?;
    }
    e.line("}")?;
    endMapping(e)?;
    emitFrameInfo(e, c, n, sources, f)?;
    e.function = none();
    return Ok();
}

/// ceeAL_<F> and ceeAN_<F>: the name, file and line of each resume state, for ceesafe_async_dump (§3a).
fn emitFrameInfo(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
) -> Result<void, AllocError> {
    let source = nirFunctionSource(n, f);
    let file = c.hir.functions[source as usize].file;
    e.t("static const uint32_t ")?;
    appendAsyncName(c, mut e.buf, "ceeAL_", source)?;
    e.t("[] = {")?;
    e.d(sources[file as usize].position(functionNameStart(c, source) as usize).line as u64)?;
    for (k in 0..e.asyncStarts.length) {
        let start = e.asyncStarts[k];
        e.t(", ")?;
        e.d(sources[file as usize].position(start as usize).line as u64)?;
    }
    e.t("};")?;
    e.emit()?;
    e.t(if (e.split) "CEE_UNUSED const ceesafe_frame_info " else "static CEE_UNUSED const ceesafe_frame_info ")?;
    appendAsyncName(c, mut e.buf, "ceeAN_", source)?;
    e.t(" = {")?;
    var name = Vector<u8>.create();
    let hf = borrow c.hir.functions[source as usize];
    if (hf.closureEnvironment != none()) {
        appendText(mut name, "async closure")?;
    } else {
        if (hf.owner != none()) {
            appendBytes(mut name, c.typeName(hf.owner))?;
            name.push('.')?;
        }
        appendBytes(mut name, c.name(hf.name))?;
    }
    appendCStringLiteral(mut e.buf, name.view())?;
    e.t(", ")?;
    appendCStringLiteral(mut e.buf, e.paths[file as usize].view())?;
    e.t(", ")?;
    appendAsyncName(c, mut e.buf, "ceeAL_", source)?;
    e.t(", ")?;
    e.d(e.asyncStarts.length as u64 + 1)?;
    e.t("u};")?;
    return e.emit();
}

/// A statement with a task's role (NirProgram.rvalueTasks) or `Async.park()`: false if it is neither.
fn emitTaskStatement(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
    s: u32,
) -> Result<bool, AllocError> {
    let r = statementRvalue(n, s);
    if (r == none()) {
        return Ok(false);
    }
    let target = match (n.statements[s as usize]) {
        NirStatement.Assign(t, _) => t,
        _ => none(),
    };
    if (builtinOf(n, r) == bfAsyncPark()) {
        e.nextState()?;
        e.t("    cee_frame->cee_state = ")?;
        e.d(e.asyncState as u64)?;
        e.t("u;")?;
        e.emit()?;
        e.line("    return false;")?;
        e.t("cee_resume_")?;
        e.d(e.asyncState as u64)?;
        e.t(": ;")?;
        e.emit()?;
        return Ok(true);
    }
    if (builtinOf(n, r) == bfAsyncSpawn()) {
        return emitSpawn(e, c, n, sources, f, r);
    }
    if (builtinOf(n, r) == bfAsyncScopeWait()) {
        return emitScopeWait(e, c, n, sources, f, r, target);
    }
    if (builtinOf(n, r) == bfAsyncJoin()) {
        return emitJoin(e, c, n, sources, f, r, target);
    }
    if (builtinOf(n, r) == bfAsyncBlocking()) {
        return emitBlocking(e, c, n, sources, f, r, target);
    }
    if (builtinOf(n, r) == bfAsyncBoxed()) {
        return emitBoxed(e, c, n, sources, f, r, target);
    }
    if (builtinOf(n, r) == bfAsyncJoinResult()) {
        let site = constArgument(n, r, 0);
        let k = constArgument(n, r, 1);
        if (target != none()) {
            let place = appendPlaceIn(e, c, n, sources, f, target)?;
            e.t("    ")?;
            e.b(place.view())?;
            e.t(" = cee_frame->cee_u.cee_j")?;
            e.d(site as u64)?;
            e.t(".r")?;
            e.d(k as u64)?;
            e.t(";")?;
            e.emit()?;
        }
        return Ok(true);
    }
    let role = n.rvalueTasks[r as usize];
    if (role == 0) {
        return Ok(false);
    }
    var callee = none();
    var arguments = emptyRange();
    match (n.rvalues[r as usize]) {
        NirRvalue.Call(function, list) => {
            callee = function;
            arguments = list;
        }
        _ => { return Ok(false); }
    }
    var args = Vector<u8>.create();
    let calleeNir = asyncNirFunction(n, callee);
    if (c.hir.functions[callee as usize].closureEnvironment != none() && calleeNir != none() && arguments.count > 0) {
        // An awaited async closure (Async.shield): its value is its environment's first member (§36.2).
        appendText(mut args, "(")?;
        appendCTypeName(c, mut args, n.functions[calleeNir as usize].locals[0].typ)?;
        appendText(mut args, ")(uintptr_t)")?;
        let environment = operandText(e, c, n, sources, f, n.at(arguments, 0))?;
        appendBytes(mut args, environment.view())?;
        if (arguments.count > 1) {
            appendText(mut args, ", ")?;
            appendOperandList(e, c, n, sources, f, mut args, arguments, 1)?;
        }
    } else {
        appendOperandList(e, c, n, sources, f, mut args, arguments, 0)?;
    }
    var place = Vector<u8>.create();
    if (target != none()) {
        place = appendPlaceIn(e, c, n, sources, f, target)?;
    }
    if (role == taskRun()) {
        // `Async.run(g(…))`: the root frame in this function's storage, run until it returns (§3a).
        e.line("    {")?;
        e.t("        struct ")?;
        appendAsyncName(c, mut e.buf, "ceeAF_", callee)?;
        e.t(" cee_root;")?;
        e.emit()?;
        e.t("        ")?;
        appendAsyncName(c, mut e.buf, "ceeAI_", callee)?;
        e.t("(&cee_root")?;
        if (arguments.count > 0) {
            e.t(", ")?;
            e.b(args.view())?;
        }
        e.t(");")?;
        e.emit()?;
        e.t("        ceesafe_async_run(&cee_root, ")?;
        appendAsyncName(c, mut e.buf, "ceeAT_", callee)?;
        e.t(", &")?;
        appendAsyncName(c, mut e.buf, "ceeAN_", callee)?;
        e.t(");")?;
        e.emit()?;
        if (target != none()) {
            e.t("        ")?;
            e.b(place.view())?;
            e.t(" = cee_root.cee_result;")?;
            e.emit()?;
        }
        e.line("    }")?;
        return Ok(true);
    }
    // `await g(…)`: start the child in its field, then resume it until it returns.
    let k = e.nextState()?;
    e.t("    ")?;
    appendAsyncName(c, mut e.buf, "ceeAI_", callee)?;
    e.t("(&cee_frame->cee_u.cee_a")?;
    e.d(k as u64)?;
    if (arguments.count > 0) {
        e.t(", ")?;
        e.b(args.view())?;
    }
    e.t(");")?;
    e.emit()?;
    e.t("    cee_frame->cee_state = ")?;
    e.d(k as u64)?;
    e.t("u;")?;
    e.emit()?;
    e.t("cee_resume_")?;
    e.d(k as u64)?;
    e.t(":")?;
    e.emit()?;
    e.t("    if (!")?;
    appendAsyncName(c, mut e.buf, "ceeAR_", callee)?;
    e.t("(&cee_frame->cee_u.cee_a")?;
    e.d(k as u64)?;
    e.t(")) return false;")?;
    e.emit()?;
    if (target != none()) {
        e.t("    ")?;
        e.b(place.view())?;
        e.t(" = cee_frame->cee_u.cee_a")?;
        e.d(k as u64)?;
        e.t(".cee_result;")?;
        e.emit()?;
    }
    return Ok(true);
}

/// `s.spawn(child)`: the child's task and frame from the runtime, then the frame initialised with its environment.
fn emitSpawn(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
    r: u32,
) -> Result<bool, AllocError> {
    let site = constArgument(n, r, 0);
    let child = constArgument(n, r, 1);
    let list = builtinArguments(n, r);
    let value = operandText(e, c, n, sources, f, n.at(list, 2))?;
    let childNir = asyncNirFunction(n, child);
    e.line("    {")?;
    e.t("        struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", child)?;
    e.t(" *cee_child = ceesafe_async_spawn(&cee_frame->cee_s")?;
    e.d(site as u64)?;
    e.t(".rt, sizeof(struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", child)?;
    e.t("), ")?;
    appendAsyncName(c, mut e.buf, "ceeAC_", child)?;
    let allocator = constArgument(n, r, 3);
    if (allocator == none()) {
        e.t(", NULL, NULL")?; // the system heap
    } else {
        e.t(", ")?;
        appendAdapterName(c, mut e.buf, "ceeAA_", allocator)?;
        e.t(", ")?;
        appendAdapterName(c, mut e.buf, "ceeAD_", allocator)?;
    }
    e.t(", &")?;
    appendAsyncName(c, mut e.buf, "ceeAN_", child)?;
    e.t(");")?;
    e.emit()?;
    e.t("        if (cee_child != NULL) ")?;
    appendAsyncName(c, mut e.buf, "ceeAI_", child)?;
    e.t("(cee_child")?;
    if (childNir != none() && c.hir.functions[child as usize].closureEnvironment != none()) {
        // The closure's value is its environment's first member, so its address is the environment's (§36.2).
        e.t(", (")?;
        appendCTypeName(c, mut e.buf, n.functions[childNir as usize].locals[0].typ)?;
        e.t(")(uintptr_t)")?;
        e.b(value.view())?;
    }
    e.t(");")?;
    e.emit()?;
    e.line("    }")?;
    return Ok(true);
}

/// The end of a scope, suspension point k: wait for the children, then the scope's result (§40.5), then the scope
/// emptied for its next run.
fn emitScopeWait(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
    r: u32,
    target: u32,
) -> Result<bool, AllocError> {
    let site = constArgument(n, r, 0);
    let list = builtinArguments(n, r);
    let oom = operandText(e, c, n, sources, f, n.at(list, 1))?;
    let result = n.rvalueTypes[r as usize];
    let errorType = n.operandTypes[n.at(list, 1) as usize];
    var scope = copyBytes("cee_frame->cee_s".bytes())?;
    appendDecimal(mut scope, site as u64)?;
    var place = Vector<u8>.create();
    if (target != none()) {
        place = appendPlaceIn(e, c, n, sources, f, target)?;
    }
    let k = e.nextState()?;
    e.t("    cee_frame->cee_state = ")?;
    e.d(k as u64)?;
    e.t("u;")?;
    e.emit()?;
    e.t("cee_resume_")?;
    e.d(k as u64)?;
    e.t(":")?;
    e.emit()?;
    e.t("    if (!ceesafe_async_scope_done(&")?;
    e.b(scope.view())?;
    e.t(".rt)) return false;")?;
    e.emit()?;
    let dropOom = c.types.needsDrop(errorType);
    // The first child's error; else the oom error if a child could not start; else Ok.
    e.t("    if (")?;
    e.b(scope.view())?;
    e.t(".rt.failed) {")?;
    e.emit()?;
    if (target != none()) {
        e.t("        ")?;
        e.b(place.view())?;
        e.t(" = ")?;
        e.b(scope.view())?;
        e.t(".error;")?;
        e.emit()?;
    } else if (c.types.needsDrop(result)) {
        e.t("        ")?;
        appendDropGlueName(c, mut e.buf, result)?;
        e.t("(&")?;
        e.b(scope.view())?;
        e.t(".error);")?;
        e.emit()?;
    }
    if (dropOom) {
        e.t("        ")?;
        appendDropGlueName(c, mut e.buf, errorType)?;
        e.t("(&")?;
        e.b(oom.view())?;
        e.t(");")?;
        e.emit()?;
    }
    e.t("    } else if (")?;
    e.b(scope.view())?;
    e.t(".rt.oom) {")?;
    e.emit()?;
    if (target != none()) {
        e.t("        ")?;
        e.b(place.view())?;
        e.t(" = (")?;
        appendCTypeName(c, mut e.buf, result)?;
        e.t("){0};")?;
        e.emit()?;
        e.t("        ")?;
        e.b(place.view())?;
        e.t(".tag = 1;")?;
        e.emit()?;
        e.t("        ")?;
        e.b(place.view())?;
        e.t(".u.v_Err.f__0 = ")?;
        e.b(oom.view())?;
        e.t(";")?;
        e.emit()?;
    } else if (dropOom) {
        e.t("        ")?;
        appendDropGlueName(c, mut e.buf, errorType)?;
        e.t("(&")?;
        e.b(oom.view())?;
        e.t(");")?;
        e.emit()?;
    }
    e.line("    } else {")?;
    if (target != none()) {
        e.t("        ")?;
        e.b(place.view())?;
        e.t(" = (")?;
        appendCTypeName(c, mut e.buf, result)?;
        e.t("){0}; /* Ok */")?;
        e.emit()?;
    }
    if (dropOom) {
        e.t("        ")?;
        appendDropGlueName(c, mut e.buf, errorType)?;
        e.t("(&")?;
        e.b(oom.view())?;
        e.t(");")?;
        e.emit()?;
    }
    e.line("    }")?;
    e.t("    ")?;
    e.b(scope.view())?;
    e.t(" = (struct ceeAS_")?;
    e.d(site as u64)?;
    e.t("){0};")?;
    e.emit()?;
    return Ok(true);
}

/// `Async.race` or `Async.all`, suspension point k: both children start in the join's storage, then the task waits
/// for both; the value is the index of the one that returned first (§40.4).
fn emitJoin(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
    r: u32,
    target: u32,
) -> Result<bool, AllocError> {
    let site = constArgument(n, r, 0);
    let list = builtinArguments(n, r);
    var join = copyBytes("cee_frame->cee_u.cee_j".bytes())?;
    appendDecimal(mut join, site as u64)?;
    e.t("    ")?;
    e.b(join.view())?;
    e.t(" = (struct ceeAJ_")?;
    e.d(site as u64)?;
    e.t("){0};")?;
    e.emit()?;
    e.t("    ")?;
    e.b(join.view())?;
    e.t(".first = 2u;")?;
    e.emit()?;
    for (k in 0..2u32) {
        let child = constArgument(n, r, 2 + 2 * k);
        let value = operandText(e, c, n, sources, f, n.at(list, 3 + 2 * k))?;
        let childNir = asyncNirFunction(n, child);
        e.t("    ")?;
        appendAsyncName(c, mut e.buf, "ceeAI_", child)?;
        e.t("(&")?;
        e.b(join.view())?;
        e.t(".f")?;
        e.d(k as u64)?;
        if (childNir != none() && c.hir.functions[child as usize].closureEnvironment != none()) {
            e.t(", (")?;
            appendCTypeName(c, mut e.buf, n.functions[childNir as usize].locals[0].typ)?;
            e.t(")(uintptr_t)")?;
            e.b(value.view())?;
        }
        e.t(");")?;
        e.emit()?;
    }
    for (k in 0..2u32) {
        let child = constArgument(n, r, 2 + 2 * k);
        e.t("    ceesafe_async_start(&")?;
        e.b(join.view())?;
        e.t(".rt, &")?;
        e.b(join.view())?;
        e.t(".t")?;
        e.d(k as u64)?;
        e.t(", &")?;
        e.b(join.view())?;
        e.t(".f")?;
        e.d(k as u64)?;
        e.t(", ceeAJ")?;
        e.d(site as u64)?;
        e.t("_")?;
        e.d(k as u64)?;
        e.t(", &")?;
        appendAsyncName(c, mut e.buf, "ceeAN_", child)?;
        e.t(");")?;
        e.emit()?;
    }
    let k = e.nextState()?;
    e.t("    cee_frame->cee_state = ")?;
    e.d(k as u64)?;
    e.t("u;")?;
    e.emit()?;
    e.t("cee_resume_")?;
    e.d(k as u64)?;
    e.t(":")?;
    e.emit()?;
    e.t("    if (!ceesafe_async_scope_done(&")?;
    e.b(join.view())?;
    e.t(".rt)) return false;")?;
    e.emit()?;
    if (target != none()) {
        let place = appendPlaceIn(e, c, n, sources, f, target)?;
        e.t("    ")?;
        e.b(place.view())?;
        e.t(" = ")?;
        e.b(join.view())?;
        e.t(".first;")?;
        e.emit()?;
    }
    return Ok(true);
}

/// `Async.blocking` at `site`: the runtime's handle, the body (a closure value) and its result (c-backend.md §3a).
fn emitBlockingStruct(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    r: u32,
) -> Result<void, AllocError> {
    let site = constArgument(n, r, 0);
    let list = builtinArguments(n, r);
    e.t("struct ceeAB_")?;
    e.d(site as u64)?;
    e.t(" { ceesafe_blocking rt; ")?;
    appendCTypeName(c, mut e.buf, n.operandTypes[n.at(list, 2) as usize])?;
    e.t(" body; ")?;
    let result = n.rvalueTypes[r as usize];
    if (!c.types.is(result, TypeKind.Void)) {
        appendCTypeName(c, mut e.buf, result)?;
        e.t(" result; ")?;
    }
    e.t("};")?;
    return e.emit();
}

/// The worker thread's body: calls the closure, keeps its result, and wakes the task.
fn emitBlockingThunk(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    r: u32,
) -> Result<void, AllocError> {
    let site = constArgument(n, r, 0);
    let body = constArgument(n, r, 1);
    e.t(if (e.split) "static CEE_UNUSED void *ceeABT_" else "static void *ceeABT_")?;
    e.d(site as u64)?;
    e.t("(void *arg) {")?;
    e.emit()?;
    e.t("    struct ceeAB_")?;
    e.d(site as u64)?;
    e.t(" *b = (struct ceeAB_")?;
    e.d(site as u64)?;
    e.t(" *)arg;")?;
    e.emit()?;
    e.t("    ")?;
    if (!c.types.is(n.rvalueTypes[r as usize], TypeKind.Void)) {
        e.t("b->result = ")?;
    }
    // A closure is called through its environment's code pointer, with the environment first (§36.2).
    if (c.hir.functions[body as usize].closureEnvironment != none()) {
        e.t("(*b->body)(b->body);")?;
    } else {
        e.t("b->body();")?;
    }
    e.emit()?;
    e.line("    ceesafe_async_blocking_finish(&b->rt);")?;
    e.line("    return NULL;")?;
    e.line("}")?;
    return Ok();
}

/// `await Async.blocking(body)`, suspension point k: the worker starts, then the task waits until it has finished.
fn emitBlocking(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
    r: u32,
    target: u32,
) -> Result<bool, AllocError> {
    let site = constArgument(n, r, 0);
    let list = builtinArguments(n, r);
    let value = operandText(e, c, n, sources, f, n.at(list, 2))?;
    var b = copyBytes("cee_frame->cee_u.cee_b".bytes())?;
    appendDecimal(mut b, site as u64)?;
    e.t("    ")?;
    e.b(b.view())?;
    e.t(".body = ")?;
    e.b(value.view())?;
    e.t(";")?;
    e.emit()?;
    e.t("    ceesafe_async_blocking_start(&")?;
    e.b(b.view())?;
    e.t(".rt, ceeABT_")?;
    e.d(site as u64)?;
    e.t(", &")?;
    e.b(b.view())?;
    e.t(");")?;
    e.emit()?;
    let k = e.nextState()?;
    e.t("    cee_frame->cee_state = ")?;
    e.d(k as u64)?;
    e.t("u;")?;
    e.emit()?;
    e.t("cee_resume_")?;
    e.d(k as u64)?;
    e.t(":")?;
    e.emit()?;
    e.t("    if (!ceesafe_async_blocking_ready(&")?;
    e.b(b.view())?;
    e.t(".rt)) return false;")?;
    e.emit()?;
    if (target != none() && !c.types.is(n.rvalueTypes[r as usize], TypeKind.Void)) {
        let place = appendPlaceIn(e, c, n, sources, f, target)?;
        e.t("    ")?;
        e.b(place.view())?;
        e.t(" = ")?;
        e.b(b.view())?;
        e.t(".result;")?;
        e.emit()?;
    }
    return Ok(true);
}

// ---- Which locals live in the frame (L1 A3; c-backend.md §3a) ----

fn markLocal(set: borrow mut Vector<bool>, local: u32) {
    if (local != none() && (local as usize) < set.length) {
        set[local as usize] = true;
    }
}

/// The locals operand `o` reads, with its place's index operands.
fn operandLocals(n: borrow NirProgram, o: u32, set: borrow mut Vector<bool>) {
    if (o == none()) {
        return;
    }
    match (n.operands[o as usize]) {
        NirOperand.Place(place, _) => { placeLocals(n, place, set); }
        _ => {}
    }
}

/// A place's root local and the locals its index projections read.
fn placeLocals(n: borrow NirProgram, place: u32, set: borrow mut Vector<bool>) {
    let p = n.places[place as usize];
    markLocal(set, p.local);
    for (k in 0..p.projections.count) {
        let projection = n.projections[(p.projections.start + k) as usize];
        if (projection.index != none()) {
            operandLocals(n, projection.index, set);
        }
    }
}

/// A statement's uses (every local it mentions but a whole-local write) and definitions (whole-local writes), and the
/// locals it borrows. Conservative: a mention through a projection is a use.
fn statementUses(
    n: borrow NirProgram,
    s: u32,
    uses: borrow mut Vector<bool>,
    defs: borrow mut Vector<bool>,
    borrowed: borrow mut Vector<bool>,
) -> Result<void, AllocError> {
    match (n.statements[s as usize]) {
        NirStatement.StorageDead(_) => { return Ok(); } // the local's end reads nothing (a Drop does, and counts)
        _ => {}
    }
    var accesses = Vector<Access>.create();
    statementAccesses(n, s, mut accesses)?;
    for (a in accesses.view()) {
        if (a.kind == accessWrite() && a.place.projections.count == 0) {
            markLocal(defs, a.place.local);
        } else {
            markLocal(uses, a.place.local);
        }
        if (a.kind == accessBorrowShared() || a.kind == accessBorrowMut()) {
            markLocal(borrowed, a.place.local);
        }
        for (k in 0..a.place.projections.count) {
            let projection = n.projections[(a.place.projections.start + k) as usize];
            if (projection.index != none()) {
                operandLocals(n, projection.index, uses);
            }
        }
    }
    match (n.statements[s as usize]) {
        NirStatement.Drop(_, flag) => { markLocal(uses, flag); }
        NirStatement.BoxFree(_, flag) => { markLocal(uses, flag); }
        _ => {}
    }
    return Ok();
}

/// By local: whether it must be a frame field. A parameter is (the initialiser stores it); a borrowed local is (its
/// loan may cross a suspension); a local live just after a suspension point is; and so is every local a scope's end
/// mentions (it reads its oom operand after resuming). Every other local is a C local of the resume function.
fn frameLocals(n: borrow NirProgram, f: u32) -> Result<Vector<bool>, AllocError> {
    let function = borrow n.functions[f as usize];
    let count = function.locals.length;
    let blockCount = function.blocks.length;
    var inFrame = Vector<bool>.create();
    for (k in 0..count) {
        inFrame.push(truncate<u32>(k) < function.parameterCount)?;
    }
    // Per block: uses before definitions (gen) and definitions (kill), statement by statement backwards later.
    var indexOf = Vector<u32>.create(); // block id -> position
    for (k in 0..blockCount) {
        let id = function.blocks[k].id as usize;
        while (indexOf.length <= id) {
            indexOf.push(none())?;
        }
        indexOf[id] = truncate<u32>(k);
    }
    var liveIn = Vector<Vector<bool>>.create();
    for (k in 0..blockCount) {
        var empty = Vector<bool>.create();
        for (j in 0..count) {
            empty.push(false)?;
        }
        liveIn.push(empty)?;
    }
    var changed = true;
    while (changed) {
        changed = false;
        var k = blockCount;
        while (k > 0) {
            k -= 1;
            var live = Vector<bool>.create();
            for (j in 0..count) {
                live.push(false)?;
            }
            for (successor in function.blocks[k].successors.view()) {
                let position = indexOf[successor as usize];
                for (j in 0..count) {
                    if (liveIn[position as usize][j]) {
                        live[j] = true;
                    }
                }
            }
            var uses = Vector<bool>.create();
            var defs = Vector<bool>.create();
            var borrowed = Vector<bool>.create();
            for (j in 0..count) {
                uses.push(false)?;
                defs.push(false)?;
                borrowed.push(false)?;
            }
            var accesses = Vector<Access>.create();
            terminatorAccesses(n, function.blocks[k].terminator, mut accesses)?;
            for (a in accesses.view()) {
                markLocal(mut live, a.place.local);
            }
            var i = function.blocks[k].statements.length;
            while (i > 0) {
                i -= 1;
                let s = function.blocks[k].statements[i];
                for (j in 0..count) {
                    uses[j] = false;
                    defs[j] = false;
                }
                statementUses(n, s, mut uses, mut defs, mut borrowed)?;
                if (isSuspension(n, s)) {
                    // Live after the suspension. An awaited call's arguments are used before it and its result is
                    // written after; only a scope's end reads an operand (its oom error) after it resumes.
                    let readsAfter = builtinOf(n, statementRvalue(n, s)) == bfAsyncScopeWait();
                    for (j in 0..count) {
                        if (live[j] || (readsAfter && (uses[j] || defs[j]))) {
                            inFrame[j] = true;
                        }
                    }
                }
                for (j in 0..count) {
                    if (defs[j] && !uses[j]) {
                        live[j] = false;
                    }
                    if (uses[j]) {
                        live[j] = true;
                    }
                }
            }
            for (j in 0..count) {
                if (borrowed[j]) {
                    inFrame[j] = true;
                }
                if (live[j] != liveIn[k][j]) {
                    liveIn[k][j] = live[j];
                    changed = true;
                }
            }
        }
    }
    return Ok(inFrame);
}

// ---- Frame layouts (L1 A3: --explain-frames, and a _Static_assert of each frame's size) ----

/// A struct's layout as it is built: its size so far and its alignment.
struct LayoutBuilder {
    size: u64;
    align: u64;
}

fn layoutAdd(l: borrow mut LayoutBuilder, size: u64, align: u64) {
    let a = if (align == 0) 1 else align;
    l.size = (l.size + a - 1) / a * a + size;
    if (a > l.align) {
        l.align = a;
    }
}

fn layoutEnd(l: borrow LayoutBuilder) -> SizeAlign {
    let a = if (l.align == 0) 1 else l.align;
    return SizeAlign { size: truncate<i64>((l.size + a - 1) / a * a), align: truncate<u32>(a) };
}

fn typeLayout(c: borrow Checker, t: u32) -> SizeAlign => cLayout(c, t);

/// The runtime's structs (ceesafe/rt.h), on the 64-bit targets ceesafec emits for.
fn scopeLayout() -> SizeAlign => SizeAlign { size: 24, align: 8 };
fn taskSlotLayout() -> SizeAlign => SizeAlign { size: 128, align: 16 };
fn blockingLayout() -> SizeAlign => SizeAlign { size: 32, align: 8 };

/// What a frame is made of, for --explain-frames.
struct FrameReport {
    layout: SizeAlign;
    keptLocals: u32;
    allLocals: u32;
    localBytes: u64;
    unionBytes: u64;
    unionMembers: u32;
    scopeBytes: u64;
    largest: Vector<u32>; // the three largest kept locals
}

fn addLayout(l: borrow mut LayoutBuilder, part: SizeAlign) {
    layoutAdd(l, truncate<u64>(part.size), part.align as u64);
}

/// The layout of async fn `f`'s frame, struct ceeAF_<f>, field by field as emitFrameStruct writes it.
fn frameReport(c: borrow Checker, n: borrow NirProgram, f: u32) -> Result<FrameReport, AllocError> {
    let function = borrow n.functions[f as usize];
    let source = nirFunctionSource(n, f);
    let inFrame = frameLocals(n, f)?;
    var l = LayoutBuilder { size: 0, align: 1 };
    layoutAdd(mut l, 4, 4); // cee_state
    let environment = c.hir.functions[source as usize].closureEnvironment;
    if (environment != none()) {
        addLayout(mut l, typeLayout(c, environment)); // cee_env (ADR 0033)
    }
    var report = FrameReport {
        layout: SizeAlign { size: 0, align: 1 },
        keptLocals: 0,
        allLocals: truncate<u32>(function.locals.length),
        localBytes: 0,
        unionBytes: 0,
        unionMembers: 0,
        scopeBytes: 0,
        largest: Vector<u32>.create(),
    };
    for (k in 0..truncate<u32>(function.locals.length)) {
        if (!inFrame[k as usize]) {
            continue;
        }
        let part = typeLayout(c, function.locals[k as usize].typ);
        addLayout(mut l, part);
        report.keptLocals += 1;
        report.localBytes += truncate<u64>(part.size);
        report.largest.push(k)?;
    }
    report.largest.sortBy((a, b) => {
        let sa = typeLayout(c, function.locals[a as usize].typ).size;
        let sb = typeLayout(c, function.locals[b as usize].typ).size;
        return if (sa > sb) -1 else if (sa < sb) 1 else 0;
    });
    report.largest.truncate(3);
    var union = LayoutBuilder { size: 0, align: 1 };
    var unionSize: u64 = 0;
    for (block in function.blocks.view()) {
        for (s in block.statements.view()) {
            if (!isSuspension(n, s)) {
                continue;
            }
            let r = statementRvalue(n, s);
            var member = SizeAlign { size: -1, align: 1 };
            if (builtinOf(n, r) == bfAsyncBlocking()) {
                var b = LayoutBuilder { size: 0, align: 1 };
                addLayout(mut b, blockingLayout());
                addLayout(mut b, typeLayout(c, n.operandTypes[n.at(builtinArguments(n, r), 2) as usize]));
                if (!c.types.is(n.rvalueTypes[r as usize], TypeKind.Void)) {
                    addLayout(mut b, typeLayout(c, n.rvalueTypes[r as usize]));
                }
                member = layoutEnd(b);
            }
            if (builtinOf(n, r) == bfAsyncJoin()) {
                let first = constArgument(n, r, 2);
                let second = constArgument(n, r, 4);
                var j = LayoutBuilder { size: 0, align: 1 };
                addLayout(mut j, scopeLayout());
                layoutAdd(mut j, 4, 4);
                let result = typeLayout(c, c.hir.functions[first as usize].returnType);
                addLayout(mut j, result);
                addLayout(mut j, result);
                addLayout(mut j, taskSlotLayout());
                addLayout(mut j, taskSlotLayout());
                addLayout(mut j, frameReport(c, n, asyncNirFunction(n, first))?.layout);
                addLayout(mut j, frameReport(c, n, asyncNirFunction(n, second))?.layout);
                member = layoutEnd(j);
            }
            if (builtinOf(n, r) == bfAsyncScopeWait()) {
                var sc = LayoutBuilder { size: 0, align: 1 };
                addLayout(mut sc, scopeLayout());
                addLayout(mut sc, typeLayout(c, n.rvalueTypes[r as usize]));
                let part = layoutEnd(sc);
                addLayout(mut l, part); // a scope's struct is its own field, in statement order
                report.scopeBytes += truncate<u64>(part.size);
            }
            if (builtinOf(n, r) == bfAsyncBoxed()) {
                member = SizeAlign { size: 8, align: 8 }; // a pointer to the boxed frame
            }
            let callee = awaitedCallee(n, s);
            if (callee != none()) {
                member = frameReport(c, n, asyncNirFunction(n, callee))?.layout;
            }
            if (member.size >= 0) {
                report.unionMembers += 1;
                if (truncate<u64>(member.size) > unionSize) {
                    unionSize = truncate<u64>(member.size);
                }
                if (member.align as u64 > union.align) {
                    union.align = member.align as u64;
                }
            }
        }
    }
    if (report.unionMembers > 0) {
        union.size = unionSize;
        let u = layoutEnd(union);
        addLayout(mut l, u);
        report.unionBytes = truncate<u64>(u.size);
    }
    let result = c.hir.functions[source as usize].returnType;
    if (!c.types.is(result, TypeKind.Void)) {
        addLayout(mut l, typeLayout(c, result));
    }
    report.layout = layoutEnd(l);
    return Ok(report);
}

/// `_Static_assert`s of a frame's size and alignment: the C compiler checks frameReport's arithmetic.
fn emitFrameAsserts(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    f: u32,
) -> Result<void, AllocError> {
    let source = nirFunctionSource(n, f);
    let layout = frameReport(c, n, f)?.layout;
    e.t("_Static_assert(sizeof(struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t(") == ")?;
    e.d(truncate<u64>(layout.size))?;
    e.t(", \"ceesafec frame layout\");")?;
    e.emit()?;
    e.t("_Static_assert(_Alignof(struct ")?;
    appendAsyncName(c, mut e.buf, "ceeAF_", source)?;
    e.t(") == ")?;
    e.d(layout.align as u64)?;
    e.t(", \"ceesafec frame layout\");")?;
    return e.emit();
}

/// --explain-frames: each async fn of the program, its frame's size and what makes it large (L1 A3).
fn explainFrames(
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    for (f in 0..truncate<u32>(n.functions.length)) {
        let source = nirFunctionSource(n, f);
        if (!isAsyncNir(c, n, f) || functionIsGeneric(c, source) || n.functions[f as usize].variant != 0) {
            continue;
        }
        let file = c.hir.functions[source as usize].file;
        if (c.fileIsLibrary[file as usize]) {
            continue;
        }
        let report = frameReport(c, n, f)?;
        appendBytes(out, c.filePaths[file as usize].view())?;
        out.push(':')?;
        appendWhere(out, sources, file, functionNameStart(c, source))?;
        appendText(out, ": ")?;
        appendDescribedFunction(c, source, out)?;
        appendText(out, " has a frame of ")?;
        appendDecimal(out, truncate<u64>(report.layout.size))?;
        appendText(out, " bytes (align ")?;
        appendDecimal(out, report.layout.align as u64)?;
        appendText(out, "): ")?;
        appendDecimal(out, report.keptLocals as u64)?;
        appendText(out, " of ")?;
        appendDecimal(out, report.allLocals as u64)?;
        appendText(out, " locals kept, ")?;
        appendDecimal(out, report.localBytes)?;
        appendText(out, " bytes")?;
        if (report.unionMembers > 0) {
            appendText(out, "; waiting storage ")?;
            appendDecimal(out, report.unionBytes)?;
            appendText(out, " bytes for ")?;
            appendDecimal(out, report.unionMembers as u64)?;
            appendText(out, " suspension point(s)")?;
        }
        if (report.scopeBytes > 0) {
            appendText(out, "; scopes ")?;
            appendDecimal(out, report.scopeBytes)?;
            appendText(out, " bytes")?;
        }
        let function = borrow n.functions[f as usize];
        if (report.largest.length > 0) {
            appendText(out, "; largest: ")?;
            for (k in 0..report.largest.length) {
                if (k > 0) {
                    appendText(out, ", ")?;
                }
                let local = report.largest[k];
                appendLocalName(c, out, function, local)?;
                appendText(out, " (")?;
                appendDecimal(out, truncate<u64>(typeLayout(c, function.locals[local as usize].typ).size))?;
                appendText(out, ")")?;
            }
        }
        out.push('\n')?;
    }
    return Ok();
}

// ---- Frames from an allocator (Async.boxed, Async.scopeIn; L1 A3) ----

fn appendAdapterName(
    c: borrow Checker,
    out: borrow mut Vector<u8>,
    prefix: StringView,
    allocator: u32,
) -> Result<void, AllocError> {
    appendText(out, prefix)?;
    return appendMangle(c, out, allocator);
}

/// The allocator types async code takes frames from, each once.
fn frameAllocators(e: borrow CEmitter, c: borrow Checker, n: borrow NirProgram) -> Result<Vector<u32>, AllocError> {
    var found = Vector<u32>.create();
    for (f in e.compiled.view()) {
        if (!isAsyncNir(c, n, f)) {
            continue;
        }
        for (block in n.functions[f as usize].blocks.view()) {
            for (s in block.statements.view()) {
                let r = statementRvalue(n, s);
                if (r == none()) {
                    continue;
                }
                var allocator = none();
                if (builtinOf(n, r) == bfAsyncBoxed()) {
                    allocator = constArgument(n, r, 0);
                } else if (builtinOf(n, r) == bfAsyncSpawn()) {
                    allocator = constArgument(n, r, 3);
                }
                if (allocator != none() && !containsU32(found, allocator)) {
                    found.push(allocator)?;
                }
            }
        }
    }
    return Ok(found);
}

/// `ceeAA_<A>(size, align)` and `ceeAD_<A>(p, size, align)`: a frame's memory from allocator type A and back (§30.3: a
/// user allocator's allocate and deallocate; else the runtime's heap, counted and fault-injected).
fn emitFrameAdapters(e: borrow mut CEmitter, c: borrow Checker, n: borrow NirProgram) -> Result<void, AllocError> {
    let allocators = frameAllocators(e, c, n)?;
    for (allocator in allocators.view()) {
        let user = isUserAllocator(c, allocator);
        e.helper()?;
        e.t("CEE_UNUSED void *")?;
        appendAdapterName(c, mut e.buf, "ceeAA_", allocator)?;
        e.t("(size_t size, size_t align) {")?;
        e.emit()?;
        if (user) {
            let definition = borrow c.types.structs[c.types.info(allocator).structDef as usize];
            let allocate = definition.allocateMethod;
            let layout = layoutTypeOf(c, allocator);
            let fields = borrow c.types.structs[c.types.info(layout).structDef as usize].fields;
            e.t("    ")?;
            appendCTypeName(c, mut e.buf, allocator)?;
            e.t(" a = { 0 };")?;
            e.emit()?;
            e.t("    ")?;
            appendCTypeName(c, mut e.buf, c.hir.functions[allocate as usize].returnType)?;
            e.t(" r = ")?;
            appendCFunctionName(c, mut e.buf, allocate)?;
            e.t("(&a, ((")?;
            appendCTypeName(c, mut e.buf, layout)?;
            e.t("){ .")?;
            appendFieldName(c, mut e.buf, fields[0])?;
            e.t(" = size, .")?;
            appendFieldName(c, mut e.buf, fields[1])?;
            e.t(" = align }));")?;
            e.emit()?;
            e.line("    return r.tag == 0 ? (void *)(uintptr_t)r.u.v_Ok.f__0 : NULL;")?;
        } else {
            e.line("    (void)align; /* the heap gives max_align_t alignment, which a frame's needs fit */")?;
            e.t("    return ceesafe_alloc(size, ")?;
            appendAllocatorId(c, mut e.buf, allocator)?;
            e.t(");")?;
            e.emit()?;
        }
        e.line("}")?;
        e.helper()?;
        e.t("CEE_UNUSED void ")?;
        appendAdapterName(c, mut e.buf, "ceeAD_", allocator)?;
        e.t("(void *p, size_t size, size_t align) {")?;
        e.emit()?;
        if (user) {
            let definition = borrow c.types.structs[c.types.info(allocator).structDef as usize];
            let deallocate = definition.deallocateMethod;
            let layout = layoutTypeOf(c, allocator);
            let fields = borrow c.types.structs[c.types.info(layout).structDef as usize].fields;
            e.t("    ")?;
            appendCTypeName(c, mut e.buf, allocator)?;
            e.t(" a = { 0 };")?;
            e.emit()?;
            e.t("    ")?;
            appendCFunctionName(c, mut e.buf, deallocate)?;
            e.t("(&a, (uint8_t *)p, ((")?;
            appendCTypeName(c, mut e.buf, layout)?;
            e.t("){ .")?;
            appendFieldName(c, mut e.buf, fields[0])?;
            e.t(" = size, .")?;
            appendFieldName(c, mut e.buf, fields[1])?;
            e.t(" = align }));")?;
            e.emit()?;
        } else {
            e.line("    (void)size;")?;
            e.line("    (void)align;")?;
            e.t("    ceesafe_free(p, ")?;
            appendAllocatorId(c, mut e.buf, allocator)?;
            e.t(");")?;
            e.emit()?;
        }
        e.line("}")?;
    }
    return Ok();
}

/// `await Async.boxed(alloc, g(args))`, suspension point k: g's frame from the allocator (or `Err` at once if it
/// cannot be had), run as an awaited call, then its result in `Ok` and the frame given back.
fn emitBoxed(
    e: borrow mut CEmitter,
    c: borrow Checker,
    n: borrow NirProgram,
    sources: borrow Vector<SourceText>,
    f: u32,
    r: u32,
    target: u32,
) -> Result<bool, AllocError> {
    let allocator = constArgument(n, r, 0);
    let callee = constArgument(n, r, 1);
    let list = builtinArguments(n, r);
    var args = Vector<u8>.create();
    appendOperandList(e, c, n, sources, f, mut args, list, 2)?;
    let k = e.nextState()?;
    var slot = copyBytes("cee_frame->cee_u.cee_x".bytes())?;
    appendDecimal(mut slot, k as u64)?;
    var frameType = copyBytes("struct ".bytes())?;
    appendAsyncName(c, mut frameType, "ceeAF_", callee)?;
    var place = Vector<u8>.create();
    if (target != none()) {
        place = appendPlaceIn(e, c, n, sources, f, target)?;
    }
    let result = n.rvalueTypes[r as usize];
    e.t("    ")?;
    e.b(slot.view())?;
    e.t(" = ")?;
    appendAdapterName(c, mut e.buf, "ceeAA_", allocator)?;
    e.t("(sizeof(")?;
    e.b(frameType.view())?;
    e.t("), _Alignof(")?;
    e.b(frameType.view())?;
    e.t("));")?;
    e.emit()?;
    e.t("    if (")?;
    e.b(slot.view())?;
    e.t(" == NULL) {")?;
    e.emit()?;
    if (target != none()) {
        e.t("        ")?;
        e.b(place.view())?;
        e.t(" = (")?;
        appendCTypeName(c, mut e.buf, result)?;
        e.t("){0};")?;
        e.emit()?;
        e.t("        ")?;
        e.b(place.view())?;
        e.t(".tag = 1; /* Err(AllocError.OutOfMemory), the enum's only, zero value */")?;
        e.emit()?;
    }
    e.t("        goto cee_boxed_")?;
    e.d(k as u64)?;
    e.t(";")?;
    e.emit()?;
    e.line("    }")?;
    e.t("    ")?;
    appendAsyncName(c, mut e.buf, "ceeAI_", callee)?;
    e.t("((")?;
    e.b(frameType.view())?;
    e.t(" *)")?;
    e.b(slot.view())?;
    if (list.count > 2) {
        e.t(", ")?;
        e.b(args.view())?;
    }
    e.t(");")?;
    e.emit()?;
    e.t("    cee_frame->cee_state = ")?;
    e.d(k as u64)?;
    e.t("u;")?;
    e.emit()?;
    e.t("cee_resume_")?;
    e.d(k as u64)?;
    e.t(":")?;
    e.emit()?;
    e.t("    if (!")?;
    appendAsyncName(c, mut e.buf, "ceeAR_", callee)?;
    e.t("((")?;
    e.b(frameType.view())?;
    e.t(" *)")?;
    e.b(slot.view())?;
    e.t(")) return false;")?;
    e.emit()?;
    if (target != none()) {
        e.t("    ")?;
        e.b(place.view())?;
        e.t(" = (")?;
        appendCTypeName(c, mut e.buf, result)?;
        e.t("){0}; /* Ok */")?;
        e.emit()?;
        if (!c.types.is(c.hir.functions[callee as usize].returnType, TypeKind.Void)) {
            e.t("    ")?;
            e.b(place.view())?;
            e.t(".u.v_Ok.f__0 = ((")?;
            e.b(frameType.view())?;
            e.t(" *)")?;
            e.b(slot.view())?;
            e.t(")->cee_result;")?;
            e.emit()?;
        }
    }
    e.t("    ")?;
    appendAdapterName(c, mut e.buf, "ceeAD_", allocator)?;
    e.t("(")?;
    e.b(slot.view())?;
    e.t(", sizeof(")?;
    e.b(frameType.view())?;
    e.t("), _Alignof(")?;
    e.b(frameType.view())?;
    e.t("));")?;
    e.emit()?;
    e.t("cee_boxed_")?;
    e.d(k as u64)?;
    e.t(": ;")?;
    e.emit()?;
    return Ok(true);
}
