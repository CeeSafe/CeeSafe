// Split mode (the reference's CEmitter: NameUnits, UnitOf, SplitFiles; ADR 0022, c-backend.md §2.4): the C as
// ceesafe_program.h, one unit per CeeSafe file at `c/<package>/<path>.c` (ADR 0082 §2.1) and ceesafe_instances.c, with
// external names carrying the program's name.

/// Inserts a name into a sorted list (ordinal order), once.
fn insertSorted(list: borrow mut Vector<Vector<u8>>, name: Vector<u8>) -> Result<void, AllocError> {
    var at = list.length;
    for (k in 0..list.length) {
        let order = compareBytes(list[k].view(), name.view());
        if (order == 0) {
            return Ok();
        }
        if (at == list.length && order > 0) {
            at = k;
        }
    }
    list.push(name)?;
    var k = list.length - 1;
    while (k > at) {
        list.swap(k - 1, k);
        k -= 1;
    }
    return Ok();
}

fn isAsciiLetterOrDigit(b: u8) -> bool => (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9');

/// Appends text with every character that is not an ASCII letter or digit as `_`, one per UTF-16 unit.
fn appendIdentifierText(out: borrow mut Vector<u8>, text: Slice<u8>) -> Result<void, AllocError> {
    var i: usize = 0;
    while (i < text.length) {
        if (text[i] < 0x80) {
            out.push(if (isAsciiLetterOrDigit(text[i])) text[i] else '_')?;
            i += 1;
            continue;
        }
        let decoded = decodeUtf8(text, i);
        for (unit in 0..decoded.utf16Units()) {
            out.push('_')?;
        }
        i += decoded.length as usize;
    }
    return Ok();
}

/// Appends one component of a unit's path: `..` as `__`, so that a unit never leaves `c/`.
fn appendUnitComponent(out: borrow mut Vector<u8>, part: Slice<u8>) -> Result<void, AllocError> {
    if (sameText(part, "..")) {
        return appendText(out, "__");
    }
    return appendBytes(out, part);
}

/// A user file's unit (ADR 0082 §2.1, c-backend.md §2.4): `c/<package>/<path in the package>.c`, its extension
/// replaced; a file outside any package (a build of files) is in the package named `program`. Package names are unique
/// in a build and paths unique in a package, but a build of files can give two files one path: `unitPaths` makes them
/// unique, so that units never merge.
fn unitPath(source: borrow SourceText, program: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var out = copyBytes("c/".bytes())?;
    let package = if (source.package.length > 0) source.package.view() else program;
    if (package.length == 0 || sameText(package, ".")) {
        out.push('_')?;
    } else {
        appendUnitComponent(mut out, package)?;
    }
    let path = if (source.packagePath.length > 0) source.packagePath.view() else source.path.view();
    var parts = Vector<usize>.create(); // [start, end) of each component kept
    var start: usize = 0;
    for (k in 0..(path.length + 1)) {
        if (k == path.length || path[k] == '/' || path[k] == '\\') {
            let part = path[start..k];
            if (part.length > 0 && !sameText(part, ".")) {
                parts.push(start)?;
                parts.push(k)?;
            }
            start = k + 1;
        }
    }
    for (p in 0..(parts.length / 2)) {
        let part = path[parts[p * 2]..parts[p * 2 + 1]];
        var end = part.length;
        if (p * 2 + 2 == parts.length) {
            var dot = part.length;
            while (dot > 0 && part[dot - 1] != '.') {
                dot -= 1;
            }
            if (dot > 1) {
                end = dot - 1; // the extension goes
            }
        }
        out.push('/')?;
        appendUnitComponent(mut out, part[..end])?;
    }
    appendText(mut out, ".c")?;
    return Ok(out);
}

fn asciiLower(b: u8) -> u8 => if (b >= 'A' && b <= 'Z') b + 32 else b;

/// Whether two unit paths are the same ignoring ASCII letter case: one file on macOS's and Windows's file systems.
fn sameIgnoringCase(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (k in 0..a.length) {
        if (asciiLower(a[k]) != asciiLower(b[k])) {
            return false;
        }
    }
    return true;
}

/// Every user file's unit (ADR 0082 §2.1, §7; c-backend.md §2.4), by file, or empty for a library's file; and in
/// `caseClashes`, by file, the earlier file whose unit differs from it only in letter case, or none. `unitPath` alone
/// can give two files one path: two files outside the working directory with one name (diagnostics name each by its
/// file name), or `../x.cee` and `__/x.cee`. A path identical to an earlier file's gets `-2`, `-3`, … before `.c`,
/// the first that no earlier file's unit has, ignoring letter case: deterministic, in the order of the files.
fn unitPaths(
    c: borrow Checker,
    sources: borrow Vector<SourceText>,
    program: Slice<u8>,
    caseClashes: borrow mut Vector<u32>,
) -> Result<Vector<Vector<u8>>, AllocError> {
    var paths = Vector<Vector<u8>>.create();
    for (file in 0..sources.length) {
        caseClashes.push(none())?;
        if (file >= c.fileIsLibrary.length || c.fileIsLibrary[file]) {
            paths.push(Vector<u8>.create())?;
            continue;
        }
        let base = unitPath(sources[file], program)?;
        var identical = false;
        var differsInCase = none();
        for (a in 0..file) {
            if (paths[a].length == 0 || !sameIgnoringCase(paths[a].view(), base.view())) {
                continue;
            }
            if (sameBytes(paths[a].view(), base.view())) {
                identical = true;
            } else if (differsInCase == none()) {
                differsInCase = truncate<u32>(a);
            }
        }
        if (!identical) {
            caseClashes[file] = differsInCase;
            paths.push(base)?;
            continue;
        }
        let stem = base[..(base.length - 2)]; // without ".c"
        var number: u64 = 2;
        loop {
            var path = copyBytes(stem)?;
            path.push('-')?;
            appendDecimal(mut path, number)?;
            appendText(mut path, ".c")?;
            var taken = false;
            for (a in 0..file) {
                if (paths[a].length > 0 && sameIgnoringCase(paths[a].view(), path.view())) {
                    taken = true;
                }
            }
            if (!taken) {
                paths.push(path)?;
                break;
            }
            number += 1;
        }
    }
    return Ok(paths);
}

/// N0363 (ADR 0082 §2.1): two user files whose units' paths differ only in letter case (`unitPaths`). Reported at the
/// later file; true if one was.
fn reportUnitCaseClashes(
    c: borrow mut Checker,
    sources: borrow Vector<SourceText>,
    program: Slice<u8>,
) -> Result<bool, AllocError> {
    var clashes = Vector<u32>.create();
    let paths = unitPaths(c, sources, program, mut clashes)?;
    var found = false;
    for (b in 0..paths.length) {
        let first = clashes[b];
        if (first == none()) {
            continue;
        }
        var message = copyBytes("this file's C unit '".bytes())?;
        appendBytes(mut message, paths[b].view())?;
        appendText(mut message, "' and the unit '")?;
        appendBytes(mut message, paths[first as usize].view())?;
        appendText(mut message, "' of '")?;
        appendBytes(mut message, sources[first as usize].shownPath())?;
        appendText(mut message, "' differ only in letter case, so they would be one file on macOS and Windows")?;
        c.front.diagnostics.error(unitCaseClash(), truncate<u32>(b), 0, 0, message)?;
        found = true;
    }
    return Ok(found);
}

fn unitCaseClash() -> u32 => 363;

/// Each user file's unit (NameUnits): its path (`unitPaths`), or empty for a file without code.
fn nameUnits(
    e: borrow mut CEmitter,
    c: borrow Checker,
    sources: borrow Vector<SourceText>,
) -> Result<void, AllocError> {
    var clashes = Vector<u32>.create();
    let paths = unitPaths(c, sources, e.programName.view(), mut clashes)?;
    var names = Vector<Vector<u8>>.create();
    for (file in 0..c.filePaths.length) {
        let named = file < paths.length && e.fileIds[file] != none();
        names.push(if (named) copyBytes(paths[file].view())? else Vector<u8>.create())?;
    }
    e.unitNames = names;
    return Ok();
}

/// The unit a function is defined in (UnitOf): its CeeSafe file's, or ceesafe_instances.c for the libraries and instances.
fn unitOf(e: borrow CEmitter, c: borrow Checker, n: borrow NirProgram, f: u32) -> Result<Vector<u8>, AllocError> {
    let source = n.functions[f as usize].source;
    let file = c.hir.functions[source as usize].file;
    if (!e.split || isLibraryFunction(c, source) || functionIsInstantiation(c, source) ||
        (file as usize) >= e.unitNames.length || e.unitNames[file as usize].length == 0) {
        return copyBytes("ceesafe_instances.c".bytes());
    }
    return copyBytes(e.unitNames[file as usize].view());
}

fn isLineSpace(b: u8) -> bool => b == ' ' || b == '\t' || b == '\r';

/// The function a definition line defines (SplitFiles' pattern): a line not starting with `static `, `typedef `, `#`
/// or a space, whose first `(` follows an identifier starting with `cee`, with no `;` after it, ending `) {`.
fn definedNameRange(line: Slice<u8>) -> Range {
    let missing = Range { start: 0, count: 0 };
    if (line.length == 0 || line[0] == '#' || isLineSpace(line[0]) || line[0] == '\n' ||
        (line.length >= 7 && sameText(line[..7], "static ")) || (line.length >= 8 && sameText(line[..8], "typedef "))) {
        return missing;
    }
    var open = line.length;
    for (k in 0..line.length) {
        if (open == line.length && line[k] == '(') {
            open = k;
        }
    }
    if (open == line.length) {
        return missing;
    }
    var start = open;
    while (start > 0 && (isAsciiLetterOrDigit(line[start - 1]) || line[start - 1] == '_')) {
        start -= 1;
    }
    if (open - start < 3 || line[start] != 'c' || line[start + 1] != 'e' || line[start + 2] != 'e') {
        return missing;
    }
    for (k in open..line.length) {
        if (line[k] == ';') {
            return missing;
        }
    }
    var end = line.length;
    while (end > open && isLineSpace(line[end - 1])) {
        end -= 1;
    }
    if (end == open || line[end - 1] != '{') {
        return missing;
    }
    end -= 1;
    while (end > open && isLineSpace(line[end - 1])) {
        end -= 1;
    }
    if (end == open || line[end - 1] != ')') {
        return missing;
    }
    return Range { start: truncate<u32>(start), count: truncate<u32>(open - start) };
}

/// The split files (SplitFiles): every function a unit or ceesafe_instances.c defines is renamed with the program's name
/// by a `#define` in the header, so two programs linked into one image never collide.
fn splitFiles(e: borrow CEmitter, out: borrow mut Vector<CFile>) -> Result<void, AllocError> {
    var defined = Vector<Vector<u8>>.create();
    for (name in e.splitData.view()) {
        insertSorted(mut defined, copyBytes(name.view())?)?;
    }
    for (k in 1..e.files.length) {
        let text = e.files[k].text.view();
        var start: usize = 0;
        for (i in 0..(text.length + 1)) {
            if (i == text.length || text[i] == '\n') {
                let line = text[start..i];
                let name = definedNameRange(line);
                if (name.count > 0) {
                    insertSorted(
                        mut defined,
                        copyBytes(line[(name.start as usize)..((name.start + name.count) as usize)])?,
                    )?;
                }
                start = i + 1;
            }
        }
    }
    var program = Vector<u8>.create();
    appendIdentifierText(mut program, e.programName.view())?;
    var names = Vector<u8>.create();
    for (name in defined.view()) {
        appendText(mut names, "#define ")?;
        appendBytes(mut names, name.view())?;
        names.push(' ')?;
        var at = name.length;
        for (k in 0..name.length) {
            if (at == name.length && name[k] == '_') {
                at = k;
            }
        }
        let text = name.view();
        if (at == name.length) {
            appendBytes(mut names, text)?;
            names.push('_')?;
            appendBytes(mut names, program.view())?;
        } else {
            appendBytes(mut names, text[..(at + 1)])?;
            appendBytes(mut names, program.view())?;
            names.push('_')?;
            appendBytes(mut names, text[(at + 1)..])?;
        }
        names.push('\n')?;
    }
    var guard = copyBytes("CEESAFE_PROGRAM_".bytes())?;
    for (b in program.view()) {
        guard.push(if (b >= 'a' && b <= 'z') b - 32 else b)?;
    }
    appendText(mut guard, "_H")?;
    var header = copyBytes("#ifndef ".bytes())?;
    appendBytes(mut header, guard.view())?;
    appendText(mut header, "\n#define ")?;
    appendBytes(mut header, guard.view())?;
    header.push('\n')?;
    appendBytes(mut header, names.view())?;
    header.push('\n')?;
    appendBytes(mut header, e.files[0].text.view())?;
    appendText(mut header, "#endif\n")?;
    out.push(CFile { name: copyBytes("ceesafe_program.h".bytes())?, text: header })?;
    for (k in 1..e.files.length) {
        var text = copyBytes("/* Generated by ".bytes())?;
        appendText(mut text, compilerBanner())?;
        appendText(mut text, ". Do not edit. */\n#include \"ceesafe_program.h\"\n\n")?;
        appendBytes(mut text, e.files[k].text.view())?;
        out.push(CFile { name: copyBytes(e.files[k].name.view())?, text: text })?;
    }
    return Ok();
}
