// Async functions (type-system.md §40, ADR 0031): `await`, `Async.run`, and the rule that a call of an async fn is a
// task, which must be awaited, run or spawned. L1 A1: scopes, spawn, race, all and shield come in A2.

fn awaitOutsideAsync() -> u32 => 341;
fn taskNotAwaited() -> u32 => 342;
fn asyncPrimitiveOutsideLibrary() -> u32 => 345;

/// CeeSafe's own builtin functions, numbered after the generated ones (src/hir/builtins.cee): `Async.park()`, which
/// suspends the current task until the runtime wakes it (type-system.md §40.4).
fn bfAsyncPark() -> u32 => 1000;
/// `s.spawn(child)`: Builtin(AsyncSpawn, [site, the child's HIR function, the child closure]) (intermediate-representation.md §3).
fn bfAsyncSpawn() -> u32 => 1001;
/// The end of `await Async.scope(oom, body)`: Builtin(AsyncScopeWait, [site, oom]), the scope's Result<void, E>.
fn bfAsyncScopeWait() -> u32 => 1002;
/// `await Async.race(a, b)` and `all`: Builtin(AsyncJoin, [site, race (1) or all (0), a's HIR function, a, b's, b]),
/// which runs both and is the index of the one that returned first; then AsyncJoinResult [site, 0 or 1] moves each
/// child's result out, and lib/std's settle function makes the value (§40.4).
fn bfAsyncJoin() -> u32 => 1003;
fn bfAsyncJoinResult() -> u32 => 1004;
/// `await Async.blocking(body)`: Builtin(AsyncBlocking, [site, body's HIR function, body]), body's result.
fn bfAsyncBlocking() -> u32 => 1005;
/// `await Async.boxed(alloc, f(args))`: Builtin(AsyncBoxed, [the allocator's type, f, args…]), a Result<T, AllocError>.
fn bfAsyncBoxed() -> u32 => 1006;
/// The start of an `Async.scope` body: Eval(Builtin(AsyncScopeStart, [site])). It does nothing at run time; the
/// borrow checker ends what the scope's children held in the scope's previous run there (ADR 0033 §3.2).
fn bfAsyncScopeStart() -> u32 => 1007;
/// `Async.runWorkers(n, task)` (ADR 0038): BuiltinCall(AsyncRunWorkers, [n, RunTask(task)]), lowered to
/// Builtin(AsyncWorkers, [n]), which gives the next run n workers, then the run.
fn bfAsyncWorkers() -> u32 => 1008;
fn bfAsyncRunWorkers() -> u32 => 1009;

/// Whether `function` (a HirFunction) is an `async fn`.
fn isAsyncFunction(c: borrow Checker, function: u32) -> bool {
    if (function == none()) {
        return false;
    }
    if (c.hir.functions[function as usize].asyncInstanceOf != none()) {
        return true; // an async instance of an @effectsOf function (ADR 0037 §3.3)
    }
    let syntax = c.hir.functions[function as usize].syntax;
    return syntax != none() && (syntax as usize) < c.front.ast.functions.length &&
        c.front.ast.functions[syntax as usize].isAsync;
}

/// A call of `function` spanning `span`: a call of an async fn is a task, allowed only as the operand that
/// `checkAwait` or `Async.run` marked (N0342 elsewhere, §40.1).
fn checkTaskCall(c: borrow mut Checker, function: u32, span: Span) -> Result<void, AllocError> {
    if (!isAsyncFunction(c, function)) {
        return Ok();
    }
    if (c.taskStart == span.start && c.taskEnd == span.end) {
        c.taskStart = none();
        c.taskEnd = none();
        return Ok();
    }
    var message = Vector<u8>.create();
    appendText(mut message, "a call of the async fn ")?;
    appendQuotedName(mut message, c, c.hir.functions[function as usize].name)?;
    appendText(mut message, " is a task: await it, or pass it to 'Async.run' (type-system.md §40.1)")?;
    c.error(taskNotAwaited(), span.start, span.end, message)?;
    return Ok();
}

/// A call passing an async closure to an `@effectsOf` parameter (ADR 0037 §3.2): a task, as a call of an async fn.
fn checkSuspendingCall(c: borrow mut Checker, function: u32, span: Span) -> Result<void, AllocError> {
    if (c.taskStart == span.start && c.taskEnd == span.end) {
        c.taskStart = none();
        c.taskEnd = none();
        return Ok();
    }
    var message = Vector<u8>.create();
    appendText(mut message, "a call of ")?;
    appendQuotedName(mut message, c, c.hir.functions[function as usize].name)?;
    appendText(
        mut message,
        " with an async closure is a task: await it, or pass it to 'Async.run' (type-system.md §32.5, §40.1)",
    )?;
    c.error(taskNotAwaited(), span.start, span.end, message)?;
    return Ok();
}

/// Checks `operand` as a task: a call of an async fn. Returns the checked call, or none after an error.
fn checkTaskOperand(c: borrow mut Checker, operand: u32, expected: u32, what: StringView) -> Result<u32, AllocError> {
    let operandSpan = c.front.ast.exprSpans[operand as usize];
    let isCall = match (c.front.ast.exprs[operand as usize]) {
        ExprNode.Call(_, _) => true,
        _ => false,
    };
    let savedStart = c.taskStart;
    let savedEnd = c.taskEnd;
    if (isCall) {
        c.taskStart = operandSpan.start;
        c.taskEnd = operandSpan.end;
    }
    let call = synth(c, operand, expected)?;
    let consumed = isCall && c.taskStart == none();
    c.taskStart = savedStart;
    c.taskEnd = savedEnd;
    if (consumed) {
        return Ok(call);
    }
    if (c.typeOf(call) != c.types.error) {
        var message = Vector<u8>.create();
        appendText(mut message, "the operand of ")?;
        appendText(mut message, what)?;
        appendText(mut message, " must be a call of an async fn (type-system.md §40.2)")?;
        c.error(taskNotAwaited(), operandSpan.start, operandSpan.end, message)?;
    }
    return Ok(none());
}

/// `await e` (§40.2): only in an async fn's body; `e` a task; the value is the task's result.
fn checkAwait(c: borrow mut Checker, operand: u32, expected: u32, span: Span) -> Result<u32, AllocError> {
    if (!isAsyncFunction(c, c.function)) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'await' is allowed only in the body of an async fn or async closure (type-system.md §40.2)",
        )?;
        c.error(awaitOutsideAsync(), span.start, span.start + 5, message)?;
    } else if (c.deferDepth > 0) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "a deferred statement cannot 'await': it runs as the scope ends (type-system.md §40.2)",
        )?;
        c.error(awaitOutsideAsync(), span.start, span.start + 5, message)?;
    }
    let call = checkTaskOperand(c, operand, expected, "'await'")?;
    if (call == none()) {
        return c.errorResult(span.start, span.end);
    }
    let isCall = match (c.hir.exprs[call as usize]) {
        HirExpr.Call(_, _) => true,
        _ => false,
    };
    if (!isCall) {
        return Ok(call); // `Async.park()` or a scope: a suspension point of its own, not a task's call
    }
    let typ = c.typeOf(call);
    return c.expr(HirExpr.Await(call), typ, span.start, span.end);
}

/// `Async.member(…)` (§40.4). A1 has `Async.run(task)`.
fn checkAsyncCall(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    expected: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let memberIdent = c.front.ast.idents[member as usize];
    if (sameText(c.name(memberIdent.symbol), "park")) {
        return checkAsyncPark(c, arguments, span);
    }
    if (sameText(c.name(memberIdent.symbol), "scope") || sameText(c.name(memberIdent.symbol), "scopeIn")) {
        let withAllocator = sameText(c.name(memberIdent.symbol), "scopeIn");
        return checkAsyncScope(c, arguments, withAllocator, span);
    }
    if (sameText(c.name(memberIdent.symbol), "boxed")) {
        return checkAsyncBoxed(c, arguments, expected, span);
    }
    if (sameText(c.name(memberIdent.symbol), "race") || sameText(c.name(memberIdent.symbol), "all")) {
        let isRace = sameText(c.name(memberIdent.symbol), "race");
        return checkAsyncJoin(c, isRace, arguments, expected, span);
    }
    if (sameText(c.name(memberIdent.symbol), "shield")) {
        return checkAsyncShield(c, arguments, expected, span);
    }
    if (sameText(c.name(memberIdent.symbol), "blocking")) {
        return checkAsyncBlocking(c, arguments, expected, span);
    }
    if (sameText(c.name(memberIdent.symbol), "isCancelled") || sameText(c.name(memberIdent.symbol), "checkpoint")) {
        return checkCancellationCall(c, memberIdent.symbol, arguments, span);
    }
    if (sameText(c.name(memberIdent.symbol), "runWorkers")) {
        return checkRunWorkers(c, arguments, expected, span);
    }
    if (!sameText(c.name(memberIdent.symbol), "run")) {
        var message = Vector<u8>.create();
        appendText(mut message, "'Async' has no function ")?;
        appendQuotedName(mut message, c, memberIdent.symbol)?;
        appendText(
            mut message,
            "; use 'Async.run(f(…))' or 'await Async.scope(oom, (s) => { … })' (type-system.md §40.4)",
        )?;
        c.error(undefinedName(), memberIdent.start, memberIdent.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (arguments.count != 1) {
        var message = Vector<u8>.create();
        appendText(mut message, "'Async.run' takes one task, a call of an async fn")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let task = c.front.ast.at(arguments, 0);
    let call = checkTaskOperand(c, task, expected, "'Async.run'")?;
    if (call == none()) {
        return c.errorResult(span.start, span.end);
    }
    let typ = c.typeOf(call);
    return c.expr(HirExpr.RunTask(call), typ, span.start, span.end);
}

/// `Async.runWorkers(n, task)` (ADR 0038 §3.3): `Async.run` with n workers, the caller among them.
fn checkRunWorkers(c: borrow mut Checker, arguments: Range, expected: u32, span: Span) -> Result<u32, AllocError> {
    if (arguments.count != 2) {
        var message = Vector<u8>.create();
        appendText(mut message, "'Async.runWorkers' takes a number of workers and a task, a call of an async fn")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let u32Type = c.types.lookup("u32".bytes());
    let countSyntax = c.front.ast.at(arguments, 0);
    let count = checkExpr(c, countSyntax, u32Type)?;
    let task = c.front.ast.at(arguments, 1);
    let call = checkTaskOperand(c, task, expected, "'Async.runWorkers'")?;
    if (call == none() || c.isBottom(count)) {
        return c.errorResult(span.start, span.end);
    }
    let typ = c.typeOf(call);
    let run = c.expr(HirExpr.RunTask(call), typ, span.start, span.end)?;
    let values = [count, run];
    let list = c.hir.list(values[..])?;
    return c.expr(HirExpr.BuiltinCall(bfAsyncRunWorkers(), list), typ, span.start, span.end);
}

/// `await Async.park()` (§40.4): library code only (N0345), and only as `await`'s operand (N0342). The library's waiting
/// operations register what wakes the task with the runtime first.
fn checkAsyncPark(c: borrow mut Checker, arguments: Range, span: Span) -> Result<u32, AllocError> {
    let inLibrary = c.function != none() && c.hir.functions[c.function as usize].library;
    if (!inLibrary) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.park' is the library's primitive; wait through lib/std's operations (type-system.md §40.4)",
        )?;
        c.error(asyncPrimitiveOutsideLibrary(), span.start, span.end, message)?;
    }
    if (c.taskStart == span.start && c.taskEnd == span.end) {
        c.taskStart = none();
        c.taskEnd = none();
    } else {
        var message = Vector<u8>.create();
        appendText(mut message, "'Async.park()' suspends the task: write it as 'await Async.park()'")?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
    }
    if (arguments.count != 0) {
        var message = Vector<u8>.create();
        appendText(mut message, "'Async.park' takes no arguments")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
    }
    let voidType = c.types.voidType;
    return c.expr(HirExpr.BuiltinCall(bfAsyncPark(), emptyRange()), voidType, span.start, span.end);
}

/// Whether HIR expression `e` is `Async.park()`.
fn isParkCall(c: borrow Checker, e: u32) -> bool => match (c.hir.exprs[e as usize]) {
    HirExpr.BuiltinCall(function, _) => function == bfAsyncPark(),
    _ => false,
};

// ---- Scopes (type-system.md §40.5; ADR 0031 §3.3 and §6.6) ----

fn scopeCaptureConflict() -> u32 => 241;
fn scopeCapturesBodyLocal() -> u32 => 344;

/// An `Async.scope` body being checked: it is a block of the awaiting function (ADR 0031 §6.6), and `symbol` (its
/// parameter's name) is not a local: only `symbol.spawn(…)` may name it.
struct AsyncScopeContext {
    symbol: u32;
    site: u32;
    function: u32;         // the awaiting function
    errorType: u32;        // E
    resultType: u32;       // Result<void, E>, every child's and the scope's
    firstLocal: u32;       // the first HIR local declared in the body
    captured: Vector<u64>; // (local << 1) | mutable, for every capture of every child so far
}

/// `await Async.scope(oom, (s) => { … })`: the body is checked inline; its children are checked by `checkSpawn`.
fn checkAsyncScope(c: borrow mut Checker, all: Range, withAllocator: bool, span: Span) -> Result<u32, AllocError> {
    // `Async.scopeIn(alloc, oom, body)`: the allocator first, then as `Async.scope` (§40.5).
    var allocatorType = none();
    var arguments = all;
    if (withAllocator) {
        if (all.count != 3) {
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "'Async.scopeIn' takes an allocator, the error for a child that cannot be allocated, and a body (type-system.md §40.5)",
            )?;
            c.error(argumentCount(), span.start, span.end, message)?;
            checkArgumentsLoosely(c, all)?;
            return c.errorResult(span.start, span.end);
        }
        let allocatorSyntax = c.front.ast.at(all, 0);
        let allocatorSpan = c.front.ast.exprSpans[allocatorSyntax as usize];
        let synthesized = synth(c, allocatorSyntax, none())?;
        let allocatorValue = autoDeref(c, synthesized)?;
        if (c.isBottom(allocatorValue)) {
            return c.errorResult(span.start, span.end);
        }
        allocatorType = c.typeOf(allocatorValue);
        if (!checkBoxAllocator(c, allocatorType, allocatorSpan)?) {
            return c.errorResult(span.start, span.end);
        }
        arguments = Range { start: all.start + 1, count: 2 };
    }
    let awaited = c.taskStart == span.start && c.taskEnd == span.end;
    if (awaited) {
        c.taskStart = none();
        c.taskEnd = none();
    } else {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.scope' waits for its children: write it as 'await Async.scope(…)' (type-system.md §40.5)",
        )?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
    }
    let body = if (arguments.count == 2) match (c.front.ast.exprs[c.front.ast.at(arguments, 1) as usize]) {
        ExprNode.Closure(closure) => closure,
        _ => none(),
    } else none();
    let literal = if (body != none()) c.front.ast.closures[body as usize] else Closure {
        parameters: emptyRange(),
        block: none(),
        body: none(),
        isMove: false,
        isAsync: false,
    };
    if (body == none() || literal.parameters.count != 1 || literal.block == none() || literal.isMove ||
        literal.isAsync) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.scope' takes the error for a child that cannot be allocated and a body '(s) => { … }' (type-system.md §40.5)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let oomSyntax = c.front.ast.at(arguments, 0);
    let oom = synth(c, oomSyntax, none())?;
    let errorType = c.typeOf(oom);
    if (c.types.isBottom(errorType)) {
        return c.errorResult(span.start, span.end);
    }
    let voidType = c.types.voidType;
    let resultType = resultOf(c, voidType, errorType)?;
    let parameter = c.front.ast.closureParameters[c.front.ast.at(literal.parameters, 0) as usize];
    let site = c.asyncSites;
    c.asyncSites += 1;
    while (c.scopeAllocators.length <= site as usize) {
        c.scopeAllocators.push(none())?;
    }
    c.scopeAllocators[site as usize] = allocatorType;
    c.asyncScopes.push(AsyncScopeContext {
        symbol: c.front.ast.idents[parameter.name as usize].symbol,
        site: site,
        function: c.function,
        errorType: errorType,
        resultType: resultType,
        firstLocal: truncate<u32>(c.hir.locals.length), // HIR locals are numbered program-wide
        captured: Vector<u64>.create(),
    })?;
    // `break` and `continue` cannot leave the body (N0214); `return` and `?` neither (checkReturn, checkTry).
    let savedLoop = c.loopDepth;
    c.loopDepth = 0;
    let block = checkBlock(c, literal.block)?;
    c.loopDepth = savedLoop;
    c.asyncScopes.pop();
    return c.expr(HirExpr.AsyncScope(site, oom, block), resultType, span.start, span.end);
}

/// Whether a `return` or `?` here would leave an `Async.scope` body of the current function (ADR 0031 §6.6).
fn inScopeBody(c: borrow Checker) -> bool {
    for (scope in c.asyncScopes.view()) {
        if (scope.function == c.function) {
            return true;
        }
    }
    return false;
}

fn reportLeavingScopeBody(c: borrow mut Checker, span: Span, what: StringView) -> Result<void, AllocError> {
    var message = Vector<u8>.create();
    appendText(mut message, what)?;
    appendText(mut message, " cannot leave an 'Async.scope' body: its children may still run (type-system.md §40.5)")?;
    return c.error(loopControlOutsideLoop(), span.start, span.end, message);
}

/// The scope whose parameter `symbol` names, innermost first, if it belongs to the current function.
fn scopeNamed(c: borrow Checker, symbol: u32) -> u32 {
    var k = c.asyncScopes.length;
    while (k > 0) {
        k -= 1;
        if (c.asyncScopes[k].symbol == symbol && c.asyncScopes[k].function == c.function) {
            return truncate<u32>(k);
        }
    }
    return none();
}

/// `s.spawn(async () => …)` in a scope body: the child must be an async closure literal with result `Result<void, E>`.
/// Its captures follow the scope-loan rule (§40.5): no capture of the body's own locals (N0344), no two children
/// capturing one local where either changes it (N0241); `useOfCaptured` refuses the body's later uses.
fn checkSpawn(c: borrow mut Checker, scope: u32, arguments: Range, send: bool, span: Span) -> Result<u32, AllocError> {
    let literal = if (arguments.count == 1) match (c.front.ast.exprs[c.front.ast.at(arguments, 0) as usize]) {
        ExprNode.Closure(closure) =>
            if (c.front.ast.closures[closure as usize].isAsync &&
                c.front.ast.closures[closure as usize].parameters.count == 0) closure else none(),
        _ => none(),
    } else none();
    if (literal == none()) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'spawn' takes an async closure literal with no parameters: 's.spawn(async () => …)' (type-system.md §40.5)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let resultType = c.asyncScopes[scope as usize].resultType;
    let none0 = Vector<u32>.create();
    let callable = c.types.closureTo(none0.view(), resultType, maskEffects())?;
    let expected = c.types.referenceTo(callable, true)?; // a `borrow mut fn`: a child may change what it captures
    let argument = c.front.ast.at(arguments, 0);
    let argumentSpan = c.front.ast.exprSpans[argument as usize];
    let savedCopy = c.copyCaptures;
    c.copyCaptures = true;
    var closure = none();
    if (c.front.ast.closures[literal as usize].isMove) {
        // `async move`: the child owns what it captures, moved into its frame (ADR 0033 §3.3).
        let into = c.types.dynFunctionOf(none0.view(), resultType, maskEffects(), true, false)?;
        closure = checkClosureWith(c, literal, none(), into, true, argumentSpan)?;
    } else {
        closure = checkClosure(c, literal, expected, argumentSpan)?;
    }
    c.copyCaptures = savedCopy;
    let captures = match (c.hir.exprs[closure as usize]) {
        HirExpr.Closure(_, list) => list,
        _ => emptyRange(),
    };
    for (k in 0..captures.count) {
        let capture = c.hir.captures[captures.start as usize + k as usize];
        let mutable = match (capture.mode) {
            CaptureMode.Shared => false,
            CaptureMode.Copy => { continue; } // the environment holds a copy: no loan
            CaptureMode.Move => { continue; } // moved into the child: the move checker sees later uses
            _ => true,
        };
        let local = capture.local;
        let name = c.hir.locals[local as usize].name;
        if (local >= c.asyncScopes[scope as usize].firstLocal) {
            var message = Vector<u8>.create();
            appendText(mut message, "this child captures ")?;
            appendQuotedName(mut message, c, name)?;
            appendText(
                mut message,
                ", which ends with the scope's body while the child may still run; a child holds its own copy only of a Copy value it does not change and that holds no borrow (type-system.md §40.5)",
            )?;
            c.error(scopeCapturesBodyLocal(), argumentSpan.start, argumentSpan.end, message)?;
            continue;
        }
        var conflict = false;
        for (entry in c.asyncScopes[scope as usize].captured.view()) {
            if (truncate<u32>(entry >> 1) == local && (mutable || (entry & 1) != 0)) {
                conflict = true;
            }
        }
        if (conflict) {
            var message = Vector<u8>.create();
            appendText(mut message, "this child captures ")?;
            appendQuotedName(mut message, c, name)?;
            appendText(
                mut message,
                if (mutable) " mutably, but an earlier child of this scope captures it too (type-system.md §40.5)" else ", but an earlier child of this scope changes it (type-system.md §40.5)",
            )?;
            c.error(scopeCaptureConflict(), argumentSpan.start, argumentSpan.end, message)?;
        }
        c.asyncScopes[scope as usize].captured.push(((local as u64) << 1) | (if (mutable) 1u64 else 0u64))?;
    }
    let site = c.asyncScopes[scope as usize].site;
    if (send && !checkSendChild(c, scope, site, captures, argumentSpan)?) {
        return c.errorResult(span.start, span.end);
    }
    let voidType = c.types.voidType;
    let spawn = c.expr(HirExpr.Spawn(site, closure), voidType, span.start, span.end)?;
    if (send) {
        c.sendSpawns.push(spawn)?;
    }
    return Ok(spawn);
}

/// `s.spawnSend(child)` (ADR 0038 §3.1): the child may run on another worker, so what it is given must be safe there,
/// by `Thread.both`'s rule (§38.6): a capture it reads needs `Share`, one it changes `Send`, references counting by
/// their target, and no closures; its error type must be `Send`; and its frame comes from the system heap.
fn checkSendChild(
    c: borrow mut Checker,
    scope: u32,
    site: u32,
    captures: Range,
    span: Span,
) -> Result<bool, AllocError> {
    var ok = true;
    let allocator = c.scopeAllocators[site as usize];
    if (allocator != none() && builtinItemIndex(c, allocator) != 2) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "a 'spawnSend' child's frame is freed on the worker that ran it, so it comes from the system heap; this scope's allocator is ",
        )?;
        appendQuotedType(mut message, c, allocator)?;
        appendText(mut message, ": use 'spawn', or 'Async.scope' (ADR 0038)")?;
        c.error(notSend(), span.start, span.end, message)?;
        ok = false;
    }
    for (k in 0..captures.count) {
        let capture = c.hir.captures[(captures.start + k) as usize];
        let local = c.hir.locals[capture.local as usize];
        let t = if (capture.field != none()) c.types.fields[capture.field as usize].typ else local.typ;
        let mutably = isMutableCapture(capture.mode);
        let pointee = c.types.info(t).pointee;
        if (c.types.is(t, TypeKind.Closure) || (pointee != none() && c.types.is(pointee, TypeKind.Closure))) {
            var message = Vector<u8>.create();
            appendText(mut message, "this child captures ")?;
            appendQuotedName(mut message, c, local.name)?;
            appendText(
                mut message,
                ", a closure: a 'spawnSend' child may run on another thread, which cannot call it (type-system.md §38.6, ADR 0038)",
            )?;
            c.error(notSend(), span.start, span.end, message)?;
            ok = false;
        } else if (!c.types.isForkSafe(t, mutably)?) {
            var message = Vector<u8>.create();
            appendText(mut message, if (mutably) "this child changes " else "this child reads ")?;
            appendQuotedName(mut message, c, local.name)?;
            appendText(mut message, ", a ")?;
            appendQuotedType(mut message, c, t)?;
            appendText(
                mut message,
                if (mutably) ", which is not Send: a 'spawnSend' child may change it from another thread (type-system.md §38.6, ADR 0038)" else ", which is not Share: a 'spawnSend' child may read it from another thread (type-system.md §38.6, ADR 0038)",
            )?;
            c.error(notSend(), span.start, span.end, message)?;
            ok = false;
        }
    }
    let errorType = c.asyncScopes[scope as usize].errorType;
    if (!c.types.isSendType(errorType)?) {
        var message = Vector<u8>.create();
        appendText(mut message, "a 'spawnSend' child's error, a ")?;
        appendQuotedType(mut message, c, errorType)?;
        appendText(
            mut message,
            ", is not Send: it may come from another thread (type-system.md §38.1, ADR 0038)",
        )?;
        c.error(notSend(), span.start, span.end, message)?;
        ok = false;
    }
    return Ok(ok);
}

/// A use of `local` in a scope body after a child captured it (§40.5): the child may run until the scope returns.
fn checkUseOfCaptured(c: borrow mut Checker, local: u32, span: Span) -> Result<void, AllocError> {
    for (scope in c.asyncScopes.view()) {
        if (scope.function != c.function) {
            continue;
        }
        for (entry in scope.captured.view()) {
            if (truncate<u32>(entry >> 1) == local) {
                var message = Vector<u8>.create();
                appendQuotedName(mut message, c, c.hir.locals[local as usize].name)?;
                appendText(
                    mut message,
                    " is captured by a child of this scope, which may run until the scope returns (type-system.md §40.5)",
                )?;
                return c.error(scopeCaptureConflict(), span.start, span.end, message);
            }
        }
    }
    return Ok();
}

/// An async closure anywhere but as `spawn`'s argument (§40.3).
fn misplacedAsyncClosure(c: borrow mut Checker, span: Span) -> Result<u32, AllocError> {
    var message = Vector<u8>.create();
    appendText(
        mut message,
        "an async closure is a task: pass it to 's.spawn(…)' in an 'Async.scope' body (type-system.md §40.3)",
    )?;
    c.error(taskNotAwaited(), span.start, span.end, message)?;
    return c.errorResult(span.start, span.end);
}

/// `Async.isCancelled()` and `Async.checkpoint(cancelled)` (§40.4, §40.7): calls of lib/std's AsyncControl<E>.
fn checkCancellationCall(c: borrow mut Checker, member: u32, arguments: Range, span: Span) -> Result<u32, AllocError> {
    let isCheckpoint = sameText(c.name(member), "checkpoint");
    if (arguments.count != (if (isCheckpoint) 1u32 else 0u32)) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            if (isCheckpoint) "'Async.checkpoint' takes the error to return if the task is cancelled" else "'Async.isCancelled' takes no arguments",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var values = Vector<u32>.create();
    var typeArguments = Vector<u32>.create();
    if (isCheckpoint) {
        let argument = c.front.ast.at(arguments, 0);
        let value = synth(c, argument, none())?;
        if (c.types.isBottom(c.typeOf(value))) {
            return c.errorResult(span.start, span.end);
        }
        typeArguments.push(c.typeOf(value))?;
        values.push(value)?;
    } else {
        typeArguments.push(c.types.lookup("u8".bytes()))?;
    }
    let function = libraryFunction(c, "AsyncControl", typeArguments.view(), member, span)?;
    if (function == none()) {
        return c.errorResult(span.start, span.end);
    }
    let list = c.hir.list(values.view())?;
    let returnType = c.hir.functions[function as usize].returnType;
    return c.expr(HirExpr.Call(function, list), returnType, span.start, span.end);
}

/// `await Async.shield(ms, async () => …)` (§40.7): the body awaited inline between lib/std's AsyncControl.enterShield
/// and leaveShield, so the library's waits ignore cancellation for at most `ms` milliseconds.
fn checkAsyncShield(c: borrow mut Checker, arguments: Range, expected: u32, span: Span) -> Result<u32, AllocError> {
    let awaited = c.taskStart == span.start && c.taskEnd == span.end;
    if (awaited) {
        c.taskStart = none();
        c.taskEnd = none();
    } else {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.shield' runs its body as a task: write 'await Async.shield(ms, async () => …)' (type-system.md §40.7)",
        )?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
    }
    let literal = if (arguments.count == 2) match (c.front.ast.exprs[c.front.ast.at(arguments, 1) as usize]) {
        ExprNode.Closure(closure) =>
            if (c.front.ast.closures[closure as usize].isAsync &&
                c.front.ast.closures[closure as usize].parameters.count == 0) closure else none(),
        _ => none(),
    } else none();
    if (literal == none()) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.shield' takes the milliseconds and an async closure literal: 'Async.shield(ms, async () => …)' (type-system.md §40.7)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let u64Type = c.types.lookup("u64".bytes());
    let msSyntax = c.front.ast.at(arguments, 0);
    let ms = checkExpr(c, msSyntax, u64Type)?;
    let bodySyntax = c.front.ast.at(arguments, 1);
    let bodySpan = c.front.ast.exprSpans[bodySyntax as usize];
    // The body's result: the expected type; else, for a block body, Result<void, AsyncError>, a shield's usual
    // cleanup (§40.4); an expression body's own type.
    var result = if (expected != none() && !c.types.isBottom(expected)) expected else none();
    if (result == none() && c.front.ast.closures[literal as usize].block != none()) {
        let asyncErrorSymbol = c.intern("AsyncError")?;
        let asyncError = match (c.item(asyncErrorSymbol)) {
            Entity.Enum(index) => c.enums[index as usize].typ,
            _ => none(),
        };
        if (asyncError != none()) {
            let voidType = c.types.voidType;
            result = resultOf(c, voidType, asyncError)?;
        }
    }
    var closureType = none();
    if (result != none()) {
        let none0 = Vector<u32>.create();
        let callable = c.types.closureTo(none0.view(), result, maskEffects())?;
        closureType = c.types.referenceTo(callable, true)?;
    }
    let closure = checkClosure(c, literal, closureType, bodySpan)?;
    let function = match (c.hir.exprs[closure as usize]) {
        HirExpr.Closure(f, _) => f,
        _ => none(),
    };
    if (function == none()) {
        return c.errorResult(span.start, span.end);
    }
    let resultType = c.hir.functions[function as usize].returnType;
    var closureArguments = Vector<u32>.create();
    if (c.hir.functions[function as usize].closureEnvironment != none()) {
        closureArguments.push(closure)?; // its environment's address (§36.2)
    }
    let call = c.expr(HirExpr.Call(function, c.hir.list(closureArguments.view())?), resultType, span.start, span.end)?;
    let body = c.expr(HirExpr.Await(call), resultType, span.start, span.end)?;
    let u8Type = c.types.lookup("u8".bytes());
    let enterName = c.intern("enterShield")?;
    let leaveName = c.intern("leaveShield")?;
    var typeArguments = Vector<u32>.create();
    typeArguments.push(u8Type)?;
    let enterFunction = libraryFunction(c, "AsyncControl", typeArguments.view(), enterName, span)?;
    let leaveFunction = libraryFunction(c, "AsyncControl", typeArguments.view(), leaveName, span)?;
    if (enterFunction == none() || leaveFunction == none()) {
        return c.errorResult(span.start, span.end);
    }
    var enterArguments = Vector<u32>.create();
    enterArguments.push(ms)?;
    let voidType = c.types.voidType;
    let enter = c.expr(
        HirExpr.Call(enterFunction, c.hir.list(enterArguments.view())?),
        voidType,
        span.start,
        span.end,
    )?;
    let none1 = Vector<u32>.create();
    let leave = c.expr(HirExpr.Call(leaveFunction, c.hir.list(none1.view())?), voidType, span.start, span.end)?;
    return c.expr(HirExpr.AsyncShield(enter, body, leave), resultType, span.start, span.end);
}

/// The (ok, err) types of a Result type, or (none, none).
fn resultParts(c: borrow Checker, t: u32) -> Vector<u32> {
    var parts = Vector<u32>.create();
    if (t != none() && isResultType(c, t)) {
        let definition = borrow c.types.enums[c.types.info(t).enumDef as usize];
        parts.push(definition.resultOk)!;
        parts.push(definition.resultErr)!;
    }
    return parts;
}

/// The async closure literal of argument `k`, with no parameters, or none.
fn asyncLiteralArgument(c: borrow Checker, arguments: Range, k: u32) -> u32 {
    if (k >= arguments.count) {
        return none();
    }
    return match (c.front.ast.exprs[c.front.ast.at(arguments, k) as usize]) {
        ExprNode.Closure(closure) =>
            if (c.front.ast.closures[closure as usize].isAsync &&
                c.front.ast.closures[closure as usize].parameters.count == 0) closure else none(),
        _ => none(),
    };
}

/// A child of race or all checked against `result` (none: inferred, for an expression body).
fn checkJoinChild(c: borrow mut Checker, arguments: Range, k: u32, result: u32) -> Result<u32, AllocError> {
    let syntax = c.front.ast.at(arguments, k);
    let span = c.front.ast.exprSpans[syntax as usize];
    var closureType = none();
    if (result != none()) {
        let none0 = Vector<u32>.create();
        let callable = c.types.closureTo(none0.view(), result, maskEffects())?;
        closureType = c.types.referenceTo(callable, true)?;
    }
    let literal = asyncLiteralArgument(c, arguments, k);
    if (c.front.ast.closures[literal as usize].isMove) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "a race or all child is the caller's: write 'async () => …'; 'async move' is for 's.spawn' (type-system.md §40.5)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return checkClosure(c, literal, closureType, span);
}

/// `await Async.race(a, b)` and `await Async.all(a, b)` (§40.4; ADR 0031 §6.4): two children whose frames are the
/// caller's, so nothing is allocated. Their result type comes from the expected type; else from `a`'s expression body;
/// else, for `all`, `Result<void, AsyncError>`. They run at once, so they may not capture one local where either
/// changes it (N0241).
fn checkAsyncJoin(
    c: borrow mut Checker,
    isRace: bool,
    arguments: Range,
    expected: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let what: StringView = if (isRace) "'Async.race'" else "'Async.all'";
    let awaited = c.taskStart == span.start && c.taskEnd == span.end;
    if (awaited) {
        c.taskStart = none();
        c.taskEnd = none();
    } else {
        var message = Vector<u8>.create();
        appendText(mut message, what)?;
        appendText(mut message, " runs its children as tasks: write it after 'await' (type-system.md §40.4)")?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
    }
    if (arguments.count != 2 || asyncLiteralArgument(c, arguments, 0) == none() ||
        asyncLiteralArgument(c, arguments, 1) == none()) {
        var message = Vector<u8>.create();
        appendText(mut message, what)?;
        appendText(
            mut message,
            " takes two async closure literals: '(async () => …, async () => …)' (type-system.md §40.4)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    // The children's result type.
    var childResult = none();
    let expectedParts = resultParts(c, if (expected != none() && !c.types.isBottom(expected)) expected else none());
    if (expectedParts.length == 2) {
        if (!isRace) {
            childResult = expected;
        } else if (c.types.is(expectedParts[0], TypeKind.Struct)) {
            let definition = c.types.info(expectedParts[0]).structDef;
            let typeArguments = c.types.structs[definition as usize].typeArguments;
            if (typeArguments.count == 1) {
                let value = c.types.listAt(typeArguments, 0);
                childResult = resultOf(c, value, expectedParts[1])?;
            }
        }
    }
    let firstLiteral = asyncLiteralArgument(c, arguments, 0);
    if (childResult == none() && !isRace && c.front.ast.closures[firstLiteral as usize].block != none()) {
        let asyncErrorSymbol = c.intern("AsyncError")?;
        let asyncError = match (c.item(asyncErrorSymbol)) {
            Entity.Enum(index) => c.enums[index as usize].typ,
            _ => none(),
        };
        if (asyncError != none()) {
            let voidType = c.types.voidType;
            childResult = resultOf(c, voidType, asyncError)?;
        }
    }
    let first = checkJoinChild(c, arguments, 0, childResult)?;
    let firstFunction = match (c.hir.exprs[first as usize]) {
        HirExpr.Closure(f, _) => f,
        _ => none(),
    };
    if (firstFunction == none()) {
        return c.errorResult(span.start, span.end);
    }
    if (childResult == none()) {
        childResult = c.hir.functions[firstFunction as usize].returnType;
    }
    let parts = resultParts(c, childResult);
    if (parts.length != 2 || (!isRace && !c.types.is(parts[0], TypeKind.Void))) {
        var message = Vector<u8>.create();
        appendText(mut message, what)?;
        appendText(
            mut message,
            if (isRace) "'s children return a 'Result<T, E>': give the race an expected 'Result<Raced<T>, E>' type, or the first child an expression body (type-system.md §40.4)" else "'s children return a 'Result<void, E>' (type-system.md §40.4)",
        )?;
        c.error(closureTypeUnknown(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let second = checkJoinChild(c, arguments, 1, childResult)?;
    let secondFunction = match (c.hir.exprs[second as usize]) {
        HirExpr.Closure(f, _) => f,
        _ => none(),
    };
    if (secondFunction == none()) {
        return c.errorResult(span.start, span.end);
    }
    // The two run at once: the scope-loan rule between them (§40.5).
    let firstCaptures = match (c.hir.exprs[first as usize]) {
        HirExpr.Closure(_, list) => list,
        _ => emptyRange(),
    };
    let secondCaptures = match (c.hir.exprs[second as usize]) {
        HirExpr.Closure(_, list) => list,
        _ => emptyRange(),
    };
    for (i in 0..firstCaptures.count) {
        let a = c.hir.captures[firstCaptures.start as usize + i as usize];
        for (j in 0..secondCaptures.count) {
            let b = c.hir.captures[secondCaptures.start as usize + j as usize];
            let aMutable = match (a.mode) {
                CaptureMode.Shared => false,
                CaptureMode.Copy => { continue; },
                _ => true,
            };
            let bMutable = match (b.mode) {
                CaptureMode.Shared => false,
                CaptureMode.Copy => { continue; },
                _ => true,
            };
            if (a.local == b.local && (aMutable || bMutable)) {
                let secondSpan = c.front.ast.exprSpans[c.front.ast.at(arguments, 1) as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "both children capture ")?;
                appendQuotedName(mut message, c, c.hir.locals[a.local as usize].name)?;
                appendText(mut message, ", and one changes it, but they run at once (type-system.md §40.4)")?;
                c.error(scopeCaptureConflict(), secondSpan.start, secondSpan.end, message)?;
            }
        }
    }
    var typeArguments = Vector<u32>.create();
    if (isRace) {
        typeArguments.push(parts[0])?;
    }
    typeArguments.push(parts[1])?;
    let settleName = c.intern("settle")?;
    let settle = libraryFunction(
        c,
        if (isRace) "AsyncRaceJoin" else "AsyncAllJoin",
        typeArguments.view(),
        settleName,
        span,
    )?;
    if (settle == none()) {
        return c.errorResult(span.start, span.end);
    }
    let site = c.asyncSites;
    c.asyncSites += 1;
    let resultType = c.hir.functions[settle as usize].returnType;
    return c.expr(HirExpr.AsyncJoin(site, isRace, first, second, settle), resultType, span.start, span.end);
}

/// `await Async.blocking(() => …)` (§40.4): a sync closure literal that runs on a worker thread while the task waits.
/// Its captures follow Thread.both's rule (§38.6) and its result must be Send (N0334). Its effects are the worker's,
/// so the task gets only `suspend`.
fn checkAsyncBlocking(c: borrow mut Checker, arguments: Range, expected: u32, span: Span) -> Result<u32, AllocError> {
    let awaited = c.taskStart == span.start && c.taskEnd == span.end;
    if (awaited) {
        c.taskStart = none();
        c.taskEnd = none();
    } else {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.blocking' waits for its worker: write 'await Async.blocking(() => …)' (type-system.md §40.4)",
        )?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
    }
    let literal = if (arguments.count == 1) match (c.front.ast.exprs[c.front.ast.at(arguments, 0) as usize]) {
        ExprNode.Closure(closure) => if (!c.front.ast.closures[closure as usize].isAsync &&
            !c.front.ast.closures[closure as usize].isMove &&
            c.front.ast.closures[closure as usize].parameters.count == 0) closure else none(),
        _ => none(),
    } else none();
    if (literal == none()) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.blocking' takes a closure literal with no parameters: 'Async.blocking(() => …)' (type-system.md §40.4)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let syntax = c.front.ast.at(arguments, 0);
    let syntaxSpan = c.front.ast.exprSpans[syntax as usize];
    var closureType = none();
    if (expected != none() && !c.types.isBottom(expected)) {
        let none0 = Vector<u32>.create();
        let callable = c.types.closureTo(none0.view(), expected, allEffects())?;
        closureType = c.types.referenceTo(callable, true)?;
    }
    let closure = checkClosure(c, literal, closureType, syntaxSpan)?;
    var function = none();
    var captures = emptyRange();
    match (c.hir.exprs[closure as usize]) {
        HirExpr.Closure(f, list) => {
            function = f;
            captures = list;
        }
        _ => {}
    }
    if (function == none()) {
        return c.errorResult(span.start, span.end);
    }
    var ok = true;
    for (j in 0..captures.count) {
        let capture = c.hir.captures[(captures.start + j) as usize];
        let local = c.hir.locals[capture.local as usize];
        let t = if (capture.field != none()) c.types.fields[capture.field as usize].typ else local.typ;
        let mutably = isMutableCapture(capture.mode);
        if (!c.types.isForkSafe(t, mutably)?) {
            var message = Vector<u8>.create();
            appendText(mut message, if (mutably) "this closure changes " else "this closure reads ")?;
            appendQuotedName(mut message, c, local.name)?;
            appendText(mut message, ", a ")?;
            appendQuotedType(mut message, c, t)?;
            appendText(
                mut message,
                if (mutably) ", which is not Send: a worker thread would change it (type-system.md §40.4)" else ", which is not Share: a worker thread would read it (type-system.md §40.4)",
            )?;
            c.error(notSend(), syntaxSpan.start, syntaxSpan.end, message)?;
            ok = false;
        }
    }
    let resultType = c.hir.functions[function as usize].returnType;
    if (!c.types.is(resultType, TypeKind.Void) && !c.types.isSendType(resultType)?) {
        var message = Vector<u8>.create();
        appendText(mut message, "the result of 'Async.blocking', a ")?;
        appendQuotedType(mut message, c, resultType)?;
        appendText(mut message, ", is not Send: it comes from a worker thread (type-system.md §40.4)")?;
        c.error(notSend(), syntaxSpan.start, syntaxSpan.end, message)?;
        ok = false;
    }
    if (!ok) {
        return c.errorResult(span.start, span.end);
    }
    let site = c.asyncSites;
    c.asyncSites += 1;
    return c.expr(HirExpr.AsyncBlocking(site, closure), resultType, span.start, span.end);
}

/// `await Async.boxed(alloc, f(…))` (§40.1): the task's frame comes from `alloc` and is freed when it returns, so the
/// awaiting frame holds only a pointer and recursion through it is allowed (no N0343). Its value is `Result<T,
/// AllocError>`: `Err` if the frame cannot be allocated.
fn checkAsyncBoxed(c: borrow mut Checker, arguments: Range, expected: u32, span: Span) -> Result<u32, AllocError> {
    let awaited = c.taskStart == span.start && c.taskEnd == span.end;
    if (awaited) {
        c.taskStart = none();
        c.taskEnd = none();
    } else {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.boxed' runs a task: write 'await Async.boxed(alloc, f(…))' (type-system.md §40.1)",
        )?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
    }
    if (arguments.count != 2) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'Async.boxed' takes an allocator and a task: 'Async.boxed(alloc, f(…))' (type-system.md §40.1)",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let allocatorSyntax = c.front.ast.at(arguments, 0);
    let allocatorSpan = c.front.ast.exprSpans[allocatorSyntax as usize];
    let synthesized = synth(c, allocatorSyntax, none())?;
    let allocatorValue = autoDeref(c, synthesized)?;
    if (c.isBottom(allocatorValue)) {
        return c.errorResult(span.start, span.end);
    }
    let allocatorType = c.typeOf(allocatorValue);
    if (!checkBoxAllocator(c, allocatorType, allocatorSpan)?) {
        return c.errorResult(span.start, span.end);
    }
    let task = c.front.ast.at(arguments, 1);
    let call = checkTaskOperand(c, task, none(), "'Async.boxed'")?;
    if (call == none()) {
        return c.errorResult(span.start, span.end);
    }
    let isCall = match (c.hir.exprs[call as usize]) {
        HirExpr.Call(_, _) => true,
        _ => false,
    };
    if (!isCall) {
        var message = Vector<u8>.create();
        appendText(mut message, "'Async.boxed' boxes a call of an async fn (type-system.md §40.1)")?;
        c.error(taskNotAwaited(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let allocError = c.allocErrorType;
    let taskResult = c.typeOf(call);
    let resultType = resultOf(c, taskResult, allocError)?;
    return c.expr(HirExpr.AsyncBoxed(allocatorType, call), resultType, span.start, span.end);
}
