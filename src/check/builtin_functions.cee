// The built-in functions of ADR 0075: `assert` and `panic` (§2.8), `replace` and `swap` (§2.11); ADR 0087's
// `debugAssert` (§2.5). Each is a HirExpr.BuiltinCall; a user item of the same name shadows it (Lookup finds package
// items first).

/// `assert(condition)` or `assert(condition, message)`: void; panics when the condition is false.
fn checkAssert(c: borrow mut Checker, arguments: Range, span: Span) -> Result<u32, AllocError> {
    if (arguments.count != 1 && arguments.count != 2) {
        return builtinArity(c, arguments, span, "write 'assert(condition)' or 'assert(condition, message)'");
    }
    var values = Vector<u32>.create();
    let boolType = c.types.boolType;
    let conditionSyntax = c.front.ast.at(arguments, 0);
    values.push(checkExpr(c, conditionSyntax, boolType)?)?;
    if (arguments.count == 2) {
        let view = c.types.stringView;
        let messageSyntax = c.front.ast.at(arguments, 1);
        values.push(checkExpr(c, messageSyntax, view)?)?;
    }
    for (v in values.view()) {
        if (c.isBottom(v)) {
            return c.errorResult(span.start, span.end);
        }
    }
    let list = c.hir.list(values.view())?;
    let voidType = c.types.voidType;
    return c.expr(HirExpr.BuiltinCall(bfAssert(), list), voidType, span.start, span.end);
}

/// `debugAssert(condition)` or `debugAssert(condition, message)` (ADR 0087 §2.5): checked as `assert` is, in every
/// build; it records the locals its arguments declare, which the effect checker's N0360 lets it change.
fn checkDebugAssert(c: borrow mut Checker, arguments: Range, span: Span) -> Result<u32, AllocError> {
    if (arguments.count != 1 && arguments.count != 2) {
        return builtinArity(
            c,
            arguments,
            span,
            "write 'debugAssert(condition)' or 'debugAssert(condition, message)'",
        );
    }
    let function = c.function;
    var firstLocal: u32 = 0;
    if (function != none()) {
        firstLocal = truncate<u32>(c.hir.functions[function as usize].locals.length);
    }
    var values = Vector<u32>.create();
    let boolType = c.types.boolType;
    let conditionSyntax = c.front.ast.at(arguments, 0);
    values.push(checkExpr(c, conditionSyntax, boolType)?)?;
    if (arguments.count == 2) {
        let view = c.types.stringView;
        let messageSyntax = c.front.ast.at(arguments, 1);
        values.push(checkExpr(c, messageSyntax, view)?)?;
    }
    for (v in values.view()) {
        if (c.isBottom(v)) {
            return c.errorResult(span.start, span.end);
        }
    }
    var endLocal = firstLocal;
    if (function != none()) {
        endLocal = truncate<u32>(c.hir.functions[function as usize].locals.length);
    }
    let list = c.hir.list(values.view())?;
    let voidType = c.types.voidType;
    let call = c.expr(HirExpr.BuiltinCall(bfDebugAssert(), list), voidType, span.start, span.end)?;
    c.hir.debugAsserts.push(HirDebugAssert { expr: call, firstLocal: firstLocal, endLocal: endLocal })?;
    return Ok(call);
}

/// `panic(message)`: never returns.
fn checkPanic(c: borrow mut Checker, arguments: Range, span: Span) -> Result<u32, AllocError> {
    if (arguments.count != 1) {
        return builtinArity(c, arguments, span, "write 'panic(message)'");
    }
    let view = c.types.stringView;
    let messageSyntax = c.front.ast.at(arguments, 0);
    let message = checkExpr(c, messageSyntax, view)?;
    if (c.isBottom(message)) {
        return c.errorResult(span.start, span.end);
    }
    let values = [message];
    let list = c.hir.list(values[..])?;
    let never = c.types.never;
    return c.expr(HirExpr.BuiltinCall(bfPanic(), list), never, span.start, span.end);
}

/// `replace(mut place, value) -> T` and `swap(mut a, mut b)`: the place is never left empty, so neither changes a
/// move rule. Both lower to an exchange of two referents (bfSwap).
fn checkReplaceOrSwap(c: borrow mut Checker, builtin: u32, arguments: Range, span: Span) -> Result<u32, AllocError> {
    let isReplace = builtin == builtinReplace();
    if (arguments.count != 2) {
        return builtinArity(
            c,
            arguments,
            span,
            if (isReplace) "write 'replace(mut place, value)'" else "write 'swap(mut a, mut b)'",
        );
    }
    let first = c.front.ast.at(arguments, 0);
    let second = c.front.ast.at(arguments, 1);
    let place = mutablePlaceArgument(c, first)?;
    if (c.isBottom(place)) {
        checkArgumentsLoosely(c, Range { start: arguments.start + 1, count: 1 })?;
        return c.errorResult(span.start, span.end);
    }
    let typ = c.types.info(c.typeOf(place)).pointee;
    var other = none();
    if (isReplace) {
        other = checkExpr(c, second, typ)?;
    } else {
        other = mutablePlaceArgument(c, second)?;
        if (!c.isBottom(other) && c.types.info(c.typeOf(other)).pointee != typ) {
            var message = Vector<u8>.create();
            appendText(mut message, "'swap' exchanges two places of one type: ")?;
            appendQuotedType(mut message, c, typ)?;
            appendText(mut message, " and ")?;
            appendQuotedType(mut message, c, c.types.info(c.typeOf(other)).pointee)?;
            let s = c.front.ast.exprSpans[second as usize];
            c.error(typeMismatch(), s.start, s.end, message)?;
            return c.errorResult(span.start, span.end);
        }
    }
    if (c.isBottom(other)) {
        return c.errorResult(span.start, span.end);
    }
    let values = [place, other];
    let list = c.hir.list(values[..])?;
    let result = if (isReplace) typ else c.types.voidType;
    return c.expr(HirExpr.BuiltinCall(if (isReplace) bfReplace() else bfSwap(), list), result, span.start, span.end);
}

/// `arrayFrom(f)` (ADR 0198 §2.2): `arrayFrom<T, N>(f: borrow mut fn(usize) -> T) -> [T; N]`, `f(0)` to `f(N - 1)` in
/// order, each result moved into its element. `T` and `N` come from the explicit list or the expected type.
fn checkArrayFrom(
    c: borrow mut Checker,
    typeArguments: Range,
    arguments: Range,
    expected: u32,
    nameSpan: Span,
    span: Span,
) -> Result<u32, AllocError> {
    var arrayType = none();
    if (typeArguments.count == 2) {
        let elementSyntax = c.front.ast.at(typeArguments, 0);
        let lengthSyntax = c.front.ast.at(typeArguments, 1);
        let lengthExpr = match (c.front.ast.types[lengthSyntax as usize]) {
            TypeNode.Constant(e) => e,
            TypeNode.Named(q) => if (q.parts.count == 1) nameAsExpression(c, q)? else none(),
            _ => none(),
        };
        if (lengthExpr == none()) {
            let lengthSpan = c.front.ast.typeSpans[lengthSyntax as usize];
            arrayLengthError(c, lengthSpan)?;
            checkArgumentsLoosely(c, arguments)?;
            return c.errorResult(span.start, span.end);
        }
        arrayType = resolveArrayType(c, elementSyntax, lengthExpr, false)?;
    } else if (typeArguments.count == 0 && expected != none() && c.types.is(expected, TypeKind.Array) &&
        !c.types.isUnsized(expected)) {
        arrayType = expected;
    } else {
        let inferred = typeArguments.count == 0;
        var message = Vector<u8>.create();
        appendText(
            mut message,
            if (inferred) "'arrayFrom' needs the array's type: give it where the value goes ('let a: [T; N] = arrayFrom(f)') or write 'arrayFrom<T, N>(f)' (type-system.md §16.2)"
                else "'arrayFrom' takes two type arguments, the element type and the length: 'arrayFrom<T, N>(f)' (type-system.md §16.2)",
        )?;
        c.error(cannotInferTypeArguments(), nameSpan.start, nameSpan.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.isBottom(arrayType)) {
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (arguments.count != 1) {
        return builtinArity(c, arguments, span, "write 'arrayFrom(f)', where 'f' is a 'borrow mut fn(usize) -> T'");
    }
    let element = c.types.info(arrayType).element;
    let usize = c.types.usize;
    let parameters = [usize];
    let callable = c.types.closureTo(parameters[..], element, allEffects())?;
    let closureType = c.types.referenceTo(callable, true)?;
    let functionSyntax = c.front.ast.at(arguments, 0);
    let function = checkExpr(c, functionSyntax, closureType)?;
    if (c.isBottom(function)) {
        return c.errorResult(span.start, span.end);
    }
    let values = [function];
    let list = c.hir.list(values[..])?;
    return c.expr(HirExpr.BuiltinCall(bfArrayFrom(), list), arrayType, span.start, span.end);
}

/// `mut p` as an argument of `replace` or `swap`: a mutable borrow of the place `p` (N0247 if it is not one, N0249
/// without `mut`).
fn mutablePlaceArgument(c: borrow mut Checker, syntax: u32) -> Result<u32, AllocError> {
    let span = c.front.ast.exprSpans[syntax as usize];
    let operand = match (c.front.ast.exprs[syntax as usize]) {
        ExprNode.MutArg(o) => o,
        _ => none(),
    };
    if (operand == none()) {
        let value = synth(c, syntax, none())?;
        if (c.isBottom(value)) {
            return Ok(value);
        }
        var message = Vector<u8>.create();
        appendText(mut message, "this argument is a place the call changes; write 'mut' before it")?;
        c.error(mutArgumentMismatch(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let value = synth(c, operand, none())?;
    if (c.isBottom(value)) {
        return Ok(value);
    }
    // A binding of type `borrow mut T` (a parameter, a `let`): the place it changes is the referent, as an assignment
    // to it writes the referent, so the reference itself is the argument, reborrowed (cee-proxy's F15). Only a bare
    // binding: a field of reference type (`mut h.r`) is still the field.
    let t = c.typeOf(value);
    let operandSpan = c.front.ast.exprSpans[operand as usize];
    match (c.hir.exprs[value as usize]) {
        HirExpr.LocalRef(_) => {
            if (c.types.is(t, TypeKind.Reference) && c.types.info(t).mutableReference) {
                let referent = c.expr(
                    HirExpr.Deref(value),
                    c.types.info(t).pointee,
                    operandSpan.start,
                    operandSpan.end,
                )?;
                return borrowPlace(c, referent, true, operandSpan);
            }
        }
        _ => {}
    }
    return borrowPlace(c, value, true, operandSpan);
}

fn builtinArity(c: borrow mut Checker, arguments: Range, span: Span, usage: StringView) -> Result<u32, AllocError> {
    var message = Vector<u8>.create();
    appendText(mut message, usage)?;
    c.error(argumentCount(), span.start, span.end, message)?;
    checkArgumentsLoosely(c, arguments)?;
    return c.errorResult(span.start, span.end);
}
