// C interoperability (the reference's DeclareExternBlock, DeclareImportedStruct, CheckLayoutUse, ResolveFunctionPointerType,
// CheckFunctionPointerPart, FunctionAddress, CheckPointerCall, CheckCName, IsFfiSafe, IsCPointee, IsVolatileCell,
// CheckSignatureIsFfiSafe and CheckForeignInterfaces): P3 S7b (type-system.md §28, §29.5, §31, §33, §34).

fn notFfiSafe() -> u32 => 291;
fn unionMemberType() -> u32 => 346;
fn invalidCName() -> u32 => 292;

/// A struct or array type written where a value of it needs a reference layout, checked once fields are known (§33.1).
struct LayoutUse {
    typ: u32;
    start: u32;
    end: u32;
    file: u32;
}

/// A C-laid-out type by value anywhere but a field or a box's contents is N0294 (CheckLayoutUse, §33.1).
fn checkLayoutUse(c: borrow mut Checker, typ: u32, span: Span) -> Result<void, AllocError> {
    if (!c.types.isCLaidOut(typ, 0)) {
        return Ok();
    }
    var message = Vector<u8>.create();
    appendQuotedType(mut message, c, typ)?;
    appendText(
        mut message,
        " holds C state, which the C compiler lays out and which never moves: it can only be a field or a box's contents, made in place by 'Box.createIn' (type-system.md §33.1)",
    )?;
    return c.error(importedTypeByValue(), span.start, span.end, message);
}

/// The layout uses recorded before members were resolved (Check, after member resolution).
fn checkLayoutUses(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (k in 0..c.layoutUses.length) {
        let use = c.layoutUses[k];
        {
            let fileToSet = use.file;
            c.setFile(fileToSet);
        }
        checkLayoutUse(c, use.typ, Span { start: use.start, end: use.end })?;
    }
    c.setFile(saved);
    return Ok();
}

// ---- C names (§28.2) ----

fn isCKeyword(name: Slice<u8>) -> bool {
    let words =
        "auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while bool true false main NULL alignas alignof noreturn static_assert thread_local";
    return hasWord(words, name);
}

fn isAsciiLetter(b: u8) -> bool => (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z');
fn isAsciiUpper(b: u8) -> bool => b >= 'A' && b <= 'Z';
fn isAsciiDigit(b: u8) -> bool => b >= '0' && b <= '9';

fn startsWithText(name: Slice<u8>, prefix: StringView) -> bool =>
    name.length >= prefix.length && sameText(name[..prefix.length], prefix);

/// A C name the reference may define or declare (CheckCName, §28.2): an identifier, no keyword, not reserved by C or by the reference's C
/// (c-backend §2.1). N0292 otherwise.
fn checkCName(c: borrow mut Checker, name: Slice<u8>, span: Span, what: StringView) -> Result<bool, AllocError> {
    var valid = name.length > 0 && (isAsciiLetter(name[0]) || name[0] == '_');
    for (b in name) {
        if (!(isAsciiLetter(b) || isAsciiDigit(b) || b == '_')) {
            valid = false;
        }
    }
    var reason: u32 = 0;
    if (!valid) {
        reason = 1;
    } else if (isCKeyword(name)) {
        reason = 2;
    } else if (startsWithText(name, "__") || (name.length > 1 && name[0] == '_' && isAsciiUpper(name[1]))) {
        reason = 3;
    } else if ((!isLibraryFile(c) && // the library calls the runtime by its names (lib/std, §38.3)
        (startsWithText(name, "ceesafe_") || startsWithText(name, "cee_") || startsWithText(name, "CEE_"))) ||
        (name.length > 3 && startsWithText(name, "cee") && isAsciiUpper(name[3]))) {
        reason = 4;
    }
    if (reason == 0) {
        return Ok(true);
    }
    var message = Vector<u8>.create();
    appendText(mut message, what)?;
    appendText(mut message, " '")?;
    appendBytes(mut message, name)?;
    appendText(mut message, "' ")?;
    appendText(
        mut message,
        match (reason) {
            1 => "is not a C identifier",
            2 => "is a C keyword or a name C programs depend on",
            3 => "is reserved by the C standard",
            _ => "is reserved for the CeeSafe runtime and generated code (c-backend.md §2.1)",
        },
    )?;
    appendText(mut message, " (type-system.md §28.2)")?;
    c.error(invalidCName(), span.start, span.end, message)?;
    return Ok(false);
}

// ---- FFI-safe types (§28.3) ----

/// `Volatile<T>` from lib/core (IsVolatileCell, §29.2): its one field has `T`'s layout.
fn isVolatileCell(c: borrow Checker, typ: u32) -> bool {
    let definition = c.types.info(typ).structDef;
    if (definition == none() || c.types.structs[definition as usize].typeArguments.count != 1) {
        return false;
    }
    let file = c.types.structs[definition as usize].file;
    return file != none() && c.fileIsLibrary[file as usize] && startsWithText(c.types.name(typ), "Volatile<");
}

/// Can a value of `typ` cross to C (IsFfiSafe)?
fn isFfiSafe(c: borrow Checker, typ: u32, isResult: bool, inStruct: bool) -> bool {
    let t = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Integer) || c.types.is(typ, TypeKind.Float) || c.types.is(typ, TypeKind.Bool) ||
        c.types.is(typ, TypeKind.Error) || c.types.is(typ, TypeKind.FunctionPointer) ||
        c.types.is(typ, TypeKind.CChar)) {
        return true; // `CChar` by value: C's `char` (ADR 0080 §3.5)
    }
    if (c.types.is(typ, TypeKind.RawPointer)) {
        return isCPointee(c, t.pointee);
    }
    if (c.types.is(typ, TypeKind.Void)) {
        return isResult;
    }
    if (c.types.is(typ, TypeKind.Struct)) {
        if (inStruct && isVolatileCell(c, typ)) {
            let field = c.types.structs[t.structDef as usize].fields[0];
            return isFfiSafe(c, c.types.fields[field as usize].typ, false, true);
        }
        if (inStruct && c.types.structs[t.structDef as usize].isImported) {
            return true; // C state by value (ADR 0029)
        }
        if (inStruct && atomicFieldInteger(c, typ) != none()) {
            return true; // its integer, which C accesses atomically (ADR 0041 §3.1)
        }
        return c.types.structs[t.structDef as usize].isReprC;
    }
    if (c.types.is(typ, TypeKind.Array) && inStruct) {
        return isFfiSafe(c, t.element, false, true); // a C array member (ADR 0029)
    }
    if (c.types.is(typ, TypeKind.Enum)) {
        return t.enumDef != none() && c.types.enums[t.enumDef as usize].repr != none() && !inStruct;
    }
    return false;
}

/// A pointee C can name (IsCPointee): an integer, bool, void, CChar, a @repr(C) or imported struct, or such a pointer.
fn isCPointee(c: borrow Checker, typ: u32) -> bool {
    if (c.types.is(typ, TypeKind.Integer) || c.types.is(typ, TypeKind.Float) || c.types.is(typ, TypeKind.Bool) ||
        c.types.is(typ, TypeKind.Void) || c.types.is(typ, TypeKind.CChar) || c.types.is(typ, TypeKind.Error)) {
        return true;
    }
    if (c.types.is(typ, TypeKind.Struct)) {
        let s = c.types.info(typ).structDef;
        return c.types.structs[s as usize].isReprC || c.types.structs[s as usize].isImported;
    }
    if (c.types.is(typ, TypeKind.RawPointer)) {
        return isCPointee(c, c.types.info(typ).pointee);
    }
    return false;
}

// ---- C function pointers (§29.5) ----

/// `extern "C" fn(T…) -> R` (ResolveFunctionPointerType).
fn resolveFunctionPointerType(
    c: borrow mut Checker,
    abi: Range,
    parameters: Range,
    result: u32,
    span: Span,
) -> Result<u32, AllocError> {
    if (!sameText(c.front.ast.textOf(abi), "C")) {
        var message = Vector<u8>.create();
        appendText(mut message, "unsupported ABI \"")?;
        appendBytes(mut message, c.front.ast.textOf(abi))?;
        appendText(mut message, "\": only extern \"C\" function pointers exist (type-system.md §29.5)")?;
        c.error(invalidAttribute(), span.start, span.end, message)?;
        return Ok(c.types.error);
    }
    var ok = true;
    var types = Vector<u32>.create();
    for (k in 0..parameters.count) {
        let syntax = c.front.ast.at(parameters, k);
        let parameter = c.resolveType(syntax, false)?;
        let parameterSpan = c.front.ast.typeSpans[syntax as usize];
        if (!checkFunctionPointerPart(c, parameter, parameterSpan, false)?) {
            ok = false;
        }
        types.push(parameter)?;
    }
    let resultType = if (result == none()) c.types.voidType else c.resolveType(result, true)?;
    let resultSpan = if (result == none()) span else c.front.ast.typeSpans[result as usize];
    if (!checkFunctionPointerPart(c, resultType, resultSpan, true)?) {
        ok = false;
    }
    return if (ok) c.types.functionPointerTo(types.view(), resultType) else Ok(c.types.error);
}

/// A parameter or result of a C function pointer (CheckFunctionPointerPart): FFI-safe, and no enum (N0291).
fn checkFunctionPointerPart(c: borrow mut Checker, typ: u32, span: Span, isResult: bool) -> Result<bool, AllocError> {
    if (c.types.isBottom(typ)) {
        return Ok(false);
    }
    let isEnum = c.types.is(typ, TypeKind.Enum);
    if (isEnum || !isFfiSafe(c, typ, isResult, false)) {
        var message = Vector<u8>.create();
        if (isEnum) {
            appendText(mut message, "a C function pointer cannot take or return the @repr enum ")?;
            appendQuotedType(mut message, c, typ)?;
            appendText(mut message, ": a value from C could not be checked (type-system.md §29.5)")?;
        } else {
            appendText(mut message, "a C function pointer cannot take or return a ")?;
            appendQuotedType(mut message, c, typ)?;
            appendText(mut message, " (type-system.md §28.3)")?;
        }
        c.error(notFfiSafe(), span.start, span.end, message)?;
        return Ok(false);
    }
    return Ok(true);
}

/// The C address of an extern, exported or `@callback` function where a function pointer type is expected
/// (FunctionAddress, §29.5).
fn functionAddress(c: borrow mut Checker, function: u32, expected: u32, span: Span) -> Result<u32, AllocError> {
    let f = borrow c.hir.functions[function as usize];
    let syntax = f.syntax;
    let name = f.name;
    let returnType = f.returnType;
    let isExtern = c.front.ast.functions[syntax as usize].isExtern;
    if (!isExtern && !f.exported && !containsU32(c.callbacks, syntax)) {
        var message = Vector<u8>.create();
        appendText(mut message, "function ")?;
        appendQuotedName(mut message, c, name)?;
        appendText(
            mut message,
            " has no C address: only extern \"C\", @export and @callback functions can be C function pointers (type-system.md §29.5, §34.1)",
        )?;
        c.error(notFfiSafe(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (isExtern && c.front.ast.functions[syntax as usize].variadicStart != none()) {
        var message = Vector<u8>.create();
        appendText(mut message, "C function ")?;
        appendQuotedName(mut message, c, name)?;
        appendText(mut message, " takes '...', which no C function pointer type spells; call it (ADR 0041 §3.3)")?;
        c.error(notFfiSafe(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    var parameters = Vector<u32>.create();
    for (p in c.hir.functions[function as usize].parameters.view()) {
        parameters.push(c.hir.locals[p as usize].typ)?;
    }
    let actual = c.types.functionPointerTo(parameters.view(), returnType)?;
    if (actual != expected) {
        var message = Vector<u8>.create();
        appendText(mut message, "expected ")?;
        appendQuotedType(mut message, c, expected)?;
        appendText(mut message, ", found ")?;
        appendQuotedType(mut message, c, actual)?;
        c.error(typeMismatch(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return c.expr(HirExpr.FunctionAddress(function), expected, span.start, span.end);
}

/// A call through a C function pointer (CheckPointerCall, §29.5): unsafe.
fn checkPointerCall(c: borrow mut Checker, callee: u32, arguments: Range, span: Span) -> Result<u32, AllocError> {
    let typ = c.typeOf(callee);
    let parameters = c.types.info(typ).parameters;
    let result = c.types.info(typ).result;
    let unsafeOk = requireUnsafe(c, span, "calling through a C function pointer".bytes())?;
    if (arguments.count != parameters.count) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " takes ")?;
        appendDecimal(mut message, parameters.count as u64)?;
        appendText(mut message, " argument(s) but ")?;
        appendDecimal(mut message, arguments.count as u64)?;
        appendText(mut message, " were supplied")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var values = Vector<u32>.create();
    values.push(callee)?;
    var bottom = false;
    for (k in 0..arguments.count) {
        let syntax = c.front.ast.at(arguments, k);
        let parameter = c.types.listAt(parameters, k);
        let argument = checkArgument(c, syntax, parameter)?;
        if (c.isBottom(argument)) {
            bottom = true;
        }
        values.push(argument)?;
    }
    if (!unsafeOk || bottom) {
        return c.errorResult(span.start, span.end);
    }
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.BuiltinCall(bfCallPointer(), list), result, span.start, span.end);
}

// ---- Extern blocks (§28.2, §31) ----

/// `extern "C" { … }` (DeclareExternBlock): its headers, and each function declared like a top-level one, without a
/// body. Its imported structs are declared with the structs (declareImportedStruct).
fn declareExternBlock(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    var abi = emptyRange();
    var functions = emptyRange();
    var structs = emptyRange();
    match (entry.kind) {
        ItemKind.Extern(a, f, s) => {
            abi = a;
            functions = f;
            structs = s;
        }
        _ => {}
    }
    var known = Vector<u32>.create();
    knownAttributes(c, entry.attributes, "an 'extern' block", "header", mut known)?;
    let header = if (known.length > 0) known[0] else none();
    if (!sameText(c.front.ast.textOf(abi), "C")) {
        let abiIdent = c.front.ast.idents[entry.name as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "unsupported ABI \"")?;
        appendBytes(mut message, c.front.ast.textOf(abi))?;
        appendText(mut message, "\": only extern \"C\" exists (type-system.md §28.2)")?;
        c.error(invalidAttribute(), abiIdent.start, abiIdent.end, message)?;
        return Ok();
    }
    if (header != none()) {
        let a = c.front.ast.attributes[header as usize];
        var allStrings = a.arguments.count > 0;
        for (k in 0..a.arguments.count) {
            let isString = match (c.front.ast.exprs[c.front.ast.at(a.arguments, k) as usize]) {
                ExprNode.StringLiteral(_) => true,
                _ => false,
            };
            if (!isString) {
                allStrings = false;
            }
        }
        if (!allStrings) {
            attributeError(c, header, "'@header' takes the headers to include as strings: '@header(\"path.h\")'")?;
        }
        for (k in 0..a.arguments.count) {
            let text = match (c.front.ast.exprs[c.front.ast.at(a.arguments, k) as usize]) {
                ExprNode.StringLiteral(t) => t,
                _ => Range { start: 0, count: 0xFFFFFFFF },
            };
            if (text.count == 0xFFFFFFFF) {
                continue;
            }
            var path = Vector<u8>.create();
            appendBytes(mut path, c.front.ast.textOf(text))?;
            var badPath = path.length == 0;
            for (b in path.view()) {
                if (b == '"' || b == '\\' || b == '\n' || b == '\r') {
                    badPath = true;
                }
            }
            if (badPath) {
                var message = Vector<u8>.create();
                appendText(mut message, "'")?;
                appendBytes(mut message, path.view())?;
                appendText(
                    mut message,
                    "' cannot be written in a C '#include \"…\"': a header path is non-empty, without quotes, backslashes or line breaks (type-system.md §31.1)",
                )?;
                attributeErrorBytes(c, header, message.view())?;
            } else {
                var present = false;
                for (h in c.headers.view()) {
                    if (sameBytes(h.view(), path.view())) {
                        present = true;
                    }
                }
                if (!present) {
                    c.headers.push(path)?;
                }
            }
        }
    } else if (structs.count > 0) {
        let first = c.front.ast.items[c.front.ast.at(structs, 0) as usize];
        let id = c.front.ast.idents[first.name as usize];
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "an 'extern' block that imports C types or constants needs '@header(\"…\")' naming the headers that define them (type-system.md §31.1)",
        )?;
        c.error(invalidAttribute(), id.start, id.end, message)?;
    }
    for (k in 0..structs.count) {
        let member = c.front.ast.at(structs, k);
        declareExternConstant(c, member)?;
        declareExternStatic(c, member)?;
    }
    for (k in 0..functions.count) {
        let f = c.front.ast.at(functions, k);
        let decl = c.front.ast.functions[f as usize];
        var fnKnown = Vector<u32>.create();
        knownAttributes(c, decl.attributes, "a C function", "effects constant cname cfg", mut fnKnown)?;
        readEffectAttributes(c, f, fnKnown.view())?;
        var problem: u32 = 0;
        if (decl.body != none() || decl.expressionBody != none()) {
            problem = 1;
        } else if (receiverIndex(decl.receiver) != 0) {
            problem = 2;
        } else if (decl.typeParameters.count > 0 || decl.regionParameters.count > 0) {
            problem = 3;
        } else if (decl.isUnsafe) {
            problem = 4;
        } else if (decl.variadicStart != none() && decl.parameters.count == 0) {
            problem = 5;
        }
        let id = c.front.ast.idents[decl.name as usize];
        if (problem != 0) {
            var message = Vector<u8>.create();
            appendText(mut message, "C function ")?;
            appendQuotedName(mut message, c, id.symbol)?;
            appendText(
                mut message,
                match (problem) {
                    1 => " cannot have a body; it is defined in C (type-system.md §28.2)",
                    2 => " cannot have a 'this' parameter (type-system.md §28.2)",
                    3 => " cannot be generic (type-system.md §28.2)",
                    5 => " needs a parameter before '...', as C does (ADR 0041 §3.3)",
                    _ => " is unsafe to call already; leave out 'unsafe' (type-system.md §28.2)",
                },
            )?;
            c.error(invalidAttribute(), id.start, id.end, message)?;
            continue;
        }
        // Declare(fn): the reserved and duplicate names, then the function.
        if (isReservedName(c, decl.name)?) {
            continue;
        }
        if (isDeclared(c, id.symbol)) {
            var message = Vector<u8>.create();
            appendText(mut message, "'")?;
            appendBytes(mut message, c.name(id.symbol))?;
            appendText(mut message, "' is already defined")?;
            c.error(duplicateItem(), id.start, id.end, message)?;
            continue;
        }
        let function = declareFunction(c, f, none())?;
        ownItem(c, id.symbol, Entity.Function(function))?;
        // `@cname("symbol")` (ADR 0080 §3.5): its C symbol, when its CeeSafe name must differ (a struct of that name).
        for (attribute in fnKnown.view()) {
            if (sameText(attributeName(c, attribute), "cfg")) {
                // `@cfg("X")` (ADR 0080 §3.3): a C function some builds lack; its uses must be where `X` holds.
                let cfgText = attributeString(c, attribute)?;
                let switchMacro = withoutBang(cfgText.view());
                let a = c.front.ast.attributes[attribute as usize];
                if (cfgText.length == 0) {
                    attributeError(
                        c,
                        attribute,
                        "'@cfg' takes the C macro's name as a string: '@cfg(\"CONFIG_DEBUG\")'",
                    )?;
                } else if (checkCName(
                    c,
                    switchMacro,
                    Span { start: a.start, end: a.end },
                    "the configuration macro",
                )?) {
                    c.hir.functions[function as usize].cfgName = c.hir.addText(cfgText.view())?;
                }
                continue;
            }
            if (!sameText(attributeName(c, attribute), "cname")) {
                continue;
            }
            let a = c.front.ast.attributes[attribute as usize];
            var text = Range { start: 0, count: 0xFFFFFFFF };
            if (a.arguments.count == 1) {
                match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                    ExprNode.StringLiteral(t) => { text = t; }
                    _ => {}
                }
            }
            if (text.count == 0xFFFFFFFF || text.count == 0) {
                attributeError(c, attribute, "'@cname' takes the C function's name as a string: '@cname(\"name\")'")?;
                continue;
            }
            c.hir.functions[function as usize].exportName = c.hir.addText(c.front.ast.textOf(text))?;
        }
    }
    return Ok();
}

/// A struct in an `extern "C"` block (DeclareImportedStruct, §31.1): a C type imported from a header, with no the reference
/// layout.
fn declareImportedStruct(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    let s = match (entry.kind) {
        ItemKind.Struct(index) => c.front.ast.structs[index as usize],
        _ => { return Ok(); }
    };
    let generic = s.typeParameters.count > 0 || s.regionParameters.count > 0;
    var problem: u32 = 0;
    if (generic) {
        problem = 1;
    } else if (s.functions.count > 0) {
        problem = 2;
    } else if (s.dropBlock != none()) {
        problem = 3;
    }
    let id = c.front.ast.idents[entry.name as usize];
    if (problem != 0) {
        var message = Vector<u8>.create();
        appendText(mut message, "imported C type ")?;
        appendQuotedName(mut message, c, id.symbol)?;
        appendText(
            mut message,
            match (problem) {
                1 => " cannot be generic; its definition is the header's (type-system.md §31.1)",
                2 => " cannot have methods; its definition is the header's (type-system.md §31.1)",
                _ => " cannot have a 'drop' block; its definition is the header's (type-system.md §31.1)",
            },
        )?;
        c.error(invalidAttribute(), id.start, id.end, message)?;
        if (generic) {
            return Ok();
        }
    }
    declareStruct(c, item)?;
    let index = ownStructEntry(c, item);
    if (index == none()) {
        return Ok();
    }
    let definition = c.types.info(c.structs[index as usize].typ).structDef;
    c.types.structs[definition as usize].isImported = true;
    c.types.structs[definition as usize].isNonCopy = true; // no value of it exists in the reference (§31.2)
    c.types.structs[definition as usize].isUnion = s.isUnion;
    var spelling = Vector<u8>.create();
    appendText(mut spelling, if (s.isUnion) "union " else "struct ")?;
    appendBytes(mut spelling, c.name(id.symbol))?;
    var known = Vector<u32>.create();
    knownAttributes(c, entry.attributes, "an imported C type", "ctype", mut known)?;
    for (attribute in known.view()) {
        let a = c.front.ast.attributes[attribute as usize];
        var text = Range { start: 0, count: 0xFFFFFFFF };
        if (a.arguments.count == 1) {
            match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                ExprNode.StringLiteral(t) => { text = t; }
                _ => {}
            }
        }
        if (text.count == 0xFFFFFFFF) {
            attributeError(c, attribute, "'@ctype' takes the C type's name as a string: '@ctype(\"name_t\")'")?;
            continue;
        }
        var name = Vector<u8>.create();
        appendBytes(mut name, c.front.ast.textOf(text))?;
        if (checkCName(c, name.view(), Span { start: a.start, end: a.end }, "the C type name")?) {
            spelling = name;
        }
    }
    c.types.structs[definition as usize].hasCSpelling = true;
    c.types.structs[definition as usize].cSpelling = c.types.addName(spelling)?;
    return Ok();
}

/// `enum name: I;` in an `extern "C"` block (ADR 0079, §31.6): an imported C enum, an integer type of its own.
/// `const NAME: T = v;` in an `extern "C"` block (ADR 0080 §3.1, type-system.md §28.2): an ordinary constant, whose
/// value the generated C asserts against C's `NAME`, or against the C expression of its `@cvalue`.
fn declareExternConstant(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    var typ = none();
    var value = none();
    match (entry.kind) {
        ItemKind.Const(t, v) => {
            typ = t;
            value = v;
        }
        _ => { return Ok(); }
    }
    let id = c.front.ast.idents[entry.name as usize];
    var known = Vector<u32>.create();
    knownAttributes(c, entry.attributes, "a C constant", "cvalue", mut known)?;
    var expression = Vector<u8>.create();
    appendBytes(mut expression, c.name(id.symbol))?;
    var byName = true;
    for (attribute in known.view()) {
        let a = c.front.ast.attributes[attribute as usize];
        var text = Range { start: 0, count: 0xFFFFFFFF };
        if (a.arguments.count == 1) {
            match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                ExprNode.StringLiteral(t) => { text = t; }
                _ => {}
            }
        }
        var bad = text.count == 0xFFFFFFFF || text.count == 0;
        if (!bad) {
            for (b in c.front.ast.textOf(text)) {
                if (b == '"' || b == '\\' || b == '\n' || b == '\r') {
                    bad = true;
                }
            }
        }
        if (bad) {
            attributeError(
                c,
                attribute,
                "'@cvalue' takes a C constant expression as a string, without quotes, backslashes or line breaks: '@cvalue(\"sizeof(struct stat)\")' (ADR 0080 §3.1)",
            )?;
            return Ok();
        }
        expression = Vector<u8>.create();
        appendBytes(mut expression, c.front.ast.textOf(text))?;
        byName = false;
    }
    if (byName && !checkCName(c, expression.view(), Span { start: id.start, end: id.end }, "a C constant's name")?) {
        return Ok();
    }
    if (value == none()) {
        // `const NAME: T;`: C's value, read at run time (ADR 0080 §3.1). It is a read-only static whose C initialiser
        // is the macro (or the `@cvalue` expression), a C constant expression.
        if (isReservedName(c, entry.name)? || reportDuplicate(c, id)?) {
            return Ok();
        }
        let before = c.hir.statics.length;
        declareStatic(c, item, false, typ)?;
        if (c.hir.statics.length == before) {
            return Ok();
        }
        let k = c.hir.statics.length - 1;
        c.hir.statics[k].cInitializer = c.hir.addText(expression.view())?; // C data, even if refused below
        let t = c.hir.statics[k].typ;
        let pointer = c.types.is(t, TypeKind.RawPointer) && c.types.is(c.types.info(t).pointee, TypeKind.CChar);
        if (!c.types.is(t, TypeKind.Integer) && !c.types.is(t, TypeKind.Bool) && !pointer && t != c.types.error) {
            let span = c.front.ast.typeSpans[typ as usize];
            var message = Vector<u8>.create();
            appendText(mut message, "a C constant without a value is an integer, 'bool' or '*CChar' (a string ")?;
            appendText(mut message, "macro) (ADR 0080 §3.1)")?;
            c.error(notFfiSafe(), span.start, span.end, message)?;
        }
        return Ok();
    }
    let before = c.hir.constants.length;
    declare(c, item)?;
    if (c.hir.constants.length == before) {
        return Ok(); // a duplicate or reserved name, reported
    }
    let k = c.hir.constants.length - 1;
    let t = c.hir.constants[k].typ;
    if (!c.types.is(t, TypeKind.Integer) && !c.types.is(t, TypeKind.Bool) && t != c.types.error) {
        let span = c.front.ast.typeSpans[typ as usize];
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "a C constant is an integer (an imported C enum among them) or 'bool' (ADR 0080 §3.1)",
        )?;
        c.error(notFfiSafe(), span.start, span.end, message)?;
        return Ok();
    }
    c.hir.constants[k].checked = true;
    c.hir.constants[k].cExpression = c.hir.addText(expression.view())?;
    return Ok();
}

/// A `cfg` condition's macro: `X` of `!X` (ADR 0080 §3.3).
fn withoutBang(text: Slice<u8>) -> Slice<u8> => if (text.length > 0 && text[0] == '!') text[1..] else text;

/// The one string argument of an attribute, or empty.
fn attributeString(c: borrow Checker, attribute: u32) -> Result<Vector<u8>, AllocError> {
    var text = Vector<u8>.create();
    let a = c.front.ast.attributes[attribute as usize];
    if (a.arguments.count == 1) {
        match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
            ExprNode.StringLiteral(t) => { appendBytes(mut text, c.front.ast.textOf(t))?; }
            _ => {}
        }
    }
    return Ok(text);
}

/// Reports `id` already declared (N0201), as Declare does: true when it is.
fn reportDuplicate(c: borrow mut Checker, id: Ident) -> Result<bool, AllocError> {
    if (!isDeclared(c, id.symbol)) {
        return Ok(false);
    }
    var message = Vector<u8>.create();
    appendText(mut message, "'")?;
    appendBytes(mut message, c.name(id.symbol))?;
    appendText(mut message, "' is already defined")?;
    c.error(duplicateItem(), id.start, id.end, message)?;
    return Ok(true);
}

/// `static NAME: T;` and `static mut NAME: T;` in an `extern "C"` block (ADR 0080 §3.2): C data its headers define,
/// named `NAME` in C or its `@cname`, of a type C can spell.
fn declareExternStatic(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    var mutable = false;
    var typ = none();
    match (entry.kind) {
        ItemKind.Static(m, t, _) => {
            mutable = m;
            typ = t;
        }
        _ => { return Ok(); }
    }
    let id = c.front.ast.idents[entry.name as usize];
    var known = Vector<u32>.create();
    knownAttributes(c, entry.attributes, "a C static", "cname", mut known)?;
    var symbol = Vector<u8>.create();
    appendBytes(mut symbol, c.name(id.symbol))?;
    var span = Span { start: id.start, end: id.end };
    for (attribute in known.view()) {
        let a = c.front.ast.attributes[attribute as usize];
        var text = Range { start: 0, count: 0xFFFFFFFF };
        if (a.arguments.count == 1) {
            match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                ExprNode.StringLiteral(t) => { text = t; }
                _ => {}
            }
        }
        if (text.count == 0xFFFFFFFF) {
            attributeError(c, attribute, "'@cname' takes the C symbol as a string: '@cname(\"g_name\")'")?;
            return Ok();
        }
        symbol = Vector<u8>.create();
        appendBytes(mut symbol, c.front.ast.textOf(text))?;
        span = Span { start: a.start, end: a.end };
    }
    if (!checkCName(c, symbol.view(), span, "a C static's name")?) {
        return Ok();
    }
    if (isReservedName(c, entry.name)? || reportDuplicate(c, id)?) {
        return Ok();
    }
    let before = c.hir.statics.length;
    declareStatic(c, item, mutable, typ)?;
    if (c.hir.statics.length == before) {
        return Ok();
    }
    let k = c.hir.statics.length - 1;
    c.hir.statics[k].imported = true; // C data, even if refused below
    c.hir.statics[k].cName = c.hir.addText(symbol.view())?;
    let t = c.hir.statics[k].typ;
    if (t != c.types.error && !isFfiSafe(c, t, false, true)) {
        let typeSpan = c.front.ast.typeSpans[typ as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "a C static is C data, so its type must be one C can spell: an integer, 'bool', an ")?;
        appendText(
            mut message,
            "atomic, a raw pointer, an 'extern \"C\" fn', a C type or an array of these (ADR 0080 ",
        )?;
        appendText(mut message, "§3.2; type-system.md §28.5)")?;
        c.error(notFfiSafe(), typeSpan.start, typeSpan.end, message)?;
    }
    return Ok();
}

fn declareImportedEnum(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    let base = match (entry.kind) {
        ItemKind.ImportedEnum(t) => t,
        _ => { return Ok(); }
    };
    let id = c.front.ast.idents[entry.name as usize];
    var name = Vector<u8>.create();
    appendBytes(mut name, c.name(id.symbol))?;
    let nameIsC = checkCName(c, name.view(), Span { start: id.start, end: id.end }, "an imported C enum's name")?;
    var spelling = Vector<u8>.create();
    appendText(mut spelling, "enum ")?;
    appendBytes(mut spelling, name.view())?;
    var known = Vector<u32>.create();
    knownAttributes(c, entry.attributes, "an imported C enum", "ctype", mut known)?;
    for (attribute in known.view()) {
        let a = c.front.ast.attributes[attribute as usize];
        var text = Range { start: 0, count: 0xFFFFFFFF };
        if (a.arguments.count == 1) {
            match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                ExprNode.StringLiteral(t) => { text = t; }
                _ => {}
            }
        }
        if (text.count == 0xFFFFFFFF) {
            attributeError(c, attribute, "'@ctype' takes the C type's name as a string: '@ctype(\"name_t\")'")?;
            continue;
        }
        var cname = Vector<u8>.create();
        appendBytes(mut cname, c.front.ast.textOf(text))?;
        if (checkCName(c, cname.view(), Span { start: a.start, end: a.end }, "the C type name")?) {
            spelling = cname;
        }
    }
    let resolved = c.resolveType(base, false)?;
    let integer = resolved == c.types.u8 || resolved == c.types.u16 || resolved == c.types.u32 ||
        resolved == c.types.u64 || resolved == c.types.i8 || resolved == c.types.i16 || resolved == c.types.i32 ||
        resolved == c.types.i64;
    if (!integer) {
        if (resolved != c.types.error) {
            let span = c.front.ast.typeSpans[base as usize];
            var message = Vector<u8>.create();
            appendText(mut message, "an imported C enum is one of the integers C gives an enum: 'u8', 'u16', 'u32', ")?;
            appendText(mut message, "'u64', 'i8', 'i16', 'i32' or 'i64' (type-system.md §31.6)")?;
            c.error(notFfiSafe(), span.start, span.end, message)?;
        }
        return Ok();
    }
    if (!nameIsC) {
        return Ok();
    }
    if (isReservedName(c, entry.name)?) {
        return Ok();
    }
    if (isDeclared(c, id.symbol)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, name.view())?;
        appendText(mut message, "' is already defined")?;
        c.error(duplicateItem(), id.start, id.end, message)?;
        return Ok();
    }
    let t = c.types.importedEnum(name.view(), resolved, spelling)?;
    ownItem(c, id.symbol, Entity.Type(t))?;
    c.importedEnums.push(ImportedEnum { typ: t, file: c.file, start: id.start })?;
    return Ok();
}

// ---- CheckForeignInterfaces (§28.2–§28.5) ----

/// One C name claimed by a C function or export, where it is claimed.
struct CNameClaim {
    name: Vector<u8>;
    function: u32; // the HIR function, or none for an exported constant
    file: u32;
    start: u32;
    end: u32;
    what: Vector<u8>; // "C function 'strlen'", as the message names it
}

fn claimCName(
    c: borrow Checker,
    claims: borrow mut Vector<CNameClaim>,
    name: Slice<u8>,
    function: u32,
    span: Span,
    what: Slice<u8>,
) -> Result<void, AllocError> {
    return claims.push(CNameClaim {
        name: copyBytes(name)?,
        function: function,
        file: c.file,
        start: span.start,
        end: span.end,
        what: copyBytes(what)?,
    });
}

/// Which packages each package depends on, directly or through others, computed once: `reach[a * n + b]` when
/// package `a` depends on package `b` (n packages).
fn packageReachability(c: borrow Checker) -> Result<Vector<bool>, AllocError> {
    let n = c.packages.length;
    var reach = Vector<bool>.create();
    for (k in 0..(n * n)) {
        reach.push(false)?;
    }
    var pending = Vector<u32>.create();
    for (from in 0..n) {
        pending.push(truncate<u32>(from))?;
        while (pending.length > 0) {
            let p = pending[pending.length - 1];
            pending.truncate(pending.length - 1);
            for (d in c.packages[p as usize].dependencies.view()) {
                let index = packageNamed(c, d.view());
                if (index == none() || reach[from * n + (index as usize)]) {
                    continue;
                }
                reach[from * n + (index as usize)] = true;
                pending.push(index)?;
            }
        }
    }
    return Ok(reach);
}

/// Does claim `a` come before claim `b` among the claims that may own a C name (ADR 0081 §7)? A library's first, then
/// by package name (unique in a build, and independent of the order of `[dependencies]`), then within one package the
/// earlier file and position.
fn claimBefore(c: borrow Checker, a: borrow CNameClaim, b: borrow CNameClaim) -> bool {
    let pa = packageOfFile(c, a.file);
    let pb = packageOfFile(c, b.file);
    if (pa != pb) {
        if (pa == none() || pb == none()) {
            return pa == none();
        }
        let order = compareBytes(c.packages[pa as usize].name.view(), c.packages[pb as usize].name.view());
        if (order != 0) {
            return order < 0;
        }
        return pa < pb;
    }
    return a.file < b.file || (a.file == b.file && a.start < b.start);
}

/// The owner of each claim's C name (ADR 0081 §2.2, §7; type-system.md §28.2), by claim: the claims of one name are
/// grouped; a claim may own it when no other claim's package is a dependency (direct or not) of its package; among
/// those, `claimBefore`'s first. The choice does not depend on the order of the claims or of `[dependencies]`.
fn cNameOwners(c: borrow Checker, claims: borrow Vector<CNameClaim>) -> Result<Vector<usize>, AllocError> {
    let reach = packageReachability(c)?;
    let n = c.packages.length;
    // Group the claims by name: `members` holds each group's claims, in claim order, from `firsts[group]`.
    var names = Map<Bytes, bool>.create();
    var groupOf = Vector<usize>.create();
    var counts = Vector<usize>.create();
    for (claim in claims.view()) {
        let key = Bytes.from(claim.name.view())?;
        let group = match (names.find(key)) {
            Some(g) => g,
            null => {
                counts.push(0)?;
                names.put(key, true)?
            }
        };
        groupOf.push(group)?;
        counts[group] += 1;
    }
    var firsts = Vector<usize>.create();
    var filled = Vector<usize>.create();
    var total: usize = 0;
    for (count in counts.view()) {
        firsts.push(total)?;
        filled.push(0)?;
        total += count;
    }
    var members = Vector<usize>.create();
    for (k in 0..claims.length) {
        members.push(0)?;
    }
    for (i in 0..claims.length) {
        let group = groupOf[i];
        members[firsts[group] + filled[group]] = i;
        filled[group] += 1;
    }
    var groupOwner = Vector<usize>.create();
    for (group in 0..counts.length) {
        let first = firsts[group];
        let count = counts[group];
        var owner = none64();
        var fallback = none64(); // the first of all, should dependencies form a cycle
        for (x in first..(first + count)) {
            let i = members[x];
            if (fallback == none64() || claimBefore(c, claims[i], claims[fallback])) {
                fallback = i;
            }
            let pi = packageOfFile(c, claims[i].file);
            var candidate = true;
            if (pi != none()) {
                for (y in first..(first + count)) {
                    let pj = packageOfFile(c, claims[members[y]].file);
                    if (pj == none() || (pj != pi && reach[(pi as usize) * n + (pj as usize)])) {
                        candidate = false; // a library's claim, or one of a dependency of this package
                        break;
                    }
                }
            }
            if (candidate && (owner == none64() || claimBefore(c, claims[i], claims[owner]))) {
                owner = i;
            }
        }
        groupOwner.push(if (owner == none64()) fallback else owner)?;
    }
    var owners = Vector<usize>.create();
    for (i in 0..claims.length) {
        owners.push(groupOwner[groupOf[i]])?;
    }
    return Ok(owners);
}

/// An attribute's text without white space, to compare two declarations' attributes.
fn attributeKey(c: borrow Checker, file: u32, attribute: u32) -> Result<Vector<u8>, AllocError> {
    var key = Vector<u8>.create();
    let a = c.front.ast.attributes[attribute as usize];
    if ((file as usize) >= c.fileTexts.length || (a.end as usize) > c.fileTexts[file as usize].length) {
        return Ok(key);
    }
    for (b in c.fileTexts[file as usize][(a.start as usize)..(a.end as usize)]) {
        if (b != ' ' && b != '\t' && b != '\n' && b != '\r') {
            key.push(b)?;
        }
    }
    return Ok(key);
}

/// Are two extern declarations identical in CeeSafe (ADR 0081 §2.2): the same parameter and result types,
/// variadic-ness and attributes? An identical C signature is not enough: `*void` and `*X509` are one C type.
fn identicalExterns(c: borrow Checker, f: u32, g: u32) -> Result<bool, AllocError> {
    let a = c.front.ast.functions[c.hir.functions[f as usize].syntax as usize];
    let b = c.front.ast.functions[c.hir.functions[g as usize].syntax as usize];
    if (!a.isExtern || !b.isExtern || (a.variadicStart == none()) != (b.variadicStart == none())) {
        return Ok(false);
    }
    let pf = borrow c.hir.functions[f as usize].parameters;
    let pg = borrow c.hir.functions[g as usize].parameters;
    let result = c.hir.functions[f as usize].returnType;
    if (pf.length != pg.length || result != c.hir.functions[g as usize].returnType || result == c.types.error) {
        return Ok(false);
    }
    for (k in 0..pf.length) {
        let t = c.hir.locals[pf[k] as usize].typ;
        if (t != c.hir.locals[pg[k] as usize].typ || t == c.types.error) {
            return Ok(false);
        }
    }
    if (a.attributes.count != b.attributes.count) {
        return Ok(false);
    }
    let fileA = c.hir.functions[f as usize].file;
    let fileB = c.hir.functions[g as usize].file;
    var used = Vector<bool>.create();
    for (k in 0..b.attributes.count) {
        used.push(false)?;
    }
    for (k in 0..a.attributes.count) {
        let key = attributeKey(c, fileA, c.front.ast.at(a.attributes, k))?;
        var found = false;
        for (j in 0..b.attributes.count) {
            if (!used[j as usize] &&
                sameBytes(key.view(), attributeKey(c, fileB, c.front.ast.at(b.attributes, j))?.view())) {
                used[j as usize] = true;
                found = true;
                break;
            }
        }
        if (!found) {
            return Ok(false);
        }
    }
    return Ok(true);
}

/// The lines of `start..end` in `text`, when nothing else is on them but white space and a trailing `//` comment:
/// from the start of the first line, with the doc comment's lines above it (`///`), to the end of the last, its line
/// break and comment among them. Otherwise `start..end` alone.
fn wholeLines(text: Slice<u8>, start: u32, end: u32) -> Span {
    var lineStart = start;
    while (lineStart > 0 && (text[(lineStart - 1) as usize] == ' ' || text[(lineStart - 1) as usize] == '\t')) {
        lineStart -= 1;
    }
    var lineEnd = end;
    while ((lineEnd as usize) < text.length && (text[lineEnd as usize] == ' ' || text[lineEnd as usize] == '\t' ||
        text[lineEnd as usize] == '\r')) {
        lineEnd += 1;
    }
    if ((lineEnd as usize) + 1 < text.length && text[lineEnd as usize] == '/' && text[(lineEnd + 1) as usize] == '/') {
        while ((lineEnd as usize) < text.length && text[lineEnd as usize] != '\n') {
            lineEnd += 1; // a trailing comment goes with the line
        }
    }
    if ((lineStart > 0 && text[(lineStart - 1) as usize] != '\n') ||
        ((lineEnd as usize) < text.length && text[lineEnd as usize] != '\n')) {
        return Span { start: start, end: end };
    }
    if ((lineEnd as usize) < text.length) {
        lineEnd += 1; // the line break
    }
    // The doc comment's lines above (`///`), which belong to the declaration.
    loop {
        if (lineStart == 0) {
            break;
        }
        var previous = lineStart - 1; // the line break ending the line above
        while (previous > 0 && text[(previous - 1) as usize] != '\n') {
            previous -= 1;
        }
        var first = previous;
        while ((first as usize) < text.length && (text[first as usize] == ' ' || text[first as usize] == '\t')) {
            first += 1;
        }
        if ((first as usize) + 3 > text.length || text[first as usize] != '/' || text[(first + 1) as usize] != '/' ||
            text[(first + 2) as usize] != '/') {
            break;
        }
        lineStart = previous;
    }
    return Span { start: lineStart, end: lineEnd };
}

/// The extern block holding only the declaration `syntax` of `file`, with no attribute: the item, or none.
fn soleExternBlock(c: borrow Checker, file: u32, syntax: u32) -> u32 {
    for (unit in c.front.ast.units.view()) {
        if (unit.file != file) {
            continue;
        }
        for (k in 0..unit.items.count) {
            let item = c.front.ast.at(unit.items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Extern(_, functions, nested) => {
                    if (functions.count == 1 && nested.count == 0 && c.front.ast.at(functions, 0) == syntax &&
                        c.front.ast.items[item as usize].attributes.count == 0) {
                        return item;
                    }
                }
                _ => {}
            }
        }
    }
    return none();
}

/// The bytes a fix removes with a declaration (`wholeLines`): its lines, its doc comment's and attributes' among them,
/// or its extern block's when it is the block's only declaration, so that no empty block is left.
fn declarationLines(c: borrow Checker, file: u32, function: u32) -> Span {
    let syntax = c.hir.functions[function as usize].syntax;
    let text = c.fileTexts[file as usize].view();
    let block = soleExternBlock(c, file, syntax);
    if (block != none()) {
        let item = c.front.ast.items[block as usize];
        return wholeLines(text, item.start, item.end);
    }
    let decl = c.front.ast.functions[syntax as usize];
    var start = decl.start;
    for (k in 0..decl.attributes.count) {
        let a = c.front.ast.attributes[c.front.ast.at(decl.attributes, k) as usize];
        if (a.start < start) {
            start = a.start;
        }
    }
    return wholeLines(text, start, decl.end);
}

/// N0201 for each claim of a C name that another claim owns (type-system.md §28.2; ADR 0081 §2.2): reported at the
/// declaration that clashes (a dependant's own, or the later in a package's file order), with a note at the owner's.
/// When the owner is an extern declaration of a dependency, a hint says to call it through its package, and a fix
/// removes this declaration if the two are identical.
fn reportCNameClashes(c: borrow mut Checker, claims: borrow Vector<CNameClaim>) -> Result<void, AllocError> {
    let owners = cNameOwners(c, claims)?;
    for (i in 0..claims.length) {
        let owner = owners[i];
        if (owner == i) {
            continue;
        }
        let mine = borrow claims[i];
        let theirs = borrow claims[owner];
        let myPackage = packageOfFile(c, mine.file);
        let ownerPackage = packageOfFile(c, theirs.file);
        let otherPackage = ownerPackage != none() && ownerPackage != myPackage;
        var message = Vector<u8>.create();
        appendText(mut message, "the C name '")?;
        appendBytes(mut message, mine.name.view())?;
        appendText(mut message, "' of ")?;
        appendBytes(mut message, mine.what.view())?;
        var note = Vector<u8>.create();
        if (otherPackage) {
            appendText(mut message, " is already declared by package '")?;
            appendBytes(mut message, c.packages[ownerPackage as usize].name.view())?;
            appendText(mut message, "' (type-system.md §28.2)")?;
            appendText(mut note, "package '")?;
            appendBytes(mut note, c.packages[ownerPackage as usize].name.view())?;
            appendText(mut note, "' declares it here")?;
        } else {
            appendText(mut message, " is already used by another C function or export (type-system.md §28.2)")?;
            if (ownerPackage == none() && myPackage != none()) {
                appendText(mut note, "a library declares it here")?;
            } else {
                appendText(mut note, "the other declaration is here")?;
            }
        }
        // The hint: a dependency's extern declaration is called through its package (ADR 0081 §2.1).
        var fixable = false;
        let bothExtern = mine.function != none() && theirs.function != none() &&
            c.front.ast.functions[c.hir.functions[mine.function as usize].syntax as usize].isExtern &&
            c.front.ast.functions[c.hir.functions[theirs.function as usize].syntax as usize].isExtern;
        if (otherPackage && bothExtern &&
            dependencyNamed(c, myPackage, c.packages[ownerPackage as usize].name.view()) == ownerPackage) {
            let ownerDecl = c.front.ast.functions[c.hir.functions[theirs.function as usize].syntax as usize];
            var qualified = Vector<u8>.create();
            appendBytes(mut qualified, c.packages[ownerPackage as usize].name.view())?;
            qualified.push('.')?;
            appendBytes(mut qualified, c.name(c.hir.functions[theirs.function as usize].name))?;
            if (isPublicVisibility(ownerDecl.visibility)) {
                appendText(mut message, ": use `")?;
                appendBytes(mut message, qualified.view())?;
                appendText(mut message, "`, which package '")?;
                appendBytes(mut message, c.packages[ownerPackage as usize].name.view())?;
                appendText(mut message, "' declares; remove this declaration")?;
                fixable = identicalExterns(c, mine.function, theirs.function)?;
            } else {
                appendText(mut message, ": make its declaration `public` in package '")?;
                appendBytes(mut message, c.packages[ownerPackage as usize].name.view())?;
                appendText(mut message, "', then use `")?;
                appendBytes(mut message, qualified.view())?;
                appendText(mut message, "` and remove this declaration")?;
            }
        }
        var notes = Vector<DiagnosticNote>.create();
        notes.push(DiagnosticNote { file: theirs.file, start: theirs.start, end: theirs.end, message: note })?;
        if (fixable) {
            let lines = declarationLines(c, mine.file, mine.function);
            var title = Vector<u8>.create();
            appendText(mut title, "remove this declaration: package '")?;
            appendBytes(mut title, c.packages[ownerPackage as usize].name.view())?;
            appendText(mut title, "' declares it identically")?;
            c.front.diagnostics.errorWithEdit(
                duplicateItem(),
                mine.file,
                mine.start,
                mine.end,
                message,
                title,
                lines.start,
                lines.end,
                Vector<u8>.create(),
            )?;
            let last = c.front.diagnostics.items.length - 1;
            c.front.diagnostics.items[last].notes = notes;
        } else {
            c.front.diagnostics.errorWithNotes(duplicateItem(), mine.file, mine.start, mine.end, message, notes)?;
        }
    }
    return Ok();
}

/// A function whose signature crosses to C (CheckSignatureIsFfiSafe, N0291).
fn checkSignatureIsFfiSafe(c: borrow mut Checker, function: u32, what: Slice<u8>) -> Result<void, AllocError> {
    let syntax = c.hir.functions[function as usize].syntax;
    let decl = c.front.ast.functions[syntax as usize];
    for (k in 0..decl.parameters.count) {
        let p = c.hir.functions[function as usize].parameters[k as usize];
        let t = c.hir.locals[p as usize].typ;
        if (!isFfiSafe(c, t, false, false)) {
            let parameter = c.front.ast.parameters[c.front.ast.at(decl.parameters, k) as usize];
            let span = c.front.ast.typeSpans[parameter.typ as usize];
            var message = Vector<u8>.create();
            appendBytes(mut message, what)?;
            appendText(mut message, " cannot take a ")?;
            appendQuotedType(mut message, c, t)?;
            appendText(
                mut message,
                ": only integers, bool, raw pointers, @repr(C) structs and @repr enums cross to C (type-system.md §28.3)",
            )?;
            c.error(notFfiSafe(), span.start, span.end, message)?;
        }
    }
    // A C constant macro's result is C's initialiser, never a value crossing a call (§39.4).
    let returnType = c.hir.functions[function as usize].returnType;
    if (!isFfiSafe(
        c,
        returnType,
        true,
        false,
    ) && !(decl.isExtern && hasAttributeNamed(c, decl.attributes, "constant"))) {
        let span = if (decl.returnType != none()) c.front.ast.typeSpans[decl.returnType as usize] else identSpan(
            c,
            decl.name,
        );
        var message = Vector<u8>.create();
        appendBytes(mut message, what)?;
        appendText(mut message, " cannot return a ")?;
        appendQuotedType(mut message, c, returnType)?;
        appendText(
            mut message,
            ": only integers, bool, raw pointers, @repr(C) structs, @repr enums and void cross to C (type-system.md §28.3)",
        )?;
        c.error(notFfiSafe(), span.start, span.end, message)?;
    }
    return Ok();
}

fn attributeSpanNamed(c: borrow Checker, attributes: Range, name: StringView) -> Span {
    for (k in 0..attributes.count) {
        let attribute = c.front.ast.at(attributes, k);
        if (sameText(attributeName(c, attribute), name)) {
            let a = c.front.ast.attributes[attribute as usize];
            return Span { start: a.start, end: a.end };
        }
    }
    return Span { start: 0, end: 0 };
}

fn identSpan(c: borrow Checker, ident: u32) -> Span {
    let id = c.front.ast.idents[ident as usize];
    return Span { start: id.start, end: id.end };
}

/// The integer whose C type an atomic field shares, for lib/core's AtomicU32, AtomicU64 and AtomicUSize (u32, u64,
/// usize), or none(): each is laid out exactly as its integer, so it may be an imported or exported struct's field
/// whose C member is that integer, accessed atomically on both sides (ADR 0041 §3.1). AtomicBool is not: it holds a
/// u32, while C's bool is one byte.
/// A type every bit pattern of whose size is a value of (ADR 0041 §3.2): an integer, a raw pointer, an array of
/// these, or an imported type whose declared fields are; what a union's members may be.
fn anyBitPattern(c: borrow Checker, t: u32, depth: u32) -> bool {
    if (c.types.is(t, TypeKind.Integer) || c.types.is(t, TypeKind.RawPointer) || c.types.is(t, TypeKind.Error)) {
        return true;
    }
    if (c.types.is(t, TypeKind.Array)) {
        return anyBitPattern(c, c.types.info(t).element, depth);
    }
    let def = c.types.info(t).structDef;
    if (c.types.is(t, TypeKind.Struct) && def != none() && c.types.structs[def as usize].isImported && depth < 64) {
        for (f in c.types.structs[def as usize].fields.view()) {
            if (!anyBitPattern(c, c.types.fields[f as usize].typ, depth + 1)) {
                return false;
            }
        }
        return true;
    }
    return false;
}

fn atomicFieldInteger(c: borrow Checker, t: u32) -> u32 {
    let def = c.types.info(t).structDef;
    if (def == none()) {
        return none();
    }
    let file = c.types.structs[def as usize].file;
    if (file == none() || !c.fileIsLibrary[file as usize]) {
        return none();
    }
    let name = c.types.name(t);
    if (sameText(name, "AtomicU64")) {
        return c.types.u64;
    }
    if (sameText(name, "AtomicU32")) {
        return c.types.u32;
    }
    if (sameText(name, "AtomicUSize")) {
        return c.types.usize;
    }
    if (sameText(name, "AtomicU8")) {
        return c.types.u8; // a byte member (ADR 0080 §3.5)
    }
    return none();
}

/// Once every type is resolved: FFI-safe signatures and fields, and valid, unique C names (CheckForeignInterfaces).
fn checkForeignInterfaces(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    var claims = Vector<CNameClaim>.create();
    for (k in 0..c.structs.length) {
        let entry = c.structs[k];
        let definition = c.types.info(entry.typ).structDef;
        if (!c.types.structs[definition as usize].isReprC) {
            continue;
        }
        {
            let fileToSet = entry.file;
            c.setFile(fileToSet);
        }
        let item = c.front.ast.items[entry.item as usize];
        var name = Vector<u8>.create();
        appendBytes(mut name, c.name(c.front.ast.idents[item.name as usize].symbol))?;
        let nameSpan = identSpan(c, item.name);
        checkCName(c, name.view(), nameSpan, "the C struct name")?;
        let s = match (item.kind) {
            ItemKind.Struct(index) => c.front.ast.structs[index as usize],
            _ => { continue; }
        };
        let fieldCount = c.types.structs[definition as usize].fields.length;
        for (j in 0..fieldCount) {
            if (j >= s.fields.count as usize) {
                break;
            }
            let field = c.types.structs[definition as usize].fields[j];
            let syntax = c.front.ast.fields[c.front.ast.at(s.fields, truncate<u32>(j)) as usize];
            c.types.fields[field as usize].hasCeeSafeCName = true;
            var fieldName = Vector<u8>.create();
            appendBytes(mut fieldName, c.name(c.types.fields[field as usize].name))?;
            let memberSpan = identSpan(c, syntax.name);
            checkCName(c, fieldName.view(), memberSpan, "the C member name")?;
            let t = c.types.fields[field as usize].typ;
            if (!isFfiSafe(c, t, false, true)) {
                let span = c.front.ast.typeSpans[syntax.typ as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "a @repr(C) struct cannot hold a ")?;
                appendQuotedType(mut message, c, t)?;
                appendText(
                    mut message,
                    ": only integers, bool, raw pointers to C types, @repr(C) structs, imported C types, arrays of these, and AtomicU32, AtomicU64 or AtomicUSize (laid out as their integer) have C layouts (type-system.md §28.5)",
                )?;
                c.error(notFfiSafe(), span.start, span.end, message)?;
            }
        }
        let dropFunction = c.types.structs[definition as usize].dropFunction;
        if (dropFunction != none() && c.types.isCLaidOut(entry.typ, 0)) {
            let dropSyntax = c.front.ast.functions[c.hir.functions[dropFunction as usize].syntax as usize];
            let span = identSpan(c, dropSyntax.name);
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "a @repr(C) struct that holds C state cannot have a drop: C makes and discards it without calling CeeSafe (type-system.md §28.5)",
            )?;
            c.error(notFfiSafe(), span.start, span.end, message)?;
        }
    }
    for (k in 0..c.enums.length) {
        let entry = c.enums[k];
        if (entry.item == none()) {
            continue;
        }
        let definition = c.types.info(entry.typ).enumDef;
        if (c.types.enums[definition as usize].repr == none()) {
            continue;
        }
        {
            let fileToSet = entry.file;
            c.setFile(fileToSet);
        }
        let nameIdent = c.front.ast.items[entry.item as usize].name;
        var name = Vector<u8>.create();
        appendBytes(mut name, c.name(c.front.ast.idents[nameIdent as usize].symbol))?;
        let nameSpan = identSpan(c, nameIdent);
        checkCName(c, name.view(), nameSpan, "the C type name")?;
    }
    for (k in 0..c.structs.length) {
        let entry = c.structs[k];
        let definition = c.types.info(entry.typ).structDef;
        if (!c.types.structs[definition as usize].isImported) {
            continue;
        }
        {
            let fileToSet = entry.file;
            c.setFile(fileToSet);
        }
        let item = c.front.ast.items[entry.item as usize];
        var name = Vector<u8>.create();
        appendBytes(mut name, c.name(c.front.ast.idents[item.name as usize].symbol))?;
        let nameSpan = identSpan(c, item.name);
        checkCName(c, name.view(), nameSpan, "the C struct name")?;
        let s = match (item.kind) {
            ItemKind.Struct(index) => c.front.ast.structs[index as usize],
            _ => { continue; }
        };
        var memberCNames = Vector<Vector<u8>>.create();
        let fieldCount = c.types.structs[definition as usize].fields.length;
        for (j in 0..fieldCount) {
            if (j >= s.fields.count as usize) {
                break;
            }
            let field = c.types.structs[definition as usize].fields[j];
            let syntax = c.front.ast.fields[c.front.ast.at(s.fields, truncate<u32>(j)) as usize];
            c.types.fields[field as usize].hasCeeSafeCName = true;
            var cName = Vector<u8>.create();
            appendBytes(mut cName, c.name(c.types.fields[field as usize].name))?;
            var cNameSpan = identSpan(c, syntax.name);
            var known = Vector<u32>.create();
            knownAttributes(c, syntax.attributes, "a field", "cname cfg", mut known)?;
            for (attribute in known.view()) {
                let a = c.front.ast.attributes[attribute as usize];
                if (sameText(attributeName(c, attribute), "cfg")) {
                    // `@cfg("X")` (ADR 0080 §3.3): a member some builds' C struct lacks; used only where `X` holds.
                    let cfgText = attributeString(c, attribute)?;
                    let switchMacro = withoutBang(cfgText.view());
                    if (cfgText.length == 0) {
                        attributeError(
                            c,
                            attribute,
                            "'@cfg' takes the C macro's name as a string: '@cfg(\"CONFIG_DEBUG\")'",
                        )?;
                    } else if (checkCName(
                        c,
                        switchMacro,
                        Span { start: a.start, end: a.end },
                        "the configuration macro",
                    )?) {
                        c.fieldCfgs.push(FieldCfg { field: field, text: cfgText })?;
                    }
                    continue;
                }
                var text = Range { start: 0, count: 0xFFFFFFFF };
                if (a.arguments.count == 1) {
                    match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                        ExprNode.StringLiteral(t) => { text = t; }
                        _ => {}
                    }
                }
                if (text.count == 0xFFFFFFFF) {
                    attributeError(c, attribute, "'@cname' takes the C member's name as a string: '@cname(\"type\")'")?;
                    continue;
                }
                cName = Vector<u8>.create();
                appendBytes(mut cName, c.front.ast.textOf(text))?;
                cNameSpan = Span { start: a.start, end: a.end };
                c.types.fields[field as usize].hasCName = true;
                c.types.fields[field as usize].cName = c.types.addName(cName)?;
            }
            if (checkCName(c, cName.view(), cNameSpan, "the C member name")?) {
                var duplicate = false;
                for (m in memberCNames.view()) {
                    if (sameBytes(m.view(), cName.view())) {
                        duplicate = true;
                    }
                }
                if (duplicate) {
                    var message = Vector<u8>.create();
                    appendQuotedType(mut message, c, entry.typ)?;
                    appendText(mut message, " already has a field with the C name '")?;
                    appendBytes(mut message, cName.view())?;
                    appendText(mut message, "' (type-system.md §31.1)")?;
                    c.error(duplicateMember(), cNameSpan.start, cNameSpan.end, message)?;
                } else {
                    memberCNames.push(copyBytes(cName.view())?)?;
                }
            }
            let t = c.types.fields[field as usize].typ;
            if (c.types.fields[field as usize].unionGroup != none() && !anyBitPattern(c, t, 0)) {
                // Reading one member after writing another reinterprets bytes, which must always be a value.
                let span = c.front.ast.typeSpans[syntax.typ as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "a union member cannot be a ")?;
                appendQuotedType(mut message, c, t)?;
                appendText(
                    mut message,
                    ": its members share storage, so each must be a type every bit pattern is a value of: integers, raw pointers, arrays of these, and imported types whose fields are (ADR 0041 §3.2)",
                )?;
                c.error(unionMemberType(), span.start, span.end, message)?;
                continue;
            }
            let isArray = c.types.is(t, TypeKind.Array);
            let element = if (isArray) c.types.info(t).element else none();
            if (element != none()) {
                let elementDef = c.types.info(element).structDef;
                let pointerElement = (c.types.is(element, TypeKind.RawPointer) &&
                    isCPointee(c, c.types.info(element).pointee)) || c.types.is(element, TypeKind.FunctionPointer);
                if (c.types.is(element, TypeKind.Integer) || c.types.is(element, TypeKind.Bool) ||
                    c.types.is(element, TypeKind.Error) || pointerElement ||
                    (elementDef != none() && c.types.structs[elementDef as usize].isImported)) {
                    continue; // a C array member (C9, §31.1), of pointers too (ADR 0080 §3.5)
                }
            }
            let fieldDef = c.types.info(t).structDef;
            let simple = c.types.is(
                t,
                TypeKind.Integer,
            ) || c.types.is(t, TypeKind.Bool) || c.types.is(t, TypeKind.Error);
            let cPointer = c.types.is(t, TypeKind.RawPointer) && isCPointee(c, c.types.info(t).pointee);
            let embedded = fieldDef != none() && c.types.structs[fieldDef as usize].isImported; // §33.1
            let callback = c.types.is(t, TypeKind.FunctionPointer);                             // a C function pointer (§34.3)
            let atomic = atomicFieldInteger(c, t) != none();                                    // ADR 0041 §3.1
            if (!simple && !cPointer && !embedded && !callback && !atomic) {
                let span = c.front.ast.typeSpans[syntax.typ as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "a field of an imported C type cannot be a ")?;
                appendQuotedType(mut message, c, t)?;
                appendText(
                    mut message,
                    ": only integers, bool, raw pointers to C types, embedded imported types, arrays of integers, bool or imported types, and AtomicU32, AtomicU64 or AtomicUSize over the matching integer are spelled alike in C and CeeSafe (type-system.md §31.1)",
                )?;
                c.error(notFfiSafe(), span.start, span.end, message)?;
            }
        }
    }
    for (k in 0..c.hir.functions.length) {
        let syntax = c.hir.functions[k].syntax;
        if (!c.hir.functions[k].registered || !containsU32(c.callbacks, syntax) || functionIsInstantiation(
            c,
            truncate<u32>(k),
        )) {
            continue;
        }
        let function = truncate<u32>(k);
        {
            let fileToSet = c.hir.functions[k].file;
            c.setFile(fileToSet);
        }
        var what = Vector<u8>.create();
        appendText(mut what, "callback '")?;
        appendBytes(mut what, c.name(c.hir.functions[k].name))?;
        appendText(mut what, "'")?;
        var generic = c.types.isGeneric(c.hir.functions[k].returnType);
        for (p in c.hir.functions[k].parameters.view()) {
            if (c.types.isGeneric(c.hir.locals[p as usize].typ)) {
                generic = true;
            }
        }
        if (generic) {
            let span = identSpan(c, c.front.ast.functions[syntax as usize].name);
            var message = Vector<u8>.create();
            appendBytes(mut message, what.view())?;
            appendText(
                mut message,
                " has a C signature that depends on its type parameters; every instance must have the same one (type-system.md §34.1)",
            )?;
            c.error(notFfiSafe(), span.start, span.end, message)?;
            continue;
        }
        checkSignatureIsFfiSafe(c, function, what.view())?;
    }
    for (k in 0..c.hir.functions.length) {
        if (!c.hir.functions[k].registered) {
            continue;
        }
        let syntax = c.hir.functions[k].syntax;
        let decl = c.front.ast.functions[syntax as usize];
        let exported = c.hir.functions[k].exported;
        if (!decl.isExtern && !exported) {
            continue;
        }
        let function = truncate<u32>(k);
        {
            let fileToSet = c.hir.functions[k].file;
            c.setFile(fileToSet);
        }
        var name = Vector<u8>.create();
        if (exported || (decl.isExtern && c.hir.functions[k].exportName.count > 0)) {
            appendBytes(mut name, c.hir.textOf(c.hir.functions[k].exportName))?; // an export's symbol, or a `@cname`
        } else {
            appendBytes(mut name, c.name(c.hir.functions[k].name))?;
        }
        var what = Vector<u8>.create();
        if (decl.isExtern) {
            appendText(mut what, "C function '")?;
            appendBytes(mut what, name.view())?;
        } else {
            appendText(mut what, "exported function '")?;
            appendBytes(mut what, c.name(c.hir.functions[k].name))?;
        }
        appendText(mut what, "'")?;
        let span = if (decl.isExtern) identSpan(c, decl.name) else attributeSpanNamed(c, decl.attributes, "export");
        // `_` and a lowercase letter is allowed: platforms' entry symbols (`_start`, §29.6) and C library names.
        if (checkCName(c, name.view(), span, if (decl.isExtern) "the C function name" else "the exported symbol")?) {
            claimCName(c, mut claims, name.view(), function, span, what.view())?;
        }
        checkSignatureIsFfiSafe(c, function, what.view())?;
        if (decl.isExtern && decl.variadicStart != none() &&
            c.types.is(c.hir.functions[k].returnType, TypeKind.Enum)) {
            // A variadic function is called directly, with no wrapper to check an enum from C (ADR 0041 §3.3).
            var message = Vector<u8>.create();
            appendBytes(mut message, what.view())?;
            appendText(
                mut message,
                " takes '...', so it cannot return a @repr enum: declare its integer (ADR 0041 §3.3)",
            )?;
            c.error(notFfiSafe(), span.start, span.end, message)?;
        }
    }
    for (k in 0..c.constants.length) {
        let entry = c.constants[k];
        let hir = c.hir.constants[entry.hir as usize];
        if (!hir.exported) {
            continue;
        }
        {
            let fileToSet = entry.file;
            c.setFile(fileToSet);
        }
        let item = c.front.ast.items[entry.item as usize];
        let span = attributeSpanNamed(c, item.attributes, "export");
        var name = Vector<u8>.create();
        appendBytes(mut name, c.hir.textOf(hir.exportName))?;
        if (checkCName(c, name.view(), span, "the exported symbol")?) {
            var what = Vector<u8>.create();
            appendText(mut what, "exported constant '")?;
            appendBytes(mut what, c.name(c.front.ast.idents[item.name as usize].symbol))?;
            appendText(mut what, "'")?;
            claimCName(c, mut claims, name.view(), none(), span, what.view())?;
        }
        let t = hir.typ;
        if (!(c.types.is(t, TypeKind.Integer) || c.types.is(t, TypeKind.Bool) || c.types.is(t, TypeKind.Array) ||
            c.types.is(t, TypeKind.Error))) {
            let typeSyntax = match (item.kind) {
                ItemKind.Const(typ, _) => typ,
                _ => none(),
            };
            let typeSpan = c.front.ast.typeSpans[typeSyntax as usize];
            var message = Vector<u8>.create();
            appendText(mut message, "an exported constant is an integer, a bool, or an array of them, not a ")?;
            appendQuotedType(mut message, c, t)?;
            appendText(mut message, " (type-system.md §28.4)")?;
            c.error(notFfiSafe(), typeSpan.start, typeSpan.end, message)?;
        }
    }
    reportCNameClashes(c, claims)?;
    c.setFile(saved);
    return Ok();
}
