// Generics (the reference's DeclareTypeParameters, GenericFunctionEntry, InstantiateStruct, InstantiateEnum,
// InstantiateFunction, FinishLateTypes, CheckInstance, Quietly, Unify, TypeArgumentsFor, ResolveGenericItemType,
// CheckGenericCall, StaticOwner and CheckBounds' marker bounds): P3 S4a/S4b (type-system.md §20). Interface bounds,
// impls and methods through bounds are S4c; `dyn` is S4d.

fn cannotInferTypeArguments() -> u32 => 265;
fn instantiationTooDeep() -> u32 => 266;
fn boundNotSatisfied() -> u32 => 268;
fn scopedTypeArgument() -> u32 => 274;
fn notSend() -> u32 => 334;
fn cellOfLoans() -> u32 => 351;

/// A type parameter's name and what it stands for: itself in a generic version, a type in an instance.
struct EnvPair {
    symbol: u32;
    typ: u32;
}

/// A generic function (GenericFunctionEntry): checked once with opaque type parameters, instantiated on use.
struct GenericFunctionEntry {
    syntax: u32; // Ast.functions
    file: u32;
    generic: u32;            // the generic version (a HIR function)
    parameters: Range;       // its type parameters, in TypeTable.lists
    owner: u32;              // a generic method's struct type (ADR 0064 §1), else none
    ownerEnvironment: Range; // that struct's type environment (Checker.envPairs), else empty
    signatureOnly: bool;     // a bound's generic interface method (ADR 0086 §2.3): instances are signatures, not compiled
}

/// A diagnostics mark for CheckInstance and Quietly: diagnostics after it are dropped when the trial ends.
fn diagnosticsMark(c: borrow Checker) -> usize => c.front.diagnostics.items.length;

/// Quietly's end: the trial's diagnostics are dropped.
fn dropDiagnosticsSince(c: borrow mut Checker, mark: usize) {
    c.front.diagnostics.items.truncate(mark);
}

/// The type a name stands for in the current type environment, or none.
fn environmentType(c: borrow Checker, symbol: u32) -> u32 {
    var k = c.typeEnvironment.length;
    while (k > 0) {
        k -= 1;
        if (c.typeEnvironment[k].symbol == symbol) {
            return c.typeEnvironment[k].typ;
        }
    }
    if (symbol == c.selfSymbol) {
        return c.selfType; // `Self` (ADR 0086 §2.2): the method's owner, or the struct or enum being declared
    }
    return none();
}

/// Stores an environment, returning its range in Checker.envPairs.
fn storeEnvironment(c: borrow mut Checker, pairs: Slice<EnvPair>) -> Result<Range, AllocError> {
    let start = truncate<u32>(c.envPairs.length);
    for (p in pairs) {
        c.envPairs.push(p)?;
    }
    return Ok(Range { start: start, count: truncate<u32>(pairs.length) });
}

/// Makes a stored environment the current one, returning the previous.
fn enterEnvironment(c: borrow mut Checker, env: Range) -> Result<Vector<EnvPair>, AllocError> {
    var old = Vector<EnvPair>.create();
    for (p in c.typeEnvironment.view()) {
        old.push(p)?;
    }
    c.typeEnvironment.truncate(0);
    for (k in 0..env.count) {
        c.typeEnvironment.push(c.envPairs[(env.start + k) as usize])?;
    }
    return Ok(old);
}

fn restoreEnvironment(c: borrow mut Checker, old: Vector<EnvPair>) {
    c.typeEnvironment = old;
}

/// Does a stored environment hold a generic type (HirFunction.IsGeneric's first half)?
fn environmentIsGeneric(c: borrow Checker, env: Range) -> bool {
    for (k in 0..env.count) {
        if (c.types.isGeneric(c.envPairs[(env.start + k) as usize].typ)) {
            return true;
        }
    }
    return false;
}

/// HirFunction.IsGeneric: its environment holds a generic type, or its owner is generic.
fn functionIsGeneric(c: borrow Checker, function: u32) -> bool {
    let f = borrow c.hir.functions[function as usize];
    return environmentIsGeneric(c, f.environment) || (f.owner != none() && c.types.isGeneric(f.owner));
}

/// HirFunction.IsInstantiation: a monomorphised copy of generic code.
/// An interface default's instance for an impl that inherits it is one too (ADR 0086 §2.1): its generic version, at
/// the interface, reports.
fn functionIsInstantiation(c: borrow Checker, function: u32) -> bool =>
    c.hir.functions[function as usize].inheritedDefault || c.hir.functions[function as usize].repeatsGeneric ||
        (c.hir.functions[function as usize].environment.count > 0 && !functionIsGeneric(c, function));

/// The type parameters of a declaration (DeclareTypeParameters): each a new type, with its marker bounds; interface
/// bounds are S4c's. `env` gets the outer environment's pairs and then these.
fn declareTypeParameters(
    c: borrow mut Checker,
    syntax: Range,
    parameters: borrow mut Vector<u32>,
    env: borrow mut Vector<EnvPair>,
) -> Result<void, AllocError> => declareTypeParametersAs(c, syntax, parameters, env, false);

/// declareTypeParameters; `again` for the parameters of an `impl<T: B> S<T> { … }` block, which name the struct's or
/// enum's own once more (ADR 0130): a name that is taken was reported where those were declared.
fn declareTypeParametersAs(
    c: borrow mut Checker,
    syntax: Range,
    parameters: borrow mut Vector<u32>,
    env: borrow mut Vector<EnvPair>,
    again: bool,
) -> Result<void, AllocError> {
    for (k in 0..syntax.count) {
        let p = c.front.ast.typeParameters[c.front.ast.at(syntax, k) as usize];
        let ident = c.front.ast.idents[p.name as usize];
        var text = Vector<u8>.create();
        appendBytes(mut text, c.name(ident.symbol))?;
        var inEnvironment = false;
        for (e in env.view()) {
            if (e.symbol == ident.symbol) {
                inEnvironment = true;
            }
        }
        let isItem = match (c.item(ident.symbol)) {
            Entity.None => false,
            _ => true,
        };
        if (!again && (inEnvironment || c.types.lookup(text.view()) != none() || isItem)) {
            var message = Vector<u8>.create();
            appendText(mut message, "type parameter '")?;
            appendBytes(mut message, text.view())?;
            appendText(mut message, if (inEnvironment) "' is declared twice" else "' would shadow the type or item '")?;
            if (!inEnvironment) {
                appendBytes(mut message, text.view())?;
                appendText(mut message, "'")?;
            }
            c.error(duplicateItem(), ident.start, ident.end, message)?;
        }
        let typ = c.types.createTypeParameter(text.view())?;
        env.push(EnvPair { symbol: ident.symbol, typ: typ })?;
        parameters.push(typ)?;
        if (p.valueType != none()) {
            declareConstParameter(c, p, typ, env.view())?; // ADR 0083 §2.2
        }
    }
    // Bounds may mention any of the parameters (`T: Comparable<T>`), so they are resolved last.
    let saved = enterEnvironmentPairs(c, env.view())?;
    for (k in 0..syntax.count) {
        let p = c.front.ast.typeParameters[c.front.ast.at(syntax, k) as usize];
        let parameterInfo = c.types.info(parameters[k as usize]).typeParameter;
        for (b in 0..p.bounds.count) {
            let bound = c.front.ast.at(p.bounds, b);
            let marker = singleName(c, bound);
            let undeclared = marker != none() && match (c.item(marker)) {
                Entity.None => true,
                _ => false,
            };
            if (undeclared && sameText(c.name(marker), "Copy")) {
                c.types.typeParameters[parameterInfo as usize].copyBound = true;
            } else if (undeclared && sameText(c.name(marker), "Send")) {
                c.types.typeParameters[parameterInfo as usize].sendBound = true; // inferred properties as bounds (§38.1)
            } else if (undeclared && sameText(c.name(marker), "Share")) {
                c.types.typeParameters[parameterInfo as usize].shareBound = true;
            } else {
                let resolved = resolveInterface(c, bound)?;
                if (resolved != none()) {
                    c.types.typeParameters[parameterInfo as usize].bounds.push(resolved)?;
                }
            }
        }
        closeBounds(c, parameterInfo)?; // the bounds' supertraits (ADR 0086 §2.6)
    }
    restoreEnvironment(c, saved);
    return Ok();
}

fn enterEnvironmentPairs(c: borrow mut Checker, pairs: Slice<EnvPair>) -> Result<Vector<EnvPair>, AllocError> {
    var old = Vector<EnvPair>.create();
    for (p in c.typeEnvironment.view()) {
        old.push(p)?;
    }
    c.typeEnvironment.truncate(0);
    for (p in pairs) {
        c.typeEnvironment.push(p)?;
    }
    return Ok(old);
}

/// `Name<A, B>` with the type names of `arguments` (the reference's `$"{text}<{string.Join(", ", arguments)}>"`).
fn appendInstanceName(
    out: borrow mut Vector<u8>,
    c: borrow Checker,
    text: Slice<u8>,
    arguments: Slice<u32>,
) -> Result<void, AllocError> {
    appendBytes(out, text)?;
    out.push('<')?;
    for (k in 0..arguments.length) {
        if (k > 0) {
            appendText(out, ", ")?;
        }
        appendBytes(out, c.typeName(arguments[k]))?;
    }
    return out.push('>');
}

fn sameTypes(c: borrow Checker, list: Range, arguments: Slice<u32>) -> bool {
    if (list.count as usize != arguments.length) {
        return false;
    }
    for (k in 0..arguments.length) {
        if (c.types.listAt(list, truncate<u32>(k)) != arguments[k]) {
            return false;
        }
    }
    return true;
}

fn listTypes(c: borrow Checker, list: Range, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    for (k in 0..list.count) {
        out.push(c.types.listAt(list, k))?;
    }
    return Ok();
}

/// The declaration's type parameters as EnvPairs with `arguments`.
fn zipEnvironment(
    c: borrow Checker,
    typeParameters: Range,
    arguments: Slice<u32>,
    out: borrow mut Vector<EnvPair>,
) -> Result<void, AllocError> {
    for (k in 0..typeParameters.count) {
        let p = c.front.ast.typeParameters[c.front.ast.at(typeParameters, k) as usize];
        out.push(EnvPair { symbol: c.front.ast.idents[p.name as usize].symbol, typ: arguments[k as usize] })?;
    }
    return Ok();
}

fn itemTypeParameters(c: borrow Checker, item: u32) -> Range => match (c.front.ast.items[item as usize].kind) {
    ItemKind.Struct(k) => c.front.ast.structs[k as usize].typeParameters,
    ItemKind.Enum(_, typeParameters, _) => typeParameters,
    _ => emptyRange(),
};

// ---- CheckInstance ----

/// CheckInstance's end (§20.3): the trial's diagnostics are dropped. If it failed for an instance with a scoped type
/// argument, the generic needs an unscoped type there, reported where the instance is written (N0274); else a failed
/// function instance records why, for N0222 after the ownership checks.
fn endInstance(
    c: borrow mut Checker,
    mark: usize,
    arguments: Slice<u32>,
    generic: Slice<u8>,
    file: u32,
    span: Span,
    instance: u32,
) -> Result<void, AllocError> {
    var first = none();
    for (k in mark..c.front.diagnostics.items.length) {
        // An arm one instance cannot reach (`_` after `[x, ..]` on a `[T; N]`) is no error of the instance: the
        // generic version's coverage stands (ADR 0083 §7).
        let item = borrow c.front.diagnostics.items[k];
        if (first == none() && item.isError && item.code != unreachableArm()) {
            first = truncate<u32>(k);
        }
    }
    let failed = first != none();
    var firstMessage = Vector<u8>.create();
    var firstCode: u32 = 0;
    if (failed) {
        appendBytes(mut firstMessage, c.front.diagnostics.items[first as usize].message.view())?;
        firstCode = c.front.diagnostics.items[first as usize].code;
    }
    dropDiagnosticsSince(c, mark);
    if (failed && firstCode == cellOfLoans()) {
        // A cell of a loan-holding type inside the instance is the use's error (ADR 0084 §2.1).
        for (r in c.scopedInstanceReports.view()) {
            if (r.file == file && r.start == span.start && r.end == span.end) {
                return Ok();
            }
        }
        c.scopedInstanceReports.push(SpanIn { file: file, start: span.start, end: span.end })?;
        return c.front.diagnostics.error(cellOfLoans(), file, span.start, span.end, firstMessage);
    }
    if (failed && firstCode == invalidArray() && instance == none() && startsWithBytesText(
        firstMessage.view(),
        "an array length",
    )) {
        // A struct's or enum's array length from a const argument (ADR 0083 §2.6): the use's error.
        for (r in c.scopedInstanceReports.view()) {
            if (r.file == file && r.start == span.start && r.end == span.end) {
                return Ok();
            }
        }
        c.scopedInstanceReports.push(SpanIn { file: file, start: span.start, end: span.end })?;
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendInstanceName(mut message, c, generic, arguments)?;
        appendText(mut message, "' cannot be instantiated: ")?;
        appendBytes(mut message, firstMessage.view())?;
        appendText(mut message, " (type-system.md §20.5)")?;
        return c.front.diagnostics.error(invalidArray(), file, span.start, span.end, message);
    }
    var scoped = none();
    for (a in arguments) {
        if (scoped == none() && c.types.isScoped(a)) {
            scoped = a;
        }
    }
    if (failed && scoped != none()) {
        for (r in c.scopedInstanceReports.view()) {
            if (r.file == file && r.start == span.start && r.end == span.end) {
                return Ok();
            }
        }
        c.scopedInstanceReports.push(SpanIn { file: file, start: span.start, end: span.end })?;
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, generic)?;
        appendText(mut message, "' cannot be used with the scoped type ")?;
        appendQuotedType(mut message, c, scoped)?;
        appendText(
            mut message,
            ": it needs an unscoped type there (for example, it puts the value in a 'Box', or borrows it: a 'borrow T' of a view would be a reference to a reference; type-system.md §25.4)",
        )?;
        return c.front.diagnostics.error(scopedTypeArgument(), file, span.start, span.end, message);
    }
    let owner = if (instance != none()) c.hir.functions[instance as usize].owner else none();
    if (failed && instance != none() && arguments.length == 0 && owner != none()) {
        // A method of a struct or enum instance (§20.4): the instance names the arguments.
        var text = Vector<u8>.create();
        appendText(mut text, "'")?;
        appendBytes(mut text, c.typeName(owner))?;
        appendText(mut text, ".")?;
        appendBytes(mut text, generic)?;
        appendText(mut text, "' cannot be used: for these arguments its body has an error: ")?;
        appendBytes(mut text, firstMessage.view())?;
        appendText(mut text, " (type-system.md §20.4)")?;
        let f = borrow mut c.hir.functions[instance as usize];
        f.hasInstanceError = true;
        f.instanceError = text;
        if (f.callFile != none()) {
            f.siteFile = f.callFile;
            f.siteStart = f.callStart;
            f.siteEnd = f.callEnd;
        } else if (f.siteFile == none()) {
            f.siteFile = file;
            f.siteStart = span.start;
            f.siteEnd = span.end;
        }
        return Ok();
    }
    if (failed && instance != none()) {
        var text = Vector<u8>.create();
        appendText(mut text, "'")?;
        appendBytes(mut text, generic)?;
        appendText(mut text, "' cannot be used with ")?;
        for (k in 0..arguments.length) {
            if (k > 0) {
                appendText(mut text, ", ")?;
            }
            appendQuotedType(mut text, c, arguments[k])?;
        }
        var anyValue = false;
        for (a in arguments) {
            if (c.types.is(a, TypeKind.ConstValue)) {
                anyValue = true; // a const argument (ADR 0083 §2.6)
            }
        }
        appendText(mut text, if (anyValue) ": for these arguments its body has an error: "
            else ": for these type arguments its body has an error: ")?;
        appendBytes(mut text, firstMessage.view())?;
        appendText(mut text, " (type-system.md §20.4)")?;
        c.hir.functions[instance as usize].hasInstanceError = true;
        c.hir.functions[instance as usize].instanceError = text;
    }
    return Ok();
}

/// A span in a file.
struct SpanIn {
    file: u32;
    start: u32;
    end: u32;
}

// ---- bounds ----

/// For N0334 on a struct of the program: the first field that is not Send (or, with `share`, not Share), so the
/// message says where to look. A library type that is thread-bound by design (`@threadSafe` or not) names none.
fn appendThreadUnsafeField(
    message: borrow mut Vector<u8>,
    c: borrow Checker,
    argument: u32,
    share: bool,
) -> Result<void, AllocError> {
    if (!c.types.is(argument, TypeKind.Struct)) {
        return Ok();
    }
    let definition = c.types.info(argument).structDef;
    if (definition == none() || c.types.structs[definition as usize].isThreadSafe) {
        return Ok();
    }
    // A library type's fields are private: `Cell<u32>` is not Share by design, not because of its `raw`.
    let file = c.types.structs[definition as usize].file;
    if (file != none() && c.fileIsLibrary[file as usize]) {
        return Ok();
    }
    let count = c.types.structs[definition as usize].fields.length;
    for (k in 0..count) {
        let field = c.types.structs[definition as usize].fields[k];
        let fieldType = c.types.fields[field as usize].typ;
        let fieldName = c.types.fields[field as usize].name;
        var safe = c.types.isSendType(fieldType)?;
        if (share) {
            safe = c.types.isShare(fieldType)?;
        }
        if (!safe) {
            appendText(message, "; its field ")?;
            appendQuotedName(message, c, fieldName)?;
            appendText(message, " is a ")?;
            appendQuotedType(message, c, fieldType)?;
            appendText(message, if (share) ", which is not Share" else ", which is not Send")?;
            return Ok();
        }
    }
    return Ok();
}

/// Is `argument` Send and Share where `parameter` is bounded so (§38.1)? N0334.
fn checkThreadBound(c: borrow mut Checker, parameter: u32, argument: u32, span: Span) -> Result<void, AllocError> {
    let info = borrow c.types.typeParameters[c.types.info(parameter).typeParameter as usize];
    let sendBound = info.sendBound;
    let shareBound = info.shareBound;
    if (sendBound && !c.types.isSendType(argument)?) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, argument)?;
        appendText(mut message, " is not Send, but ")?;
        appendQuotedType(mut message, c, parameter)?;
        appendText(mut message, " must be ('")?;
        appendBytes(mut message, c.typeName(parameter))?;
        appendText(
            mut message,
            ": Send'): it holds a loan, a raw pointer or another value tied to one thread (type-system.md §38.1)",
        )?;
        appendThreadUnsafeField(mut message, c, argument, false)?;
        c.error(notSend(), span.start, span.end, message)?;
    }
    if (shareBound && !c.types.isShare(argument)?) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, argument)?;
        appendText(mut message, " is not Share, but ")?;
        appendQuotedType(mut message, c, parameter)?;
        appendText(mut message, " must be ('")?;
        appendBytes(mut message, c.typeName(parameter))?;
        appendText(mut message, ": Share'; type-system.md §38.1)")?;
        appendThreadUnsafeField(mut message, c, argument, true)?;
        c.error(notSend(), span.start, span.end, message)?;
    }
    return Ok();
}

/// The Send and Share bounds of the types that declarations name, once every struct and enum has its fields: before
/// that a type looks Send and Share whatever it holds.
fn checkPendingThreadBounds(c: borrow mut Checker) -> Result<void, AllocError> {
    c.membersReady = true;
    let saved = c.file;
    for (k in 0..c.pendingThreadBounds.length) {
        let p = c.pendingThreadBounds[k];
        {
            let fileToSet = p.file;
            c.setFile(fileToSet);
        }
        let parameter = c.types.listAt(p.parameters, 0);
        let argument = c.types.listAt(p.arguments, 0);
        checkThreadBound(c, parameter, argument, Span { start: p.start, end: p.end })?;
    }
    c.pendingThreadBounds.truncate(0);
    c.setFile(saved);
    return Ok();
}

/// What decideBounds answers.
fn boundsMet() -> u32 => 0;
fn boundsUnmet() -> u32 => 1;
fn boundsUnknown() -> u32 => 2;

/// Do `arguments` meet the bounds of `parameters`, as a decision and not a report (ADR 0130 §2.6)? Met, unmet, or
/// not yet known: an interface bound is decided by the impls, `Copy` by the fields and drop blocks, `Send` and
/// `Share` by the fields, so before all of them are known (and inside an instantiation, whose types are not finished)
/// there is no answer. CheckBounds defers then, reporting nothing, which must never read as "met". Nothing is
/// reported here.
fn decideBounds(c: borrow mut Checker, parameters: Slice<u32>, arguments: Slice<u32>) -> Result<u32, AllocError> {
    var anyBound = false;
    for (p in parameters) {
        let info = borrow c.types.typeParameters[c.types.info(p).typeParameter as usize];
        if (info.copyBound || info.sendBound || info.shareBound || info.bounds.length > 0) {
            anyBound = true;
        }
    }
    if (!anyBound) {
        return Ok(boundsMet());
    }
    if (!c.implsReady || !c.membersReady || c.instantiating != 0) {
        return Ok(boundsUnknown());
    }
    let mark = diagnosticsMark(c);
    let pending = c.pendingBounds.length;
    let pendingThread = c.pendingThreadBounds.length;
    checkBounds(c, parameters, arguments, Span { start: 0, end: 0 })?;
    let met = diagnosticsMark(c) == mark;
    dropDiagnosticsSince(c, mark);
    if (c.pendingBounds.length != pending || c.pendingThreadBounds.length != pendingThread) {
        // The check put itself off after all: its silence is no answer, and the question is not asked again.
        c.pendingBounds.truncate(pending);
        c.pendingThreadBounds.truncate(pendingThread);
        return Ok(boundsUnknown());
    }
    return Ok(if (met) boundsMet() else boundsUnmet());
}

/// Do `arguments` satisfy the bounds of `parameters` (CheckBounds, §21.2)? Reported as N0268 (N0334 for Send and
/// Share); deferred until every impl is known, and Send and Share until every type has its fields.
fn checkBounds(
    c: borrow mut Checker,
    parameters: Slice<u32>,
    arguments: Slice<u32>,
    span: Span,
) -> Result<void, AllocError> {
    var anyBound = false;
    for (p in parameters) {
        let info = borrow c.types.typeParameters[c.types.info(p).typeParameter as usize];
        if (info.copyBound || info.sendBound || info.shareBound || info.bounds.length > 0) {
            anyBound = true;
        }
    }
    if (!anyBound) {
        return Ok();
    }
    if (!c.implsReady) {
        let parameterList = c.types.addList(parameters)?;
        let argumentList = c.types.addList(arguments)?;
        let file = c.file;
        return c.pendingBounds.push(
            PendingBounds {
                parameters: parameterList,
                arguments: argumentList,
                start: span.start,
                end: span.end,
                file: file,
            },
        );
    }
    var map = Vector<TypeMapping>.create();
    for (k in 0..parameters.length) {
        map.push(TypeMapping { from: parameters[k], to: arguments[k] })?;
    }
    for (k in 0..parameters.length) {
        let parameter = parameters[k];
        let argument = arguments[k];
        if (c.types.isBottom(argument)) {
            continue;
        }
        let info = borrow c.types.typeParameters[c.types.info(parameter).typeParameter as usize];
        let copyBound = info.copyBound;
        let sendBound = info.sendBound;
        let shareBound = info.shareBound;
        if (copyBound && !c.types.isCopy(argument)) {
            var message = Vector<u8>.create();
            appendQuotedType(mut message, c, argument)?;
            appendText(mut message, " is not Copy, but ")?;
            appendQuotedType(mut message, c, parameter)?;
            appendText(mut message, " must be ('")?;
            appendBytes(mut message, c.typeName(parameter))?;
            appendText(mut message, ": Copy')")?;
            c.error(boundNotSatisfied(), span.start, span.end, message)?;
        }
        if ((sendBound || shareBound) && !c.membersReady) {
            // Send and Share are decided by a type's fields (§38.1), which a declaration's types do not have yet:
            // checked once they do (checkPendingThreadBounds).
            let one = [parameter];
            let other = [argument];
            let parameterList = c.types.addList(one[..])?;
            let argumentList = c.types.addList(other[..])?;
            let file = c.file;
            c.pendingThreadBounds.push(
                PendingBounds {
                    parameters: parameterList,
                    arguments: argumentList,
                    start: span.start,
                    end: span.end,
                    file: file,
                },
            )?;
        } else if (sendBound || shareBound) {
            checkThreadBound(c, parameter, argument, span)?;
        }
        let boundCount = c.types.typeParameters[c.types.info(parameter).typeParameter as usize].bounds.length;
        for (b in 0..boundCount) {
            let bound = c.types.typeParameters[c.types.info(parameter).typeParameter as usize].bounds[b];
            let original = c.types.bounds[bound as usize];
            var substituted = Vector<u32>.create();
            for (a in 0..original.arguments.count) {
                let argumentType = c.types.listAt(original.arguments, a);
                substituted.push(substitute(c, argumentType, map.view())?)?;
            }
            var boundName = Vector<u8>.create();
            appendBytes(mut boundName, c.types.rangeText(original.name))?;
            let required = c.types.addBound(original.interfaceEntry, boundName.view(), substituted.view())?;
            if (!implements(c, argument, required)) {
                var message = Vector<u8>.create();
                appendQuotedType(mut message, c, argument)?;
                appendText(mut message, " does not implement ")?;
                quotedBound(mut message, c, required)?;
                appendText(mut message, ", which ")?;
                appendQuotedType(mut message, c, parameter)?;
                appendText(mut message, " requires")?;
                let held = c.types.info(argument).pointee;
                if (c.types.is(argument, TypeKind.Box) && held != none() && implements(c, held, required)) {
                    // A type parameter is inferred as the argument's own type, the box; its contents are what
                    // implements the interface.
                    appendText(mut message, "; the box's contents, ")?;
                    appendQuotedType(mut message, c, held)?;
                    if (c.types.isDyn(held)) {
                        appendText(mut message, ", implement it: pass a 'borrow ")?;
                        appendBytes(mut message, c.typeName(held))?;
                        appendText(mut message, "' (as in 'let r: borrow ")?;
                        appendBytes(mut message, c.typeName(held))?;
                        appendText(mut message, " = borrow box;'), or declare the parameter with that type")?;
                    } else {
                        appendText(mut message, ", implement it: name the type argument, as in 'f<")?;
                        appendBytes(mut message, c.typeName(held))?;
                        appendText(mut message, ">(…)', so that the box lends its contents")?;
                    }
                }
                c.error(boundNotSatisfied(), span.start, span.end, message)?;
            }
        }
    }
    return Ok();
}

// ---- instantiation ----

/// The instantiation of a generic struct template with `arguments` (InstantiateStruct, §20.4).
fn instantiateStruct(
    c: borrow mut Checker,
    template: u32,
    arguments: Slice<u32>,
    span: Span,
) -> Result<u32, AllocError> {
    let entry = c.structs[template as usize];
    let definition = c.types.info(entry.typ).structDef;
    let parameters = c.types.structs[definition as usize].typeArguments;
    if (sameTypes(c, parameters, arguments)) {
        return Ok(template);
    }
    var parameterTypes = Vector<u32>.create();
    listTypes(c, parameters, mut parameterTypes)?;
    checkBounds(c, parameterTypes.view(), arguments, span)?;
    if (c.types.structs[definition as usize].isInteriorMutable) {
        for (a in arguments) {
            if (c.types.isScoped(a)) {
                // The raw-pointer rule of §27.1 at the type: a cell's contents never hold loans (ADR 0084 §2.1).
                var message = Vector<u8>.create();
                appendText(mut message, "a cell cannot hold ")?;
                appendQuotedType(mut message, c, a)?;
                appendText(
                    mut message,
                    ", which holds loans; hold a raw pointer or an owned value instead (type-system.md §41.1; ADR 0084 §2.1)",
                )?;
                c.error(cellOfLoans(), span.start, span.end, message)?;
            }
        }
    }
    // Its template's instances alone: a scan of every struct was quadratic in the instances.
    let known = instancesOf(c.structInstances, template)?;
    for (k in known.view()) {
        let s = c.structs[k as usize];
        if (s.template == template && sameTypes(
            c,
            c.types.structs[c.types.info(s.typ).structDef as usize].typeArguments,
            arguments,
        )) {
            return Ok(truncate<u32>(k));
        }
    }
    let item = c.front.ast.items[entry.item as usize];
    let symbol = c.front.ast.idents[item.name as usize].symbol;
    var text = Vector<u8>.create();
    qualifiedName(c, entry.file, c.name(symbol), mut text)?; // QualifiedIn(template.Source, …)
    var name = Vector<u8>.create();
    appendInstanceName(mut name, c, text.view(), arguments)?;
    let hasRegions = c.types.structs[definition as usize].hasRegionParameters;
    let typ = c.types.createStruct(name.view(), entry.item, entry.file, hasRegions)?;
    let instanceDefinition = c.types.info(typ).structDef;
    let list = c.types.addList(arguments)?;
    c.types.structs[instanceDefinition as usize].typeArguments = list;
    c.types.structs[instanceDefinition as usize].isThreadSafe = c.types.structs[definition as usize].isThreadSafe;
    c.types.structs[instanceDefinition as usize].isInteriorMutable =
        c.types.structs[definition as usize].isInteriorMutable;

    var pairs = Vector<EnvPair>.create();
    zipEnvironment(c, itemTypeParameters(c, entry.item), arguments, mut pairs)?;
    let env = storeEnvironment(c, pairs.view())?;
    c.structs.push(StructEntry { item: entry.item, file: entry.file, typ: typ, environment: env, template: template })?;
    let index = truncate<u32>(c.structs.length - 1);
    addInstance(mut c.structInstances, template, index)?;
    if (c.membersResolved) {
        c.instantiating += 1;
        let mark = diagnosticsMark(c);
        resolveStructMembers(c, index)?; // checked in the generic version
        let file = c.file;
        endInstance(c, mark, arguments, text.view(), file, span, none())?;
        c.instantiating -= 1;
        finishLateTypes(c)?;
    }
    if (c.implsReady) {
        attachGenericImpls(c, typ)?; // ADR 0054
    }
    noteBoundedEntry(c, index, false)?; // ADR 0130
    return Ok(index);
}

/// As instantiateStruct, for enums (InstantiateEnum).
fn instantiateEnum(c: borrow mut Checker, template: u32, arguments: Slice<u32>, span: Span) -> Result<u32, AllocError> {
    let entry = c.enums[template as usize];
    let definition = c.types.info(entry.typ).enumDef;
    let parameters = c.types.enums[definition as usize].typeArguments;
    if (sameTypes(c, parameters, arguments)) {
        return Ok(template);
    }
    var parameterTypes = Vector<u32>.create();
    listTypes(c, parameters, mut parameterTypes)?;
    checkBounds(c, parameterTypes.view(), arguments, span)?;
    let known = instancesOf(c.enumInstances, template)?;
    for (k in known.view()) {
        let e = c.enums[k as usize];
        if (e.template == template && sameTypes(
            c,
            c.types.enums[c.types.info(e.typ).enumDef as usize].typeArguments,
            arguments,
        )) {
            return Ok(truncate<u32>(k));
        }
    }
    let item = c.front.ast.items[entry.item as usize];
    let symbol = c.front.ast.idents[item.name as usize].symbol;
    var text = Vector<u8>.create();
    qualifiedName(c, entry.file, c.name(symbol), mut text)?; // QualifiedIn(template.Source, …)
    var name = Vector<u8>.create();
    appendInstanceName(mut name, c, text.view(), arguments)?;
    let hasRegions = c.types.enums[definition as usize].hasRegionParameters;
    let typ = c.types.createEnum(name.view(), entry.item, entry.file, hasRegions)?;
    let instanceDefinition = c.types.info(typ).enumDef;
    let list = c.types.addList(arguments)?;
    c.types.enums[instanceDefinition as usize].typeArguments = list;
    var pairs = Vector<EnvPair>.create();
    zipEnvironment(c, itemTypeParameters(c, entry.item), arguments, mut pairs)?;
    let env = storeEnvironment(c, pairs.view())?;
    c.enums.push(
        EnumEntry {
            item: entry.item,
            file: entry.file,
            typ: typ,
            builtin: none(),
            environment: env,
            template: template,
        },
    )?;
    addInstance(mut c.enumInstances, template, truncate<u32>(c.enums.length - 1))?;
    let index = truncate<u32>(c.enums.length - 1);
    if (c.membersResolved) {
        c.instantiating += 1;
        let mark = diagnosticsMark(c);
        resolveEnumVariants(c, index)?;
        let file = c.file;
        endInstance(c, mark, arguments, text.view(), file, span, none())?;
        c.instantiating -= 1;
        finishLateTypes(c)?;
    }
    if (c.implsReady) {
        attachGenericImpls(c, typ)?; // ADR 0054
    }
    noteBoundedEntry(c, index, true)?; // ADR 0130
    return Ok(index);
}

/// Recursion, Copy and drop for types instantiated after the declaration phase, once the outermost instantiation is
/// complete (FinishLateTypes).
fn finishLateTypes(c: borrow mut Checker) -> Result<void, AllocError> {
    if (c.copyKnown && c.instantiating == 0) {
        checkStructRecursion(c)?;
        computeCopyAndDrop(c)?;
    }
    return Ok();
}

/// The instantiation of a generic function with `arguments` (InstantiateFunction, §20.4); none after N0266.
fn instantiateFunction(c: borrow mut Checker, g: u32, arguments: Slice<u32>, span: Span) -> Result<u32, AllocError> {
    let entry = c.genericFunctions[g as usize];
    if (sameTypes(c, entry.parameters, arguments)) {
        return Ok(entry.generic);
    }
    var parameterTypes = Vector<u32>.create();
    listTypes(c, entry.parameters, mut parameterTypes)?;
    checkBounds(c, parameterTypes.view(), arguments, span)?;
    for (k in 0..c.hir.functions.length) {
        let f = borrow c.hir.functions[k];
        if (f.genericEntry == g && sameTypes(c, f.typeArguments, arguments)) {
            return Ok(truncate<u32>(k));
        }
    }
    let decl = c.front.ast.functions[entry.syntax as usize];
    let symbol = c.front.ast.idents[decl.name as usize].symbol;
    let depth = (if (c.function == none()) 0u32 else c.hir.functions[c.function as usize].instantiationDepth) + 1;
    if (depth > 64) {
        var message = Vector<u8>.create();
        appendText(mut message, "instantiating ")?;
        appendQuotedName(mut message, c, symbol)?;
        appendText(mut message, " here makes more than 64 nested instantiations (polymorphic recursion?)")?;
        c.error(instantiationTooDeep(), span.start, span.end, message)?;
        return Ok(none());
    }
    var pairs = Vector<EnvPair>.create();
    for (k in 0..entry.ownerEnvironment.count) {
        pairs.push(c.envPairs[(entry.ownerEnvironment.start + k) as usize])?; // a generic method's struct's (ADR 0064)
    }
    zipEnvironment(c, decl.typeParameters, arguments, mut pairs)?;
    let env = storeEnvironment(c, pairs.view())?;
    let savedFile = c.file;
    {
        let fileToSet = entry.file;
        c.setFile(fileToSet);
    }
    // The generic version's signature was checked; the instantiation's would only repeat it (§20.3).
    var text = Vector<u8>.create();
    appendBytes(mut text, c.name(symbol))?;
    let mark = diagnosticsMark(c);
    let savedGenericMethod = c.genericMethod;
    c.genericMethod = entry.owner != none();
    // A bound's generic interface method is instantiated as a signature only (ADR 0086 §2.3).
    let instance = if (entry.signatureOnly) declareSignature(c, entry.syntax, entry.owner, env)? else declareFunctionIn(
        c,
        entry.syntax,
        entry.owner,
        env,
    )?;
    c.genericMethod = savedGenericMethod;
    endInstance(c, mark, arguments, text.view(), savedFile, span, none())?;
    c.setFile(savedFile);
    let list = c.types.addList(arguments)?;
    c.hir.functions[instance as usize].typeArguments = list;
    c.hir.functions[instance as usize].instantiationDepth = depth;
    c.hir.functions[instance as usize].siteFile = savedFile;
    c.hir.functions[instance as usize].siteStart = span.start;
    c.hir.functions[instance as usize].siteEnd = span.end;
    c.hir.functions[instance as usize].genericEntry = g;
    return Ok(instance);
}

/// A method with type parameters of its own (ADR 0064 §1, ADR 0086 §2.3), of an impl, an interface's default or a
/// bound: its generic version, declared with its own parameters opaque after `ownerEnvironment`'s, and the
/// GenericFunctionEntry its calls instantiate (HirFunction.methodTemplate). `signatureOnly` for a bound's signature.
fn declareGenericMethod(
    c: borrow mut Checker,
    f: u32,
    owner: u32,
    ownerEnvironment: Range,
    signatureOnly: bool,
) -> Result<u32, AllocError> {
    var parameters = Vector<u32>.create();
    var pairs = Vector<EnvPair>.create();
    for (k in 0..ownerEnvironment.count) {
        pairs.push(c.envPairs[(ownerEnvironment.start + k) as usize])?;
    }
    let saved = enterEnvironment(c, ownerEnvironment)?;
    let ownSyntax = c.front.ast.functions[f as usize].typeParameters;
    declareTypeParameters(c, ownSyntax, mut parameters, mut pairs)?;
    restoreEnvironment(c, saved);
    let env = storeEnvironment(c, pairs.view())?;
    let list = c.types.addList(parameters.view())?;
    let savedGenericMethod = c.genericMethod;
    c.genericMethod = true;
    let function = if (signatureOnly) declareSignature(c, f, owner, env)? else declareFunctionIn(c, f, owner, env)?;
    c.genericMethod = savedGenericMethod;
    c.genericFunctions.push(GenericFunctionEntry {
        syntax: f,
        file: c.file,
        generic: function,
        parameters: list,
        owner: owner,
        ownerEnvironment: ownerEnvironment,
        signatureOnly: signatureOnly,
    })?;
    c.hir.functions[function as usize].methodTemplate = truncate<u32>(c.genericFunctions.length - 1);
    return Ok(function);
}

// ---- inference ----

struct Found {
    parameter: u32;
    typ: u32;
}

fn foundFor(found: borrow Vector<Found>, parameter: u32) -> u32 {
    for (f in found.view()) {
        if (f.parameter == parameter) {
            return f.typ;
        }
    }
    return none();
}

/// Matches a declared type that mentions `parameters` against an actual type, recording what each parameter must be
/// (Unify, §20.2). Mismatches are not reported here: the real check follows.
fn unify(
    c: borrow mut Checker,
    declared: u32,
    actual: u32,
    parameters: Slice<u32>,
    found: borrow mut Vector<Found>,
) -> Result<void, AllocError> {
    if (c.types.isBottom(actual)) {
        return Ok();
    }
    for (p in parameters) {
        if (p == declared) {
            if (foundFor(found, declared) == none()) {
                found.push(Found { parameter: declared, typ: actual })?;
            }
            return Ok();
        }
    }
    let d = c.types.info(declared);
    let a = c.types.info(actual);
    if (c.types.is(declared, TypeKind.Reference)) {
        // An argument for a `borrow T` parameter is borrowed implicitly.
        let inner = if (c.types.is(actual, TypeKind.Reference)) a.pointee else actual;
        return unify(c, d.pointee, inner, parameters, found);
    }
    if (c.types.is(actual, TypeKind.Box) && !c.types.is(declared, TypeKind.Box)) {
        return unify(c, declared, a.pointee, parameters, found); // a box converts to its contents (§18.2)
    }
    if (typeKindIndex(d.kind) != typeKindIndex(a.kind)) {
        return Ok();
    }
    if (c.types.is(declared, TypeKind.Struct)) {
        let declaredItem = c.types.structs[d.structDef as usize].item;
        let declaredArguments = c.types.structs[d.structDef as usize].typeArguments;
        let actualItem = c.types.structs[a.structDef as usize].item;
        let actualArguments = c.types.structs[a.structDef as usize].typeArguments;
        if (declaredItem != none() && declaredItem == actualItem) {
            for (k in 0..declaredArguments.count) {
                if (k < actualArguments.count) {
                    let declaredArgument = c.types.listAt(declaredArguments, k);
                    let actualArgument = c.types.listAt(actualArguments, k);
                    unify(c, declaredArgument, actualArgument, parameters, found)?;
                }
            }
        }
        return Ok();
    }
    if (c.types.is(declared, TypeKind.Enum)) {
        let de = d.enumDef as usize;
        let ae = a.enumDef as usize;
        let declaredOk = c.types.enums[de].resultOk;
        let actualOk = c.types.enums[ae].resultOk;
        if (declaredOk != none() && actualOk != none()) {
            let declaredErr = c.types.enums[de].resultErr;
            let actualErr = c.types.enums[ae].resultErr;
            unify(c, declaredOk, actualOk, parameters, found)?;
            return unify(c, declaredErr, actualErr, parameters, found);
        }
        let declaredOption = c.types.enums[de].optionType;
        let actualOption = c.types.enums[ae].optionType;
        if (declaredOption != none() && actualOption != none()) {
            return unify(c, declaredOption, actualOption, parameters, found);
        }
        let declaredItem = c.types.enums[de].item;
        let declaredArguments = c.types.enums[de].typeArguments;
        let actualArguments = c.types.enums[ae].typeArguments;
        if (declaredItem != none() && declaredItem == c.types.enums[ae].item) {
            for (k in 0..declaredArguments.count) {
                if (k < actualArguments.count) {
                    let declaredArgument = c.types.listAt(declaredArguments, k);
                    let actualArgument = c.types.listAt(actualArguments, k);
                    unify(c, declaredArgument, actualArgument, parameters, found)?;
                }
            }
        }
        return Ok();
    }
    if (c.types.is(declared, TypeKind.Vector)) {
        if (c.types.isString(declared) == c.types.isString(actual)) {
            let declaredElement = c.types.info(d.pointee).element;
            let actualElement = c.types.info(a.pointee).element;
            return unify(c, declaredElement, actualElement, parameters, found);
        }
        return Ok();
    }
    if (c.types.is(declared, TypeKind.StableVector)) {
        let declaredElement = c.types.info(d.pointee).element;
        let actualElement = c.types.info(a.pointee).element;
        return unify(c, declaredElement, actualElement, parameters, found);
    }
    if (c.types.is(declared, TypeKind.SlotMap) || c.types.is(declared, TypeKind.Handle)) {
        return unify(c, d.element, a.element, parameters, found);
    }
    if (c.types.is(declared, TypeKind.Array) && d.lengthParameter != none()) {
        unifyLength(c, d.lengthParameter, actual, parameters, found)?; // `[T; N]` (ADR 0083 §2.5)
    }
    if (c.types.is(declared, TypeKind.Array) || c.types.is(declared, TypeKind.Box)) {
        let de = if (d.element != none()) d.element else d.pointee;
        let ae = if (a.element != none()) a.element else a.pointee;
        return unify(c, de, ae, parameters, found);
    }
    return Ok();
}

/// One (declared type, expression) pair for inference.
struct InferencePair {
    declared: u32;
    value: u32; // an expression
}

/// Type arguments for `parameters` (TypeArgumentsFor): from the explicit list, else from the expected instance, else
/// inferred from `pairs`. False after an error (reported).
fn typeArgumentsFor(
    c: borrow mut Checker,
    what: Slice<u8>,
    parameters: Slice<u32>,
    explicit: Range,
    expected: Range,
    hasExpected: bool,
    pairs: Slice<InferencePair>,
    span: Span,
    out: borrow mut Vector<u32>,
) -> Result<bool, AllocError> {
    if (explicit.count > 0) {
        if (explicit.count as usize != parameters.length) {
            var message = Vector<u8>.create();
            appendText(mut message, "'")?;
            appendBytes(mut message, what)?;
            appendText(mut message, "' takes ")?;
            appendDecimal(mut message, parameters.length as u64)?;
            appendText(mut message, " type argument(s), but ")?;
            appendDecimal(mut message, explicit.count as u64)?;
            appendText(mut message, " were given")?;
            c.error(argumentCount(), span.start, span.end, message)?;
            return Ok(false);
        }
        var bottom = false;
        for (k in 0..explicit.count) {
            let argumentSyntax = c.front.ast.at(explicit, k);
            let t = if (c.types.constParameterType(parameters[k as usize]) != none()) resolveConstArgument(
                c,
                parameters[k as usize],
                what,
                argumentSyntax,
            )? else c.resolveType(argumentSyntax, false)?;
            if (c.types.isBottom(t)) {
                bottom = true;
            }
            out.push(t)?;
        }
        return Ok(!bottom);
    }
    if (hasExpected) {
        listTypes(c, expected, out)?;
        return Ok(true);
    }
    var found = Vector<Found>.create();
    var erroneous = false;
    for (p in pairs) {
        let value = match (c.front.ast.exprs[p.value as usize]) {
            ExprNode.MutArg(operand) => operand,
            _ => p.value,
        };
        let mark = diagnosticsMark(c);
        let actual = synth(c, value, none())?;
        if (diagnosticsMark(c) > mark || c.isBottom(actual)) {
            erroneous = true;
        }
        dropDiagnosticsSince(c, mark);
        let actualType = c.typeOf(actual);
        unify(c, p.declared, actualType, parameters, mut found)?;
    }
    inferFromBounds(c, parameters, mut found)?; // ADR 0086 §2.7
    var missing = Vector<u32>.create();
    for (p in parameters) {
        if (foundFor(found, p) == none()) {
            missing.push(p)?;
        }
    }
    if (missing.length > 0 && erroneous) {
        // An argument has an error of its own, reported when the arguments are checked: inferring from it would
        // only add a misleading N0265 (ADR 0075 §2.16, G17).
        return Ok(false);
    }
    if (missing.length > 0) {
        var message = Vector<u8>.create();
        appendText(mut message, "cannot infer ")?;
        for (k in 0..missing.length) {
            if (k > 0) {
                appendText(mut message, ", ")?;
            }
            appendQuotedType(mut message, c, missing[k])?;
        }
        appendText(mut message, " for '")?;
        appendBytes(mut message, what)?;
        appendText(mut message, "' here; write the type arguments: '")?;
        appendBytes(mut message, what)?;
        appendText(mut message, "<…>'")?;
        c.error(cannotInferTypeArguments(), span.start, span.end, message)?;
        return Ok(false);
    }
    for (p in parameters) {
        out.push(foundFor(found, p))?;
    }
    return Ok(true);
}

/// Infers type parameters the arguments left open from a bound (§20.2, ADR 0086 §2.7): for `I: J<…T…>` where `I` is
/// known, if `I`'s type implements exactly one instantiation of `J`, its arguments give `T`. Repeated while it finds
/// more.
fn inferFromBounds(
    c: borrow mut Checker,
    parameters: Slice<u32>,
    found: borrow mut Vector<Found>,
) -> Result<void, AllocError> {
    for (round in 0..parameters.length) {
        let before = found.length;
        for (p in parameters) {
            let actual = foundFor(found, p);
            if (actual == none() || !c.types.is(p, TypeKind.TypeParameter)) {
                continue;
            }
            var bounds = Vector<u32>.create();
            for (b in c.types.typeParameters[c.types.info(p).typeParameter as usize].bounds.view()) {
                bounds.push(b)?;
            }
            for (bound in bounds.view()) {
                let b = c.types.bounds[bound as usize];
                var instantiations = Vector<Range>.create();
                instantiationsOf(c, actual, b.interfaceEntry, mut instantiations)?;
                if (instantiations.length != 1) {
                    continue;
                }
                for (a in 0..b.arguments.count) {
                    let declared = c.types.listAt(b.arguments, a);
                    let given = c.types.listAt(instantiations[0], a);
                    unify(c, declared, given, parameters, found)?;
                }
            }
        }
        if (found.length == before) {
            break;
        }
    }
    return Ok();
}

/// The argument lists of the instantiations of interface `entry` that `typ` implements: its impls', a `dyn`'s
/// interface and supertraits, or a type parameter's bounds; each once.
fn instantiationsOf(
    c: borrow mut Checker,
    typ: u32,
    entry: u32,
    out: borrow mut Vector<Range>,
) -> Result<void, AllocError> {
    var candidates = Vector<Range>.create();
    for (i in c.implementations.view()) {
        if (i.typ == typ && i.interfaceEntry == entry) {
            candidates.push(i.arguments)?;
        }
    }
    var bounds = Vector<u32>.create();
    if (c.types.isDyn(typ) && c.types.info(typ).dynInterface != none()) {
        let dynBound = c.types.info(typ).dynInterface;
        boundWithSupers(c, dynBound, mut bounds)?;
    } else if (c.types.is(typ, TypeKind.TypeParameter)) {
        for (b in c.types.typeParameters[c.types.info(typ).typeParameter as usize].bounds.view()) {
            bounds.push(b)?;
        }
    }
    for (b in bounds.view()) {
        if (c.types.bounds[b as usize].interfaceEntry == entry) {
            candidates.push(c.types.bounds[b as usize].arguments)?;
        }
    }
    for (candidate in candidates.view()) {
        var seen = false;
        for (o in out.view()) {
            if (sameLists(c, o, candidate)) {
                seen = true;
            }
        }
        if (!seen) {
            out.push(candidate)?;
        }
    }
    return Ok();
}

/// `f(args)` or `f<T>(args)` for a generic function (CheckGenericCall, §20.2): infer, instantiate, check.
fn checkGenericCall(
    c: borrow mut Checker,
    g: u32,
    nameSymbol: u32,
    typeArguments: Range,
    arguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    let entry = c.genericFunctions[g as usize];
    var parameterTypes = Vector<u32>.create();
    listTypes(c, entry.parameters, mut parameterTypes)?;
    var pairs = Vector<InferencePair>.create();
    let genericParameters = c.hir.functions[entry.generic as usize].parameters.length;
    for (k in 0..arguments.count) {
        if ((k as usize) < genericParameters) {
            let local = c.hir.functions[entry.generic as usize].parameters[k as usize];
            pairs.push(
                InferencePair { declared: c.hir.locals[local as usize].typ, value: c.front.ast.at(arguments, k) },
            )?;
        }
    }
    var text = Vector<u8>.create();
    appendBytes(mut text, c.name(nameSymbol))?;
    var found = Vector<u32>.create();
    let ok = typeArgumentsFor(
        c,
        text.view(),
        parameterTypes.view(),
        typeArguments,
        emptyRange(),
        false,
        pairs.view(),
        span,
        mut found,
    )?;
    if (ok && found.length == 1 && isFieldlessEnum(c, found[0]) && isDerivedKeyHelper(c, g, nameSymbol) &&
        !boundsHold(c, parameterTypes[0], found[0])?) {
        return derivedIndexCall(c, g, arguments, span); // a fieldless-enum field without its own derive
    }
    let instance = if (ok) instantiateFunction(c, g, found.view(), span)? else none();
    if (instance == none()) {
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    return checkUserCall(c, instance, arguments, span);
}

/// Is `g` lib/std's `deriveHash` or `deriveCompare`, which the derived `HashKey` and `OrderKey` call per field?
fn isDerivedKeyHelper(c: borrow Checker, g: u32, nameSymbol: u32) -> bool {
    let file = c.genericFunctions[g as usize].file;
    if ((file as usize) >= c.filePaths.length || !startsWithText(c.filePaths[file as usize].view(), "lib/std/")) {
        return false;
    }
    return sameText(c.name(nameSymbol), "deriveHash") || sameText(c.name(nameSymbol), "deriveCompare");
}

/// Does `argument` satisfy the interface bounds of type parameter `parameter` (as checkBounds, without reporting)?
fn boundsHold(c: borrow mut Checker, parameter: u32, argument: u32) -> Result<bool, AllocError> {
    var mapping = Vector<TypeMapping>.create();
    mapping.push(TypeMapping { from: parameter, to: argument })?;
    let boundCount = c.types.typeParameters[c.types.info(parameter).typeParameter as usize].bounds.length;
    for (b in 0..boundCount) {
        let bound = c.types.typeParameters[c.types.info(parameter).typeParameter as usize].bounds[b];
        let original = c.types.bounds[bound as usize];
        var substituted = Vector<u32>.create();
        for (a in 0..original.arguments.count) {
            let argumentType = c.types.listAt(original.arguments, a);
            substituted.push(substitute(c, argumentType, mapping.view())?)?;
        }
        var boundName = Vector<u8>.create();
        appendBytes(mut boundName, c.types.rangeText(original.name))?;
        let required = c.types.addBound(original.interfaceEntry, boundName.view(), substituted.view())?;
        if (!implements(c, argument, required)) {
            return Ok(false);
        }
    }
    return Ok(true);
}

/// `deriveHash(this.mode, mut h)` or `deriveCompare(l0, r0)` on a fieldless enum without `HashKey` or `OrderKey`
/// (ADR 0087 §2.3): its variant index as a `u32` is hashed or compared, through the `u32` instance.
fn derivedIndexCall(c: borrow mut Checker, g: u32, arguments: Range, span: Span) -> Result<u32, AllocError> {
    let u32Type = c.types.u32;
    let types = [u32Type];
    let instance = instantiateFunction(c, g, types[..], span)?;
    if (instance == none()) {
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let reference = c.types.referenceTo(u32Type, false)?;
    var values = Vector<u32>.create();
    for (k in 0..arguments.count) {
        let argument = c.front.ast.at(arguments, k);
        let local = c.hir.functions[instance as usize].parameters[k as usize];
        let parameterType = c.hir.locals[local as usize].typ;
        if (parameterType != reference) {
            values.push(checkArgument(c, argument, parameterType)?)?;
            continue;
        }
        let value = synth(c, argument, none())?;
        let argumentSpan = c.spanOf(value);
        let lent = if (c.types.is(c.typeOf(value), TypeKind.Reference)) value else borrowOperand(c, value)?;
        let lentList = [lent];
        let list = c.hir.list(lentList[..])?;
        let index = c.expr(
            HirExpr.BuiltinCall(bfVariantIndex(), list),
            u32Type,
            argumentSpan.start,
            argumentSpan.end,
        )?;
        values.push(c.expr(HirExpr.BorrowTemp(false, index), reference, argumentSpan.start, argumentSpan.end)?)?;
    }
    let returnType = c.hir.functions[instance as usize].returnType;
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.Call(instance, list), returnType, span.start, span.end);
}

/// A generic method's instance for a call (ADR 0064 §1): the type arguments written, or inferred from `arguments`
/// against its parameters after the first `skip` (the receiver); none (reported) when they cannot be had.
fn instantiateMethod(
    c: borrow mut Checker,
    g: u32,
    nameSymbol: u32,
    typeArguments: Range,
    arguments: Range,
    skip: usize,
    span: Span,
) -> Result<u32, AllocError> {
    let entry = c.genericFunctions[g as usize];
    var parameterTypes = Vector<u32>.create();
    listTypes(c, entry.parameters, mut parameterTypes)?;
    var pairs = Vector<InferencePair>.create();
    let declared = c.hir.functions[entry.generic as usize].parameters.length;
    for (k in 0..arguments.count) {
        let index = (k as usize) + skip;
        if (index < declared) {
            let local = c.hir.functions[entry.generic as usize].parameters[index];
            pairs.push(
                InferencePair { declared: c.hir.locals[local as usize].typ, value: c.front.ast.at(arguments, k) },
            )?;
        }
    }
    var text = Vector<u8>.create();
    appendBytes(mut text, c.name(nameSymbol))?;
    var found = Vector<u32>.create();
    let ok = typeArgumentsFor(
        c,
        text.view(),
        parameterTypes.view(),
        typeArguments,
        emptyRange(),
        false,
        pairs.view(),
        span,
        mut found,
    )?;
    return Ok(if (ok) instantiateFunction(c, g, found.view(), span)? else none());
}

/// `S<A>` or `E<A>` for a user generic struct or enum (ResolveGenericItemType's instantiation, after the regions).
fn instantiateItemType(
    c: borrow mut Checker,
    isStruct: bool,
    index: u32,
    arguments: Slice<u32>,
    span: Span,
) -> Result<u32, AllocError> {
    if (isStruct) {
        let entry = instantiateStruct(c, index, arguments, span)?;
        return Ok(c.structs[entry as usize].typ);
    }
    let entry = instantiateEnum(c, index, arguments, span)?;
    return Ok(c.enums[entry as usize].typ);
}

/// The struct entry of an instantiation (or the template itself) of `template` (StructEntryFor).
fn structEntryFor(c: borrow Checker, template: u32, typ: u32) -> u32 {
    if (c.structs[template as usize].typ == typ) {
        return template;
    }
    for (k in 0..c.structs.length) {
        if (c.structs[k].template == template && c.structs[k].typ == typ) {
            return truncate<u32>(k);
        }
    }
    return none();
}

fn enumEntryFor(c: borrow Checker, template: u32, typ: u32) -> u32 {
    if (c.enums[template as usize].typ == typ) {
        return template;
    }
    match (c.enumInstances.get(Word { value: template as u64 })) {
        Some(list) => {
            for (k in list.view()) {
                if (c.enums[k as usize].template == template && c.enums[k as usize].typ == typ) {
                    return k;
                }
            }
        }
        null => {}
    }
    return none();
}

/// The instances of `template` (indices into c.structs or c.enums), in the order they were made.
fn instancesOf(map: borrow Map<Word, Vector<u32>>, template: u32) -> Result<Vector<u32>, AllocError> {
    var out = Vector<u32>.create();
    match (map.get(Word { value: template as u64 })) {
        Some(list) => {
            for (k in list.view()) {
                out.push(k)?;
            }
        }
        null => {}
    }
    return Ok(out);
}

fn addInstance(map: borrow mut Map<Word, Vector<u32>>, template: u32, index: u32) -> Result<void, AllocError> {
    let key = Word { value: template as u64 };
    match (map.getMut(key)) {
        Some(list) => {
            list.push(index)?;
            return Ok();
        }
        null => {}
    }
    var list = Vector<u32>.create();
    list.push(index)?;
    map.put(key, list)?;
    return Ok();
}

/// Is the struct or enum entry a generic declaration (its syntax has type parameters)?
fn isGenericItem(c: borrow Checker, item: u32) -> bool => item != none() && itemTypeParameters(c, item).count > 0;

/// The struct whose static function `S.f(…)` or `S<T>.f(…)` names (StaticOwner, §20.2); none after an error.
fn staticOwner(
    c: borrow mut Checker,
    index: u32,
    target: u32,
    nameSymbol: u32,
    typeArguments: Range,
) -> Result<u32, AllocError> {
    let entry = c.structs[index as usize];
    let targetSpan = c.front.ast.exprSpans[target as usize];
    if (!isGenericItem(c, entry.item)) {
        if (typeArguments.count > 0) {
            var message = Vector<u8>.create();
            appendQuotedType(mut message, c, entry.typ)?;
            appendText(mut message, " is not generic; write it without type arguments")?;
            c.error(unknownType(), targetSpan.start, targetSpan.end, message)?;
            return Ok(none());
        }
        return Ok(index);
    }
    if (typeArguments.count == 0) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, nameSymbol)?;
        appendText(mut message, " is generic: write its type arguments, e.g. '")?;
        appendBytes(mut message, c.name(nameSymbol))?;
        appendText(mut message, "<i32>.…'")?;
        c.error(cannotInferTypeArguments(), targetSpan.start, targetSpan.end, message)?;
        return Ok(none());
    }
    var itemName = Vector<u8>.create();
    appendBytes(mut itemName, c.name(nameSymbol))?;
    let typ = resolveRegionItemType(c, entry.typ, entry.item, itemName.view(), typeArguments, targetSpan, true, index)?;
    if (c.types.isBottom(typ)) {
        return Ok(none());
    }
    return Ok(structEntryFor(c, index, typ));
}

// ---- `dyn I` as a type argument (ADR 0064 §3.1) ----

/// Whether a value of type `t` holds a `dyn` value by value, not behind a reference or a box: `dyn I` is unsized.
fn holdsBareDyn(c: borrow Checker, t: u32, depth: u32) -> bool {
    if (t == none() || depth > 32) {
        return false;
    }
    if (c.types.isDyn(t)) {
        return true;
    }
    if (c.types.is(t, TypeKind.Reference) || c.types.is(t, TypeKind.Box) || c.types.is(t, TypeKind.RawPointer)) {
        return false; // behind a reference or a box: the dyn value's size is its table's
    }
    let info = c.types.info(t);
    if (c.types.is(t, TypeKind.Array)) {
        return holdsBareDyn(c, info.element, depth + 1);
    }
    if (c.types.is(t, TypeKind.Vector) || c.types.is(t, TypeKind.StableVector)) {
        return holdsBareDyn(c, c.types.info(info.pointee).element, depth + 1);
    }
    if (info.structDef != none()) {
        for (field in c.types.structs[info.structDef as usize].fields.view()) {
            if (holdsBareDyn(c, c.types.fields[field as usize].typ, depth + 1)) {
                return true;
            }
        }
        return false;
    }
    if (info.enumDef != none()) {
        let e = borrow c.types.enums[info.enumDef as usize];
        for (k in 0..e.typeArguments.count) {
            if (holdsBareDyn(c, c.types.listAt(e.typeArguments, k), depth + 1)) {
                return true;
            }
        }
        if (e.optionType != none() && holdsBareDyn(c, e.optionType, depth + 1)) {
            return true;
        }
        if (e.resultOk != none() && (holdsBareDyn(
            c,
            e.resultOk,
            depth + 1,
        ) || holdsBareDyn(c, e.resultErr, depth + 1))) {
            return true;
        }
    }
    return false;
}

/// An instance with a `dyn` type argument (ADR 0064 §3.1): its parameters, locals and result must hold the `dyn`
/// value only behind references (N0274). Reported inside the instance's check, so endInstance gives it at the use.
fn checkDynInstance(c: borrow mut Checker, function: u32, arguments: Slice<u32>) -> Result<void, AllocError> {
    var hasDyn = false;
    for (a in arguments) {
        if (c.types.isDyn(a)) {
            hasDyn = true;
        }
    }
    if (!hasDyn) {
        return Ok();
    }
    let f = borrow c.hir.functions[function as usize];
    var offending = none();
    var offendingType = none();
    if (holdsBareDyn(c, f.returnType, 0)) {
        offendingType = f.returnType;
    }
    for (local in f.locals.view()) {
        let l = c.hir.locals[local as usize];
        if (offendingType == none() && holdsBareDyn(c, l.typ, 0)) {
            offending = local;
            offendingType = l.typ;
        }
    }
    if (offendingType == none()) {
        return Ok();
    }
    let syntax = c.front.ast.functions[f.syntax as usize];
    let start = if (offending == none()) syntax.start else c.hir.locals[offending as usize].start;
    let end = if (offending == none()) syntax.start + 1 else c.hir.locals[offending as usize].end;
    var message = Vector<u8>.create();
    appendText(
        mut message,
        "a 'dyn' type can be a type argument only where the generic uses it behind references; here a value of type ",
    )?;
    appendQuotedType(mut message, c, offendingType)?;
    appendText(mut message, " holds one by value, and a 'dyn' value is unsized (ADR 0064 §3.1)")?;
    return c.error(scopedTypeArgument(), start, end, message);
}

/// A user type instantiated with a `dyn` argument before its members were known (ADR 0064 §3.1).
struct PendingDynInstance {
    typ: u32;
    argument: u32;
    file: u32;
    start: u32;
    end: u32;
}

fn reportBareDynInstance(c: borrow mut Checker, instance: u32, argument: u32, span: Span) -> Result<void, AllocError> {
    var message = Vector<u8>.create();
    appendQuotedType(mut message, c, instance)?;
    appendText(mut message, " holds a ")?;
    appendQuotedType(mut message, c, argument)?;
    appendText(
        mut message,
        " by value, which has no size the compiler knows: a 'dyn' type argument must be used behind a reference or a box (ADR 0064 §3.1, type-system.md §37.1)",
    )?;
    return c.error(dynNotBehindPointer(), span.start, span.end, message);
}

fn checkPendingDynInstances(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (k in 0..c.pendingDynInstances.length) {
        let p = c.pendingDynInstances[k];
        if (holdsBareDyn(c, p.typ, 0)) {
            {
                let fileToSet = p.file;
                c.setFile(fileToSet);
            }
            reportBareDynInstance(c, p.typ, p.argument, Span { start: p.start, end: p.end })?;
        }
    }
    c.setFile(saved);
    return Ok();
}
