// MergeInherentImpls (ADR 0064 §1): `impl S { … }` and `impl<T> S<T> { … }` blocks add methods to a struct of the same
// package, as if written in its body. They are merged before anything is declared, so every later pass (a generic
// struct's methods per instance, duplicate members, generic methods, visibility) sees one list of functions.
// An enum has no body to merge into: the functions of its `impl E { … }` blocks are listed in Checker.enumMethods and
// declared for the enum and for each of its instances when their variants are resolved (ADR 0107).

fn inherentImplError() -> u32 => 267;

/// A method merged from an `impl S { … }` block, and the file that block is in.
struct MethodFile {
    function: u32;
    file: u32;
}

/// A function of an `impl E { … }` block of an enum (ADR 0107): the enum's item, the function and the block's file.
struct EnumMethod {
    item: u32;     // the enum's AST item
    function: u32; // Ast.functions
    file: u32;
}

/// The function named `symbol` that an `impl E { … }` block gives the enum item `item` (Ast.functions), or none.
fn enumMethodNamed(c: borrow Checker, item: u32, symbol: u32) -> u32 {
    for (m in c.enumMethods.view()) {
        if (m.item == item &&
            c.front.ast.idents[c.front.ast.functions[m.function as usize].name as usize].symbol == symbol) {
            return m.function;
        }
    }
    return none();
}

/// Is the AST function `f` a function of an enum's `impl E { … }` block?
fn isEnumMethod(c: borrow Checker, f: u32) -> bool {
    for (m in c.enumMethods.view()) {
        if (m.function == f) {
            return true;
        }
    }
    return false;
}

/// The enum item whose `impl E { … }` block declares the function `f` of `owner` (ADR 0107), or none: for a struct's
/// method, an interface's, or a free function.
fn enumOfMethod(c: borrow Checker, f: u32, owner: u32) -> u32 {
    if (owner == none() || !c.types.is(owner, TypeKind.Enum) || !isEnumMethod(c, f)) {
        return none();
    }
    let definition = c.types.info(owner).enumDef;
    return if (definition == none()) none() else c.types.enums[definition as usize].item;
}

/// The file of struct method `f` (an AST function): its `impl` block's when merged from one, else `structFile`.
fn methodFileOf(c: borrow Checker, f: u32, structFile: u32) -> u32 {
    for (m in c.methodFiles.view()) {
        if (m.function == f) {
            return m.file;
        }
    }
    return structFile;
}

/// The struct item named `symbol` in package `package`, or none.
fn structItemNamed(c: borrow Checker, symbol: u32, package: u32) -> u32 {
    for (u in 0..c.front.ast.units.length) {
        if (packageOfFile(c, c.front.ast.units[u].file) != package) {
            continue;
        }
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Struct(_) => {
                    if (c.front.ast.idents[c.front.ast.items[item as usize].name as usize].symbol == symbol) {
                        return item;
                    }
                }
                _ => {}
            }
        }
    }
    return none();
}

/// The enum item named `symbol` in package `package`, or none.
fn enumItemNamed(c: borrow Checker, symbol: u32, package: u32) -> u32 {
    for (u in 0..c.front.ast.units.length) {
        if (packageOfFile(c, c.front.ast.units[u].file) != package) {
            continue;
        }
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Enum(_, _, _) => {
                    if (c.front.ast.idents[c.front.ast.items[item as usize].name as usize].symbol == symbol) {
                        return item;
                    }
                }
                _ => {}
            }
        }
    }
    return none();
}

fn enumIsGeneric(c: borrow Checker, item: u32) -> bool => match (c.front.ast.items[item as usize].kind) {
    ItemKind.Enum(_, typeParameters, regionParameters) => typeParameters.count > 0 || regionParameters.count > 0,
    _ => false,
};

/// The symbols of a list of type parameters (Ast.typeParameters), in order.
fn parameterSymbols(c: borrow Checker, list: Range, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    for (k in 0..list.count) {
        let p = c.front.ast.typeParameters[c.front.ast.at(list, k) as usize];
        out.push(c.front.ast.idents[p.name as usize].symbol)?;
    }
    return Ok();
}

/// Whether the impl's target `S<…>` names the struct's or enum's own parameters in order (`impl<T> S<T>`,
/// `impl<region r> S<r>`).
fn sameParameters(
    c: borrow Checker,
    implTypes: Range,
    implRegions: Range,
    ownTypes: Range,
    ownRegions: Range,
) -> Result<bool, AllocError> {
    var a = Vector<u32>.create();
    var b = Vector<u32>.create();
    parameterSymbols(c, implTypes, mut a)?;
    parameterSymbols(c, ownTypes, mut b)?;
    var ar = Vector<u32>.create();
    var br = Vector<u32>.create();
    parameterSymbols(c, implRegions, mut ar)?;
    parameterSymbols(c, ownRegions, mut br)?;
    if (a.length != b.length || ar.length != br.length) {
        return Ok(false);
    }
    for (k in 0..a.length) {
        if (a[k] != b[k]) {
            return Ok(false);
        }
    }
    for (k in 0..ar.length) {
        if (ar[k] != br[k]) {
            return Ok(false);
        }
    }
    return Ok(true);
}

fn mergeInherentImpls(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (u in 0..c.front.ast.units.length) {
        let file = c.front.ast.units[u].file;
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            let entry = c.front.ast.items[item as usize];
            match (entry.kind) {
                ItemKind.InherentImpl(target, functions, typeParameters, regionParameters, constants) => {
                    c.setFile(file);
                    let span = c.front.ast.typeSpans[target as usize];
                    let nameIdent = match (c.front.ast.types[target as usize]) {
                        TypeNode.Named(q) => if (q.parts.count == 1) c.front.ast.at(q.parts, 0) else none(),
                        TypeNode.Generic(q, _) => if (q.parts.count == 1) c.front.ast.at(q.parts, 0) else none(),
                        _ => none(),
                    };
                    let symbol = if (nameIdent == none()) none() else c.front.ast.idents[nameIdent as usize].symbol;
                    let structItem = if (symbol == none()) none() else structItemNamed(
                        c,
                        symbol,
                        packageOfFile(c, file),
                    );
                    let enumItem = if (symbol == none() || structItem != none()) none() else enumItemNamed(
                        c,
                        symbol,
                        packageOfFile(c, file),
                    );
                    if (enumItem != none()) {
                        // `impl E { … }`: an enum's functions (ADR 0107) and constants (ADR 0074 §2.7).
                        let enumTypes = match (c.front.ast.items[enumItem as usize].kind) {
                            ItemKind.Enum(_, t, _) => t,
                            _ => emptyRange(),
                        };
                        let enumRegions = match (c.front.ast.items[enumItem as usize].kind) {
                            ItemKind.Enum(_, _, r) => r,
                            _ => emptyRange(),
                        };
                        if (functions.count > 0 &&
                            !sameParameters(c, typeParameters, regionParameters, enumTypes, enumRegions)?) {
                            var message = Vector<u8>.create();
                            appendText(
                                mut message,
                                "an 'impl' of an enum's methods names the enum with its own parameters, in order: 'impl<T> E<T>' for 'enum E<T>' (ADR 0107)",
                            )?;
                            c.error(inherentImplError(), span.start, span.end, message)?;
                            continue;
                        }
                        for (j in 0..functions.count) {
                            let f = c.front.ast.at(functions, j);
                            c.enumMethods.push(EnumMethod { item: enumItem, function: f, file: file })?;
                        }
                        if (functions.count > 0 && writesBounds(c, typeParameters)) {
                            c.boundedImpls.push(BoundedImpl {
                                item: enumItem,
                                isEnum: true,
                                file: file,
                                typeParameters: typeParameters,
                                functions: functions,
                                start: span.start,
                                end: span.end,
                                conditional: false,
                                parameters: emptyRange(),
                                checkedIn: none(),
                            })?;
                        }
                        if (typeParameters.count > 0 || regionParameters.count > 0 || enumIsGeneric(c, enumItem)) {
                            genericConstants(c, constants)?;
                        } else {
                            addMemberConstants(c, enumItem, file, constants)?;
                        }
                        continue;
                    }
                    if (structItem == none()) {
                        var message = Vector<u8>.create();
                        appendText(
                            mut message,
                            "an 'impl' without 'for' adds methods to a struct or enum of this package; this names none (ADR 0064 §1, ADR 0107)",
                        )?;
                        c.error(inherentImplError(), span.start, span.end, message)?;
                        continue;
                    }
                    let structIndex = match (c.front.ast.items[structItem as usize].kind) {
                        ItemKind.Struct(s) => s,
                        _ => 0,
                    };
                    let s = c.front.ast.structs[structIndex as usize];
                    if (!sameParameters(c, typeParameters, regionParameters, s.typeParameters, s.regionParameters)?) {
                        var message = Vector<u8>.create();
                        appendText(
                            mut message,
                            "an 'impl' of a struct's methods names the struct with its own parameters, in order: 'impl<T> S<T>' for 'struct S<T>' (ADR 0064 §1)",
                        )?;
                        c.error(inherentImplError(), span.start, span.end, message)?;
                        continue;
                    }
                    // The struct's functions, then the block's: one list in Ast.lists.
                    var merged = Vector<u32>.create();
                    for (j in 0..s.functions.count) {
                        merged.push(c.front.ast.at(s.functions, j))?;
                    }
                    for (j in 0..functions.count) {
                        let f = c.front.ast.at(functions, j);
                        merged.push(f)?;
                        // The method keeps its own file: its offsets are into this file, not the struct's.
                        c.methodFiles.push(MethodFile { function: f, file: file })?;
                    }
                    let list = c.front.ast.list(merged)?;
                    c.front.ast.structs[structIndex as usize].functions = list;
                    if (functions.count > 0 && writesBounds(c, typeParameters)) {
                        c.boundedImpls.push(BoundedImpl {
                            item: structItem,
                            isEnum: false,
                            file: file,
                            typeParameters: typeParameters,
                            functions: functions,
                            start: span.start,
                            end: span.end,
                            conditional: false,
                            parameters: emptyRange(),
                            checkedIn: none(),
                        })?;
                    }
                    if (s.typeParameters.count > 0 || s.regionParameters.count > 0) {
                        genericConstants(c, constants)?;
                    } else {
                        addMemberConstants(c, structItem, file, constants)?;
                    }
                }
                _ => {}
            }
        }
    }
    c.setFile(saved);
    return Ok();
}

/// The attributes of the functions an enum's `impl E { … }` blocks give it (ADR 0107), read once per declaration as
/// a struct's methods' are (processMethodAttributes); `@placed` is a struct's.
fn processEnumMethodAttributes(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let savedFile = c.file;
    var k: usize = 0;
    var intoCount: u32 = 0;
    while (k < c.enumMethods.length) {
        let m = c.enumMethods[k];
        k += 1;
        if (m.item != item) {
            continue;
        }
        c.setFile(m.file);
        let words = "effects effectsOf context constant test into";
        var known = Vector<u32>.create();
        let attributes = c.front.ast.functions[m.function as usize].attributes;
        knownAttributes(c, attributes, "an enum's method", words, mut known)?;
        if (readIntoAttribute(c, m.function, known.view(), intoCount)?) {
            intoCount += 1; // ADR 0128
        }
        for (attribute in known.view()) {
            if (sameText(attributeName(c, attribute), "test")) {
                let a = c.front.ast.attributes[attribute as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "a test is a free function, not a method (ADR 0049 §3.1)")?;
                c.error(testShape(), a.start, a.end, message)?;
            }
        }
        readEffectAttributes(c, m.function, known.view())?;
    }
    c.setFile(savedFile);
    return Ok();
}

/// The functions an enum's `impl E { … }` blocks give it (ADR 0107), declared for the enum entry `index`: the
/// declaration's own type, whose bodies report, or an instance of a generic enum, as a generic struct's methods are
/// declared for each instance. They are recorded as an impl's methods are (Checker.implMethods), so a method call,
/// `E.f(…)` and `Self.f(…)` find them where they find an interface's. A name the enum already has, as a variant or
/// as a method of one of its impls, is N0228.
fn declareEnumMethods(c: borrow mut Checker, index: u32) -> Result<void, AllocError> {
    let entry = c.enums[index as usize];
    if (entry.item == none() || c.enumMethods.length == 0) {
        return Ok();
    }
    let definition = c.types.info(entry.typ).enumDef;
    let savedFile = c.file;
    var k: usize = 0;
    while (k < c.enumMethods.length) {
        let m = c.enumMethods[k];
        k += 1;
        if (m.item != entry.item) {
            continue;
        }
        c.setFile(m.file);
        let id = c.front.ast.idents[c.front.ast.functions[m.function as usize].name as usize];
        // A bounded block's function is declared later, for the instances that meet its bounds (ADR 0130); here it
        // takes its name, so that an enum has one member of each name whatever the bounds.
        var named = false;
        for (earlier in 0..k - 1) {
            let e = c.enumMethods[earlier];
            if (e.item == m.item && boundedImplOf(c, e.function) != none() &&
                c.front.ast.idents[c.front.ast.functions[e.function as usize].name as usize].symbol == id.symbol) {
                named = true;
            }
        }
        if (named || findVariant(c, definition, id.symbol) != none() || implMethodFor(
            c,
            entry.typ,
            id.symbol,
        ) != none()) {
            if (entry.template == none()) {
                var message = Vector<u8>.create();
                appendQuotedType(mut message, c, entry.typ)?;
                appendText(mut message, " already has a member named ")?;
                appendQuotedName(mut message, c, id.symbol)?;
                c.error(duplicateMember(), id.start, id.end, message)?;
            }
            continue;
        }
        if (boundedImplOf(c, m.function) != none()) {
            continue;
        }
        // A function with type parameters of its own is a generic method, instantiated per call (ADR 0064 §1).
        let function = if (c.front.ast.functions[m.function as usize].typeParameters.count > 0) declareGenericMethod(
            c,
            m.function,
            entry.typ,
            entry.environment,
            false,
        )? else declareFunctionIn(c, m.function, entry.typ, entry.environment)?;
        c.implMethods.push(ImplMethod { typ: entry.typ, name: id.symbol, function: function })?;
    }
    c.setFile(savedFile);
    return Ok();
}

/// The enum type a call `E.f(…)` or `E<A>.f(…)` of a function of the enum's own (ADR 0107) is made on, as
/// staticOwner finds a struct's: the enum itself, or the instance its type arguments name; none after an error.
fn enumStaticOwner(
    c: borrow mut Checker,
    index: u32,
    target: u32,
    nameSymbol: u32,
    typeArguments: Range,
) -> Result<u32, AllocError> {
    let entry = c.enums[index as usize];
    let targetSpan = c.front.ast.exprSpans[target as usize];
    if (!isGenericItem(c, entry.item)) {
        if (typeArguments.count > 0) {
            var message = Vector<u8>.create();
            appendQuotedType(mut message, c, entry.typ)?;
            appendText(mut message, " is not generic; write it without type arguments")?;
            c.error(unknownType(), targetSpan.start, targetSpan.end, message)?;
            return Ok(none());
        }
        return Ok(entry.typ);
    }
    if (typeArguments.count == 0) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, nameSymbol)?;
        appendText(mut message, " is generic: write its type arguments, e.g. '")?;
        appendBytes(mut message, c.name(nameSymbol))?;
        appendText(mut message, "<i32>.…'")?;
        c.error(cannotInferTypeArguments(), targetSpan.start, targetSpan.end, message)?;
        return Ok(none());
    }
    var itemName = Vector<u8>.create();
    appendBytes(mut itemName, c.name(nameSymbol))?;
    let typ = resolveRegionItemType(
        c,
        entry.typ,
        entry.item,
        itemName.view(),
        typeArguments,
        targetSpan,
        false,
        index,
    )?;
    if (c.types.isBottom(typ)) {
        return Ok(none());
    }
    return Ok(typ);
}
