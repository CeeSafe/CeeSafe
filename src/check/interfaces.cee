// Interfaces, impls and bounds (the reference's DeclareInterface, ResolveInterface, ProcessImpls, ProcessImpl,
// SignatureMismatch, CheckBounds' interface part, Implements, Substitute and FindMethod): P3 S4c (type-system.md §21).
// Effect lists on interface and impl methods come with S6; `dyn` with S4d.

fn implMismatch() -> u32 => 267;

/// An interface (InterfaceEntry).
struct InterfaceEntry {
    item: u32;
    file: u32;
    parameters: Range;  // its type parameters, in TypeTable.lists
    selfType: u32;      // `Self` in its defaults (ADR 0086 §2.1): a type parameter bounded by the interface, or none
    supertraits: Range; // TypeTable.bounds, in TypeTable.lists, over its own parameters (ADR 0086 §2.6)
    copySuper: bool;    // `Copy` is one of its supertraits
}

/// An impl block waiting for ProcessImpls.
struct ImplRef {
    item: u32;
    file: u32;
}

/// One `impl I<A> for T` (the reference's _implementations key).
struct Implementation {
    typ: u32;
    interfaceEntry: u32;
    arguments: Range; // in TypeTable.lists
}

/// A method an impl gives a type (the reference's _implMethods), in declaration order.
struct ImplMethod {
    typ: u32;
    name: u32; // a symbol
    function: u32;
}

/// A bound's method declared for a type parameter (the reference's _boundMethods).
struct BoundMethod {
    typ: u32;
    bound: u32; // TypeTable.bounds
    name: u32;
    function: u32;
}

/// A bound check that waits until every impl is known (the reference's _pendingBoundChecks).
struct PendingBounds {
    parameters: Range; // in TypeTable.lists
    arguments: Range;
    start: u32;
    end: u32;
    file: u32;
}

/// An allocator to verify once every impl is known (the reference's _pendingAllocators).
struct PendingAllocator {
    typ: u32;
    start: u32;
    end: u32;
    file: u32;
}

fn interfaceMethods(c: borrow Checker, entry: u32) -> Range =>
    match (c.front.ast.items[c.interfaces[entry as usize].item as usize].kind) {
        ItemKind.Interface(methods, _) => methods,
        _ => emptyRange(),
    };

/// The interface method named `name`, or none (an Ast.functions index).
fn interfaceMethod(c: borrow Checker, entry: u32, name: u32) -> u32 {
    let methods = interfaceMethods(c, entry);
    for (k in 0..methods.count) {
        let f = c.front.ast.at(methods, k);
        if (c.front.ast.idents[c.front.ast.functions[f as usize].name as usize].symbol == name) {
            return f;
        }
    }
    return none();
}

/// DeclareInterface (§21).
fn declareInterface(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    let ident = c.front.ast.idents[entry.name as usize];
    if (isReservedName(c, entry.name)?) {
        return Ok();
    }
    var text = Vector<u8>.create();
    appendBytes(mut text, c.name(ident.symbol))?;
    if (c.types.lookup(text.view()) != none() || isDeclared(c, ident.symbol)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, text.view())?;
        appendText(mut message, "' is already defined")?;
        return c.error(duplicateItem(), ident.start, ident.end, message);
    }
    let typeParameters = match (entry.kind) {
        ItemKind.Interface(_, t) => t,
        _ => emptyRange(),
    };
    c.interfaces.push(InterfaceEntry {
        item: item,
        file: c.file,
        parameters: emptyRange(),
        selfType: none(),
        supertraits: emptyRange(),
        copySuper: false,
    })?;
    let index = truncate<u32>(c.interfaces.length - 1);
    ownItem(c, ident.symbol, Entity.Interface(index))?;
    var parameters = Vector<u32>.create();
    var pairs = Vector<EnvPair>.create();
    declareTypeParameters(c, typeParameters, mut parameters, mut pairs)?;
    c.interfaces[index as usize].parameters = c.types.addList(parameters.view())?;
    let methods = interfaceMethods(c, index);
    for (k in 0..methods.count) {
        // A method without a receiver is a static function (ADR 0086 §2.3).
        let f = c.front.ast.functions[c.front.ast.at(methods, k) as usize];
        if (f.regionParameters.count > 0) {
            // Conformance compares the signatures, which would have to match the region lists (ADR 0074 §2.4).
            let first = c.front.ast.typeParameters[c.front.ast.at(f.regionParameters, 0) as usize];
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "an interface's methods, and the methods that implement one, cannot declare region parameters of their own; use the type's regions (type-system.md §25.1)",
            )?;
            c.error(unsupported(), first.start, first.end, message)?;
        }
    }
    for (k in 0..methods.count) {
        let method = c.front.ast.at(methods, k);
        let attributes = c.front.ast.functions[method as usize].attributes;
        let words = "effects";
        var known = Vector<u32>.create();
        knownAttributes(c, attributes, "an interface method", words, mut known)?;
        readEffectAttributes(c, method, known.view())?; // §37.3
        let declared = c.front.ast.functions[method as usize].parameters;
        for (j in 0..declared.count) {
            let typ = c.front.ast.parameters[c.front.ast.at(declared, j) as usize].typ;
            if (writesStatic(c, typ)) {
                staticParameterError(c, typ)?; // ADR 0068
            }
        }
    }
    return Ok();
}

/// An interface reference `I` or `I<Args>` in a bound or an impl (ResolveInterface, §21); none after an error.
fn resolveInterface(c: borrow mut Checker, syntax: u32) -> Result<u32, AllocError> {
    let span = c.front.ast.typeSpans[syntax as usize];
    var symbol = none();
    var arguments = emptyRange();
    match (c.front.ast.types[syntax as usize]) {
        TypeNode.Named(q) => {
            if (q.parts.count == 1) {
                symbol = c.front.ast.idents[c.front.ast.at(q.parts, 0) as usize].symbol;
            }
        }
        TypeNode.Generic(q, a) => {
            if (q.parts.count == 1) {
                symbol = c.front.ast.idents[c.front.ast.at(q.parts, 0) as usize].symbol;
                arguments = a;
            }
        }
        _ => {}
    }
    let entry = if (symbol == none()) none() else match (c.item(symbol)) {
        Entity.Interface(i) => i,
        _ => none(),
    };
    if (entry != none()) {
        let named = c.front.ast.typeSpans[syntax as usize];
        checkPrivateItem(c, Entity.Interface(entry), named)?; // ADR 0109
    }
    if (entry == none()) {
        var message = Vector<u8>.create();
        if (symbol == none()) {
            appendText(mut message, "expected an interface")?;
        } else {
            appendQuotedName(mut message, c, symbol)?;
            appendText(mut message, " is not an interface")?;
        }
        c.error(unknownType(), span.start, span.end, message)?;
        return Ok(none());
    }
    let parameterCount = c.interfaces[entry as usize].parameters.count;
    if (arguments.count != parameterCount) {
        var message = Vector<u8>.create();
        appendText(mut message, "interface ")?;
        appendQuotedName(mut message, c, symbol)?;
        appendText(mut message, " takes ")?;
        appendDecimal(mut message, parameterCount as u64)?;
        appendText(mut message, " type argument(s), but ")?;
        appendDecimal(mut message, arguments.count as u64)?;
        appendText(mut message, " were given")?;
        c.error(unknownType(), span.start, span.end, message)?;
        return Ok(none());
    }
    var resolved = Vector<u32>.create();
    var bottom = false;
    var interfaceName = Vector<u8>.create();
    appendBytes(mut interfaceName, c.name(symbol))?;
    for (k in 0..arguments.count) {
        let argumentSyntax = c.front.ast.at(arguments, k);
        let parameter = c.types.listAt(c.interfaces[entry as usize].parameters, k);
        let t = if (c.types.constParameterType(parameter) != none()) resolveConstArgument(
            c,
            parameter,
            interfaceName.view(),
            argumentSyntax,
        )? else c.resolveType(argumentSyntax, false)?;
        if (c.types.isBottom(t)) {
            bottom = true;
        }
        resolved.push(t)?;
    }
    if (bottom) {
        return Ok(none());
    }
    // Named from its declaration, with its package's name for a dependency's (qualifiedName), however the use spells
    // it: the first use names the type, and whichever package that is, the name is one (ADR 0082 §2.7).
    let name = interfaceDisplayName(c, entry)?;
    return c.types.addBound(entry, name.view(), resolved.view());
}

fn boundText(out: borrow mut Vector<u8>, c: borrow Checker, bound: u32) -> Result<void, AllocError> =>
    c.types.appendBound(out, bound);

fn quotedBound(out: borrow mut Vector<u8>, c: borrow Checker, bound: u32) -> Result<void, AllocError> {
    out.push('\'')?;
    boundText(out, c, bound)?;
    return out.push('\'');
}

/// Is `typ` known to implement `bound` (Implements): an impl, or for a type parameter, its own bounds?
fn implements(c: borrow Checker, typ: u32, bound: u32) -> bool {
    let b = c.types.bounds[bound as usize];
    if (c.types.is(typ, TypeKind.TypeParameter)) {
        for (ownBound in c.types.typeParameters[c.types.info(typ).typeParameter as usize].bounds.view()) {
            let o = c.types.bounds[ownBound as usize];
            if (o.interfaceEntry == b.interfaceEntry && sameLists(c, o.arguments, b.arguments)) {
                return true;
            }
        }
        return false;
    }
    if (c.types.isDyn(typ)) {
        // `dyn I` implements `I` (ADR 0064 §3.1): each method calls through the value's table. Only behind a reference,
        // since `dyn I` is unsized; a generic that needs `T` by value fails its instance (N0222).
        let dynBound = c.types.info(typ).dynInterface;
        if (dynBound != none() && boundImplies(c, dynBound, bound, 0)) {
            return true; // `dyn B` implements B's supertraits too (ADR 0086 §2.6)
        }
    }
    match (c.implementationsOf.get(Word { value: b.interfaceEntry as u64 })) {
        Some(list) => {
            for (k in list.view()) {
                let i = c.implementations[k as usize];
                if (i.typ == typ && sameLists(c, i.arguments, b.arguments)) {
                    return true;
                }
            }
        }
        null => {}
    }
    return false;
}

/// Does `have` imply `want`: the same instantiation, or one of its supertraits' (ADR 0086 §2.6)? A supertrait's
/// argument is compared when it is one of the interface's parameters or a type without parameters.
fn boundImplies(c: borrow Checker, have: u32, want: u32, depth: u32) -> bool {
    let h = c.types.bounds[have as usize];
    let w = c.types.bounds[want as usize];
    if (h.interfaceEntry == w.interfaceEntry && sameLists(c, h.arguments, w.arguments)) {
        return true;
    }
    if (depth > 32) {
        return false;
    }
    let supers = c.interfaces[h.interfaceEntry as usize].supertraits;
    let parameters = c.interfaces[h.interfaceEntry as usize].parameters;
    for (k in 0..supers.count) {
        let s = c.types.bounds[c.types.listAt(supers, k) as usize];
        if (s.interfaceEntry == w.interfaceEntry && s.arguments.count == w.arguments.count) {
            var same = true;
            for (a in 0..s.arguments.count) {
                var argument = c.types.listAt(s.arguments, a);
                for (p in 0..parameters.count) {
                    if (c.types.listAt(parameters, p) == argument) {
                        argument = c.types.listAt(h.arguments, p);
                    }
                }
                if (argument != c.types.listAt(w.arguments, a)) {
                    same = false;
                }
            }
            if (same) {
                return true;
            }
        }
    }
    for (k in 0..supers.count) {
        let s = c.types.listAt(supers, k);
        let sameParameters = c.types.bounds[s as usize].arguments.count == 0;
        if (sameParameters && boundImplies(c, s, want, depth + 1)) {
            return true;
        }
    }
    return false;
}

fn sameLists(c: borrow Checker, a: Range, b: Range) -> bool {
    if (a.count != b.count) {
        return false;
    }
    for (k in 0..a.count) {
        if (c.types.listAt(a, k) != c.types.listAt(b, k)) {
            return false;
        }
    }
    return true;
}

// ---- impls ----

/// Every `impl I for T` (ProcessImpls, §21.1); then the bound checks and allocators that waited for them.
fn processImpls(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (k in 0..c.impls.length) {
        let pending = c.impls[k];
        {
            let fileToSet = pending.file;
            c.setFile(fileToSet);
        }
        processImpl(c, pending.item)?;
    }
    c.implsReady = true;
    attachToInstances(c)?; // the instances made while the declarations were read (ADR 0054)
    for (k in 0..c.pendingBounds.length) {
        let p = c.pendingBounds[k];
        {
            let fileToSet = p.file;
            c.setFile(fileToSet);
        }
        var parameters = Vector<u32>.create();
        listTypes(c, p.parameters, mut parameters)?;
        var arguments = Vector<u32>.create();
        listTypes(c, p.arguments, mut arguments)?;
        checkBounds(c, parameters.view(), arguments.view(), Span { start: p.start, end: p.end })?;
    }
    for (k in 0..c.pendingAllocators.length) {
        let p = c.pendingAllocators[k];
        {
            let fileToSet = p.file;
            c.setFile(fileToSet);
        }
        verifyUserAllocator(c, p.typ, Span { start: p.start, end: p.end })?;
    }
    c.pendingBounds.truncate(0);
    c.setFile(saved);
    return Ok();
}

/// One impl (ProcessImpl): resolves both sides with the impl's own parameters in scope (ADR 0054), checks where it
/// may be written and that it overlaps no other, declares the methods as methods of T, and checks them against the
/// interface (N0267). A generic impl is checked once for its target, which names the parameters, and becomes a
/// template that each matching instance gets (attachGenericImpls).
fn processImpl(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    let interfaceSyntax = match (entry.kind) {
        ItemKind.Impl(i, _, _, _, _) => i,
        _ => { return Ok(); }
    };
    let forSyntax = match (entry.kind) {
        ItemKind.Impl(_, t, _, _, _) => t,
        _ => none(),
    };
    let typeSyntax = match (entry.kind) {
        ItemKind.Impl(_, _, _, t, _) => t,
        _ => emptyRange(),
    };
    let regionSyntax = match (entry.kind) {
        ItemKind.Impl(_, _, _, _, r) => r,
        _ => emptyRange(),
    };
    checkRegionParameters(c, regionSyntax, typeSyntax)?;
    var regionNames = Vector<u32>.create();
    pushRegionNames(c, regionSyntax, mut regionNames)?;
    let savedRegions = swapRegions(c, regionNames)?;
    var parameters = Vector<u32>.create();
    var pairs = Vector<EnvPair>.create();
    declareTypeParameters(c, typeSyntax, mut parameters, mut pairs)?;
    let savedEnvironment = enterEnvironmentPairs(c, pairs.view())?;
    let forType = c.resolveType(forSyntax, false)?;
    let bound = resolveInterface(c, interfaceSyntax)?;
    restoreEnvironment(c, savedEnvironment);
    swapRegions(c, savedRegions)?;
    if (c.types.isBottom(forType) || bound == none()) {
        return Ok();
    }
    let span = c.front.ast.typeSpans[forSyntax as usize];
    if (parameters.length > 0) {
        if (declarationOf(c, forType) == none()) {
            var message = Vector<u8>.create();
            appendText(mut message, "'impl<…> … for ")?;
            appendBytes(mut message, c.typeName(forType))?;
            appendText(
                mut message,
                "': a generic impl is for a generic struct or enum, written with the impl's type ",
            )?;
            appendText(mut message, "parameters (ADR 0054)")?;
            return c.error(implMismatch(), span.start, span.end, message);
        }
        var found = Vector<Found>.create();
        unify(c, forType, forType, parameters.view(), mut found)?;
        for (k in 0..parameters.length) {
            if (foundFor(found, parameters[k]) == none()) {
                let p = c.front.ast.typeParameters[c.front.ast.at(typeSyntax, truncate<u32>(k)) as usize];
                let ident = c.front.ast.idents[p.name as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "type parameter ")?;
                appendQuotedName(mut message, c, ident.symbol)?;
                appendText(mut message, " does not appear in ")?;
                appendQuotedType(mut message, c, forType)?;
                appendText(mut message, ", so no instance could choose it (ADR 0054)")?;
                return c.error(implMismatch(), ident.start, ident.end, message);
            }
        }
    } else if (c.types.isGeneric(forType)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'impl … for ")?;
        appendBytes(mut message, c.typeName(forType))?;
        appendText(mut message, "': implementing for a type parameter is not allowed")?;
        return c.error(implMismatch(), span.start, span.end, message);
    }
    if (c.types.isScoped(forType) && !(regionSyntax.count > 0 && hasRegionParameters(c, forType))) {
        var message = Vector<u8>.create();
        appendText(mut message, "'impl … for ")?;
        appendBytes(mut message, c.typeName(forType))?;
        appendText(mut message, "': a struct or enum with region parameters is implemented as ")?;
        appendText(mut message, "'impl<region r> I for S<r>' (ADR 0054); other scoped types implement no interface")?;
        return c.error(implMismatch(), span.start, span.end, message);
    }
    if (regionSyntax.count > 0 && !hasRegionParameters(c, forType)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'impl<region …> … for ")?;
        appendBytes(mut message, c.typeName(forType))?;
        appendText(mut message, "': region parameters are for a type that has them (ADR 0054)")?;
        return c.error(implMismatch(), span.start, span.end, message);
    }
    // The orphan rule (ADR 0054 §3.1): the impl's package declares the interface or the type's struct or enum.
    let b = c.types.bounds[bound as usize];
    let home = currentPackage(c);
    let interfaceFile = c.interfaces[b.interfaceEntry as usize].file;
    if (home != packageOfFile(c, interfaceFile) && home != typeHome(c, forType)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'impl ")?;
        boundText(mut message, c, bound)?;
        appendText(mut message, " for ")?;
        appendBytes(mut message, c.typeName(forType))?;
        appendText(mut message, "' must be written in the package that declares ")?;
        quotedBound(mut message, c, bound)?;
        appendText(mut message, " or ")?;
        appendQuotedType(mut message, c, forType)?;
        appendText(mut message, " (the orphan rule, ADR 0054)")?;
        return c.error(implMismatch(), entry.start, entry.end, message);
    }
    if (implements(c, forType, bound)) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, forType)?;
        appendText(mut message, " already implements ")?;
        quotedBound(mut message, c, bound)?;
        return c.error(implMismatch(), entry.start, entry.end, message);
    }
    // Overlap (ADR 0054 §3.1): with a generic impl on either side, one impl of an interface per struct or enum.
    let constructor = declarationOf(c, forType);
    if (constructor != none()) {
        // The impls of this interface alone, in their order: a scan of every impl was quadratic.
        var same = Vector<u32>.create();
        match (c.implementationsOf.get(Word { value: b.interfaceEntry as u64 })) {
            Some(list) => {
                for (k in list.view()) {
                    same.push(k)?;
                }
            }
            null => {}
        }
        for (k in same.view()) {
            let other = c.implementations[k as usize];
            let sameDeclaration = other.interfaceEntry == b.interfaceEntry && declarationOf(
                c,
                other.typ,
            ) == constructor;
            let eitherGeneric = parameters.length > 0 || c.types.isGeneric(other.typ);
            let argumentsMayMeet = sameLists(c, other.arguments, b.arguments) || listIsGeneric(c, other.arguments) ||
                listIsGeneric(c, b.arguments);
            if (sameDeclaration && eitherGeneric && argumentsMayMeet) {
                var message = Vector<u8>.create();
                appendText(mut message, "'impl ")?;
                boundText(mut message, c, bound)?;
                appendText(mut message, " for ")?;
                appendBytes(mut message, c.typeName(forType))?;
                appendText(mut message, "' overlaps the impl for ")?;
                appendQuotedType(mut message, c, other.typ)?;
                appendText(mut message, ": a generic impl is the only impl of its interface for its struct or enum ")?;
                appendText(mut message, "(ADR 0054)")?;
                return c.error(implMismatch(), entry.start, entry.end, message);
            }
        }
    }
    let implEnvironment = storeEnvironment(c, pairs.view())?;
    requireSupertraits(c, forType, bound, span)?; // ADR 0086 §2.6
    if (parameters.length > 0) {
        let list = c.types.addList(parameters.view())?;
        c.implTemplates.push(
            ImplTemplate { item: item, file: c.file, target: forType, bound: bound, parameters: list },
        )?;
        let constructorKey = Word { value: declarationOf(c, forType) as u64 };
        let index = truncate<u32>(c.implTemplates.length - 1);
        var known = false;
        match (c.templatesOf.getMut(constructorKey)) {
            Some(templates) => {
                templates.push(index)?;
                known = true;
            }
            null => {}
        }
        if (!known) {
            var templates = Vector<u32>.create();
            templates.push(index)?;
            c.templatesOf.put(constructorKey, templates)?;
        }
    }
    return implementFor(c, item, forType, bound, implEnvironment, true);
}

/// A generic impl (ADR 0054): its target names the impl's type parameters.
struct ImplTemplate {
    item: u32;
    file: u32;
    target: u32;
    bound: u32;        // the interface, whose arguments may name the parameters
    parameters: Range; // the impl's type parameters, in TypeTable.lists
}

/// The AST item of a user struct's or enum's declaration (a generic one's instances share it), or none.
fn declarationOf(c: borrow Checker, typ: u32) -> u32 {
    let info = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Struct) && info.structDef != none()) {
        let d = borrow c.types.structs[info.structDef as usize];
        return if (d.isClosureEnvironment) none() else d.item;
    }
    if (c.types.is(typ, TypeKind.Enum) && info.enumDef != none()) {
        return c.types.enums[info.enumDef as usize].item;
    }
    return none();
}

/// The package that declares a type: its struct's or enum's; the built-in types are the libraries' (none).
fn typeHome(c: borrow Checker, typ: u32) -> u32 {
    let info = c.types.info(typ);
    if (declarationOf(c, typ) == none()) {
        return none();
    }
    if (c.types.is(typ, TypeKind.Struct)) {
        return packageOfFile(c, c.types.structs[info.structDef as usize].file);
    }
    return packageOfFile(c, c.types.enums[info.enumDef as usize].file);
}

fn hasRegionParameters(c: borrow Checker, typ: u32) -> bool {
    let info = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Struct) && info.structDef != none()) {
        return c.types.structs[info.structDef as usize].hasRegionParameters;
    }
    if (c.types.is(typ, TypeKind.Enum) && info.enumDef != none()) {
        return c.types.enums[info.enumDef as usize].hasRegionParameters;
    }
    return false;
}

fn listIsGeneric(c: borrow Checker, list: Range) -> bool {
    for (k in 0..list.count) {
        if (c.types.isGeneric(c.types.listAt(list, k))) {
            return true;
        }
    }
    return false;
}

/// Is the function a method of an impl of an interface (ADR 0074 §2.4)?
fn isInterfaceImplMethod(c: borrow Checker, f: u32) -> bool {
    for (r in c.impls.view()) {
        match (c.front.ast.items[r.item as usize].kind) {
            ItemKind.Impl(_, _, functions, _, _) => {
                for (k in 0..functions.count) {
                    if (c.front.ast.at(functions, k) == f) {
                        return true;
                    }
                }
            }
            _ => {}
        }
    }
    return false;
}

/// The region parameters of the impl whose method `f` (an AST function) is, or none (ADR 0054 §3.2).
fn implRegionsOf(c: borrow Checker, f: u32) -> Range {
    // Only the impls with region parameters: every function asks, so a scan of every impl was quadratic.
    for (index in c.regionImpls.view()) {
        let r = c.impls[index as usize];
        match (c.front.ast.items[r.item as usize].kind) {
            ItemKind.Impl(_, _, functions, _, regions) => {
                if (regions.count > 0) {
                    for (k in 0..functions.count) {
                        if (c.front.ast.at(functions, k) == f) {
                            return regions;
                        }
                    }
                }
            }
            _ => {}
        }
    }
    return emptyRange();
}

/// Implements every generic impl whose target matches `typ`, an instance of a generic struct or enum, when the
/// arguments meet the impl's bounds (ADR 0054 §3.1). The methods are declared again for `typ`, as a generic struct's
/// are for its instances; the generic version reported their problems.
fn attachGenericImpls(c: borrow mut Checker, typ: u32) -> Result<void, AllocError> {
    let constructor = declarationOf(c, typ);
    if (constructor == none()) {
        return Ok();
    }
    // The templates for this declaration alone: every instance asks, so a scan of every template was quadratic.
    var candidates = Vector<u32>.create();
    match (c.templatesOf.get(Word { value: constructor as u64 })) {
        Some(list) => {
            for (t in list.view()) {
                candidates.push(t)?;
            }
        }
        null => {}
    }
    for (t in candidates.view()) {
        let template = c.implTemplates[t as usize];
        if (template.target == typ) {
            continue;
        }
        var parameters = Vector<u32>.create();
        listTypes(c, template.parameters, mut parameters)?;
        var found = Vector<Found>.create();
        unify(c, template.target, typ, parameters.view(), mut found)?;
        var arguments = Vector<u32>.create();
        var map = Vector<TypeMapping>.create();
        var complete = true;
        for (p in parameters.view()) {
            let a = foundFor(found, p);
            if (a == none()) {
                complete = false;
            } else {
                arguments.push(a)?;
                map.push(TypeMapping { from: p, to: a })?;
            }
        }
        if (!complete || substitute(c, template.target, map.view())? != typ) {
            continue;
        }
        let original = c.types.bounds[template.bound as usize];
        var substituted = Vector<u32>.create();
        for (a in 0..original.arguments.count) {
            let argumentType = c.types.listAt(original.arguments, a);
            substituted.push(substitute(c, argumentType, map.view())?)?;
        }
        var boundName = Vector<u8>.create();
        appendBytes(mut boundName, c.types.rangeText(original.name))?;
        let required = c.types.addBound(original.interfaceEntry, boundName.view(), substituted.view())?;
        if (implements(c, typ, required)) {
            continue;
        }
        let mark = diagnosticsMark(c);
        checkBounds(c, parameters.view(), arguments.view(), Span { start: 0, end: 0 })?;
        let met = diagnosticsMark(c) == mark;
        dropDiagnosticsSince(c, mark);
        if (!met) {
            continue; // the instance does not implement the interface
        }
        let savedFile = c.file;
        {
            let fileToSet = template.file;
            c.setFile(fileToSet);
        }
        let typeSyntax = match (c.front.ast.items[template.item as usize].kind) {
            ItemKind.Impl(_, _, _, ts, _) => ts,
            _ => emptyRange(),
        };
        var pairs = Vector<EnvPair>.create();
        zipEnvironment(c, typeSyntax, arguments.view(), mut pairs)?;
        let environment = storeEnvironment(c, pairs.view())?;
        implementFor(c, template.item, typ, required, environment, false)?;
        dropDiagnosticsSince(c, mark);
        c.setFile(savedFile);
    }
    return Ok();
}

/// Every instance made so far gets the generic impls that match it (twice, so an instance whose bound needs another
/// instance's impl finds it whatever their order), and so does each generic struct's or enum's own type, whose methods
/// are checked with its parameters opaque (bug B9).
fn attachToInstances(c: borrow mut Checker) -> Result<void, AllocError> {
    if (c.implTemplates.length == 0) {
        return Ok();
    }
    for (round in 0..2) {
        var k: usize = 0;
        while (k < c.structs.length) {
            let typ = c.structs[k].typ;
            if (c.structs[k].template != none() || isGenericItem(c, c.structs[k].item)) {
                attachGenericImpls(c, typ)?;
            }
            k += 1;
        }
        k = 0;
        while (k < c.enums.length) {
            let typ = c.enums[k].typ;
            if (c.enums[k].template != none() || isGenericItem(c, c.enums[k].item)) {
                attachGenericImpls(c, typ)?;
            }
            k += 1;
        }
    }
    return Ok();
}

/// An impl's methods for `forType` (the body of ProcessImpl after its checks): the interface's arguments in scope,
/// and `implEnvironment`, the impl's own type parameters. `first` is false for an instance of a generic impl.
fn implementFor(
    c: borrow mut Checker,
    item: u32,
    forType: u32,
    bound: u32,
    implEnvironment: Range,
    first: bool,
) -> Result<void, AllocError> {
    let b = c.types.bounds[bound as usize];
    c.implementations.push(Implementation { typ: forType, interfaceEntry: b.interfaceEntry, arguments: b.arguments })?;
    let index = truncate<u32>(c.implementations.length - 1);
    let key = Word { value: b.interfaceEntry as u64 };
    var found = false;
    match (c.implementationsOf.getMut(key)) {
        Some(list) => {
            list.push(index)?;
            found = true;
        }
        null => {}
    }
    if (!found) {
        var list = Vector<u32>.create();
        list.push(index)?;
        c.implementationsOf.put(key, list)?;
    }
    let interfaceEntry = b.interfaceEntry;
    var arguments = Vector<u32>.create();
    listTypes(c, b.arguments, mut arguments)?;
    let interfaceItem = c.interfaces[interfaceEntry as usize].item;
    let interfaceParameters = match (c.front.ast.items[interfaceItem as usize].kind) {
        ItemKind.Interface(_, t) => t,
        _ => emptyRange(),
    };
    var pairs = Vector<EnvPair>.create();
    zipEnvironment(c, interfaceParameters, arguments.view(), mut pairs)?;
    let environment = storeEnvironment(c, pairs.view())?;
    implementAssociated(c, item, forType, bound, environment, implEnvironment, first)?; // ADR 0086 §2.4, §2.5
    let interfaceSyntax = match (c.front.ast.items[item as usize].kind) {
        ItemKind.Impl(i, _, _, _, _) => i,
        _ => none(),
    };
    let functions = match (c.front.ast.items[item as usize].kind) {
        ItemKind.Impl(_, _, f, _, _) => f,
        _ => emptyRange(),
    };
    var implemented = Vector<u32>.create(); // names
    for (k in 0..functions.count) {
        let f = c.front.ast.at(functions, k);
        let decl = c.front.ast.functions[f as usize];
        let id = c.front.ast.idents[decl.name as usize];
        let signature = interfaceMethod(c, interfaceEntry, id.symbol);
        if (signature == none()) {
            var message = Vector<u8>.create();
            quotedBound(mut message, c, bound)?;
            appendText(mut message, " has no method ")?;
            appendQuotedName(mut message, c, id.symbol)?;
            appendText(mut message, "; an impl block holds only the interface's methods")?;
            c.error(implMismatch(), id.start, id.end, message)?;
            continue;
        }
        if (first) {
            // Per declaration: an instance of a generic impl shares its generic version's (ADR 0054).
            let words = "effects context";
            var known = Vector<u32>.create();
            knownAttributes(c, decl.attributes, "a method", words, mut known)?;
            readEffectAttributes(c, f, known.view())?;
            inheritEffects(c, signature, f)?;
        }
        if (c.types.is(forType, TypeKind.Integer) && integerMethod(c.name(id.symbol)) != none()) {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, id.symbol)?;
            appendText(mut message, " is a built-in method of every integer type (type-system.md §6)")?;
            c.error(duplicateMember(), id.start, id.end, message)?;
            continue;
        }
        if (c.types.is(forType, TypeKind.Float) && isReservedFloatName(c.name(id.symbol))) {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, id.symbol)?;
            appendText(mut message, " is a built-in method of every float type (type-system.md §35.5, §35.8)")?;
            c.error(duplicateMember(), id.start, id.end, message)?;
            continue;
        }
        // A method with type parameters of its own is a generic method, instantiated per call (ADR 0086 §2.3).
        let hir = if (decl.typeParameters.count > 0) declareGenericMethod(
            c,
            f,
            forType,
            implEnvironment,
            false,
        )? else declareFunctionIn(c, f, forType, implEnvironment)?;
        if (implMethodFor(c, forType, id.symbol) != none() || containsU32(implemented, id.symbol)) {
            var message = Vector<u8>.create();
            appendQuotedType(mut message, c, forType)?;
            appendText(mut message, " already has a method named ")?;
            appendQuotedName(mut message, c, id.symbol)?;
            c.error(duplicateMember(), id.start, id.end, message)?;
            continue;
        }
        c.implMethods.push(ImplMethod { typ: forType, name: id.symbol, function: hir })?;
        implemented.push(id.symbol)?;
        var problem = Vector<u8>.create();
        let ownCount = c.front.ast.functions[signature as usize].typeParameters.count;
        if (ownCount != decl.typeParameters.count) {
            appendText(mut problem, "it must have ")?;
            appendDecimal(mut problem, ownCount as u64)?;
            appendText(mut problem, " type parameter(s) of its own")?;
        } else {
            let expected = expectedSignature(c, signature, forType, environment, hir)?;
            signatureMismatch(c, expected, hir, mut problem)?;
        }
        if (problem.length > 0) {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, id.symbol)?;
            appendText(mut message, " does not match ")?;
            quotedBound(mut message, c, bound)?;
            appendText(mut message, ": ")?;
            appendBytes(mut message, problem.view())?;
            c.error(implMismatch(), id.start, id.end, message)?;
        }
    }
    // A reserved integer or float method was reported above; it is not missing as well.
    let methods = interfaceMethods(c, interfaceEntry);
    let interfaceSpan = c.front.ast.typeSpans[interfaceSyntax as usize];
    for (k in 0..methods.count) {
        let method = c.front.ast.at(methods, k);
        let m = c.front.ast.functions[method as usize];
        let name = c.front.ast.idents[m.name as usize].symbol;
        let reserved = (c.types.is(forType, TypeKind.Integer) && integerMethod(c.name(name)) != none()) ||
            (c.types.is(forType, TypeKind.Float) && isReservedFloatName(c.name(name)));
        if (!containsU32(implemented, name) && !reserved && hasDefault(c, method)) {
            inheritDefault(c, method, forType, bound, environment, interfaceSpan)?;
        } else if (!containsU32(implemented, name) && !reserved) {
            var message = Vector<u8>.create();
            appendText(mut message, "'impl ")?;
            boundText(mut message, c, bound)?;
            appendText(mut message, " for ")?;
            appendBytes(mut message, c.typeName(forType))?;
            appendText(mut message, "' is missing method ")?;
            appendQuotedName(mut message, c, name)?;
            c.error(implMismatch(), interfaceSpan.start, interfaceSpan.end, message)?;
        }
    }
    return Ok();
}

/// Does the interface method (an Ast.functions index) have a body, a default (ADR 0086 §2.1)?
fn hasDefault(c: borrow Checker, method: u32) -> bool {
    let f = c.front.ast.functions[method as usize];
    return f.body != none() || f.expressionBody != none();
}

/// Does the struct `typ` declare a function named `name` in its body or an inherent impl (merged into it)?
fn ownsFunctionNamed(c: borrow Checker, typ: u32, name: u32) -> bool {
    let item = declarationOf(c, typ);
    if (item == none() || !c.types.is(typ, TypeKind.Struct)) {
        return false;
    }
    let functions = match (c.front.ast.items[item as usize].kind) {
        ItemKind.Struct(k) => c.front.ast.structs[k as usize].functions,
        _ => emptyRange(),
    };
    for (k in 0..functions.count) {
        let f = c.front.ast.functions[c.front.ast.at(functions, k) as usize];
        if (c.front.ast.idents[f.name as usize].symbol == name) {
            return true;
        }
    }
    return false;
}

/// An impl that leaves out a default inherits it (ADR 0086 §2.1): the default is instantiated with `Self` = the
/// target, as an ordinary method of the target, recorded as the impl's methods are. Its generic version, at the
/// interface, reports the body's errors; an instance that does not check is N0222 at the impl.
fn inheritDefault(
    c: borrow mut Checker,
    method: u32,
    forType: u32,
    bound: u32,
    environment: Range,
    span: Span,
) -> Result<void, AllocError> {
    let name = c.front.ast.idents[c.front.ast.functions[method as usize].name as usize].symbol;
    if (implMethodFor(c, forType, name) != none() || ownsFunctionNamed(c, forType, name)) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, forType)?;
        appendText(mut message, " already has a method named ")?;
        appendQuotedName(mut message, c, name)?;
        appendText(mut message, ", which the impl would inherit as the default of ")?;
        quotedBound(mut message, c, bound)?;
        appendText(mut message, ": a type has one method of each name (ADR 0086 §2.1)")?;
        return c.error(duplicateMember(), span.start, span.end, message);
    }
    let interfaceEntry = c.types.bounds[bound as usize].interfaceEntry;
    let savedFile = c.file;
    {
        let fileToSet = c.interfaces[interfaceEntry as usize].file;
        c.setFile(fileToSet);
    }
    let function = if (c.front.ast.functions[method as usize].typeParameters.count > 0) declareGenericMethod(
        c,
        method,
        forType,
        environment,
        false,
    )? else declareFunctionIn(c, method, forType, environment)?;
    c.setFile(savedFile);
    let only = [forType];
    let list = c.types.addList(only[..])?;
    c.hir.functions[function as usize].inheritedDefault = true;
    c.hir.functions[function as usize].typeArguments = list;
    c.hir.functions[function as usize].siteFile = savedFile;
    c.hir.functions[function as usize].siteStart = span.start;
    c.hir.functions[function as usize].siteEnd = span.end;
    return c.implMethods.push(ImplMethod { typ: forType, name: name, function: function });
}

/// `Self` in an interface's defaults (ADR 0086 §2.1): a type parameter bounded by the interface, with its own
/// parameters as arguments; made once.
fn interfaceSelf(c: borrow mut Checker, index: u32) -> Result<u32, AllocError> {
    if (c.interfaces[index as usize].selfType != none()) {
        return Ok(c.interfaces[index as usize].selfType);
    }
    let selfType = c.types.createTypeParameter("Self".bytes())?;
    c.interfaces[index as usize].selfType = selfType;
    let name = interfaceDisplayName(c, index)?;
    var arguments = Vector<u32>.create();
    listTypes(c, c.interfaces[index as usize].parameters, mut arguments)?;
    let ownBound = c.types.addBound(index, name.view(), arguments.view())?;
    let info = c.types.info(selfType).typeParameter;
    c.types.typeParameters[info as usize].bounds.push(ownBound)?;
    closeBounds(c, info)?; // its supertraits (ADR 0086 §2.6)
    return Ok(selfType);
}

/// The type environment of an interface's own declaration: its type parameters, opaque.
fn interfaceEnvironment(c: borrow mut Checker, index: u32) -> Result<Range, AllocError> {
    let item = c.interfaces[index as usize].item;
    let typeParameters = match (c.front.ast.items[item as usize].kind) {
        ItemKind.Interface(_, t) => t,
        _ => emptyRange(),
    };
    var arguments = Vector<u32>.create();
    listTypes(c, c.interfaces[index as usize].parameters, mut arguments)?;
    var pairs = Vector<EnvPair>.create();
    zipEnvironment(c, typeParameters, arguments.view(), mut pairs)?;
    return storeEnvironment(c, pairs.view());
}

/// Every interface default, checked once at the interface (ADR 0086 §2.1): a generic body whose `Self` is opaque,
/// bounded by the interface; never compiled.
fn declareInterfaceDefaults(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (index in 0..c.interfaces.length) {
        let entry = truncate<u32>(index);
        let methods = interfaceMethods(c, entry);
        var any = false;
        for (k in 0..methods.count) {
            if (hasDefault(c, c.front.ast.at(methods, k))) {
                any = true;
            }
        }
        if (!any) {
            continue;
        }
        {
            let fileToSet = c.interfaces[index].file;
            c.setFile(fileToSet);
        }
        let selfType = interfaceSelf(c, entry)?;
        let environment = interfaceEnvironment(c, entry)?;
        for (k in 0..methods.count) {
            let method = c.front.ast.at(methods, k);
            if (hasDefault(c, method) && c.front.ast.functions[method as usize].typeParameters.count > 0) {
                declareGenericMethod(c, method, selfType, environment, false)?;
            } else if (hasDefault(c, method)) {
                declareFunctionIn(c, method, selfType, environment)?;
            }
        }
    }
    c.setFile(saved);
    return Ok();
}

fn isReservedFloatName(name: Slice<u8>) -> bool => sameText(name, "fromBits") || floatMethod(name) != none();

fn implMethodFor(c: borrow Checker, typ: u32, name: u32) -> u32 {
    for (m in c.implMethods.view()) {
        if (m.typ == typ && m.name == name) {
            return m.function;
        }
    }
    return none();
}

fn receiverText(kind: ReceiverKind) -> StringView => match (kind) {
    ReceiverKind.Borrow => "'borrow this'",
    ReceiverKind.BorrowMut => "'borrow mut this'",
    ReceiverKind.None => "none (a static function)",
    _ => "'this'",
};

/// The interface's signature `signature` for an impl's method `actual` on `forType`: a generic method's own type
/// parameters are the impl method's, by position, so the two compare (ADR 0086 §2.3).
fn expectedSignature(
    c: borrow mut Checker,
    signature: u32,
    forType: u32,
    environment: Range,
    actual: u32,
) -> Result<u32, AllocError> {
    let ownParameters = c.front.ast.functions[signature as usize].typeParameters;
    let template = c.hir.functions[actual as usize].methodTemplate;
    if (ownParameters.count == 0 || template == none()) {
        return declareSignature(c, signature, forType, environment);
    }
    var pairs = Vector<EnvPair>.create();
    for (k in 0..environment.count) {
        pairs.push(c.envPairs[(environment.start + k) as usize])?;
    }
    var arguments = Vector<u32>.create();
    listTypes(c, c.genericFunctions[template as usize].parameters, mut arguments)?;
    zipEnvironment(c, ownParameters, arguments.view(), mut pairs)?;
    let env = storeEnvironment(c, pairs.view())?;
    let savedGenericMethod = c.genericMethod;
    c.genericMethod = true;
    let function = declareSignature(c, signature, forType, env)?;
    c.genericMethod = savedGenericMethod;
    return Ok(function);
}

/// Empty if `actual` has the interface's signature `expected`; else what differs (SignatureMismatch).
fn signatureMismatch(
    c: borrow Checker,
    expected: u32,
    actual: u32,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    let e = borrow c.hir.functions[expected as usize];
    let a = borrow c.hir.functions[actual as usize];
    let es = c.front.ast.functions[e.syntax as usize];
    let as2 = c.front.ast.functions[a.syntax as usize];
    if (es.isUnsafe != as2.isUnsafe) {
        return appendText(out, if (as2.isUnsafe) "it must not be 'unsafe'" else "it must be 'unsafe'");
    }
    if (es.isAsync != as2.isAsync) {
        // A call through the interface is awaited exactly when the method is async (type-system.md §40.1).
        return appendText(out, if (as2.isAsync) "it must not be 'async'" else "it must be 'async'");
    }
    if (receiverIndex(es.receiver) != receiverIndex(as2.receiver)) {
        appendText(out, "the receiver must be ")?;
        appendText(out, receiverText(es.receiver))?;
        appendText(out, ", not ")?;
        return appendText(out, receiverText(as2.receiver));
    }
    let first: usize = if (receiverIndex(es.receiver) == 0) 0 else 1; // a static function has no receiver
    if (e.parameters.length != a.parameters.length) {
        appendText(out, "it must take ")?;
        appendDecimal(out, truncate<u64>(e.parameters.length - first))?;
        return appendText(out, if (first == 0) " parameter(s)" else " parameter(s) besides the receiver");
    }
    for (i in first..e.parameters.length) {
        let et = c.hir.locals[e.parameters[i] as usize].typ;
        let at = c.hir.locals[a.parameters[i] as usize].typ;
        if (et != at) {
            appendText(out, "parameter ")?;
            appendDecimal(out, i as u64)?;
            appendText(out, " must have type ")?;
            appendQuotedType(out, c, et)?;
            appendText(out, ", not ")?;
            return appendQuotedType(out, c, at);
        }
    }
    if (e.returnType != a.returnType && e.returnType != c.types.error) {
        appendText(out, "it must return ")?;
        appendQuotedType(out, c, e.returnType)?;
        appendText(out, ", not ")?;
        return appendQuotedType(out, c, a.returnType);
    }
    return Ok();
}

// ---- user allocators ----

/// Checks a user allocator against lib/core's `Allocator` (VerifyUserAllocator, §30.2).
fn verifyUserAllocator(c: borrow mut Checker, typ: u32, span: Span) -> Result<bool, AllocError> {
    let definition = c.types.info(typ).structDef;
    if (c.types.structs[definition as usize].allocateMethod != none()) {
        return Ok(true);
    }
    let allocatorName = c.intern("Allocator")?;
    let entry = match (c.item(allocatorName)) {
        Entity.Interface(i) => i,
        _ => none(),
    };
    if (entry != none()) {
        let noArguments = Vector<u32>.create();
        let bound = c.types.addBound(entry, "Allocator".bytes(), noArguments.view())?;
        let allocateName = c.intern("allocate")?;
        let deallocateName = c.intern("deallocate")?;
        let allocate = implMethodFor(c, typ, allocateName);
        let deallocate = implMethodFor(c, typ, deallocateName);
        if (implements(c, typ, bound) && allocate != none() && deallocate != none()) {
            c.types.structs[definition as usize].allocateMethod = allocate;
            c.types.structs[definition as usize].deallocateMethod = deallocate;
            return Ok(true);
        }
    }
    var message = Vector<u8>.create();
    appendQuotedType(mut message, c, typ)?;
    appendText(mut message, " is not an allocator type: it does not implement 'Allocator' (type-system.md §30.2)")?;
    c.error(notAnAllocator(), span.start, span.end, message)?;
    return Ok(false);
}

// ---- methods ----

/// The methods a value of `typ` has (FindMethod, §21): its own, those of its impls, or for a type parameter, its
/// bounds'. None if there is none of that name; reports an ambiguous bound.
fn findMethod(c: borrow mut Checker, typ: u32, name: u32, span: Span) -> Result<u32, AllocError> {
    let definition = c.types.info(typ).structDef;
    if (definition != none()) {
        let ownBound = findStructFunction(c, definition, name);
        if (ownBound != none()) {
            checkMethodVisible(c, ownBound, span)?;
            return Ok(ownBound);
        }
    }
    let implemented = implMethodFor(c, typ, name);
    if (implemented != none()) {
        checkEnumMethodVisible(c, implemented, span)?; // a function of an enum's own (ADR 0107)
        return Ok(implemented);
    }
    if (c.types.isDyn(typ)) {
        return dynMethod(c, typ, name);
    }
    if (!c.types.is(typ, TypeKind.TypeParameter)) {
        return Ok(none());
    }
    var candidates = Vector<u32>.create(); // bounds
    var signatures = Vector<u32>.create();
    for (bound in c.types.typeParameters[c.types.info(typ).typeParameter as usize].bounds.view()) {
        let signature = interfaceMethod(c, c.types.bounds[bound as usize].interfaceEntry, name);
        if (signature != none()) {
            candidates.push(bound)?;
            signatures.push(signature)?;
        }
    }
    if (candidates.length > 1) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, name)?;
        appendText(mut message, " is ambiguous: both ")?;
        quotedBound(mut message, c, candidates[0])?;
        appendText(mut message, " and ")?;
        quotedBound(mut message, c, candidates[1])?;
        appendText(mut message, " declare it")?;
        c.error(implMismatch(), span.start, span.end, message)?;
    }
    if (candidates.length == 0) {
        return Ok(none());
    }
    let bound = candidates[0];
    let b = c.types.bounds[bound as usize];
    for (m in c.boundMethods.view()) {
        if (m.typ == typ && m.name == name && c.types.bounds[m.bound as usize].interfaceEntry == b.interfaceEntry &&
            sameLists(c, c.types.bounds[m.bound as usize].arguments, b.arguments)) {
            return Ok(m.function);
        }
    }
    let entry = c.interfaces[b.interfaceEntry as usize];
    let interfaceParameters = match (c.front.ast.items[entry.item as usize].kind) {
        ItemKind.Interface(_, t) => t,
        _ => emptyRange(),
    };
    var arguments = Vector<u32>.create();
    listTypes(c, b.arguments, mut arguments)?;
    var pairs = Vector<EnvPair>.create();
    zipEnvironment(c, interfaceParameters, arguments.view(), mut pairs)?;
    let environment = storeEnvironment(c, pairs.view())?;
    let savedFile = c.file;
    {
        let fileToSet = entry.file;
        c.setFile(fileToSet);
    }
    let ownParameters = c.front.ast.functions[signatures[0] as usize].typeParameters.count;
    let function = if (ownParameters > 0) declareGenericMethod(
        c,
        signatures[0],
        typ,
        environment,
        true,
    )? else declareSignature(c, signatures[0], typ, environment)?;
    c.setFile(savedFile);
    c.boundMethods.push(BoundMethod { typ: typ, bound: bound, name: name, function: function })?;
    return Ok(function);
}

// ---- substitution ----

struct TypeMapping {
    from: u32;
    to: u32;
}

/// A type with type parameters replaced by `map` (Substitute, for bounds such as `Comparable<T>`).
fn substitute(c: borrow mut Checker, typ: u32, map: Slice<TypeMapping>) -> Result<u32, AllocError> {
    for (m in map) {
        if (m.from == typ) {
            return Ok(m.to);
        }
    }
    if (!c.types.isGeneric(typ)) {
        return Ok(typ);
    }
    let t = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Reference)) {
        let p = substitute(c, t.pointee, map)?;
        return c.types.referenceTo(p, t.mutableReference);
    }
    if (c.types.is(typ, TypeKind.RawPointer)) {
        let p = substitute(c, t.pointee, map)?;
        return c.types.pointerTo(p, t.mutablePointer);
    }
    if (c.types.is(typ, TypeKind.Array)) {
        let e = substitute(c, t.element, map)?;
        if (t.lengthParameter != none()) {
            let length = substitute(c, t.lengthParameter, map)?;
            return substituteLength(c, e, length); // ADR 0083 §2.3
        }
        return c.types.arrayOf(e, t.arrayLength);
    }
    if (c.types.is(typ, TypeKind.Box)) {
        let p = substitute(c, t.pointee, map)?;
        return boxOf(c, p, t.allocator);
    }
    if (c.types.is(typ, TypeKind.Enum)) {
        let resultOkType = c.types.enums[t.enumDef as usize].resultOk;
        let resultErrType = c.types.enums[t.enumDef as usize].resultErr;
        let optionValue = c.types.enums[t.enumDef as usize].optionType;
        let enumItem = c.types.enums[t.enumDef as usize].item;
        let enumArguments = c.types.enums[t.enumDef as usize].typeArguments;
        if (resultOkType != none()) {
            let ok = substitute(c, resultOkType, map)?;
            let err = substitute(c, resultErrType, map)?;
            return resultOf(c, ok, err);
        }
        if (optionValue != none()) {
            let v = substitute(c, optionValue, map)?;
            return optionOf(c, v);
        }
        if (enumItem != none()) {
            var template = none();
            for (k in 0..c.enums.length) {
                if (c.enums[k].item == enumItem && c.enums[k].template == none()) {
                    template = truncate<u32>(k);
                }
            }
            if (template != none()) {
                var arguments = Vector<u32>.create();
                for (k in 0..enumArguments.count) {
                    let a = c.types.listAt(enumArguments, k);
                    arguments.push(substitute(c, a, map)?)?;
                }
                let entry = instantiateEnum(c, template, arguments.view(), Span { start: 0, end: 0 })?;
                return Ok(c.enums[entry as usize].typ);
            }
        }
        return Ok(typ);
    }
    if (c.types.is(typ, TypeKind.Vector)) {
        let elementType = c.types.info(t.pointee).element;
        let element = if (c.types.isString(typ)) none() else substitute(c, elementType, map)?;
        return vectorType(c, element, t.allocator);
    }
    if (c.types.is(typ, TypeKind.StableVector)) {
        let elementType = c.types.info(t.pointee).element;
        let e = substitute(c, elementType, map)?;
        return containerType(c, false, e, t.allocator);
    }
    if (c.types.is(typ, TypeKind.SlotMap)) {
        let e = substitute(c, t.element, map)?;
        return containerType(c, true, e, t.allocator);
    }
    if (c.types.is(typ, TypeKind.Handle)) {
        let e = substitute(c, t.element, map)?;
        return c.types.handleOf(e);
    }
    if (c.types.is(typ, TypeKind.Struct)) {
        let structItem = c.types.structs[t.structDef as usize].item;
        let structArguments = c.types.structs[t.structDef as usize].typeArguments;
        if (structItem != none()) {
            var template = none();
            for (k in 0..c.structs.length) {
                if (c.structs[k].item == structItem && c.structs[k].template == none()) {
                    template = truncate<u32>(k);
                }
            }
            if (template != none()) {
                var arguments = Vector<u32>.create();
                for (k in 0..structArguments.count) {
                    let a = c.types.listAt(structArguments, k);
                    arguments.push(substitute(c, a, map)?)?;
                }
                let entry = instantiateStruct(c, template, arguments.view(), Span { start: 0, end: 0 })?;
                return Ok(c.structs[entry as usize].typ);
            }
        }
        return Ok(typ);
    }
    // Function, closure and thread types come with S6.
    return Ok(typ);
}

/// An interface's name as messages write it: its declared name, with its package's for a dependency's (qualifiedName).
fn interfaceDisplayName(c: borrow Checker, entry: u32) -> Result<Vector<u8>, AllocError> {
    let item = c.interfaces[entry as usize].item;
    let symbol = c.front.ast.idents[c.front.ast.items[item as usize].name as usize].symbol;
    var name = Vector<u8>.create();
    qualifiedName(c, c.interfaces[entry as usize].file, c.name(symbol), mut name)?;
    return Ok(name);
}
