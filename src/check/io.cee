// I/O and the number methods (the reference's CheckResourceFunction, CheckResourceMethod, `e.message()`, the I/O cases
// of CheckBuiltinMemberCall, IntegerMethod, CheckIntegerMethod, FloatMethod and CheckFloatMethod): P3 S3e (§6, §26,
// §35). `File.kind` and `Process.capture` call lib/std's HostServices (src/check/library.cee).

fn builtinFile() -> u32 => 18;
fn builtinTcpListener() -> u32 => 19;
fn builtinTcpStream() -> u32 => 20;

fn ioResult(c: borrow mut Checker, ok: u32) -> Result<u32, AllocError> {
    let ioError = usedIoError(c);
    return resultOf(c, ok, ioError);
}

/// `File.open(path)`, `File.create(path)`, `File.remove(path)`, `TcpListener.bind(address, port)`,
/// `TcpStream.connect(address, port)` (CheckResourceFunction, §26).
fn checkResourceFunction(
    c: borrow mut Checker,
    owner: u32,
    member: u32,
    arguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    let ident = c.front.ast.idents[member as usize];
    var textBytes = Vector<u8>.create();
    appendBytes(mut textBytes, c.name(ident.symbol))?;
    let text = textBytes.view();
    if (owner == builtinFile() && (sameText(text, "kind") || sameText(text, "rename") || sameText(text, "modified") ||
        sameText(text, "setPermissions")) && !c.freestanding) {
        return checkHostService(c, member, arguments, span); // lib/std's HostServices.kind (§26.8, ADR 0028)
    }
    var function = none();
    var ok = none();
    if (owner == builtinFile() && sameText(text, "open")) {
        function = bfFileOpen();
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "create")) {
        function = bfFileCreate();
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "openReadWrite")) {
        function = bfFileOpenReadWrite(); // ADR 0075 §2.1
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "openOrCreate")) {
        function = bfFileOpenOrCreate();
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "createNew")) {
        function = bfFileCreateNew();
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "openAppend")) {
        function = bfFileOpenAppend(); // ADR 0077
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "openRegular")) {
        function = bfFileOpenRegular(); // ADR 0078 §3
        ok = c.types.file;
    } else if (owner == builtinFile() && sameText(text, "remove")) {
        function = bfFileRemove();
        ok = c.types.voidType;
    } else if (owner == builtinTcpListener() && sameText(text, "bind")) {
        function = bfTcpListen();
        ok = c.types.tcpListener;
    } else if (owner == builtinTcpStream() && sameText(text, "connect")) {
        function = bfTcpConnect();
        ok = c.types.tcpStream;
    }
    if (function == none()) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendText(mut message, builtinName(owner))?;
        appendText(mut message, "' has no function ")?;
        appendQuotedName(mut message, c, ident.symbol)?;
        appendBuiltinDidYouMean(c, mut message, builtinName(owner).bytes(), ident.symbol)?;
        c.error(undefinedName(), ident.start, ident.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let result = ioResult(c, ok)?;
    let withPort = function == bfTcpListen() || function == bfTcpConnect();
    if (arguments.count != (if (withPort) 2u32 else 1u32)) {
        var message = Vector<u8>.create();
        appendText(mut message, "write '")?;
        appendText(mut message, resourceUsage(function))?;
        appendText(mut message, "'")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var values = Vector<u32>.create();
    let view = c.types.stringView;
    let pathSyntax = c.front.ast.at(arguments, 0);
    values.push(checkArgument(c, pathSyntax, view)?)?;
    if (withPort) {
        let u16Type = c.types.u16;
        let portSyntax = c.front.ast.at(arguments, 1);
        values.push(checkExpr(c, portSyntax, u16Type)?)?;
    }
    for (v in values.view()) {
        if (c.isBottom(v)) {
            return c.errorResult(span.start, span.end);
        }
    }
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
}

fn resourceUsage(function: u32) -> StringView {
    if (function == bfFileOpen()) {
        return "File.open(path)";
    }
    if (function == bfFileCreate()) {
        return "File.create(path)";
    }
    if (function == bfFileRemove()) {
        return "File.remove(path)";
    }
    if (function == bfFileOpenReadWrite()) {
        return "File.openReadWrite(path)";
    }
    if (function == bfFileOpenOrCreate()) {
        return "File.openOrCreate(path)";
    }
    if (function == bfFileCreateNew()) {
        return "File.createNew(path)";
    }
    if (function == bfFileOpenAppend()) {
        return "File.openAppend(path)";
    }
    if (function == bfFileOpenRegular()) {
        return "File.openRegular(path)";
    }
    if (function == bfTcpListen()) {
        return "TcpListener.bind(address, port)";
    }
    return "TcpStream.connect(address, port)";
}

/// Methods of a file or socket place (CheckResourceMethod, §26.3, §26.4).
fn checkResourceMethod(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    resource: u32,
    targetSpan: Span,
    span: Span,
) -> Result<u32, AllocError> {
    let typ = c.typeOf(resource);
    let kind = c.types.info(typ).resource;
    let isFileOrStream = match (kind) {
        ResourceKind.File => true,
        ResourceKind.TcpStream => true,
        _ => false,
    };
    let isStream = match (kind) {
        ResourceKind.TcpStream => true,
        _ => false,
    };
    let isListener = match (kind) {
        ResourceKind.TcpListener => true,
        _ => false,
    };
    let isFile = match (kind) {
        ResourceKind.File => true,
        _ => false,
    };
    let ident = c.front.ast.idents[member as usize];
    var textBytes = Vector<u8>.create();
    appendBytes(mut textBytes, c.name(ident.symbol))?;
    let text = textBytes.view();
    if (isFile && (sameText(text, "modified") || sameText(text, "kind")) && !c.freestanding) {
        return checkFileMetadata(c, member, arguments, resource, targetSpan, span);
    }
    var function = none();
    var arity: u32 = 0;
    var mutable = true;
    var ok = none();
    if (isFileOrStream && sameText(text, "read")) {
        function = bfResourceRead();
        arity = 1;
        ok = c.types.usize;
    } else if (isFileOrStream && sameText(text, "write")) {
        function = bfResourceWrite();
        arity = 1;
        ok = c.types.voidType;
    } else if (isFile && sameText(text, "readAt")) {
        function = bfFileReadAt(); // ADR 0075 §2.1
        mutable = false;           // positional and whole-file calls leave the position alone: `borrow this` (ADR 0075 §8)
        arity = 2;
        ok = c.types.usize;
    } else if (isFile && sameText(text, "writeAt")) {
        function = bfFileWriteAt();
        mutable = false; // positional and whole-file calls leave the position alone: `borrow this` (ADR 0075 §8)
        arity = 2;
        ok = c.types.voidType;
    } else if (isFile && sameText(text, "syncData")) {
        function = bfFileSyncData();
        mutable = false; // positional and whole-file calls leave the position alone: `borrow this` (ADR 0075 §8)
        ok = c.types.voidType;
    } else if (isFile && sameText(text, "syncAll")) {
        function = bfFileSyncAll();
        mutable = false; // positional and whole-file calls leave the position alone: `borrow this` (ADR 0075 §8)
        ok = c.types.voidType;
    } else if (isFile && sameText(text, "length")) {
        function = bfFileLength();
        mutable = false; // positional and whole-file calls leave the position alone: `borrow this` (ADR 0075 §8)
        ok = c.types.u64;
    } else if (isFile && sameText(text, "setLength")) {
        function = bfFileSetLength();
        mutable = false; // positional and whole-file calls leave the position alone: `borrow this` (ADR 0075 §8)
        arity = 1;
        ok = c.types.voidType;
    } else if (isStream && sameText(text, "shutdownWrite")) {
        function = bfTcpShutdownWrite();
        ok = c.types.voidType;
    } else if (isStream && sameText(text, "shutdownRead")) {
        function = bfTcpShutdownRead();
        ok = c.types.voidType;
    } else if (isStream && tcpOption(text) != none()) {
        function = tcpOption(text);
        arity = 1;
        mutable = false;
        ok = c.types.voidType;
    } else if (isListener && sameText(text, "accept")) {
        function = bfTcpAccept();
        mutable = false;
        ok = c.types.tcpStream;
    } else if (isListener && sameText(text, "port")) {
        function = bfTcpPort();
        mutable = false;
        ok = c.types.u16;
    }
    if (function == none()) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " has no method ")?;
        appendQuotedName(mut message, c, ident.symbol)?;
        appendBuiltinDidYouMean(c, mut message, c.typeName(typ), ident.symbol)?;
        c.error(undefinedName(), ident.start, ident.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let result = ioResult(c, ok)?;
    if (arguments.count != arity) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, text)?;
        appendText(
            mut message,
            if (arity == 0) "' takes no arguments"
                else if (arity == 1) "' takes one argument"
                else "' takes two arguments",
        )?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var argument = none();
    var offset = none();
    if (arity == 2) {
        // readAt(mut buffer, offset) and writeAt(bytes, offset) (ADR 0075 §2.1).
        let u8Type = c.types.u8;
        let u64Type = c.types.u64;
        let bytes = c.types.sliceOf(u8Type, function == bfFileReadAt())?;
        let bufferSyntax = c.front.ast.at(arguments, 0);
        argument = checkArgument(c, bufferSyntax, bytes)?;
        let offsetSyntax = c.front.ast.at(arguments, 1);
        offset = checkExpr(c, offsetSyntax, u64Type)?;
    } else if (arity == 1 && function == bfFileSetLength()) {
        let u64Type = c.types.u64;
        let lengthSyntax = c.front.ast.at(arguments, 0);
        argument = checkExpr(c, lengthSyntax, u64Type)?;
    } else if (arity == 1) {
        let u8Type = c.types.u8;
        let u32Type = c.types.u32;
        let parameter =
            if (function == bfTcpSetNoDelay()) c.types.boolType
                else if (function == bfTcpSetSendBuffer() || function == bfTcpSetRecvBuffer()) u32Type
                else if (function == bfTcpSetKeepAlive() || function == bfTcpSetLinger()) optionOf(
                    c,
                    u32Type,
                )?
                else c.types.sliceOf(
                    u8Type,
                    function == bfResourceRead(),
                )?;
        let argumentSyntax = c.front.ast.at(arguments, 0);
        argument = checkArgument(c, argumentSyntax, parameter)?;
    }
    let receiver = borrowReceiver(c, resource, mutable, targetSpan)?;
    if (c.isBottom(receiver) || (argument != none() && c.isBottom(argument)) ||
        (offset != none() && c.isBottom(offset))) {
        return c.errorResult(span.start, span.end);
    }
    var values = Vector<u32>.create();
    values.push(receiver)?;
    if (argument != none()) {
        values.push(argument)?;
    }
    if (offset != none()) {
        values.push(offset)?;
    }
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
}

/// `f.modified()` and `f.kind()` (ADR 0078 §3): lib/std's FileMetadata function of that name, called with `f` borrowed.
fn checkFileMetadata(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    resource: u32,
    targetSpan: Span,
    span: Span,
) -> Result<u32, AllocError> {
    let symbol = c.front.ast.idents[member as usize].symbol;
    let none0 = Vector<u32>.create();
    let function = libraryFunction(c, "FileMetadata", none0.view(), symbol, span)?;
    if (function == none()) {
        c.notPorted(span.start, span.end, "this file method", "S5")?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let receiver = borrowReceiver(c, resource, false, targetSpan)?;
    if (c.isBottom(receiver)) {
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    return checkUserCallWith(c, function, arguments, span, receiver);
}

/// TcpStream's option setters (ADR 0044 §3.6), or none.
fn tcpOption(name: Slice<u8>) -> u32 {
    if (sameText(name, "setNoDelay")) {
        return bfTcpSetNoDelay();
    }
    if (sameText(name, "setKeepAlive")) {
        return bfTcpSetKeepAlive();
    }
    if (sameText(name, "setSendBuffer")) {
        return bfTcpSetSendBuffer();
    }
    if (sameText(name, "setRecvBuffer")) {
        return bfTcpSetRecvBuffer();
    }
    if (sameText(name, "setLinger")) {
        return bfTcpSetLinger();
    }
    return none();
}

/// `e.message()` on an IoError (§26.2): static text for the variant.
fn checkIoErrorMessage(c: borrow mut Checker, receiver: u32, span: Span) -> Result<u32, AllocError> {
    let read = autoDeref(c, receiver)?;
    let values = [read];
    let list = c.hir.list(values[..])?;
    let view = c.types.stringView;
    return c.expr(HirExpr.BuiltinCall(bfIoErrorMessage(), list), view, span.start, span.end);
}

/// The built-in arithmetic methods of integer types (IntegerMethod, §6, M11), or none.
fn integerMethod(name: Slice<u8>) -> u32 {
    if (sameText(name, "wrappingAdd")) {
        return bfWrappingAdd();
    }
    if (sameText(name, "wrappingSub")) {
        return bfWrappingSub();
    }
    if (sameText(name, "wrappingMul")) {
        return bfWrappingMul();
    }
    if (sameText(name, "checkedAdd")) {
        return bfCheckedAdd();
    }
    if (sameText(name, "checkedSub")) {
        return bfCheckedSub();
    }
    if (sameText(name, "checkedMul")) {
        return bfCheckedMul();
    }
    if (sameText(name, "saturatingAdd")) {
        return bfSaturatingAdd();
    }
    if (sameText(name, "saturatingSub")) {
        return bfSaturatingSub();
    }
    if (sameText(name, "saturatingMul")) {
        return bfSaturatingMul();
    }
    if (sameText(name, "min")) {
        return bfIntMin();
    }
    if (sameText(name, "max")) {
        return bfIntMax();
    }
    if (sameText(name, "abs")) {
        return bfIntAbs();
    }
    if (sameText(name, "unsignedAbs")) {
        return bfIntUnsignedAbs();
    }
    return integerBitMethod(name);
}

/// The bit methods of integers (ADR 0071 §2.3), or none.
fn integerBitMethod(name: Slice<u8>) -> u32 {
    if (sameText(name, "rotateLeft")) {
        return bfIntRotateLeft();
    }
    if (sameText(name, "rotateRight")) {
        return bfIntRotateRight();
    }
    if (sameText(name, "wrappingShl")) {
        return bfIntWrappingShl();
    }
    if (sameText(name, "wrappingShr")) {
        return bfIntWrappingShr();
    }
    if (sameText(name, "leadingZeros")) {
        return bfIntLeadingZeros();
    }
    if (sameText(name, "trailingZeros")) {
        return bfIntTrailingZeros();
    }
    if (sameText(name, "countOnes")) {
        return bfIntCountOnes();
    }
    if (sameText(name, "byteSwap")) {
        return bfIntByteSwap();
    }
    return none();
}

/// The built-in methods of a float value (FloatMethod, §35.5, §35.8), or none.
fn floatMethod(name: Slice<u8>) -> u32 {
    if (sameText(name, "bits")) {
        return bfFloatBits();
    }
    if (sameText(name, "sqrt")) {
        return bfFloatSqrt();
    }
    if (sameText(name, "abs")) {
        return bfFloatAbs();
    }
    if (sameText(name, "floor")) {
        return bfFloatFloor();
    }
    if (sameText(name, "ceil")) {
        return bfFloatCeil();
    }
    if (sameText(name, "min")) {
        return bfFloatMin();
    }
    if (sameText(name, "max")) {
        return bfFloatMax();
    }
    return none();
}

/// `x.wrappingAdd(y)`, `x.min(y)` and the rest (CheckIntegerMethod): one argument of the receiver's type; never panics.
fn checkIntegerMethod(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    receiver: u32,
    function: u32,
    span: Span,
) -> Result<u32, AllocError> {
    if (function == bfIntAbs() || function == bfIntUnsignedAbs()) {
        return checkIntegerAbs(c, member, arguments, receiver, function, span);
    }
    if (function >= bfIntRotateLeft() && function <= bfIntByteSwap()) {
        return checkIntegerBits(c, member, arguments, receiver, function, span);
    }
    if (arguments.count != 1) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, c.front.ast.idents[member as usize].symbol)?;
        appendText(mut message, " takes one argument")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let typ = c.typeOf(receiver);
    let argumentSyntax = c.front.ast.at(arguments, 0);
    let argument = checkExpr(c, argumentSyntax, typ)?;
    if (c.isBottom(argument)) {
        return c.errorResult(span.start, span.end);
    }
    let checked = function == bfCheckedAdd() || function == bfCheckedSub() || function == bfCheckedMul();
    let result = if (checked) optionOf(c, typ)? else typ;
    let values = [receiver, argument];
    let list = c.hir.list(values[..])?;
    return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
}

/// The unsigned integer type of `typ`'s width.
fn unsignedTwin(c: borrow Checker, typ: u32) -> u32 {
    if (typ == c.types.isize) {
        return c.types.usize;
    }
    let bits = c.types.info(typ).bits;
    return if (bits == 8) c.types.u8 else if (bits == 16) c.types.u16 else if (bits == 32) c.types.u32 else c.types.u64;
}

/// `x.abs()` and `x.unsignedAbs()` (ADR 0063 §2.5): no arguments, a signed receiver; `abs` is of the receiver's type and
/// panics at its minimum, as `-x` does; `unsignedAbs` is of the unsigned type of its width and never panics.
fn checkIntegerAbs(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    receiver: u32,
    function: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let typ = c.typeOf(receiver);
    if (!c.types.info(typ).signed) {
        var message = Vector<u8>.create();
        appendText(mut message, "type ")?;
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " is unsigned, so it has no ")?;
        appendQuotedName(mut message, c, c.front.ast.idents[member as usize].symbol)?;
        appendText(mut message, ": the value is its own magnitude (ADR 0063 §2.5)")?;
        c.error(notAStruct(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (arguments.count != 0) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, c.front.ast.idents[member as usize].symbol)?;
        appendText(mut message, " takes no arguments")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let result = if (function == bfIntAbs()) typ else unsignedTwin(c, typ);
    let values = [receiver];
    let list = c.hir.list(values[..])?;
    return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
}

/// `x.rotateLeft(n)` … `x.byteSwap()` (ADR 0071 §2.3). Every one but `byteSwap` needs an unsigned receiver, as the bit
/// operators do (§6). Rotations and the masking shifts take a `u32` amount, taken modulo the width; the counts are
/// `u32`. None of them panics.
fn checkIntegerBits(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    receiver: u32,
    function: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let typ = c.typeOf(receiver);
    if (function != bfIntByteSwap() && c.types.info(typ).signed) {
        var message = Vector<u8>.create();
        appendText(mut message, "type ")?;
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " is signed, so it has no ")?;
        appendQuotedName(mut message, c, c.front.ast.idents[member as usize].symbol)?;
        appendText(
            mut message,
            ": bit operations are on unsigned types; reinterpret with 'truncate<u32>(x)' (ADR 0071 §2.3)",
        )?;
        c.error(notAStruct(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let takesAmount = function <= bfIntWrappingShr();
    if (arguments.count != (if (takesAmount) 1u32 else 0u32)) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, c.front.ast.idents[member as usize].symbol)?;
        appendText(mut message, if (takesAmount) " takes one argument, a 'u32' amount" else " takes no arguments")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var values = Vector<u32>.create();
    values.push(receiver)?;
    if (takesAmount) {
        let u32Type = c.types.u32;
        let argumentSyntax = c.front.ast.at(arguments, 0);
        let amount = checkExpr(c, argumentSyntax, u32Type)?;
        if (c.isBottom(amount)) {
            return c.errorResult(span.start, span.end);
        }
        values.push(amount)?;
    }
    let counts = function == bfIntLeadingZeros() || function == bfIntTrailingZeros() || function == bfIntCountOnes();
    let result = if (counts) c.types.u32 else typ;
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
}

/// `f.bits()`, `f.sqrt()` … `f.min(g)` (CheckFloatMethod, §35.5, §35.8).
fn checkFloatMethod(
    c: borrow mut Checker,
    member: u32,
    arguments: Range,
    receiver: u32,
    function: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let binary = function == bfFloatMin() || function == bfFloatMax();
    if (arguments.count != (if (binary) 1u32 else 0u32)) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, c.front.ast.idents[member as usize].symbol)?;
        appendText(mut message, if (binary) " takes one argument" else " takes no arguments")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let typ = c.typeOf(receiver);
    if (function == bfFloatBits()) {
        let bitsType = if (c.types.info(typ).bits == 32) c.types.u32 else c.types.u64;
        let values = [receiver];
        let list = c.hir.list(values[..])?;
        return c.expr(HirExpr.BuiltinCall(function, list), bitsType, span.start, span.end);
    }
    if (!binary) {
        let values = [receiver];
        let list = c.hir.list(values[..])?;
        return c.expr(HirExpr.BuiltinCall(function, list), typ, span.start, span.end);
    }
    let otherSyntax = c.front.ast.at(arguments, 0);
    let other = checkExpr(c, otherSyntax, typ)?;
    if (c.isBottom(other)) {
        return c.errorResult(span.start, span.end);
    }
    let values = [receiver, other];
    let list = c.hir.list(values[..])?;
    return c.expr(HirExpr.BuiltinCall(function, list), typ, span.start, span.end);
}
