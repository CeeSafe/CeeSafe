// Enums, `match` and branching (the reference's CheckEnumValue, CheckMatch, CheckNestedMatch, CheckPattern,
// CheckVariantPattern, DeclareBinding, ResolvePatternVariant, VariantText, CheckBranching, CheckBranch and
// FinishBranches): P3 S2b. Pattern usefulness is in src/check/usefulness.cee.

fn branchCompletes() -> u32 => 235;
fn nonExhaustiveMatch() -> u32 => 256;
fn unreachableArm() -> u32 => 257;

/// Is the enum a `Result` or an optional, whose variants are written without a type prefix?
fn isOptionOrResult(c: borrow Checker, typ: u32) -> bool {
    let definition = c.types.info(typ).enumDef;
    let d = borrow c.types.enums[definition as usize];
    return d.optionType != none() || d.resultOk != none();
}

/// The variant as a pattern writes it: `null`, `Some`, `Ok`, `Err`, or `E.V` (VariantText).
fn appendVariantText(
    out: borrow mut Vector<u8>,
    c: borrow Checker,
    variant: u32,
    typ: u32,
) -> Result<void, AllocError> {
    if (!isOptionOrResult(c, typ)) {
        appendBytes(out, c.typeName(typ))?;
        out.push('.')?;
    }
    return appendBytes(out, c.name(c.types.variants[variant as usize].name));
}

fn variantAt(c: borrow Checker, typ: u32, k: usize) -> u32 {
    let definition = c.types.info(typ).enumDef;
    return c.types.enums[definition as usize].variants[k];
}

fn payloadType(c: borrow Checker, variant: u32, k: usize) -> u32 {
    let field = c.types.variants[variant as usize].payload[k];
    return c.types.fields[field as usize].typ;
}

fn payloadCount(c: borrow Checker, variant: u32) -> usize => c.types.variants[variant as usize].payload.length;

/// Is the variant the `Ok` of a `Result<void, E>`, whose payload is a unit (§20.4)? It has no payload slot, but a
/// pattern may bind one name to it and a construction may pass one `void` argument.
fn isUnitPayload(c: borrow Checker, typ: u32, variant: u32) -> bool {
    if (!c.types.is(typ, TypeKind.Enum)) {
        return false;
    }
    let d = borrow c.types.enums[c.types.info(typ).enumDef as usize];
    return d.resultOk != none() && c.types.is(d.resultOk, TypeKind.Void) && d.variants.length > 0 &&
        d.variants[0] == variant;
}

/// A unit value (§20.4), the read of a unit local: an empty block's value, of type `void`. It holds nothing, and the
/// places that take a unit (a payload, `return`, a `let`) erase it.
fn unitValue(c: borrow mut Checker, span: Span) -> Result<u32, AllocError> {
    let block = c.hir.addStmt(HirStmt.Block(emptyRange()), span.start, span.end)?;
    let voidType = c.types.voidType;
    return c.expr(HirExpr.StmtValue(block), voidType, span.start, span.end);
}

/// Is `e` a unit value (`unitValue`)?
fn isUnitValue(c: borrow Checker, e: u32) -> bool {
    if (!c.types.is(c.typeOf(e), TypeKind.Void)) {
        return false;
    }
    match (c.hir.exprs[e as usize]) {
        HirExpr.StmtValue(statement) => {
            match (c.hir.stmts[statement as usize]) {
                HirStmt.Block(statements) => { return statements.count == 0; }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

/// A name bound to a unit payload (§20.4): a unit local, after the check `declareBinding` makes.
fn declareUnitBinding(c: borrow mut Checker, name: u32) -> Result<void, AllocError> {
    let ident = c.front.ast.idents[name as usize];
    if (c.lookupLocal(ident.symbol)? != none()) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, ident.symbol)?;
        appendText(mut message, " is already declared in this function; locals cannot be shadowed")?;
        c.error(localRedeclared(), ident.start, ident.end, message)?;
    }
    return c.bindUnit(ident.symbol);
}

/// `Ok(v)` binding a unit payload (§20.4): one plain name or `_`, no nested pattern.
fn bindsUnitPayload(c: borrow Checker, typ: u32, variant: u32, bindings: Range) -> bool {
    if (bindings.count != 1 || payloadCount(c, variant) != 0 || !isUnitPayload(c, typ, variant)) {
        return false;
    }
    return c.front.ast.bindings[c.front.ast.at(bindings, 0) as usize].nested == none();
}

/// `E.V` or `E.V(a, b)` (CheckEnumValue) for a non-generic enum.
fn checkEnumValue(
    c: borrow mut Checker,
    template: u32,
    member: u32,
    arguments: Range,
    typeArguments: Range,
    targetSpan: Span,
    span: Span,
    expected: u32,
) -> Result<u32, AllocError> {
    useEnumEntry(c, template);
    if (c.freestanding && c.enums[template as usize].typ == c.ioErrorType) {
        hostedOnly(c, targetSpan, "'IoError'".bytes())?;
        for (k in 0..arguments.count) {
            let argument = c.front.ast.at(arguments, k);
            synth(c, argument, none())?;
        }
        return c.errorResult(span.start, span.end);
    }
    var index = template;
    let entryItem = c.enums[template as usize].item;
    if (isGenericItem(c, entryItem)) {
        // `Maybe.Just(7)`, `Maybe<u8>.Nothing`, or a variant of the expected instance (§20.2).
        let templateType = c.enums[template as usize].typ;
        let templateDefinition = c.types.info(templateType).enumDef;
        let memberSymbol = c.front.ast.idents[member as usize].symbol;
        let templateVariant = findVariant(c, templateDefinition, memberSymbol);
        var pairs = Vector<InferencePair>.create();
        if (templateVariant != none()) {
            let count = payloadCount(c, templateVariant);
            for (k in 0..arguments.count) {
                if ((k as usize) < count) {
                    pairs.push(
                        InferencePair {
                            declared: payloadType(c, templateVariant, k as usize),
                            value: c.front.ast.at(arguments, k),
                        },
                    )?;
                }
            }
        }
        var expectedArguments = emptyRange();
        var hasExpected = false;
        if (expected != none() && c.types.is(expected, TypeKind.Enum)) {
            let expectedDefinition = c.types.info(expected).enumDef;
            if (c.types.enums[expectedDefinition as usize].item == entryItem) {
                expectedArguments = c.types.enums[expectedDefinition as usize].typeArguments;
                hasExpected = true;
            }
        }
        var parameters = Vector<u32>.create();
        listTypes(c, c.types.enums[templateDefinition as usize].typeArguments, mut parameters)?;
        let nameSymbol = c.front.ast.idents[c.front.ast.items[entryItem as usize].name as usize].symbol;
        var text = Vector<u8>.create();
        appendBytes(mut text, c.name(nameSymbol))?;
        var found = Vector<u32>.create();
        if (!typeArgumentsFor(
            c,
            text.view(),
            parameters.view(),
            typeArguments,
            expectedArguments,
            hasExpected,
            pairs.view(),
            span,
            mut found,
        )?) {
            synthAll(c, arguments)?;
            return c.errorResult(span.start, span.end);
        }
        index = instantiateEnum(c, template, found.view(), span)?;
    } else if (typeArguments.count > 0) {
        let typ = c.enums[index as usize].typ;
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " is not generic; write it without type arguments")?;
        c.error(unknownType(), targetSpan.start, targetSpan.end, message)?;
    }
    let typ = c.enums[index as usize].typ;
    let definition = c.types.info(typ).enumDef;
    let ident = c.front.ast.idents[member as usize];
    let variant = findVariant(c, definition, ident.symbol);
    if (variant == none()) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " has no variant named ")?;
        appendQuotedName(mut message, c, ident.symbol)?;
        c.error(undefinedName(), ident.start, ident.end, message)?;
        synthAll(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let count = payloadCount(c, variant);
    if (arguments.count as usize != count) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendVariantName(mut message, c, typ, variant)?;
        appendText(mut message, "' has ")?;
        appendDecimal(mut message, count as u64)?;
        appendText(mut message, " payload value(s) but ")?;
        appendDecimal(mut message, arguments.count as u64)?;
        appendText(mut message, " were given")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        synthAll(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var payload = Vector<u32>.create();
    for (k in 0..count) {
        let t = payloadType(c, variant, k);
        let argument = c.front.ast.at(arguments, truncate<u32>(k));
        payload.push(checkExpr(c, argument, t)?)?;
    }
    let list = c.hir.list(payload.view())?;
    return c.expr(HirExpr.EnumValue(variant, list), typ, span.start, span.end);
}

/// `{type}.{V}`, as messages name a variant.
fn appendVariantName(
    out: borrow mut Vector<u8>,
    c: borrow Checker,
    typ: u32,
    variant: u32,
) -> Result<void, AllocError> {
    appendBytes(out, c.typeName(typ))?;
    out.push('.')?;
    return appendBytes(out, c.name(c.types.variants[variant as usize].name));
}

fn synthAll(c: borrow mut Checker, arguments: Range) -> Result<void, AllocError> {
    for (k in 0..arguments.count) {
        let argument = c.front.ast.at(arguments, k);
        synth(c, argument, none())?;
    }
    return Ok();
}

// ---- match ----

/// The type of an `if` or `match` expression, found as its branches are checked in order (BranchType, §15.3).
struct BranchType {
    typ: u32; // or none
    deferred: Vector<DeferredBranch>;
}

/// A flexible or `null` branch met before the type was known.
struct DeferredBranch {
    index: u32;
    value: u32; // an expression
}

fn branchType(expected: u32) -> BranchType => BranchType { typ: expected, deferred: Vector<DeferredBranch>.create() };

fn armPattern(c: borrow Checker, arms: Range, k: u32, isValue: bool) -> u32 {
    let arm = c.front.ast.at(arms, k);
    return if (isValue) c.front.ast.valueArms[arm as usize].pattern else c.front.ast.matchArms[arm as usize].pattern;
}

/// An arm's guard (ADR 0085 §2.2): an expression, or none.
fn armGuard(c: borrow Checker, arms: Range, k: u32, isValue: bool) -> u32 {
    let arm = c.front.ast.at(arms, k);
    return if (isValue) c.front.ast.valueArms[arm as usize].guard else c.front.ast.matchArms[arm as usize].guard;
}

fn armSpan(c: borrow Checker, arms: Range, k: u32, isValue: bool) -> Span {
    let arm = c.front.ast.at(arms, k);
    if (isValue) {
        let a = c.front.ast.valueArms[arm as usize];
        return Span { start: a.start, end: a.end };
    }
    let a = c.front.ast.matchArms[arm as usize];
    return Span { start: a.start, end: a.end };
}

/// An arm's body: a block of a `match` statement, or a branch of a `match` expression.
fn checkArmBody(
    c: borrow mut Checker,
    arms: Range,
    k: u32,
    isValue: bool,
    branches: borrow mut BranchType,
) -> Result<u32, AllocError> {
    let arm = c.front.ast.at(arms, k);
    if (isValue) {
        let value = c.front.ast.valueArms[arm as usize].value;
        return checkBranch(c, value, branches, k);
    }
    let body = c.front.ast.matchArms[arm as usize].body;
    return checkBlock(c, body);
}

/// Does the pattern need the nested path (checkNestedMatch): a nested pattern, or a form of ADR 0085?
fn hasNested(c: borrow Checker, pattern: u32) -> bool {
    match (c.front.ast.patterns[pattern as usize]) {
        PatternNode.Or(_) => { return true; }
        PatternNode.Range(_, _, _) => { return true; }
        PatternNode.At(_, _) => { return true; }
        PatternNode.Variant(_, _, bindings) => {
            for (k in 0..bindings.count) {
                if (c.front.ast.bindings[c.front.ast.at(bindings, k) as usize].nested != none()) {
                    return true;
                }
            }
            return false;
        }
        _ => { return false; }
    }
}

fn listsPayloads(c: borrow Checker, pattern: u32) -> bool => match (c.front.ast.patterns[pattern as usize]) {
    PatternNode.Variant(_, hasBindings, _) => hasBindings,
    _ => false,
};

fn sameInt(a: IntValue, b: IntValue) -> bool => a.negative == b.negative && a.magnitude == b.magnitude;

fn containsInt(values: borrow Vector<IntValue>, v: IntValue) -> bool {
    for (w in values.view()) {
        if (sameInt(w, v)) {
            return true;
        }
    }
    return false;
}

fn containsU32(values: borrow Vector<u32>, v: u32) -> bool {
    for (w in values.view()) {
        if (w == v) {
            return true;
        }
    }
    return false;
}

fn checkMatchStmt(c: borrow mut Checker, scrutinee: u32, arms: Range, span: Span) -> Result<u32, AllocError> {
    var branches = branchType(none());
    return checkMatch(c, scrutinee, arms, false, mut branches, span);
}

/// A match on `scrutineeSyntax` (CheckMatch, §15.2): a statement's arms, or an expression's (`isValue`).
fn checkMatch(
    c: borrow mut Checker,
    scrutineeSyntax: u32,
    arms: Range,
    isValue: bool,
    branches: borrow mut BranchType,
    span: Span,
) -> Result<u32, AllocError> {
    let scrutinee = synth(c, scrutineeSyntax, none())?;
    let scrutineeType = c.typeOf(scrutinee);
    let reference = if (c.types.is(scrutineeType, TypeKind.Reference)) scrutineeType else none();
    let typ = if (reference != none()) c.types.info(reference).pointee else scrutineeType;
    let scrutineeSpan = c.front.ast.exprSpans[scrutineeSyntax as usize];
    var ok = !c.types.isBottom(typ);
    if (ok && !c.types.is(
        typ,
        TypeKind.Enum,
    ) && !c.types.is(typ, TypeKind.Integer) && !c.types.is(typ, TypeKind.Bool)) {
        var message = Vector<u8>.create();
        appendText(mut message, "cannot match on a value of type ")?;
        appendQuotedType(mut message, c, typ)?;
        c.error(invalidOperandTypes(), scrutineeSpan.start, scrutineeSpan.end, message)?;
        ok = false;
    }
    if (ok) {
        // An integer match without `_` too: its literals and ranges may cover the type (ADR 0085 §2.4).
        var nested = c.types.is(typ, TypeKind.Integer);
        for (k in 0..arms.count) {
            if (hasNested(c, armPattern(c, arms, k, isValue)) || armGuard(c, arms, k, isValue) != none()) {
                return checkNestedMatch(c, scrutineeSyntax, arms, isValue, branches, span, scrutinee, typ, reference);
            }
            match (c.front.ast.patterns[armPattern(c, arms, k, isValue) as usize]) {
                PatternNode.Wildcard => { nested = false; }
                _ => {}
            }
        }
        if (nested) {
            return checkNestedMatch(c, scrutineeSyntax, arms, isValue, branches, span, scrutinee, typ, reference);
        }
    }
    var armIds = Vector<u32>.create();
    var seenVariants = Vector<u32>.create();
    var seenValues = Vector<IntValue>.create();
    var wildcard = false;
    var patternFailed = false; // an invalid pattern already reported: exhaustiveness would only add noise
    var consumes = false;
    for (index in 0..arms.count) {
        let pattern = armPattern(c, arms, index, isValue);
        let patternSpan = c.front.ast.patternSpans[pattern as usize];
        if (wildcard) {
            var message = Vector<u8>.create();
            appendText(mut message, "this arm can never match: an earlier '_' matches everything")?;
            c.error(unreachableArm(), patternSpan.start, patternSpan.end, message)?;
        }
        var kind = HirPatternKind.Wildcard;
        var variant = none();
        var value = intValue(0);
        var bindings = Vector<HirArmBinding>.create();
        c.pushScope()?;
        match (c.front.ast.patterns[pattern as usize]) {
            PatternNode.Or(_) => { patternFailed = true; } // the nested path's (hasNested)
            PatternNode.Range(_, _, _) => { patternFailed = true; }
            PatternNode.At(_, _) => { patternFailed = true; }
            PatternNode.Wildcard => { wildcard = true; }
            PatternNode.Literal(literal) => {
                if (ok) {
                    let hir = checkExpr(c, literal, typ)?;
                    var isConstant = true;
                    match (c.hir.exprs[hir as usize]) {
                        HirExpr.IntConst(v) => {
                            kind = HirPatternKind.IntegerLiteral;
                            value = v;
                        }
                        HirExpr.BoolConst(b) => {
                            kind = HirPatternKind.Bool;
                            value = intValue(if (b) 1 else 0);
                        }
                        _ => { isConstant = false; }
                    }
                    if (isConstant) {
                        if (containsInt(seenValues, value)) {
                            var message = Vector<u8>.create();
                            appendText(mut message, "this value is already matched by an earlier arm")?;
                            c.error(unreachableArm(), patternSpan.start, patternSpan.end, message)?;
                        } else {
                            seenValues.push(value)?;
                        }
                    }
                }
            }
            PatternNode.Null => {
                if (ok) {
                    if (c.types.optionType(typ) == none()) {
                        var message = Vector<u8>.create();
                        appendText(mut message, "a 'null' pattern needs an optional, but the value has type ")?;
                        appendQuotedType(mut message, c, typ)?;
                        c.error(typeMismatch(), patternSpan.start, patternSpan.end, message)?;
                        patternFailed = true;
                    } else {
                        kind = HirPatternKind.Variant;
                        variant = variantAt(c, typ, 0);
                        if (containsU32(seenVariants, variant)) {
                            var message = Vector<u8>.create();
                            appendText(mut message, "'null' is already matched by an earlier arm")?;
                            c.error(unreachableArm(), patternSpan.start, patternSpan.end, message)?;
                        } else {
                            seenVariants.push(variant)?;
                        }
                    }
                }
            }
            PatternNode.Variant(path, hasBindings, payload) => {
                if (ok) {
                    kind = HirPatternKind.Variant;
                    variant = checkVariantPattern(
                        c,
                        path,
                        hasBindings,
                        payload,
                        patternSpan,
                        typ,
                        reference,
                        mut bindings,
                    )?;
                    if (variant == none()) {
                        patternFailed = true;
                    } else if (containsU32(seenVariants, variant)) {
                        var message = Vector<u8>.create();
                        appendText(mut message, "variant '")?;
                        appendBytes(mut message, c.name(c.types.variants[variant as usize].name))?;
                        appendText(mut message, "' is already matched by an earlier arm")?;
                        c.error(unreachableArm(), patternSpan.start, patternSpan.end, message)?;
                    } else {
                        seenVariants.push(variant)?;
                    }
                }
            }
        }
        // The bindings go into the table before the body, whose own matches add theirs after.
        let bindingStart = truncate<u32>(c.hir.armBindings.length);
        for (b in bindings.view()) {
            c.hir.armBindings.push(b)?;
            if (!c.types.isCopy(c.hir.locals[b.local as usize].typ)) {
                consumes = true;
            }
        }
        let bindingRange = Range { start: bindingStart, count: truncate<u32>(bindings.length) };
        let body = checkArmBody(c, arms, index, isValue, branches)?;
        c.popScope();
        let armSpanValue = armSpan(c, arms, index, isValue);
        c.hir.arms.push(HirArm {
            kind: kind,
            variant: variant,
            value: value,
            bindings: bindingRange,
            body: body,
            start: armSpanValue.start,
            end: armSpanValue.end,
            listsPayloads: listsPayloads(c, pattern),
            pattern: none(),
            guard: none(),
        })?;
        armIds.push(truncate<u32>(c.hir.arms.length - 1))?;
    }

    if (ok && !wildcard && !patternFailed) {
        var missing = Vector<u8>.create();
        var any = false;
        if (c.types.is(typ, TypeKind.Enum)) {
            let definition = c.types.info(typ).enumDef;
            let count = c.types.enums[definition as usize].variants.length;
            for (k in 0..count) {
                let v = variantAt(c, typ, k);
                if (!containsU32(seenVariants, v)) {
                    if (any) {
                        appendText(mut missing, ", ")?;
                    }
                    appendVariantText(mut missing, c, v, typ)?;
                    any = true;
                }
            }
        } else if (c.types.is(typ, TypeKind.Bool)) {
            for (k in 0..2u64) {
                if (!containsInt(seenValues, intValue(truncate<i64>(k)))) {
                    if (any) {
                        appendText(mut missing, ", ")?;
                    }
                    appendText(mut missing, if (k == 1) "true" else "false")?;
                    any = true;
                }
            }
        } else {
            appendText(mut missing, "_")?;
            any = true;
        }
        if (any) {
            var message = Vector<u8>.create();
            appendText(mut message, "this match does not cover ")?;
            appendBytes(mut message, missing.view())?;
            appendText(mut message, "; add the missing arms or a '_' arm")?;
            c.error(nonExhaustiveMatch(), scrutineeSpan.start, scrutineeSpan.end, message)?;
        }
    }
    if (!ok) {
        let error = c.errorResult(span.start, span.end)?;
        return c.hir.addStmt(HirStmt.Expression(error), span.start, span.end);
    }
    // A value scrutinee with a non-Copy payload bound by name is consumed (§18.4).
    let list = c.hir.list(armIds.view())?;
    return c.hir.addStmt(HirStmt.Match(scrutinee, list, reference == none() && consumes, false), span.start, span.end);
}

/// A `match` with nested patterns (CheckNestedMatch, M11) or guards (ADR 0085 §2.2): each arm's pattern as a tree,
/// exhaustiveness and unreachable arms by usefulness. A guarded arm is checked for reachability, but never counts
/// toward coverage.
fn checkNestedMatch(
    c: borrow mut Checker,
    scrutineeSyntax: u32,
    arms: Range,
    isValue: bool,
    branches: borrow mut BranchType,
    span: Span,
    scrutinee: u32,
    typ: u32,
    reference: u32,
) -> Result<u32, AllocError> {
    var armIds = Vector<u32>.create();
    var earlier = Vector<u32>.create(); // the unguarded arms' patterns
    var every = Vector<u32>.create();   // every arm's
    var failed = false;
    let scrutineeRoot = rootLocalOf(c, scrutinee);
    for (index in 0..arms.count) {
        let pattern = armPattern(c, arms, index, isValue);
        let patternSpan = c.front.ast.patternSpans[pattern as usize];
        let guardSyntax = armGuard(c, arms, index, isValue);
        c.pushScope()?;
        var alternatives = Alternatives { active: false, names: Vector<AlternativeName>.create() };
        let tree = checkPattern(c, pattern, typ, reference, mut failed, mut alternatives)?;
        var guard = none();
        if (guardSyntax != none()) {
            let boolType = c.types.boolType;
            guard = checkExpr(c, guardSyntax, boolType)?;
            checkGuardWrites(c, guard, tree, scrutineeRoot)?;
        }
        let body = checkArmBody(c, arms, index, isValue, branches)?;
        c.popScope();
        if (!failed) {
            var witness = Vector<u8>.create();
            if (!patternWitness(c, earlier.view(), tree, typ, mut witness)?) {
                var message = Vector<u8>.create();
                appendText(mut message, "this arm can never match: earlier arms match every value it does")?;
                c.error(unreachableArm(), patternSpan.start, patternSpan.end, message)?;
            } else {
                unreachableAlternatives(c, earlier.view(), tree, pattern, typ)?;
            }
        }
        if (guard == none()) {
            earlier.push(tree)?;
        }
        every.push(tree)?;
        let armSpanValue = armSpan(c, arms, index, isValue);
        c.hir.arms.push(HirArm {
            kind: HirPatternKind.Wildcard,
            variant: none(),
            value: intValue(0),
            bindings: emptyRange(),
            body: body,
            start: armSpanValue.start,
            end: armSpanValue.end,
            listsPayloads: listsPayloads(c, pattern),
            pattern: tree,
            guard: guard,
        })?;
        armIds.push(truncate<u32>(c.hir.arms.length - 1))?;
    }
    if (!failed) {
        let wildcardPattern = c.hir.addPattern(HirPattern.Wildcard)?;
        var witness = Vector<u8>.create();
        if (patternWitness(c, earlier.view(), wildcardPattern, typ, mut witness)?) {
            let scrutineeSpan = c.front.ast.exprSpans[scrutineeSyntax as usize];
            var message = Vector<u8>.create();
            var everyWitness = Vector<u8>.create();
            if (every.length > earlier.length && !patternWitness(
                c,
                every.view(),
                wildcardPattern,
                typ,
                mut everyWitness,
            )?) {
                // Only the guarded arms match what is missing (ADR 0085 §2.2).
                appendText(mut message, "this match does not cover ")?;
                appendBytes(mut message, witness.view())?;
                appendText(
                    mut message,
                    " without its guards: arms with a guard do not count; add '_' or an arm without a guard",
                )?;
            } else {
                appendText(mut message, "this match does not cover ")?;
                if (everyWitness.length > 0) {
                    appendBytes(mut message, everyWitness.view())?;
                } else {
                    appendBytes(mut message, witness.view())?;
                }
                appendText(mut message, "; add the missing arms or a '_' arm")?;
            }
            c.error(nonExhaustiveMatch(), scrutineeSpan.start, scrutineeSpan.end, message)?;
        }
    }
    // A value scrutinee with a non-Copy payload bound by name, at any depth, is consumed (§18.4).
    var consumes = false;
    if (reference == none()) {
        for (tree in every.view()) {
            if (bindsNonCopy(c, tree)) {
                consumes = true;
            }
        }
    }
    let list = c.hir.list(armIds.view())?;
    return c.hir.addStmt(HirStmt.Match(scrutinee, list, consumes, true), span.start, span.end);
}

/// N0257 for each alternative of a top-level or-pattern that earlier arms, or its earlier alternatives, already match
/// (ADR 0085 §2.3); the arm itself is reachable.
fn unreachableAlternatives(
    c: borrow mut Checker,
    earlier: Slice<u32>,
    tree: u32,
    pattern: u32,
    typ: u32,
) -> Result<void, AllocError> {
    let hirAlternatives = match (c.hir.patterns[tree as usize]) {
        HirPattern.Or(list) => list,
        _ => { return Ok(); }
    };
    let astAlternatives = match (c.front.ast.patterns[pattern as usize]) {
        PatternNode.Or(list) => list,
        _ => { return Ok(); }
    };
    var rows = Vector<u32>.create();
    for (p in earlier) {
        rows.push(p)?;
    }
    for (k in 0..hirAlternatives.count) {
        let alternative = c.hir.at(hirAlternatives, k);
        var witness = Vector<u8>.create();
        if (!patternWitness(c, rows.view(), alternative, typ, mut witness)?) {
            let span = c.front.ast.patternSpans[c.front.ast.at(astAlternatives, k) as usize];
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "this alternative can never match: earlier arms or alternatives match every value it does",
            )?;
            c.error(unreachableArm(), span.start, span.end, message)?;
        }
        rows.push(alternative)?;
    }
    return Ok();
}

fn bindsNonCopy(c: borrow Checker, pattern: u32) -> bool {
    match (c.hir.patterns[pattern as usize]) {
        HirPattern.Or(alternatives) => { return bindsNonCopy(c, c.hir.at(alternatives, 0)); }
        HirPattern.Binding(local) => { return !c.types.isCopy(c.hir.locals[local as usize].typ); }
        HirPattern.At(local, inner) => {
            return !c.types.isCopy(c.hir.locals[local as usize].typ) || bindsNonCopy(c, inner);
        }
        HirPattern.Variant(_, hasPayload, payload) => {
            if (hasPayload) {
                for (k in 0..payload.count) {
                    if (bindsNonCopy(c, c.hir.at(payload, k))) {
                        return true;
                    }
                }
            }
            return false;
        }
        _ => { return false; }
    }
}

/// A name the first alternative of an or-pattern binds, which every other alternative must bind alike (ADR 0085
/// §2.3).
struct AlternativeName {
    symbol: u32;
    local: u32;
    seen: bool;
}

/// While a later alternative of an or-pattern is checked (`active`), its bindings are the first alternative's locals.
struct Alternatives {
    active: bool;
    names: Vector<AlternativeName>;
}

fn alternativesDiffer() -> u32 => 356;

/// `A | B | …` (ADR 0085 §2.3): each alternative checked against `typ`; the later ones bind the first one's locals,
/// with the same type and `var`-ness (N0356 otherwise).
fn checkOrPattern(
    c: borrow mut Checker,
    list: Range,
    typ: u32,
    reference: u32,
    failed: borrow mut bool,
    alternatives: borrow mut Alternatives,
) -> Result<u32, AllocError> {
    var trees = Vector<u32>.create();
    let firstSyntax = c.front.ast.at(list, 0);
    let first = checkPattern(c, firstSyntax, typ, reference, failed, alternatives)?;
    trees.push(first)?;
    var locals = Vector<u32>.create();
    patternLocals(c, first, mut locals)?;
    var inner = Alternatives { active: true, names: Vector<AlternativeName>.create() };
    for (local in locals.view()) {
        inner.names.push(AlternativeName { symbol: c.hir.locals[local as usize].name, local: local, seen: false })?;
    }
    for (k in 1..list.count) {
        for (i in 0..inner.names.length) {
            inner.names[i].seen = false;
        }
        let alternative = c.front.ast.at(list, k);
        trees.push(checkPattern(c, alternative, typ, reference, failed, mut inner)?)?;
        for (name in inner.names.view()) {
            if (!name.seen) {
                let span = c.front.ast.patternSpans[alternative as usize];
                var message = Vector<u8>.create();
                appendText(mut message, "this alternative does not bind ")?;
                appendQuotedName(mut message, c, name.symbol)?;
                appendText(mut message, ", which the first one does: every alternative binds the same names")?;
                c.error(alternativesDiffer(), span.start, span.end, message)?;
            }
        }
    }
    let range = c.hir.list(trees.view())?;
    return c.hir.addPattern(HirPattern.Or(range));
}

/// A binding in a pattern: a new local, or in a later alternative of an or-pattern the first alternative's local of
/// that name (N0356 when it differs or is not there).
fn declarePatternBinding(
    c: borrow mut Checker,
    name: u32,
    mutable: bool,
    payload: u32,
    reference: u32,
    alternatives: borrow mut Alternatives,
) -> Result<u32, AllocError> {
    if (!alternatives.active) {
        return declareBinding(c, name, mutable, payload, reference);
    }
    let ident = c.front.ast.idents[name as usize];
    for (i in 0..alternatives.names.length) {
        if (alternatives.names[i].symbol != ident.symbol) {
            continue;
        }
        alternatives.names[i].seen = true;
        let local = alternatives.names[i].local;
        let bindingType = if (reference == none()) payload else c.types.referenceTo(
            payload,
            c.types.info(reference).mutableReference,
        )?;
        let l = c.hir.locals[local as usize];
        let isMutable = mutable && reference == none();
        if (l.typ != bindingType || l.mutable != isMutable) {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, ident.symbol)?;
            if (l.typ != bindingType) {
                appendText(mut message, " has type ")?;
                appendQuotedType(mut message, c, bindingType)?;
                appendText(mut message, " here but ")?;
                appendQuotedType(mut message, c, l.typ)?;
                appendText(mut message, " in the first alternative")?;
            } else {
                appendText(mut message, if (isMutable) " is 'var' here but not" else " is not 'var' here but is")?;
                appendText(mut message, " in the first alternative")?;
            }
            appendText(mut message, ": every alternative binds each name alike")?;
            c.error(alternativesDiffer(), ident.start, ident.end, message)?;
        }
        return Ok(local);
    }
    var message = Vector<u8>.create();
    appendText(mut message, "this alternative binds ")?;
    appendQuotedName(mut message, c, ident.symbol)?;
    appendText(mut message, ", which the first one does not: every alternative binds the same names")?;
    c.error(alternativesDiffer(), ident.start, ident.end, message)?;
    let bindingType = if (reference == none()) payload else c.types.referenceTo(
        payload,
        c.types.info(reference).mutableReference,
    )?;
    return c.hir.addLocal(c.function, ident.symbol, bindingType, false, false, ident.start, ident.end);
}

/// A pattern for a value of `typ` (CheckPattern, §15.2); a failure is reported and becomes `_`.
fn checkPattern(
    c: borrow mut Checker,
    pattern: u32,
    typ: u32,
    reference: u32,
    failed: borrow mut bool,
    alternatives: borrow mut Alternatives,
) -> Result<u32, AllocError> {
    let span = c.front.ast.patternSpans[pattern as usize];
    match (c.front.ast.patterns[pattern as usize]) {
        PatternNode.Or(list) => { return checkOrPattern(c, list, typ, reference, failed, alternatives); }
        PatternNode.Range(low, high, inclusive) => {
            return checkRangePattern(c, low, high, inclusive, typ, span, failed);
        }
        PatternNode.At(name, inner) => {
            // `name @ P` (ADR 0085 §2.5): binds the value P matched, as a payload binding would.
            let local = declarePatternBinding(c, name, false, typ, reference, alternatives)?;
            let tree = checkPattern(c, inner, typ, reference, failed, alternatives)?;
            if (reference == none() && !c.types.isCopy(typ)) {
                let moved = firstMovingBinding(c, tree);
                if (moved != none()) {
                    // A value moves at most once: into `name`, or into what `P` binds, not both.
                    let ident = c.front.ast.idents[name as usize];
                    var message = Vector<u8>.create();
                    appendText(mut message, "'")?;
                    appendBytes(mut message, c.name(ident.symbol))?;
                    appendText(mut message, " @ …' moves the value that ")?;
                    appendQuotedName(mut message, c, c.hir.locals[moved as usize].name)?;
                    appendText(mut message, " also moves; bind one of them (ADR 0085 §2.5)")?;
                    c.error(atMovesTwice(), span.start, span.end, message)?;
                }
            }
            return c.hir.addPattern(HirPattern.At(local, tree));
        }
        PatternNode.Wildcard => { return c.hir.addPattern(HirPattern.Wildcard); }
        PatternNode.Null => {
            if (c.types.optionType(typ) == none()) {
                var message = Vector<u8>.create();
                appendText(mut message, "a 'null' pattern needs an optional, but the value has type ")?;
                appendQuotedType(mut message, c, typ)?;
                c.error(typeMismatch(), span.start, span.end, message)?;
                failed = true;
                return c.hir.addPattern(HirPattern.Wildcard);
            }
            return c.hir.addPattern(HirPattern.Variant(variantAt(c, typ, 0), false, emptyRange()));
        }
        PatternNode.Literal(literal) => {
            if (!c.types.is(typ, TypeKind.Integer) && !c.types.is(typ, TypeKind.Bool)) {
                var message = Vector<u8>.create();
                appendText(mut message, "a literal pattern needs an integer or 'bool', but the value has type ")?;
                appendQuotedType(mut message, c, typ)?;
                c.error(typeMismatch(), span.start, span.end, message)?;
                failed = true;
                return c.hir.addPattern(HirPattern.Wildcard);
            }
            let hir = checkExpr(c, literal, typ)?;
            match (c.hir.exprs[hir as usize]) {
                HirExpr.IntConst(v) => { return c.hir.addPattern(HirPattern.Literal(v)); }
                HirExpr.BoolConst(b) => { return c.hir.addPattern(HirPattern.Literal(intValue(if (b) 1 else 0))); }
                _ => {
                    failed = true;
                    return c.hir.addPattern(HirPattern.Wildcard);
                }
            }
        }
        PatternNode.Variant(path, hasBindings, bindings) => {
            let variant = resolvePatternVariant(c, path, span, typ)?;
            if (variant == none()) {
                failed = true;
                return c.hir.addPattern(HirPattern.Wildcard);
            }
            if (!hasBindings) {
                return c.hir.addPattern(HirPattern.Variant(variant, false, emptyRange()));
            }
            if (bindsUnitPayload(c, typ, variant, bindings)) {
                let name = c.front.ast.bindings[c.front.ast.at(bindings, 0) as usize].name;
                if (name != none()) {
                    declareUnitBinding(c, name)?;
                }
                return c.hir.addPattern(HirPattern.Variant(variant, false, emptyRange()));
            }
            let count = payloadCount(c, variant);
            if (bindings.count as usize != count) {
                payloadArityError(c, typ, variant, bindings.count, span)?;
                failed = true;
                return c.hir.addPattern(HirPattern.Wildcard);
            }
            var payload = Vector<u32>.create();
            for (i in 0..count) {
                let t = payloadType(c, variant, i);
                let binding = c.front.ast.bindings[c.front.ast.at(bindings, truncate<u32>(i)) as usize];
                if (binding.nested != none()) {
                    if (c.types.is(t, TypeKind.Reference)) {
                        let nestedSpan = c.front.ast.patternSpans[binding.nested as usize];
                        var message = Vector<u8>.create();
                        appendText(mut message, "this payload is a reference (")?;
                        appendQuotedType(mut message, c, t)?;
                        appendText(
                            mut message,
                            "): bind it and match on it separately (type-system.md §15.2)",
                        )?;
                        c.error(typeMismatch(), nestedSpan.start, nestedSpan.end, message)?;
                        failed = true;
                        payload.push(c.hir.addPattern(HirPattern.Wildcard)?)?;
                        continue;
                    }
                    payload.push(checkPattern(c, binding.nested, t, reference, failed, alternatives)?)?;
                } else if (binding.name != none()) {
                    let local = declarePatternBinding(c, binding.name, binding.mutable, t, reference, alternatives)?;
                    payload.push(c.hir.addPattern(HirPattern.Binding(local))?)?;
                } else {
                    payload.push(c.hir.addPattern(HirPattern.Wildcard)?)?;
                }
            }
            let list = c.hir.list(payload.view())?;
            return c.hir.addPattern(HirPattern.Variant(variant, true, list));
        }
    }
}

fn emptyRangePattern() -> u32 => 357;

/// N0250's number: use of a moved value, here a value `name @ P` would move twice (ADR 0085 §2.5).
fn atMovesTwice() -> u32 => 250;

/// The first binding under a pattern that moves its value (a non-Copy type, on a value scrutinee), or none.
fn firstMovingBinding(c: borrow Checker, pattern: u32) -> u32 {
    match (c.hir.patterns[pattern as usize]) {
        HirPattern.Binding(local) => {
            return if (c.types.isCopy(c.hir.locals[local as usize].typ)) none() else local;
        }
        HirPattern.At(local, inner) => {
            if (!c.types.isCopy(c.hir.locals[local as usize].typ)) {
                return local;
            }
            return firstMovingBinding(c, inner);
        }
        HirPattern.Variant(_, listed, payload) => {
            if (listed) {
                for (k in 0..payload.count) {
                    let found = firstMovingBinding(c, c.hir.at(payload, k));
                    if (found != none()) {
                        return found;
                    }
                }
            }
            return none();
        }
        HirPattern.Or(alternatives) => { return firstMovingBinding(c, c.hir.at(alternatives, 0)); }
        _ => { return none(); }
    }
}

/// `lo..=hi` or `lo..hi` on an integer (ADR 0085 §2.4): both bounds typed by the value, as literals are (§4); as
/// `lo..=hi'` with the inclusive upper bound. An empty range is N0357.
fn checkRangePattern(
    c: borrow mut Checker,
    low: u32,
    high: u32,
    inclusive: bool,
    typ: u32,
    span: Span,
    failed: borrow mut bool,
) -> Result<u32, AllocError> {
    if (!c.types.is(typ, TypeKind.Integer)) {
        var message = Vector<u8>.create();
        appendText(mut message, "a range pattern needs an integer, but the value has type ")?;
        appendQuotedType(mut message, c, typ)?;
        c.error(typeMismatch(), span.start, span.end, message)?;
        failed = true;
        return c.hir.addPattern(HirPattern.Wildcard);
    }
    let lowHir = checkExpr(c, low, typ)?;
    let highHir = checkExpr(c, high, typ)?;
    let lowValue = match (c.hir.exprs[lowHir as usize]) {
        HirExpr.IntConst(v) => v,
        _ => {
            failed = true;
            return c.hir.addPattern(HirPattern.Wildcard);
        }
    };
    let highValue = match (c.hir.exprs[highHir as usize]) {
        HirExpr.IntConst(v) => v,
        _ => {
            failed = true;
            return c.hir.addPattern(HirPattern.Wildcard);
        }
    };
    var top = highValue;
    var empty = false;
    if (!inclusive) {
        if (compareIntValues(highValue, integerBottom(c, typ)) == 0) {
            empty = true;
        } else {
            top = intPredecessor(highValue);
        }
    }
    if (empty || compareIntValues(lowValue, top) > 0) {
        var message = Vector<u8>.create();
        appendText(mut message, "this range matches no value: ")?;
        appendText(
            mut message,
            if (inclusive) "'lo..=hi' needs lo <= hi" else "'lo..hi' excludes hi, so it needs lo < hi",
        )?;
        c.error(emptyRangePattern(), span.start, span.end, message)?;
        failed = true;
        return c.hir.addPattern(HirPattern.Wildcard);
    }
    return c.hir.addPattern(HirPattern.Range(lowValue, top));
}

fn payloadArityError(
    c: borrow mut Checker,
    typ: u32,
    variant: u32,
    binds: u32,
    span: Span,
) -> Result<void, AllocError> {
    var message = Vector<u8>.create();
    appendText(mut message, "'")?;
    appendVariantName(mut message, c, typ, variant)?;
    appendText(mut message, "' has ")?;
    appendDecimal(mut message, payloadCount(c, variant) as u64)?;
    appendText(mut message, " payload value(s), but the pattern binds ")?;
    appendDecimal(mut message, binds as u64)?;
    return c.error(argumentCount(), span.start, span.end, message);
}

/// CheckVariantPattern: a simple match's variant and its bindings, or none (reported).
fn checkVariantPattern(
    c: borrow mut Checker,
    path: QualifiedName,
    hasBindings: bool,
    bindings: Range,
    span: Span,
    typ: u32,
    reference: u32,
    out: borrow mut Vector<HirArmBinding>,
) -> Result<u32, AllocError> {
    let variant = resolvePatternVariant(c, path, span, typ)?;
    if (variant == none() || !hasBindings) {
        return Ok(variant); // `E.V` ignores the payload
    }
    if (bindsUnitPayload(c, typ, variant, bindings)) {
        let name = c.front.ast.bindings[c.front.ast.at(bindings, 0) as usize].name;
        if (name != none()) {
            declareUnitBinding(c, name)?; // a unit local: nothing to bind (§20.4)
        }
        return Ok(variant);
    }
    if (bindings.count as usize != payloadCount(c, variant)) {
        payloadArityError(c, typ, variant, bindings.count, span)?;
        return Ok(variant);
    }
    for (i in 0..bindings.count) {
        let binding = c.front.ast.bindings[c.front.ast.at(bindings, i) as usize];
        if (binding.name != none()) {
            let t = payloadType(c, variant, i as usize);
            let local = declareBinding(c, binding.name, binding.mutable, t, reference)?;
            out.push(HirArmBinding { local: local, payloadIndex: i })?;
        }
    }
    return Ok(variant);
}

/// A binding of a payload (DeclareBinding, §15.2, §18.4): a copy or a move, or a reference when the scrutinee is one.
fn declareBinding(
    c: borrow mut Checker,
    name: u32,
    mutable: bool,
    payload: u32,
    reference: u32,
) -> Result<u32, AllocError> {
    let ident = c.front.ast.idents[name as usize];
    var isMutable = mutable;
    if (isMutable && reference != none()) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, ident.symbol)?;
        appendText(mut message, " is bound by reference (the match is on a reference), so it cannot be 'var'")?;
        c.error(referenceNotAllowed(), ident.start, ident.end, message)?;
        isMutable = false;
    }
    if (c.lookupLocal(ident.symbol)? != none()) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, ident.symbol)?;
        appendText(mut message, " is already declared in this function; locals cannot be shadowed")?;
        c.error(localRedeclared(), ident.start, ident.end, message)?;
    }
    let bindingType = if (reference == none()) payload else c.types.referenceTo(
        payload,
        c.types.info(reference).mutableReference,
    )?;
    let local = c.hir.addLocal(c.function, ident.symbol, bindingType, isMutable, false, ident.start, ident.end)?;
    c.bind(ident.symbol, local)?;
    return Ok(local);
}

/// The variant a variant pattern names for a value of `typ`, or none (reported) (ResolvePatternVariant).
fn resolvePatternVariant(c: borrow mut Checker, path: QualifiedName, span: Span, typ: u32) -> Result<u32, AllocError> {
    if (!c.types.is(typ, TypeKind.Enum)) {
        var message = Vector<u8>.create();
        appendText(mut message, "a variant pattern needs an enum, but the value has type ")?;
        appendQuotedType(mut message, c, typ)?;
        c.error(typeMismatch(), span.start, span.end, message)?;
        return Ok(none());
    }
    let definition = c.types.info(typ).enumDef;
    let parts = path.parts;
    let first = c.front.ast.idents[c.front.ast.at(parts, 0) as usize];
    if (c.types.enums[definition as usize].resultOk != none()) {
        // Result patterns have no type prefix: Ok(x), Err(e) (§17.3).
        let found = if (parts.count == 1) findVariant(c, definition, first.symbol) else none();
        if (found == none()) {
            var message = Vector<u8>.create();
            appendText(mut message, "expected 'Ok(…)' or 'Err(…)' for a value of type ")?;
            appendQuotedType(mut message, c, typ)?;
            c.error(typeMismatch(), path.start, path.end, message)?;
        }
        return Ok(found);
    }
    if (c.types.enums[definition as usize].optionType != none()) {
        // Optional patterns: Some(x) and null (§22.1).
        if (parts.count != 1 || !sameBytes(c.name(first.symbol), "Some".bytes())) {
            var message = Vector<u8>.create();
            appendText(mut message, "expected 'Some(…)' or 'null' for a value of type ")?;
            appendQuotedType(mut message, c, typ)?;
            c.error(typeMismatch(), path.start, path.end, message)?;
            return Ok(none());
        }
        return Ok(variantAt(c, typ, 1));
    }
    if (parts.count != 2 || !namesEnum(c, first.symbol, typ)) {
        var message = Vector<u8>.create();
        appendText(mut message, "expected a variant of ")?;
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, ", written '")?;
        appendBytes(mut message, c.typeName(typ))?;
        appendText(mut message, ".Variant'")?;
        c.error(typeMismatch(), path.start, path.end, message)?;
        return Ok(none());
    }
    let second = c.front.ast.idents[c.front.ast.at(parts, 1) as usize];
    let found = findVariant(c, definition, second.symbol);
    if (found == none()) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " has no variant named ")?;
        appendQuotedName(mut message, c, second.symbol)?;
        c.error(undefinedName(), second.start, second.end, message)?;
    }
    return Ok(found);
}

/// Does `symbol` name the enum: its own name, or an item that is that enum (`geometry.Shape`, §2)?
fn namesEnum(c: borrow Checker, symbol: u32, typ: u32) -> bool {
    let item = c.types.enums[c.types.info(typ).enumDef as usize].item;
    if (item == none()) {
        // AllocError and IoError: declared from built-in source, named as written.
        return sameBytes(c.name(symbol), c.typeName(typ));
    }
    if (c.front.ast.idents[c.front.ast.items[item as usize].name as usize].symbol == symbol) {
        return true;
    }
    match (c.item(symbol)) {
        Entity.Enum(index) => { return c.enums[index as usize].item == item; }
        _ => { return false; }
    }
}

// ---- if and match expressions ----

/// An `if` or `match` expression (CheckBranching, §15.3): the statement form, whose expression branches end in a yield
/// of a value of one type, and whose block branches cannot complete (N0235).
fn checkBranching(c: borrow mut Checker, e: u32, expected: u32) -> Result<u32, AllocError> {
    let span = c.front.ast.exprSpans[e as usize];
    var branches = branchType(expected);
    var statement = none();
    match (c.front.ast.exprs[e as usize]) {
        ExprNode.If(conditionSyntax, thenSyntax, elseSyntax) => {
            let boolType = c.types.boolType;
            let condition = checkExpr(c, conditionSyntax, boolType)?;
            var then = checkBranch(c, thenSyntax, mut branches, 0)?;
            var otherwise = checkBranch(c, elseSyntax, mut branches, 1)?;
            var finished = Vector<DeferredBranch>.create();
            finishBranches(c, mut branches, mut finished)?;
            for (f in finished.view()) {
                if (f.index == 0) {
                    then = f.value;
                } else {
                    otherwise = f.value;
                }
            }
            statement = c.hir.addStmt(HirStmt.If(condition, then, otherwise), span.start, span.end)?;
        }
        ExprNode.Match(scrutinee, arms) => {
            statement = checkMatch(c, scrutinee, arms, true, mut branches, span)?;
            var finished = Vector<DeferredBranch>.create();
            finishBranches(c, mut branches, mut finished)?;
            let armList = match (c.hir.stmts[statement as usize]) {
                HirStmt.Match(_, list, _, _) => list,
                _ => { return c.errorResult(span.start, span.end); }
            };
            for (f in finished.view()) {
                let arm = c.hir.at(armList, f.index);
                c.hir.arms[arm as usize].body = f.value;
            }
        }
        _ => { return c.errorResult(span.start, span.end); }
    }
    let typ = if (branches.typ != none()) branches.typ else c.types.never;
    return c.expr(HirExpr.StmtValue(statement), typ, span.start, span.end);
}

/// One branch (CheckBranch, §15.3): a block that cannot complete, or an expression whose value the whole yields.
fn checkBranch(
    c: borrow mut Checker,
    value: u32,
    branches: borrow mut BranchType,
    index: u32,
) -> Result<u32, AllocError> {
    let span = c.front.ast.exprSpans[value as usize];
    match (c.front.ast.exprs[value as usize]) {
        ExprNode.Block(block) => {
            let final = blockValue(c, value);
            if (final != none()) {
                // A value block (ADR 0073 §2.3); a flexible or `null` value waits for the type, as a value branch does.
                if (branches.typ == none() && (isFlexible(c, final) || isNullExpr(c, final))) {
                    branches.deferred.push(DeferredBranch { index: index, value: value })?;
                    return c.hir.addStmt(HirStmt.Block(emptyRange()), span.start, span.end);
                }
                return checkValueBlock(c, block, branches);
            }
            let body = checkBlock(c, block)?;
            var loopExits = Vector<bool>.create();
            if (completes(c, body, mut loopExits)?) {
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    "this block can complete, but it has no value: end it with its value, written without ';', or with 'return', 'break' or 'continue'",
                )?;
                c.error(branchCompletes(), span.start, span.end, message)?;
            }
            return Ok(body);
        }
        _ => {}
    }
    let isNull = match (c.front.ast.exprs[unparenthesized(c, value) as usize]) {
        ExprNode.NullLiteral => true,
        _ => false,
    };
    if (branches.typ == none() && (isFlexible(c, value) || isNull)) {
        branches.deferred.push(DeferredBranch { index: index, value: value })?; // checked once a later branch fixes it
        return c.hir.addStmt(HirStmt.Block(emptyRange()), span.start, span.end);
    }
    let hir = checkExpr(c, value, branches.typ)?;
    if (branches.typ == none() && !c.types.is(c.typeOf(hir), TypeKind.Never)) {
        branches.typ = c.typeOf(hir);
    }
    return yieldBlock(c, hir, span);
}

/// A value block's last expression (ADR 0073 §2.3), or none: `e` is a branch.
fn blockValue(c: borrow Checker, e: u32) -> u32 {
    let block = match (c.front.ast.exprs[e as usize]) {
        ExprNode.Block(b) => b,
        _ => { return none(); }
    };
    let statements = match (c.front.ast.stmts[block as usize]) {
        StmtNode.Block(list) => list,
        _ => { return none(); }
    };
    if (statements.count == 0) {
        return none();
    }
    return match (c.front.ast.stmts[c.front.ast.at(statements, statements.count - 1) as usize]) {
        StmtNode.Value(v) => v,
        _ => none(),
    };
}

/// What gives a branch its value: the branch itself, a value block's last expression, or none for a block without one.
fn branchValue(c: borrow Checker, e: u32) -> u32 => if (isBlockExpr(c, e)) blockValue(c, e) else e;

fn isNullExpr(c: borrow Checker, e: u32) -> bool => match (c.front.ast.exprs[unparenthesized(c, e) as usize]) {
    ExprNode.NullLiteral => true,
    _ => false,
};

/// Checks a value block whose value has `branches.typ` when known, and fixes it otherwise (ADR 0073 §2.3). The
/// block's statements are checked in its scope; its last one, StmtNode.Value, yields.
fn checkValueBlock(c: borrow mut Checker, block: u32, branches: borrow mut BranchType) -> Result<u32, AllocError> {
    let savedType = c.blockValueType;
    let savedResult = c.blockValueResult;
    c.blockValueType = branches.typ;
    c.blockValueResult = none();
    let body = checkBlock(c, block)?;
    let result = c.blockValueResult;
    c.blockValueType = savedType;
    c.blockValueResult = savedResult;
    if (branches.typ == none() && result != none() && !c.types.is(result, TypeKind.Never)) {
        branches.typ = result;
    }
    return Ok(body);
}

fn yieldBlock(c: borrow mut Checker, hir: u32, span: Span) -> Result<u32, AllocError> {
    let yielded = c.hir.addStmt(HirStmt.Yield(hir), span.start, span.end)?;
    var statements = Vector<u32>.create();
    statements.push(yielded)?;
    let list = c.hir.list(statements.view())?;
    return c.hir.addStmt(HirStmt.Block(list), span.start, span.end);
}

/// The deferred branches, checked now that the type is known (FinishBranches); if they alone have values, their
/// literals' default type: f64 if one is a float literal, else i32 (§5, §35.2). Each result's `value` is its block.
fn finishBranches(
    c: borrow mut Checker,
    branches: borrow mut BranchType,
    finished: borrow mut Vector<DeferredBranch>,
) -> Result<void, AllocError> {
    if (branches.typ == none()) {
        var flexible = false;
        var float = false;
        for (d in branches.deferred.view()) {
            let v = branchValue(c, d.value);
            if (isFlexible(c, v)) {
                flexible = true;
            }
            if (hasFloatLiteral(c, v)) {
                float = true;
            }
        }
        if (flexible) {
            branches.typ = if (float) c.types.f64 else c.types.i32;
        }
    }
    for (k in 0..branches.deferred.length) {
        let d = branches.deferred[k];
        let block = match (c.front.ast.exprs[d.value as usize]) {
            ExprNode.Block(b) => b,
            _ => none(),
        };
        if (block != none()) {
            finished.push(DeferredBranch { index: d.index, value: checkValueBlock(c, block, branches)? })?;
            continue;
        }
        let hir = checkExpr(c, d.value, branches.typ)?;
        if (branches.typ == none()) {
            branches.typ = c.typeOf(hir);
        }
        let span = c.front.ast.exprSpans[d.value as usize];
        finished.push(DeferredBranch { index: d.index, value: yieldBlock(c, hir, span)? })?;
    }
    return Ok();
}

/// Are the value branches of an `if` or `match` expression all flexible (FlexibleBranches)? Blocks do not count, but
/// there must be a value branch.
fn flexibleBranches(c: borrow Checker, e: u32) -> bool {
    var anyValue = false;
    match (c.front.ast.exprs[e as usize]) {
        ExprNode.If(_, then, otherwise) => {
            for (branch in [then, otherwise]) {
                let b = branchValue(c, branch);
                if (b != none()) {
                    if (!isFlexible(c, b)) {
                        return false;
                    }
                    anyValue = true;
                }
            }
        }
        ExprNode.Match(_, arms) => {
            for (k in 0..arms.count) {
                let b = branchValue(c, c.front.ast.valueArms[c.front.ast.at(arms, k) as usize].value);
                if (b != none()) {
                    if (!isFlexible(c, b)) {
                        return false;
                    }
                    anyValue = true;
                }
            }
        }
        _ => { return false; }
    }
    return anyValue;
}

fn isBlockExpr(c: borrow Checker, e: u32) -> bool => match (c.front.ast.exprs[e as usize]) {
    ExprNode.Block(_) => true,
    _ => false,
};
