// References (the reference's ResolveTypeCore ReferenceType case, the BorrowExpr, MoveExpr and MutArgExpr cases of
// Synth, CheckArgument, MutArgumentFix, ResolveFlows and ResolveReturnSources): P3 S2d. Regions (S3), type parameters
// (S4), closures (S6) and `dyn` (S4) come later; without them a signature has no mutable flows.

fn returnSourceMismatch() -> u32 => 245;
fn mutArgumentMismatch() -> u32 => 249;

/// `borrow T`, `borrow mut T` and `borrow(a, b) T` (a source list only in a return type, `allowSources`).
fn resolveReferenceType(
    c: borrow mut Checker,
    mutable: bool,
    hasSources: bool,
    sources: Range,
    pointeeSyntax: u32,
    allowSources: bool,
    span: Span,
) -> Result<u32, AllocError> {
    if (hasSources && !allowSources) {
        // Outside a return type, the list names regions (§25.2), which are erased.
        var namesStatic = false;
        for (k in 0..sources.count) {
            let ident = c.front.ast.idents[c.front.ast.at(sources, k) as usize];
            if (sameText(c.name(ident.symbol), "static")) {
                namesStatic = true;
            }
        }
        if (c.regions.length == 0 && !namesStatic) {
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "a source list 'borrow(...)' is only allowed in a function's return type, or naming regions (type-system.md §25.2)",
            )?;
            c.error(referenceNotAllowed(), span.start, span.end, message)?;
        } else {
            for (k in 0..sources.count) {
                let ident = c.front.ast.idents[c.front.ast.at(sources, k) as usize];
                if (!isRegionSymbol(c, ident.symbol)) {
                    unknownRegionError(c, ident)?;
                }
            }
        }
    }
    let isFunction = match (c.front.ast.types[pointeeSyntax as usize]) {
        TypeNode.Function(_, _, _) => true,
        _ => false,
    };
    if (isFunction) {
        // `borrow fn(…) -> R` is a closure type (§36.2): a reference to a callable object, not to a function value.
        let pointeeSpan = c.front.ast.typeSpans[pointeeSyntax as usize];
        let callable = match (c.front.ast.types[pointeeSyntax as usize]) {
            TypeNode.Function(attributes, parameters, result) => c.resolveFunctionType(
                attributes,
                parameters,
                result,
                pointeeSpan,
            )?,
            _ => c.types.error,
        };
        if (!c.types.is(callable, TypeKind.Function)) {
            return Ok(c.types.error);
        }
        var parameterTypes = Vector<u32>.create();
        listTypes(c, c.types.info(callable).parameters, mut parameterTypes)?;
        let result = c.types.info(callable).result;
        let effects = c.types.info(callable).effects;
        let closure = c.types.closureTo(parameterTypes.view(), result, effects)?;
        return c.types.referenceTo(closure, mutable);
    }
    let pointee = resolvePointee(c, pointeeSyntax)?;
    if (c.types.is(pointee, TypeKind.Reference)) {
        var message = Vector<u8>.create();
        appendText(mut message, "references to references are not supported")?;
        c.error(referenceNotAllowed(), span.start, span.end, message)?;
        return Ok(c.types.error);
    }
    if (c.types.isBottom(pointee)) {
        return Ok(c.types.error);
    }
    return c.types.referenceTo(pointee, mutable);
}

/// `borrow e` and `borrow mut e` (Synth's BorrowExpr case).
fn synthBorrow(c: borrow mut Checker, mutable: bool, operandSyntax: u32, span: Span) -> Result<u32, AllocError> {
    match (c.front.ast.exprs[operandSyntax as usize]) {
        ExprNode.Slice(target, low, high) => { return synthSlice(c, target, low, high, mutable, span); }
        ExprNode.Name(name, _) => {
            if (mutable && constParameterLent(c, name, span)?) {
                return c.errorResult(span.start, span.end); // N0211 (ADR 0083 §2.3)
            }
        }
        _ => {}
    }
    let operand = synth(c, operandSyntax, none())?;
    if (c.isBottom(operand)) {
        return Ok(operand);
    }
    if (c.types.is(c.typeOf(operand), TypeKind.Reference)) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "this is already a reference; use it directly (references to references are not supported)",
        )?;
        c.error(referenceNotAllowed(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return borrowPlace(c, operand, mutable, span);
}

/// `move e` (Synth's MoveExpr case).
fn synthMove(c: borrow mut Checker, operandSyntax: u32, span: Span) -> Result<u32, AllocError> {
    let operand = synth(c, operandSyntax, none())?;
    if (c.isBottom(operand)) {
        return Ok(operand);
    }
    let place = toPlace(c, operand)?;
    if (place == none()) {
        var message = Vector<u8>.create();
        appendText(mut message, "only a variable or a field can be moved out of with 'move'")?;
        c.error(borrowOfNonPlace(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let t = c.typeOf(operand);
    return c.expr(HirExpr.Move(place), t, span.start, span.end);
}

/// `*e` (ADR 0075 §2.14): the Copy value the reference `e` refers to. A raw pointer is read with `p.read()`.
fn synthDeref(c: borrow mut Checker, operandSyntax: u32, span: Span) -> Result<u32, AllocError> {
    let operand = synth(c, operandSyntax, none())?;
    if (c.isBottom(operand)) {
        return Ok(operand);
    }
    let t = c.typeOf(operand);
    if (!c.types.is(t, TypeKind.Reference) || c.types.isClosure(t)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'*' reads through a reference, and this is a ")?;
        appendQuotedType(mut message, c, t)?;
        if (c.types.is(t, TypeKind.RawPointer)) {
            appendText(mut message, "; read a raw pointer with 'p.read()' in an 'unsafe' block")?;
        }
        c.error(typeMismatch(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let pointee = c.types.info(t).pointee;
    if (!c.types.isCopy(pointee)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'*' copies the value, and ")?;
        appendQuotedType(mut message, c, pointee)?;
        appendText(mut message, " is not Copy; borrow it, or take it with 'replace(mut place, value)'")?;
        c.error(moveOutOfReference(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return c.expr(HirExpr.Deref(operand), pointee, span.start, span.end);
}

/// `mut e` outside an argument list.
fn misplacedMutArgument(c: borrow mut Checker, span: Span) -> Result<u32, AllocError> {
    var message = Vector<u8>.create();
    appendText(mut message, "'mut' marks an argument for a 'borrow mut' parameter; it is not an expression")?;
    c.error(mutArgumentMismatch(), span.start, span.end, message)?;
    return c.errorResult(span.start, span.end);
}

/// A box's contents or a vector's elements, lent where the parameter wants its pointee.
fn contentsFor(c: borrow mut Checker, value: u32, parameterType: u32) -> Result<u32, AllocError> {
    let t = c.typeOf(value);
    let lendsContents = c.types.is(t, TypeKind.Box) || c.types.is(t, TypeKind.Vector);
    let pointee = c.types.info(t).pointee;
    if (lendsContents && pointee == c.types.info(parameterType).pointee) {
        let s = c.spanOf(value);
        return c.expr(HirExpr.Deref(value), pointee, s.start, s.end);
    }
    return Ok(value);
}

/// An argument for a parameter of type `parameterType` (CheckArgument, §13.2).
fn checkArgument(c: borrow mut Checker, argument: u32, parameterType: u32) -> Result<u32, AllocError> {
    let span = c.front.ast.exprSpans[argument as usize];
    let mutOperand = match (c.front.ast.exprs[argument as usize]) {
        ExprNode.MutArg(operand) => operand,
        _ => none(),
    };
    if (parameterType == none()) {
        synth(c, if (mutOperand != none()) mutOperand else argument, none())?;
        return c.errorResult(span.start, span.end);
    }
    match (c.front.ast.exprs[argument as usize]) {
        ExprNode.ArrayLiteral(elements) => {
            if (elements.count == 0) {
                return emptySlice(c, parameterType, span); // `[]` (ADR 0075 §2.9)
            }
        }
        _ => {}
    }
    // A closure parameter takes a closure (or a function value), never a borrow of the argument (§36.2).
    if (c.types.isClosure(parameterType) && mutOperand == none()) {
        return checkExpr(c, argument, parameterType);
    }
    let converted = optionalBorrowArgument(c, argument, mutOperand, parameterType, span)?;
    if (converted != none()) {
        return Ok(converted);
    }
    let pointee = c.types.info(parameterType).pointee;
    if (mutOperand != none()) {
        let operandSpan = c.front.ast.exprSpans[mutOperand as usize];
        if (!c.types.info(parameterType).mutableReference) {
            var message = Vector<u8>.create();
            appendText(mut message, "'mut' is only for arguments passed to a 'borrow mut' parameter")?;
            var title = Vector<u8>.create();
            appendText(mut title, "remove 'mut'")?;
            c.errorWithFix(
                mutArgumentMismatch(),
                span.start,
                span.end,
                message,
                title,
                span.start,
                operandSpan.start,
                Vector<u8>.create(),
            )?;
            synth(c, mutOperand, none())?;
            return c.errorResult(span.start, span.end);
        }
        match (c.front.ast.exprs[mutOperand as usize]) {
            ExprNode.Slice(target, low, high) => {
                if (c.types.isSlice(parameterType)) {
                    let slice = synthSlice(c, target, low, high, true, span)?;
                    return coerce(c, slice, parameterType, span);
                }
            }
            _ => {}
        }
        let hint = integerHint(c, pointee);
        var target = synth(c, mutOperand, hint)?;
        target = contentsFor(c, target, parameterType)?;
        if (c.types.isDynReference(parameterType) && !c.isBottom(target) && !c.types.is(
            c.typeOf(target),
            TypeKind.Reference,
        )) {
            // `mut x` for a `borrow mut dyn I` lends x (a box's contents) as a `borrow mut T`, then coerces (§37.2).
            target = boxContents(c, target)?;
            let lent = borrowPlace(c, target, true, span)?;
            return coerce(c, lent, parameterType, span);
        }
        let targetType = c.typeOf(target);
        if (c.types.isBottom(targetType) || c.types.is(targetType, TypeKind.Reference)) {
            return coerce(c, target, parameterType, span);
        }
        if (targetType != pointee) {
            var message = Vector<u8>.create();
            appendText(mut message, "expected ")?;
            appendQuotedType(mut message, c, pointee)?;
            appendText(mut message, ", found ")?;
            appendQuotedType(mut message, c, targetType)?;
            c.error(typeMismatch(), operandSpan.start, operandSpan.end, message)?;
            return c.errorResult(span.start, span.end);
        }
        return borrowPlace(c, target, true, span);
    }
    if (!c.types.is(parameterType, TypeKind.Reference)) {
        return checkExpr(c, argument, parameterType);
    }
    let hint = integerHint(c, pointee);
    var value = synth(c, argument, hint)?;
    value = contentsFor(c, value, parameterType)?;
    let valueType = c.typeOf(value);
    if (c.types.isDynReference(parameterType) && !c.types.isBottom(valueType) && !c.types.is(
        valueType,
        TypeKind.Reference,
    ) && !c.types.isDyn(valueType)) {
        // A `T` (or a box's contents) for a `borrow dyn I` is borrowed as a `borrow T`, then coerced (§37.2).
        value = boxContents(c, value)?;
        if (c.types.info(parameterType).mutableReference) {
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "this parameter is 'borrow mut': write 'mut' before the argument to let the call modify it",
            )?;
            mutArgumentError(c, value, span, message)?;
            return c.errorResult(span.start, span.end);
        }
        let lent = c.types.referenceTo(c.typeOf(value), false)?;
        let place = toPlace(c, value)?;
        let borrowed = if (place != none()) c.expr(
            HirExpr.Borrow(false, place),
            lent,
            span.start,
            span.end,
        )? else c.expr(
            HirExpr.BorrowTemp(false, value),
            lent,
            span.start,
            span.end,
        )?;
        return coerce(c, borrowed, parameterType, span);
    }
    if (c.types.isBottom(valueType) || c.types.is(valueType, TypeKind.Reference)) {
        return coerce(c, value, parameterType, span);
    }
    if (valueType != pointee) {
        var message = Vector<u8>.create();
        appendText(mut message, "expected ")?;
        appendQuotedType(mut message, c, parameterType)?;
        appendText(mut message, ", found ")?;
        appendQuotedType(mut message, c, valueType)?;
        c.error(typeMismatch(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.info(parameterType).mutableReference) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "this parameter is 'borrow mut': write 'mut' before the argument to let the call modify it",
        )?;
        mutArgumentError(c, value, span, message)?;
        return c.errorResult(span.start, span.end);
    }
    let dynBox = if (c.types.isDyn(valueType)) match (c.hir.exprs[value as usize]) {
        HirExpr.Deref(reference) => reference,
        _ => none(),
    } else none();
    if (dynBox != none() && toPlace(c, value)? == none()) {
        // A temporary `Box<dyn I>`: lend the box, then reborrow its contents, which cannot be copied out (§37.2).
        let boxType = c.typeOf(dynBox);
        let lentType = c.types.referenceTo(boxType, false)?;
        let lentBox = c.expr(HirExpr.BorrowTemp(false, dynBox), lentType, span.start, span.end)?;
        return coerce(c, lentBox, parameterType, span);
    }
    // Implicit shared borrow: of the place itself, or of a temporary holding the value (lifetimes.md §6).
    let place = toPlace(c, value)?;
    if (place != none()) {
        return c.expr(HirExpr.Borrow(false, place), parameterType, span.start, span.end);
    }
    if (c.types.info(valueType).isStr || c.types.isUnsized(valueType)) {
        // The text of a `String` value, or the elements of a vector value: they cannot be copied to a temporary, so
        // the value that owns them is held to the end of the statement and they are lent from it (ADR 0073 §2.1).
        return borrowReceiver(c, value, false, span);
    }
    return c.expr(HirExpr.BorrowTemp(false, value), parameterType, span.start, span.end);
}

/// Is the expression written as a place: a name, `this`, a field or an element (in parentheses or not)?
fn isPlaceSyntax(c: borrow Checker, e: u32) -> bool => match (c.front.ast.exprs[e as usize]) {
    ExprNode.Name(_, _) => true,
    ExprNode.This => true,
    ExprNode.Member(_, _) => true,
    ExprNode.Index(_, _) => true,
    ExprNode.Paren(inner) => isPlaceSyntax(c, inner),
    _ => false,
};

/// An argument for an optional borrow parameter, `borrow T?` or `(borrow mut T)?` (ADR 0074 §2.5): a place of type
/// `T?` is borrowed as an optional borrow, and a place of type `T` as `Some(borrow t)`; for
/// `(borrow mut T)?` the argument is written `mut p`. None when the parameter or the argument is not of this kind,
/// for checkArgument's other rules.
fn optionalBorrowArgument(
    c: borrow mut Checker,
    argument: u32,
    mutOperand: u32,
    parameterType: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let lent = c.types.optionType(parameterType);
    if (lent == none() || !c.types.is(lent, TypeKind.Reference) || c.types.isSlice(lent) || c.types.isStringView(
        lent,
    ) || c.types.isDynReference(lent)) {
        return Ok(none());
    }
    let mutable = c.types.info(lent).mutableReference;
    let target = c.types.info(lent).pointee;
    let operand = if (mutOperand != none()) mutOperand else argument;
    if ((mutOperand != none() && !mutable) || !isPlaceSyntax(c, operand)) {
        return Ok(none());
    }
    let operandSpan = c.front.ast.exprSpans[operand as usize];
    let hint = integerHint(c, target);
    let value = synth(c, operand, hint)?;
    let t = c.typeOf(value);
    if (c.types.isBottom(t)) {
        return Ok(value);
    }
    // A reference to an optional stays a different type (§22.1): it converts with `asBorrow()`.
    let referent = if (c.types.is(t, TypeKind.Reference)) c.types.info(t).pointee else t;
    let ofOptional = !c.types.is(t, TypeKind.Reference) && c.types.optionType(t) == target;
    let ofTarget = referent == target;
    if (!ofOptional && !ofTarget) {
        if (mutOperand == none()) {
            return coerce(c, value, parameterType, span);
        }
        var message = Vector<u8>.create();
        appendText(mut message, "expected ")?;
        appendQuotedType(mut message, c, target)?;
        appendText(mut message, " or ")?;
        appendQuotedType(mut message, c, c.types.info(parameterType).pointee)?;
        appendText(mut message, "?, found ")?;
        appendQuotedType(mut message, c, t)?;
        c.error(typeMismatch(), operandSpan.start, operandSpan.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (ofTarget && c.types.is(t, TypeKind.Reference)) {
        // A reference to `T`: `Some` of it, reborrowed (§22.1).
        if (mutable && !c.types.info(t).mutableReference) {
            return coerce(c, value, parameterType, span); // reports the mismatch
        }
        let reborrowed = c.expr(HirExpr.Reborrow(mutable, value), lent, span.start, span.end)?;
        let someVariant = variantAt(c, parameterType, 1);
        return enumValue(c, someVariant, reborrowed, parameterType, span);
    }
    if (mutable && mutOperand == none() && !c.types.is(t, TypeKind.Reference)) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "this parameter is an optional 'borrow mut': write 'mut' before the argument to let the call modify it",
        )?;
        mutArgumentError(c, value, span, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (ofTarget) {
        // A place of `T`: `Some(borrow t)`.
        let borrowed = if (!mutable && toPlace(c, value)? == none()) c.expr(
            HirExpr.BorrowTemp(false, value),
            lent,
            span.start,
            span.end,
        )? else borrowPlace(c, value, mutable, span)?;
        if (c.isBottom(borrowed)) {
            return Ok(borrowed);
        }
        let someVariant = variantAt(c, parameterType, 1);
        return enumValue(c, someVariant, borrowed, parameterType, span);
    }
    let reference = optionalReference(c, value, mutable, span)?;
    if (reference == none()) {
        return c.errorResult(span.start, span.end);
    }
    return optionalBorrow(c, reference, mutable, span);
}

/// N0249 for a value passed to a `borrow mut` parameter without `mut`, with MutArgumentFix's fix: insert `mut`, and
/// turn the root's `let` into `var` when that is why the place is immutable.
fn mutArgumentError(c: borrow mut Checker, value: u32, span: Span, message: Vector<u8>) -> Result<void, AllocError> {
    let place = toPlace(c, value)?;
    if (place == none()) {
        return c.error(mutArgumentMismatch(), span.start, span.end, message);
    }
    var insert = Vector<u8>.create();
    appendText(mut insert, "mut ")?;
    var reason = Vector<u8>.create();
    mutabilityError(c, place, mut reason)?;
    if (reason.length == 0) {
        var title = Vector<u8>.create();
        appendText(mut title, "write 'mut' before the argument")?;
        return c.errorWithFix(
            mutArgumentMismatch(),
            span.start,
            span.end,
            message,
            title,
            span.start,
            span.start,
            insert,
        );
    }
    let letStart = letToVarStart(c, place, reason.view());
    if (letStart == none()) {
        return c.error(mutArgumentMismatch(), span.start, span.end, message);
    }
    let root = c.hir.places[place as usize].root;
    var title = Vector<u8>.create();
    appendText(mut title, "write 'mut' before the argument, and declare ")?;
    appendQuotedName(mut title, c, c.hir.locals[root as usize].name)?;
    appendText(mut title, " with 'var'")?;
    var text = Vector<u8>.create();
    appendText(mut text, "var")?;
    let file = c.file;
    return c.front.diagnostics.errorWithTwoEdits(
        mutArgumentMismatch(),
        file,
        span.start,
        span.end,
        message,
        title,
        span.start,
        insert,
        letStart,
        letStart + 3,
        text,
    );
}

// ---- flows ----

// Flow names (CollectFlowNames, §25.6): a region a type names (`r:name`, not `static`), a scoped parameter's own
// elided region (`#i`), and a type parameter (`t:name`, S4). Each is a u64: the kind in the high half.
fn regionFlowName(symbol: u32) -> u64 => (1u64 << 32) | symbol as u64;
fn elidedFlowName(i: usize) -> u64 => (2u64 << 32) | i as u64;
fn isRegionOrElided(name: u64) -> bool => (name >> 32) == 1 || (name >> 32) == 2;
fn isElided(name: u64) -> bool => (name >> 32) == 2;
fn isTypeFlowName(name: u64) -> bool => (name >> 32) == 3;
fn typeFlowName(symbol: u32) -> u64 => (3u64 << 32) | symbol as u64;

/// A mutable flow (HirFunction.mutableFlows): `(target << 32) | source`, with `deepFlowBit` for a deep one.
fn deepFlowBit() -> u64 => 1u64 << 63;
fn flowIsDeep(flow: u64) -> bool => (flow >> 63) == 1;
fn flowTarget(flow: u64) -> u32 => truncate<u32>((flow >> 32) & 0x7FFFFFFF);
fn flowSource(flow: u64) -> u32 => truncate<u32>(flow & 0xFFFFFFFF);

fn addName(names: borrow mut Vector<u64>, name: u64) -> Result<void, AllocError> {
    for (n in names.view()) {
        if (n == name) {
            return Ok();
        }
    }
    return names.push(name);
}

fn overlaps(a: borrow Vector<u64>, b: borrow Vector<u64>) -> bool {
    for (x in a.view()) {
        for (y in b.view()) {
            if (x == y) {
                return true;
            }
        }
    }
    return false;
}

/// Can a value of this type carry loans (MayHoldLoans)? Scoped types, and in generic code anything mentioning a type
/// parameter (§25.7).
/// §25.7 rule 5: a scoped type, or in generic code one that mentions a type parameter, except inside a `dyn` type,
/// which carries no loans of its own (§37.2; bug B8: a `Box<dyn I<S>>` parameter could not be stored).
fn mayHoldLoans(c: borrow Checker, typ: u32) -> bool =>
    c.types.isScoped(typ) || c.types.mentionsParameterOutsideDyn(typ);

/// The flows of a signature (ResolveFlows, §25.6): which parameters' loans the result may carry (its return sources)
/// and which parameters' loans the callee may store through each `borrow mut` parameter.
fn resolveFlows(c: borrow mut Checker, f: u32, function: u32, owner: u32) -> Result<void, AllocError> {
    let decl = c.front.ast.functions[f as usize];
    var ownerRegions = Vector<u32>.create();
    var ownerTypeParameters = Vector<u32>.create();
    var typeParameters = Vector<u32>.create();
    pushRegionNames(c, decl.typeParameters, mut typeParameters)?;
    // The declarations whose type parameters' bounds are in scope: a bounded parameter has its bounds' names too.
    var bounded = Vector<Range>.create();
    bounded.push(decl.typeParameters)?;
    if (owner != none()) {
        let definition = c.types.info(owner).structDef;
        let item = if (definition == none()) none() else c.types.structs[definition as usize].item;
        if (item != none()) {
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Struct(k) => {
                    pushRegionNames(c, c.front.ast.structs[k as usize].regionParameters, mut ownerRegions)?;
                    pushRegionNames(c, c.front.ast.structs[k as usize].typeParameters, mut ownerTypeParameters)?;
                    bounded.push(c.front.ast.structs[k as usize].typeParameters)?;
                }
                _ => {}
            }
        }
        // A function of an enum's `impl E { … }` block: the receiver carries the enum's regions and type parameters,
        // as a struct's method's does (ADR 0107).
        let enumItem = enumOfMethod(c, f, owner);
        if (enumItem != none()) {
            match (c.front.ast.items[enumItem as usize].kind) {
                ItemKind.Enum(_, enumTypes, enumRegions) => {
                    pushRegionNames(c, enumRegions, mut ownerRegions)?;
                    pushRegionNames(c, enumTypes, mut ownerTypeParameters)?;
                    bounded.push(enumTypes)?;
                }
                _ => {}
            }
        }
    }
    // An interface's method, whatever it is declared for (a bound's type parameter, `Self`, a `dyn` type, or the
    // type that inherits a default): its receiver carries the interface's type parameters and `Self`, as a struct's
    // method's receiver carries the struct's (§25.6, ADR 0131). So `fn get(borrow this) -> T` has a deep result.
    var selfNames = Vector<u32>.create();
    let interfaceEntry = if ((f as usize) < c.interfaceOfMethod.length) c.interfaceOfMethod[f as usize] else none();
    if (interfaceEntry != none()) {
        let interfaceParameters = match (c.front.ast.items[c.interfaces[interfaceEntry as usize].item as usize].kind) {
            ItemKind.Interface(_, t) => t,
            _ => emptyRange(),
        };
        pushRegionNames(c, interfaceParameters, mut selfNames)?;
        for (t in selfNames.view()) {
            ownerTypeParameters.push(t)?;
        }
        ownerTypeParameters.push(c.selfSymbol)?;
        bounded.push(interfaceParameters)?;
    }
    var selfRegions = Vector<u32>.create();
    if (interfaceEntry == none() && owner != none()) {
        // `Self` in a struct's or an enum's own function is the type with its parameters and regions (ADR 0086 §2.2).
        for (t in ownerTypeParameters.view()) {
            selfNames.push(t)?;
        }
        for (r in ownerRegions.view()) {
            selfRegions.push(r)?;
        }
        ownerTypeParameters.push(c.selfSymbol)?;
    }
    for (t in ownerTypeParameters.view()) {
        typeParameters.push(t)?;
    }
    c.flowTypeParameters = typeParameters;
    let parameterCount = c.hir.functions[function as usize].parameters.length;
    let receiverOffset = parameterCount - decl.parameters.count as usize;
    var names = Vector<Vector<u64>>.create();
    var written = Vector<usize>.create(); // how many of a parameter's names are its own, not a bound's
    for (i in 0..parameterCount) {
        var set = Vector<u64>.create();
        if (i < receiverOffset) {
            for (r in ownerRegions.view()) {
                addName(mut set, regionFlowName(r))?;
            }
            for (t in ownerTypeParameters.view()) {
                addName(mut set, typeFlowName(t))?;
            }
        } else {
            let p = c.front.ast.parameters[c.front.ast.at(decl.parameters, truncate<u32>(i - receiverOffset)) as usize];
            collectFlowNames(c, p.typ, function, false, mut set)?;
            if (writesStatic(c, p.typ)) {
                staticParameterError(c, p.typ)?;
            }
        }
        written.push(set.length)?;
        closeFlowNames(c, function, bounded, selfNames, selfRegions, mut set)?;
        let local = c.hir.functions[function as usize].parameters[i];
        var hasRegion = false;
        for (n in set.view()) {
            if ((n >> 32) == 1) {
                hasRegion = true;
            }
        }
        if (c.types.isScoped(c.hir.locals[local as usize].typ) && !hasRegion) {
            addName(mut set, elidedFlowName(i))?; // elided: a region of its own
        }
        names.push(set)?;
    }
    c.flowNames = names;
    let returnType = c.hir.functions[function as usize].returnType;
    if (decl.returnType != none() && mayHoldLoans(c, returnType)) {
        var resultNames = Vector<u64>.create();
        collectFlowNames(c, decl.returnType, function, true, mut resultNames)?;
        closeFlowNames(c, function, bounded, selfNames, selfRegions, mut resultNames)?;
        var sources = Vector<u32>.create();
        for (i in 0..parameterCount) {
            if (overlaps(c.flowNames[i], resultNames)) {
                sources.push(truncate<u32>(i))?;
            }
        }
        let hasSourceList = match (c.front.ast.types[decl.returnType as usize]) {
            TypeNode.Reference(_, hasSources, _, _) => hasSources,
            _ => false,
        };
        var named = hasSourceList;
        for (n in resultNames.view()) {
            if (isRegionOrElided(n)) {
                named = true;
            }
        }
        // A result that names only `static` borrows from no parameter, so it is not elided (ADR 0068).
        var resolved = Vector<u32>.create();
        if (hasSourceList || (c.types.isScoped(returnType) && !named && !writesStatic(c, decl.returnType))) {
            resolveReturnSources(c, f, function, mut resolved)?; // v0: `borrow(a, b)`, or elision (§13.5)
            for (i in resolved.view()) {
                if (!containsU32(sources, i)) {
                    sources.push(i)?;
                }
            }
        }
        // A result reference with no region written on it has an elided region of its own, also when its pointee
        // names regions (`-> borrow S<r>`): with a single scoped parameter it is tied to that parameter (§25.6, B18),
        // and so is not a deep result of it.
        if (!hasSourceList && named && elidedResultPointee(c, decl.returnType) != none()) {
            let single = singleScopedParameter(c, function);
            if (single != none()) {
                if (!containsU32(sources, single)) {
                    sources.push(single)?;
                }
                resolved.push(single)?;
            }
        }
        // A function with a parameter that is a function value whose result may hold a loan can hand it anything
        // it was given, and return what comes back (`fn apply<U>(o: borrow Owner, f: fn(StringView) -> U) -> U =>
        // f(o.text.view())`): its result may borrow from every scoped parameter, as a scoped result of a function
        // with one scoped parameter does by elision (ADR 0131). Not deep: it may be a borrow of the referent itself.
        var widened = Vector<u32>.create();
        if (c.types.mentionsParameterOutsideDyn(returnType) && takesMakingFunction(c, function)) {
            for (i in 0..parameterCount) {
                let local = c.hir.functions[function as usize].parameters[i];
                if (c.types.isScoped(c.hir.locals[local as usize].typ) && !containsU32(sources, truncate<u32>(i))) {
                    sources.push(truncate<u32>(i))?;
                    widened.push(truncate<u32>(i))?;
                }
            }
        }
        sortU32(mut sources);
        // A deep result of a reference parameter (ADR 0074 §2.4) names none of the reference's own regions (its
        // elided one, or those written on it), only regions of its pointee.
        // A result that is a type parameter (`-> T`) cannot name a reference parameter's own region, which is elided:
        // what it holds came from a referent, so each reference source is deep (ADR 0075 §8: `take(mut this.a)`).
        let bareParameter = c.types.is(returnType, TypeKind.TypeParameter);
        var deep = Vector<u32>.create();
        for (i in sources.view()) {
            let local = c.hir.functions[function as usize].parameters[i as usize];
            let t = c.hir.locals[local as usize].typ;
            if (!c.types.is(t, TypeKind.Reference) || c.types.isSlice(t) || c.types.isStringView(t)) {
                continue;
            }
            if (containsU32(widened, i)) {
                continue;
            }
            if (bareParameter) {
                deep.push(i)?;
                continue;
            }
            if (containsU32(resolved, i)) {
                continue;
            }
            var outer = Vector<u64>.create();
            if (!outerFlowNames(c, f, i as usize, receiverOffset, mut outer)?) {
                continue; // written otherwise (in parentheses): kept outer
            }
            if (!overlaps(outer, resultNames)) {
                deep.push(i)?;
            }
        }
        // A reference result tied to one reference parameter alone, whose pointee names only regions that the
        // parameter's referent holds: what it refers to holds no more than that referent does (B18). A deep result
        // through a temporary holding such a call's result then follows the call's argument (`o.inner().first()`).
        var through: u32 = none();
        let pointee = match (c.front.ast.types[decl.returnType as usize]) {
            TypeNode.Reference(_, _, _, inner) => inner,
            _ => none(),
        };
        if (pointee != none() && sources.length == 1 && containsU32(resolved, sources[0])) {
            let i = sources[0];
            let local = c.hir.functions[function as usize].parameters[i as usize];
            let t = c.hir.locals[local as usize].typ;
            var outer = Vector<u64>.create();
            if (c.types.is(t, TypeKind.Reference) && !c.types.isSlice(t) && !c.types.isStringView(t) &&
                outerFlowNames(c, f, i as usize, receiverOffset, mut outer)?) {
                var held = Vector<u64>.create();
                collectFlowNames(c, pointee, function, true, mut held)?;
                var inside = true;
                for (n in held.view()) {
                    var single = Vector<u64>.create();
                    single.push(n)?;
                    if (!overlaps(single, c.flowNames[i as usize]) || overlaps(single, outer)) {
                        inside = false;
                    }
                }
                // A pointee whose regions are all elided (`-> borrow S`) names none, yet may hold loans.
                if (inside && (held.length > 0 || !mayHoldLoans(c, c.types.info(returnType).pointee))) {
                    through = i;
                }
            }
        }
        c.hir.functions[function as usize].resultThrough = through;
        c.hir.functions[function as usize].returnSources = sources;
        c.hir.functions[function as usize].deepSources = deep;
    }
    var flows = Vector<u64>.create();
    for (i in 0..parameterCount) {
        let local = c.hir.functions[function as usize].parameters[i];
        let t = c.hir.locals[local as usize].typ;
        // A store target is every parameter through which a write can reach memory that outlives the call (ADR 0131
        // §2.13): a `borrow mut` or `SliceMut`, and a value that holds one at any depth (`s: Sink<r>` with a field
        // `out: borrow mut(r) Vector<StringView<r>>`).
        let held = !c.types.is(t, TypeKind.Reference) && c.types.writableThrough(t, 0);
        if (!held && (!c.types.is(t, TypeKind.Reference) || !c.types.info(t).mutableReference)) {
            continue;
        }
        // What a `borrow mut dyn I` refers to may be a scoped implementation, which is a `dyn` value only behind a
        // reference (§37.2): a method may store a loan in it, as in any other referent that may hold one.
        let pointeeType = if (held) t else c.types.info(t).pointee;
        if (!mayHoldLoans(c, pointeeType) && !c.types.isDyn(pointeeType)) {
            continue;
        }
        var target = Vector<u64>.create();
        var targetWritten: usize = 0;
        let p0 = if (i < receiverOffset) none() else c.front.ast.parameters[c.front.ast.at(
            decl.parameters,
            truncate<u32>(i - receiverOffset),
        ) as usize].typ;
        let writtenAsReference = p0 != none() && match (c.front.ast.types[p0 as usize]) {
            TypeNode.Reference(_, _, _, _) => true,
            _ => false,
        };
        // A `SliceMut<T>` is written `SliceMut<…>`, not `borrow mut …`: its names are its type's.
        if (i < receiverOffset || held || !writtenAsReference) {
            for (n in c.flowNames[i].view()) {
                target.push(n)?;
            }
            targetWritten = written[i];
        } else {
            let p = c.front.ast.parameters[c.front.ast.at(decl.parameters, truncate<u32>(i - receiverOffset)) as usize];
            match (c.front.ast.types[p.typ as usize]) {
                TypeNode.Reference(_, _, _, pointee) => {
                    // Through a `borrow mut fn`, the function is called, and nothing is stored: its result's names
                    // (collectFlowNames) are what it gives, not what it can be given to keep.
                    let callable = match (c.front.ast.types[pointee as usize]) {
                        TypeNode.Function(_, _, _) => true,
                        TypeNode.FunctionPointer(_, _, _) => true,
                        _ => false,
                    };
                    if (!callable) {
                        collectReferentNames(c, pointee, function, false, mut target)?;
                    }
                }
                _ => {}
            }
            targetWritten = target.length;
            closeFlowNames(c, function, bounded, selfNames, selfRegions, mut target)?;
        }
        var kept = Vector<u64>.create();
        var keptWritten = Vector<u64>.create();
        for (k in 0..target.length) {
            if (!isElided(target[k])) {
                kept.push(target[k])?;
                if (k < targetWritten) {
                    keptWritten.push(target[k])?;
                }
            }
        }
        for (j in 0..parameterCount) {
            if (j != i && overlaps(c.flowNames[j], kept)) {
                // A flow that only a bound gives (`it: borrow mut I` into `out: borrow mut Vector<T>` under
                // `I: Stream<T>`) is deep when its source is a reference (ADR 0131): what the bound's methods give
                // holds what the referent holds, never a loan of the reference itself, so only that may be stored.
                var direct = false;
                for (k in 0..written[j]) {
                    for (y in keptWritten.view()) {
                        if (c.flowNames[j][k] == y) {
                            direct = true;
                        }
                    }
                }
                let source = c.hir.locals[c.hir.functions[function as usize].parameters[j] as usize].typ;
                let deep = !direct && c.types.is(source, TypeKind.Reference) && !c.types.isSlice(source) &&
                    !c.types.isStringView(source);
                flows.push((if (deep) deepFlowBit() else 0u64) | (i as u64) << 32 | j as u64)?;
            }
        }
    }
    // What may be stored through a parameter that the result flows from may be in the result (ADR 0131): the checker
    // keeps one loan set for what a reference refers to, so a `V` read from a map holds what a `K` put into it held.
    if (decl.returnType != none() && mayHoldLoans(c, c.hir.functions[function as usize].returnType)) {
        var grew = true;
        while (grew) {
            grew = false;
            for (flow in flows.view()) {
                let target = flowTarget(flow);
                let source = flowSource(flow);
                if (containsU32(c.hir.functions[function as usize].returnSources, target) && !containsU32(
                    c.hir.functions[function as usize].returnSources,
                    source,
                )) {
                    c.hir.functions[function as usize].returnSources.push(source)?;
                    let local = c.hir.functions[function as usize].parameters[source as usize];
                    let t = c.hir.locals[local as usize].typ;
                    if (flowIsDeep(flow) && c.types.is(t, TypeKind.Reference) && !c.types.isSlice(t) &&
                        !c.types.isStringView(t)) {
                        c.hir.functions[function as usize].deepSources.push(source)?;
                    }
                    grew = true;
                }
            }
        }
        sortU32(mut c.hir.functions[function as usize].returnSources);
    }
    c.hir.functions[function as usize].mutableFlows = flows;
    // Whether a by-value parameter holds a `borrow mut` is known once the structs and enums have their fields: a
    // function declared before then keeps its parameters' names for resolveHeldTargets (ADR 0131 §2.13).
    if (!c.membersReady) {
        var waits = false;
        for (i in 0..parameterCount) {
            let t = c.hir.locals[c.hir.functions[function as usize].parameters[i] as usize].typ;
            if (!c.types.is(t, TypeKind.Reference) && c.types.isScoped(t)) {
                waits = true;
            }
        }
        if (waits) {
            var kept = Vector<Vector<u64>>.create();
            for (i in 0..parameterCount) {
                var set = Vector<u64>.create();
                for (name in c.flowNames[i].view()) {
                    set.push(name)?;
                }
                kept.push(set)?;
            }
            c.heldNames.push(HeldNames { function: function, names: kept, written: written })?;
        }
    }
    c.flowNames = Vector<Vector<u64>>.create();
    c.flowTypeParameters = Vector<u32>.create();
    // The declaration's flows, once, and every instance has at least those (ADR 0131 §2.9).
    while (c.declaredFlows.length <= f as usize) {
        c.declaredFlows.push(DeclaredFlows {
            function: none(),
            sources: Vector<u32>.create(),
            deep: Vector<u32>.create(),
            flows: Vector<u64>.create(),
        })?;
    }
    if (c.declaredFlows[f as usize].function != none()) {
        inheritFlows(c, f, function)?;
    } else if (isDeclarationVersion(c, f, owner)) {
        recordDeclaredFlows(c, f, function)?;
        var k: usize = 0;
        while (k < c.flowsWaiting.length) {
            let waiting = c.flowsWaiting[k];
            k += 1;
            if (c.hir.functions[waiting as usize].syntax == f) {
                inheritFlows(c, f, waiting)?;
            }
        }
    } else {
        c.flowsWaiting.push(function)?;
    }
    return Ok();
}

/// The parameters' flow names of a function declared before the structs and enums had their fields.
struct HeldNames {
    function: u32;
    names: Vector<Vector<u64>>;
    written: Vector<usize>;
}

/// The flows into the by-value parameters that hold a `borrow mut` (ADR 0131 §2.13), for the functions declared
/// before that could be known; then an impl's method keeps only its interface's, and every instance has its
/// declaration's (§2.9).
fn resolveHeldTargets(c: borrow mut Checker) -> Result<void, AllocError> {
    for (e in 0..c.heldNames.length) {
        let function = c.heldNames[e].function;
        let count = c.hir.functions[function as usize].parameters.length;
        for (i in 0..count) {
            let t = c.hir.locals[c.hir.functions[function as usize].parameters[i] as usize].typ;
            if (c.types.is(t, TypeKind.Reference) || !c.types.writableThrough(t, 0)) {
                continue;
            }
            for (j in 0..count) {
                if (j == i) {
                    continue;
                }
                var shared = false;
                var direct = false;
                for (x in 0..c.heldNames[e].names[i].length) {
                    let name = c.heldNames[e].names[i][x];
                    if (isElided(name)) {
                        continue;
                    }
                    for (y in 0..c.heldNames[e].names[j].length) {
                        if (c.heldNames[e].names[j][y] == name) {
                            shared = true;
                            if (x < c.heldNames[e].written[i] && y < c.heldNames[e].written[j]) {
                                direct = true;
                            }
                        }
                    }
                }
                if (!shared) {
                    continue;
                }
                let source = c.hir.locals[c.hir.functions[function as usize].parameters[j] as usize].typ;
                let deep = !direct && isPlainReference(c, source);
                let plain = (i as u64) << 32 | j as u64;
                if (!containsU64(c.hir.functions[function as usize].mutableFlows, plain) && !containsU64(
                    c.hir.functions[function as usize].mutableFlows,
                    plain | deepFlowBit(),
                )) {
                    c.hir.functions[function as usize].mutableFlows.push(if (deep) plain | deepFlowBit() else plain)?;
                }
            }
        }
    }
    for (e in 0..c.heldNames.length) {
        let function = c.heldNames[e].function;
        let view = c.hir.functions[function as usize].interfaceView;
        if (view == none()) {
            continue;
        }
        var flows = Vector<u64>.create();
        for (flow in c.hir.functions[function as usize].mutableFlows.view()) {
            let plain = flow & (deepFlowBit() ^ 0xFFFFFFFFFFFFFFFF);
            if (containsU64(c.hir.functions[view as usize].mutableFlows, plain)) {
                flows.push(flow)?;
            } else if (containsU64(c.hir.functions[view as usize].mutableFlows, plain | deepFlowBit())) {
                flows.push(plain | deepFlowBit())?;
            }
        }
        c.hir.functions[function as usize].mutableFlows = flows;
    }
    for (e in 0..c.heldNames.length) {
        let function = c.heldNames[e].function;
        let f = c.hir.functions[function as usize].syntax;
        if ((f as usize) < c.declaredFlows.length && c.declaredFlows[f as usize].function == function) {
            recordDeclaredFlows(c, f, function)?;
        }
    }
    for (e in 0..c.heldNames.length) {
        let function = c.heldNames[e].function;
        let f = c.hir.functions[function as usize].syntax;
        if ((f as usize) < c.declaredFlows.length && c.declaredFlows[f as usize].function != none()) {
            inheritFlows(c, f, function)?;
        }
    }
    c.heldNames = Vector<HeldNames>.create();
    return Ok();
}

/// The flows of a function's declaration (ADR 0131 §2.9): computed once, with every type parameter in scope opaque.
struct DeclaredFlows {
    function: u32; // the HIR function they were computed for, or none while they are not known
    sources: Vector<u32>;
    deep: Vector<u32>;
    flows: Vector<u64>;
}

/// Is the function being declared its declaration's own version: every type parameter in scope opaque, and its
/// owner the declaring type itself (a struct's or an enum's own generic type, an interface's `Self`), not an
/// instance, a bound's type parameter, a `dyn` type or the type that inherits a default?
fn isDeclarationVersion(c: borrow Checker, f: u32, owner: u32) -> bool {
    for (pair in c.typeEnvironment.view()) {
        if (!c.types.is(pair.typ, TypeKind.TypeParameter)) {
            return false;
        }
    }
    let interfaceEntry = if ((f as usize) < c.interfaceOfMethod.length) c.interfaceOfMethod[f as usize] else none();
    if (interfaceEntry != none()) {
        return owner != none() && owner == c.interfaces[interfaceEntry as usize].selfType;
    }
    if (owner == none()) {
        return true;
    }
    let info = c.types.info(owner);
    var arguments = emptyRange();
    if (info.structDef != none()) {
        arguments = c.types.structs[info.structDef as usize].typeArguments;
    } else if (info.enumDef != none()) {
        arguments = c.types.enums[info.enumDef as usize].typeArguments;
    }
    for (k in 0..arguments.count) {
        let a = c.types.listAt(arguments, k);
        if (!c.types.is(a, TypeKind.TypeParameter) && !c.types.is(a, TypeKind.ConstValue)) {
            return false;
        }
    }
    return true;
}

fn recordDeclaredFlows(c: borrow mut Checker, f: u32, function: u32) -> Result<void, AllocError> {
    var sources = Vector<u32>.create();
    var deep = Vector<u32>.create();
    var flows = Vector<u64>.create();
    for (i in c.hir.functions[function as usize].returnSources.view()) {
        sources.push(i)?;
    }
    for (i in c.hir.functions[function as usize].deepSources.view()) {
        deep.push(i)?;
    }
    for (flow in c.hir.functions[function as usize].mutableFlows.view()) {
        flows.push(flow)?;
    }
    c.declaredFlows[f as usize] = DeclaredFlows { function: function, sources: sources, deep: deep, flows: flows };
    return Ok();
}

fn isPlainReference(c: borrow Checker, t: u32) -> bool =>
    c.types.is(t, TypeKind.Reference) && !c.types.isSlice(t) && !c.types.isStringView(t);

/// What `function`, an instance of declaration `f`, lacks of the declaration's flows (ADR 0131 §2.9): added when
/// `add`, else only counted. Two gates lose no loan: a result whose instance type can hold none has no sources, and
/// a `borrow mut` parameter whose instance referent can hold none is no target.
fn missingDeclaredFlows(c: borrow mut Checker, f: u32, function: u32, add: bool) -> Result<u32, AllocError> {
    var missing: u32 = 0;
    let count = c.hir.functions[function as usize].parameters.length;
    let returnType = c.hir.functions[function as usize].returnType;
    if (mayHoldLoans(c, returnType)) {
        for (k in 0..c.declaredFlows[f as usize].sources.length) {
            let i = c.declaredFlows[f as usize].sources[k];
            if (i as usize >= count) {
                continue;
            }
            let declaredDeep = containsU32(c.declaredFlows[f as usize].deep, i);
            if (!containsU32(c.hir.functions[function as usize].returnSources, i)) {
                missing += 1;
                if (add) {
                    c.hir.functions[function as usize].returnSources.push(i)?;
                    let local = c.hir.functions[function as usize].parameters[i as usize];
                    if (declaredDeep && isPlainReference(c, c.hir.locals[local as usize].typ)) {
                        c.hir.functions[function as usize].deepSources.push(i)?;
                    }
                }
            } else if (!declaredDeep && containsU32(c.hir.functions[function as usize].deepSources, i)) {
                // Deep where the declaration's is not: less than the declaration's.
                missing += 1;
                if (add) {
                    var kept = Vector<u32>.create();
                    for (d in c.hir.functions[function as usize].deepSources.view()) {
                        if (d != i) {
                            kept.push(d)?;
                        }
                    }
                    c.hir.functions[function as usize].deepSources = kept;
                    if (c.hir.functions[function as usize].resultThrough == i) {
                        c.hir.functions[function as usize].resultThrough = none();
                    }
                }
            }
        }
        if (add) {
            sortU32(mut c.hir.functions[function as usize].returnSources);
        }
    }
    for (k in 0..c.declaredFlows[f as usize].flows.length) {
        let flow = c.declaredFlows[f as usize].flows[k];
        let target = flowTarget(flow);
        if (target as usize >= count || flowSource(flow) as usize >= count) {
            continue;
        }
        let t = c.hir.locals[c.hir.functions[function as usize].parameters[target as usize] as usize].typ;
        let held = !c.types.is(t, TypeKind.Reference) && c.types.writableThrough(t, 0);
        if (!held && (!c.types.is(t, TypeKind.Reference) || !c.types.info(t).mutableReference)) {
            continue;
        }
        let pointee = if (held) t else c.types.info(t).pointee;
        if (!mayHoldLoans(c, pointee) && !c.types.isDyn(pointee)) {
            continue;
        }
        let plain = flow & (deepFlowBit() ^ 0xFFFFFFFFFFFFFFFF);
        let hasPlain = containsU64(c.hir.functions[function as usize].mutableFlows, plain);
        let hasDeep = containsU64(c.hir.functions[function as usize].mutableFlows, plain | deepFlowBit());
        if (hasPlain || (hasDeep && flowIsDeep(flow))) {
            continue;
        }
        missing += 1;
        if (add) {
            if (hasDeep) {
                var kept = Vector<u64>.create();
                for (mine in c.hir.functions[function as usize].mutableFlows.view()) {
                    kept.push(if (mine == (plain | deepFlowBit())) plain else mine)?;
                }
                c.hir.functions[function as usize].mutableFlows = kept;
            } else {
                c.hir.functions[function as usize].mutableFlows.push(flow)?;
            }
        }
    }
    return Ok(missing);
}

fn inheritFlows(c: borrow mut Checker, f: u32, function: u32) -> Result<void, AllocError> {
    if (c.declaredFlows[f as usize].function == function) {
        return Ok();
    }
    let _ = missingDeclaredFlows(c, f, function, true)?;
    return Ok();
}

/// ceesafec's own check of §2.9, after the declarations and again before the bodies' loans are followed: a function
/// that lacks a flow of its declaration is N0216, not a silent pass.
fn checkDeclaredFlows(c: borrow mut Checker) -> Result<void, AllocError> {
    for (k in 0..c.hir.functions.length) {
        let function = truncate<u32>(k);
        let f = c.hir.functions[k].syntax;
        if (f == none() || (f as usize) >= c.declaredFlows.length || c.declaredFlows[f as usize].function == none() ||
            c.declaredFlows[f as usize].function == function) {
            continue;
        }
        if (missingDeclaredFlows(c, f, function, false)? > 0) {
            var message = Vector<u8>.create();
            appendText(mut message, "ceesafec's internal check: this instance of '")?;
            appendBytes(mut message, c.name(c.hir.functions[k].name))?;
            appendText(
                mut message,
                "' lacks a flow of its declaration, so a caller would not know of a loan its body may return or store (ADR 0131 §2.9); please report this",
            )?;
            let file = c.hir.functions[k].file;
            c.front.diagnostics.error(unsupported(), file, 0, 1, message)?;
        }
    }
    return Ok();
}

/// Does the function take a function value whose result may hold a loan (a `fn`, a `borrow fn` or a closure whose
/// result mentions a type parameter that is not Send or Share)? Not a `dyn fn`: its result borrows from nothing it
/// is given (§36.5).
fn takesMakingFunction(c: borrow Checker, function: u32) -> bool {
    for (local in c.hir.functions[function as usize].parameters.view()) {
        var t = c.hir.locals[local as usize].typ;
        if (c.types.is(t, TypeKind.Reference)) {
            t = c.types.info(t).pointee;
        }
        if (c.types.isDyn(t)) {
            continue;
        }
        let result = c.types.info(t).result;
        if (result != none() && c.types.mentionsParameterOutsideDyn(result)) {
            return true;
        }
    }
    return false;
}

/// A type parameter's flow names include those of its bounds' arguments (§25.6, ADR 0131): a value of type `S` under
/// `S: Source<T>` may give a `T` that holds what it holds, so the two share a name, and `Self` in an interface has the
/// interface's parameters (`selfNames`). `bounded` holds the type parameter lists in scope.
fn closeFlowNames(
    c: borrow Checker,
    function: u32,
    bounded: borrow Vector<Range>,
    selfNames: borrow Vector<u32>,
    selfRegions: borrow Vector<u32>,
    names: borrow mut Vector<u64>,
) -> Result<void, AllocError> {
    var k: usize = 0;
    while (k < names.length) {
        // The names added here are looked at in turn, so a bound's bound counts too.
        let name = names[k];
        k += 1;
        if (!isTypeFlowName(name)) {
            continue;
        }
        let symbol = truncate<u32>(name & 0xFFFFFFFF);
        if (symbol == c.selfSymbol) {
            for (t in selfNames.view()) {
                addName(names, typeFlowName(t))?;
            }
            for (r in selfRegions.view()) {
                addName(names, regionFlowName(r))?;
            }
            continue;
        }
        for (list in bounded.view()) {
            for (j in 0..list.count) {
                let p = c.front.ast.typeParameters[c.front.ast.at(list, j) as usize];
                if (p.isRegion || c.front.ast.idents[p.name as usize].symbol != symbol) {
                    continue;
                }
                for (b in 0..p.bounds.count) {
                    collectFlowNames(c, c.front.ast.at(p.bounds, b), function, false, names)?;
                }
            }
        }
    }
    return Ok();
}

/// The pointee of a result written `borrow T` or `borrow mut T` (or an optional of one) with no sources or regions
/// written on the reference, or none.
fn elidedResultPointee(c: borrow Checker, syntax: u32) -> u32 {
    let reference = match (c.front.ast.types[syntax as usize]) {
        TypeNode.Optional(inner) => inner,
        _ => syntax,
    };
    return match (c.front.ast.types[reference as usize]) {
        TypeNode.Reference(_, hasSources, _, pointee) => if (hasSources) none() else pointee,
        _ => none(),
    };
}

/// The single parameter of scoped type, or none when there are none or several (v0 elision, §13.5).
fn singleScopedParameter(c: borrow Checker, function: u32) -> u32 {
    var found: u32 = none();
    for (i in 0..c.hir.functions[function as usize].parameters.length) {
        let local = c.hir.functions[function as usize].parameters[i];
        if (c.types.isScoped(c.hir.locals[local as usize].typ)) {
            if (found != none()) {
                return none();
            }
            found = truncate<u32>(i);
        }
    }
    return found;
}

/// Reference parameter `i`'s outer flow names (ADR 0074 §2.4): its elided name and the regions written on it. False
/// for a parameter whose reference is written otherwise (in parentheses), which keeps its outer loan.
fn outerFlowNames(
    c: borrow Checker,
    f: u32,
    i: usize,
    receiverOffset: usize,
    outer: borrow mut Vector<u64>,
) -> Result<bool, AllocError> {
    addName(outer, elidedFlowName(i))?;
    if (i < receiverOffset) {
        return Ok(true);
    }
    let decl = c.front.ast.functions[f as usize];
    let p = c.front.ast.parameters[c.front.ast.at(decl.parameters, truncate<u32>(i - receiverOffset)) as usize];
    match (c.front.ast.types[p.typ as usize]) {
        TypeNode.Reference(_, _, written, _) => {
            for (k in 0..written.count) {
                let symbol = c.front.ast.idents[c.front.ast.at(written, k) as usize].symbol;
                addName(outer, regionFlowName(symbol))?;
            }
            return Ok(true);
        }
        _ => { return Ok(false); }
    }
}

/// The flow names of what a reference written `borrow P` refers to. What a `borrow dyn I<T>` refers to may be a
/// scoped implementation (§37.2), which holds what its interface's arguments name; an owned `dyn` value, as in a
/// `Box<dyn I<T>>`, holds no loan (§25.7 rule 5), nor does a `dyn I + Send` (§38.4).
fn collectReferentNames(
    c: borrow Checker,
    pointee: u32,
    function: u32,
    inResult: bool,
    names: borrow mut Vector<u64>,
) -> Result<void, AllocError> {
    match (c.front.ast.types[pointee as usize]) {
        TypeNode.Dyn(inner, _, marker) => {
            return if (marker == 0) collectFlowNames(c, inner, function, inResult, names) else Ok();
        }
        _ => {}
    }
    return collectFlowNames(c, pointee, function, inResult, names);
}

/// The flow names a type written in a signature mentions (CollectFlowNames). In a result (`inResult`), `borrow(p)`
/// adds parameter `p`'s names (c.flowNames), less its type parameters'.
fn collectFlowNames(
    c: borrow Checker,
    syntax: u32,
    function: u32,
    inResult: bool,
    names: borrow mut Vector<u64>,
) -> Result<void, AllocError> {
    match (c.front.ast.types[syntax as usize]) {
        TypeNode.Optional(inner) => { return collectFlowNames(c, inner, function, inResult, names); }
        TypeNode.Array(element, _) => { return collectFlowNames(c, element, function, inResult, names); }
        TypeNode.Reference(_, _, sources, pointee) => {
            for (k in 0..sources.count) {
                let symbol = c.front.ast.idents[c.front.ast.at(sources, k) as usize].symbol;
                let i = if (inResult) parameterIndex(c, function, symbol) else none();
                if (i != none()) {
                    // The result borrows the parameter's referent: its regions, not its type parameters' loans.
                    for (n in c.flowNames[i as usize].view()) {
                        if (!isTypeFlowName(n)) {
                            addName(names, n)?;
                        }
                    }
                } else if (isRegionSymbol(c, symbol) && !sameText(c.name(symbol), "static")) {
                    addName(names, regionFlowName(symbol))?;
                }
            }
            return collectReferentNames(c, pointee, function, inResult, names);
        }
        TypeNode.Named(name) => {
            // `T`, or a projection `T.Item` (ADR 0086 §2.5): what an associated type of `T` holds, a `T` gave it.
            if (name.parts.count >= 1) {
                let symbol = c.front.ast.idents[c.front.ast.at(name.parts, 0) as usize].symbol;
                if (containsU32(c.flowTypeParameters, symbol)) {
                    addName(names, typeFlowName(symbol))?;
                }
            }
            return Ok();
        }
        // A function value gives its result: a parameter `f: fn(StringView) -> U` shares `U` with a result `U`
        // (ADR 0131). A `borrow fn` or a closure then is a deep source: what its captures hold.
        TypeNode.Function(_, _, result) => {
            return if (result == none()) Ok() else collectFlowNames(c, result, function, inResult, names);
        }
        TypeNode.FunctionPointer(_, _, result) => {
            return if (result == none()) Ok() else collectFlowNames(c, result, function, inResult, names);
        }
        TypeNode.Generic(name, arguments) => {
            if (name.parts.count != 1) {
                return Ok();
            }
            let symbol = c.front.ast.idents[c.front.ast.at(name.parts, 0) as usize].symbol;
            let text = c.name(symbol);
            var regions: u32 = 0;
            match (c.item(symbol)) {
                Entity.Struct(index) => { regions = itemRegionCount(c, c.structs[index as usize].item); }
                Entity.Enum(index) => { regions = itemRegionCount(c, c.enums[index as usize].item); }
                _ => {
                    if (sameText(text, "StringView") || ((sameText(text, "Slice") || sameText(text, "SliceMut")) &&
                        arguments.count == 2)) {
                        regions = 1;
                    }
                }
            }
            let hasRegions = regions > 0 && arguments.count > 0 && isRegionName(c, c.front.ast.at(arguments, 0));
            for (k in 0..arguments.count) {
                let argument = c.front.ast.at(arguments, k);
                if (hasRegions && k < regions) {
                    let r = singleName(c, argument);
                    if (isRegionName(c, argument) && !sameText(c.name(r), "static")) {
                        addName(names, regionFlowName(r))?;
                    }
                } else {
                    collectFlowNames(c, argument, function, inResult, names)?;
                }
            }
            return Ok();
        }
        _ => { return Ok(); }
    }
}

/// The number of region parameters an item declares.
fn itemRegionCount(c: borrow Checker, item: u32) -> u32 {
    if (item == none()) {
        return 0;
    }
    match (c.front.ast.items[item as usize].kind) {
        ItemKind.Struct(k) => { return c.front.ast.structs[k as usize].regionParameters.count; }
        ItemKind.Enum(_, _, regionParameters) => { return regionParameters.count; }
        _ => { return 0; }
    }
}

/// The index of the parameter named `symbol`, or none.
fn parameterIndex(c: borrow Checker, function: u32, symbol: u32) -> u32 {
    let parameters = borrow c.hir.functions[function as usize].parameters;
    for (i in 0..parameters.length) {
        if (c.hir.locals[parameters[i] as usize].name == symbol) {
            return truncate<u32>(i);
        }
    }
    return none();
}

/// The parameters a returned reference may be derived from (ResolveReturnSources, §13.5): its source list, or the
/// only reference parameter.
fn resolveReturnSources(
    c: borrow mut Checker,
    f: u32,
    function: u32,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    let decl = c.front.ast.functions[f as usize];
    let returnSpan = c.front.ast.typeSpans[decl.returnType as usize];
    let returnType = c.hir.functions[function as usize].returnType;
    let returnsMutable = c.types.is(returnType, TypeKind.Reference) && c.types.info(returnType).mutableReference;
    let parameterCount = c.hir.functions[function as usize].parameters.length;
    var referenceParameters = Vector<u32>.create();
    for (i in 0..parameterCount) {
        let local = c.hir.functions[function as usize].parameters[i];
        if (c.types.isScoped(c.hir.locals[local as usize].typ)) {
            referenceParameters.push(truncate<u32>(i))?;
        }
    }
    let sourceList = match (c.front.ast.types[decl.returnType as usize]) {
        TypeNode.Reference(_, hasSourceList, sources, _) => if (hasSourceList) sources else emptyRange(),
        _ => emptyRange(),
    };
    let hasSourceList = match (c.front.ast.types[decl.returnType as usize]) {
        TypeNode.Reference(_, hasSourceList, _, _) => hasSourceList,
        _ => false,
    };
    if (!hasSourceList) {
        if (referenceParameters.length == 0 && onlyViews(c, returnType)) {
            return Ok(); // string views of static text (§22.2); the return check still rejects local loans
        }
        if (referenceParameters.length == 1) {
            let i = referenceParameters[0];
            let local = c.hir.functions[function as usize].parameters[i as usize];
            let onlyType = c.hir.locals[local as usize].typ;
            if (returnsMutable && !c.types.info(onlyType).mutableReference) {
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    "a 'borrow mut' result cannot be derived from the shared reference parameter ",
                )?;
                appendQuotedName(mut message, c, c.hir.locals[local as usize].name)?;
                c.error(returnSourceMismatch(), returnSpan.start, returnSpan.end, message)?;
            }
            out.push(i)?;
            return Ok();
        }
        var message = Vector<u8>.create();
        if (referenceParameters.length == 0) {
            appendText(
                mut message,
                "a function without reference parameters cannot return a reference: there is nothing it could borrow from",
            )?;
        } else {
            appendText(
                mut message,
                "this function has several reference parameters: name the ones the result is borrowed from, e.g. 'borrow(a, b) T'",
            )?;
        }
        return c.error(returnSourceMismatch(), returnSpan.start, returnSpan.end, message);
    }
    for (k in 0..sourceList.count) {
        let ident = c.front.ast.idents[c.front.ast.at(sourceList, k) as usize];
        if (isRegionSymbol(c, ident.symbol)) {
            continue; // a region: its parameters were found by name (§25.6)
        }
        let i = parameterIndex(c, function, ident.symbol);
        let local = if (i == none()) none() else c.hir.functions[function as usize].parameters[i as usize];
        if (local == none() || !c.types.isScoped(c.hir.locals[local as usize].typ)) {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, ident.symbol)?;
            if (local == none()) {
                appendText(mut message, " is not a parameter of ")?;
                appendQuotedName(mut message, c, c.front.ast.idents[decl.name as usize].symbol)?;
            } else {
                appendText(mut message, " is not a reference parameter, so the result cannot borrow from it")?;
            }
            c.error(returnSourceMismatch(), ident.start, ident.end, message)?;
            continue;
        }
        if (returnsMutable && !c.types.info(c.hir.locals[local as usize].typ).mutableReference) {
            var message = Vector<u8>.create();
            appendText(mut message, "a 'borrow mut' result cannot be derived from the shared reference parameter ")?;
            appendQuotedName(mut message, c, ident.symbol)?;
            c.error(returnSourceMismatch(), ident.start, ident.end, message)?;
            continue;
        }
        out.push(i)?;
    }
    return Ok();
}

/// Is every scoped value in the type a `StringView` (OnlyViews, §22.2)?
fn onlyViews(c: borrow Checker, typ: u32) -> bool {
    if (c.types.isStringView(typ)) {
        return true;
    }
    if (c.types.is(typ, TypeKind.Reference)) {
        return false;
    }
    if (isResultType(c, typ)) {
        let ok = resultOk(c, typ);
        let err = resultErr(c, typ);
        return (!c.types.isScoped(ok) || onlyViews(c, ok)) && (!c.types.isScoped(err) || onlyViews(c, err));
    }
    let option = c.types.optionType(typ);
    if (option != none()) {
        return onlyViews(c, option);
    }
    return false;
}

fn sortU32(values: borrow mut Vector<u32>) {
    for (i in 1..values.length) {
        var j = i;
        while (j > 0 && values[j - 1] > values[j]) {
            let t = values[j];
            values[j] = values[j - 1];
            values[j - 1] = t;
            j -= 1;
        }
    }
}

/// Does the type syntax write the region `static` anywhere: `StringView<static>`, `Slice<static, T>`, `S<static>`,
/// `borrow(static) T`, or inside an optional or array of one (ADR 0068)?
fn writesStatic(c: borrow Checker, syntax: u32) -> bool {
    match (c.front.ast.types[syntax as usize]) {
        TypeNode.Optional(inner) => { return writesStatic(c, inner); }
        TypeNode.Array(element, _) => { return writesStatic(c, element); }
        TypeNode.Reference(_, _, sources, pointee) => {
            for (k in 0..sources.count) {
                if (sameText(c.name(c.front.ast.idents[c.front.ast.at(sources, k) as usize].symbol), "static")) {
                    return true;
                }
            }
            return writesStatic(c, pointee);
        }
        TypeNode.Generic(_, arguments) => {
            for (k in 0..arguments.count) {
                let argument = c.front.ast.at(arguments, k);
                let symbol = singleName(c, argument);
                if (symbol != none() && sameText(c.name(symbol), "static")) {
                    return true;
                }
                if (writesStatic(c, argument)) {
                    return true;
                }
            }
            return false;
        }
        _ => { return false; }
    }
}

/// N0273 for `static` written in a parameter's type (ADR 0068): no call checks that its argument is static data.
fn staticParameterError(c: borrow mut Checker, syntax: u32) -> Result<void, AllocError> {
    let span = c.front.ast.typeSpans[syntax as usize];
    var message = Vector<u8>.create();
    appendText(
        mut message,
        "a parameter cannot require the region 'static': a call does not check that its argument is static data, so the callee could not rely on it; drop 'static' (string literals still pass) (type-system.md §25.2; ADR 0068)",
    )?;
    return c.error(unknownRegion(), span.start, span.end, message);
}

fn unknownRegion() -> u32 => 273;

/// N0273 for a name that is not a region in scope (CheckRegionArgument).
fn unknownRegionError(c: borrow mut Checker, ident: Ident) -> Result<void, AllocError> {
    var message = Vector<u8>.create();
    appendQuotedName(mut message, c, ident.symbol)?;
    appendText(mut message, " is not a region in scope; declare it with 'region ")?;
    appendBytes(mut message, c.name(ident.symbol))?;
    appendText(mut message, "' or use 'static'")?;
    return c.error(unknownRegion(), ident.start, ident.end, message);
}

/// A box's contents (not a `Box<dyn I>`'s), dereferenced; other values as they are.
fn boxContents(c: borrow mut Checker, value: u32) -> Result<u32, AllocError> {
    let t = c.typeOf(value);
    if (c.types.is(t, TypeKind.Box) && !c.types.isDyn(c.types.info(t).pointee)) {
        let s = c.spanOf(value);
        return c.expr(HirExpr.Deref(value), c.types.info(t).pointee, s.start, s.end);
    }
    return Ok(value);
}
