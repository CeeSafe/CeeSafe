// Suggestions for a name that does not exist (Suggest): the closest names by edit distance, used by the checker's
// "did you mean" notes and by the MCP server's ceesafe_api. Optimal string alignment distance (insert, delete,
// substitute, swap two neighbours), case-insensitive, over ASCII bytes; names of other bytes compare exactly.

fn lowerByte(b: u8) -> u8 => if (b >= 'A' && b <= 'Z') b + 32 else b;

fn smaller(a: usize, b: usize) -> usize => if (a < b) a else b;

/// The distance between `a` and `b`, or `limit + 1` once it is certainly above `limit` (names are short; the
/// rows are at most 64 bytes, longer names are compared on their first 64).
fn nameDistance(a: Slice<u8>, b: Slice<u8>, limit: usize) -> usize {
    let n = if (a.length < 64) a.length else 64;
    let m = if (b.length < 64) b.length else 64;
    if ((if (n > m) n - m else m - n) > limit) {
        return limit + 1;
    }
    var before = [0usize; 65];   // row i - 2
    var previous = [0usize; 65]; // row i - 1
    var current = [0usize; 65];
    for (j in 0..m + 1) {
        previous[j] = j;
    }
    for (i in 1..n + 1) {
        current[0] = i;
        var smallest = current[0];
        for (j in 1..m + 1) {
            let cost: usize = if (lowerByte(a[i - 1]) == lowerByte(b[j - 1])) 0 else 1;
            // The compiler's own source stays within what its stage 0 accepts (bootstrap/reference.md): no `min`.
            var d = smaller(smaller(previous[j] + 1, current[j - 1] + 1), previous[j - 1] + cost);
            if (i > 1 && j > 1 && lowerByte(a[i - 1]) == lowerByte(b[j - 2]) &&
                lowerByte(a[i - 2]) == lowerByte(b[j - 1])) {
                d = smaller(d, before[j - 2] + 1); // a swap of two neighbours
            }
            current[j] = d;
            smallest = smaller(smallest, d);
        }
        if (smallest > limit) {
            return limit + 1;
        }
        for (j in 0..m + 1) {
            before[j] = previous[j];
            previous[j] = current[j];
        }
    }
    return previous[m];
}

/// Whether `candidate` is a plausible meaning of `wanted`: within a third of its length (at least one edit, at most
/// three), or one contains the other case-insensitively (`unsigned` and `unsignedAbs`).
fn isCloseName(wanted: Slice<u8>, candidate: Slice<u8>) -> bool {
    if (wanted.length == 0 || candidate.length == 0) {
        return false;
    }
    let third = wanted.length / 3;
    let limit: usize = if (third < 1) 1 else if (third > 3) 3 else third;
    if (nameDistance(wanted, candidate, limit) <= limit) {
        return true;
    }
    return wanted.length >= 3 && (containsIgnoringCase(candidate, wanted) || containsIgnoringCase(wanted, candidate) &&
        candidate.length >= 3);
}

/// "; did you mean 'a', 'b' or 'c'?" for `wanted`, a member of struct `definition` that does not exist: its functions
/// (with `functions`) and fields (with `fields`) whose names are close (isCloseName), then its functions whose doc
/// comment mentions the name (`unsigned` finds `decimal`, "Appends an unsigned integer in decimal"). Nothing when
/// none is close. Up to three, in declaration order.
fn appendDidYouMean(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    definition: u32,
    wanted: u32,
    functions: bool,
    fields: bool,
) -> Result<void, AllocError> {
    if (definition == none()) {
        return Ok();
    }
    let name = c.name(wanted);
    var found = Vector<u32>.create();
    let s = borrow c.types.structs[definition as usize];
    if (functions) {
        for (symbol in s.functionNames.view()) {
            if (found.length < 3 && symbol != wanted && isCloseName(
                name,
                c.name(symbol),
            ) && !containsU32(found, symbol)) {
                found.push(symbol)?;
            }
        }
    }
    if (fields) {
        for (field in s.fields.view()) {
            let symbol = c.types.fields[field as usize].name;
            if (found.length < 3 && symbol != wanted && !fieldIsHidden(c, s.file, field) && isCloseName(
                name,
                c.name(symbol),
            ) && !containsU32(found, symbol)) {
                found.push(symbol)?;
            }
        }
    }
    if (functions && name.length >= 4) {
        for (k in 0..s.functions.length) {
            let syntax = c.front.ast.functions[c.hir.functions[s.functions[k] as usize].syntax as usize];
            let symbol = s.functionNames[k];
            if (found.length < 3 && syntax.hasDoc && containsIgnoringCase(c.front.ast.textOf(syntax.doc), name) &&
                !containsU32(found, symbol)) {
                found.push(symbol)?;
            }
        }
    }
    if (found.length == 0) {
        // Nothing close: a small type's members are short enough to list (`Environment` has `variable`).
        var count: usize = 0;
        if (functions) {
            count += s.functionNames.length;
        }
        if (fields) {
            for (field in s.fields.view()) {
                if (!fieldIsHidden(c, s.file, field)) {
                    count += 1;
                }
            }
        }
        if (count == 0 || count > 6) {
            return Ok();
        }
        appendText(message, "; it has ")?;
        var k: usize = 0;
        if (functions) {
            for (symbol in s.functionNames.view()) {
                if (k > 0) {
                    appendText(message, if (k + 1 == count) " and " else ", ")?;
                }
                appendQuotedName(message, c, symbol)?;
                k += 1;
            }
        }
        if (fields) {
            for (field in s.fields.view()) {
                if (fieldIsHidden(c, s.file, field)) {
                    continue;
                }
                if (k > 0) {
                    appendText(message, if (k + 1 == count) " and " else ", ")?;
                }
                appendQuotedName(message, c, c.types.fields[field as usize].name)?;
                k += 1;
            }
        }
        return Ok();
    }
    appendText(message, "; did you mean ")?;
    for (k in 0..found.length) {
        if (k > 0) {
            appendText(message, if (k + 1 == found.length) " or " else ", ")?;
        }
        appendQuotedName(message, c, found[k])?;
    }
    return appendText(message, "?");
}

/// Is the field of a struct declared in `file` one the current file cannot reach: private to another file, or not
/// public in another package (CheckPrivate's two cases)? A message does not name it.
fn fieldIsHidden(c: borrow Checker, file: u32, field: u32) -> bool =>
    (c.types.fields[field as usize].isPrivate && file != c.file) ||
        (!c.types.fields[field as usize].isPublic && file != none() && isOtherPackage(c, file));

/// "; did you mean …?" for a member of a built-in type (`Process.args`): the members the built-in types page lists
/// for that type that ApiLookup finds close (ceesafe_api's suggestions), so the error and the tool agree.
fn appendBuiltinDidYouMean(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    typeName: Slice<u8>,
    wanted: u32,
) -> Result<void, AllocError> {
    var query = Vector<u8>.create();
    appendBytes(mut query, typeName)?;
    query.push('.')?;
    appendBytes(mut query, c.name(wanted))?;
    var hits = Vector<ApiHit>.create();
    var suggestions = Vector<Vector<u8>>.create();
    apiLookup(query.view(), mut hits, mut suggestions)?;
    var candidates = Vector<Vector<u8>>.create();
    for (s in suggestions.view()) {
        let name = s.view();
        if (name.length > typeName.length + 1 && name[typeName.length] == '.' &&
            sameBytes(name[0..typeName.length], typeName)) {
            var m = Vector<u8>.create();
            appendBytes(mut m, name[typeName.length + 1..])?;
            candidates.push(m)?;
        }
    }
    // The three best: the longest shared start first (`args` → `argument`), then the fewest edits.
    let wantedName = c.name(wanted);
    var members = Vector<Vector<u8>>.create();
    var used = Vector<bool>.create();
    for (k in 0..candidates.length) {
        used.push(false)?;
    }
    while (members.length < 3) {
        var best = candidates.length;
        var bestPrefix: usize = 0;
        var bestDistance: usize = 0;
        for (k in 0..candidates.length) {
            if (used[k]) {
                continue;
            }
            let prefix = sharedStart(wantedName, candidates[k].view());
            let distance = nameDistance(wantedName, candidates[k].view(), 64);
            if (best == candidates.length || prefix > bestPrefix || (prefix == bestPrefix && distance < bestDistance)) {
                best = k;
                bestPrefix = prefix;
                bestDistance = distance;
            }
        }
        if (best == candidates.length) {
            break;
        }
        used[best] = true;
        var m = Vector<u8>.create();
        appendBytes(mut m, candidates[best].view())?;
        members.push(m)?;
    }
    return appendNameChoices(message, members);
}

/// How many leading bytes `a` and `b` share, ignoring ASCII case.
fn sharedStart(a: Slice<u8>, b: Slice<u8>) -> usize {
    var k: usize = 0;
    while (k < a.length && k < b.length && lowerByte(a[k]) == lowerByte(b[k])) {
        k += 1;
    }
    return k;
}

/// "; did you mean …?" for a method of a number (`x.clamp(…)`): the integer or float methods whose names are close.
/// The names are the ones the checker accepts (integerMethodNames, floatMethodNames), then the type's impl methods.
fn appendNumberDidYouMean(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    typ: u32,
    wanted: u32,
) -> Result<void, AllocError> {
    let names = if (c.types.is(typ, TypeKind.Float)) floatMethodNames() else integerMethodNames();
    var members = Vector<Vector<u8>>.create();
    // The count is not needed here. (A named local, not `let _`: ceesafec 0.8.0, which builds this file in the
    // release's chain, does not have it.)
    let found = methodNamesOf(c, typ, names, wanted, mut members)?;
    if (found == 0) {
        return appendNameChoices(message, members);
    }
    return appendNameChoices(message, members);
}

/// The names close to `wanted` (isCloseName; up to three, into `close`) among the methods a value of `typ` has without
/// being a struct: the built-in ones of `builtin` (names separated by spaces, or empty) and those of the type's impls,
/// an enum's own `impl E { … }` among them (ADR 0107), that the current file may call. Returns how many methods there
/// are, close or not.
fn methodNamesOf(
    c: borrow Checker,
    typ: u32,
    builtin: StringView,
    wanted: u32,
    close: borrow mut Vector<Vector<u8>>,
) -> Result<usize, AllocError> {
    let name = c.name(wanted);
    var count: usize = 0;
    let list = builtin.bytes();
    var start: usize = 0;
    for (k in 0..list.length + 1) {
        if (k == list.length || list[k] == ' ') {
            if (k > start) {
                count += 1;
                if (close.length < 3 && isCloseName(name, list[start..k])) {
                    var m = Vector<u8>.create();
                    appendBytes(mut m, list[start..k])?;
                    close.push(m)?;
                }
            }
            start = k + 1;
        }
    }
    var seen = Vector<u32>.create();
    for (m in c.implMethods.view()) {
        if (m.typ != typ || containsU32(seen, m.name) || methodIsHidden(c, m.function)) {
            continue;
        }
        seen.push(m.name)?;
        count += 1;
        if (close.length < 3 && isCloseName(name, c.name(m.name))) {
            var text = Vector<u8>.create();
            appendBytes(mut text, c.name(m.name))?;
            close.push(text)?;
        }
    }
    return Ok(count);
}

/// Is `function`, a method of an impl, one the current file cannot call: private to another file (ADR 0109), or an
/// enum's own and not public in another package (ADR 0107)? A message does not name it.
fn methodIsHidden(c: borrow Checker, function: u32) -> bool {
    let syntax = c.hir.functions[function as usize].syntax;
    let file = c.hir.functions[function as usize].file;
    if (syntax == none() || file == none() || file == c.file) {
        return false;
    }
    let visibility = c.front.ast.functions[syntax as usize].visibility;
    if (isOtherPackage(c, file)) {
        return isEnumMethod(c, syntax) && !isPublicVisibility(visibility);
    }
    return isPrivateVisibility(visibility);
}

/// What follows "type 'T' has no method 'm'" for a type that is not a struct (an enum, a number): "; did you mean …?"
/// with its methods of a close name, else "; it has …" with all of them when they are at most six, as for a struct's
/// members (appendDidYouMean). Returns whether the type has any method.
fn appendMethodChoices(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    typ: u32,
    builtin: StringView,
    wanted: u32,
) -> Result<bool, AllocError> {
    var close = Vector<Vector<u8>>.create();
    let count = methodNamesOf(c, typ, builtin, wanted, mut close)?;
    if (close.length > 0 || count == 0 || count > 6) {
        appendNameChoices(message, close)?;
        return Ok(count > 0);
    }
    // Nothing close: a few methods are short enough to list.
    appendMethodList(c, message, typ, builtin, count)?;
    return Ok(true);
}

/// What follows "'T' has no method 'm'" for a built-in container (`Vector<u8>`, `String`): "; did you mean …?" with
/// its methods of a close name, else "; it has …" with every one, however many. Both include the methods lib/core's
/// impls give the type (`Vector<u8>.appendHex`), which the call would have found, not only the built-in ones.
fn appendEveryMethodChoice(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    typ: u32,
    builtin: StringView,
    wanted: u32,
) -> Result<void, AllocError> {
    var close = Vector<Vector<u8>>.create();
    let count = methodNamesOf(c, typ, builtin, wanted, mut close)?;
    if (close.length > 0 || count == 0) {
        return appendNameChoices(message, close);
    }
    return appendMethodList(c, message, typ, builtin, count);
}

/// "; it has 'a', 'b' and 'c'": the `count` names of `builtin` (separated by spaces), then the type's impl methods.
fn appendMethodList(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    typ: u32,
    builtin: StringView,
    count: usize,
) -> Result<void, AllocError> {
    appendText(message, "; it has ")?;
    var k: usize = 0;
    let list = builtin.bytes();
    var start: usize = 0;
    for (j in 0..list.length + 1) {
        if (j == list.length || list[j] == ' ') {
            if (j > start) {
                if (k > 0) {
                    appendText(message, if (k + 1 == count) " and " else ", ")?;
                }
                message.push('\'')?;
                appendBytes(message, list[start..j])?;
                message.push('\'')?;
                k += 1;
            }
            start = j + 1;
        }
    }
    var seen = Vector<u32>.create();
    for (m in c.implMethods.view()) {
        if (m.typ != typ || containsU32(seen, m.name) || methodIsHidden(c, m.function)) {
            continue;
        }
        seen.push(m.name)?;
        if (k > 0) {
            appendText(message, if (k + 1 == count) " and " else ", ")?;
        }
        appendQuotedName(message, c, m.name)?;
        k += 1;
    }
    return Ok();
}

/// "; did you mean …?" for `wanted`, a name used as a type that no type has (`Vec<i32>`): the built-in generic types
/// (builtinGenericTypeNames) and the structs and enums the current file can name, whose names are close (isCloseName;
/// `Vec` finds `Vector`). For `Option` and `Optional`, how an optional type is written. Nothing when none is close.
fn appendTypeDidYouMean(c: borrow Checker, message: borrow mut Vector<u8>, wanted: u32) -> Result<void, AllocError> {
    let name = c.name(wanted);
    if (sameText(name, "Option") || sameText(name, "Optional")) {
        return appendText(message, "; an optional type is written 'T?' (type-system.md §22.1)");
    }
    var close = Vector<Vector<u8>>.create();
    let list = builtinGenericTypeNames().bytes();
    var start: usize = 0;
    for (k in 0..list.length + 1) {
        if (k == list.length || list[k] == ' ') {
            if (isCloseName(name, list[start..k])) {
                var m = Vector<u8>.create();
                appendBytes(mut m, list[start..k])?;
                close.push(m)?;
            }
            start = k + 1;
        }
    }
    for (entry in c.structs.view()) {
        if (entry.item != none() && entry.template == none()) {
            addCloseTypeName(c, name, entry.typ, mut close)?;
        }
    }
    for (entry in c.enums.view()) {
        if (entry.template == none()) {
            addCloseTypeName(c, name, entry.typ, mut close)?;
        }
    }
    // The three with the fewest edits, in the order found. A name within a misspelling's distance (`Par`, `Pair`)
    // leaves out those that only contain the name (`IoParts`).
    let third = name.length / 3;
    let limit: usize = if (third < 1) 1 else if (third > 3) 3 else third;
    var nearest: usize = 65;
    for (k in 0..close.length) {
        nearest = smaller(nearest, nameDistance(name, close[k].view(), 64));
    }
    var chosen = Vector<Vector<u8>>.create();
    var used = Vector<bool>.create();
    for (k in 0..close.length) {
        used.push(false)?;
    }
    while (chosen.length < 3) {
        var best = close.length;
        var bestDistance: usize = 0;
        for (k in 0..close.length) {
            let distance = nameDistance(name, close[k].view(), 64);
            if (!used[k] && (nearest > limit || distance <= limit) &&
                (best == close.length || distance < bestDistance)) {
                best = k;
                bestDistance = distance;
            }
        }
        if (best == close.length) {
            break;
        }
        used[best] = true;
        var m = Vector<u8>.create();
        appendBytes(mut m, close[best].view())?;
        chosen.push(m)?;
    }
    return appendNameChoices(message, chosen);
}

/// Adds the name of the struct or enum type `typ` (without its type parameters) to `close` if it is close to `name`,
/// the current file can name it, and it is not there yet.
fn addCloseTypeName(
    c: borrow Checker,
    name: Slice<u8>,
    typ: u32,
    close: borrow mut Vector<Vector<u8>>,
) -> Result<void, AllocError> {
    let full = c.typeName(typ);
    var end = full.length;
    for (k in 0..full.length) {
        if (end == full.length && full[k] == '<') {
            end = k;
        }
    }
    let candidate = full[..end];
    if (!isCloseName(name, candidate)) {
        return Ok();
    }
    let visible = match (c.front.symbols.find(candidate)) {
        Some(s) => match (c.item(s.id)) {
            Entity.Struct(_) => true,
            Entity.Enum(_) => true,
            _ => false,
        },
        null => false,
    };
    if (!visible) {
        return Ok();
    }
    for (k in 0..close.length) {
        if (sameBytes(close[k].view(), candidate)) {
            return Ok();
        }
    }
    var m = Vector<u8>.create();
    appendBytes(mut m, candidate)?;
    return close.push(m);
}

fn appendNameChoices(message: borrow mut Vector<u8>, names: borrow Vector<Vector<u8>>) -> Result<void, AllocError> {
    if (names.length == 0) {
        return Ok();
    }
    appendText(message, "; did you mean ")?;
    for (k in 0..names.length) {
        if (k > 0) {
            appendText(message, if (k + 1 == names.length) " or " else ", ")?;
        }
        message.push('\'')?;
        appendBytes(message, names[k].view())?;
        message.push('\'')?;
    }
    return appendText(message, "?");
}
