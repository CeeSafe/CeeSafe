// Suggestions for a name that does not exist (Suggest): the closest names by edit distance, used by the checker's
// "did you mean" notes and by the MCP server's ceesafe_api. Optimal string alignment distance (insert, delete,
// substitute, swap two neighbours), case-insensitive, over ASCII bytes; names of other bytes compare exactly.

fn lowerByte(b: u8) -> u8 => if (b >= 'A' && b <= 'Z') b + 32 else b;

fn smaller(a: usize, b: usize) -> usize => if (a < b) a else b;

/// The distance between `a` and `b`, or `limit + 1` once it is certainly above `limit` (names are short; the
/// rows are at most 64 bytes, longer names are compared on their first 64).
fn nameDistance(a: Slice<u8>, b: Slice<u8>, limit: usize) -> usize {
    let n = if (a.length < 64) a.length else 64;
    let m = if (b.length < 64) b.length else 64;
    if ((if (n > m) n - m else m - n) > limit) {
        return limit + 1;
    }
    var before = [0usize; 65];   // row i - 2
    var previous = [0usize; 65]; // row i - 1
    var current = [0usize; 65];
    for (j in 0..m + 1) {
        previous[j] = j;
    }
    for (i in 1..n + 1) {
        current[0] = i;
        var smallest = current[0];
        for (j in 1..m + 1) {
            let cost: usize = if (lowerByte(a[i - 1]) == lowerByte(b[j - 1])) 0 else 1;
            // The compiler's own source stays within what its stage 0 accepts (bootstrap/reference.md): no `min`.
            var d = smaller(smaller(previous[j] + 1, current[j - 1] + 1), previous[j - 1] + cost);
            if (i > 1 && j > 1 && lowerByte(a[i - 1]) == lowerByte(b[j - 2]) &&
                lowerByte(a[i - 2]) == lowerByte(b[j - 1])) {
                d = smaller(d, before[j - 2] + 1); // a swap of two neighbours
            }
            current[j] = d;
            smallest = smaller(smallest, d);
        }
        if (smallest > limit) {
            return limit + 1;
        }
        for (j in 0..m + 1) {
            before[j] = previous[j];
            previous[j] = current[j];
        }
    }
    return previous[m];
}

/// Whether `candidate` is a plausible meaning of `wanted`: within a third of its length (at least one edit, at most
/// three), or one contains the other case-insensitively (`unsigned` and `unsignedAbs`).
fn isCloseName(wanted: Slice<u8>, candidate: Slice<u8>) -> bool {
    if (wanted.length == 0 || candidate.length == 0) {
        return false;
    }
    let third = wanted.length / 3;
    let limit: usize = if (third < 1) 1 else if (third > 3) 3 else third;
    if (nameDistance(wanted, candidate, limit) <= limit) {
        return true;
    }
    return wanted.length >= 3 && (containsIgnoringCase(candidate, wanted) || containsIgnoringCase(wanted, candidate) &&
        candidate.length >= 3);
}

/// "; did you mean 'a', 'b' or 'c'?" for `wanted`, a member of struct `definition` that does not exist: its functions
/// (with `functions`) and fields (with `fields`) whose names are close (isCloseName), then its functions whose doc
/// comment mentions the name (`unsigned` finds `decimal`, "Appends an unsigned integer in decimal"). Nothing when
/// none is close. Up to three, in declaration order.
fn appendDidYouMean(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    definition: u32,
    wanted: u32,
    functions: bool,
    fields: bool,
) -> Result<void, AllocError> {
    if (definition == none()) {
        return Ok();
    }
    let name = c.name(wanted);
    var found = Vector<u32>.create();
    let s = borrow c.types.structs[definition as usize];
    if (functions) {
        for (symbol in s.functionNames.view()) {
            if (found.length < 3 && symbol != wanted && isCloseName(
                name,
                c.name(symbol),
            ) && !containsU32(found, symbol)) {
                found.push(symbol)?;
            }
        }
    }
    if (fields) {
        for (field in s.fields.view()) {
            let symbol = c.types.fields[field as usize].name;
            if (found.length < 3 && symbol != wanted && isCloseName(
                name,
                c.name(symbol),
            ) && !containsU32(found, symbol)) {
                found.push(symbol)?;
            }
        }
    }
    if (functions && name.length >= 4) {
        for (k in 0..s.functions.length) {
            let syntax = c.front.ast.functions[c.hir.functions[s.functions[k] as usize].syntax as usize];
            let symbol = s.functionNames[k];
            if (found.length < 3 && syntax.hasDoc && containsIgnoringCase(c.front.ast.textOf(syntax.doc), name) &&
                !containsU32(found, symbol)) {
                found.push(symbol)?;
            }
        }
    }
    if (found.length == 0) {
        // Nothing close: a small type's members are short enough to list (`Environment` has `variable`).
        var count: usize = 0;
        if (functions) {
            count += s.functionNames.length;
        }
        if (fields) {
            count += s.fields.length;
        }
        if (count == 0 || count > 6) {
            return Ok();
        }
        appendText(message, "; it has ")?;
        var k: usize = 0;
        if (functions) {
            for (symbol in s.functionNames.view()) {
                if (k > 0) {
                    appendText(message, if (k + 1 == count) " and " else ", ")?;
                }
                appendQuotedName(message, c, symbol)?;
                k += 1;
            }
        }
        if (fields) {
            for (field in s.fields.view()) {
                if (k > 0) {
                    appendText(message, if (k + 1 == count) " and " else ", ")?;
                }
                appendQuotedName(message, c, c.types.fields[field as usize].name)?;
                k += 1;
            }
        }
        return Ok();
    }
    appendText(message, "; did you mean ")?;
    for (k in 0..found.length) {
        if (k > 0) {
            appendText(message, if (k + 1 == found.length) " or " else ", ")?;
        }
        appendQuotedName(message, c, found[k])?;
    }
    return appendText(message, "?");
}

/// "; did you mean …?" for a member of a built-in type (`Process.args`): the members the built-in types page lists
/// for that type that ApiLookup finds close (ceesafe_api's suggestions), so the error and the tool agree.
fn appendBuiltinDidYouMean(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    typeName: Slice<u8>,
    wanted: u32,
) -> Result<void, AllocError> {
    var query = Vector<u8>.create();
    appendBytes(mut query, typeName)?;
    query.push('.')?;
    appendBytes(mut query, c.name(wanted))?;
    var hits = Vector<ApiHit>.create();
    var suggestions = Vector<Vector<u8>>.create();
    apiLookup(query.view(), mut hits, mut suggestions)?;
    var candidates = Vector<Vector<u8>>.create();
    for (s in suggestions.view()) {
        let name = s.view();
        if (name.length > typeName.length + 1 && name[typeName.length] == '.' &&
            sameBytes(name[0..typeName.length], typeName)) {
            var m = Vector<u8>.create();
            appendBytes(mut m, name[typeName.length + 1..])?;
            candidates.push(m)?;
        }
    }
    // The three best: the longest shared start first (`args` → `argument`), then the fewest edits.
    let wantedName = c.name(wanted);
    var members = Vector<Vector<u8>>.create();
    var used = Vector<bool>.create();
    for (k in 0..candidates.length) {
        used.push(false)?;
    }
    while (members.length < 3) {
        var best = candidates.length;
        var bestPrefix: usize = 0;
        var bestDistance: usize = 0;
        for (k in 0..candidates.length) {
            if (used[k]) {
                continue;
            }
            let prefix = sharedStart(wantedName, candidates[k].view());
            let distance = nameDistance(wantedName, candidates[k].view(), 64);
            if (best == candidates.length || prefix > bestPrefix || (prefix == bestPrefix && distance < bestDistance)) {
                best = k;
                bestPrefix = prefix;
                bestDistance = distance;
            }
        }
        if (best == candidates.length) {
            break;
        }
        used[best] = true;
        var m = Vector<u8>.create();
        appendBytes(mut m, candidates[best].view())?;
        members.push(m)?;
    }
    return appendNameChoices(message, members);
}

/// How many leading bytes `a` and `b` share, ignoring ASCII case.
fn sharedStart(a: Slice<u8>, b: Slice<u8>) -> usize {
    var k: usize = 0;
    while (k < a.length && k < b.length && lowerByte(a[k]) == lowerByte(b[k])) {
        k += 1;
    }
    return k;
}

/// "; did you mean …?" for a method of a number (`x.clamp(…)`): the integer or float methods whose names are close.
fn appendNumberDidYouMean(
    c: borrow Checker,
    message: borrow mut Vector<u8>,
    isFloat: bool,
    wanted: u32,
) -> Result<void, AllocError> {
    let integers =
        "wrappingAdd wrappingSub wrappingMul checkedAdd checkedSub checkedMul saturatingAdd saturatingSub saturatingMul min max abs unsignedAbs";
    let floats = "bits sqrt abs floor ceil min max";
    let list = (if (isFloat) floats else integers).bytes();
    let name = c.name(wanted);
    var members = Vector<Vector<u8>>.create();
    var start: usize = 0;
    for (k in 0..list.length + 1) {
        if (k == list.length || list[k] == ' ') {
            let candidate = list[start..k];
            if (members.length < 3 && isCloseName(name, candidate)) {
                var m = Vector<u8>.create();
                appendBytes(mut m, candidate)?;
                members.push(m)?;
            }
            start = k + 1;
        }
    }
    return appendNameChoices(message, members);
}

fn appendNameChoices(message: borrow mut Vector<u8>, names: borrow Vector<Vector<u8>>) -> Result<void, AllocError> {
    if (names.length == 0) {
        return Ok();
    }
    appendText(message, "; did you mean ")?;
    for (k in 0..names.length) {
        if (k > 0) {
            appendText(message, if (k + 1 == names.length) " or " else ", ")?;
        }
        message.push('\'')?;
        appendBytes(message, names[k].view())?;
        message.push('\'')?;
    }
    return appendText(message, "?");
}
