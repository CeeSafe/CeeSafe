// lib/core's text views in the checker (ADR 0253 §2.6–§2.8): `==` between a `ByteStringView` and a `StringView` or
// another `ByteStringView`, `v[i]` on a `ByteStringView`, a `match` of one with string patterns, and a concrete
// `StringView`'s searches with a needle of any `TextView`. Each is lowered to lib/core calls: no new HIR.

/// Is `t` lib/core's `ByteStringView`?
fn isByteStringViewType(c: borrow Checker, t: u32) -> bool {
    if (t == none() || !c.types.is(t, TypeKind.Struct) || c.types.info(t).structDef == none()) {
        return false;
    }
    let file = c.types.structs[c.types.info(t).structDef as usize].file;
    return file != none() && (file as usize) < c.filePaths.length &&
        startsWithText(c.filePaths[file as usize].view(), "lib/core/") && sameText(c.typeName(t), "ByteStringView");
}

/// The `TextView` method `name` of `typ` (an impl's, or an inherited default), or none.
fn textViewMethod(c: borrow mut Checker, typ: u32, name: StringView) -> Result<u32, AllocError> {
    let symbol = c.intern(name)?;
    return Ok(implMethodFor(c, typ, symbol));
}

/// The bytes of `value`, a `StringView` (its bytes, as a cast) or a `ByteStringView` (its `bytes()`), as a
/// `Slice<u8>`.
fn textViewBytes(c: borrow mut Checker, value: u32, span: Span) -> Result<u32, AllocError> {
    let t = c.typeOf(value);
    let u8Type = c.types.u8;
    let slice = c.types.sliceOf(u8Type, false)?;
    if (c.types.isStringView(t)) {
        let s = c.spanOf(value);
        return c.expr(HirExpr.Cast(value), slice, s.start, s.end);
    }
    let function = textViewMethod(c, t, "bytes")?;
    if (function == none()) {
        return c.errorResult(span.start, span.end);
    }
    let values = [value];
    return libraryCall(c, function, values[..], span);
}

/// Is `t` text that `==` compares with a `ByteStringView` by its bytes: a `StringView`, a `String` or a
/// `ByteStringView` (ADR 0253 §2.6)?
fn isComparedText(c: borrow Checker, t: u32) -> bool =>
    c.types.isStringView(t) || c.types.isString(t) || isByteStringViewType(c, t);

/// `v == t` and `v != t` where one side is a `ByteStringView` and the other a `StringView` (a string literal
/// included), a `String` (its text, lent: not consumed) or a `ByteStringView` (ADR 0253 §2.6): the bytes compared.
/// None for any other operands.
fn textViewEquality(
    c: borrow mut Checker,
    op: BinaryOp,
    leftOperand: u32,
    rightOperand: u32,
    span: Span,
) -> Result<u32, AllocError> {
    // Text read through a reference (`str`, as an optional `String`'s value is) is its view again (sliceOperand).
    let left = sliceOperand(c, leftOperand);
    let right = sliceOperand(c, rightOperand);
    let lt = c.typeOf(left);
    let rt = c.typeOf(right);
    let leftBytes = isByteStringViewType(c, lt);
    let rightBytes = isByteStringViewType(c, rt);
    if (!leftBytes && !rightBytes) {
        return Ok(none());
    }
    if (!isComparedText(c, lt) || !isComparedText(c, rt)) {
        return Ok(none());
    }
    let leftText = if (c.types.isString(lt)) stringText(c, left)? else left;
    let rightText = if (c.types.isString(rt)) stringText(c, right)? else right;
    let l = textViewBytes(c, leftText, span)?;
    let r = textViewBytes(c, rightText, span)?;
    if (c.isBottom(l) || c.isBottom(r)) {
        return c.errorResult(span.start, span.end);
    }
    let boolType = c.types.boolType;
    return c.expr(HirExpr.Binary(op, l, r), boolType, span.start, span.end);
}

/// `v[i]` on a `ByteStringView` (ADR 0253 §2.7): its `byteAt(i)`, a `u8`, panicking past the end as `s[i]` does.
fn byteStringViewIndex(c: borrow mut Checker, target: u32, position: u32, span: Span) -> Result<u32, AllocError> {
    let function = textViewMethod(c, c.typeOf(target), "byteAt")?;
    if (function == none()) {
        return c.errorResult(span.start, span.end);
    }
    let values = [target, position];
    return libraryCall(c, function, values[..], span);
}

/// `"abc"` on a `ByteStringView` inside another pattern (`Some("abc")`, a field's, a payload's; ADR 0253 §2.7): the
/// view's bytes, matched as a `Slice<u8>`'s are, through its field: `ByteStringView { data: "abc" }`. Coverage is a
/// byte slice's.
fn byteStringViewPattern(
    c: borrow mut Checker,
    literal: u32,
    typ: u32,
    reference: u32,
    span: Span,
    failed: borrow mut bool,
) -> Result<u32, AllocError> {
    let definition = c.types.info(typ).structDef;
    let count = c.types.structs[definition as usize].fields.length;
    var trees = Vector<u32>.create();
    var found = false;
    for (i in 0..count) {
        let field = c.types.structs[definition as usize].fields[i];
        let t = c.types.fields[field as usize].typ;
        let target = if (c.types.isSlice(t)) viewTarget(c, t) else none();
        if (!found && target != none() && !c.types.info(target).isStr && c.types.info(target).element == c.types.u8) {
            found = true;
            trees.push(checkStringPattern(c, literal, t, reference, span, failed)?)?;
        } else {
            trees.push(c.hir.addPattern(HirPattern.Wildcard)?)?;
        }
    }
    if (!found) {
        failed = true;
        return c.hir.addPattern(HirPattern.Wildcard);
    }
    let list = c.hir.list(trees.view())?;
    return c.hir.addPattern(HirPattern.Struct(typ, list, false));
}

/// Is `pattern` a string literal, or alternatives or an `@` binding of them only (as `viewPattern` asks)?
fn isStringPatternSyntax(c: borrow Checker, pattern: u32) -> bool {
    match (c.front.ast.patterns[pattern as usize]) {
        PatternNode.Literal(literal) => { return isStringLiteral(c, literal); }
        PatternNode.Or(alternatives) => {
            for (k in 0..alternatives.count) {
                if (!isStringPatternSyntax(c, c.front.ast.at(alternatives, k))) {
                    return false;
                }
            }
            return alternatives.count > 0;
        }
        PatternNode.At(_, inner) => { return isStringPatternSyntax(c, inner); }
        _ => { return false; }
    }
}

/// The interface `TextView`'s entry in the checker, or none.
fn textViewInterface(c: borrow mut Checker) -> Result<u32, AllocError> {
    let symbol = c.intern("TextView")?;
    return Ok(match (foundEntity(c.coreItems, Word { value: symbol as u64 })) {
        Entity.Interface(entry) => entry,
        _ => none(),
    });
}

/// `s.indexOf(t)` and the other searches of a concrete `StringView` (or a `String`'s text, `view`) whose one
/// argument, already checked as `needle`, is a `TextView` other than a `StringView` (ADR 0253 §2.8): `TextView`'s
/// method of the name, with the needle's type, so matches stay whole characters. None when the needle is no such
/// text: the caller then takes it as a `StringView`, as before.
fn otherTextNeedleSearch(
    c: borrow mut Checker,
    name: u32,
    view: u32,
    needle: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let needleType = c.typeOf(needle);
    if (c.types.isStringView(needleType) || c.isBottom(needle)) {
        return Ok(none());
    }
    let entry = textViewInterface(c)?;
    if (entry == none()) {
        return Ok(none());
    }
    let none0 = Vector<u32>.create();
    if (!implementsQualified(c, needleType, entry, none0.view())) {
        return Ok(none());
    }
    let viewType = c.typeOf(view);
    let method = implMethodIn(c, viewType, name, entry);
    if (method == none()) {
        return Ok(none());
    }
    let template = c.hir.functions[method as usize].methodTemplate;
    if (template == none()) {
        return Ok(none());
    }
    let arguments = [needleType];
    let instance = instantiateFunction(c, template, arguments[..], span)?;
    if (instance == none()) {
        return c.errorResult(span.start, span.end);
    }
    let values = [view, needle];
    return libraryCall(c, instance, values[..], span);
}
