// Exhaustiveness and unreachable arms for nested patterns (the reference's PatternUsefulness, M11, type-system.md
// §15.2): the usefulness algorithm of Maranget, "Warnings for pattern matching" (2007). A pattern vector is useful
// against a matrix of earlier rows when some value matches it and no earlier row. The constructors of a type are its
// enum's variants, `true`/`false`, or, for an integer, intervals of its values (ADR 0085 §2.4): a literal is a
// one-value interval, a range its own, and a column of integers is split into the intervals its rows' bounds define,
// so that literals and ranges together can cover the type. Patterns are ids in the HIR's pattern table; a matrix is
// its rows' cells, row after row.

/// A constructor: a variant, or the integers `value..=high` (one literal: value == high; 0 and 1 for bool).
struct Constructor {
    isVariant: bool;
    variant: u32;
    value: IntValue;
    high: IntValue;
    arity: usize;
}

struct Matrix {
    cells: Vector<u32>;
    rows: usize;
    width: usize;
}

fn sameConstructor(a: Constructor, b: Constructor) -> bool =>
    a.isVariant == b.isVariant &&
        (if (a.isVariant) a.variant == b.variant else sameInt(a.value, b.value) && sameInt(a.high, b.high));

fn containsConstructor(list: borrow Vector<Constructor>, k: Constructor) -> bool {
    for (x in list.view()) {
        if (sameConstructor(x, k)) {
            return true;
        }
    }
    return false;
}

/// A value that matches `pattern` and none of `earlier`, written as a pattern into `out`; false if there is none
/// (Witness).
fn patternWitness(
    c: borrow mut Checker,
    earlier: Slice<u32>,
    pattern: u32,
    typ: u32,
    out: borrow mut Vector<u8>,
) -> Result<bool, AllocError> {
    let wildcard = c.hir.addPattern(HirPattern.Wildcard)?;
    var rows = Matrix { cells: Vector<u32>.create(), rows: earlier.length, width: 1 };
    for (p in earlier) {
        rows.cells.push(p)?;
    }
    var q = Vector<u32>.create();
    q.push(pattern)?;
    var types = Vector<u32>.create();
    types.push(typ)?;
    var witness = Vector<Vector<u8>>.create();
    if (!useful(c, wildcard, rows, q.view(), types.view(), mut witness)?) {
        return Ok(false);
    }
    appendBytes(out, witness[0].view())?;
    return Ok(true);
}

/// The constructor a pattern names, or false for `_` and bindings (ConstructorOf).
fn constructorOf(c: borrow Checker, pattern: u32, found: borrow mut Constructor) -> bool {
    match (c.hir.patterns[testedPattern(c, pattern) as usize]) {
        HirPattern.Variant(variant, _, _) => {
            found = Constructor {
                isVariant: true,
                variant: variant,
                value: intValue(0),
                high: intValue(0),
                arity: payloadCount(c, variant),
            };
            return true;
        }
        HirPattern.Literal(value) => {
            found = Constructor { isVariant: false, variant: none(), value: value, high: value, arity: 0 };
            return true;
        }
        HirPattern.Range(low, high) => {
            found = Constructor { isVariant: false, variant: none(), value: low, high: high, arity: 0 };
            return true;
        }
        _ => { return false; }
    }
}

fn noConstructor() -> Constructor => Constructor {
    isVariant: false,
    variant: none(),
    value: intValue(0),
    high: intValue(0),
    arity: 0,
};

/// A pattern's arguments for its constructor: its payload patterns, or `_` for each without a list (Arguments).
fn pushArguments(
    c: borrow Checker,
    wildcard: u32,
    pattern: u32,
    k: Constructor,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    match (c.hir.patterns[testedPattern(c, pattern) as usize]) {
        HirPattern.Variant(_, hasPayload, payload) => {
            if (hasPayload) {
                for (i in 0..payload.count) {
                    out.push(c.hir.at(payload, i))?;
                }
                return Ok();
            }
        }
        _ => {}
    }
    return pushWildcards(wildcard, k.arity, out);
}

fn pushWildcards(wildcard: u32, count: usize, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    for (unused in 0..count) {
        out.push(wildcard)?;
    }
    return Ok();
}

/// The payload types of a constructor (ArgumentTypes).
fn pushArgumentTypes(c: borrow Checker, k: Constructor, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    if (k.isVariant) {
        for (i in 0..k.arity) {
            out.push(payloadType(c, k.variant, i))?;
        }
    }
    return Ok();
}

/// Every constructor of the type when there are finitely many; false for integers and other types (AllConstructors).
fn allConstructors(c: borrow Checker, typ: u32, out: borrow mut Vector<Constructor>) -> Result<bool, AllocError> {
    if (c.types.is(typ, TypeKind.Enum)) {
        let definition = c.types.info(typ).enumDef;
        let count = c.types.enums[definition as usize].variants.length;
        for (k in 0..count) {
            let v = variantAt(c, typ, k);
            out.push(
                Constructor {
                    isVariant: true,
                    variant: v,
                    value: intValue(0),
                    high: intValue(0),
                    arity: payloadCount(c, v),
                },
            )?;
        }
        return Ok(true);
    }
    if (c.types.is(typ, TypeKind.Bool)) {
        out.push(Constructor { isVariant: false, variant: none(), value: intValue(0), high: intValue(0), arity: 0 })?;
        out.push(Constructor { isVariant: false, variant: none(), value: intValue(1), high: intValue(1), arity: 0 })?;
        return Ok(true);
    }
    return Ok(false);
}

/// The rows whose first pattern can match `k`, with that pattern replaced by its arguments (Specialize).
fn specialize(c: borrow Checker, wildcard: u32, rows: borrow Matrix, k: Constructor) -> Result<Matrix, AllocError> {
    var result = Matrix { cells: Vector<u32>.create(), rows: 0, width: k.arity + rows.width - 1 };
    for (r in 0..rows.rows) {
        let first = rows.cells[r * rows.width];
        var firstConstructor = noConstructor();
        if (!constructorOf(c, first, mut firstConstructor)) {
            pushWildcards(wildcard, k.arity, mut result.cells)?;
        } else if (sameConstructor(firstConstructor, k)) {
            pushArguments(c, wildcard, first, firstConstructor, mut result.cells)?;
        } else {
            continue;
        }
        for (i in 1..rows.width) {
            result.cells.push(rows.cells[r * rows.width + i])?;
        }
        result.rows += 1;
    }
    return Ok(result);
}

/// The pattern a first column tests, looking through what does not change the test: `name @ P` tests P.
fn testedPattern(c: borrow Checker, pattern: u32) -> u32 {
    var p = pattern;
    loop {
        match (c.hir.patterns[p as usize]) {
            HirPattern.At(_, inner) => { p = inner; }
            _ => { return p; }
        }
    }
}

/// Does any row start with an or-pattern?
fn hasOrRow(c: borrow Checker, rows: borrow Matrix) -> bool {
    for (r in 0..rows.rows) {
        match (c.hir.patterns[testedPattern(c, rows.cells[r * rows.width]) as usize]) {
            HirPattern.Or(_) => { return true; }
            _ => {}
        }
    }
    return false;
}

/// The rows with each or-pattern in the first column replaced by one row per alternative (ADR 0085 §2.3).
fn expandOrRows(c: borrow Checker, rows: borrow Matrix, out: borrow mut Matrix) -> Result<void, AllocError> {
    for (r in 0..rows.rows) {
        pushExpandedRow(c, rows, r, rows.cells[r * rows.width], out)?;
    }
    return Ok();
}

fn pushExpandedRow(
    c: borrow Checker,
    rows: borrow Matrix,
    r: usize,
    first: u32,
    out: borrow mut Matrix,
) -> Result<void, AllocError> {
    match (c.hir.patterns[testedPattern(c, first) as usize]) {
        HirPattern.Or(alternatives) => {
            for (k in 0..alternatives.count) {
                pushExpandedRow(c, rows, r, c.hir.at(alternatives, k), out)?;
            }
            return Ok();
        }
        _ => {}
    }
    out.cells.push(first)?;
    for (i in 1..rows.width) {
        out.cells.push(rows.cells[r * rows.width + i])?;
    }
    out.rows += 1;
    return Ok();
}

/// Useful: is `q` useful against `rows`? If so, `witness` gets a value per column that shows it.
fn useful(
    c: borrow Checker,
    wildcard: u32,
    rows: borrow Matrix,
    q: Slice<u32>,
    types: Slice<u32>,
    witness: borrow mut Vector<Vector<u8>>,
) -> Result<bool, AllocError> {
    if (q.length == 0) {
        return Ok(rows.rows == 0);
    }
    if (rows.width > 0 && hasOrRow(c, rows)) {
        var expanded = Matrix { cells: Vector<u32>.create(), rows: 0, width: rows.width };
        expandOrRows(c, rows, mut expanded)?;
        return useful(c, wildcard, expanded, q, types, witness);
    }
    match (c.hir.patterns[testedPattern(c, q[0]) as usize]) {
        HirPattern.Or(alternatives) => {
            // Useful when some alternative is.
            for (k in 0..alternatives.count) {
                var nq = Vector<u32>.create();
                nq.push(c.hir.at(alternatives, k))?;
                appendU32s(mut nq, q[1..])?;
                var inner = Vector<Vector<u8>>.create();
                if (useful(c, wildcard, rows, nq.view(), types, mut inner)?) {
                    for (i in 0..inner.length) {
                        witness.push(copyBytes(inner[i].view())?)?;
                    }
                    return Ok(true);
                }
            }
            return Ok(false);
        }
        _ => {}
    }
    let typ = types[0];
    if (c.types.is(typ, TypeKind.Integer)) {
        return usefulInteger(c, wildcard, rows, q, types, witness);
    }
    var head = noConstructor();
    if (constructorOf(c, q[0], mut head)) {
        var nq = Vector<u32>.create();
        pushArguments(c, wildcard, q[0], head, mut nq)?;
        appendU32s(mut nq, q[1..])?;
        var nt = Vector<u32>.create();
        pushArgumentTypes(c, head, mut nt)?;
        appendU32s(mut nt, types[1..])?;
        let specialized = specialize(c, wildcard, rows, head)?;
        var inner = Vector<Vector<u8>>.create();
        if (!useful(c, wildcard, specialized, nq.view(), nt.view(), mut inner)?) {
            return Ok(false);
        }
        rebuild(c, head, typ, inner, witness)?;
        return Ok(true);
    }
    var used = Vector<Constructor>.create();
    for (r in 0..rows.rows) {
        var k = noConstructor();
        if (constructorOf(c, rows.cells[r * rows.width], mut k) && !containsConstructor(used, k)) {
            used.push(k)?;
        }
    }
    var all = Vector<Constructor>.create();
    let finite = allConstructors(c, typ, mut all)?;
    var complete = finite;
    for (k in all.view()) {
        if (!containsConstructor(used, k)) {
            complete = false;
        }
    }
    if (complete) {
        for (k in all.view()) {
            var nq = Vector<u32>.create();
            pushWildcards(wildcard, k.arity, mut nq)?;
            appendU32s(mut nq, q[1..])?;
            var nt = Vector<u32>.create();
            pushArgumentTypes(c, k, mut nt)?;
            appendU32s(mut nt, types[1..])?;
            let specialized = specialize(c, wildcard, rows, k)?;
            var inner = Vector<Vector<u8>>.create();
            if (useful(c, wildcard, specialized, nq.view(), nt.view(), mut inner)?) {
                rebuild(c, k, typ, inner, witness)?;
                return Ok(true);
            }
        }
        return Ok(false);
    }
    // The rows that match anything here, without their first column.
    var rest = Matrix { cells: Vector<u32>.create(), rows: 0, width: rows.width - 1 };
    for (r in 0..rows.rows) {
        var k = noConstructor();
        if (!constructorOf(c, rows.cells[r * rows.width], mut k)) {
            for (i in 1..rows.width) {
                rest.cells.push(rows.cells[r * rows.width + i])?;
            }
            rest.rows += 1;
        }
    }
    var inner = Vector<Vector<u8>>.create();
    if (!useful(c, wildcard, rest, q[1..], types[1..], mut inner)?) {
        return Ok(false);
    }
    // A constructor no row names, if the type has a finite set; otherwise any value.
    var first = Vector<u8>.create();
    var missing = false;
    for (k in all.view()) {
        if (!missing && !containsConstructor(used, k)) {
            var arguments = Vector<Vector<u8>>.create();
            for (unused in 0..k.arity) {
                var underscore = Vector<u8>.create();
                underscore.push('_')?;
                arguments.push(underscore)?;
            }
            renderConstructor(c, k, typ, arguments, 0, k.arity, mut first)?;
            missing = true;
        }
    }
    if (!missing) {
        first.push('_')?;
    }
    witness.push(first)?;
    for (i in 0..inner.length) {
        witness.push(copyBytes(inner[i].view())?)?;
    }
    return Ok(true);
}

fn appendU32s(out: borrow mut Vector<u32>, values: Slice<u32>) -> Result<void, AllocError> {
    for (v in values) {
        out.push(v)?;
    }
    return Ok();
}

/// The constructor applied to the witness's first `arity` values, then the rest (Rebuild).
fn rebuild(
    c: borrow Checker,
    k: Constructor,
    typ: u32,
    inner: borrow Vector<Vector<u8>>,
    witness: borrow mut Vector<Vector<u8>>,
) -> Result<void, AllocError> {
    var first = Vector<u8>.create();
    renderConstructor(c, k, typ, inner, 0, k.arity, mut first)?;
    witness.push(first)?;
    for (i in k.arity..inner.length) {
        witness.push(copyBytes(inner[i].view())?)?;
    }
    return Ok();
}

/// A constructor with the arguments `arguments[from..to]`, as a pattern writes it (Render).
fn renderConstructor(
    c: borrow Checker,
    k: Constructor,
    typ: u32,
    arguments: borrow Vector<Vector<u8>>,
    from: usize,
    to: usize,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    if (k.isVariant) {
        appendVariantText(out, c, k.variant, typ)?;
        if (to > from) {
            out.push('(')?;
            for (i in from..to) {
                if (i > from) {
                    appendText(out, ", ")?;
                }
                appendBytes(out, arguments[i].view())?;
            }
            out.push(')')?;
        }
        return Ok();
    }
    if (c.types.is(typ, TypeKind.Bool)) {
        return appendText(out, if (k.value.magnitude != 0) "true" else "false");
    }
    return appendIntegerWitness(c, typ, k.value, out);
}

/// An integer as a witness names it: a printable ASCII byte of a `u8` as a character literal (`'{'`), else decimal.
fn appendIntegerWitness(
    c: borrow Checker,
    typ: u32,
    value: IntValue,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    let info = c.types.info(typ);
    if (info.bits == 8 && !info.signed && value.magnitude >= 0x20 && value.magnitude <= 0x7E) {
        out.push('\'')?;
        let byte = truncate<u8>(value.magnitude);
        if (byte == '\'' || byte == '\\') {
            out.push('\\')?;
        }
        out.push(byte)?;
        return out.push('\'');
    }
    return appendIntValue(out, value);
}

// ---- integers as intervals (ADR 0085 §2.4) ----

/// The smallest value of an integer type.
fn integerBottom(c: borrow Checker, typ: u32) -> IntValue {
    let info = c.types.info(typ);
    if (!info.signed) {
        return intValue(0);
    }
    return IntValue { negative: true, magnitude: (1u64) << ((info.bits - 1) as u64) };
}

/// The largest value of an integer type.
fn integerTop(c: borrow Checker, typ: u32) -> IntValue {
    let info = c.types.info(typ);
    let bits = if (info.signed) info.bits - 1 else info.bits;
    if (bits >= 64) {
        return IntValue { negative: false, magnitude: 0xFFFF_FFFF_FFFF_FFFFu64 };
    }
    return IntValue { negative: false, magnitude: ((1u64) << (bits as u64)) - 1 };
}

/// v + 1 (never called on the type's largest value).
fn intSuccessor(v: IntValue) -> IntValue {
    if (v.negative && v.magnitude != 0) {
        return IntValue { negative: v.magnitude != 1, magnitude: v.magnitude - 1 };
    }
    return IntValue { negative: false, magnitude: v.magnitude + 1 };
}

/// v - 1 (never called on the type's smallest value).
fn intPredecessor(v: IntValue) -> IntValue {
    if (v.negative || v.magnitude == 0) {
        return IntValue { negative: true, magnitude: v.magnitude + 1 };
    }
    return IntValue { negative: false, magnitude: v.magnitude - 1 };
}

/// Does `outer` (an interval) contain all of `inner`?
fn covers(outer: Constructor, inner: Constructor) -> bool =>
    compareIntValues(outer.value, inner.value) <= 0 && compareIntValues(inner.high, outer.high) <= 0;

fn insertBoundary(points: borrow mut Vector<IntValue>, v: IntValue) -> Result<void, AllocError> {
    var at = points.length;
    for (i in 0..points.length) {
        let order = compareIntValues(points[i], v);
        if (order == 0) {
            return Ok();
        }
        if (order > 0) {
            at = i;
            break;
        }
    }
    points.push(v)?;
    var i = points.length - 1;
    while (i > at) {
        points[i] = points[i - 1];
        i -= 1;
    }
    points[at] = v;
    return Ok();
}

/// `whole` split into the intervals the first column's literals and ranges bound: within each piece, every row's
/// interval contains it or misses it.
fn splitIntervals(
    c: borrow Checker,
    rows: borrow Matrix,
    whole: Constructor,
    out: borrow mut Vector<Constructor>,
) -> Result<void, AllocError> {
    var points = Vector<IntValue>.create();
    points.push(whole.value)?;
    for (r in 0..rows.rows) {
        var k = noConstructor();
        if (!constructorOf(c, rows.cells[r * rows.width], mut k)) {
            continue;
        }
        if (compareIntValues(k.high, whole.value) < 0 || compareIntValues(k.value, whole.high) > 0) {
            continue;
        }
        if (compareIntValues(k.value, whole.value) > 0) {
            insertBoundary(mut points, k.value)?;
        }
        if (compareIntValues(k.high, whole.high) < 0) {
            insertBoundary(mut points, intSuccessor(k.high))?;
        }
    }
    for (i in 0..points.length) {
        let high = if (i + 1 < points.length) intPredecessor(points[i + 1]) else whole.high;
        out.push(Constructor { isVariant: false, variant: none(), value: points[i], high: high, arity: 0 })?;
    }
    return Ok();
}

/// The rows that match every value of `piece` in their first column, without it.
fn specializeInterval(c: borrow Checker, rows: borrow Matrix, piece: Constructor) -> Result<Matrix, AllocError> {
    var result = Matrix { cells: Vector<u32>.create(), rows: 0, width: rows.width - 1 };
    for (r in 0..rows.rows) {
        var k = noConstructor();
        if (constructorOf(c, rows.cells[r * rows.width], mut k) && !covers(k, piece)) {
            continue;
        }
        for (i in 1..rows.width) {
            result.cells.push(rows.cells[r * rows.width + i])?;
        }
        result.rows += 1;
    }
    return Ok(result);
}

/// Useful for an integer column: the interval `q` names (or the whole type for `_`), split by the rows' bounds; `q`
/// is useful when it is for some piece, and the lowest such piece's first value is the witness.
fn usefulInteger(
    c: borrow Checker,
    wildcard: u32,
    rows: borrow Matrix,
    q: Slice<u32>,
    types: Slice<u32>,
    witness: borrow mut Vector<Vector<u8>>,
) -> Result<bool, AllocError> {
    let typ = types[0];
    var whole = Constructor {
        isVariant: false,
        variant: none(),
        value: integerBottom(c, typ),
        high: integerTop(c, typ),
        arity: 0,
    };
    var named = noConstructor();
    if (constructorOf(c, q[0], mut named)) {
        whole = named;
    }
    var pieces = Vector<Constructor>.create();
    splitIntervals(c, rows, whole, mut pieces)?;
    for (piece in pieces.view()) {
        let specialized = specializeInterval(c, rows, piece)?;
        var inner = Vector<Vector<u8>>.create();
        if (useful(c, wildcard, specialized, q[1..], types[1..], mut inner)?) {
            var first = Vector<u8>.create();
            appendIntegerWitness(c, typ, piece.value, mut first)?;
            witness.push(first)?;
            for (i in 0..inner.length) {
                witness.push(copyBytes(inner[i].view())?)?;
            }
            return Ok(true);
        }
    }
    return Ok(false);
}
