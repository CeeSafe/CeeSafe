// Each diagnostic code's meaning, as the reference's DiagnosticCatalog finds it in its embedded documents (the JSON
// "summary", tooling.md §5.1). GENERATED by tools/gen_catalog.py from CeeSafe's spec/: rerun it, do not edit.

/// The meaning of code N`number`, or "" for a code no document lists.
fn summaryOf(number: u32) -> StringView => match (number) {
    1 => "Unexpected character (including non-ASCII outside literals and comments)",
    2 => "*(unassigned)*",
    3 => "Unterminated block comment",
    4 => "Integer literal does not fit in 64 bits",
    5 => "Unterminated string literal (newline or EOF before `\"`)",
    6 =>
        "Invalid escape sequence, or `\\u{...}` that is not a Unicode scalar value; a NUL byte in a `c\"…\"`, or in the left operand of a constant `+` whose right operand is one (ADR 0087 §2.4, §2.7)",
    7 => "Invalid char literal: empty, more than one character, or unterminated",
    8 => "Invalid digit for the radix, or no digits after a radix prefix",
    9 => "Unknown literal suffix",
    10 => "Misplaced digit separator `_` (must sit between two digits)",
    11 =>
        "A raw `\"\"\"` string literal laid out wrongly: text after the opening `\"\"\"` on its line, or a content line that is not blank and is indented less than the closing `\"\"\"` (`grammar.md` §1.6, ADR 0074 §2.6)",
    100 => "Expected a specific token",
    101 => "Expected an item (`fn` or `const`) at the top level",
    102 => "Expected an expression",
    103 => "Comparison operators chained",
    104 => "Invalid assignment target",
    105 =>
        "Expected a type, or `Self` where it names no type (outside an interface, an `impl` or a struct's or enum's body, ADR 0086 §2.2)",
    106 => "Namespace declaration not first in the file",
    107 =>
        "Expected a field or `fn` inside a struct body; an imported union with no member, or a union inside an anonymous union member (ADR 0041 §3.2)",
    108 =>
