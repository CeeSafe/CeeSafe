// Diagnostics (the reference's Diagnostics/Diagnostic.cs) and their JSON document (Tooling/DiagnosticJson.cs;
// tooling.md §5.1). A code is kept as its number (N0001 is 1). Spans are byte offsets into the file's SourceText; the
// JSON's positions are the reference's (1-based lines, UTF-16 columns). A diagnostic has at most one fix with one edit
// in its own file, which is all the frontend makes (the parser's "insert ';'"); notes, and the fuller fixes of later
// passes, come with those passes (P3, P4).

// Codes the frontend reports (Diagnostic.cs's DiagnosticCodes).
fn unexpectedCharacter() -> u32 => 1;
fn unterminatedBlockComment() -> u32 => 3;
fn integerLiteralTooLarge() -> u32 => 4;
fn unterminatedString() -> u32 => 5;
fn invalidEscape() -> u32 => 6;
fn invalidCharLiteral() -> u32 => 7;
fn invalidDigit() -> u32 => 8;
fn invalidLiteralSuffix() -> u32 => 9;
fn misplacedDigitSeparator() -> u32 => 10;
fn rawStringLayout() -> u32 => 11;
fn expectedToken() -> u32 => 100;
fn expectedItem() -> u32 => 101;
fn expectedExpression() -> u32 => 102;
fn chainedComparison() -> u32 => 103;
fn invalidAssignmentTarget() -> u32 => 104;
fn expectedType() -> u32 => 105;
fn misplacedNamespace() -> u32 => 106;
fn expectedMember() -> u32 => 107;
fn expectedPattern() -> u32 => 108;
fn misplacedImport() -> u32 => 109;
fn nestingTooDeep() -> u32 => 110;
fn unsupported() -> u32 => 216;
fn duplicateMember() -> u32 => 228;
fn invalidAttribute() -> u32 => 290;

struct Diagnostic {
    code: u32;
    isError: bool;
    file: u32; // the index of the SourceText in the compilation's list
    start: u32;
    end: u32;
    message: Vector<u8>;
    hasFix: bool;
    fixTitle: Vector<u8>;
    fixStart: u32;
    fixEnd: u32;
    fixText: Vector<u8>;
    hasSecondEdit: bool; // a fix of two edits in the same file, applied together
    secondStart: u32;
    secondEnd: u32;
    secondText: Vector<u8>;
    notes: Vector<DiagnosticNote>;
}

/// A note on a diagnostic (DiagnosticNote): in the diagnostic's file, or in another one, as N0201's note at the other
/// package's declaration (ADR 0081 §2.2).
struct DiagnosticNote {
    file: u32; // the index of its SourceText, as Diagnostic.file
    start: u32;
    end: u32;
    message: Vector<u8>;
}

/// Diagnostics in the order they are reported (DiagnosticBag).
struct Diagnostics {
    items: Vector<Diagnostic>;

    fn create() -> Diagnostics => Diagnostics { items: Vector<Diagnostic>.create() };

    fn error(
        borrow mut this,
        code: u32,
        file: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
    ) -> Result<void, AllocError> {
        this.items.push(Diagnostic {
            code: code,
            isError: true,
            file: file,
            start: start,
            end: end,
            message: message,
            hasFix: false,
            fixTitle: Vector<u8>.create(),
            fixStart: 0,
            fixEnd: 0,
            fixText: Vector<u8>.create(),
            hasSecondEdit: false,
            secondStart: 0,
            secondEnd: 0,
            secondText: Vector<u8>.create(),
            notes: Vector<DiagnosticNote>.create(),
        })?;
        return Ok();
    }

    /// A warning (ADR 0073 §2.4): reported like an error, but it never makes a command fail.
    fn warning(
        borrow mut this,
        code: u32,
        file: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
    ) -> Result<void, AllocError> {
        this.error(code, file, start, end, message)?;
        this.items[this.items.length - 1].isError = false;
        return Ok();
    }

    /// An error with a fix that replaces [start, end) of the same file with `fixText`.
    fn errorWithFix(
        borrow mut this,
        code: u32,
        file: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
        fixTitle: Vector<u8>,
        fixText: Vector<u8>,
    ) -> Result<void, AllocError> {
        this.items.push(Diagnostic {
            code: code,
            isError: true,
            file: file,
            start: start,
            end: end,
            message: message,
            hasFix: true,
            fixTitle: fixTitle,
            fixStart: start,
            fixEnd: end,
            fixText: fixText,
            hasSecondEdit: false,
            secondStart: 0,
            secondEnd: 0,
            secondText: Vector<u8>.create(),
            notes: Vector<DiagnosticNote>.create(),
        })?;
        return Ok();
    }

    /// An error with a fix that replaces [fixStart, fixEnd) of the same file with `fixText`.
    fn errorWithEdit(
        borrow mut this,
        code: u32,
        file: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
        fixTitle: Vector<u8>,
        fixStart: u32,
        fixEnd: u32,
        fixText: Vector<u8>,
    ) -> Result<void, AllocError> {
        this.items.push(Diagnostic {
            code: code,
            isError: true,
            file: file,
            start: start,
            end: end,
            message: message,
            hasFix: true,
            fixTitle: fixTitle,
            fixStart: fixStart,
            fixEnd: fixEnd,
            fixText: fixText,
            hasSecondEdit: false,
            secondStart: 0,
            secondEnd: 0,
            secondText: Vector<u8>.create(),
            notes: Vector<DiagnosticNote>.create(),
        })?;
        return Ok();
    }

    /// An error with a fix of two edits: [fixStart, fixEnd) and [secondStart, secondEnd) replaced.
    fn errorWithTwoEdits(
        borrow mut this,
        code: u32,
        file: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
        fixTitle: Vector<u8>,
        fixStart: u32,
        fixText: Vector<u8>,
        secondStart: u32,
        secondEnd: u32,
        secondText: Vector<u8>,
    ) -> Result<void, AllocError> {
        this.items.push(Diagnostic {
            code: code,
            isError: true,
            file: file,
            start: start,
            end: end,
            message: message,
            hasFix: true,
            fixTitle: fixTitle,
            fixStart: fixStart,
            fixEnd: fixStart,
            fixText: fixText,
            hasSecondEdit: true,
            secondStart: secondStart,
            secondEnd: secondEnd,
            secondText: secondText,
            notes: Vector<DiagnosticNote>.create(),
        })?;
        return Ok();
    }

    /// An error with notes (DiagnosticBag.Error with notes).
    fn errorWithNotes(
        borrow mut this,
        code: u32,
        file: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
        notes: Vector<DiagnosticNote>,
    ) -> Result<void, AllocError> {
        this.error(code, file, start, end, message)?;
        let last = this.items.length - 1;
        this.items[last].notes = notes;
        return Ok();
    }

    /// Removes the diagnostics in the files `remove` marks, keeping the others' order.
    fn removeFiles(borrow mut this, remove: Slice<bool>) {
        var kept: usize = 0;
        for (i in 0..this.items.length) {
            let file = this.items[i].file;
            if ((file as usize) < remove.length && remove[file as usize]) {
                continue;
            }
            if (kept != i) {
                this.items.swap(kept, i);
            }
            kept += 1;
        }
        this.items.truncate(kept);
    }

    /// Is the diagnostic at `index` reported already by one before `before`: the same code at the same place, and with
    /// `sameMessage` the same message too?
    fn isRepeat(borrow this, index: usize, before: usize, sameMessage: bool) -> bool {
        let d = borrow this.items[index];
        for (i in 0..before) {
            let e = borrow this.items[i];
            if (e.code == d.code && e.start == d.start && e.end == d.end && e.file == d.file &&
                e.isError == d.isError && (!sameMessage || sameBytes(e.message.view(), d.message.view()))) {
                return true;
            }
        }
        return false;
    }

    /// Of the diagnostics from `mark` on, keeps the ones of code `always` and, with `news`, the ones no diagnostic
    /// before `declared` reports already (the same code at the same place: one fault in generic code, met again in an
    /// instance). The others are removed, and so are the new ones when one of code `always` is among them: they follow
    /// from it. Returns whether a kept one is an error that is not of code `always`.
    fn keepSince(borrow mut this, mark: usize, always: u32, news: bool, declared: usize) -> bool {
        var kept = mark;
        var newError = false;
        var keepNews = news;
        for (i in mark..this.items.length) {
            if (this.items[i].code == always) {
                keepNews = false;
            }
        }
        for (i in mark..this.items.length) {
            let isAlways = this.items[i].code == always;
            if (!isAlways && (!keepNews || this.isRepeat(i, if (declared < mark) declared else mark, false))) {
                continue;
            }
            if (isAlways && this.isRepeat(i, kept, false)) {
                continue; // one place, one such diagnostic, whatever limit was met there
            }
            if (!isAlways && this.items[i].isError) {
                newError = true;
            }
            if (kept != i) {
                this.items.swap(kept, i);
            }
            kept += 1;
        }
        this.items.truncate(kept);
        return newError;
    }

    /// If a diagnostic from `mark` on is of code `code`, removes the others from `mark` on: they follow from it.
    fn keepCause(borrow mut this, mark: usize, code: u32) {
        var found = false;
        for (i in mark..this.items.length) {
            if (this.items[i].code == code) {
                found = true;
            }
        }
        if (found) {
            this.keepSince(mark, code, false, mark);
        }
    }

    /// Removes each diagnostic that repeats an earlier one in code, place and message: it is one finding.
    fn removeRepeats(borrow mut this) {
        var kept: usize = 0;
        for (i in 0..this.items.length) {
            if (this.isRepeat(i, kept, true)) {
                continue;
            }
            if (kept != i) {
                this.items.swap(kept, i);
            }
            kept += 1;
        }
        this.items.truncate(kept);
    }

    /// Whether any diagnostic so far is in `file`.
    fn anyIn(borrow this, file: u32) -> bool {
        for (i in 0..this.items.length) {
            if (this.items[i].file == file) {
                return true;
            }
        }
        return false;
    }

    /// --deny-warnings (ADR 0073 §2.4): every warning becomes an error.
    fn denyWarnings(borrow mut this) {
        for (i in 0..this.items.length) {
            this.items[i].isError = true;
        }
    }

    fn hasErrors(borrow this) -> bool {
        for (i in 0..this.items.length) {
            if (this.items[i].isError) {
                return true;
            }
        }
        return false;
    }

    fn count(borrow this, errors: bool) -> i64 {
        var n: i64 = 0;
        for (i in 0..this.items.length) {
            if (this.items[i].isError == errors) {
                n += 1;
            }
        }
        return n;
    }
}

/// "N0001" for 1.
fn appendCode(target: borrow mut Vector<u8>, code: u32) -> Result<void, AllocError> {
    target.push('N')?;
    var digits = Vector<u8>.create();
    appendDecimal(mut digits, code as u64)?;
    for (k in digits.length..4) {
        target.push('0')?;
    }
    appendBytes(target, digits.view())?;
    return Ok();
}

fn writePosition(
    json: borrow mut JsonWriter,
    label: StringView,
    source: borrow SourceText,
    offset: u32,
) -> Result<void, AllocError> {
    let p = source.position(offset as usize);
    json.name(label)?;
    json.startObject()?;
    json.name("line")?;
    json.number(p.line as i64)?;
    json.name("column")?;
    json.number(p.column as i64)?;
    json.endObject()?;
    return Ok();
}

/// A blank source named `<library>` as long as `d` needs: what a diagnostic is shown with when its file is not among
/// the compilation's sources (bug B6: an error in a library function's instance, reported in its library file, crashed
/// the printers).
fn placeholderSource(d: borrow Diagnostic) -> Result<SourceText, AllocError> {
    var blank = Vector<u8>.create();
    let end = if (d.fixEnd > d.end) d.fixEnd else d.end;
    for (k in 0..(end as usize + 1)) {
        blank.push(' ')?;
    }
    return SourceText.create("<library>".bytes(), blank.view());
}

/// The whole JSON document for `diagnostics`, on one line (DiagnosticJson.Serialize).
fn diagnosticsJson(
    diagnostics: borrow Diagnostics,
    sources: borrow Vector<SourceText>,
) -> Result<Vector<u8>, AllocError> {
    var json = JsonWriter.create();
    json.startObject()?;
    json.name("version")?;
    json.number(1)?;
    json.name("errors")?;
    json.number(diagnostics.count(true))?;
    json.name("warnings")?;
    json.number(diagnostics.count(false))?;
    json.name("diagnostics")?;
    json.startArray()?;
    for (i in 0..diagnostics.items.length) {
        writeJsonDiagnostic(mut json, diagnostics.items[i], sources)?;
    }
    json.endArray()?;
    json.endObject()?;
    return Ok(json.out);
}

/// One diagnostic of the document (tooling.md §5.1), in `sources`.
fn writeJsonDiagnostic(
    json: borrow mut JsonWriter,
    d: borrow Diagnostic,
    sources: borrow Vector<SourceText>,
) -> Result<void, AllocError> {
    let placeholder = placeholderSource(d)?;
    let source = if ((d.file as usize) < sources.length) borrow sources[d.file as usize] else borrow placeholder;
    json.startObject()?;
    json.name("code")?;
    var code = Vector<u8>.create();
    appendCode(mut code, d.code)?;
    json.stringBytes(code.view())?;
    json.name("severity")?;
    json.string(if (d.isError) "error" else "warning")?;
    json.name("file")?;
    json.stringBytes(source.shownPath())?;
    if (source.package.length > 0) {
        // A file's package in package mode (ADR 0082 §2.1): which of a build's packages to open.
        json.name("package")?;
        json.stringBytes(source.package.view())?;
    }
    writePosition(mut json, "start", source, d.start)?;
    writePosition(mut json, "end", source, d.end)?;
    json.name("message")?;
    json.stringBytes(d.message.view())?;
    json.name("summary")?;
    json.string(summaryOf(d.code))?;
    json.name("notes")?;
    json.startArray()?;
    for (note in d.notes.view()) {
        let noteSource =
            if (note.file != d.file && (note.file as usize) < sources.length) borrow sources[note.file as usize]
                else source;
        json.startObject()?;
        json.name("file")?;
        json.stringBytes(noteSource.shownPath())?;
        writePosition(mut json, "start", noteSource, note.start)?;
        writePosition(mut json, "end", noteSource, note.end)?;
        json.name("message")?;
        json.stringBytes(note.message.view())?;
        json.endObject()?;
    }
    json.endArray()?;
    json.name("fixes")?;
    json.startArray()?;
    if (d.hasFix) {
        json.startObject()?;
        json.name("title")?;
        json.stringBytes(d.fixTitle.view())?;
        json.name("edits")?;
        json.startArray()?;
        json.startObject()?;
        json.name("file")?;
        json.stringBytes(source.shownPath())?;
        writePosition(mut json, "start", source, d.fixStart)?;
        writePosition(mut json, "end", source, d.fixEnd)?;
        json.name("newText")?;
        json.stringBytes(d.fixText.view())?;
        json.endObject()?;
        if (d.hasSecondEdit) {
            json.startObject()?;
            json.name("file")?;
            json.stringBytes(source.shownPath())?;
            writePosition(mut json, "start", source, d.secondStart)?;
            writePosition(mut json, "end", source, d.secondEnd)?;
            json.name("newText")?;
            json.stringBytes(d.secondText.view())?;
            json.endObject()?;
        }
        json.endArray()?;
        json.endObject()?;
    }
    json.endArray()?;
    json.endObject()?;
    return Ok();
}
