fn bfThreadSpawnBoxed() -> u32 => 95;
fn bfThreadBoth() -> u32 => 96;
/// TcpStream's options and its read side's shutdown (ADR 0044 §3.6).
fn bfTcpSetNoDelay() -> u32 => 97;
fn bfTcpSetKeepAlive() -> u32 => 98;
fn bfTcpSetSendBuffer() -> u32 => 99;
fn bfTcpSetRecvBuffer() -> u32 => 100;
fn bfTcpSetLinger() -> u32 => 101;
fn bfTcpShutdownRead() -> u32 => 102;
/// `a.min(b)` and `a.max(b)` on integers (type-system.md §6).
fn bfIntMin() -> u32 => 103;
fn bfIntMax() -> u32 => 104;
/// `a.abs()` (panics at the minimum) and `a.unsignedAbs()` on signed integers (ADR 0063 §2.5).
fn bfIntAbs() -> u32 => 105;
fn bfIntUnsignedAbs() -> u32 => 106;
/// The bit methods of integers (ADR 0071 §2.3): rotations and masking shifts take a `u32` amount.
fn bfIntRotateLeft() -> u32 => 107;
fn bfIntRotateRight() -> u32 => 108;
fn bfIntWrappingShl() -> u32 => 109;
fn bfIntWrappingShr() -> u32 => 110;
fn bfIntLeadingZeros() -> u32 => 111;
fn bfIntTrailingZeros() -> u32 => 112;
fn bfIntCountOnes() -> u32 => 113;
fn bfIntByteSwap() -> u32 => 114;
/// `v.extend(s)`, `v.resize(n, fill)` and `v.reserve(extra)` on vectors of Copy elements (ADR 0071 §2.1).
fn bfVectorExtend() -> u32 => 115;
fn bfVectorResize() -> u32 => 116;
fn bfVectorReserve() -> u32 => 117;

/// `assert` and `panic` (ADR 0075 §2.8); `replace` and `swap` (§2.11), which lower to bfSwap.
fn bfAssert() -> u32 => 118;
fn bfPanic() -> u32 => 119;
fn bfReplace() -> u32 => 120;
fn bfSwap() -> u32 => 121;

/// Durable files (ADR 0075 §2.1).
fn bfFileOpenReadWrite() -> u32 => 122;
fn bfFileOpenOrCreate() -> u32 => 123;
fn bfFileCreateNew() -> u32 => 124;
fn bfFileReadAt() -> u32 => 125;
fn bfFileWriteAt() -> u32 => 126;
fn bfFileSyncData() -> u32 => 127;
fn bfFileSyncAll() -> u32 => 128;
fn bfFileLength() -> u32 => 129;
fn bfFileSetLength() -> u32 => 130;

/// `File.openAppend(path)` (ADR 0077).
fn bfFileOpenAppend() -> u32 => 131;

/// `File.openRegular(path)` (ADR 0078 §3).
fn bfFileOpenRegular() -> u32 => 132;

/// `debugAssert(condition[, message])` (ADR 0087 §2.5): HIR only; NIR lowers it to a configured `assert`.
fn bfDebugAssert() -> u32 => 133;

/// A fieldless enum's variant index as a `u32`, from a `borrow E` (ADR 0087 §2.3): HIR only, made for a derived
/// `HashKey` or `OrderKey` over a fieldless-enum field; NIR lowers it to the place's discriminant.
fn bfVariantIndex() -> u32 => 134;

/// `v.setLength(n)` (ADR 0090 §2.2): the length, without touching the elements; `n <= capacity` is checked.
fn bfVectorSetLength() -> u32 => 135;

/// The libraries only, for lib/core's VectorRaw and VectorForeign (ADR 0090): the vector becomes the empty one without its buffer being freed or its
/// elements dropped; `(v, foreign)`, where `foreign` takes the block out of the report's `live`.
fn bfVectorRelease() -> u32 => 136;

/// The libraries only (ADR 0090): an empty vector takes a buffer; `(v, pointer, length, capacity, foreign)`,
/// where `foreign` adds the block to the report's `live`.
fn bfVectorAdopt() -> u32 => 137;

/// `x.mulHigh(y)` (ADR 0092): the upper half of the full product, of the receiver's type; never overflows.
fn bfIntMulHigh() -> u32 => 138;

/// Whether `b` is one of ADR 0075 §2.1's file builtins.
fn isDurableFileBuiltin(b: u32) -> bool => b >= bfFileOpenReadWrite() && b <= bfFileOpenRegular();

