fn bfFloatAbs() -> u32 => 66;
fn bfFloatFloor() -> u32 => 67;
fn bfFloatCeil() -> u32 => 68;
fn bfFloatMin() -> u32 => 69;
fn bfFloatMax() -> u32 => 70;
