// `build` after checking (the reference's Program.Build): C files for `--emit c`, else the C compiler run on them in a
// temporary directory for `--emit exe` (the default), `--emit obj` or `--emit lib` (ADR 0088 §2.1).

/// The name without its directory and extension (Path.GetFileNameWithoutExtension).
fn appendStem(out: borrow mut Vector<u8>, path: Slice<u8>) -> Result<void, AllocError> {
    var start = path.length;
    while (start > 0 && path[start - 1] != '/') {
        start -= 1;
    }
    var end = path.length;
    while (end > start && path[end - 1] != '.') {
        end -= 1;
    }
    return appendBytes(out, path[start..(if (end > start + 1) end - 1 else path.length)]);
}

/// The directory part of a path, or empty.
fn directoryOf(path: Slice<u8>) -> Slice<u8> {
    var end = path.length;
    while (end > 0 && path[end - 1] != '/') {
        end -= 1;
    }
    return if (end > 1) path[..(end - 1)] else path[..end];
}

fn failBytes(message: Slice<u8>) -> i32 => fail(StringView.fromUtf8(message)!);

/// Writes a tool's output to standard error, as the reference compiler does: its standard output, then its standard error.
fn relayTool(outcome: borrow ToolOutcome) {
    Console.writeError(StringView.fromUtf8(outcome.stdout.view())!);
    Console.writeError(StringView.fromUtf8(outcome.stderr.view())!);
}

fn buildFiles(
    options: borrow Options,
    files: borrow Vector<CFile>,
    firstSource: Slice<u8>,
) -> i32 {
    var defaultName = Vector<u8>.create();
    if (options.defaultOutput.length > 0) {
        appendBytes(mut defaultName, options.defaultOutput.view())!;
        if (options.output.length == 0) {
            match (makeDirectories(directoryOf(defaultName.view()))) {
                Ok() => {}
                Err(e) => { return fail(e.message()); }
            }
        }
    } else {
        appendStem(mut defaultName, firstSource)!;
    }
    if (sameText(options.emit.view(), "c")) {
        var directory = copyBytes(options.output.view())!;
        if (directory.length == 0) {
            appendBytes(mut directory, defaultName.view())!;
            appendText(mut directory, "-c")!;
        }
        match (writeFilesUnder(directory.view(), files)) {
            Ok() => { return writeLinkFile(options, directory.view(), "ceesafe_link.txt".bytes(), true); }
            Err(e) => {
                var message = copyBytes("cannot write the C: ".bytes())!;
                appendText(mut message, e.message())!;
                return failBytes(message.view());
            }
        }
    }
    let library = sameText(options.emit.view(), "lib");
    let object = library || sameText(options.emit.view(), "obj");
    var output = copyBytes(options.output.view())!;
    if (output.length == 0) {
        appendBytes(mut output, defaultName.view())!;
        if (library) {
            appendText(mut output, ".a")!;
        } else if (object) {
            appendText(mut output, ".o")!;
        }
    }
    // --emit lib's archiver (ADR 0088 §2.1): --ar, else llvm-ar beside an LLVM clang, else ar; a usage error if none.
    var archiver = Vector<u8>.create();
    if (library) {
        let compilerName =
            if (options.cc.length > 0) options.cc.view() else (if (hostIsWindows()) "clang" else "cc").bytes();
        let found: Vector<u8>? = if (options.archiver.length > 0) resolveTool(
            options.archiver.view(),
        ) else locateArchiver(
            compilerName,
        );
        match (found) {
            Some(a) => { archiver = a; }
            null => {
                var message = copyBytes("--emit lib needs an archiver: ".bytes())!;
                if (options.archiver.length > 0) {
                    appendText(mut message, "'")!;
                    appendBytes(mut message, options.archiver.view())!;
                    appendText(mut message, "' was not found")!;
                } else {
                    appendText(mut message, "neither llvm-ar beside the C compiler nor ar was found")!;
                }
                appendText(mut message, "; name one with --ar")!;
                return failBytes(message.view());
            }
        }
    }
    if (!object && hostIsWindows()) {
        // tooling.md §8.4: a path without an extension gets .exe. cl adds it by itself, clang and gcc do not.
        var dot = false;
        for (c in output.view()) {
            if (c == '.') {
                dot = true;
            } else if (c == '/' || c == '\\') {
                dot = false;
            }
        }
        if (!dot) {
            appendText(mut output, ".exe")!;
        }
    }
    match (makeDirectories(directoryOf(output.view()))) {
        Ok() => {}
        Err(e) => { return fail(e.message()); }
    }
    // The objects of --emit obj are made with GCC's and clang's flags (§8.3); an executable with the compiler found.
    var compilerError = Vector<u8>.create();
    let found: CCompiler? = if (object) CCompiler {
        path: if (options.cc.length > 0) copyBytes(options.cc.view())! else copyBytes(
            (if (hostIsWindows()) "clang" else "cc").bytes(),
        )!,
        msvc: false,
        vcvars: Vector<u8>.create(),
    } else locateCompiler(options.cc.view(), mut compilerError);
    let compiler = match (found) {
        Some(c) => c,
        null => { return failBytes(compilerError.view()); }
    };
    let work = match (Directory.temporary()) {
        Ok(d) => d,
        Err(e) => { return fail(e.message()); }
    };
    let workBytes = copyBytes(work.view().bytes())!;
    // Archive members carry the program's name (ADR 0088 §2.1): --program, the package's, or the first file's.
    var program = copyBytes(options.programName.view())!;
    if (program.length == 0) {
        appendStem(mut program, firstSource)!;
    }
    if (library) {
        // Two C files that would become one member: the second object would replace the first, losing its code.
        let members = archiveMembers(files, options.native.separate.length, program.view())!;
        let shared = sharedMember(members)!;
        if (shared.length > 0) {
            removeTree(workBytes.view());
            var message = copyBytes("--emit lib: two C files would share the archive member '".bytes())!;
            appendBytes(mut message, shared.view())!;
            appendText(mut message, "'; rename one (ADR 0088 §2.1)")!;
            Console.writeError("ceesafec: ");
            Console.writeErrorLine(StringView.fromUtf8(message.view())!);
            return 1;
        }
    }
    if (library) {
        // A file of the user's where a header would go fails the build before anything is compiled or archived.
        let blocked = writeHostHeaders(options, files, output.view(), false);
        if (blocked != 0) {
            removeTree(workBytes.view());
            return blocked;
        }
    }
    let status = compileIn(
        options,
        files,
        workBytes.view(),
        compiler,
        output.view(),
        object,
        archiver.view(),
        program.view(),
    );
    removeTree(workBytes.view());
    if (status == 0 && object) {
        if (library) {
            // ADR 0088 §2.1: `--emit obj` stays as 0.27.0 had it, without the host's headers.
            let headers = writeHostHeaders(options, files, output.view(), true);
            if (headers != 0) {
                return headers;
            }
        }
        var linkPath = copyBytes(output.view())!;
        appendText(mut linkPath, ".link.txt")!;
        return writeLinkFile(options, "".bytes(), linkPath.view(), false); // an object's libraries are its user's
    }
    return status;
}

/// `--emit lib` (ADR 0088 §2.1): the headers a C or C++ host includes, written beside `output`: `ceesafe/embed.h`
/// and, if the program has exports, the exports header (`--exports-header`'s name, by default `ceesafe_exports.h`);
/// 0, or 1 after reporting a failure. Each starts with ceesafec's banner, and a file already at its path is replaced
/// only if it starts with that banner too: a file of the user's that happens to have the name is never overwritten.
/// With `write` false, only that check is made.
fn writeHostHeaders(options: borrow Options, files: borrow Vector<CFile>, output: Slice<u8>, write: bool) -> i32 {
    var directory = copyBytes(directoryOf(output))!;
    if (directory.length == 0) {
        directory.push('.')!;
    }
    var headers = Vector<CFile>.create();
    for (file in files.view()) {
        let name = file.name.view();
        if (sameText(name, "ceesafe/embed.h") || sameBytes(name, options.exportsHeader.view())) {
            var text = Vector<u8>.create();
            if (!startsWithBytes(file.text.view(), generatedBanner().bytes())) {
                appendText(mut text, "/* Generated by ")!;
                appendText(mut text, compilerBanner())!;
                appendText(mut text, ". Do not edit. ADR 0088 §2.2. */\n")!;
            }
            appendBytes(mut text, file.text.view())!;
            var path = Vector<u8>.create();
            appendPath(mut path, directory.view(), name)!;
            if (!replaceableHeader(path.view())) {
                var message = copyBytes("--emit lib: will not overwrite '".bytes())!;
                appendBytes(mut message, path.view())!;
                appendText(mut message, "', which ceesafec did not write (its first line is not ")!;
                appendText(mut message, "\"/* Generated by ceesafec\"); remove it, or build into another directory")!;
                appendText(mut message, " or name another --exports-header")!;
                Console.writeError("ceesafec: ");
                Console.writeErrorLine(StringView.fromUtf8(message.view())!);
                return 1;
            }
            headers.push(CFile { name: copyBytes(name)!, text: text })!;
        }
    }
    if (!write) {
        return 0;
    }
    match (writeFilesUnder(directory.view(), headers)) {
        Ok() => { return 0; }
        Err(e) => {
            var message = copyBytes("cannot write the host's headers: ".bytes())!;
            appendText(mut message, e.message())!;
            return failBytes(message.view());
        }
    }
}

/// The start of every file ceesafec writes for a host to include.
fn generatedBanner() -> StringView => "/* Generated by ceesafec";

/// Whether a host header may be written at `path`: nothing is there, or a file that starts with ceesafec's banner.
fn replaceableHeader(path: Slice<u8>) -> bool {
    if (!fileExists(path)) {
        return true;
    }
    let text = match (StringView.fromUtf8(path)) {
        Some(t) => t,
        null => { return false; }
    };
    return match (readFile(text)) {
        Ok(bytes) => startsWithBytes(bytes.view(), generatedBanner().bytes()),
        Err(_) => false,
    };
}

/// Writes the manifests' link line (ADR 0047 §3.4) as `name` in `directory` (or, with `nameIsPath` false, to the path
/// `name`), when there is one; 0, or 1 after reporting a failure.
fn writeLinkFile(options: borrow Options, directory: Slice<u8>, name: Slice<u8>, nameIsPath: bool) -> i32 {
    let msvc = compilerStem(options.cc.view()).length > 0 && isMsvcName(options.cc.view());
    let text = linkFileText(borrow options.native, msvc)!;
    if (text.length == 0) {
        return 0;
    }
    let path = if (nameIsPath) joinPath(directory, name)! else copyBytes(name)!;
    match (writeFile(StringView.fromUtf8(path.view())!, text.view())) {
        Ok() => { return 0; }
        Err(e) => {
            var message = copyBytes("cannot write the link file: ".bytes())!;
            appendText(mut message, e.message())!;
            return failBytes(message.view());
        }
    }
}

fn compileIn(
    options: borrow Options,
    files: borrow Vector<CFile>,
    work: Slice<u8>,
    compilerFound: borrow CCompiler,
    output: Slice<u8>,
    object: bool,
    archiver: Slice<u8>,
    program: Slice<u8>,
) -> i32 {
    let compiler = compilerFound.path.view();
    var tool = Vector<u8>.create(); // the program that failed: the C compiler, or --emit lib's archiver
    match (writeFilesUnder(work, files)) {
        Ok() => {}
        Err(e) => {
            var message = copyBytes("cannot write the C: ".bytes())!;
            appendText(mut message, e.message())!;
            return failBytes(message.view());
        }
    }
    // Run in the current directory: the source paths in #line directives are relative to it (c-backend.md §7).
    var flags = Vector<Vector<u8>>.create();
    pushText(mut flags, if (options.debug) "-g" else "-O2")!;
    if (options.debug) {
        pushText(mut flags, "-O0")!;
    }
    for (flag in options.cflags.view()) {
        pushBytes(mut flags, flag.view())!;
    }
    let outcome = if (object) compileObject(
        compiler,
        work,
        files,
        output,
        flags,
        options.freestanding,
        options.linker.view(),
        borrow options.native,
        archiver,
        program,
        mut tool,
    )! else compileExecutable(
        compilerFound,
        work,
        files,
        output,
        options.debug,
        options.cflags,
        options.freestanding,
        borrow options.native,
        options.split,
        if (!options.split) 1 else if (options.jobsGiven) options.testJobs else processorCount(),
    )!;
    if (tool.length == 0) {
        appendBytes(mut tool, compiler)!;
    }
    let what = if (sameBytes(tool.view(), compiler)) "the C compiler '" else "the archiver '";
    if (!outcome.started) {
        var message = copyBytes("cannot run ".bytes())!;
        appendText(mut message, what)!;
        appendBytes(mut message, tool.view())!;
        appendText(mut message, "': ")!;
        appendText(mut message, outcome.error.message())!;
        return failBytes(message.view());
    }
    if (compilerFound.msvc) {
        let shown = withoutMsvcProgress(outcome.stdout.view(), files)!;
        Console.writeError(StringView.fromUtf8(shown.view())!);
        Console.writeError(StringView.fromUtf8(outcome.stderr.view())!);
    } else {
        relayTool(outcome);
    }
    if (outcome.status != 0) {
        var message = copyBytes(what.bytes())!;
        appendBytes(mut message, tool.view())!;
        appendText(mut message, "' failed (exit code ")!;
        if (outcome.status < 0) {
            message.push('-')!;
        }
        appendDecimal(
            mut message,
            truncate<u64>(if (outcome.status < 0) 0 - (outcome.status as i64) else outcome.status as i64),
        )!;
        appendText(mut message, ")")!;
        Console.writeError("ceesafec: ");
        Console.writeErrorLine(StringView.fromUtf8(message.view())!);
        return 1;
    }
    return 0;
}
