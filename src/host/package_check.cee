// `check` in a package (ADR 0082 §2.7, tooling.md §4.4): one check of the package and every package it depends on,
// which takes a dependency from its interface record (src/host/record_cache.cee) where the cache holds a valid one,
// and checks it in full otherwise. A dependency from its record is parsed and its declarations resolved, but its
// skipped bodies are not checked again: so the check is never more work than `--whole-program`'s, which checks every
// package in full, and is that check when no record is valid (no usable cache, a cold one). Whatever records there
// are, it reports the same: the package's own diagnostics, and for each package of its closure that has errors one
// N0364 at the line of the manifest that leads to it. A package with errors is never taken from a record.
//
// The records are made by these checks: once the answer is printed, each dependency checked in full here whose
// closure has no error gets its record, from what the check found (the effect checker records every such package's
// functions). `check --all` is one check of every package of the lock, every package's tests included, reported by
// package. `--record` is the check of a package as its dependents see it ("dependency mode": without its tests or entry
// function, its files and items named as a dependent names them), which prints its record.
//
// Safety stays whole-program: `build`, `test`, `run` and `fix` check every package together and read no record.

extern "C" {
    // C's fflush(NULL), which writes what standard output holds buffered: the answer goes out before the records are
    // made (Console.flush is newer than ceesafec 0.8.0, which builds these sources).
    fn fflush(stream: *mut u8) -> i32;
}

/// Writes what standard output holds buffered.
/// Safety: fflush(NULL) flushes every output stream of the C library, and reads no memory of ours.
fn flushStandardOutput() {
    unsafe { fflush(0 as *mut u8); }
}

/// A package of the workspace as per-package checking needs it.
struct WorkspacePackage {
    info: PackageInfo;
    sources: Vector<Vector<u8>>;   // absolute paths of its .cee sources
    tests: Vector<Vector<u8>>;     // and of its test files (ADR 0049)
    texts: Vector<Vector<u8>>;     // its sources' bytes, read once (loadTexts): what is hashed is what is checked
    manifestFile: u32;             // its manifest in WorkspaceData.report
    dependencies: Vector<u32>;     // its direct dependencies, by index
    dependencyStarts: Vector<u32>; // each one's span in its manifest
    dependencyEnds: Vector<u32>;
    level: u32; // 0 for no dependencies, else one more than its deepest dependency's
}

/// The package of the current directory (first) and every package of its lock, in the workspace's order.
struct WorkspaceData {
    packages: Vector<WorkspacePackage>;
    report: PackageReport; // the manifests' texts
    levels: u32;
    digests: Vector<Vector<u8>>; // by package: the SHA-256 of its manifest and sources (sourceDigest), once made
}

/// What one check found: the diagnostics, with the sources they name, and what records are made from.
struct PackageRun {
    package: usize;         // the package checked, by index
    members: Vector<usize>; // it and its closure, by index: a package's position in this check
    sources: Vector<SourceText>;
    sourcePackage: Vector<usize>; // by source: its package, by index; none64() for a library file or a manifest
    sourceIsTest: Vector<bool>;   // by source: a test file
    diagnostics: Diagnostics;
    errors: u64; // before --deny-warnings
    warnings: u64;
    phase: u32;
    failed: Vector<bool>;               // by package index: errors in its own files
    effectsRecorded: bool;              // the effect checker ran: what follows holds what it found
    recorded: Vector<bool>;             // by position: its record can be made from this check
    opaque: Vector<bool>;               // by position: its record would be opaque (madeOpaque, an `embed`)
    functions: Vector<RecordedEffects>; // the recorded packages' functions, each with its position
    spans: Vector<Vector<Span>>;        // by source: the bodies dependents skip (recordedShapes)
    record: InterfaceRecord;            // the package's own record (dependency mode), once `hasRecord`
    hasRecord: bool;
    failure: i32; // a usage error's exit status, else 0
}

fn blankRecord() -> InterfaceRecord => InterfaceRecord {
    key: Vector<u8>.create(),
    banner: Vector<u8>.create(),
    package: Vector<u8>.create(),
    profile: Vector<u8>.create(),
    errors: 0,
    warnings: 0,
    phase: 0,
    opaque: false,
    interfaceHash: Vector<u8>.create(),
    functions: Vector<RecordedEffects>.create(),
};

fn copyRecord(r: borrow InterfaceRecord) -> Result<InterfaceRecord, AllocError> {
    var copy = InterfaceRecord {
        key: copyBytes(r.key.view())?,
        banner: copyBytes(r.banner.view())?,
        package: copyBytes(r.package.view())?,
        profile: copyBytes(r.profile.view())?,
        errors: r.errors,
        warnings: r.warnings,
        phase: r.phase,
        opaque: r.opaque,
        interfaceHash: copyBytes(r.interfaceHash.view())?,
        functions: Vector<RecordedEffects>.create(),
    };
    for (f in r.functions.view()) {
        copy.functions.push(copyRecordedEffects(f, f.package)?)?;
    }
    return Ok(copy);
}

fn copyRecordedEffects(f: borrow RecordedEffects, package: u32) -> Result<RecordedEffects, AllocError> {
    var copy = RecordedEffects {
        package: package,
        path: copyBytes(f.path.view())?,
        offset: f.offset,
        effects: f.effects,
        chains: Vector<RecordedChain>.create(),
    };
    for (chain in f.chains.view()) {
        var steps = Vector<Vector<u8>>.create();
        for (step in chain.steps.view()) {
            steps.push(copyBytes(step.view())?)?;
        }
        copy.chains.push(
            RecordedChain {
                steps: steps,
                terminal: copyBytes(chain.terminal.view())?,
                truncated: chain.truncated,
                length: chain.length,
            },
        )?;
    }
    return Ok(copy);
}

fn copyPackageInfo(p: borrow PackageInfo) -> Result<PackageInfo, AllocError> {
    var dependencies = Vector<Vector<u8>>.create();
    for (d in p.dependencies.view()) {
        dependencies.push(copyBytes(d.view())?)?;
    }
    var roots = Vector<Vector<u8>>.create();
    for (r in p.embedRoots.view()) {
        roots.push(copyBytes(r.view())?)?;
    }
    return Ok(
        PackageInfo {
            name: copyBytes(p.name.view())?,
            dependencies: dependencies,
            trusted: p.trusted,
            directory: copyBytes(p.directory.view())?,
            embedRoots: roots,
            embedBoundary: copyBytes(p.embedBoundary.view())?,
        },
    );
}

/// The workspace of the nearest manifest, resolved through its lock, with the root manifest's profile set in
/// `options` as loadPackage sets it; or the exit status of a failure (reported).
fn loadWorkspaceData(options: borrow mut Options, data: borrow mut WorkspaceData) -> i32 {
    let cwd = match (currentDirectory()) {
        Ok(d) => d,
        Err(_) => { return fail("cannot read the current directory"); }
    };
    let directory = match (findManifestDirectory(cwd.view())!) {
        Some(d) => d,
        null => {
            fail("no CeeSafe input files, and no ceesafe.toml here or above");
            return 1;
        }
    };
    let noUpdate = Vector<Vector<u8>>.create();
    let resolved = resolveWorkspace(directory.view(), mut data.report, false, options.offline, false, noUpdate)!;
    if (data.report.count() > 0) {
        reportPackage(options.json, data.report);
    }
    let workspace = match (resolved) {
        Some(w) => w,
        null => { return 1; }
    };
    var rootFiles = Vector<Vector<u8>>.create();
    manifestSourceFiles(workspace.root, mut rootFiles)!;
    if (rootFiles.length == 0) {
        var message = String.create();
        message.append("package '")!;
        message.append(StringView.fromUtf8(workspace.root.name.view())!)!;
        message.append("' has no .cee files under ")!;
        for (k in 0..workspace.root.sources.length) {
            if (k > 0) {
                message.append(", ")!;
            }
            message.append(StringView.fromUtf8(workspace.root.sources[k].view())!)!;
        }
        fail(message.view());
        return 1;
    }
    if (!options.profileGiven) {
        options.freestanding = workspace.root.freestanding;
    }
    if (!workspace.root.floatAllowed) {
        options.noFloat = true;
    }
    if (workspace.root.kernel) {
        options.kernel = true;
    }
    let count = workspace.resolved.length + 1;
    for (p in 0..count) {
        let manifest = workspace.dependentManifest(if (p == 0) none() else truncate<u32>(p - 1));
        var sources = Vector<Vector<u8>>.create();
        manifestSourceFiles(manifest, mut sources)!;
        var tests = Vector<Vector<u8>>.create();
        manifestTestFiles(manifest, mut tests)!;
        data.packages.push(
            WorkspacePackage {
                info: workspace.packageInfo(p)!,
                sources: sources,
                tests: tests,
                texts: Vector<Vector<u8>>.create(),
                manifestFile: manifest.file,
                dependencies: Vector<u32>.create(),
                dependencyStarts: Vector<u32>.create(),
                dependencyEnds: Vector<u32>.create(),
                level: 0,
            },
        )!;
        data.digests.push(Vector<u8>.create())!;
    }
    // Each package's dependencies by index: names are unique in a build (ADR 0013 D1).
    for (p in 0..count) {
        let manifest = workspace.dependentManifest(if (p == 0) none() else truncate<u32>(p - 1));
        for (d in manifest.dependencies.view()) {
            for (q in 0..count) {
                if (q != p && sameBytes(data.packages[q].info.name.view(), d.name.view())) {
                    data.packages[p].dependencies.push(truncate<u32>(q))!;
                    data.packages[p].dependencyStarts.push(d.start)!;
                    data.packages[p].dependencyEnds.push(d.end)!;
                    break;
                }
            }
        }
    }
    // Levels: a package after everything it depends on. A cycle (the resolver forbids one) leaves the rounds unsettled.
    var settled = false;
    var round: usize = 0;
    while (!settled && round <= count) {
        settled = true;
        for (p in 0..count) {
            var level: u32 = 0;
            for (d in data.packages[p].dependencies.view()) {
                let below = data.packages[d as usize].level + 1;
                if (below > level) {
                    level = below;
                }
            }
            if (level != data.packages[p].level) {
                data.packages[p].level = level;
                settled = false;
            }
        }
        round += 1;
    }
    if (!settled) {
        return fail("the packages' dependencies form a cycle");
    }
    for (p in data.packages.view()) {
        if (p.level + 1 > data.levels) {
            data.levels = p.level + 1;
        }
    }
    return 0;
}

/// Reads the sources of every package of `members`, once: the bytes a record's key hashes are the bytes checked.
/// The exit status of a failure (reported), else 0.
fn loadTexts(data: borrow mut WorkspaceData, members: borrow Vector<usize>) -> i32 {
    for (m in members.view()) {
        if (data.packages[m].texts.length == data.packages[m].sources.length) {
            continue;
        }
        var texts = Vector<Vector<u8>>.create();
        for (path in data.packages[m].sources.view()) {
            let text = StringView.fromUtf8(path.view())!;
            match (readFile(text)) {
                Ok(b) => { texts.push(b)!; }
                Err(_) => {
                    var message = String.create();
                    message.append("cannot read '")!;
                    message.append(text)!;
                    message.append("'")!;
                    return fail(message.view());
                }
            }
        }
        data.packages[m].texts = texts;
    }
    return 0;
}

/// `root` and every package it depends on, directly or not: root first, then the others in the workspace's order.
fn packageClosure(data: borrow WorkspaceData, root: usize) -> Result<Vector<usize>, AllocError> {
    var reached = Vector<bool>.create();
    while (reached.length < data.packages.length) {
        reached.push(false)?;
    }
    var work = Vector<usize>.create();
    work.push(root)?;
    reached[root] = true;
    while (work.length > 0) {
        let p = work[work.length - 1];
        work.truncate(work.length - 1);
        for (d in data.packages[p].dependencies.view()) {
            if (!reached[d as usize]) {
                reached[d as usize] = true;
                work.push(d as usize)?;
            }
        }
    }
    var members = Vector<usize>.create();
    members.push(root)?;
    for (p in 0..data.packages.length) {
        if (p != root && reached[p]) {
            members.push(p)?;
        }
    }
    return Ok(members);
}

/// The profile a record is valid for: what changes how every package checks.
fn profileText(options: borrow Options) -> Result<Vector<u8>, AllocError> {
    var text = copyBytes((if (options.freestanding) "freestanding" else "hosted").bytes())?;
    if (options.kernel) {
        appendText(mut text, "+kernel")?;
    }
    if (options.noFloat) {
        appendText(mut text, "+no-float")?;
    }
    return Ok(text);
}

/// The SHA-256 of `package`'s manifest and sources (each with its path in the package), as read: made once.
fn sourceDigest(data: borrow mut WorkspaceData, package: usize) -> Result<void, AllocError> {
    if (data.digests[package].length > 0) {
        return Ok();
    }
    var sha = Sha256.create();
    let p = borrow data.packages[package];
    appendLengthPrefixed(mut sha, data.report.sources[p.manifestFile as usize].text.view())?;
    for (k in 0..p.sources.length) {
        let inPackage = pathBelow(p.sources[k].view(), p.info.directory.view())?;
        appendLengthPrefixed(mut sha, inPackage.view())?;
        appendLengthPrefixed(mut sha, p.texts[k].view())?;
    }
    var digest = Vector<u8>.create();
    appendHexDigest(mut digest, sha.finish())?;
    data.digests[package] = digest;
    return Ok();
}

/// `package`'s record key (ADR 0082 §2.7): a SHA-256 of the record format, ceesafec's banner and identity (the
/// SHA-256 of its executable), the profile, the package's name, its manifest and sources as read (sourceDigest), and
/// its direct dependencies' interface hashes, by name; null if a dependency has no record.
fn interfaceKey(
    options: borrow Options,
    identity: Slice<u8>,
    data: borrow mut WorkspaceData,
    package: usize,
    records: borrow Vector<InterfaceRecord?>,
) -> Result<Vector<u8>?, AllocError> {
    sourceDigest(data, package)?;
    var sha = Sha256.create();
    let zero = [0u8];
    sha.append("ceesafe-interface-key".bytes());
    sha.append(zero[..]);
    sha.append(recordFormat().bytes());
    sha.append(zero[..]);
    sha.append(compilerBanner().bytes());
    sha.append(zero[..]);
    sha.append(identity);
    sha.append(zero[..]);
    let profile = profileText(options)?;
    sha.append(profile.view());
    sha.append(zero[..]);
    sha.append(data.packages[package].info.name.view());
    sha.append(zero[..]);
    sha.append(data.digests[package].view());
    sha.append(zero[..]);
    let names = dependenciesByName(data, package)?;
    for (d in names.view()) {
        match (borrow records[d]) {
            Some(r) => {
                appendLengthPrefixed(mut sha, data.packages[d].info.name.view())?;
                appendLengthPrefixed(mut sha, r.interfaceHash.view())?;
            }
            null => { return Ok(null); }
        }
    }
    var key = Vector<u8>.create();
    appendHexDigest(mut key, sha.finish())?;
    return Ok(key);
}

/// `package`'s direct dependencies, by index, in the order of their names.
fn dependenciesByName(data: borrow WorkspaceData, package: usize) -> Result<Vector<usize>, AllocError> {
    var names = Vector<usize>.create();
    for (d in data.packages[package].dependencies.view()) {
        names.push(d as usize)?;
        var at = names.length - 1;
        while (at > 0 && lessBytes(
            data.packages[names[at]].info.name.view(),
            data.packages[names[at - 1]].info.name.view(),
        )) {
            names.swap(at, at - 1);
            at -= 1;
        }
    }
    return Ok(names);
}

fn appendLengthPrefixed(sha: borrow mut Sha256, bytes: Slice<u8>) -> Result<void, AllocError> {
    var length = Vector<u8>.create();
    appendDecimal(mut length, bytes.length as u64)?;
    length.push(':')?;
    sha.append(length.view());
    sha.append(bytes);
    return Ok();
}

/// The interface hash of the package at `position` in `run` (ADR 0082 §2.7): its name; per source, its path in the
/// package and its tokens, with each body dependents skip left out; what its record says; and its direct
/// dependencies' interface hashes. It holds no position (nor does anything a dependent's check can say of the
/// package: a closure is named by its place in its function, placeClosure): a comment, or a declaration moved, leaves
/// it as it was, and with it the dependents' keys. A change inside a skipped
/// body changes the record's key but not this hash, unless it changes the package's effects or whether it checks.
fn interfaceHash(
    run: borrow PackageRun,
    data: borrow WorkspaceData,
    position: usize,
    record: borrow InterfaceRecord,
    records: borrow Vector<InterfaceRecord?>,
) -> Result<Vector<u8>, AllocError> {
    let package = run.members[position];
    let p = borrow data.packages[package];
    var sha = Sha256.create();
    let zero = [0u8];
    sha.append("ceesafe-interface".bytes());
    sha.append(zero[..]);
    sha.append(recordFormat().bytes());
    sha.append(zero[..]);
    appendLengthPrefixed(mut sha, p.info.name.view())?;
    for (s in 0..run.sources.length) {
        if (run.sourcePackage[s] != package || run.sourceIsTest[s]) {
            continue;
        }
        appendLengthPrefixed(mut sha, run.sources[s].packagePath.view())?;
        let noSpans = Vector<Span>.create();
        let spans = if (s < run.spans.length) borrow run.spans[s] else borrow noSpans;
        appendTokens(mut sha, run.sources[s].text.view(), spans)?;
    }
    var shown = copyRecord(record)?;
    shown.key = Vector<u8>.create();
    shown.interfaceHash = Vector<u8>.create();
    shown.errors = if (record.errors > 0) 1 else 0;
    shown.warnings = 0;
    for (k in 0..shown.functions.length) {
        shown.functions[k].offset = 0; // a declaration's offset is a key into its own sources, not its interface
    }
    let encoded = encodeRecord(shown)?;
    appendLengthPrefixed(mut sha, encoded.view())?;
    let names = dependenciesByName(data, package)?;
    for (d in names.view()) {
        match (borrow records[d]) {
            Some(r) => {
                appendLengthPrefixed(mut sha, data.packages[d].info.name.view())?;
                appendLengthPrefixed(mut sha, r.interfaceHash.view())?;
            }
            null => {}
        }
    }
    var hash = Vector<u8>.create();
    appendHexDigest(mut hash, sha.finish())?;
    return Ok(hash);
}

/// Hashes `text`'s tokens, each by its bytes (length-prefixed), without their positions; the tokens inside each of
/// `spans` (sorted, not overlapping) stand as one `{}`. The bytes go to the hash 64 kB at a time.
fn appendTokens(sha: borrow mut Sha256, text: Slice<u8>, spans: borrow Vector<Span>) -> Result<void, AllocError> {
    var symbols = Interner.create();
    var diagnostics = Diagnostics.create();
    let lexed = lex(text, 0, mut symbols, mut diagnostics)?;
    var k: usize = 0;
    var marked = false;
    var buffer = Vector<u8>.create();
    for (t in lexed.tokens.view()) {
        while (k < spans.length && t.start >= spans[k].end) {
            k += 1;
            marked = false;
        }
        if (k < spans.length && t.start >= spans[k].start) {
            if (!marked) {
                appendText(mut buffer, "2:{}")?;
                marked = true;
            }
            continue;
        }
        let start = t.start as usize;
        let end = if ((t.end as usize) < text.length) t.end as usize else text.length;
        if (start <= end) {
            appendDecimal(mut buffer, (end - start) as u64)?;
            buffer.push(':')?;
            appendBytes(mut buffer, text[start..end])?;
        }
        if (buffer.length >= 65536) {
            sha.append(buffer.view());
            buffer.truncate(0);
        }
    }
    sha.append(buffer.view());
    return Ok();
}

/// A dependency failed: N0364 at its line in `package`'s manifest.
fn dependencyFailure() -> u32 => 364;

/// N0364's message for `failed`, a package of the closure with errors, reached through the direct dependency
/// `through`: where to see them (`check --package`, which works from anywhere in the lock).
fn dependencyFailureMessage(
    data: borrow WorkspaceData,
    failed: usize,
    through: usize,
) -> Result<Vector<u8>, AllocError> {
    let name = data.packages[failed].info.name.view();
    var message = copyBytes("the dependency '".bytes())?;
    appendBytes(mut message, name)?;
    appendText(mut message, "' ")?;
    if (through != failed) {
        appendText(mut message, "(through '")?;
        appendBytes(mut message, data.packages[through].info.name.view())?;
        appendText(mut message, "') ")?;
    }
    appendText(mut message, "has errors: run 'ceesafec check --package ")?;
    appendBytes(mut message, name)?;
    appendText(mut message, "' to see them all (ADR 0082 §2.7)")?;
    return Ok(message);
}

/// Checks package `package` with its closure `members` (packageClosure), each dependency from its record where
/// `useRecord` says so (by package index), else in full. `recordWanted` (by package index) marks the packages whose
/// records this check finds what for. `dependencyMode` is the check that makes a dependency's record: without its
/// tests or entry function, its files named as a dependent names them. `allTests` checks every package's tests too
/// (`check --all`), a package with tests is never from its record then. `qualifyRoot` names the first package's items
/// as its dependents do (a later round of `check --all`, whose first package is not the current directory's).
fn checkPackageRun(
    options: borrow Options,
    data: borrow WorkspaceData,
    package: usize,
    members: borrow Vector<usize>,
    records: borrow Vector<InterfaceRecord?>,
    useRecord: borrow Vector<bool>,
    recordWanted: borrow Vector<bool>,
    dependencyMode: bool,
    allTests: bool,
    qualifyRoot: bool,
) -> PackageRun {
    var run = PackageRun {
        package: package,
        members: Vector<usize>.create(),
        sources: Vector<SourceText>.create(),
        sourcePackage: Vector<usize>.create(),
        sourceIsTest: Vector<bool>.create(),
        diagnostics: Diagnostics.create(),
        errors: 0,
        warnings: 0,
        phase: 0,
        failed: Vector<bool>.create(),
        effectsRecorded: false,
        recorded: Vector<bool>.create(),
        opaque: Vector<bool>.create(),
        functions: Vector<RecordedEffects>.create(),
        spans: Vector<Vector<Span>>.create(),
        record: blankRecord(),
        hasRecord: false,
        failure: 0,
    };
    for (m in members.view()) {
        run.members.push(m)!;
    }
    while (run.failed.length < data.packages.length) {
        run.failed.push(false)!;
    }
    var packages = Vector<PackageInfo>.create();
    var input = emptyRecordInput();
    for (m in members.view()) {
        packages.push(copyPackageInfo(data.packages[m].info)!)!;
        input.recordedPackages.push(recordWanted[m])!;
        if (recordWanted[m]) {
            input.recording = true;
        }
    }
    var sources = Vector<SourceText>.create();
    var fileIsLibrary = Vector<bool>.create();
    var filePackage = Vector<u32>.create();
    for (k in 0..libraryFileCount()) {
        let group = libraryGroup(k);
        if (group == 0 || (group == 1 && !options.freestanding) ||
            (group == 2 && options.freestanding && options.kernel)) {
            let text = libraryText(k)!;
            sources.push(SourceText.create(libraryPath(k).bytes(), text.view())!)!;
            fileIsLibrary.push(true)!;
            filePackage.push(0xFFFFFFFF)!;
            run.sourcePackage.push(none64())!;
            run.sourceIsTest.push(false)!;
        }
    }
    input.qualifyRoot = dependencyMode || qualifyRoot;
    while (input.fileFromRecord.length < sources.length) {
        input.fileFromRecord.push(false)!;
        input.filePackagePaths.push(Vector<u8>.create())!;
        input.recordPaths.push(Vector<u8>.create())!;
    }
    let cwd = match (currentDirectory()) {
        Ok(d) => d,
        Err(_) => Vector<u8>.create(),
    };
    for (position in 0..members.length) {
        let member = members[position];
        let p = borrow data.packages[member];
        let fromRecord = position > 0 && useRecord[member];
        if (fromRecord) {
            match (borrow records[member]) {
                Some(r) => {
                    for (f in r.functions.view()) {
                        input.functions.push(copyRecordedEffects(f, truncate<u32>(position))!)!;
                    }
                }
                null => {}
            }
        }
        let withTests = !dependencyMode && (position == 0 || (allTests && !fromRecord));
        let count = p.sources.length + (if (withTests) p.tests.length else 0);
        for (k in 0..count) {
            let isTest = k >= p.sources.length;
            let path = if (isTest) borrow p.tests[k - p.sources.length] else borrow p.sources[k];
            let text = StringView.fromUtf8(path.view())!;
            var testBytes = Vector<u8>.create();
            if (isTest) {
                match (readFile(text)) {
                    Ok(b) => { testBytes = b; }
                    Err(_) => {
                        var message = String.create();
                        message.append("cannot read '")!;
                        message.append(text)!;
                        message.append("'")!;
                        run.failure = fail(message.view());
                        return run;
                    }
                }
            }
            let bytes = if (isTest) testBytes.view() else p.texts[k].view();
            let slashed = slashedPath(path.view())!;
            let inPackage = pathBelow(slashed.view(), p.info.directory.view())!;
            // The current directory's package is named from it; any other by its package (ADR 0082 §2.1).
            var name = Vector<u8>.create();
            var openPath = Vector<u8>.create();
            var dependencyName = Vector<u8>.create();
            appendBytes(mut dependencyName, p.info.name.view())!;
            dependencyName.push('/')!;
            appendBytes(mut dependencyName, inPackage.view())!;
            if (member == 0 || inPackage.length == 0) {
                name = sourcePath(text);
            } else {
                name = copyBytes(dependencyName.view())!;
                if (cwd.length > 0) {
                    openPath = pathFrom(cwd.view(), slashed.view())!;
                }
            }
            input.fileFromRecord.push(fromRecord)!;
            input.filePackagePaths.push(copyBytes(inPackage.view())!)!;
            input.recordPaths.push(if (position == 0 && member == 0) dependencyName else Vector<u8>.create())!;
            var source = SourceText.create(name.view(), bytes)!;
            source.package = copyBytes(p.info.name.view())!;
            source.packagePath = inPackage;
            source.openPath = openPath;
            source.diskPath = absolutePath(path.view());
            sources.push(source)!;
            fileIsLibrary.push(false)!;
            filePackage.push(truncate<u32>(position))!;
            run.sourcePackage.push(member)!;
            run.sourceIsTest.push(isTest)!;
        }
    }
    var front = Frontend.create();
    for (i in 0..sources.length) {
        let source = borrow sources[i];
        let file = truncate<u32>(i);
        let lexed = lex(source.text.view(), file, mut front.symbols, mut front.diagnostics)!;
        let marks = astMarks(front);
        front = parseFile(file, lexed, front)!;
        if (!fileIsLibrary[i] && !front.diagnostics.hasErrors()) {
            let unit = truncate<u32>(front.ast.units.length - 1);
            rewritePackageNames(mut front, unit, packages[filePackage[i] as usize].dependencies, marks)!;
        }
    }
    if (front.diagnostics.hasErrors()) {
        run.phase = 1;
        for (position in 0..members.length) {
            let m = members[position];
            run.recorded.push(recordWanted[m] && (position == 0 || !useRecord[m]))!;
            run.opaque.push(false)!;
        }
        run.diagnostics = front.diagnostics;
        run.sources = sources;
        finishRun(mut run, options, dependencyMode);
        return run;
    }
    var texts = Vector<Vector<u8>>.create();
    var names = Vector<Vector<u8>>.create();
    var diskPaths = Vector<Vector<u8>>.create();
    for (i in 0..sources.length) {
        texts.push(copyBytes(sources[i].text.view())!)!;
        names.push(copyBytes(sources[i].path.view())!)!;
        diskPaths.push(copyBytes(sources[i].diskPath.view())!)!;
    }
    let entry = if (dependencyMode) copyBytes("-".bytes())! else copyBytes(options.entryName.view())!;
    let recording = input.recording;
    var checker = checkProgramWith(
        front,
        fileIsLibrary,
        texts,
        names,
        diskPaths,
        options.noFloat,
        options.freestanding,
        packages,
        filePackage,
        entry,
        input,
    )!;
    markUncheckedLibrary(mut checker);
    checker.front.diagnostics.removeFiles(checker.fileIsLibrary.view());
    if (checker.front.diagnostics.hasErrors()) {
        run.phase = 2;
    } else {
        analyzeProgram(mut checker)!;
        if (checker.nirLoopErrors) {
            run.phase = 3;
        } else if (checker.instanceErrors) {
            run.phase = 4;
        } else if (checker.front.diagnostics.hasErrors()) {
            run.phase = 5;
        }
    }
    // What the records are made from (makeRecords), once the answer is out.
    var fromRecords = Vector<bool>.create();
    packagesFromRecords(checker, mut fromRecords)!;
    for (position in 0..members.length) {
        let wanted = recordWanted[members[position]];
        let live = position >= fromRecords.length || !fromRecords[position];
        run.recorded.push(wanted && live)!;
        run.opaque.push(position < checker.opaquePackages.length && checker.opaquePackages[position])!;
    }
    run.effectsRecorded = checker.effectsRecorded;
    if (recording && checker.effectsRecorded) {
        recordedShapes(checker, mut run.spans)!;
        var reversed = Vector<RecordedEffects>.create();
        while (checker.recordOut.length > 0) {
            reversed.push(checker.recordOut.pop()!)!;
        }
        while (reversed.length > 0) {
            run.functions.push(reversed.pop()!)!;
        }
    }
    run.diagnostics = checker.front.diagnostics;
    run.sources = sources;
    finishRun(mut run, options, dependencyMode);
    return run;
}

/// The end of a check: which packages have errors in their own files, and the counts.
fn finishRun(run: borrow mut PackageRun, options: borrow Options, dependencyMode: bool) {
    for (d in run.diagnostics.items.view()) {
        if (d.isError && (d.file as usize) < run.sourcePackage.length) {
            let p = run.sourcePackage[d.file as usize];
            if (p != none64()) {
                run.failed[p] = true;
            }
        }
    }
    run.errors = truncate<u64>(run.diagnostics.count(true));
    run.warnings = truncate<u64>(run.diagnostics.count(false));
    if (!dependencyMode && options.denyWarnings) {
        run.diagnostics.denyWarnings();
    }
}

/// `check`'s report of a package's closure (ADR 0082 §2.7): the package's own diagnostics, and for each other
/// package of the closure with errors, one N0364 at the line of the package's manifest that leads to it (the first
/// such dependency), with a note at its first error, in place of its own diagnostics. What a dependency's check would
/// say is its own: its warnings are left out too, so that the report is the same whether it was checked here in full
/// or taken from its record.
fn reportFailedDependencies(run: borrow mut PackageRun, data: borrow WorkspaceData) -> Result<void, AllocError> {
    let target = run.package;
    var firstError = Vector<usize>.create(); // by package: its first error, by index in the diagnostics
    while (firstError.length < data.packages.length) {
        firstError.push(none64())?;
    }
    var remove = Vector<bool>.create();
    for (s in 0..run.sources.length) {
        let p = run.sourcePackage[s];
        remove.push(p != none64() && p != target)?;
    }
    for (i in 0..run.diagnostics.items.length) {
        let d = borrow run.diagnostics.items[i];
        if (d.isError && (d.file as usize) < remove.length && remove[d.file as usize]) {
            let p = run.sourcePackage[d.file as usize];
            if (firstError[p] == none64()) {
                firstError[p] = i;
            }
        }
    }
    var added = Diagnostics.create();
    var manifestFile = none();
    let root = borrow data.packages[target];
    for (position in 1..run.members.length) {
        let failed = run.members[position];
        if (firstError[failed] == none64()) {
            continue;
        }
        // The first direct dependency, in the manifest's order, that reaches it.
        var through: usize = none64();
        for (k in 0..root.dependencies.length) {
            let d = root.dependencies[k] as usize;
            let reach = packageClosure(data, d)?;
            for (r in reach.view()) {
                if (r == failed) {
                    through = k;
                    break;
                }
            }
            if (through != none64()) {
                break;
            }
        }
        if (through == none64()) {
            continue;
        }
        if (manifestFile == none()) {
            manifestFile = truncate<u32>(run.sources.length);
            run.sources.push(manifestSource(data, target)?)?;
            run.sourcePackage.push(none64())?;
            run.sourceIsTest.push(false)?;
        }
        let first = borrow run.diagnostics.items[firstError[failed]];
        var note = copyBytes("its first error: error[".bytes())?;
        appendCode(mut note, first.code)?;
        appendText(mut note, "]: ")?;
        appendBytes(mut note, first.message.view())?;
        var notes = Vector<DiagnosticNote>.create();
        notes.push(DiagnosticNote { file: first.file, start: first.start, end: first.end, message: note })?;
        let message = dependencyFailureMessage(data, failed, root.dependencies[through] as usize)?;
        added.errorWithNotes(
            dependencyFailure(),
            manifestFile,
            root.dependencyStarts[through],
            root.dependencyEnds[through],
            message,
            notes,
        )?;
    }
    run.diagnostics.removeFiles(remove.view());
    while (added.items.length > 0) {
        var reversed = Vector<Diagnostic>.create();
        while (added.items.length > 0) {
            reversed.push(added.items.pop()!)?;
        }
        while (reversed.length > 0) {
            run.diagnostics.items.push(reversed.pop()!)?;
        }
    }
    run.errors = truncate<u64>(run.diagnostics.count(true));
    run.warnings = truncate<u64>(run.diagnostics.count(false));
    return Ok();
}

/// The manifest of `package` as a source diagnostics can name, from the current directory.
fn manifestSource(data: borrow WorkspaceData, package: usize) -> Result<SourceText, AllocError> {
    let manifest = borrow data.report.sources[data.packages[package].manifestFile as usize];
    let directory = data.packages[package].info.directory.view();
    let path = joinPath(directory, manifestName().bytes())?;
    var shown = Vector<u8>.create();
    match (currentDirectory()) {
        Ok(cwd) => { shown = pathFrom(cwd.view(), path.view())?; }
        Err(_) => { shown = copyBytes(path.view())?; }
    }
    var source = SourceText.create(shown.view(), manifest.text.view())?;
    source.package = copyBytes(data.packages[package].info.name.view())?;
    source.packagePath = copyBytes(manifestName().bytes())?;
    return Ok(source);
}

/// The records of every package of `members` but `skip` the cache holds, level by level: a package's key needs its
/// dependencies' interface hashes, so one whose dependency has none has none either.
fn lookUpRecords(
    options: borrow Options,
    cache: borrow RecordCache,
    data: borrow mut WorkspaceData,
    members: borrow Vector<usize>,
    skip: usize,
    records: borrow mut Vector<InterfaceRecord?>,
) -> Result<void, AllocError> {
    let profile = profileText(options)?;
    for (level in 0..data.levels) {
        for (m in members.view()) {
            if (m == skip || data.packages[m].level != level) {
                continue;
            }
            let key = match (interfaceKey(options, cache.identity.view(), data, m, records)?) {
                Some(k) => k,
                null => { continue; }
            };
            match (lookUpRecord(cache, data.packages[m].info.name.view(), key.view(), profile.view())?) {
                Some(r) => { records[m] = r; }
                null => {}
            }
        }
    }
    return Ok();
}

/// Makes the records `run` can give, level by level, and stores them: of each package checked there in full that
/// wanted one (run.recorded) and whose closure has no error, from what the effect checker found; and in dependency
/// mode of the package checked, whatever it found (`run.record`).
fn makeRecords(
    options: borrow Options,
    cache: borrow RecordCache,
    data: borrow mut WorkspaceData,
    run: borrow mut PackageRun,
    dependencyMode: bool,
    records: borrow mut Vector<InterfaceRecord?>,
) -> Result<void, AllocError> {
    for (level in 0..data.levels) {
        for (position in 0..run.members.length) {
            let member = run.members[position];
            if (data.packages[member].level != level || !run.recorded[position]) {
                continue;
            }
            let ownRecord = position == 0 && dependencyMode;
            if (!ownRecord) {
                if (!run.effectsRecorded || records[member] != null) {
                    continue;
                }
                var clean = true;
                let reach = packageClosure(data, member)?;
                for (r in reach.view()) {
                    if (run.failed[r]) {
                        clean = false;
                    }
                }
                if (!clean) {
                    continue;
                }
            }
            var record = blankRecord();
            record.package = copyBytes(data.packages[member].info.name.view())?;
            record.banner = copyBytes(compilerBanner().bytes())?;
            record.profile = profileText(options)?;
            record.opaque = run.opaque[position] || !run.effectsRecorded;
            if (ownRecord) {
                record.errors = run.errors;
                record.warnings = run.warnings;
                record.phase = run.phase;
            } else {
                for (s in 0..run.sources.length) {
                    if (run.sourcePackage[s] != member) {
                        continue;
                    }
                    for (d in run.diagnostics.items.view()) {
                        if (d.file as usize == s && !d.isError) {
                            record.warnings += 1;
                        }
                    }
                }
            }
            if (run.effectsRecorded) {
                for (f in run.functions.view()) {
                    if (f.package as usize == position) {
                        record.functions.push(copyRecordedEffects(f, 0)?)?;
                    }
                }
            }
            record.interfaceHash = interfaceHash(run, data, position, record, records)?;
            let key = match (interfaceKey(options, cache.identity.view(), data, member, records)?) {
                Some(k) => k,
                null => { continue; }
            };
            record.key = key;
            if (cache.identity.length > 0) {
                storeRecord(cache, record)?;
            }
            if (ownRecord) {
                run.record = copyRecord(record)?;
                run.hasRecord = true;
            }
            records[member] = record;
        }
    }
    return Ok();
}

/// The bytes of `package`'s sources.
fn sourceBytes(data: borrow WorkspaceData, package: usize) -> u64 {
    var total: u64 = 0;
    for (t in data.packages[package].texts.view()) {
        total += t.length as u64;
    }
    return total;
}

/// What checking `package` alone, its dependencies from their records, costs, in the bytes a check of the whole
/// program costs per byte: its own sources, a quarter of its dependencies' (parsed and declared, their bodies
/// skipped), and the libraries' check (about 200 kB's worth: a leaf's check takes 0.06 s where 10 MB take 2.7 s).
fn recordCost(data: borrow WorkspaceData, package: usize) -> Result<u64, AllocError> {
    var cost: u64 = 200000 + sourceBytes(data, package);
    let reach = packageClosure(data, package)?;
    for (k in 1..reach.length) {
        cost += sourceBytes(data, reach[k]) / 4;
    }
    return Ok(cost);
}

/// Makes the records missing at the bottom of the closure first, when they are few and cheap: a dependency whose own
/// dependencies all have records, checked alone in dependency mode, gives its record, and with it the keys of the
/// packages above it, whose records may then be found. An edit in a package low in the graph (a comment, a body)
/// leaves its interface hash, so the records above it hold again. Only a package one of whose dependents has had a
/// record is made so (in a cold cache, none), at most a twentieth of the whole program's check is spent, and only
/// while the records made let more be found: past that, the check of the whole closure is no slower than making them,
/// and makes them too.
fn makeMissingRecords(
    options: borrow Options,
    cache: borrow RecordCache,
    data: borrow mut WorkspaceData,
    members: borrow Vector<usize>,
    target: usize,
    records: borrow mut Vector<InterfaceRecord?>,
) -> Result<void, AllocError> {
    var whole: u64 = 200000;
    for (m in members.view()) {
        whole += sourceBytes(data, m);
    }
    let budget = whole / 20;
    var spent: u64 = 0;
    var tried = Vector<bool>.create();
    while (tried.length < data.packages.length) {
        tried.push(false)?;
    }
    // Worth making a record only where a package that depends on it has had one (under any key): in a cold cache
    // none has, and nothing is made.
    let seen = packagesWithRecords(cache, data)?;
    for (m in members.view()) {
        var wanted = false;
        for (q in members.view()) {
            if (q == target || !seen[q]) {
                continue;
            }
            for (d in data.packages[q].dependencies.view()) {
                if (d as usize == m) {
                    wanted = true;
                }
            }
        }
        if (!wanted) {
            tried[m] = true;
        }
    }
    loop {
        // One level at a time, the lowest with a package to make, then what the cache holds above it.
        var made = false;
        var exhausted = false;
        var level: u32 = 0;
        var found = false;
        while (level < data.levels && !found) {
            for (m in members.view()) {
                if (data.packages[m].level == level && missingReady(data, m, target, tried, records)) {
                    found = true;
                }
            }
            if (!found) {
                level += 1;
            }
        }
        if (!found) {
            return Ok();
        }
        for (m in members.view()) {
            if (data.packages[m].level != level || !missingReady(data, m, target, tried, records)) {
                continue;
            }
            let cost = recordCost(data, m)?;
            if (spent + cost > budget) {
                exhausted = true;
                break;
            }
            spent += cost;
            tried[m] = true;
            let closure = packageClosure(data, m)?;
            var useRecord = Vector<bool>.create();
            var recordWanted = Vector<bool>.create();
            for (p in 0..data.packages.length) {
                var use = false;
                match (borrow records[p]) {
                    Some(r) => { use = !r.opaque && r.errors == 0; }
                    null => {}
                }
                useRecord.push(use)?;
                recordWanted.push(p == m)?;
            }
            var run = checkPackageRun(options, data, m, closure, records, useRecord, recordWanted, true, false, false);
            if (run.failure != 0) {
                return Ok();
            }
            reportFailedDependencies(mut run, data)?;
            makeRecords(options, cache, data, mut run, true, records)?;
            made = made || records[m] != null;
        }
        if (!made) {
            return Ok();
        }
        // Go on only while the records made let the cache's be found: in a cold cache they do not.
        let before = recordCount(records);
        lookUpRecords(options, cache, data, members, target, records)?;
        if (exhausted || recordCount(records) == before) {
            return Ok();
        }
    }
}

/// By package index: whether the cache holds a record of it, under any key (`<package>-<key>.rec`, the key 64
/// hexadecimal digits).
fn packagesWithRecords(cache: borrow RecordCache, data: borrow WorkspaceData) -> Result<Vector<bool>, AllocError> {
    var seen = Vector<bool>.create();
    while (seen.length < data.packages.length) {
        seen.push(false)?;
    }
    let names = match (Directory.list(StringView.fromUtf8(cache.directory.view())!)) {
        Ok(n) => n,
        Err(_) => { return Ok(seen); }
    };
    for (name in names.view()) {
        let bytes = name.view().bytes();
        if (bytes.length <= 69 || bytes[bytes.length - 69] != '-' ||
            !sameBytes(bytes[(bytes.length - 4)..], ".rec".bytes())) {
            continue;
        }
        let package = bytes[..(bytes.length - 69)];
        for (p in 0..data.packages.length) {
            if (sameBytes(data.packages[p].info.name.view(), package)) {
                seen[p] = true;
            }
        }
    }
    return Ok(seen);
}

/// Whether `m`, not `target`, has no record yet, has not been tried, and its dependencies all have theirs.
fn missingReady(
    data: borrow WorkspaceData,
    m: usize,
    target: usize,
    tried: borrow Vector<bool>,
    records: borrow Vector<InterfaceRecord?>,
) -> bool {
    if (m == target || tried[m] || records[m] != null) {
        return false;
    }
    for (d in data.packages[m].dependencies.view()) {
        if (records[d as usize] == null) {
            return false;
        }
    }
    return true;
}

fn recordCount(records: borrow Vector<InterfaceRecord?>) -> usize {
    var count: usize = 0;
    for (k in 0..records.length) {
        if (records[k] != null) {
            count += 1;
        }
    }
    return count;
}

/// The index of the package named `name` in the lock, or none64().
fn lockPackageNamed(data: borrow WorkspaceData, name: Slice<u8>) -> usize {
    for (p in 0..data.packages.length) {
        if (sameBytes(data.packages[p].info.name.view(), name)) {
            return p;
        }
    }
    return none64();
}

/// `check` in a package (ADR 0082 §2.7): the package of the current directory, or `--package`'s; with --all, every
/// package of the lock; with --record, the check that makes a dependency's record, which it prints.
fn packageCheckCommand(given: Options) -> i32 {
    var options = given;
    var data = WorkspaceData {
        packages: Vector<WorkspacePackage>.create(),
        report: PackageReport.create(),
        levels: 0,
        digests: Vector<Vector<u8>>.create(),
    };
    let loaded = loadWorkspaceData(mut options, mut data);
    if (loaded != 0) {
        return loaded;
    }
    var target: usize = 0;
    if (options.checkPackage.length > 0) {
        target = lockPackageNamed(data, options.checkPackage.view());
        if (target == none64()) {
            var message = copyBytes("ceesafec: there is no package '".bytes())!;
            appendBytes(mut message, options.checkPackage.view())!;
            appendText(mut message, "' in this package's lock; its packages: ")!;
            let byName = packagesByName(data);
            for (k in 0..byName.length) {
                if (k > 0) {
                    appendText(mut message, ", ")!;
                }
                appendBytes(mut message, data.packages[byName[k]].info.name.view())!;
            }
            message.push('\n')!;
            Console.writeError(StringView.fromUtf8(message.view())!);
            return 2;
        }
    }
    let members = packageClosure(data, target)!;
    let unread = loadTexts(mut data, members);
    if (unread != 0) {
        return unread;
    }
    var records = Vector<InterfaceRecord?>.create();
    var useRecord = Vector<bool>.create();
    var recordWanted = Vector<bool>.create();
    for (p in 0..data.packages.length) {
        records.push(null)!;
        useRecord.push(false)!;
        recordWanted.push(false)!;
    }
    // Records only where they can help: a usable cache, a package with dependencies, an executable to key them by.
    var cache = openRecordCache()!;
    var useCache = cache.usable && (members.length > 1 || options.recordOnly);
    if (useCache) {
        useCache = ensureCompilerIdentity(mut cache)!;
    }
    if (useCache) {
        lookUpRecords(options, cache, mut data, members, target, mut records)!;
        makeMissingRecords(options, cache, mut data, members, target, mut records)!;
    }
    for (k in 1..members.length) {
        let m = members[k];
        match (borrow records[m]) {
            Some(r) => {
                useRecord[m] = !r.opaque && r.errors == 0 &&
                    (!options.checkAll || (r.warnings == 0 && data.packages[m].tests.length == 0));
            }
            null => {}
        }
        // A package checked here in full gets its record from this check, but not with its tests in it (--all).
        recordWanted[m] = useCache && !useRecord[m] && (!options.checkAll || data.packages[m].tests.length == 0);
    }
    if (options.recordOnly) {
        recordWanted[target] = true;
    }
    if (options.checkAll) {
        return checkAllCommand(options, cache, mut data, members, useCache, records, useRecord, recordWanted);
    }
    var run = checkPackageRun(
        options,
        data,
        target,
        members,
        records,
        useRecord,
        recordWanted,
        options.recordOnly,
        false,
        false,
    );
    if (run.failure != 0) {
        return run.failure;
    }
    var status: i32 = 0;
    reportFailedDependencies(mut run, data)!;
    if (!options.recordOnly) {
        status = report(options.json, run.diagnostics, run.sources);
    }
    if (useCache || options.recordOnly) {
        // The answer is out: now the records this check can give, for the next.
        flushStandardOutput();
        makeRecords(options, cache, mut data, mut run, options.recordOnly, mut records)!;
    }
    if (options.recordOnly) {
        if (!run.hasRecord) {
            return 1;
        }
        let bytes = encodeRecord(run.record)!;
        Console.writeBytes(bytes.view());
        return 0;
    }
    return status;
}

/// `check --all`: every package of the lock checked together, their tests included, in rounds. The first round
/// checks them all; where it stopped early (errors before the effect checks, which stop what follows, as in any
/// check), the next checks again the packages none of whose closure had errors, so that each package's own errors
/// are found as its own check would find them, and so on. A package's diagnostics are those of the last round that
/// checked it.
fn checkAllCommand(
    options: borrow Options,
    cache: borrow RecordCache,
    data: borrow mut WorkspaceData,
    members: borrow Vector<usize>,
    useCache: bool,
    given: Vector<InterfaceRecord?>,
    useRecord: borrow Vector<bool>,
    recordWanted: borrow Vector<bool>,
) -> i32 {
    var records = given;
    var runs = Vector<PackageRun>.create();
    var remaining = Vector<usize>.create();
    for (m in members.view()) {
        remaining.push(m)!;
    }
    loop {
        let first = remaining[0];
        let run = checkPackageRun(
            options,
            data,
            first,
            remaining,
            records,
            useRecord,
            recordWanted,
            false,
            true,
            first != 0,
        );
        if (run.failure != 0) {
            return run.failure;
        }
        var next = Vector<usize>.create();
        for (p in remaining.view()) {
            var clean = true;
            let reach = packageClosure(data, p)!;
            for (r in reach.view()) {
                if (run.failed[r]) {
                    clean = false;
                }
            }
            if (clean) {
                next.push(p)!;
            }
        }
        let complete = run.phase == 0 || run.phase == 5;
        runs.push(run)!;
        if (complete || next.length == 0 || next.length == remaining.length) {
            break;
        }
        remaining = next;
    }
    let status = reportAll(options, data, runs);
    if (useCache) {
        flushStandardOutput();
        for (k in 0..runs.length) {
            makeRecords(options, cache, data, mut runs[k], false, mut records)!;
        }
    }
    return status;
}

/// One diagnostic of `check --all`'s report: its round, its index there, and its package (the round's first when its
/// file has none).
struct ReportedDiagnostic {
    run: usize;
    index: usize;
    package: usize; // by index
}

/// `check --all`'s report (tooling.md §5.1): each package's diagnostics from the last round that checked it, sorted
/// by package name, file and position, the same in both forms; as JSON one document with a `packages` summary of each
/// package's errors and warnings, counted by the diagnostics' packages; as text, the diagnostics, then a line per
/// package with any.
fn reportAll(options: borrow Options, data: borrow WorkspaceData, runs: borrow Vector<PackageRun>) -> i32 {
    var last = Vector<usize>.create(); // by package: the last round that checked it
    while (last.length < data.packages.length) {
        last.push(none64())!;
    }
    for (r in 0..runs.length) {
        for (m in runs[r].members.view()) {
            last[m] = r;
        }
    }
    var order = Vector<ReportedDiagnostic>.create();
    for (r in 0..runs.length) {
        let run = borrow runs[r];
        for (i in 0..run.diagnostics.items.length) {
            let file = run.diagnostics.items[i].file as usize;
            var package = run.package;
            if (file < run.sourcePackage.length && run.sourcePackage[file] != none64()) {
                package = run.sourcePackage[file];
            }
            if (last[package] == r) {
                order.push(ReportedDiagnostic { run: r, index: i, package: package })!;
            }
        }
    }
    sortReported(runs, data, mut order);
    var errors = Vector<i64>.create();
    var warnings = Vector<i64>.create();
    while (errors.length < data.packages.length) {
        errors.push(0)!;
        warnings.push(0)!;
    }
    var totalErrors: i64 = 0;
    var totalWarnings: i64 = 0;
    for (o in order.view()) {
        if (runs[o.run].diagnostics.items[o.index].isError) {
            errors[o.package] += 1;
            totalErrors += 1;
        } else {
            warnings[o.package] += 1;
            totalWarnings += 1;
        }
    }
    let byName = packagesByName(data);
    if (options.json) {
        var json = JsonWriter.create();
        json.startObject()!;
        json.name("version")!;
        json.number(1)!;
        json.name("errors")!;
        json.number(totalErrors)!;
        json.name("warnings")!;
        json.number(totalWarnings)!;
        json.name("diagnostics")!;
        json.startArray()!;
        for (o in order.view()) {
            writeJsonDiagnostic(mut json, runs[o.run].diagnostics.items[o.index], runs[o.run].sources)!;
        }
        json.endArray()!;
        json.name("packages")!;
        json.startArray()!;
        for (p in byName.view()) {
            json.startObject()!;
            json.name("name")!;
            json.stringBytes(data.packages[p].info.name.view())!;
            json.name("errors")!;
            json.number(errors[p])!;
            json.name("warnings")!;
            json.number(warnings[p])!;
            json.endObject()!;
        }
        json.endArray()!;
        json.endObject()!;
        Console.writeBytes(json.out.view());
        Console.writeLine("");
    } else {
        var text = Vector<u8>.create();
        for (o in order.view()) {
            renderAny(mut text, runs[o.run].diagnostics.items[o.index], runs[o.run].sources)!;
        }
        for (p in byName.view()) {
            let e = errors[p];
            let w = warnings[p];
            if (e > 0 || w > 0) {
                appendText(mut text, "ceesafec: package '")!;
                appendBytes(mut text, data.packages[p].info.name.view())!;
                appendText(mut text, "': ")!;
                appendDecimal(mut text, truncate<u64>(e))!;
                appendText(mut text, if (e == 1) " error, " else " errors, ")!;
                appendDecimal(mut text, truncate<u64>(w))!;
                appendText(mut text, if (w == 1) " warning\n" else " warnings\n")!;
            }
        }
        match (StringView.fromUtf8(text.view())) {
            Some(t) => { Console.writeError(t); }
            null => { Console.writeBytes(text.view()); }
        }
    }
    return if (totalErrors > 0) 1 else 0;
}

/// Whether diagnostic `a` comes before `b`: by package name, file (as shown) and start, then in the order found.
fn reportedBefore(
    runs: borrow Vector<PackageRun>,
    data: borrow WorkspaceData,
    a: ReportedDiagnostic,
    b: ReportedDiagnostic,
) -> bool {
    let byPackage = compareBytes(data.packages[a.package].info.name.view(), data.packages[b.package].info.name.view());
    if (byPackage != 0) {
        return byPackage < 0;
    }
    let ra = borrow runs[a.run];
    let rb = borrow runs[b.run];
    let da = borrow ra.diagnostics.items[a.index];
    let db = borrow rb.diagnostics.items[b.index];
    let noFile = "".bytes();
    let fa = if ((da.file as usize) < ra.sources.length) ra.sources[da.file as usize].shownPath() else noFile;
    let fb = if ((db.file as usize) < rb.sources.length) rb.sources[db.file as usize].shownPath() else noFile;
    let byFile = compareBytes(fa, fb);
    if (byFile != 0) {
        return byFile < 0;
    }
    if (da.start != db.start) {
        return da.start < db.start;
    }
    if (a.run != b.run) {
        return a.run < b.run;
    }
    return a.index < b.index;
}

/// The packages' indices in the order of their names.
fn packagesByName(data: borrow WorkspaceData) -> Vector<usize> {
    var order = Vector<usize>.create();
    for (p in 0..data.packages.length) {
        order.push(p)!;
        var at = order.length - 1;
        while (at > 0 && lessBytes(
            data.packages[order[at]].info.name.view(),
            data.packages[order[at - 1]].info.name.view(),
        )) {
            order.swap(at, at - 1);
            at -= 1;
        }
    }
    return order;
}

/// Sorts `order` by reportedBefore: a merge sort, stable.
fn sortReported(
    runs: borrow Vector<PackageRun>,
    data: borrow WorkspaceData,
    order: borrow mut Vector<ReportedDiagnostic>,
) {
    var width: usize = 1;
    let n = order.length;
    var scratch = Vector<ReportedDiagnostic>.create();
    while (width < n) {
        scratch.truncate(0);
        var lo: usize = 0;
        while (lo < n) {
            let mid = if (lo + width < n) lo + width else n;
            let hi = if (lo + 2 * width < n) lo + 2 * width else n;
            var i = lo;
            var j = mid;
            while (i < mid || j < hi) {
                if (j >= hi || (i < mid && !reportedBefore(runs, data, order[j], order[i]))) {
                    scratch.push(order[i])!;
                    i += 1;
                } else {
                    scratch.push(order[j])!;
                    j += 1;
                }
            }
            lo = hi;
        }
        for (k in 0..n) {
            order[k] = scratch[k];
        }
        width *= 2;
    }
}
