// The interface records' cache (ADR 0082 §2.7): `$CEESAFE_HOME/cache/records/`, beside where the objects will live
// (`cache/objects/`, §2.6). A record is a cache of a check this compiler made, never a promise from outside, so any
// doubt is a miss and a recheck:
// - the cache directories are made with mode 0700, and used only while they, and each record, are owned by this user
//   and not writable by the group or others. `$CEESAFE_HOME` and the directories above it are trusted as they are
//   named; `cache` and `records` are opened once, neither through a symbolic link, and their descriptors checked;
// - a record is opened from the descriptor of `records` (openat, never through a symbolic link), and read from the
//   descriptor whose owner and mode were checked; one that cannot be read, is not complete (its last field is the
//   SHA-256 of the rest) or names another key, banner, profile or package, is a miss;
// - a record is written to a new temporary name (created exclusively) in that directory and renamed there, so agents
//   checking at once share the cache and a reader never sees half a record.
// Owners and modes come from fstat(2), whose layout this file knows for macOS and Linux on arm64 and x86-64; on any
// other system (Windows included) no record is read or written, and every check is whole.
//
// A record is a sequence of fields, each `<length>:<bytes>\n`, in this order: the magic `ceesafe-interface-record`,
// the format (`2`), the key, the banner, the package, the profile, errors, warnings, the phase of its first error,
// opaque (`0`/`1`), the interface hash, the number of functions; then per function its path in the package, its
// declaration's offset, its effects, and for sleep, alloc, suspend and write a chain (the number of steps, the steps,
// the end, truncated `0`/`1`, its rank); last, the SHA-256 (hexadecimal) of every byte before that field.

extern "C" {
    // POSIX's calls (ceesafec 0.8.0's runtime lets the compiler's own sources use them, as embedding.cee's). On
    // Windows, rt.h names the runtime's own (ceesafe_win_*), which fail: no record is read or written there.
    fn fstat(fd: i32, buffer: *mut u8) -> i32;
    fn chmod(path: *CChar, mode: u32) -> i32;
    fn pwrite(fd: i32, buffer: *u8, size: usize, offset: i64) -> isize;
    fn renameat(fromDirectory: i32, from: *CChar, toDirectory: i32, to: *CChar) -> i32;
    fn unlinkat(directory: i32, path: *CChar, flags: i32) -> i32;
    // macOS's system calls by number (executablePath): getpid (20) and proc_info (336).
    fn syscall(number: i32, ...) -> i32;
}

/// The record format; a change to what a record holds or means changes it.
fn recordFormat() -> StringView => "2";

/// What a record says of a package (ADR 0082 §2.7).
struct InterfaceRecord {
    key: Vector<u8>;
    banner: Vector<u8>;
    package: Vector<u8>;
    profile: Vector<u8>;
    errors: u64;
    warnings: u64;
    phase: u32; // of its first error: 0 none, 1 parse, 2 types, 3 per-function NIR checks, 4 instances, 5 later
    opaque: bool;
    interfaceHash: Vector<u8>;
    functions: Vector<RecordedEffects>;
}

/// The cache's directory, open, and this process's user, once the directory is known to be safe; `usable` false
/// otherwise.
struct RecordCache {
    usable: bool;
    directory: Vector<u8>; // its path, for messages
    directoryFd: i32;      // its descriptor, every record opened from it; -1 if not usable
    owner: u32;
    system: u32;          // hostSystem()
    layout: u32;          // statLayout()
    identity: Vector<u8>; // this ceesafec's executable (compilerIdentity), part of every key, once asked for
}

/// What fstat says of an open file: 1 a regular file, 2 a directory, 3 anything else; its permission bits; its owner.
struct FileFacts {
    kind: u32;
    mode: u32;
    owner: u32;
    size: u64;
}

/// The machine, from uname(2): its `machine` member follows four others, of 256 bytes each on macOS and 65 on Linux.
/// Safety: uname writes a struct utsname of at most 1,280 bytes (macOS) into the 2,048 given, during the call only.
fn hostMachine(system: u32) -> Result<Vector<u8>, AllocError> {
    var name = [0u8; 2048];
    let failed = unsafe { uname(borrow mut name[0] as *mut u8) };
    if (failed != 0 || (system != 1 && system != 2)) {
        return Ok(Vector<u8>.create());
    }
    let start: usize = if (system == 1) 1024 else 260;
    var end = start;
    while (end < 2048 && name[end] != 0) {
        end += 1;
    }
    return copyBytes(name[start..end]);
}

/// Where fstat puts the mode and the owner: 1 macOS arm64 (the 64-bit inode layout), 2 macOS x86-64 (the `fstat`
/// symbol's older layout), 3 Linux x86-64, 4 Linux arm64 (the generic layout); 0 unknown.
fn statLayout(system: u32) -> Result<u32, AllocError> {
    let machine = hostMachine(system)?;
    let m = machine.view();
    if (system == 1) {
        if (sameBytes(m, "arm64".bytes())) {
            return Ok(1);
        }
        if (sameBytes(m, "x86_64".bytes())) {
            return Ok(2);
        }
    } else if (system == 2) {
        if (sameBytes(m, "x86_64".bytes())) {
            return Ok(3);
        }
        if (sameBytes(m, "aarch64".bytes())) {
            return Ok(4);
        }
    }
    return Ok(0);
}

fn littleEndian(bytes: Slice<u8>, at: usize, size: usize) -> u32 => truncate<u32>(littleEndian64(bytes, at, size));

fn littleEndian64(bytes: Slice<u8>, at: usize, size: usize) -> u64 {
    var value: u64 = 0;
    var k = size;
    while (k > 0) {
        k -= 1;
        value = (value << 8) | bytes[at + k] as u64;
    }
    return value;
}

/// What fstat says of `fd`, or null if it fails or the layout is unknown.
/// Safety: fstat writes one struct stat, at most 144 bytes on the four layouts known, into the 512 given, during the
/// call only.
fn descriptorFacts(layout: u32, fd: i32) -> FileFacts? {
    if (layout == 0) {
        return null;
    }
    var buffer = [0u8; 512];
    let failed = unsafe { fstat(fd, borrow mut buffer[0] as *mut u8) };
    if (failed != 0) {
        return null;
    }
    let bytes = buffer[..];
    // Offsets of st_mode, st_uid and st_size, with the sizes of the first two.
    var mode: u32 = 0;
    var owner: u32 = 0;
    var facts = FileFacts { kind: 0, mode: 0, owner: 0, size: 0 };
    if (layout == 1) {
        mode = littleEndian(bytes, 4, 2);
        owner = littleEndian(bytes, 16, 4);
        facts.size = littleEndian64(bytes, 96, 8);
    } else if (layout == 2) {
        mode = littleEndian(bytes, 8, 2);
        owner = littleEndian(bytes, 12, 4);
        facts.size = littleEndian64(bytes, 72, 8);
    } else if (layout == 3) {
        mode = littleEndian(bytes, 24, 4);
        owner = littleEndian(bytes, 28, 4);
        facts.size = littleEndian64(bytes, 48, 8);
    } else {
        mode = littleEndian(bytes, 16, 4);
        owner = littleEndian(bytes, 24, 4);
        facts.size = littleEndian64(bytes, 48, 8);
    }
    let fileType = mode & 0xF000;
    facts.kind = if (fileType == 0x8000) 1 else if (fileType == 0x4000) 2 else 3;
    facts.mode = mode & 0xFFF;
    facts.owner = owner;
    return facts;
}

/// openat's flags on `layout`'s system: `what` 0 reads a file (O_RDONLY | O_NONBLOCK | O_CLOEXEC), 1 also never
/// through a symbolic link (| O_NOFOLLOW), 2 opens a directory that way (O_RDONLY | O_DIRECTORY | O_NOFOLLOW |
/// O_CLOEXEC), 3 creates a new file that way (O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC).
fn openFlags(layout: u32, what: u32) -> i32 {
    let mac = layout == 1 || layout == 2;
    let nonblock: u32 = if (mac) 0x4 else 0x800;
    let cloexec: u32 = if (mac) 0x1000000 else 0x80000;
    let nofollow: u32 = if (mac) 0x100 else if (layout == 4) 0x8000 else 0x20000;
    let directory: u32 = if (mac) 0x100000 else if (layout == 4) 0x4000 else 0x10000;
    let create: u32 = if (mac) 0xA00 else 0xC0; // O_CREAT | O_EXCL
    var flags: u32 = 1 | create | nofollow | cloexec;
    if (what == 0) {
        flags = nonblock | cloexec;
    } else if (what == 1) {
        flags = nonblock | cloexec | nofollow;
    } else if (what == 2) {
        flags = directory | nofollow | cloexec;
    }
    return truncate<i32>(flags);
}

/// The current directory for openat: AT_FDCWD.
fn currentDirectoryFd(layout: u32) -> i32 => if (layout == 1 || layout == 2) -2 else -100;

/// Opens `path`, relative to the directory `at` (currentDirectoryFd for a path from here), with `flags`; -1 if it
/// cannot be.
/// Safety: openat reads the NUL-terminated path during the call only.
fn openAt(at: i32, path: Slice<u8>, flags: i32) -> Result<i32, AllocError> {
    let input = match (cPath(path)?) {
        Some(p) => p,
        null => { return Ok(-1); }
    };
    let fd = unsafe { openat(at, borrow input[0] as *u8 as *CChar, flags) };
    return Ok(fd);
}

/// Opens `path` to read it: O_RDONLY | O_NONBLOCK | O_CLOEXEC; -1 if it cannot be.
fn openForReading(system: u32, path: Slice<u8>) -> Result<i32, AllocError> {
    let layout: u32 = if (system == 1) 1 else 3; // the flags read alike on each system's two layouts
    return openAt(currentDirectoryFd(layout), path, openFlags(layout, 0));
}

/// The facts of the file or directory at `path`, or null.
/// Safety: the descriptor is closed here, once.
fn pathFacts(system: u32, layout: u32, path: Slice<u8>) -> Result<FileFacts?, AllocError> {
    let fd = openForReading(system, path)?;
    if (fd < 0) {
        return Ok(null);
    }
    let facts = descriptorFacts(layout, fd);
    unsafe { close(fd); }
    return Ok(facts);
}

/// A directory this user owns, that no one else may write to.
fn privateDirectory(facts: FileFacts?, owner: u32) -> bool {
    return match (facts) {
        Some(f) => f.kind == 2 && f.owner == owner && (f.mode & 0x12) == 0,
        null => false,
    };
}

/// Makes `path` if it is missing, with mode 0700.
/// Safety: chmod reads the NUL-terminated path during the call only.
fn makePrivateDirectory(path: Slice<u8>) -> Result<void, AllocError> {
    let text = StringView.fromUtf8(path)!;
    match (File.kind(text)) {
        Ok(Some(_)) => { return Ok(); }
        _ => {}
    }
    match (makeDirectories(path)) {
        Ok() => {}
        Err(_) => { return Ok(); }
    }
    match (cPath(path)?) {
        Some(p) => {
            unsafe { chmod(borrow p[0] as *u8 as *CChar, 448); } // 0700
        }
        null => {}
    }
    return Ok();
}

/// The directory `name` in the open directory `at`, opened never through a symbolic link, if this user owns it and
/// no one else may write to it; else -1.
/// Safety: the descriptor is closed here unless it is returned.
fn openPrivateDirectory(layout: u32, at: i32, name: Slice<u8>, owner: u32) -> Result<i32, AllocError> {
    let fd = openAt(at, name, openFlags(layout, 2))?;
    if (fd < 0) {
        return Ok(-1);
    }
    if (!privateDirectory(descriptorFacts(layout, fd), owner)) {
        unsafe { close(fd); }
        return Ok(-1);
    }
    return Ok(fd);
}

/// The cache, made if missing: `$CEESAFE_HOME/cache/records`, usable only where owners and modes can be read and its
/// two directories belong to this user, who alone may write to them. Both are opened once, never through a symbolic
/// link, and `records` stays open: every record is opened from it.
/// Safety: the descriptor of `cache` is closed here, once.
fn openRecordCache() -> Result<RecordCache, AllocError> {
    var cache = RecordCache {
        usable: false,
        directory: Vector<u8>.create(),
        directoryFd: -1,
        owner: 0,
        system: hostSystem(),
        layout: 0,
        identity: Vector<u8>.create(),
    };
    let layout = statLayout(cache.system)?;
    cache.layout = layout;
    let home = defaultHome()?;
    if (layout == 0 || home.length == 0) {
        return Ok(cache);
    }
    // This user, as the owner of a directory just made for it.
    let probe = match (Directory.temporary()) {
        Ok(d) => d,
        Err(_) => { return Ok(cache); }
    };
    let probeFacts = pathFacts(cache.system, layout, probe.view().bytes())?;
    match (Directory.remove(probe.view())) {
        Ok() => {}
        Err(_) => {}
    }
    match (probeFacts) {
        Some(f) => { cache.owner = f.owner; }
        null => { return Ok(cache); }
    }
    let top = joinPath(home.view(), "cache".bytes())?;
    let records = joinPath(top.view(), "records".bytes())?;
    makePrivateDirectory(top.view())?;
    makePrivateDirectory(records.view())?;
    let topFd = openPrivateDirectory(layout, currentDirectoryFd(layout), top.view(), cache.owner)?;
    if (topFd < 0) {
        return Ok(cache);
    }
    let recordsFd = openPrivateDirectory(layout, topFd, "records".bytes(), cache.owner)?;
    unsafe { close(topFd); }
    if (recordsFd < 0) {
        return Ok(cache);
    }
    cache.directory = records;
    cache.directoryFd = recordsFd;
    cache.usable = true;
    return Ok(cache);
}

/// This ceesafec's identity, as a key holds it beside the banner: the SHA-256 of its executable's bytes, read once
/// per process (builds of one version share its banner, and a record proved by one build is not the next build's to
/// trust). False if the executable cannot be found or read: then no record is used.
fn ensureCompilerIdentity(cache: borrow mut RecordCache) -> Result<bool, AllocError> {
    if (cache.identity.length > 0) {
        return Ok(true);
    }
    let path = match (executablePath(cache.system)?) {
        Some(p) => p,
        null => { return Ok(false); }
    };
    match (hashFile(cache.system, cache.layout, path.view())?) {
        Some(digest) => {
            cache.identity = digest;
            return Ok(true);
        }
        null => { return Ok(false); }
    }
}

/// The SHA-256 (hexadecimal) of the regular file at `path`, or null if it cannot be read.
/// Safety: the descriptor is closed here, once; pread writes at most the 65,536 bytes asked into `buffer`.
fn hashFile(system: u32, layout: u32, path: Slice<u8>) -> Result<Vector<u8>?, AllocError> {
    let fd = openForReading(system, path)?;
    if (fd < 0) {
        return Ok(null);
    }
    let regular = match (descriptorFacts(layout, fd)) {
        Some(f) => f.kind == 1,
        null => false,
    };
    if (!regular) {
        unsafe { close(fd); }
        return Ok(null);
    }
    var sha = Sha256.create();
    var buffer = [0u8; 65536];
    var at: i64 = 0;
    var failed = false;
    loop {
        let n = unsafe { pread(fd, borrow mut buffer[0] as *mut u8, 65536, at) };
        if (n < 0) {
            failed = true;
            break;
        }
        if (n == 0) {
            break;
        }
        sha.append(buffer[..truncate<usize>(n)]);
        at += n as i64;
    }
    unsafe { close(fd); }
    if (failed) {
        return Ok(null);
    }
    var digest = Vector<u8>.create();
    appendHexDigest(mut digest, sha.finish())?;
    return Ok(digest);
}

/// The running executable itself, as the system knows it, never as it was named when started (`argv[0]` and `PATH`
/// are the caller's to choose): Linux's /proc/self/exe; on macOS the path of the process's executable from the
/// kernel (proc_info's PROC_PIDPATHINFO, what proc_pidpath(3) asks), its real path; null elsewhere.
/// Safety: proc_info writes at most the 4,096 bytes given (PROC_PIDPATHINFO_MAXSIZE) into `buffer`, during the call
/// only; getpid takes no argument.
fn executablePath(system: u32) -> Result<Vector<u8>?, AllocError> {
    if (system == 2) {
        return Ok(copyBytes("/proc/self/exe".bytes())?);
    }
    if (system != 1) {
        return Ok(null);
    }
    var buffer = [0u8; 4096];
    let pid = unsafe { syscall(20) };
    let failed = unsafe { syscall(336, 2, pid, 11, 0u64, borrow mut buffer[0] as *mut u8, 4096) };
    if (pid <= 0 || failed < 0) {
        return Ok(null);
    }
    var length: usize = 0;
    while (length < 4096 && buffer[length] != 0) {
        length += 1;
    }
    if (length == 0 || length == 4096 || buffer[0] != '/') {
        return Ok(null);
    }
    return realPath(buffer[..length]);
}

/// The record's file name in the cache: `<package>-<key>.rec`, the package's name for whoever looks, the key for the
/// cache. Null if the package's name would make it a path (names are checked by the manifest's rules: this is a
/// second guard).
fn recordName(package: Slice<u8>, key: Slice<u8>) -> Result<Vector<u8>?, AllocError> {
    for (b in package) {
        if (b == '/' || b == '\\' || b == 0) {
            return Ok(null);
        }
    }
    if (package.length == 0 || package[0] == '.') {
        return Ok(null);
    }
    var name = copyBytes(package)?;
    name.push('-')?;
    appendBytes(mut name, key)?;
    appendText(mut name, ".rec")?;
    return Ok(name);
}

/// The bytes of the record file `name` in the cache's directory, if it is a regular file this user owns that no one
/// else may write to; opened from the directory's descriptor, never through a symbolic link, and read from the
/// descriptor that was checked.
/// Safety: the descriptor is closed here, once; pread writes at most the 65,536 bytes asked into `buffer`.
fn readRecordFile(cache: borrow RecordCache, name: Slice<u8>) -> Result<Vector<u8>?, AllocError> {
    let fd = openAt(cache.directoryFd, name, openFlags(cache.layout, 1))?;
    if (fd < 0) {
        return Ok(null);
    }
    let trusted = match (descriptorFacts(cache.layout, fd)) {
        Some(f) => f.kind == 1 && f.owner == cache.owner && (f.mode & 0x12) == 0,
        null => false,
    };
    if (!trusted) {
        unsafe { close(fd); }
        return Ok(null);
    }
    var bytes = Vector<u8>.create();
    var buffer = [0u8; 65536];
    var failed = false;
    loop {
        let n = unsafe { pread(fd, borrow mut buffer[0] as *mut u8, 65536, truncate<i64>(bytes.length)) };
        if (n < 0) {
            failed = true;
            break;
        }
        if (n == 0) {
            break;
        }
        appendBytes(mut bytes, buffer[..truncate<usize>(n)])?;
    }
    unsafe { close(fd); }
    if (failed) {
        return Ok(null);
    }
    return Ok(bytes);
}

/// The record of `package` under `key`, if the cache holds a valid one: complete, and naming this key, banner,
/// profile and package.
fn lookUpRecord(
    cache: borrow RecordCache,
    package: Slice<u8>,
    key: Slice<u8>,
    profile: Slice<u8>,
) -> Result<InterfaceRecord?, AllocError> {
    if (!cache.usable) {
        return Ok(null);
    }
    let name = match (recordName(package, key)?) {
        Some(n) => n,
        null => { return Ok(null); }
    };
    let bytes = match (readRecordFile(cache, name.view())?) {
        Some(b) => b,
        null => { return Ok(null); }
    };
    let record = match (decodeRecord(bytes.view())?) {
        Some(r) => r,
        null => { return Ok(null); }
    };
    if (!sameBytes(record.key.view(), key) || !sameBytes(record.banner.view(), compilerBanner().bytes()) ||
        !sameBytes(record.profile.view(), profile) || !sameBytes(record.package.view(), package)) {
        return Ok(null);
    }
    return Ok(record);
}

/// Stores `record`: written under a new name created for it alone (mode 0600) in the cache's directory, then renamed
/// over the record's name there, both from the directory's descriptor. A failure leaves the cache as it was: the
/// record stays this process's only.
/// Safety: openat, renameat and unlinkat read their NUL-terminated names during the call only; pwrite reads at most
/// `size` bytes of the record; the descriptor is closed here, once.
fn storeRecord(cache: borrow RecordCache, record: borrow InterfaceRecord) -> Result<void, AllocError> {
    if (!cache.usable) {
        return Ok();
    }
    let bytes = encodeRecord(record)?;
    let name = match (recordName(record.package.view(), record.key.view())?) {
        Some(n) => n,
        null => { return Ok(); }
    };
    var temporary = Vector<u8>.create();
    var fd: i32 = -1;
    var attempt: u64 = 0;
    while (fd < 0 && attempt < 16) {
        temporary = copyBytes(name.view())?;
        appendText(mut temporary, ".tmp-")?;
        appendDecimal(mut temporary, Timer.now())?;
        temporary.push('-')?;
        appendDecimal(mut temporary, attempt)?;
        let input = match (cPath(temporary.view())?) {
            Some(p) => p,
            null => { return Ok(); }
        };
        fd = unsafe { openat(cache.directoryFd, borrow input[0] as *u8 as *CChar, openFlags(cache.layout, 3), 384) };
        attempt += 1;
    }
    if (fd < 0) {
        return Ok();
    }
    var written: usize = 0;
    var failed = false;
    while (written < bytes.length) {
        let rest = bytes.view();
        let n = unsafe { pwrite(fd, borrow rest[written] as *u8, bytes.length - written, truncate<i64>(written)) };
        if (n <= 0) {
            failed = true;
            break;
        }
        written += truncate<usize>(n);
    }
    unsafe { close(fd); }
    let from = cPath(temporary.view())?;
    let to = cPath(name.view())?;
    if (from == null || to == null) {
        return Ok();
    }
    let source = from!;
    let target = to!;
    var renamed: i32 = -1;
    if (!failed) {
        renamed = unsafe { renameat(
            cache.directoryFd,
            borrow source[0] as *u8 as *CChar,
            cache.directoryFd,
            borrow target[0] as *u8 as *CChar,
        ) };
    }
    if (renamed != 0) {
        unsafe { unlinkat(cache.directoryFd, borrow source[0] as *u8 as *CChar, 0); }
    }
    return Ok();
}

// ---- The format ----

fn appendField(out: borrow mut Vector<u8>, bytes: Slice<u8>) -> Result<void, AllocError> {
    appendDecimal(out, bytes.length as u64)?;
    out.push(':')?;
    appendBytes(out, bytes)?;
    out.push('\n')?;
    return Ok();
}

fn appendNumberField(out: borrow mut Vector<u8>, value: u64) -> Result<void, AllocError> {
    var text = Vector<u8>.create();
    appendDecimal(mut text, value)?;
    return appendField(out, text.view());
}

fn encodeRecord(record: borrow InterfaceRecord) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    appendField(mut out, "ceesafe-interface-record".bytes())?;
    appendField(mut out, recordFormat().bytes())?;
    appendField(mut out, record.key.view())?;
    appendField(mut out, record.banner.view())?;
    appendField(mut out, record.package.view())?;
    appendField(mut out, record.profile.view())?;
    appendNumberField(mut out, record.errors)?;
    appendNumberField(mut out, record.warnings)?;
    appendNumberField(mut out, record.phase as u64)?;
    appendNumberField(mut out, if (record.opaque) 1 else 0)?;
    appendField(mut out, record.interfaceHash.view())?;
    appendNumberField(mut out, record.functions.length as u64)?;
    for (f in record.functions.view()) {
        appendField(mut out, f.path.view())?;
        appendNumberField(mut out, f.offset as u64)?;
        appendNumberField(mut out, f.effects as u64)?;
        for (chain in f.chains.view()) {
            appendNumberField(mut out, chain.steps.length as u64)?;
            for (step in chain.steps.view()) {
                appendField(mut out, step.view())?;
            }
            appendField(mut out, chain.terminal.view())?;
            appendNumberField(mut out, if (chain.truncated) 1 else 0)?;
            appendNumberField(mut out, chain.length as u64)?;
        }
    }
    var sha = Sha256.create();
    sha.append(out.view());
    var digest = Vector<u8>.create();
    appendHexDigest(mut digest, sha.finish())?;
    appendField(mut out, digest.view())?;
    return Ok(out);
}

/// Reads the fields of a record in order.
struct FieldReader {
    at: usize;
    ok: bool;

    fn next(borrow mut this, bytes: Slice<u8>) -> Result<Vector<u8>, AllocError> {
        var length: u64 = 0;
        var digits: usize = 0;
        while (this.ok && this.at < bytes.length && bytes[this.at] >= '0' && bytes[this.at] <= '9' && digits < 12) {
            length = length * 10 + (bytes[this.at] - '0') as u64;
            this.at += 1;
            digits += 1;
        }
        if (!this.ok || digits == 0 || this.at >= bytes.length || bytes[this.at] != ':') {
            this.ok = false;
            return Ok(Vector<u8>.create());
        }
        this.at += 1;
        let start = this.at;
        if (length > (bytes.length - start) as u64) {
            this.ok = false;
            return Ok(Vector<u8>.create());
        }
        let end = start + truncate<usize>(length);
        if (end >= bytes.length || bytes[end] != '\n') {
            this.ok = false;
            return Ok(Vector<u8>.create());
        }
        this.at = end + 1;
        return copyBytes(bytes[start..end]);
    }

    fn number(borrow mut this, bytes: Slice<u8>) -> Result<u64, AllocError> {
        let field = this.next(bytes)?;
        var value: u64 = 0;
        if (field.length == 0 || field.length > 19) {
            this.ok = false;
            return Ok(0);
        }
        for (b in field.view()) {
            if (b < '0' || b > '9') {
                this.ok = false;
                return Ok(0);
            }
            value = value * 10 + (b - '0') as u64;
        }
        return Ok(value);
    }
}

/// A record's bytes as a record; null if they are not one, whole and unchanged.
fn decodeRecord(bytes: Slice<u8>) -> Result<InterfaceRecord?, AllocError> {
    var r = FieldReader { at: 0, ok: true };
    let magic = r.next(bytes)?;
    let format = r.next(bytes)?;
    if (!r.ok || !sameBytes(magic.view(), "ceesafe-interface-record".bytes()) ||
        !sameBytes(format.view(), recordFormat().bytes())) {
        return Ok(null);
    }
    var record = InterfaceRecord {
        key: r.next(bytes)?,
        banner: r.next(bytes)?,
        package: r.next(bytes)?,
        profile: r.next(bytes)?,
        errors: r.number(bytes)?,
        warnings: r.number(bytes)?,
        phase: 0,
        opaque: false,
        interfaceHash: Vector<u8>.create(),
        functions: Vector<RecordedEffects>.create(),
    };
    let phase = r.number(bytes)?;
    record.phase = truncate<u32>(if (phase > 5) 5 else phase);
    record.opaque = r.number(bytes)? != 0;
    record.interfaceHash = r.next(bytes)?;
    let count = r.number(bytes)?;
    var k: u64 = 0;
    while (r.ok && k < count) {
        var entry = RecordedEffects {
            package: 0,
            path: r.next(bytes)?,
            offset: 0,
            effects: 0,
            chains: Vector<RecordedChain>.create(),
        };
        entry.offset = truncate<u32>(r.number(bytes)? & 0xFFFFFFFF);
        entry.effects = truncate<u32>(r.number(bytes)? & 0xFFFFFFFF);
        for (slot in 0..4usize) {
            var chain = emptyChain();
            let steps = r.number(bytes)?;
            var s: u64 = 0;
            while (r.ok && s < steps) {
                chain.steps.push(r.next(bytes)?)?;
                s += 1;
            }
            chain.terminal = r.next(bytes)?;
            chain.truncated = r.number(bytes)? != 0;
            chain.length = truncate<u32>(r.number(bytes)? & 0xFFFFFFFF);
            entry.chains.push(chain)?;
        }
        record.functions.push(entry)?;
        k += 1;
    }
    let body = r.at;
    let digest = r.next(bytes)?;
    if (!r.ok || r.at != bytes.length) {
        return Ok(null);
    }
    var sha = Sha256.create();
    sha.append(bytes[..body]);
    var expected = Vector<u8>.create();
    appendHexDigest(mut expected, sha.finish())?;
    if (!sameBytes(expected.view(), digest.view())) {
        return Ok(null);
    }
    return Ok(record);
}
