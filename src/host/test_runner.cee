// `ceesafec test` (ADR 0049): the generated harness, and the runner that builds it once and runs each test as a process
// of its own, reading its outcome from the harness's lines, the runtime's reports and its exit status.

/// A test the checker found: its name, whether it is async, and how its failure is shown (0 void: it cannot fail but by
/// panicking; 1 TestFailure; 2 IoError; 3 AsyncError; 4 another error type).
struct TestEntry {
    name: Vector<u8>;
    isAsync: bool;
    errorKind: u32;
    variants: Vector<Vector<u8>>; // for its own enum error type: each variant's pattern, so a failure names it
}

/// The patterns of the variants of `t`, a test's own enum error type (`Mine.Broke`, `Mine.Bad(_, _)`), so the harness
/// names the one returned (ADR 0049 §3.2); none for another type, or one the harness cannot name unqualified.
fn variantPatterns(c: borrow Checker, t: u32) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    let definition = c.types.info(t).enumDef;
    if (definition == none()) {
        return Ok(out);
    }
    let e = borrow c.types.enums[definition as usize];
    let name = c.typeName(t);
    if (e.item == none() || e.typeArguments.count > 0 || containsText(name, ".") || containsText(name, "<")) {
        return Ok(out);
    }
    for (v in e.variants.view()) {
        let variant = borrow c.types.variants[v as usize];
        var pattern = copyBytes(name)?;
        pattern.push('.')?;
        appendBytes(mut pattern, c.name(variant.name))?;
        if (variant.payload.length > 0) {
            pattern.push('(')?;
            for (k in 0..variant.payload.length) {
                appendText(mut pattern, if (k == 0) "_" else ", _")?;
            }
            pattern.push(')')?;
        }
        out.push(pattern)?;
    }
    return Ok(out);
}

/// The checker's `@test` functions of the package under test, in declaration order: a dependency's tests are its
/// own, and private to it (N0312), so the harness cannot call them.
fn testEntries(c: borrow Checker) -> Result<Vector<TestEntry>, AllocError> {
    var out = Vector<TestEntry>.create();
    for (f in c.testFunctions.view()) {
        let hir = borrow c.hir.functions[f as usize];
        if (packageOfFile(c, hir.file) != 0) {
            continue;
        }
        let parts = resultParts(c, hir.returnType);
        var kind: u32 = 0;
        var variants = Vector<Vector<u8>>.create();
        if (parts.length == 2) {
            let name = c.typeName(parts[1]);
            kind = if (sameText(name, "TestFailure")) 1 else if (sameText(name, "IoError")) 2 else if (sameText(
                name,
                "AsyncError",
            )) 3 else 4;
            if (kind == 4) {
                variants = variantPatterns(c, parts[1])?;
            }
        }
        out.push(
            TestEntry {
                name: copyBytes(c.name(hir.name))?,
                isAsync: c.front.ast.functions[hir.syntax as usize].isAsync,
                errorKind: kind,
                variants: variants,
            },
        )?;
    }
    return Ok(out);
}

/// The harness's source (ADR 0049 §3.4): `ceesafeTestMain` lists the tests, or runs the one named, through lib/std's
/// TestRun (protocol version 1).
fn harnessSource(tests: borrow Vector<TestEntry>) -> Result<Vector<u8>, AllocError> {
    var s = Vector<u8>.create();
    appendText(
        mut s,
        "// GENERATED by ceesafec test (ADR 0049 §3.4): the test harness. Not to be edited or committed.\n",
    )?;
    appendText(mut s, "fn ceesafeTestMain() -> i32 {\n")?;
    appendText(mut s, "    let command = match (Process.argument(1)) {\n")?;
    appendText(mut s, "        Some(c) => c,\n")?;
    appendText(mut s, "        null => { return TestRun.unknown(); },\n")?;
    appendText(mut s, "    };\n")?;
    appendText(mut s, "    if (command == \"--ceesafe-list\") {\n")?;
    appendText(mut s, "        Console.writeLine(\"ceesafe-test 1\");\n")?;
    for (t in tests.view()) {
        appendText(mut s, "        Console.writeLine(\"")?;
        appendBytes(mut s, t.name.view())?;
        appendText(mut s, "\");\n")?;
    }
    appendText(mut s, "        return 0;\n    }\n")?;
    appendText(mut s, "    let name = match (Process.argument(2)) {\n")?;
    appendText(mut s, "        Some(n) => n,\n")?;
    appendText(mut s, "        null => { return TestRun.unknown(); },\n")?;
    appendText(mut s, "    };\n")?;
    appendText(mut s, "    TestRun.begin();\n")?;
    for (t in tests.view()) {
        appendText(mut s, "    if (name == \"")?;
        appendBytes(mut s, t.name.view())?;
        appendText(mut s, "\") {\n")?;
        var call = Vector<u8>.create();
        if (t.isAsync) {
            appendText(mut call, "Async.run(")?;
        }
        appendBytes(mut call, t.name.view())?;
        appendText(mut call, "()")?;
        if (t.isAsync) {
            appendText(mut call, ")")?;
        }
        if (t.errorKind == 0) {
            appendText(mut s, "        ")?;
            appendBytes(mut s, call.view())?;
            appendText(mut s, ";\n        return TestRun.passed();\n")?;
        } else if (t.errorKind == 4 && t.variants.length > 0) {
            // Its own enum: the variant returned, by name (ADR 0049 §3.2).
            appendText(mut s, "        match (")?;
            appendBytes(mut s, call.view())?;
            appendText(mut s, ") {\n            Ok() => { return TestRun.passed(); }\n")?;
            for (pattern in t.variants.view()) {
                appendText(mut s, "            Err(")?;
                appendBytes(mut s, pattern.view())?;
                appendText(mut s, ") => { return TestRun.failedWith(\"returned Err(")?;
                for (b in pattern.view()) {
                    if (b == '(') {
                        break; // the name without its payload's placeholders
                    }
                    s.push(b)?;
                }
                appendText(mut s, ")\"); }\n")?;
            }
            appendText(mut s, "        }\n")?;
        } else {
            appendText(mut s, "        match (")?;
            appendBytes(mut s, call.view())?;
            appendText(mut s, ") {\n            Ok() => { return TestRun.passed(); }\n")?;
            appendText(
                mut s,
                match (t.errorKind) {
                    1 => "            Err(f) => { return TestRun.failed(f.message.view()); }\n",
                    2 => "            Err(e) => { return TestRun.failedWith(e.message()); }\n",
                    3 =>
                        "            Err(AsyncError.Io(e)) => { return TestRun.failedWith(e.message()); }\n            Err(AsyncError.Cancelled) => { return TestRun.failedWith(\"cancelled\"); }\n            Err(AsyncError.TimedOut) => { return TestRun.failedWith(\"timed out\"); }\n            Err(AsyncError.Closed) => { return TestRun.failedWith(\"closed\"); }\n",
                    _ => "            Err(_) => { return TestRun.failedWith(\"returned Err\"); }\n",
                },
            )?;
            appendText(mut s, "        }\n")?;
        }
        appendText(mut s, "    }\n")?;
    }
    appendText(mut s, "    return TestRun.unknown();\n}\n")?;
    return Ok(s);
}

/// The directory of the harness and the test list: `out/ceesafe-test` beside the package's output.
fn testDirectory(options: borrow Options) -> Vector<u8> {
    var directory = copyBytes(directoryOf(options.defaultOutput.view()))!;
    appendText(mut directory, "/ceesafe-test")!;
    return directory;
}

/// After `test`'s check (ADR 0049 §3.3): the harness and the list of tests, written to the test directory.
fn writeHarness(options: borrow Options, c: borrow Checker, sources: borrow Vector<SourceText>) -> i32 {
    let tests = testEntries(c)!;
    let directory = testDirectory(options);
    match (makeDirectories(directory.view())) {
        Ok() => {}
        Err(e) => { return fail(e.message()); }
    }
    let harness = harnessSource(borrow tests)!;
    var list = Vector<u8>.create();
    for (t in tests.view()) {
        appendBytes(mut list, t.name.view())!;
        list.push('\n')!;
    }
    // Where each test function is, so a sweep can tell its own unwraps from the code's (ADR 0075 §2.16).
    var spans = Vector<u8>.create();
    for (f in c.testFunctions.view()) {
        let hir = borrow c.hir.functions[f as usize];
        if (packageOfFile(c, hir.file) != 0 || (hir.file as usize) >= sources.length) {
            continue;
        }
        let source = borrow sources[hir.file as usize];
        let syntax = borrow c.front.ast.functions[hir.syntax as usize];
        appendBytes(mut spans, source.path.view())!;
        spans.push('\t')!;
        appendDecimal(mut spans, (source.lineIndex(syntax.start as usize) + 1) as u64)!;
        spans.push('\t')!;
        appendDecimal(mut spans, (source.lineIndex(syntax.end as usize) + 1) as u64)!;
        spans.push('\n')!;
    }
    let spansPath = joinPath(directory.view(), "test-spans.txt".bytes())!;
    match (writeFile(StringView.fromUtf8(spansPath.view())!, spans.view())) {
        Ok() => {}
        Err(e) => { return fail(e.message()); }
    }
    let harnessPath = joinPath(directory.view(), "harness.cee".bytes())!;
    let listPath = joinPath(directory.view(), "tests.txt".bytes())!;
    match (writeFile(StringView.fromUtf8(harnessPath.view())!, harness.view())) {
        Ok() => {}
        Err(e) => { return fail(e.message()); }
    }
    match (writeFile(StringView.fromUtf8(listPath.view())!, list.view())) {
        Ok() => {}
        Err(e) => { return fail(e.message()); }
    }
    return 0;
}

/// What one run of a test showed (ADR 0049 §3.3's outcomes).
struct TestOutcome {
    outcome: u32; // 0 passed, 1 failed, 2 panicked, 3 crashed, 4 timed out, 5 leaked, 6 unknown, 7 skipped, 8 exited
    message: Vector<u8>;
    stdout: Vector<u8>;
    stderr: Vector<u8>;
    attempts: u64; // allocation attempts, from the runtime's report
    points: u64;   // suspension points, from the cancellation report
    millis: u64;
}

fn outcomeName(outcome: u32) -> StringView => match (outcome) {
    0 => "passed",
    1 => "failed",
    2 => "panicked",
    3 => "crashed",
    4 => "timed out",
    5 => "leaked",
    7 => "skipped",
    8 => "exited",
    _ => "not found",
};

/// The number after `key` in `text`, or none.
fn numberAfter(text: Slice<u8>, key: StringView) -> u64 {
    let k = key.bytes();
    var at: usize = 0;
    var found = none() as u64;
    while (at + k.length <= text.length) {
        if (sameBytes(text[at..at + k.length], k)) {
            var n: u64 = 0;
            var p = at + k.length;
            while (p < text.length && text[p] >= '0' && text[p] <= '9') {
                n = n * 10 + (text[p] - '0') as u64;
                p += 1;
            }
            found = n; // the last report counts
        }
        at += 1;
    }
    return found;
}

/// The lines between `ceesafe-test 1 failed` and `ceesafe-test 1 end`, or the panic's line.
fn failureMessage(stderr: Slice<u8>, start: StringView, end: StringView) -> Vector<u8> {
    var message = Vector<u8>.create();
    let s = start.bytes();
    var at: usize = 0;
    while (at + s.length <= stderr.length && !sameBytes(stderr[at..at + s.length], s)) {
        at += 1;
    }
    if (at + s.length > stderr.length) {
        return message;
    }
    var p = at + s.length;
    while (p < stderr.length && (stderr[p] == '\n' || stderr[p] == ':' || stderr[p] == ' ')) {
        p += 1;
    }
    let e = end.bytes();
    while (p < stderr.length) {
        if (e.length > 0 && p + e.length <= stderr.length && sameBytes(stderr[p..p + e.length], e)) {
            break;
        }
        if (e.length == 0 && stderr[p] == '\n') {
            break;
        }
        message.push(stderr[p])!;
        p += 1;
    }
    while (message.length > 0 && message[message.length - 1] == '\n') {
        message.pop();
    }
    return message;
}

/// Runs test `name` once: natively, the harness `exe`, with the allocation that fails and the suspension that cancels
/// (0: none); with --interp, `ceesafec run --interp` on the harness.
fn runTest(
    options: borrow Options,
    exe: Slice<u8>,
    harness: Slice<u8>,
    name: Slice<u8>,
    failAt: u64,
    cancelAt: u64,
) -> TestOutcome {
    var arguments = Vector<Vector<u8>>.create();
    var program = Vector<u8>.create();
    if (options.interp) {
        appendBytes(mut program, Process.argument(0)!.bytes())!;
        pushText(mut arguments, "run")!;
        pushText(mut arguments, "--interp")!;
        pushText(mut arguments, "--ceesafe-harness")!;
        pushBytes(mut arguments, harness)!;
        pushText(mut arguments, "--")!;
    } else {
        appendBytes(mut program, exe)!;
    }
    pushText(mut arguments, "--ceesafe-test")!;
    pushBytes(mut arguments, name)!;
    var numbers = Vector<u8>.create();
    appendDecimal(mut numbers, failAt)!;
    arguments.push(numbers)!;
    var cancel = Vector<u8>.create();
    appendDecimal(mut cancel, cancelAt)!;
    arguments.push(cancel)!;
    var timeout = Vector<u8>.create();
    appendDecimal(mut timeout, options.testTimeout * 1000)!;
    arguments.push(timeout)!;
    if (hostIsWindows()) {
        for (k in 0..program.length) {
            if (program[k] == '/') {
                program[k] = '\\'; // run through a batch file there (runTool), which wants Windows' separator
            }
        }
    }
    let started = Timer.now();
    let captured = runTool(program.view(), arguments)!;
    let millis = Timer.now() - started;
    var result = TestOutcome {
        outcome: 3,
        message: Vector<u8>.create(),
        stdout: Vector<u8>.create(),
        stderr: Vector<u8>.create(),
        attempts: 0,
        points: 0,
        millis: millis,
    };
    if (captured.started) {
        let output = captured;
        {
            let err = output.stderr.view();
            let attempts = numberAfter(err, "ceesafe alloc: attempts=");
            let live = numberAfter(err, " live=");
            let points = numberAfter(err, "ceesafe cancel: points=");
            result.attempts = if (attempts == none() as u64) 0 else attempts;
            result.points = if (points == none() as u64) 0 else points;
            if (options.interp && containsText(err, "the interpreter runs no C code")) {
                result.outcome = 7; // --interp cannot run a test that calls C (ADR 0049 §3.3)
                appendText(mut result.message, "it calls C, which the interpreter cannot run")!;
            } else if (containsText(err, "ceesafe-test 1 timeout")) {
                result.outcome = 4;
            } else if (containsText(err, "ceesafe panic")) {
                result.outcome = 2;
                result.message = failureMessage(err, "ceesafe panic", "");
            } else if (containsText(err, "ceesafe-test 1 failed")) {
                result.outcome = 1;
                result.message = failureMessage(err, "ceesafe-test 1 failed", "ceesafe-test 1 end");
            } else if (containsText(err, "ceesafe-test 1 unknown")) {
                result.outcome = 6;
            } else if (output.status == 0 && containsText(err, "ceesafe-test 1 passed")) {
                result.outcome = if (live != none() as u64 && live > 0) 5 else 0;
                if (result.outcome == 5) {
                    appendDecimal(mut result.message, live)!;
                    appendText(mut result.message, " allocation(s) still live at the end")!;
                }
            } else {
                // A status a signal gives (128 + its number, as Process.capture reports one; on Windows an exception's
                // code, negative as an i32) is a crash; any other is the test ending the process itself (Process.exit).
                let signalled = output.status < 0 || (!hostIsWindows() && output.status > 128 && output.status <= 192);
                result.outcome = if (signalled) 3 else 8;
                appendText(mut result.message, "exit status ")!;
                if (output.status < 0) {
                    result.message.push('-')!;
                }
                appendDecimal(
                    mut result.message,
                    truncate<u64>(if (output.status < 0) 0 - (output.status as i64) else output.status as i64),
                )!;
            }
            result.stdout = output.stdout;
            result.stderr = output.stderr;
        }
    } else {
        appendText(mut result.message, "cannot run the test: ")!;
        appendText(mut result.message, captured.error.message())!;
    }
    return result;
}

/// The sweep points of a passing run: every allocation (alloc), or every suspension, sampled past 200 as
/// tools/cancel_sweep.py does (cancel).
fn sweepPoints(n: u64) -> Vector<u64> {
    var points = Vector<u64>.create();
    if (n <= 200) {
        for (k in 1..(n + 1)) {
            points.push(k)!;
        }
        return points;
    }
    for (k in 1..(n + 1)) {
        let picked = k <= 50 || k + 50 > n || (k * 101) % n < 101;
        if (picked) {
            points.push(k)!;
        }
    }
    return points;
}

/// Runs tests `lo` to `hi` of `names` into `out`, in order: `jobs` at once, by splitting the range between two threads
/// (Thread.both) until each has one job.
fn runTests(
    options: borrow Options,
    exe: Slice<u8>,
    harness: Slice<u8>,
    names: borrow Vector<Vector<u8>>,
    lo: usize,
    hi: usize,
    jobs: u32,
    out: borrow mut Vector<TestOutcome>,
) {
    if (jobs <= 1 || hi - lo <= 1) {
        for (k in lo..hi) {
            out.push(runTest(options, exe, harness, names[k].view(), 0, 0))!;
        }
        return;
    }
    let mid = lo + (hi - lo) / 2;
    var left = Vector<TestOutcome>.create();
    var right = Vector<TestOutcome>.create();
    let leftJobs = jobs / 2;
    let rightJobs = jobs - leftJobs;
    Thread.both(
        () => { runTests(options, exe, harness, names, lo, mid, leftJobs, mut left); },
        () => { runTests(options, exe, harness, names, mid, hi, rightJobs, mut right); },
    );
    appendInOrder(mut left, out);
    appendInOrder(mut right, out);
}

/// Moves `from`'s outcomes to the end of `to`, in their order.
fn appendInOrder(from: borrow mut Vector<TestOutcome>, to: borrow mut Vector<TestOutcome>) {
    var reversed = Vector<TestOutcome>.create();
    loop {
        match (from.pop()) {
            Some(o) => { reversed.push(o)!; }
            null => { break; }
        }
    }
    loop {
        match (reversed.pop()) {
            Some(o) => { to.push(o)!; }
            null => { break; }
        }
    }
}

/// `test`'s options, read from the command line afresh: `compileFiles` takes them by value, so each step makes its own.
fn testOptions(options: borrow mut Options) -> i32 {
    options.testing = true;
    options.includeTests = true;
    let status = readOptions(options);
    if (status != 0) {
        return status;
    }
    if (options.files.length > 0) {
        return fail("'test' runs a package's tests: run it in the package's directory, without files");
    }
    return 0;
}

/// Checks the package and its tests and writes the harness (`harness` empty), or builds the harness (`harness` its
/// path) into `exe`.
fn testStep(harness: Slice<u8>, exe: Slice<u8>) -> i32 {
    var options = defaultOptions(true);
    let status = testOptions(mut options);
    if (status != 0) {
        return status;
    }
    var packages = Vector<PackageInfo>.create();
    var packageFiles = Vector<Vector<Vector<u8>>>.create();
    let loaded = loadPackage(mut options, mut packages, mut packageFiles);
    if (loaded != 0) {
        return loaded;
    }
    if (harness.length == 0) {
        return compileFiles(options, false, Vector<String>.create(), packages, packageFiles);
    }
    options.harness = copyBytes(harness)!;
    options.entryName = copyBytes(harnessEntry().bytes())!;
    options.output = copyBytes(exe)!;
    options.emit = copyBytes("exe".bytes())!;
    return compileFiles(options, true, Vector<String>.create(), packages, packageFiles);
}

/// `ceesafec test --help`: its options and outcomes.
fn testHelp() {
    Console.writeLine("usage: ceesafec test [options]   (in a package's directory; tooling.md §10, ADR 0049)");
    Console.writeLine("runs the package's @test functions, each as a process of its own, in the order of their names");
    Console.writeLine("  --filter <text>       only the tests whose name contains <text> (none matching is an error)");
    Console.writeLine("  --list                print the tests' names and run none");
    Console.writeLine("  --interp              run them in the interpreter (a test that calls C is skipped)");
    Console.writeLine("  --jobs <n>            run n tests at once");
    Console.writeLine("  --timeout <seconds>   a test running longer has timed out (default 60)");
    Console.writeLine("  --sweep alloc|cancel  run each passing test again under every failed allocation or every");
    Console.writeLine("                        cancellation point (native only)");
    Console.writeLine("  --sweep-strict        with --sweep alloc: a panic from an unwrap in a test's own file fails");
    Console.writeLine("                        the sweep too");
    Console.writeLine("  --format text|json    the report's form");
    Console.writeLine("  --deny-warnings       treat the check's warnings as errors: no test runs");
    Console.writeLine(
        "the test program is built as `ceesafec build` builds, so test takes build's options too, such as",
    );
    Console.writeLine("--cc, --cflag and -g (ceesafec --help lists them; tooling.md §12.1 says what each does here)");
    Console.writeLine(
        "outcomes: passed, failed, panicked, crashed (a signal or exception), exited (the test ended the",
    );
    Console.writeLine("process itself), timed out, leaked (allocations still live at exit), skipped");
}

/// `ceesafec test` (ADR 0049 §3.3).
fn testCommand() -> i32 {
    var argument: usize = 2;
    loop {
        match (Process.argument(argument)) {
            Some(a) => {
                if (a == "--help" || a == "-h") {
                    testHelp();
                    return 0;
                }
            }
            null => { break; }
        }
        argument += 1;
    }
    var options = defaultOptions(true);
    let status = testOptions(mut options);
    if (status != 0) {
        return status;
    }
    if (options.interp && options.testSweep != 0) {
        // The sweeps need the native runtime's hooks; under --interp they would pass without one run.
        return fail(
            "'--sweep' runs the tests natively, under the runtime's allocation and cancellation hooks: it cannot be combined with '--interp'",
        );
    }
    {
        // The package's output directory (out/<name>), as a build's.
        var packages = Vector<PackageInfo>.create();
        var packageFiles = Vector<Vector<Vector<u8>>>.create();
        let loaded = loadPackage(mut options, mut packages, mut packageFiles);
        if (loaded != 0) {
            return loaded;
        }
    }
    // 1. Check the package with its tests, and write the harness and the list.
    let checked = testStep("".bytes(), "".bytes());
    if (checked != 0) {
        return checked;
    }
    let directory = testDirectory(options);
    let harness = joinPath(directory.view(), "harness.cee".bytes())!;
    let listPath = joinPath(directory.view(), "tests.txt".bytes())!;
    let listText = match (readFile(StringView.fromUtf8(listPath.view())!)) {
        Ok(t) => t,
        Err(_) => { return fail("cannot read the list of tests"); }
    };
    var names = Vector<Vector<u8>>.create();
    var line = Vector<u8>.create();
    for (b in listText.view()) {
        if (b == '\n') {
            let wanted = options.testFilter.length == 0 || containsSlice(line.view(), options.testFilter.view());
            if (line.length > 0 && wanted) {
                names.push(copyBytes(line.view())!)!;
            }
            line.clear();
        } else {
            line.push(b)!;
        }
    }
    // In the order of their names (ADR 0049 §3.3), whatever their order in the sources.
    names.sortBy((a, b) => compareBytes(a.view(), b.view()));
    if (names.length == 0 && options.testFilter.length > 0) {
        // A filter that matches nothing is an error, so a mistyped one cannot pass in CI.
        var message = copyBytes("ceesafec test: no test's name contains '".bytes())!;
        appendBytes(mut message, options.testFilter.view())!;
        appendText(mut message, "'\n")!;
        Console.writeError(StringView.fromUtf8(message.view())!);
        return 1;
    }
    if (options.testList) {
        for (n in names.view()) {
            Console.writeLine(StringView.fromUtf8(n.view())!);
        }
        return 0;
    }
    // 2. Build the harness once (natively).
    var exe = copyBytes(options.defaultOutput.view())!;
    appendText(mut exe, "-tests")!;
    if (hostIsWindows()) {
        appendText(mut exe, ".exe")!;
    }
    if (!options.interp) {
        let built = testStep(harness.view(), exe.view());
        if (built != 0) {
            return built;
        }
    }
    // 3. Run each test (--jobs at once), then the sweeps.
    var outcomes = Vector<TestOutcome>.create();
    runTests(borrow options, exe.view(), harness.view(), borrow names, 0, names.length, options.testJobs, mut outcomes);
    var sweepFailures = Vector<Vector<u8>>.create();
    var sweepRuns: u64 = 0;
    var sweepUnwrapped: u64 = 0;
    let spansPath = joinPath(directory.view(), "test-spans.txt".bytes())!;
    let testSpans = match (readFile(StringView.fromUtf8(spansPath.view())!)) {
        Ok(t) => t,
        Err(_) => Vector<u8>.create(),
    };
    for (index in 0..names.length) {
        let n = borrow names[index];
        let first = borrow outcomes[index];
        if (first.outcome == 0 && options.testSweep != 0 && !options.interp) {
            let count = if (options.testSweep == 1) first.attempts else first.points;
            let points = sweepPoints(count);
            for (k in points.view()) {
                sweepRuns += 1;
                let swept = if (options.testSweep == 1) runTest(
                    options,
                    exe.view(),
                    harness.view(),
                    n.view(),
                    k,
                    0,
                ) else runTest(options, exe.view(), harness.view(), n.view(), 0, k);
                // Under a failed allocation or a cancellation a test may fail; it may not panic, crash, hang or leak.
                if (swept.outcome == 2 && options.testSweep == 1 && !options.testSweepStrict &&
                    unwrapInTest(swept.message.view(), testSpans.view())) {
                    sweepUnwrapped += 1; // the test's own `!` or `?` met the failure (ADR 0075 §2.16)
                    continue;
                }
                if (swept.outcome != 0 && swept.outcome != 1) {
                    var what = copyBytes(n.view())!;
                    appendText(
                        mut what,
                        if (options.testSweep == 1) ": allocation " else ": cancellation at suspension ",
                    )!;
                    appendDecimal(mut what, k)!;
                    appendText(mut what, " ")!;
                    appendText(mut what, outcomeName(swept.outcome))!;
                    if (swept.message.length > 0) {
                        appendText(mut what, ": ")!;
                        appendBytes(mut what, swept.message.view())!;
                    }
                    sweepFailures.push(what)!;
                }
            }
        }
        if (!options.testJson) {
            var text = copyBytes("test ".bytes())!;
            appendBytes(mut text, n.view())!;
            appendText(mut text, " ... ")!;
            appendText(mut text, if (first.outcome == 0) "ok" else outcomeName(first.outcome))!;
            Console.writeLine(StringView.fromUtf8(text.view())!);
        }
    }
    var passed: u64 = 0;
    var skipped: u64 = 0;
    for (o in outcomes.view()) {
        if (o.outcome == 0) {
            passed += 1;
        } else if (o.outcome == 7) {
            skipped += 1;
        }
    }
    let failed = outcomes.length as u64 - passed - skipped;
    if (options.testJson) {
        var json = JsonWriter.create();
        json.startObject()!;
        json.name("version")!;
        json.number(1)!;
        json.name("tests")!;
        json.startArray()!;
        for (k in 0..outcomes.length) {
            let o = borrow outcomes[k];
            json.startObject()!;
            json.name("name")!;
            json.stringBytes(names[k].view())!;
            json.name("outcome")!;
            json.string(outcomeName(o.outcome))!;
            json.name("milliseconds")!;
            json.number(truncate<i64>(o.millis))!;
            json.name("message")!;
            json.stringBytes(o.message.view())!;
            json.name("stdout")!;
            json.stringBytes(o.stdout.view())!;
            json.name("stderr")!;
            json.stringBytes(o.stderr.view())!;
            json.endObject()!;
        }
        json.endArray()!;
        json.name("sweepFailures")!;
        json.startArray()!;
        for (f in sweepFailures.view()) {
            json.stringBytes(f.view())!;
        }
        json.endArray()!;
        json.name("sweepRuns")!;
        json.number(truncate<i64>(sweepRuns))!;
        json.name("sweepUnwrappedByTest")!;
        json.number(truncate<i64>(sweepUnwrapped))!;
        json.name("passed")!;
        json.number(truncate<i64>(passed))!;
        json.name("failed")!;
        json.number(truncate<i64>(failed))!;
        json.name("skipped")!;
        json.number(truncate<i64>(skipped))!;
        json.endObject()!;
        Console.writeBytes(json.out.view());
        Console.writeLine("");
    } else {
        for (k in 0..outcomes.length) {
            let o = borrow outcomes[k];
            if (o.outcome == 0 || o.outcome == 7) {
                continue;
            }
            var text = copyBytes("\n---- ".bytes())!;
            appendBytes(mut text, names[k].view())!;
            appendText(mut text, ": ")!;
            appendText(mut text, outcomeName(o.outcome))!;
            appendText(mut text, " ----\n")!;
            if (o.message.length > 0) {
                appendBytes(mut text, o.message.view())!;
                text.push('\n')!;
            }
            if (o.stdout.length > 0) {
                appendText(mut text, "-- its output:\n")!;
                appendBytes(mut text, o.stdout.view())!;
            }
            Console.writeBytes(text.view());
        }
        for (f in sweepFailures.view()) {
            Console.writeLine(StringView.fromUtf8(f.view())!);
        }
        var summary = copyBytes("\nceesafec test: ".bytes())!;
        appendDecimal(mut summary, passed)!;
        appendText(mut summary, " passed, ")!;
        appendDecimal(mut summary, failed)!;
        appendText(mut summary, " failed")!;
        if (skipped > 0) {
            appendText(mut summary, ", ")!;
            appendDecimal(mut summary, skipped)!;
            appendText(mut summary, " skipped")!;
        }
        if (options.testSweep != 0) {
            appendText(mut summary, ", ")!;
            appendDecimal(mut summary, sweepFailures.length as u64)!;
            appendText(mut summary, " sweep failure(s) in ")!;
            appendDecimal(mut summary, sweepRuns)!;
            appendText(mut summary, " sweep run(s)")!;
            if (sweepUnwrapped > 0) {
                appendText(mut summary, " (")!;
                appendDecimal(mut summary, sweepUnwrapped)!;
                appendText(mut summary, " unwrapped by the test itself)")!;
            }
        }
        Console.writeLine(StringView.fromUtf8(summary.view())!);
    }
    return if (failed == 0 && sweepFailures.length == 0) 0 else 1;
}

/// Whether a sweep's panic `message` ("unwrapped an Err value at f.cee:12:5", or "unwrapped null at …") is in a file
/// that declares a test function (test-spans.txt: each test's path, first and last line, tab-separated): the tests'
/// own `!` or `?`, in a test or one of its helpers, met the injected failure, which is the tests' business, not a fault
/// of the code under test (ADR 0075 §2.16).
fn unwrapInTest(message: Slice<u8>, spans: Slice<u8>) -> bool {
    if (!containsText(message, "unwrapped an Err value") && !containsText(message, "unwrapped null")) {
        return false;
    }
    // The location after the last " at ": path, ':', line, ':', column.
    var at = message.length;
    var found = false;
    while (at >= 4) {
        at -= 1;
        if (message[at - 3] == ' ' && message[at - 2] == 'a' && message[at - 1] == 't' && message[at] == ' ') {
            found = true;
            break;
        }
    }
    if (!found) {
        return false;
    }
    let location = message[(at + 1)..];
    var colon = location.length;
    var colons: u32 = 0;
    while (colon > 0 && colons < 2) {
        colon -= 1;
        if (location[colon] == ':') {
            colons += 1;
        }
    }
    if (colons < 2) {
        return false;
    }
    let path = location[0..colon];
    var line: u64 = 0;
    var p = colon + 1;
    while (p < location.length && location[p] >= '0' && location[p] <= '9') {
        line = line * 10 + ((location[p] - '0') as u64);
        p += 1;
    }
    var start: usize = 0;
    while (start < spans.length) {
        var end = start;
        while (end < spans.length && spans[end] != '\n') {
            end += 1;
        }
        let entry = spans[start..end];
        start = end + 1;
        var tab = 0usize;
        while (tab < entry.length && entry[tab] != '\t') {
            tab += 1;
        }
        if (tab >= entry.length) {
            continue;
        }
        let file = entry[0..tab];
        let sameFile = sameBytes(file, path) || (file.length > path.length &&
            sameBytes(file[(file.length - path.length)..], path)) || (path.length > file.length &&
            sameBytes(path[(path.length - file.length)..], file));
        if (sameFile && line > 0) {
            // A file that declares @test functions is test code: its helpers' unwraps are the tests' own too.
            return true;
        }
    }
    return false;
}
