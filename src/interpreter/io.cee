// Program arguments, files, sockets, processes, host services, the C library model and threads for the interpreter
// (the reference's Interpreter/IoRuntime.cs, HostIo.cs, HostServices.cs, CLibrary.cs and Threads.cs; type-system.md
// §26, §28.6, §38; intermediate-representation.md §5.4). Files and sockets are the host's, through lib/core's File,
// TcpListener and TcpStream: a descriptor the program holds names an entry of the interpreter's table.

/// A descriptor's host object.
enum HostHandle {
    Closed,
    OpenFile(File, String), // the file, and its path (ADR 0051: a read at an offset reopens it)
    // A file opened for reading and writing (ADR 0075 §2.1): its path and position. Each operation reopens the file,
    // as ADR 0051's read at an offset does, so the stage-0 compiler's File serves.
    PathFile(String, u64),
    Listener(TcpListener),
    Stream(TcpStream),
}

/// A thread of the interpreted program (Threads.cs): its body, and what it waits for.
struct InterpThread {
    started: bool;
    finished: bool;
    waitingKind: u32; // 0 runnable, 1 a thread to finish, 2 a mutex to be free
    waitingOn: u64;   // the thread's index, or the mutex's address
    isClosure: bool;  // Thread.both's first closure, else a spawned body
    function: u32;    // a spawned body's NIR function
    data: u64;        // its environment, or the closure value's environment pointer
    block: u64;       // the thread's record, where the result goes
    resultType: u32;
}

struct InterpRuntime {
    argumentPointers: Vector<u64>;
    argumentLengths: Vector<u64>;
    handles: Vector<HostHandle>; // descriptor d is handles[d - 3]
    listingAddresses: Vector<u64>;
    listings: Vector<Vector<Vector<u8>>>;
    listingNext: Vector<usize>;
    nextListing: u64;
    threads: Vector<InterpThread>; // in spawn order; the main thread first
    current: u32;
    recordAddresses: Vector<u64>; // the runtime's thread records, by thread
    recordThreads: Vector<u32>;
    mutexAddresses: Vector<u64>;
    mutexOwners: Vector<u32>;        // the owning thread, or none
    onceDepth: u32;                  // how often the owner of OnceLock's lock (ADR 0096) holds it
    channels: Vector<InterpChannel>; // ADR 0032: a channel's handle is its index + 1
}

/// A channel in the interpreter (lib/std/channel.cee over runtime/hosted/ceesafe_rt_async.c's model).
struct InterpChannel {
    data: u64; // its buffer, from alloc
    capacity: u64;
    stride: u64;
    head: u64;
    count: u64;
    closed: bool;
    refs: u64;
    epoch: u64;
    waiters: Vector<u32>; // tasks parked on it (runTasks' global ids)
}

fn newInterpRuntime() -> InterpRuntime => InterpRuntime {
    argumentPointers: Vector<u64>.create(),
    argumentLengths: Vector<u64>.create(),
    handles: Vector<HostHandle>.create(),
    listingAddresses: Vector<u64>.create(),
    listings: Vector<Vector<Vector<u8>>>.create(),
    listingNext: Vector<usize>.create(),
    nextListing: 0x7E5700000000,
    threads: Vector<InterpThread>.create(),
    current: 0,
    recordAddresses: Vector<u64>.create(),
    recordThreads: Vector<u32>.create(),
    mutexAddresses: Vector<u64>.create(),
    mutexOwners: Vector<u32>.create(),
    onceDepth: 0,
    channels: Vector<InterpChannel>.create(),
};

/// ceesafe_init's argv (ADR 0088 §2.2): copied, as the native runtime copies it.
fn startRuntime(it: borrow mut Interp) -> Result<void, Stop> {
    for (k in 0..it.options.arguments.length) {
        let bytes = copyBytes(it.options.arguments[k].view())!;
        let pointer = if (bytes.length == 0) it.emptyVector else it.memory.staticBytes(
            bytes.view(),
            "a program argument".bytes(),
        )?;
        it.runtime.argumentPointers.push(pointer)!;
        it.runtime.argumentLengths.push(bytes.length as u64)!;
    }
    // The main thread (Threads.cs's Running, made at the first thread operation; first either way).
    it.runtime.threads.push(
        InterpThread {
            started: true,
            finished: false,
            waitingKind: 0,
            waitingOn: 0,
            isClosure: false,
            function: none(),
            data: 0,
            block: 0,
            resultType: none(),
        },
    )!;
    return Ok();
}

fn hostIsX8664() -> bool => Target.isX86_64();

// ---- Errors (HostIo's errno numbers and Kind) ----

fn errnoInvalid() -> i64 => 22;
fn errnoNoMemory() -> i64 => 12;
fn errnoRange() -> i64 => 34;

/// Whether the host is Linux (its errno numbers differ from macOS's for a few errors).
fn isLinuxHost() -> bool => match (File.kind("/proc/self")) {
    Ok(kind) => kind != null,
    Err(_) => false,
};

/// The host's errno numbering: 0 Linux, 1 macOS (and the BSDs), 2 Windows (MSVC's errno.h, to which the runtime
/// translates Winsock's errors).
fn hostErrnos() -> u32 => if (hostIsWindows()) 2 else if (isLinuxHost()) 0 else 1;

/// One errno on Linux, macOS and Windows.
fn errnoFor(system: u32, linux: i64, mac: i64, windows: i64) -> i64 =>
    if (system == 0) linux else if (system == 1) mac else windows;

/// The errno a lib/core IoError stands for (HostIo's numbers), so the program's ceesafe_io_kind maps it back.
fn errnoOf(error: IoError) -> i64 => match (error) {
    IoError.NotFound => 2,
    IoError.PermissionDenied => 13,
    IoError.AlreadyExists => 17,
    IoError.IsDirectory => 21,
    IoError.NotDirectory => 20,
    IoError.InvalidInput => 22,
    IoError.BrokenPipe => 32,
    IoError.ConnectionRefused => errnoFor(hostErrnos(), 111, 61, 107),
    IoError.AddressInUse => errnoFor(hostErrnos(), 98, 48, 100),
    IoError.OutOfMemory => 12,
    IoError.Other(code) => code as i64,
    // ADR 0044's kinds, which stage 0 (ceesafec 0.3.2, Decision 0009) cannot name: each has its own fixed message.
    _ => errnoOfMessage(error.message()),
};

/// The errno of one of ADR 0044's kinds, or ADR 0060's HostNotFound, from its message (§26.2's wording).
fn errnoOfMessage(text: StringView) -> i64 {
    if (sameText(text.bytes(), ioMessage(19))) {
        return hostNotFound();
    }
    if (sameText(text.bytes(), ioMessage(20))) {
        return 28; // ENOSPC on Linux, macOS and MSVC: IoError.StorageFull (ADR 0077)
    }
    let system = hostErrnos();
    for (k in 11..19u64) {
        if (sameText(text.bytes(), ioMessage(k))) {
            return networkErrno(k, system);
        }
    }
    return 5; // EIO: not reached, every kind has a message
}

/// The errno each of ADR 0044's kinds stands for on the host (Linux's, macOS's, MSVC's numbers; MSVC's read from its
/// errno.h with cl on the Windows 11 ARM64 test host, 2026-11-02).
fn networkErrno(kind: u64, system: u32) -> i64 => match (kind) {
    11 => errnoFor(system, 104, 54, 108), // ECONNRESET
    12 => errnoFor(system, 103, 53, 106), // ECONNABORTED
    13 => errnoFor(system, 107, 57, 126), // ENOTCONN
    14 => errnoFor(system, 110, 60, 138), // ETIMEDOUT
    15 => errnoFor(system, 113, 65, 110), // EHOSTUNREACH
    16 => errnoFor(system, 101, 51, 118), // ENETUNREACH
    17 => errnoFor(system, 99, 49, 101),  // EADDRNOTAVAIL
    _ => errnoFor(system, 95, 102, 130),  // EOPNOTSUPP
};

/// Whether a name is in the reserved `.invalid` top-level domain (RFC 6761 §6.4), in any case, with or without the
/// final dot: the interpreter's resolver answers HostNotFound for it (ADR 0060).
fn reservedInvalid(host: Slice<u8>) -> bool {
    var end = host.length;
    if (end > 0 && host[end - 1] == '.') {
        end -= 1;
    }
    if (end < 7) {
        return false;
    }
    let start = end - 7;
    if (start > 0 && host[start - 1] != '.') {
        return false;
    }
    for (k in 0..7usize) {
        let c = host[start + k];
        let lower = if (c >= 'A' && c <= 'Z') c + 32 else c;
        if (lower != "invalid".bytes()[k]) {
            return false;
        }
    }
    return true;
}

/// The runtime's number for the resolver's "no such host" (rt.h's CEE_ERROR_HOST_NOT_FOUND, ADR 0060), not an errno.
fn hostNotFound() -> i64 => 65536;

/// HostIo.Kind: the IoError variant (by declaration order) for an errno.
fn ioKindOf(error: i64) -> u64 {
    let system = hostErrnos();
    if (error == hostNotFound()) {
        return 19;
    }
    if (error == 2) {
        return 0;
    }
    if (error == 13 || error == 1) {
        return 1;
    }
    if (error == 17) {
        return 2;
    }
    if (error == 21) {
        return 3;
    }
    if (error == 20) {
        return 4;
    }
    if (error == 22 || error == errnoFor(system, 36, 63, 38) || error == errnoFor(system, 90, 40, 115)) { // EMSGSIZE too
        return 5;
    }
    if (error == 32) {
        return 6;
    }
    if (error == errnoFor(system, 111, 61, 107)) {
        return 7;
    }
    if (error == errnoFor(system, 98, 48, 100)) {
        return 8;
    }
    if (error == 12) {
        return 9;
    }
    for (k in 11..19u64) {
        if (error == networkErrno(k, system)) {
            return k;
        }
    }
    // The other spellings of Unsupported: ENOTSUP (where it differs from EOPNOTSUPP), ENOPROTOOPT, EAFNOSUPPORT,
    // EPROTONOSUPPORT.
    let unsupported = if (system == 0) error == 92 || error == 97 || error == 93 else if (system == 1) error == 45 ||
        error == 42 || error == 47 || error == 43 else error == 129 || error == 123 || error == 102 || error == 135;
    return if (unsupported) 18 else 10;
}

/// ceeIOR_: Err with the IoError variant for the errno (its number kept for Other), or Ok with the value.
fn interpIoResult(c: borrow Checker, result: u32, value: i64, error: i64) -> Result<Value, Stop> {
    let ok = resultOkOf(c, result);
    let errorType = resultErrOf(c, result);
    if (error != 0) {
        let variant = enumVariantAt(c, errorType, ioKindOf(error) as usize);
        let payload = borrow c.types.variants[variant as usize].payload;
        var values = Vector<Value>.create();
        if (payload.length > 0) {
            values.push(fromInteger(c, intValue(error), c.types.fields[payload[0] as usize].typ)?)!;
        }
        var errors = Vector<Value>.create();
        errors.push(makeEnumValue(c, errorType, variant, values)?)!;
        return makeEnumValue(c, result, enumVariantAt(c, result, 1), errors);
    }
    if (c.types.is(ok, TypeKind.Void)) {
        return okValue(c, result, null);
    }
    return okValue(c, result, fromInteger(c, intValue(value), ok)?);
}

fn requireHostIo(it: borrow Interp) -> Result<void, Stop> {
    if (it.options.sandboxed) {
        return Err(fault("refused: the sandbox allows no files, sockets or processes"));
    }
    return Ok();
}

// ---- Descriptors ----

fn addHandle(it: borrow mut Interp, handle: HostHandle) -> i64 {
    for (k in 0..it.runtime.handles.length) {
        let closed = match (borrow it.runtime.handles[k]) {
            HostHandle.Closed => true,
            _ => false,
        };
        if (closed) {
            it.runtime.handles[k] = handle;
            return truncate<i64>(k) + 3;
        }
    }
    it.runtime.handles.push(handle)!;
    return truncate<i64>(it.runtime.handles.length - 1) + 3;
}

/// ceesafe_file_read_at (ADR 0051): at most `length` bytes at `offset` of the file the first argument points at, its
/// own position untouched. Stage 0's File cannot seek, so the model opens the file's path again and reads past the
/// first `offset` bytes.
fn readAt(it: borrow mut Interp, arguments: borrow Vector<Value>) -> Result<Value?, Stop> {
    requireHostIo(it)?;
    let fd = truncate<i32>(truncate<u32>(it.memory.loadBits(arguments[0].bits(0, 8)?, 4)?));
    let target = arguments[1].bits(0, 8)?;
    let wanted = arguments[2].bits(0, 8)?;
    let offset = arguments[3].bits(0, 8)?;
    var path = String.create();
    match (handleIndex(it, fd)) {
        Some(k) => {
            match (borrow it.runtime.handles[k]) {
                HostHandle.OpenFile(_, p) => { path.append(p.view())!; }
                HostHandle.PathFile(p, _) => { path.append(p.view())!; }
                _ => {}
            }
        }
        null => {}
    }
    if (path.view().length == 0) {
        return Ok(valueOf(truncate<u64>(-9i64), 8)); // EBADF, 9 on every host
    }
    var file = match (File.open(path.view())) {
        Ok(f) => f,
        Err(e) => { return Ok(valueOf(truncate<u64>(0 - errnoOf(e)), 8)); }
    };
    var buffer = [0u8; 65536];
    var skipped: u64 = 0;
    while (skipped < offset) {
        let step = if (offset - skipped > 65536) 65536 else offset - skipped;
        match (file.read(mut buffer[0..step as usize])) {
            Ok(0) => { return Ok(valueOf(0, 8)); } // the end is before `offset`
            Ok(got) => { skipped += got as u64; }
            Err(e) => { return Ok(valueOf(truncate<u64>(0 - errnoOf(e)), 8)); }
        }
    }
    let count = if (wanted > 65536) 65536 else wanted;
    match (file.read(mut buffer[0..count as usize])) {
        Ok(got) => {
            for (k in 0..got) {
                it.memory.storeBits(target + k as u64, buffer[k] as u64, 1)?;
            }
            return Ok(valueOf(got as u64, 8));
        }
        Err(e) => { return Ok(valueOf(truncate<u64>(0 - errnoOf(e)), 8)); }
    }
}

fn handleIndex(it: borrow Interp, fd: i32) -> usize? {
    if (fd < 3 || truncate<usize>(fd - 3) >= it.runtime.handles.length) {
        return null;
    }
    return truncate<usize>(fd - 3);
}

/// The drop glue of File, TcpListener and TcpStream: closes the descriptor, ignoring errors.
fn closeDescriptor(it: borrow mut Interp, fd: i32) -> Result<void, Stop> {
    match (handleIndex(it, fd)) {
        Some(k) => { it.runtime.handles[k] = HostHandle.Closed; }
        null => {}
    }
    return Ok();
}

fn descriptorArgument(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    arguments: Range,
    k: u32,
) -> Result<i32, Stop> {
    let reference = argument(it, c, n, frame, arguments, k)?.bits(0, 8)?;
    return Ok(truncate<i32>(truncate<u32>(it.memory.loadBits(reference, 4)?)));
}

/// The bytes a slice argument names must be live and in bounds; the host's buffer for them.
fn readBuffer(it: borrow Interp, slice: borrow Value) -> Result<Vector<u8>, Stop> {
    let pointer = slice.bits(0, 8)?;
    let length = slice.bits(8, 8)?;
    let size = if (length > 0x40000000) 0x40000000 else length;
    if (size > 0) {
        it.memory.load(pointer, size as usize)?; // the whole buffer must be live and in bounds
    }
    var buffer = Vector<u8>.create();
    for (i in 0..size) {
        buffer.push(0)!;
    }
    return Ok(buffer);
}

/// The bytes read become initialised.
fn storeRead(
    it: borrow mut Interp,
    slice: borrow Value,
    buffer: borrow Vector<u8>,
    count: usize,
) -> Result<void, Stop> {
    if (count > 0) {
        it.memory.store(slice.bits(0, 8)?, initialisedValue(buffer[0..count]))?;
    }
    return Ok();
}

fn ioMessage(kind: u64) -> StringView => match (kind) {
    0 => "No such file or directory",
    1 => "Permission denied",
    2 => "File exists",
    3 => "Is a directory",
    4 => "Not a directory",
    5 => "Invalid argument",
    6 => "Broken pipe",
    7 => "Connection refused",
    8 => "Address already in use",
    9 => "Out of memory",
    11 => "Connection reset by peer",
    12 => "Software caused connection abort",
    13 => "Transport endpoint is not connected",
    14 => "Connection timed out",
    15 => "No route to host",
    16 => "Network is unreachable",
    17 => "Cannot assign requested address",
    18 => "Operation not supported",
    19 => "Host not found",
    20 => "No space left on device",
    _ => "Input/output error",
};

fn ioBuiltin(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    r: u32,
    b: u32,
    arguments: Range,
) -> Result<Value?, Stop> {
    let resultType = n.rvalueTypes[r as usize];
    if (b == bfArgumentCount()) {
        return Ok(valueOf(it.runtime.argumentPointers.length as u64, 8));
    }
    if (b == bfArgument()) {
        let index = argumentInteger(it, c, n, frame, arguments, 0)?;
        if (index.negative || index.magnitude >= (it.runtime.argumentPointers.length as u64)) {
            return Ok(noneValue(c, resultType)?);
        }
        let k = index.magnitude as usize;
        return Ok(someValue(c, resultType, viewValue(it.runtime.argumentPointers[k], it.runtime.argumentLengths[k]))?);
    }
    if (b == bfIoErrorMessage()) {
        let errorType = builtinArgumentType(n, arguments, 0);
        let value = argument(it, c, n, frame, arguments, 0)?;
        var kind = value.bits(0, enumTagSize(c, errorType))?;
        if (kind > 20) {
            kind = 10;
        }
        let text = ioMessage(kind);
        let pointer = literal(it, text.bytes())?;
        return Ok(viewValue(pointer, text.bytes().length as u64));
    }
    if (b == bfFileOpen() || b == bfFileCreate() || b == bfFileOpenRegular()) {
        requireHostIo(it)?;
        let pathValue = argument(it, c, n, frame, arguments, 0)?;
        let path = bytesOf(it, pathValue)?;
        let text = StringView.fromUtf8(path.view())!;
        if (b == bfFileOpenRegular()) {
            // ADR 0078 §3: only a regular file opens. The interpreter checks the path first; nothing else runs between
            // the check and the open, which the runtime makes from the open file instead.
            match (File.kind(text)) {
                Ok(Some(PathKind.File)) => {}
                Ok(Some(PathKind.Directory)) => { return Ok(interpIoResult(c, resultType, 0, 21)?); } // EISDIR
                Ok(Some(_)) => { return Ok(interpIoResult(c, resultType, 0, errnoInvalid())?); }
                Ok(null) => { return Ok(interpIoResult(c, resultType, 0, 2)?); } // ENOENT
                Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
            }
        }
        let opened = if (b == bfFileCreate()) File.create(text) else File.open(text);
        var kept = String.create();
        kept.append(text)!;
        match (opened) {
            Ok(file) => {
                let fd = addHandle(it, HostHandle.OpenFile(file, kept));
                return Ok(interpIoResult(c, resultType, fd, 0)?);
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
    }
    if (b == bfFileOpenReadWrite() || b == bfFileOpenOrCreate() || b == bfFileCreateNew() || b == bfFileOpenAppend()) {
        // ADR 0075 §2.1: the file is checked and created here; reads and writes reopen it (HostHandle.PathFile).
        requireHostIo(it)?;
        let pathValue = argument(it, c, n, frame, arguments, 0)?;
        let path = bytesOf(it, pathValue)?;
        let text = StringView.fromUtf8(path.view())!;
        var exists = false;
        match (File.kind(text)) {
            Ok(found) => {
                match (found) {
                    Some(PathKind.Directory) => { return Ok(interpIoResult(c, resultType, 0, 21)?); }
                    Some(_) => { exists = true; }
                    null => {}
                }
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
        if (exists && b == bfFileCreateNew()) {
            return Ok(interpIoResult(c, resultType, 0, 17)?);
        }
        if (!exists && b == bfFileOpenReadWrite()) {
            return Ok(interpIoResult(c, resultType, 0, 2)?);
        }
        if (!exists) {
            match (File.create(text)) {
                Ok(_) => {}
                Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
            }
        }
        var kept = String.create();
        kept.append(text)!;
        // An appending file's position is `appendPosition()`: each write goes to the file's end then (ADR 0077).
        let position: u64 = if (b == bfFileOpenAppend()) appendPosition() else 0;
        let fd = addHandle(it, HostHandle.PathFile(kept, position));
        return Ok(interpIoResult(c, resultType, fd, 0)?);
    }
    if (isDurableFileBuiltin(b)) {
        return durableFileBuiltin(it, c, n, frame, b, arguments, resultType);
    }
    if (b == bfFileRemove()) {
        requireHostIo(it)?;
        let pathValue = argument(it, c, n, frame, arguments, 0)?;
        let path = bytesOf(it, pathValue)?;
        return match (File.remove(StringView.fromUtf8(path.view())!)) {
            Ok() => Ok(interpIoResult(c, resultType, 0, 0)?),
            Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
        };
    }
    if (b == bfResourceRead()) {
        requireHostIo(it)?;
        let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
        let slice = argument(it, c, n, frame, arguments, 1)?;
        var buffer = readBuffer(it, slice)?;
        var read: Result<usize, IoError> = Err(IoError.Other(9));
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow mut it.runtime.handles[k]) {
                    HostHandle.OpenFile(file, _) => { read = file.read(mut buffer[..]); }
                    HostHandle.Stream(stream) => { read = stream.read(mut buffer[..]); }
                    HostHandle.PathFile(p, position) => {
                        read = readFileAt(p.view(), mut buffer, position);
                        match (read) {
                            Ok(count) => { position = position + (count as u64); }
                            Err(_) => {}
                        }
                    }
                    _ => {}
                }
            }
            null => {}
        }
        match (read) {
            Ok(count) => {
                storeRead(it, slice, buffer, count)?;
                return Ok(interpIoResult(c, resultType, truncate<i64>(count), 0)?);
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
    }
    if (b == bfConsoleRead()) {
        let slice = argument(it, c, n, frame, arguments, 0)?;
        var buffer = readBuffer(it, slice)?;
        if (it.options.capture) {
            // The given input (a MemoryStream in the reference).
            let left = it.options.input.length - it.inputRead;
            let count = if (buffer.length < left) buffer.length else left;
            for (k in 0..count) {
                buffer[k] = it.options.input[it.inputRead + k];
            }
            it.inputRead += count;
            storeRead(it, slice, buffer, count)?;
            return Ok(interpIoResult(c, resultType, truncate<i64>(count), 0)?);
        }
        // ADR 0106: what Console.readLine read and did not take comes first; and what the program wrote is written
        // before the interpreter waits for input.
        if (buffer.length > 0 && it.stdinAt < it.stdinHeld.length) {
            let left = it.stdinHeld.length - it.stdinAt;
            let count = if (buffer.length < left) buffer.length else left;
            for (k in 0..count) {
                buffer[k] = it.stdinHeld[it.stdinAt + k];
            }
            it.stdinAt += count;
            storeRead(it, slice, buffer, count)?;
            return Ok(interpIoResult(c, resultType, truncate<i64>(count), 0)?);
        }
        flushOutputThrough(it);
        match (Console.read(mut buffer[..])) {
            Ok(count) => {
                storeRead(it, slice, buffer, count)?;
                return Ok(interpIoResult(c, resultType, truncate<i64>(count), 0)?);
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
    }
    if (b == bfResourceWrite()) {
        requireHostIo(it)?;
        let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
        let value = argument(it, c, n, frame, arguments, 1)?;
        let bytes = bytesOf(it, value)?;
        var written: Result<void, IoError> = Err(IoError.Other(9));
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow mut it.runtime.handles[k]) {
                    HostHandle.OpenFile(file, _) => { written = file.write(bytes.view()); }
                    HostHandle.Stream(stream) => { written = stream.write(bytes.view()); }
                    HostHandle.PathFile(p, position) => {
                        var at: u64 = position;
                        if (position == appendPosition()) {
                            at = match (wholeFile(p.view())) {
                                Ok(v) => v.length as u64,
                                Err(_) => 0,
                            };
                        }
                        written = writeFileAt(p.view(), bytes.view(), at);
                        match (written) {
                            Ok() => {
                                if (position != appendPosition()) { position = position + (bytes.length as u64); }
                            }
                            Err(_) => {}
                        }
                    }
                    _ => {}
                }
            }
            null => {}
        }
        return match (written) {
            Ok() => Ok(interpIoResult(c, resultType, truncate<i64>(bytes.length), 0)?),
            Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
        };
    }
    if (b == bfTcpListen() || b == bfTcpConnect()) {
        requireHostIo(it)?;
        let addressValue = argument(it, c, n, frame, arguments, 0)?;
        let addressText = bytesOf(it, addressValue)?;
        let port = truncate<u16>(argumentInteger(it, c, n, frame, arguments, 1)?.magnitude);
        let text = StringView.fromUtf8(addressText.view())!;
        if (b == bfTcpListen()) {
            match (TcpListener.bind(text, port)) {
                Ok(listener) => {
                    let fd = addHandle(it, HostHandle.Listener(listener));
                    return Ok(interpIoResult(c, resultType, fd, 0)?);
                }
                Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
            }
        }
        match (TcpStream.connect(text, port)) {
            Ok(stream) => {
                let fd = addHandle(it, HostHandle.Stream(stream));
                return Ok(interpIoResult(c, resultType, fd, 0)?);
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
    }
    if (b == bfTcpPort()) {
        requireHostIo(it)?;
        let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
        var port: Result<u16, IoError> = Err(IoError.Other(9));
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow mut it.runtime.handles[k]) {
                    HostHandle.Listener(listener) => { port = listener.port(); }
                    _ => {}
                }
            }
            null => {}
        }
        return match (port) {
            Ok(p) => Ok(interpIoResult(c, resultType, p as i64, 0)?),
            Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
        };
    }
    if (b == bfTcpAccept()) {
        requireHostIo(it)?;
        let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
        var accepted: Result<TcpStream, IoError> = Err(IoError.Other(9));
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow mut it.runtime.handles[k]) {
                    HostHandle.Listener(listener) => { accepted = listener.accept(); }
                    _ => {}
                }
            }
            null => {}
        }
        match (accepted) {
            Ok(stream) => {
                let fd2 = addHandle(it, HostHandle.Stream(stream));
                return Ok(interpIoResult(c, resultType, fd2, 0)?);
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
    }
    if (b == bfTcpShutdownWrite()) {
        requireHostIo(it)?;
        let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
        var done: Result<void, IoError> = Err(IoError.Other(9));
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow mut it.runtime.handles[k]) {
                    HostHandle.Stream(stream) => { done = stream.shutdownWrite(); }
                    _ => {}
                }
            }
            null => {}
        }
        return match (done) {
            Ok() => Ok(interpIoResult(c, resultType, 0, 0)?),
            Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
        };
    }
    if (b == bfTcpShutdownRead() || b == bfTcpSetNoDelay() || b == bfTcpSetKeepAlive() || b == bfTcpSetSendBuffer() ||
        b == bfTcpSetRecvBuffer() || b == bfTcpSetLinger()) {
        // ADR 0044 §3.6: the host's own TcpStream does each, on the stream the descriptor names.
        requireHostIo(it)?;
        let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
        var value: u64 = 0;
        var present = true;
        if (b != bfTcpShutdownRead()) {
            let argumentType = builtinArgumentType(n, arguments, 1);
            let v = argument(it, c, n, frame, arguments, 1)?;
            if (b == bfTcpSetKeepAlive() || b == bfTcpSetLinger()) {
                present = v.bits(0, enumTagSize(c, argumentType))? != 0;
                value = if (present) v.bits(enumUnionOffset(c, argumentType) as usize, 4)? else 0;
            } else {
                value = v.bits(0, if (b == bfTcpSetNoDelay()) 1 else 4)?;
            }
        }
        var done: Result<void, IoError> = Err(IoError.Other(9));
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow mut it.runtime.handles[k]) {
                    HostHandle.Stream(stream) => {
                        let seconds: u32? = if (present) Some(truncate<u32>(value)) else null;
                        done =
                            if (b == bfTcpShutdownRead()) stream.shutdownRead()
                                else if (b == bfTcpSetNoDelay()) stream.setNoDelay(
                                    value != 0,
                                )
                                else if (b == bfTcpSetKeepAlive()) stream.setKeepAlive(seconds)
                                else if (b == bfTcpSetSendBuffer()) stream.setSendBuffer(
                                    truncate<u32>(value),
                                )
                                else if (b == bfTcpSetRecvBuffer()) stream.setRecvBuffer(
                                    truncate<u32>(value),
                                )
                                else stream.setLinger(seconds);
                    }
                    _ => {}
                }
            }
            null => {}
        }
        return match (done) {
            Ok() => Ok(interpIoResult(c, resultType, 0, 0)?),
            Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
        };
    }
    if (b == bfProcessRun()) {
        requireHostIo(it)?;
        let program = argument(it, c, n, frame, arguments, 0)?;
        let vector = argument(it, c, n, frame, arguments, 1)?.bits(0, 8)?;
        let outcome = processRun(it, program, vector)?;
        return Ok(interpIoResult(c, resultType, outcome.value, outcome.error)?);
    }
    var m = copyBytes("cannot interpret built-in ".bytes())!;
    appendText(mut m, builtinFunctionName(b))!;
    return Err(faultBytes(m.view()));
}

struct HostOutcome {
    value: i64;
    error: i64;
}

fn hostOk(value: i64) -> HostOutcome => HostOutcome { value: value, error: 0 };

fn hostError(error: i64) -> HostOutcome => HostOutcome { value: 0, error: error };

/// ceesafe_process_run: the argument copies are counted allocations (argv, then each string, stopping at the first
/// failure); standard output is flushed; the child's exit status, or 128 + its signal.
fn processRun(it: borrow mut Interp, program: borrow Value, vector: u64) -> Result<HostOutcome, Stop> {
    let count = it.memory.loadBits(vector + 8, 8)?;
    if (count > 4096) {
        return Ok(hostError(errnoInvalid()));
    }
    var texts = Vector<Vector<u8>>.create();
    texts.push(bytesOf(it, program)?)!;
    for (i in 0..count) {
        let base = pointerAt(it, vector)?;
        let view = it.memory.load(base + i * 16, 16)?;
        texts.push(bytesOf(it, view)?)!;
    }
    let argv = alloc(it, (count + 2) * 8, allocSystem())?;
    if (argv == 0) {
        return Ok(hostError(errnoNoMemory()));
    }
    var made = Vector<u64>.create();
    var error: i64 = 0;
    for (text in texts.view()) {
        var zero = false;
        for (byte in text.view()) {
            zero = zero || byte == 0;
        }
        if (zero) {
            error = errnoInvalid();
            break;
        }
        let copy = alloc(it, (text.length as u64) + 1, allocSystem())?;
        if (copy == 0) {
            error = errnoNoMemory();
            break;
        }
        made.push(copy)!;
    }
    var result = hostError(error);
    if (error == 0) {
        flushOutput(it);
        var views = Vector<StringView>.create();
        for (k in 1..texts.length) {
            views.push(StringView.fromUtf8(texts[k].view())!)!;
        }
        result = match (Process.run(StringView.fromUtf8(texts[0].view())!, views)) {
            Ok(status) => hostOk(status as i64),
            Err(e) => hostError(errnoOf(e)),
        };
    }
    for (copy in made.view()) {
        freeMemory(it, copy)?;
    }
    freeMemory(it, argv)?;
    return Ok(result);
}

// ---- Host services (HostServices.cs; lib/std/host.cee's extern functions) ----

fn hostResult(value: i64) -> Value => valueOf(truncate<u64>(value), 8);

fn hostFailure(errno: i64) -> Value => hostResult(0 - errno);

/// The bytes at arguments[pointer] of the length at arguments[length].
fn hostBytes(
    it: borrow Interp,
    arguments: borrow Vector<Value>,
    pointer: usize,
    length: usize,
) -> Result<Vector<u8>, Stop> {
    let count = arguments[length].bits(0, 8)?;
    if (count > 0x7FFFFFFF) {
        return Err(fault("a host-service argument larger than the interpreter's memory"));
    }
    let value = it.memory.load(arguments[pointer].bits(0, 8)?, count as usize)?;
    return Ok(value.data);
}

/// ceesafe_c_path: no zero byte, at most 4,095 bytes, valid text; null otherwise.
fn hostPath(
    it: borrow Interp,
    arguments: borrow Vector<Value>,
    pointer: usize,
    length: usize,
) -> Result<Vector<u8>?, Stop> {
    let bytes = hostBytes(it, arguments, pointer, length)?;
    if (bytes.length >= 4096) {
        return Ok(null);
    }
    for (b in bytes.view()) {
        if (b == 0) {
            return Ok(null);
        }
    }
    if (StringView.fromUtf8(bytes.view()) == null) {
        return Ok(null);
    }
    return Ok(bytes);
}

/// Writes text to the buffer at arguments[buffer] of the capacity at arguments[capacity] (ERANGE if it does not fit).
fn hostOut(
    it: borrow mut Interp,
    arguments: borrow Vector<Value>,
    text: Slice<u8>,
    buffer: usize,
    capacity: usize,
) -> Result<Value, Stop> {
    if ((text.length as u64) > arguments[capacity].bits(0, 8)?) {
        return Ok(hostFailure(errnoRange()));
    }
    if (text.length > 0) {
        it.memory.store(arguments[buffer].bits(0, 8)?, initialisedValue(text))?;
    }
    return Ok(hostResult(truncate<i64>(text.length)));
}

fn hostService(it: borrow mut Interp, name: Slice<u8>, arguments: borrow Vector<Value>) -> Result<Value, Stop> {
    requireHostIo(it)?;
    if (sameText(name, "ceesafe_host_env")) {
        let key = hostBytes(it, arguments, 0, 1)?;
        var bad = key.length >= 4096;
        for (b in key.view()) {
            bad = bad || b == 0;
        }
        let keyText = StringView.fromUtf8(key.view());
        if (bad || keyText == null) {
            return Ok(hostFailure(errnoInvalid()));
        }
        match (Environment.variable(keyText!)) {
            Some(value) => {
                let pointer = literal(it, value.bytes())?;
                it.memory.storeBits(arguments[2].bits(0, 8)?, pointer, 8)?;
                it.memory.storeBits(arguments[3].bits(0, 8)?, value.bytes().length as u64, 8)?;
                return Ok(hostResult(1));
            }
            null => { return Ok(hostResult(0)); }
        }
    }
    if (sameText(name, "ceesafe_host_path_kind")) {
        let path = match (hostPath(it, arguments, 0, 1)?) {
            Some(p) => p,
            null => { return Ok(hostFailure(errnoInvalid())); }
        };
        let kind: i64 = match (File.kind(StringView.fromUtf8(path.view())!)) {
            Ok(found) => match (found) {
                Some(PathKind.Directory) => 2,
                Some(_) => 1,
                null => 0,
            },
            Err(_) => 0,
        };
        return Ok(hostResult(kind));
    }
    if (sameText(name, "ceesafe_host_modified") || sameText(name, "ceesafe_host_set_permissions")) {
        // ADR 0077: the stage-0 compiler's library can neither stat nor chmod, so the interpreter refuses both.
        return Ok(hostFailure(errnoFor(hostErrnos(), 95, 102, 130))); // EOPNOTSUPP: IoError.Unsupported
    }
    if (sameText(name, "ceesafe_host_file_modified")) {
        // ADR 0078 §3: as for ceesafe_host_modified, the stage-0 compiler's library cannot stat.
        return Ok(hostFailure(errnoFor(hostErrnos(), 95, 102, 130))); // EOPNOTSUPP: IoError.Unsupported
    }
    if (sameText(name, "ceesafe_host_file_kind")) {
        // ADR 0078 §3: the kind of the open file's path. The interpreter's files are opened by path, and nothing
        // renames them while it runs.
        let fd = truncate<i32>(truncate<u32>(it.memory.loadBits(arguments[0].bits(0, 8)?, 4)?));
        var path = String.create();
        match (handleIndex(it, fd)) {
            Some(k) => {
                match (borrow it.runtime.handles[k]) {
                    HostHandle.OpenFile(_, p) => { path.append(p.view())!; }
                    HostHandle.PathFile(p, _) => { path.append(p.view())!; }
                    HostHandle.Stream(_) => { return Ok(hostResult(3)); }
                    _ => {}
                }
            }
            null => {}
        }
        if (path.view().length == 0) {
            return Ok(hostFailure(9)); // EBADF, 9 on every host
        }
        let kind: i64 = match (File.kind(path.view())) {
            Ok(Some(PathKind.File)) => 1,
            Ok(Some(PathKind.Directory)) => 2,
            Ok(Some(_)) => 3,
            Ok(null) => 0 - 2, // ENOENT: removed since it was opened
            Err(e) => 0 - errnoOf(e),
        };
        return Ok(hostResult(kind));
    }
    if (sameText(name, "ceesafe_host_space")) {
        // ADR 0077: the interpreter describes no volume of its own, so a run stays reproducible.
        return Ok(hostFailure(errnoFor(hostErrnos(), 95, 102, 130))); // EOPNOTSUPP: IoError.Unsupported
    }
    if (sameText(name, "ceesafe_host_dir_sync")) {
        // ADR 0075 §2.1: nothing to make durable in the interpreter, once the directory is there.
        let path = match (hostPath(it, arguments, 0, 1)?) {
            Some(p) => p,
            null => { return Ok(hostFailure(errnoInvalid())); }
        };
        return match (File.kind(StringView.fromUtf8(path.view())!)) {
            Ok(found) => match (found) {
                Some(PathKind.Directory) => Ok(hostResult(0)),
                Some(_) => Ok(hostFailure(20)),
                null => Ok(hostFailure(2)),
            },
            Err(e) => Ok(hostFailure(errnoOf(e))),
        };
    }
    if (sameText(name, "ceesafe_host_rename")) {
        // ADR 0075 §2.1: a copy and a removal; the stage-0 compiler's library has no rename.
        let from = match (hostPath(it, arguments, 0, 1)?) {
            Some(p) => p,
            null => { return Ok(hostFailure(errnoInvalid())); }
        };
        let to = match (hostPath(it, arguments, 2, 3)?) {
            Some(p) => p,
            null => { return Ok(hostFailure(errnoInvalid())); }
        };
        let source = StringView.fromUtf8(from.view())!;
        let contents = match (wholeFile(source)) {
            Ok(v) => v,
            Err(e) => { return Ok(hostFailure(errnoOf(e))); }
        };
        match (replaceFile(StringView.fromUtf8(to.view())!, contents.view())) {
            Ok() => {}
            Err(e) => { return Ok(hostFailure(errnoOf(e))); }
        }
        return match (File.remove(source)) {
            Ok() => Ok(hostResult(0)),
            Err(e) => Ok(hostFailure(errnoOf(e))),
        };
    }
    if (sameText(name, "ceesafe_host_dir_create") || sameText(name, "ceesafe_host_dir_remove")) {
        let path = match (hostPath(it, arguments, 0, 1)?) {
            Some(p) => p,
            null => { return Ok(hostFailure(errnoInvalid())); }
        };
        let text = StringView.fromUtf8(path.view())!;
        let done = if (sameText(name, "ceesafe_host_dir_create")) Directory.create(text) else Directory.remove(text);
        return match (done) {
            Ok() => Ok(hostResult(0)),
            Err(e) => Ok(hostFailure(errnoOf(e))),
        };
    }
    if (sameText(name, "ceesafe_host_dir_open")) {
        let path = hostPath(it, arguments, 0, 1)?;
        var error: i64 = 0;
        var names = Vector<Vector<u8>>.create();
        match (path) {
            Some(p) => {
                match (Directory.list(StringView.fromUtf8(p.view())!)) {
                    Ok(listed) => {
                        for (entry in listed.view()) {
                            names.push(copyBytes(entry.view().bytes())!)!;
                        }
                    }
                    Err(e) => { error = errnoOf(e); }
                }
            }
            null => { error = errnoInvalid(); }
        }
        if (error != 0) {
            it.memory.storeBits(arguments[2].bits(0, 8)?, truncate<u64>(error), 4)?;
            return Ok(hostResult(0));
        }
        let listing = it.runtime.nextListing;
        it.runtime.nextListing += 1;
        it.runtime.listingAddresses.push(listing)!;
        it.runtime.listings.push(names)!;
        it.runtime.listingNext.push(0)!;
        return Ok(hostResult(truncate<i64>(listing)));
    }
    if (sameText(name, "ceesafe_host_dir_next") || sameText(name, "ceesafe_host_dir_close")) {
        let listing = arguments[0].bits(0, 8)?;
        var index = it.runtime.listingAddresses.length;
        for (k in 0..it.runtime.listingAddresses.length) {
            if (it.runtime.listingAddresses[k] == listing) {
                index = k;
            }
        }
        if (index == it.runtime.listingAddresses.length) {
            return Err(addressMessage("a directory listing that is not open (", listing, ")"));
        }
        if (sameText(name, "ceesafe_host_dir_close")) {
            it.runtime.listingAddresses[index] = 0;
            return Ok(hostResult(0));
        }
        let next = it.runtime.listingNext[index];
        if (next == it.runtime.listings[index].length) {
            return Ok(hostResult(0));
        }
        it.runtime.listingNext[index] = next + 1;
        let entry = copyBytes(it.runtime.listings[index][next].view())!;
        let pointer = literal(it, entry.view())?;
        it.memory.storeBits(arguments[1].bits(0, 8)?, pointer, 8)?;
        it.memory.storeBits(arguments[2].bits(0, 8)?, entry.length as u64, 8)?;
        return Ok(hostResult(1));
    }
    if (sameText(name, "ceesafe_host_temporary")) {
        return match (Directory.temporary()) {
            Ok(path) => hostOut(it, arguments, path.view().bytes(), 0, 1),
            Err(e) => Ok(hostFailure(errnoOf(e))),
        };
    }
    if (sameText(name, "ceesafe_host_current")) {
        if (it.options.workingDirectory.length > 0) {
            let directory = copyBytes(it.options.workingDirectory.view())!;
            return hostOut(it, arguments, directory.view(), 0, 1);
        }
        return match (Directory.current()) {
            Ok(path) => hostOut(it, arguments, path.view().bytes(), 0, 1),
            Err(e) => Ok(hostFailure(errnoOf(e))),
        };
    }
    // ceesafe_host_spawn: argv as views, then the paths of standard input, output and error.
    let count = arguments[1].bits(0, 8)?;
    if (count == 0 || count > 4097) {
        return Ok(hostFailure(errnoInvalid()));
    }
    var argv = Vector<Vector<u8>>.create();
    for (i in 0..count) {
        let view = it.memory.load(arguments[0].bits(0, 8)? + i * 16, 16)?;
        let text = bytesOf(it, view)?;
        for (b in text.view()) {
            if (b == 0) {
                return Ok(hostFailure(errnoInvalid()));
            }
        }
        argv.push(text)!;
    }
    let input = hostPath(it, arguments, 2, 3)?;
    let output = hostPath(it, arguments, 4, 5)?;
    let errors = hostPath(it, arguments, 6, 7)?;
    if (input == null || output == null || errors == null) {
        return Ok(hostFailure(errnoInvalid()));
    }
    let inputPath = input!;
    let outputPath = output!;
    let errorsPath = errors!;
    let stdinBytes = match (readFile(StringView.fromUtf8(inputPath.view())!)) {
        Ok(bytes) => bytes,
        Err(_) => Vector<u8>.create(),
    };
    flushOutput(it);
    var views = Vector<StringView>.create();
    for (k in 1..argv.length) {
        views.push(StringView.fromUtf8(argv[k].view())!)!;
    }
    match (Process.capture(StringView.fromUtf8(argv[0].view())!, views, stdinBytes.view())) {
        Ok(captured) => {
            match (writeFile(StringView.fromUtf8(outputPath.view())!, captured.stdout.view())) {
                Ok() => {}
                Err(e) => { return Ok(hostFailure(errnoOf(e))); }
            }
            match (writeFile(StringView.fromUtf8(errorsPath.view())!, captured.stderr.view())) {
                Ok() => {}
                Err(e) => { return Ok(hostFailure(errnoOf(e))); }
            }
            return Ok(hostResult(captured.status as i64));
        }
        Err(e) => { return Ok(hostFailure(errnoOf(e))); }
    }
}

// ---- The C library model (CLibrary.cs) ----

/// The shapes of a modelled C function's parameters and result: P pointer, i int32_t, s uint64_t/size_t, u uint32_t,
/// l int64_t, and the result after ':' ('-' for void). Null for a function the interpreter does not model.
fn cLibraryShape(name: Slice<u8>) -> StringView? {
    if (sameText(name, "strlen")) {
        return "P:s";
    }
    if (sameText(name, "puts")) {
        return "P:i";
    }
    if (sameText(name, "abs")) {
        return "i:i";
    }
    if (sameText(name, "memcmp")) {
        return "PPs:i";
    }
    if (sameText(name, "memcpy")) {
        return "PPs:P";
    }
    if (sameText(name, "memset")) {
        return "Pis:P";
    }
    if (sameText(name, "malloc")) {
        return "s:P";
    }
    if (sameText(name, "free")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_host_env")) {
        return "PsPP:l";
    }
    if (sameText(name, "ceesafe_host_path_kind")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_dir_create")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_dir_sync")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_space")) {
        return "PsPPP:l";
    }
    if (sameText(name, "ceesafe_host_modified")) {
        return "PsPP:l";
    }
    if (sameText(name, "ceesafe_host_file_modified")) {
        return "PPP:l";
    }
    if (sameText(name, "ceesafe_host_file_kind")) {
        return "P:l";
    }
    if (sameText(name, "ceesafe_host_set_permissions")) {
        return "Psu:l";
    }
    if (sameText(name, "ceesafe_host_console_flush")) {
        return ":l";
    }
    if (sameText(name, "ceesafe_host_console_read_line")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_rename")) {
        return "PsPs:l";
    }
    if (sameText(name, "ceesafe_host_dir_remove")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_dir_open")) {
        return "PsP:P";
    }
    if (sameText(name, "ceesafe_host_dir_next")) {
        return "PPP:l";
    }
    if (sameText(name, "ceesafe_async_now")) {
        return ":s";
    }
    if (sameText(name, "ceesafe_chan_create")) {
        return "sss:P";
    }
    if (sameText(name, "ceesafe_chan_release") || sameText(name, "ceesafe_chan_closed")) {
        return "P:b";
    }
    if (sameText(name, "ceesafe_chan_begin_send") || sameText(name, "ceesafe_chan_begin_recv")) {
        return "PPP:P";
    }
    if (sameText(name, "ceesafe_chan_wait")) {
        return "Ps:-";
    }
    if (sameText(name, "ceesafe_chan_park")) {
        return "PPs:b";
    }
    if (sameText(name, "ceesafe_chan_unpark")) {
        return "PP:-";
    }
    if (n0IsChannelHandleCall(name)) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_async_wait_until")) {
        return "s:-";
    }
    if (sameText(name, "ceesafe_async_wait_writable")) {
        return "i:-";
    }
    if (sameText(name, "ceesafe_async_write")) {
        return "iPs:l";
    }
    if (sameText(name, "ceesafe_async_status")) {
        return ":u";
    }
    if (sameText(name, "ceesafe_async_wait_readable") || sameText(name, "ceesafe_async_close")) {
        return "i:-";
    }
    if (sameText(name, "ceesafe_async_tcp_listen") || sameText(name, "ceesafe_async_tcp_connect")) {
        return "Psh:l";
    }
    if (sameText(name, "ceesafe_async_tcp_port") || sameText(name, "ceesafe_async_tcp_accept") ||
        sameText(name, "ceesafe_async_tcp_connected") || sameText(name, "ceesafe_async_shutdown_write")) {
        return "i:l";
    }
    if (sameText(name, "ceesafe_async_read") || sameText(name, "ceesafe_async_send")) {
        return "iPs:l";
    }
    if (sameText(name, "ceesafe_async_poll")) {
        return "PPPsl:l";
    }
    if (sameText(name, "ceesafe_async_op_read") || sameText(name, "ceesafe_async_op_send")) {
        return "PiPs:l";
    }
    if (sameText(name, "ceesafe_async_op_accept")) {
        return "Pi:l";
    }
    if (sameText(name, "ceesafe_async_msg_part")) {
        return "PuPs:-";
    }
    if (sameText(name, "ceesafe_dns_start")) {
        return "Psh:P";
    }
    if (sameText(name, "ceesafe_dns_poll")) {
        return "P:i";
    }
    if (sameText(name, "ceesafe_dns_count")) {
        return "P:u";
    }
    if (sameText(name, "ceesafe_dns_address")) {
        return "PuPPP:-";
    }
    if (sameText(name, "ceesafe_dns_end")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_async_op_sendv")) {
        return "Piu:l";
    }
    if (sameText(name, "ceesafe_async_udp_bind")) {
        return "uPhuuuu:l";
    }
    if (sameText(name, "ceesafe_async_msg_send_to")) {
        return "PuuPhuuPuu:-";
    }
    if (sameText(name, "ceesafe_async_op_sendmsg")) {
        return "Piu:l";
    }
    if (sameText(name, "ceesafe_async_op_recvmsg")) {
        return "PiPs:l";
    }
    if (sameText(name, "ceesafe_async_msg_address")) {
        return "PuPP:l";
    }
    if (sameText(name, "ceesafe_async_msg_flags")) {
        return "P:u";
    }
    if (sameText(name, "ceesafe_async_udp_send")) {
        return "iPsuuPhu:l";
    }
    if (sameText(name, "ceesafe_async_udp_recv")) {
        return "iPsPPP:l";
    }
    if (sameText(name, "ceesafe_async_op_connect")) {
        return "PPsh:l";
    }
    if (sameText(name, "ceesafe_async_op_connect_at")) {
        return "PuPhu:l";
    }
    if (sameText(name, "ceesafe_async_tcp_listen_at")) {
        return "uPhuuu:l";
    }
    if (sameText(name, "ceesafe_async_tcp_connect_at")) {
        return "uPhu:l";
    }
    if (sameText(name, "ceesafe_async_socket_name")) {
        return "iuPP:l";
    }
    if (sameText(name, "ceesafe_async_socket_option")) {
        return "iul:l";
    }
    if (sameText(name, "ceesafe_async_shutdown_read")) {
        return "i:l";
    }
    if (sameText(name, "ceesafe_interface_index")) {
        return "Ps:u";
    }
    if (sameText(name, "ceesafe_async_op_cancel")) {
        return "P:b";
    }
    if (sameText(name, "ceesafe_async_shield_enter")) {
        return "s:-";
    }
    if (sameText(name, "ceesafe_async_shield_leave")) {
        return ":-";
    }
    if (sameText(name, "ceesafe_async_signal_take")) {
        return "P:b";
    }
    if (sameText(name, "ceesafe_async_set_init")) {
        return "PuP:-";
    }
    if (sameText(name, "ceesafe_async_set_admit")) {
        return "Pb:u";
    }
    if (sameText(name, "ceesafe_async_set_done") || sameText(name, "ceesafe_async_set_oom")) {
        return "P:b";
    }
    if (sameText(name, "ceesafe_async_set_cancel")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_async_signal_forget") || sameText(name, "ceesafe_async_signal_raise")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_host_dir_close")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_host_temporary")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_current")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_host_spawn")) {
        return "PsPsPsPs:l";
    }
    if (sameText(name, "ceesafe_io_kind")) {
        return "i:u";
    }
    if (sameText(name, "ceesafe_test_begin")) {
        return "ss:-";
    }
    if (sameText(name, "ceesafe_random_key")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_random_fill")) {
        return "Ps:l";
    }
    if (sameText(name, "ceesafe_crc32c_available")) {
        return ":u";
    }
    if (sameText(name, "ceesafe_crc32c_update")) {
        return "uPs:u";
    }
    if (sameText(name, "ceesafe_clock_realtime")) {
        return "PP:-";
    }
    if (sameText(name, "ceesafe_clock_monotonic")) {
        return ":s";
    }
    if (sameText(name, "ceesafe_window_open")) {
        return "PsuuP:P";
    }
    if (sameText(name, "ceesafe_async_op_sendfile")) {
        return "PiPss:l";
    }
    if (sameText(name, "ceesafe_file_read_at")) {
        return "PPss:l";
    }
    if (sameText(name, "ceesafe_thread_watchdog")) {
        return "s:-";
    }
    if (sameText(name, "ceesafe_mutex_create")) {
        return ":P";
    }
    if (sameText(name, "ceesafe_mutex_lock")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_mutex_once_lock") || sameText(name, "ceesafe_mutex_once_unlock")) {
        return ":-"; // ADR 0096
    }
    if (sameText(name, "ceesafe_mutex_unlock")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_mutex_destroy")) {
        return "P:-";
    }
    if (sameText(name, "ceesafe_atomic_load_u64")) {
        return "P:s";
    }
    if (sameText(name, "ceesafe_atomic_store_u64")) {
        return "Ps:-";
    }
    if (sameText(name, "ceesafe_atomic_swap_u64")) {
        return "Ps:s";
    }
    if (sameText(name, "ceesafe_atomic_cas_u64")) {
        return "Pss:s";
    }
    if (sameText(name, "ceesafe_atomic_add_u64")) {
        return "Ps:s";
    }
    if (sameText(name, "ceesafe_atomic_load_u32")) {
        return "P:u";
    }
    if (sameText(name, "ceesafe_atomic_load_u8") || sameText(name, "ceesafe_atomic_load_ord_u8")) {
        return if (sameText(name, "ceesafe_atomic_load_u8")) "P:y" else "Pi:y"; // ADR 0080 §3.5
    }
    if (sameText(name, "ceesafe_atomic_store_u8")) {
        return "Py:-";
    }
    if (sameText(name, "ceesafe_atomic_store_ord_u8")) {
        return "Pyi:-";
    }
    if (sameText(name, "ceesafe_atomic_swap_u8")) {
        return "Py:y";
    }
    if (sameText(name, "ceesafe_atomic_cas_u8")) {
        return "Pyy:y";
    }
    if (sameText(name, "ceesafe_atomic_store_u32")) {
        return "Pu:-";
    }
    if (sameText(name, "ceesafe_atomic_swap_u32")) {
        return "Pu:u";
    }
    if (sameText(name, "ceesafe_atomic_cas_u32")) {
        return "Puu:u";
    }
    if (sameText(name, "ceesafe_atomic_add_u32")) {
        return "Pu:u";
    }
    if (sameText(name, "ceesafe_atomic_load_ord_u64")) {
        return "Pi:s";
    }
    if (sameText(name, "ceesafe_atomic_store_ord_u64")) {
        return "Psi:-";
    }
    if (sameText(name, "ceesafe_atomic_swap_ord_u64")) {
        return "Psi:s";
    }
    if (sameText(name, "ceesafe_atomic_cas_ord_u64")) {
        return "Pssi:s";
    }
    if (sameText(name, "ceesafe_atomic_add_ord_u64")) {
        return "Psi:s";
    }
    if (sameText(name, "ceesafe_atomic_load_ord_u32")) {
        return "Pi:u";
    }
    if (sameText(name, "ceesafe_atomic_store_ord_u32")) {
        return "Pui:-";
    }
    if (sameText(name, "ceesafe_atomic_swap_ord_u32")) {
        return "Pui:u";
    }
    if (sameText(name, "ceesafe_atomic_cas_ord_u32")) {
        return "Puui:u";
    }
    if (sameText(name, "ceesafe_atomic_add_ord_u32")) {
        return "Pui:u";
    }
    // fetchOr and fetchAnd (ADR 0041)
    if (sameText(name, "ceesafe_atomic_or_u64") || sameText(name, "ceesafe_atomic_and_u64")) {
        return "Ps:s";
    }
    if (sameText(name, "ceesafe_atomic_or_u32") || sameText(name, "ceesafe_atomic_and_u32")) {
        return "Pu:u";
    }
    if (sameText(name, "ceesafe_atomic_or_ord_u64") || sameText(name, "ceesafe_atomic_and_ord_u64")) {
        return "Psi:s";
    }
    if (sameText(name, "ceesafe_atomic_or_ord_u32") || sameText(name, "ceesafe_atomic_and_ord_u32")) {
        return "Pui:u";
    }
    return null;
}

fn fitsShape(c: borrow Checker, t: u32, shape: u8) -> bool {
    let info = c.types.info(t);
    if (shape == 'P') {
        return c.types.is(t, TypeKind.RawPointer);
    }
    if (shape == 'b') {
        return c.types.is(t, TypeKind.Bool);
    }
    if (shape == 'h') {
        return c.types.is(t, TypeKind.Integer) && info.bits == 16 && !info.signed;
    }
    let integer = c.types.is(t, TypeKind.Integer);
    return match (shape) {
        'i' => integer && info.bits == 32 && info.signed,
        'u' => integer && info.bits == 32 && !info.signed,
        'y' => integer && info.bits == 8 && !info.signed,
        'l' => integer && info.bits == 64 && info.signed,
        _ => integer && info.bits == 64 && !info.signed,
    };
}

fn modelFits(c: borrow Checker, function: borrow HirFunction, shape: StringView) -> bool {
    let s = shape.bytes();
    var colon: usize = 0;
    while (s[colon] != ':') {
        colon += 1;
    }
    if (colon != function.parameters.length) {
        return false;
    }
    for (k in 0..colon) {
        if (!fitsShape(c, c.hir.locals[function.parameters[k] as usize].typ, s[k])) {
            return false;
        }
    }
    if (s[colon + 1] == '-') {
        return c.types.is(function.returnType, TypeKind.Void);
    }
    return fitsShape(c, function.returnType, s[colon + 1]);
}

fn callC(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    hir: u32,
    arguments: borrow Vector<Value>,
) -> Result<Value?, Stop> {
    let function = borrow c.hir.functions[hir as usize];
    let name = copyBytes(c.name(function.name))!;
    let fits = match (cLibraryShape(name.view())) {
        Some(shape) => modelFits(c, function, shape),
        null => false,
    };
    if (!fits) {
        var m = copyBytes("unsupported: call to C function '".bytes())!;
        appendBytes(mut m, name.view())!;
        appendText(mut m, "' (the interpreter runs no C code)")!;
        return Err(faultBytes(m.view()));
    }
    let n0 = name.view();
    if (sameText(n0, "strlen")) {
        let start = arguments[0].bits(0, 8)?;
        var length: u64 = 0;
        while (it.memory.loadBits(start + length, 1)? != 0) {
            length += 1;
        }
        return Ok(valueOf(length, 8));
    }
    if (sameText(n0, "puts")) {
        var bytes = Vector<u8>.create();
        var at = arguments[0].bits(0, 8)?;
        loop {
            let b = it.memory.loadBits(at, 1)?;
            if (b == 0) {
                break;
            }
            bytes.push(truncate<u8>(b))!;
            at += 1;
        }
        bytes.push('\n')!;
        writeOutput(it, bytes.view());
        return Ok(valueOf(0, 4));
    }
    if (sameText(n0, "abs")) {
        // abs(INT_MIN) is undefined in C.
        let v = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        if (v == -2147483648) {
            return Err(fault("abs of the minimum int (undefined in C)"));
        }
        return Ok(valueOf(truncate<u64>(if (v < 0) 0 - v else v), 4));
    }
    if (sameText(n0, "memcmp")) {
        let count = arguments[2].bits(0, 8)?;
        for (i in 0..count) {
            let a = it.memory.loadBits(arguments[0].bits(0, 8)? + i, 1)?;
            let b = it.memory.loadBits(arguments[1].bits(0, 8)? + i, 1)?;
            if (a != b) {
                return Ok(valueOf(if (a < b) 0xFFFFFFFF else 1, 4));
            }
        }
        return Ok(valueOf(0, 4));
    }
    if (sameText(n0, "memcpy")) {
        let to = arguments[0].bits(0, 8)?;
        let from = arguments[1].bits(0, 8)?;
        let count = arguments[2].bits(0, 8)?;
        if (count > 0 && to < from + count && from < to + count) {
            return Err(fault("memcpy with overlapping ranges (undefined in C)"));
        }
        if (count > 0) {
            let value = it.memory.load(from, count as usize)?;
            it.memory.store(to, value)?;
        }
        return Ok(valueOf(to, 8));
    }
    if (sameText(n0, "malloc")) {
        // A heap allocation of the interpreter's memory (not counted as the reference's own: it is C's).
        let size = arguments[0].bits(0, 8)?;
        if (size == 0) {
            return Ok(valueOf(0, 8));
        }
        return Ok(valueOf(it.memory.allocate(allocationHeap(), size as usize, false, "malloc".bytes())?, 8));
    }
    if (sameText(n0, "free")) {
        let pointer = arguments[0].bits(0, 8)?;
        if (pointer != 0) {
            it.memory.free(pointer)?;
        }
        return Ok(null);
    }
    if (sameText(n0, "memset")) {
        let to = arguments[0].bits(0, 8)?;
        let count = arguments[2].bits(0, 8)?;
        let fill = arguments[1].bits(0, 4)? & 0xFF;
        for (i in 0..count) {
            it.memory.store(to + i, valueOf(fill, 1))?;
        }
        return Ok(valueOf(to, 8));
    }
    if (sameText(n0, "ceesafe_mutex_create")) {
        return Ok(valueOf(mutexCreate(it)?, 8));
    }
    if (sameText(n0, "ceesafe_mutex_lock")) {
        mutexLock(it, c, n, arguments[0].bits(0, 8)?)?;
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_mutex_once_lock")) {
        // OnceLock's lock (ADR 0096): a mutex at an address no allocation has, recursive for its owner.
        if (mutexOwner(it, onceLockAddress()) == it.runtime.current) {
            it.runtime.onceDepth += 1;
            return Ok(null);
        }
        var known = false;
        for (k in 0..it.runtime.mutexAddresses.length) {
            if (it.runtime.mutexAddresses[k] == onceLockAddress()) {
                known = true;
            }
        }
        if (!known) {
            it.runtime.mutexAddresses.push(onceLockAddress())!;
            it.runtime.mutexOwners.push(none())!;
        }
        mutexLock(it, c, n, onceLockAddress())?;
        it.runtime.onceDepth = 1;
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_mutex_once_unlock")) {
        it.runtime.onceDepth -= 1;
        if (it.runtime.onceDepth == 0) {
            for (k in 0..it.runtime.mutexAddresses.length) {
                if (it.runtime.mutexAddresses[k] == onceLockAddress()) {
                    it.runtime.mutexOwners[k] = none();
                }
            }
        }
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_mutex_unlock")) {
        let address = arguments[0].bits(0, 8)?;
        for (k in 0..it.runtime.mutexAddresses.length) {
            if (it.runtime.mutexAddresses[k] == address) {
                it.runtime.mutexOwners[k] = none();
            }
        }
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_mutex_destroy")) {
        let address = arguments[0].bits(0, 8)?;
        for (k in 0..it.runtime.mutexAddresses.length) {
            if (it.runtime.mutexAddresses[k] == address) {
                it.runtime.mutexAddresses[k] = 0;
            }
        }
        freeMemory(it, address)?;
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_crc32c_available")) {
        // Crc32c (ADR 0089): the interpreter has no CRC instruction, so lib/std keeps its tables, as on such a CPU.
        return Ok(valueOf(0, 4));
    }
    if (sameText(n0, "ceesafe_crc32c_update")) {
        // Not reached while ceesafe_crc32c_available answers 0; modelled bit by bit (reflected 0x82F63B78) all the same.
        var crc = arguments[0].bits(0, 4)?;
        let at = arguments[1].bits(0, 8)?;
        let length = arguments[2].bits(0, 8)?;
        var k: u64 = 0;
        while (k < length) {
            crc = crc ^ it.memory.loadBits(at + k, 1)?;
            for (bit in 0..8) {
                crc = if (crc & 1 != 0) (crc >> 1) ^ 0x82F63B78 else crc >> 1;
            }
            k += 1;
        }
        return Ok(valueOf(crc, 4));
    }
    if (sameText(n0, "ceesafe_random_fill")) {
        // Random.fill (ADR 0060): a fixed sequence, SplitMix64 from a fixed seed and continuing from call to call, so
        // a run stays reproducible (§40.8). Not secret.
        let at = arguments[0].bits(0, 8)?;
        let length = arguments[1].bits(0, 8)?;
        var k: u64 = 0;
        while (k < length) {
            it.randomState = it.randomState.wrappingAdd(0x9e3779b97f4a7c15);
            var z = it.randomState;
            z = (z ^ (z >> 30)).wrappingMul(0xbf58476d1ce4e5b9);
            z = (z ^ (z >> 27)).wrappingMul(0x94d049bb133111eb);
            z = z ^ (z >> 31);
            var b: u64 = 0;
            while (b < 8 && k < length) {
                it.memory.storeBits(at + k, (z >> (8 * b)) & 0xFF, 1)?;
                b += 1;
                k += 1;
            }
        }
        return Ok(valueOf(0, 8));
    }
    if (sameText(n0, "ceesafe_random_key")) {
        // HashMap's key (ADR 0052): fixed in the interpreter; a map's order never depends on it.
        let at = arguments[0].bits(0, 8)?;
        it.memory.storeBits(at, 0xa6d2ae2816157e2b, 8)?;
        it.memory.storeBits(at + 8, 0x3c4fcf098815f7ab, 8)?;
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_async_op_sendfile")) {
        // ADR 0051 §3.3: no sendfile here; lib/std copies through ceesafe_file_read_at, with the same results.
        return Ok(valueOf(0x8000000000000002, 8)); // CEE_ASYNC_NO_SENDFILE
    }
    if (sameText(n0, "ceesafe_file_read_at")) {
        return readAt(it, arguments);
    }
    if (sameText(n0, "ceesafe_clock_monotonic")) {
        // ADR 0075 §2.6: the virtual clock, in nanoseconds, so a run stays reproducible.
        return Ok(valueOf(it.asyncClock * 1000000, 8));
    }
    if (sameText(n0, "ceesafe_clock_realtime")) {
        // Wall-clock time (ADR 0055): 2000-01-01T00:00:00Z plus the virtual clock, so a run stays reproducible.
        let ms = it.asyncClock;
        it.memory.storeBits(arguments[0].bits(0, 8)?, 946684800 + ms / 1000, 8)?;
        it.memory.storeBits(arguments[1].bits(0, 8)?, (ms % 1000) * 1000000, 4)?;
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_window_open")) {
        // Window.open (type-system.md §26.13, ADR 0069): the interpreter has no window system, so every open is
        // WindowError.Unsupported, and no other window call can be reached.
        it.memory.storeBits(arguments[4].bits(0, 8)?, 1, 4)?;
        return Ok(valueOf(0, 8));
    }
    if (sameText(n0, "ceesafe_test_begin")) {
        // `ceesafec test --interp` (ADR 0049 §3.3): the allocation report, so a leak is found as natively; the
        // sweeps are native only (the runner refuses --interp --sweep).
        it.options.allocationReport = true;
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_thread_watchdog")) {
        let ms = arguments[0].bits(0, 8)?;
        it.testDeadline = if (ms == 0) 0 else Timer.now() + ms; // checked by `step`
        return Ok(null);
    }
    if (sameText(n0, "ceesafe_io_kind")) {
        let error = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        return Ok(valueOf(ioKindOf(error as i64), 4));
    }
    if (n0.length > 13 && sameText(n0[0..13], "ceesafe_chan_")) {
        return channelService(it, c, n, n0, arguments);
    }
    if (n0.length > 14 && sameText(n0[0..14], "ceesafe_async_")) {
        return asyncService(it, n0, arguments);
    }
    if (n0.length > 12 && sameText(n0[0..12], "ceesafe_dns_")) {
        return asyncService(it, n0, arguments); // ADR 0048's model, with the sockets'
    }
    if (sameText(n0, "ceesafe_host_console_flush")) {
        // Console.flush (ADR 0077): written now, not only handed to the interpreter's own buffer (ADR 0106). It is
        // no host I/O: the sandbox, which keeps the output, has nothing to flush, and refused the call before.
        flushOutputThrough(it);
        return Ok(hostResult(0));
    }
    if (sameText(n0, "ceesafe_host_console_read_line")) {
        // Console.readLine's step (ADR 0106): standard input is the sandbox's given input too, so no host I/O.
        let at = arguments[0].bits(0, 8)?;
        let capacity = arguments[1].bits(0, 8)?;
        if (capacity == 0) {
            return Ok(hostFailure(errnoInvalid()));
        }
        it.memory.load(at, 1)?; // the buffer must be live
        match (readLineBytes(it, capacity)) {
            Ok(taken) => {
                if (taken.length > 0) {
                    it.memory.store(at, initialisedValue(taken.view()))?;
                }
                return Ok(hostResult(truncate<i64>(taken.length)));
            }
            Err(e) => { return Ok(hostFailure(errnoOf(e))); }
        }
    }
    if (n0.length > 13 && sameText(n0[0..13], "ceesafe_host_")) {
        let result = hostService(it, n0, arguments)?;
        return Ok(if (sameText(n0, "ceesafe_host_dir_close")) null else result);
    }
    // ceesafe_atomic_*: one thread runs at a time (§5), so every operation is atomic; the width is the name's suffix.
    let byte = sameText(n0[n0.length - 3..], "_u8"); // AtomicU8 (ADR 0080 §3.5)
    let size: usize = if (byte) 1 else if (sameText(n0[n0.length - 3..], "u64")) 8 else 4;
    let mask: u64 = if (size == 8) 0xFFFFFFFFFFFFFFFF else if (size == 1) 0xFF else 0xFFFFFFFF;
    let at = arguments[0].bits(0, 8)?;
    let old = it.memory.loadBits(at, size)?;
    let suffix: usize = if (byte) 3 else 4;
    let operation = n0[15..n0.length - suffix];
    let ordered = operation.length > 4 && sameText(operation[operation.length - 4..], "_ord");
    let plain = operation[0..(if (ordered) operation.length - 4 else operation.length)];
    if (sameText(plain, "store")) {
        it.memory.storeBits(at, arguments[1].bits(0, size)?, size)?;
        return Ok(null);
    }
    if (sameText(plain, "swap")) {
        it.memory.storeBits(at, arguments[1].bits(0, size)?, size)?;
    } else if (sameText(plain, "cas")) {
        if (old == arguments[1].bits(0, size)?) {
            it.memory.storeBits(at, arguments[2].bits(0, size)?, size)?;
        }
    } else if (sameText(plain, "add")) {
        it.memory.storeBits(at, old.wrappingAdd(arguments[1].bits(0, size)?) & mask, size)?;
    } else if (sameText(plain, "or")) {
        it.memory.storeBits(at, (old | arguments[1].bits(0, size)?) & mask, size)?;
    } else if (sameText(plain, "and")) {
        it.memory.storeBits(at, old & arguments[1].bits(0, size)? & mask, size)?;
    }
    return Ok(valueOf(old, size));
}

// ---- Threads (Threads.cs): cooperative, one at a time, switching only when the running thread blocks ----

/// The address of OnceLock's lock (ADR 0096) among the mutexes: below every allocation's.
fn onceLockAddress() -> u64 => 8;

fn mutexOwner(it: borrow Interp, address: u64) -> u32 {
    for (k in 0..it.runtime.mutexAddresses.length) {
        if (it.runtime.mutexAddresses[k] == address) {
            return it.runtime.mutexOwners[k];
        }
    }
    return none();
}

fn runnable(it: borrow Interp, k: usize) -> bool {
    let t = borrow it.runtime.threads[k];
    if (t.finished) {
        return false;
    }
    if (t.waitingKind == 1) {
        return it.runtime.threads[t.waitingOn as usize].finished;
    }
    if (t.waitingKind == 2) {
        return mutexOwner(it, t.waitingOn) == none();
    }
    if (t.waitingKind == 3) {
        // A channel's blocking wait: until its epoch moves (index << 40 | the low 40 bits of the epoch seen).
        let channel = borrow it.runtime.channels[(t.waitingOn >> 40) as usize];
        return (channel.epoch & 0xFFFFFFFFFF) != (t.waitingOn & 0xFFFFFFFFFF);
    }
    return true;
}

/// Waits until the running thread's wait is over: the baton goes to the first runnable thread in spawn order, which
/// runs here until it ends. A thread that started and is blocked deeper in this host stack cannot be resumed out of
/// order (docs/p8-plan.md, known differences); if no thread can run, it is a deadlock.
fn waitHere(it: borrow mut Interp, c: borrow Checker, n: borrow NirProgram, kind: u32, on: u64) -> Result<void, Stop> {
    let me = it.runtime.current;
    it.runtime.threads[me as usize].waitingKind = kind;
    it.runtime.threads[me as usize].waitingOn = on;
    loop {
        var next = none();
        for (k in 0..it.runtime.threads.length) {
            if (next == none() && runnable(it, k)) {
                next = truncate<u32>(k);
            }
        }
        if (next == me) {
            break;
        }
        var startable = none();
        if (next != none() && !it.runtime.threads[next as usize].started) {
            startable = next;
        } else {
            for (k in 0..it.runtime.threads.length) {
                if (startable == none() && runnable(it, k) && !it.runtime.threads[k].started) {
                    startable = truncate<u32>(k);
                }
            }
            if (startable == none() && runnable(it, me as usize)) {
                break;
            }
        }
        if (startable == none()) {
            return Err(fault("deadlock: every thread is waiting for another (type-system.md §38)"));
        }
        runThread(it, c, n, startable)?;
    }
    it.runtime.threads[me as usize].waitingKind = 0;
    it.runtime.current = me;
    return Ok();
}

/// Runs a thread that has not started, here, until it ends.
fn runThread(it: borrow mut Interp, c: borrow Checker, n: borrow NirProgram, k: u32) -> Result<void, Stop> {
    let previous = it.runtime.current;
    it.runtime.threads[k as usize].started = true;
    it.runtime.current = k;
    let scratch = scratchAside(it); // the thread's own scratch stack (type-system.md §19.5)
    let t = it.runtime.threads[k as usize];
    var arguments = Vector<Value>.create();
    arguments.push(valueOf(t.data, 8))!;
    if (t.isClosure) {
        let code = it.memory.loadBits(t.data, 8)?;
        callThrough(it, c, n, code, arguments)?;
    } else {
        match (callFunction(it, c, n, t.function, arguments)?) {
            Some(value) => {
                let offset = resultOffset(c, t.resultType)?;
                it.memory.store(t.block + offset, value)?;
            }
            null => {}
        }
    }
    scratchRestore(it, scratch);
    it.runtime.threads[k as usize].finished = true;
    it.runtime.current = previous;
    return Ok();
}

/// The record of a thread: its runtime record, its closure (data, table), then the body's result.
fn resultOffset(c: borrow Checker, result: u32) -> Result<u64, Stop> {
    let align = typeAlign(c, result)?;
    return Ok((24 + align - 1) / align * align);
}

fn threadRecordSize(c: borrow Checker, result: u32) -> Result<u64, Stop> {
    if (c.types.is(result, TypeKind.Void)) {
        return Ok(24);
    }
    return Ok(resultOffset(c, result)? + typeSize(c, result)? as u64);
}

fn addThread(it: borrow mut Interp, isClosure: bool, function: u32, data: u64, block: u64, resultType: u32) -> u32 {
    it.runtime.threads.push(
        InterpThread {
            started: false,
            finished: false,
            waitingKind: 0,
            waitingOn: 0,
            isClosure: isClosure,
            function: function,
            data: data,
            block: block,
            resultType: resultType,
        },
    )!;
    return truncate<u32>(it.runtime.threads.length - 1);
}

/// The first dyn table pairing an environment with a `dyn fn` (ThreadSpawn's dyn).
fn dynFunctionTableOf(c: borrow Checker, implementation: u32) -> Result<usize, Stop> {
    for (k in 0..c.dynTables.length) {
        let table = borrow c.dynTables[k];
        if (table.implementation == implementation && c.types.info(table.dynType).dynInterface == none()) {
            return Ok(k);
        }
    }
    return Err(fault("a thread body with no dyn table"));
}

fn threadBuiltin(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    r: u32,
    b: u32,
    arguments: Range,
) -> Result<Value?, Stop> {
    let resultType = n.rvalueTypes[r as usize];
    if (b == bfThreadSpawn()) {
        // ceeTS_: the environment into the heap, and a thread running it; the same three allocations as the C runtime.
        let environment = argument(it, c, n, frame, arguments, 0)?;
        let environmentType = builtinArgumentType(n, arguments, 0);
        let thread = resultOkOf(c, resultType);
        let result = elementOf(c, thread);
        let table = dynFunctionTableOf(c, environmentType)?;
        let block = alloc(it, threadRecordSize(c, result)?, allocSystem())?;
        if (block == 0) {
            destroyValue(it, c, n, environmentType, environment)?;
            return Ok(outOfMemory(c, resultType)?);
        }
        let data = alloc(it, typeSize(c, environmentType)? as u64, allocSystem())?;
        if (data == 0) {
            freeMemory(it, block)?;
            destroyValue(it, c, n, environmentType, environment)?;
            return Ok(outOfMemory(c, resultType)?);
        }
        it.memory.store(data, environment)?;
        let record = alloc(it, 8, allocSystem())?;
        if (record == 0) {
            if (c.types.needsDrop(environmentType)) {
                destroy(it, c, n, environmentType, data)?;
            }
            freeMemory(it, data)?;
            freeMemory(it, block)?;
            return Ok(outOfMemory(c, resultType)?);
        }
        it.memory.storeBits(block, record, 8)?;
        it.memory.storeBits(block + 8, data, 8)?;
        it.memory.storeBits(block + 16, dynTableBase() + (table as u64) * 16, 8)?;
        let body = nirFunctionOf(it, c.hir.at(c.dynTables[table].methods, 0), 0)?;
        let started = addThread(it, false, body, data, block, result);
        it.runtime.recordAddresses.push(record)!;
        it.runtime.recordThreads.push(started)!;
        return Ok(okValue(c, resultType, valueOf(block, 8))?);
    }
    if (b == bfThreadSpawnBoxed()) {
        // ceeTSB_: a thread running a boxed closure: the record and the runtime's thread record, as in C.
        let closure = argument(it, c, n, frame, arguments, 0)?;
        let box = builtinArgumentType(n, arguments, 0);
        let result = elementOf(c, resultOkOf(c, resultType));
        let block = alloc(it, threadRecordSize(c, result)?, allocSystem())?;
        if (block == 0) {
            destroyValue(it, c, n, box, closure)?;
            return Ok(outOfMemory(c, resultType)?);
        }
        let record = alloc(it, 8, allocSystem())?;
        if (record == 0) {
            freeMemory(it, block)?;
            destroyValue(it, c, n, box, closure)?;
            return Ok(outOfMemory(c, resultType)?);
        }
        let data = closure.bits(0, 8)?;
        let tableAddress = closure.bits(8, 8)?;
        it.memory.storeBits(block, record, 8)?;
        it.memory.storeBits(block + 8, data, 8)?;
        it.memory.storeBits(block + 16, tableAddress, 8)?;
        let table = dynTableAt(c, tableAddress)?;
        let body = nirFunctionOf(it, c.hir.at(c.dynTables[table].methods, 0), 0)?;
        let started = addThread(it, false, body, data, block, result);
        it.runtime.recordAddresses.push(record)!;
        it.runtime.recordThreads.push(started)!;
        return Ok(okValue(c, resultType, valueOf(block, 8))?);
    }
    if (b == bfThreadBoth()) {
        // Thread.both(a, b) (§38.6): a on a new thread, b here, then a wait; without a thread record both run here.
        let a = argument(it, c, n, frame, arguments, 0)?;
        let second = argument(it, c, n, frame, arguments, 1)?;
        let record = alloc(it, 8, allocSystem())?;
        if (record == 0) {
            let scratch = scratchAside(it); // `a` as on a thread of its own (ceesafe_scratch_aside)
            callClosureValue(it, c, n, a)?;
            scratchRestore(it, scratch);
            callClosureValue(it, c, n, second)?;
            return Ok(null);
        }
        let started = addThread(it, true, none(), a.bits(0, 8)?, 0, none());
        callClosureValue(it, c, n, second)?;
        if (!it.runtime.threads[started as usize].finished) {
            waitHere(it, c, n, 1, started as u64)?;
        }
        freeMemory(it, record)?;
        return Ok(null);
    }
    // ceeTJ_: waits for the thread, takes its result, and frees its record and closure.
    let referenceType = builtinArgumentType(n, arguments, 0);
    let threadType = if (c.types.is(referenceType, TypeKind.Thread)) referenceType else pointeeOf(c, referenceType);
    let block = argument(it, c, n, frame, arguments, 0)?.bits(0, 8)?;
    return threadJoin(it, c, n, threadType, block);
}

/// Calls a closure with no parameters: its environment's first member is its code (§36.2).
fn callClosureValue(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    closure: borrow Value,
) -> Result<void, Stop> {
    let code = it.memory.loadBits(closure.bits(0, 8)?, 8)?;
    var arguments = Vector<Value>.create();
    arguments.push(copyValue(closure))!;
    callThrough(it, c, n, code, arguments)?;
    return Ok();
}

fn threadJoin(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    t: u32,
    block: u64,
) -> Result<Value?, Stop> {
    let record = pointerAt(it, block)?;
    var joined = none();
    var index: usize = 0;
    for (k in 0..it.runtime.recordAddresses.length) {
        if (it.runtime.recordAddresses[k] == record) {
            joined = it.runtime.recordThreads[k];
            index = k;
        }
    }
    if (joined == none()) {
        return Err(addressMessage("join of a thread that is not running (", record, ")"));
    }
    if (!it.runtime.threads[joined as usize].finished) {
        waitHere(it, c, n, 1, joined as u64)?;
    }
    let result = elementOf(c, t);
    var value: Value? = null;
    if (!c.types.is(result, TypeKind.Void)) {
        value = it.memory.load(block + resultOffset(c, result)?, typeSize(c, result)?)?;
    }
    let data = pointerAt(it, block + 8)?;
    let tableAddress = it.memory.loadBits(block + 16, 8)?;
    let environment = c.dynTables[dynTableAt(c, tableAddress)?].implementation;
    if (c.types.needsDrop(environment)) {
        destroy(it, c, n, environment, data)?;
    }
    it.runtime.recordAddresses[index] = 0;
    freeMemory(it, data)?;
    freeMemory(it, record)?;
    freeMemory(it, block)?;
    return Ok(value);
}

fn mutexCreate(it: borrow mut Interp) -> Result<u64, Stop> {
    let address = alloc(it, 8, allocSystem())?;
    if (address != 0) {
        it.runtime.mutexAddresses.push(address)!;
        it.runtime.mutexOwners.push(none())!;
    }
    return Ok(address);
}

fn mutexLock(it: borrow mut Interp, c: borrow Checker, n: borrow NirProgram, address: u64) -> Result<void, Stop> {
    var index = it.runtime.mutexAddresses.length;
    for (k in 0..it.runtime.mutexAddresses.length) {
        if (it.runtime.mutexAddresses[k] == address) {
            index = k;
        }
    }
    if (index == it.runtime.mutexAddresses.length) {
        return Err(addressMessage("lock of a mutex that does not exist (", address, ")"));
    }
    if (it.runtime.mutexOwners[index] == it.runtime.current) {
        return Err(fault("deadlock: a thread locks a mutex it already holds"));
    }
    if (it.runtime.mutexOwners[index] != none()) {
        waitHere(it, c, n, 2, address)?;
    }
    it.runtime.mutexOwners[index] = it.runtime.current;
    return Ok();
}

/// A task set's record (ADR 0053) on one thread: word 0 is its InterpScope plus one. A wait (for room, or for the
/// children) parks the task until a child returns and wakes it (asyncWoken), or a cancellation.
fn asyncSet(it: borrow mut Interp, name: Slice<u8>, arguments: borrow Vector<Value>) -> Result<Value?, Stop> {
    let record = arguments[0].bits(0, 8)?;
    if (sameText(name, "ceesafe_async_set_init")) {
        let limit = truncate<u32>(arguments[1].bits(0, 4)?);
        it.asyncScopes.push(
            InterpScope {
                task: it.asyncCurrent,
                site: none(),
                active: true,
                live: 0,
                failed: false,
                cancelled: false,
                error: uninitialisedValue(0),
                waiting: false,
                isJoin: false,
                isRace: false,
                started: false,
                first: 2,
                results: Vector<Value>.create(),
                oom: false,
                isSet: true,
                limit: if (limit == 0) 1 else limit,
                roomWaiter: none(),
                doneWaiter: none(),
                errorSlot: arguments[2].bits(0, 8)?,
                allocator: none(),
                childResult: none(),
            },
        )!;
        it.memory.storeBits(record, it.asyncScopes.length as u64, 8)?;
        return Ok(null);
    }
    let scope = truncate<usize>(it.memory.loadBits(record, 8)? - 1);
    if (sameText(name, "ceesafe_async_set_admit")) {
        let wait = arguments[1].bits(0, 1)? != 0;
        if (it.asyncScopes[scope].cancelled || asyncStatus(it) == 1) {
            return Ok(valueOf(2, 4));
        }
        if (it.asyncScopes[scope].live < it.asyncScopes[scope].limit) {
            return Ok(valueOf(0, 4));
        }
        if (wait) {
            it.asyncScopes[scope].roomWaiter = it.asyncCurrent;
            it.asyncOnWake = true; // parks until a child returns
        }
        return Ok(valueOf(1, 4));
    }
    if (sameText(name, "ceesafe_async_set_done")) {
        if (it.asyncScopes[scope].live == 0) {
            it.asyncScopes[scope].active = false;
            return Ok(valueOf(1, 1));
        }
        it.asyncScopes[scope].doneWaiter = it.asyncCurrent;
        it.asyncOnWake = true; // parks until the last child returns
        return Ok(valueOf(0, 1));
    }
    if (sameText(name, "ceesafe_async_set_cancel")) {
        if (!it.asyncScopes[scope].cancelled) {
            it.asyncScopes[scope].cancelled = true;
            it.asyncSetCancelled = true; // the children waiting run again, to see it
        }
        return Ok(null);
    }
    return Ok(valueOf(if (it.asyncScopes[scope].oom) 1 else 0, 1)); // ceesafe_async_set_oom
}

/// `Async.setAllocator(record, alloc)` (ADR 0053): a user allocator's type, which the set's children's frames come
/// from as a scopeIn scope's do (the system heap needs nothing here).
fn asyncSetAllocator(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    arguments: Range,
) -> Result<Value?, Stop> {
    let allocator = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 0))?.bits(0, 4)?);
    let record = operand(it, c, n, frame, n.at(arguments, 1))?.bits(0, 8)?;
    if (isUserAllocator(c, allocator) || builtinItemIndex(c, allocator) == 3) {
        let scope = truncate<usize>(it.memory.loadBits(record, 8)? - 1);
        it.asyncScopes[scope].allocator = allocator; // a user allocator, or FailingAllocator, which gives nothing
    }
    return Ok(null);
}

/// A task set's start (ADR 0053): if admitted, a child queued in the set's scope, as `asyncSpawn` does; else what its
/// environment was to own dropped. The value is the start's code: 0, or the admission's.
fn asyncSetSpawn(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    arguments: Range,
) -> Result<Value?, Stop> {
    let child = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 0))?.bits(0, 4)?);
    let record = operand(it, c, n, frame, n.at(arguments, 1))?.bits(0, 8)?;
    let code = operand(it, c, n, frame, n.at(arguments, 2))?.bits(0, 4)?;
    let closure = operand(it, c, n, frame, n.at(arguments, 3))?;
    let function = nirFunctionOf(it, child, 0)?;
    let environmentDrop = if (ownsEnvironment(c, child)) c.hir.functions[child as usize].closureEnvironment else none();
    var values = Vector<Value>.create();
    var environment: u64 = 0;
    if (c.hir.functions[child as usize].closureEnvironment != none()) {
        let envType = c.types.info(n.functions[function as usize].locals[0].typ).pointee;
        let size = typeSize(c, envType)?;
        environment = it.memory.allocate(allocationLocal(), size, true, "a child's environment".bytes())?;
        if (c.types.is(n.operandTypes[n.at(arguments, 3) as usize], TypeKind.Reference)) {
            let bytes = it.memory.load(closure.bits(0, 8)?, size)?;
            it.memory.store(environment, bytes)?;
        } else {
            it.memory.store(environment, closure)?;
        }
        values.push(valueOf(environment, 8))!;
    }
    if (code != 0) {
        if (environment != 0) {
            if (environmentDrop != none()) {
                destroy(it, c, n, environmentDrop, environment)?; // not started: what it was to own is dropped
            }
            it.memory.end(environment);
        }
        return Ok(valueOf(code, 4));
    }
    let scope = truncate<u32>(it.memory.loadBits(record, 8)? - 1);
    it.asyncScopes[scope as usize].childResult = c.hir.functions[child as usize].returnType;
    // Async.tasksIn: the child's task and frame from the user allocator, as the runtime asks (asyncSpawn's sizes).
    var allocator = it.asyncScopes[scope as usize].allocator;
    var releaseBlock: u64 = 0;
    var releaseSize: u64 = 0;
    if (allocator != none()) {
        releaseSize = 192 + truncate<u64>(frameReport(c, n, function)!.layout.size); // CEE_TASK_HEAD on 64-bit hosts
        if (builtinItemIndex(c, allocator) == 3) {
            // FailingAllocator: the runtime's attempt (failAfter's count), the block given back at once, since the
            // interpreter's frames are its own.
            let block = alloc(it, releaseSize, allocFailing())?;
            if (block != 0) {
                freeMemory(it, block)?;
                releaseBlock = 0;
                releaseSize = 0;
                allocator = none();
            }
        } else {
            releaseBlock = interpAllocate(it, c, n, allocator, releaseSize, 16)?;
        }
        if (allocator != none() && releaseBlock == 0) {
            it.asyncScopes[scope as usize].oom = true; // the set goes on (ADR 0053 §3.2)
            if (environment != 0 && it.memory.isLive(environment)) {
                if (environmentDrop != none()) {
                    destroy(it, c, n, environmentDrop, environment)?;
                }
                it.memory.end(environment);
            }
            return Ok(valueOf(3, 4));
        }
    }
    it.asyncScopes[scope as usize].live += 1;
    it.asyncSpawns.push(
        InterpSpawn {
            function: function,
            arguments: values,
            scope: scope,
            environment: environment,
            environmentDrop: if (isRunOnce(c, child)) none() else environmentDrop, // a run-once body drops its own
            joinIndex: none(),
            release: allocator,
            releaseBlock: releaseBlock,
            releaseSize: releaseSize,
        },
    )!;
    return Ok(valueOf(0, 4));
}

/// AsyncSignal's record (ADR 0039) on one thread: word 0 is raised, word 1 the waiting task plus one (0: none).
fn asyncSignal(it: borrow mut Interp, name: Slice<u8>, record: u64) -> Result<Value?, Stop> {
    let raised = it.memory.loadBits(record, 8)?;
    let waiting = it.memory.loadBits(record + 8, 8)?;
    if (sameText(name, "ceesafe_async_signal_take")) {
        if (raised != 0) {
            it.memory.storeBits(record, 0, 8)?;
            it.memory.storeBits(record + 8, 0, 8)?;
            return Ok(valueOf(1, 1));
        }
        it.memory.storeBits(record + 8, it.asyncCurrent as u64 + 1, 8)?;
        it.asyncOnWake = true; // parks until the raise, or a cancellation
        return Ok(valueOf(0, 1));
    }
    if (sameText(name, "ceesafe_async_signal_forget")) {
        it.memory.storeBits(record + 8, 0, 8)?;
        return Ok(null);
    }
    it.memory.storeBits(record, 1, 8)?;
    if (waiting != 0) {
        it.memory.storeBits(record + 8, 0, 8)?;
        it.asyncWoken.push(truncate<u32>(waiting - 1))!;
    }
    return Ok(null);
}

/// runtime/hosted/ceesafe_rt_async.c on the interpreter's virtual clock (type-system.md §40.8): time passes only when a
/// task parks for a deadline, and output is always writable.
fn asyncService(it: borrow mut Interp, name: Slice<u8>, arguments: borrow Vector<Value>) -> Result<Value?, Stop> {
    if (sameText(name, "ceesafe_async_now")) {
        return Ok(valueOf(it.asyncClock, 8));
    }
    if (sameText(name, "ceesafe_async_wait_until")) {
        let deadline = arguments[0].bits(0, 8)?;
        if (deadline < it.asyncDeadline) {
            it.asyncDeadline = deadline;
        }
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_wait_writable")) {
        let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        if (fd == 1 || fd == 2) {
            it.asyncWritable = true; // the interpreter's own output is always writable
        } else {
            it.asyncFd = fd;
            it.asyncFdEvents = 2;
        }
        return Ok(null);
    }
    if (n0IsAsyncSocketCall(name)) {
        return asyncSocketService(it, name, arguments);
    }
    if (sameText(name, "ceesafe_async_status")) {
        return Ok(valueOf(asyncStatus(it) as u64, 4));
    }
    if (sameText(name, "ceesafe_async_signal_take") || sameText(name, "ceesafe_async_signal_forget") ||
        sameText(name, "ceesafe_async_signal_raise")) {
        return asyncSignal(it, name, arguments[0].bits(0, 8)?);
    }
    if (name.length > 18 && sameText(name[0..18], "ceesafe_async_set_")) {
        return asyncSet(it, name, arguments);
    }
    if (sameText(name, "ceesafe_async_shield_enter")) {
        let ms = arguments[0].bits(0, 8)?;
        let k = it.asyncCurrent as usize;
        if (it.asyncTasks[k].shields == 0) {
            it.asyncTasks[k].shieldDeadline =
                if (ms > 0xFFFFFFFFFFFFFFFF - it.asyncClock) 0xFFFFFFFFFFFFFFFF else it.asyncClock + ms;
        }
        it.asyncTasks[k].shields += 1;
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_shield_leave")) {
        let k = it.asyncCurrent as usize;
        it.asyncTasks[k].shields -= 1;
        if (it.asyncTasks[k].shields == 0) {
            it.asyncTasks[k].shieldDeadline = 0xFFFFFFFFFFFFFFFF;
        }
        return Ok(null);
    }
    // ceesafe_async_write: at most PIPE_BUF (512 here, POSIX's minimum) bytes, in order with Console's output.
    let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
    let start = arguments[1].bits(0, 8)?;
    let length = arguments[2].bits(0, 8)?;
    let step = if (length < 512) length else 512;
    var bytes = Vector<u8>.create();
    for (k in 0..step) {
        bytes.push(truncate<u8>(it.memory.loadBits(start + k, 1)?))!;
    }
    if (fd == 2) {
        writeError(it, bytes.view());
    } else {
        writeOutput(it, bytes.view());
    }
    return Ok(valueOf(step, 8));
}

/// `Async.park()`: back to runTasks, which wakes the task as what it registered comes (§40.8).
fn asyncPark(it: borrow mut Interp) -> Result<Value?, Stop> => Err(parkStop());

// ---- Tasks (type-system.md §40.8): one thread, a run queue, the virtual clock ----

fn parkStop() -> Stop =>
    Stop { kind: 3, message: Vector<u8>.create(), location: Vector<u8>.create(), hasLocation: false, code: 0 };

/// A child `spawn` made, for runTasks to start: its NIR function, arguments and scope (InterpScope).
struct InterpSpawn {
    function: u32;
    arguments: Vector<Value>;
    scope: u32;
    environment: u64;     // the child's copy of its environment, or 0
    environmentDrop: u32; // an `async move` child's environment type, destroyed when it returns (ADR 0033), or none
    joinIndex: u32;       // a join's child (race, all): 0 or 1; none for a spawned one
    release: u32;         // Async.scopeIn's user allocator, or none
    releaseBlock: u64;
    releaseSize: u64;
}

/// A scope of a task: (task, site) while it has children or has not ended.
struct InterpScope {
    task: u32;
    site: u32;
    active: bool;
    live: u32;
    failed: bool;
    cancelled: bool; // a child failed: the others are cancelled (§40.7)
    error: Value;
    waiting: bool;
    isJoin: bool; // race or all (§40.4)
    isRace: bool;
    started: bool;
    first: u32;
    results: Vector<Value>;
    oom: bool;        // a child could not be allocated (Async.scopeIn)
    isSet: bool;      // a task set's (ADR 0053): a child's error cancels no sibling
    limit: u32;       // a set's most live children
    roomWaiter: u32;  // the task waiting to start a child (a global task id), or none
    doneWaiter: u32;  // the task waiting for the set's children, or none
    errorSlot: u64;   // where a set's first child error is stored
    allocator: u32;   // a set's user allocator type (Async.tasksIn), or none
    childResult: u32; // the children's result type, set when one spawns: a later child's error is dropped (bug B13)
}

/// What cancellation needs of a task, beside runTasks' own record (InterpTask).
struct InterpTaskInfo {
    scope: u32; // a child's InterpScope, or none for the root
    shields: u32;
    shieldDeadline: u64;
}

/// ceesafe_async_status: 0 runs on, 1 cancelled (its scope, or the scope's task, transitively), 2 shield's time up.
fn asyncStatus(it: borrow Interp) -> u32 {
    if (it.asyncCurrent == none() || (it.asyncCurrent as usize) >= it.asyncTasks.length) {
        return 0;
    }
    let current = borrow it.asyncTasks[it.asyncCurrent as usize];
    if (current.shields > 0) {
        return if (it.asyncClock >= current.shieldDeadline) 2 else 0;
    }
    var scope = current.scope;
    while (scope != none()) {
        if (it.asyncScopes[scope as usize].cancelled) {
            return 1;
        }
        scope = it.asyncTasks[it.asyncScopes[scope as usize].task as usize].scope;
    }
    return 0;
}

struct InterpTask {
    scope: u32;           // a child's InterpScope, or none for the root
    environment: u64;     // a child's copy of its environment, ended when it returns, or 0
    environmentDrop: u32; // its type, if the child owns what it holds (ADR 0033 §3.3), or none
    parked: bool;
    deadline: u64;
    onScope: bool;
    joinIndex: u32;
    fd: i32; // a socket it waits on, or -1
    fdEvents: u32;
    release: u32;
    releaseBlock: u64;
    releaseSize: u64;
}

/// The running task's active scope at `site`, made on first use.
fn interpScope(it: borrow mut Interp, site: u32) -> u32 {
    for (k in 0..it.asyncScopes.length) {
        let s = borrow it.asyncScopes[k];
        if (s.active && s.task == it.asyncCurrent && s.site == site) {
            return truncate<u32>(k);
        }
    }
    it.asyncScopes.push(
        InterpScope {
            task: it.asyncCurrent,
            site: site,
            active: true,
            live: 0,
            failed: false,
            cancelled: false,
            error: uninitialisedValue(0),
            waiting: false,
            isJoin: false,
            isRace: false,
            started: false,
            first: 2,
            results: Vector<Value>.create(),
            oom: false,
            isSet: false,
            limit: 0,
            roomWaiter: none(),
            doneWaiter: none(),
            errorSlot: 0,
            allocator: none(),
            childResult: none(),
        },
    )!;
    return truncate<u32>(it.asyncScopes.length - 1);
}

/// `s.spawn(child)`: queued for runTasks, which starts it after this task parks or returns.
fn asyncSpawn(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    arguments: Range,
) -> Result<Value?, Stop> {
    let site = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 0))?.bits(0, 4)?);
    let child = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 1))?.bits(0, 4)?);
    let closure = operand(it, c, n, frame, n.at(arguments, 2))?;
    let function = nirFunctionOf(it, child, 0)?;
    var values = Vector<Value>.create();
    var environment: u64 = 0;
    let environmentDrop = if (ownsEnvironment(c, child)) c.hir.functions[child as usize].closureEnvironment else none();
    if (c.hir.functions[child as usize].closureEnvironment != none()) {
        // The child's own copy of its environment, as in C (c-backend.md §3a): the closure value may be made again by
        // a loop's next iteration while the child runs. An `async move` child's value is the environment itself.
        let envType = c.types.info(n.functions[function as usize].locals[0].typ).pointee;
        let size = typeSize(c, envType)?;
        environment = it.memory.allocate(allocationLocal(), size, true, "a child's environment".bytes())?;
        if (c.types.is(n.operandTypes[n.at(arguments, 2) as usize], TypeKind.Reference)) {
            let bytes = it.memory.load(closure.bits(0, 8)?, size)?;
            it.memory.store(environment, bytes)?;
        } else {
            it.memory.store(environment, closure)?;
        }
        values.push(valueOf(environment, 8))!;
    }
    let scope = interpScope(it, site);
    it.asyncScopes[scope as usize].childResult = c.hir.functions[child as usize].returnType;
    // Async.scopeIn: the child's task and frame from the user allocator, as the runtime asks (its 128-byte task
    // header, then the frame, aligned to 16).
    let allocator = if (arguments.count > 3) truncate<u32>(
        operand(it, c, n, frame, n.at(arguments, 3))?.bits(0, 4)?,
    ) else none();
    var release = none();
    var releaseBlock: u64 = 0;
    var releaseSize: u64 = 0;
    if (allocator != none() && isUserAllocator(c, allocator)) {
        if (it.asyncScopes[scope as usize].oom) {
            if (environment != 0 && it.memory.isLive(environment)) {
                if (environmentDrop != none()) {
                    destroy(it, c, n, environmentDrop, environment)?; // not started: what it was to own is dropped
                }
                it.memory.end(environment);
            }
            return Ok(null); // the scope already failed to start a child: it starts no more
        }
        releaseSize = 192 + truncate<u64>(frameReport(c, n, function)!.layout.size); // CEE_TASK_HEAD on 64-bit hosts
        releaseBlock = interpAllocate(it, c, n, allocator, releaseSize, 16)?;
        if (releaseBlock == 0) {
            it.asyncScopes[scope as usize].oom = true;
            it.asyncScopes[scope as usize].cancelled = true;
            if (environment != 0 && it.memory.isLive(environment)) {
                if (environmentDrop != none()) {
                    destroy(it, c, n, environmentDrop, environment)?;
                }
                it.memory.end(environment);
            }
            return Ok(null);
        }
        release = allocator;
    }
    it.asyncScopes[scope as usize].live += 1;
    it.asyncSpawns.push(
        InterpSpawn {
            function: function,
            arguments: values,
            scope: scope,
            environment: environment,
            environmentDrop: if (isRunOnce(c, child)) none() else environmentDrop, // a run-once body drops its own
            joinIndex: none(),
            release: release,
            releaseBlock: releaseBlock,
            releaseSize: releaseSize,
        },
    )!;
    return Ok(null);
}

/// The end of a scope: parks until the children have returned, then its result (§40.5).
fn asyncScopeWait(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    r: u32,
    arguments: Range,
) -> Result<Value?, Stop> {
    let site = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 0))?.bits(0, 4)?);
    let scope = interpScope(it, site);
    if (it.asyncScopes[scope as usize].live > 0) {
        it.asyncScopes[scope as usize].waiting = true;
        it.asyncRetry = true;
        return Err(parkStop());
    }
    let oom = operand(it, c, n, frame, n.at(arguments, 1))?;
    let oomType = n.operandTypes[n.at(arguments, 1) as usize];
    it.asyncScopes[scope as usize].active = false;
    if (it.asyncScopes[scope as usize].failed) {
        destroyValue(it, c, n, oomType, borrow oom)?; // the scope's own error, unused: dropped, as in C (bug B13)
        return Ok(copyValue(it.asyncScopes[scope as usize].error));
    }
    let t = n.rvalueTypes[r as usize];
    if (it.asyncScopes[scope as usize].oom) {
        // A child could not be allocated (Async.scopeIn): Err(oom), as in C (§40.5).
        let errVariant = c.types.enums[c.types.info(t).enumDef as usize].variants[1];
        var payload = Vector<Value>.create();
        payload.push(oom)!;
        return Ok(makeEnumValue(c, t, errVariant, payload)?);
    }
    destroyValue(it, c, n, oomType, borrow oom)?; // Ok: the scope's own error is unused, and dropped (bug B13)
    let ok = c.types.enums[c.types.info(t).enumDef as usize].variants[0];
    let none0 = Vector<Value>.create();
    return Ok(makeEnumValue(c, t, ok, none0)?);
}

/// Ends every frame of every task: after a fault, panic or exit.
fn endTasks(it: borrow mut Interp, stacks: borrow mut Vector<Vector<Activation>>) {
    for (k in 0..stacks.length) {
        var j = stacks[k].length;
        while (j > 0) {
            j -= 1;
            endFrame(it, stacks[k][j].frame);
        }
        stacks[k].clear();
    }
}

/// `Async.run(f(…))`: runs the root task and the children its scopes spawn, one at a time in queue order, on the
/// virtual clock: time passes only when no task can run (type-system.md §40.8).
fn runTasks(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    f: u32,
    arguments: Vector<Value>,
) -> Result<Value?, Stop> {
    let savedCurrent = it.asyncCurrent;
    let savedTasks = it.asyncTasks.length;
    let first = truncate<u32>(savedTasks); // this run's tasks are it.asyncTasks[first..]
    var stacks = Vector<Vector<Activation>>.create();
    var tasks = Vector<InterpTask>.create();
    var ready = Vector<u32>.create();
    var head: usize = 0;
    let root = newFrame(it, c, n, f, arguments)?;
    var rootStack = Vector<Activation>.create();
    rootStack.push(
        Activation {
            frame: root,
            block: 0,
            next: 0,
            target: none(),
            savedHas: it.hasPosition,
            savedFile: it.positionFile,
            savedStart: it.positionStart,
            wrapOk: none(),
            release: none(),
            releaseBlock: 0,
            releaseSize: 0,
        },
    )!;
    stacks.push(rootStack)!;
    tasks.push(
        InterpTask {
            scope: none(),
            environment: 0,
            environmentDrop: none(),
            parked: false,
            deadline: 0xFFFFFFFFFFFFFFFF,
            onScope: false,
            joinIndex: none(),
            fd: -1,
            fdEvents: 0,
            release: none(),
            releaseBlock: 0,
            releaseSize: 0,
        },
    )!;
    ready.push(0)!;
    it.asyncTasks.push(InterpTaskInfo { scope: none(), shields: 0, shieldDeadline: 0xFFFFFFFFFFFFFFFF })!;
    loop {
        if (it.asyncSetCancelled) {
            // A task set was cancelled (ADR 0053): every waiting task runs again to see it, as for a scope's.
            it.asyncSetCancelled = false;
            for (j in 0..tasks.length) {
                if (tasks[j].parked && !tasks[j].onScope) {
                    tasks[j].parked = false;
                    tasks[j].deadline = 0xFFFFFFFFFFFFFFFF;
                    ready.push(truncate<u32>(j))!;
                }
            }
        }
        // Tasks a channel woke (§40.8); another run's stay for it.
        var others = Vector<u32>.create();
        loop {
            match (it.asyncWoken.pop()) {
                Some(id) => {
                    if (id >= first && ((id - first) as usize) < tasks.length) {
                        let j = (id - first) as usize;
                        if (tasks[j].parked && !tasks[j].onScope) {
                            tasks[j].parked = false;
                            tasks[j].deadline = 0xFFFFFFFFFFFFFFFF;
                            ready.push(truncate<u32>(j))!;
                        }
                    } else {
                        others.push(id)!;
                    }
                }
                null => { break; }
            }
        }
        for (id in others.view()) {
            it.asyncWoken.push(id)!;
        }
        if (head == ready.length) {
            // Tasks waiting on sockets: a real poll, which waits only if no timer can come instead (§40.8).
            var fds = Vector<i32>.create();
            var events = Vector<u32>.create();
            var owners = Vector<u32>.create();
            var anyDeadline = false;
            for (j in 0..tasks.length) {
                if (tasks[j].parked && !tasks[j].onScope && tasks[j].fd >= 0) {
                    fds.push(tasks[j].fd)!;
                    events.push(tasks[j].fdEvents)!;
                    owners.push(truncate<u32>(j))!;
                }
                if (tasks[j].parked && tasks[j].deadline != 0xFFFFFFFFFFFFFFFF) {
                    anyDeadline = true;
                }
            }
            if (fds.length > 0) {
                var readiness = Vector<u32>.create();
                for (fd in fds.view()) {
                    readiness.push(0)!;
                }
                let woke = AsyncSockets.poll(
                    fds.view(),
                    events.view(),
                    readiness.viewMut(),
                    if (anyDeadline) 0 else -1,
                );
                if (woke > 0) {
                    for (j in 0..owners.length) {
                        if (readiness[j] != 0) {
                            let t = owners[j] as usize;
                            tasks[t].parked = false;
                            tasks[t].fd = -1;
                            ready.push(owners[j])!;
                        }
                    }
                    continue;
                }
                if (!anyDeadline) {
                    continue; // interrupted: wait again
                }
            }
            // No task can run: the earliest deadline comes (§40.8).
            var earliest: u64 = 0xFFFFFFFFFFFFFFFF;
            for (j in 0..tasks.length) {
                let t = borrow tasks[j];
                if (t.parked && t.deadline < earliest) {
                    earliest = t.deadline;
                }
                let info = borrow it.asyncTasks[first as usize + j];
                if (t.parked && !t.onScope && info.shields > 0 && info.shieldDeadline < earliest) {
                    earliest = info.shieldDeadline;
                }
            }
            if (earliest == 0xFFFFFFFFFFFFFFFF) {
                // Another thread may fill the channel they wait on: one that has not started runs now, to its end
                // (the interpreter runs one thread at a time, ADR 0016 §3.8).
                var startable = none();
                for (t in 0..it.runtime.threads.length) {
                    if (startable == none() && !it.runtime.threads[t].started && !it.runtime.threads[t].finished) {
                        startable = truncate<u32>(t);
                    }
                }
                if (startable != none()) {
                    let me = it.asyncCurrent;
                    runThread(it, c, n, startable)?;
                    it.asyncCurrent = me;
                    continue;
                }
                // Nothing can wake a task: one thread, and its tasks all wait (on a channel no one fills, say).
                endTasks(it, mut stacks);
                it.asyncCurrent = savedCurrent;
                it.asyncTasks.truncate(savedTasks);
                return Err(fault("every task is parked with nothing to wake it"));
            }
            if (earliest > it.asyncClock) {
                it.asyncClock = earliest;
            }
            for (k in 0..tasks.length) {
                let shieldDue = it.asyncTasks[first as usize + k].shields > 0 &&
                    it.asyncTasks[first as usize + k].shieldDeadline <= it.asyncClock;
                if (tasks[k].parked && !tasks[k].onScope && (tasks[k].deadline <= it.asyncClock || shieldDue)) {
                    tasks[k].parked = false;
                    tasks[k].deadline = 0xFFFFFFFFFFFFFFFF;
                    ready.push(truncate<u32>(k))!;
                }
            }
            continue;
        }
        let k = ready[head];
        head += 1;
        it.asyncCurrent = first + k;
        it.asyncDeadline = 0xFFFFFFFFFFFFFFFF;
        it.asyncWritable = false;
        it.asyncRetry = false;
        it.asyncOnWake = false;
        it.asyncFd = -1;
        let outcome = runActivations(it, c, n, mut stacks[k as usize]);
        // The children this task spawned start after it, in order.
        var spawned = Vector<InterpSpawn>.create();
        loop {
            match (it.asyncSpawns.pop()) {
                Some(x) => { spawned.push(x)!; }
                null => { break; }
            }
        }
        loop {
            let spawn = match (spawned.pop()) {
                Some(x) => x,
                null => { break; },
            };
            let frame = newFrame(it, c, n, spawn.function, spawn.arguments)?;
            var stack = Vector<Activation>.create();
            stack.push(
                Activation {
                    frame: frame,
                    block: 0,
                    next: 0,
                    target: none(),
                    savedHas: it.hasPosition,
                    savedFile: it.positionFile,
                    savedStart: it.positionStart,
                    wrapOk: none(),
                    release: none(),
                    releaseBlock: 0,
                    releaseSize: 0,
                },
            )!;
            stacks.push(stack)!;
            it.asyncTasks.push(
                InterpTaskInfo { scope: spawn.scope, shields: 0, shieldDeadline: 0xFFFFFFFFFFFFFFFF },
            )!;
            tasks.push(
                InterpTask {
                    scope: spawn.scope,
                    environment: spawn.environment,
                    environmentDrop: spawn.environmentDrop,
                    parked: false,
                    deadline: 0xFFFFFFFFFFFFFFFF,
                    onScope: false,
                    joinIndex: spawn.joinIndex,
                    fd: -1,
                    fdEvents: 0,
                    release: spawn.release,
                    releaseBlock: spawn.releaseBlock,
                    releaseSize: spawn.releaseSize,
                },
            )!;
            ready.push(truncate<u32>(tasks.length - 1))!;
        }
        match (outcome) {
            Ok(value) => {
                if (k == 0) {
                    it.asyncCurrent = savedCurrent;
                    it.asyncTasks.truncate(savedTasks);
                    return Ok(value); // the root's scopes have ended, so every child has returned
                }
                let scope = tasks[k as usize].scope;
                let environment = tasks[k as usize].environment;
                let environmentDrop = tasks[k as usize].environmentDrop;
                if (tasks[k as usize].release != none()) {
                    let allocator = tasks[k as usize].release;
                    let block = tasks[k as usize].releaseBlock;
                    let size = tasks[k as usize].releaseSize;
                    interpDeallocate(it, c, n, allocator, block, size, 16)?;
                }
                if (environment != 0 && it.memory.isLive(environment)) {
                    if (environmentDrop != none()) {
                        destroy(it, c, n, environmentDrop, environment)?; // an `async move` child's (ADR 0033)
                    }
                    it.memory.end(environment);
                }
                let joinIndex = tasks[k as usize].joinIndex;
                if (joinIndex != none()) {
                    // A join's child (§40.4): its result kept; race cancels the other when the first returns, all
                    // when one returns an Err.
                    let result = match (value) {
                        Some(v) => v,
                        null => uninitialisedValue(0),
                    };
                    let isErr = result.data.length > 0 && result.bits(0, 1)? != 0;
                    it.asyncScopes[scope as usize].results[joinIndex as usize] = result;
                    if (it.asyncScopes[scope as usize].first == 2) {
                        it.asyncScopes[scope as usize].first = joinIndex;
                    }
                    if ((it.asyncScopes[scope as usize].isRace || isErr) && !it.asyncScopes[scope as usize].cancelled) {
                        it.asyncScopes[scope as usize].cancelled = true;
                        for (j in 0..tasks.length) {
                            if (tasks[j].parked && !tasks[j].onScope) {
                                tasks[j].parked = false;
                                tasks[j].deadline = 0xFFFFFFFFFFFFFFFF;
                                ready.push(truncate<u32>(j))!;
                            }
                        }
                    }
                    it.asyncScopes[scope as usize].live -= 1;
                    if (it.asyncScopes[scope as usize].live == 0 && it.asyncScopes[scope as usize].waiting) {
                        it.asyncScopes[scope as usize].waiting = false;
                        let waiter = it.asyncScopes[scope as usize].task - first;
                        tasks[waiter as usize].parked = false;
                        tasks[waiter as usize].onScope = false;
                        ready.push(waiter)!;
                    }
                    continue;
                }
                match (value) {
                    Some(result) => {
                        if (result.bits(0, 1)? != 0 && it.asyncScopes[scope as usize].failed) {
                            // A later child's error, not the scope's: dropped, as the C adapter does (bug B13).
                            let resultType = it.asyncScopes[scope as usize].childResult;
                            if (resultType != none()) {
                                destroyValue(it, c, n, resultType, borrow result)?;
                            }
                        }
                        if (result.bits(0, 1)? != 0 && !it.asyncScopes[scope as usize].failed) {
                            it.asyncScopes[scope as usize].failed = true;
                            if (it.asyncScopes[scope as usize].isSet) {
                                // A task set's first child error, to its record's slot (ADR 0053).
                                it.memory.store(it.asyncScopes[scope as usize].errorSlot, result)?;
                            } else {
                                it.asyncScopes[scope as usize].error = result; // the first child's error
                            }
                        }
                    }
                    null => {}
                }
                it.asyncScopes[scope as usize].live -= 1;
                if (it.asyncScopes[scope as usize].isSet) {
                    // A set's child: no sibling is cancelled; the task waiting for room or for the set runs again.
                    let s = borrow mut it.asyncScopes[scope as usize];
                    if (s.roomWaiter != none() && s.live < s.limit) {
                        it.asyncWoken.push(s.roomWaiter)!;
                        s.roomWaiter = none();
                    }
                    if (s.doneWaiter != none() && s.live == 0) {
                        it.asyncWoken.push(s.doneWaiter)!;
                        s.doneWaiter = none();
                    }
                    continue;
                }
                if (it.asyncScopes[scope as usize].failed && !it.asyncScopes[scope as usize].cancelled) {
                    // The first error cancels the other children: those waiting run again to see it (§40.7).
                    it.asyncScopes[scope as usize].cancelled = true;
                    for (j in 0..tasks.length) {
                        if (tasks[j].parked && !tasks[j].onScope) {
                            tasks[j].parked = false;
                            tasks[j].deadline = 0xFFFFFFFFFFFFFFFF;
                            ready.push(truncate<u32>(j))!;
                        }
                    }
                }
                if (it.asyncScopes[scope as usize].live == 0 && it.asyncScopes[scope as usize].waiting) {
                    it.asyncScopes[scope as usize].waiting = false;
                    let waiter = it.asyncScopes[scope as usize].task - first;
                    tasks[waiter as usize].parked = false;
                    tasks[waiter as usize].onScope = false;
                    ready.push(waiter)!;
                }
            }
            Err(stop) => {
                if (stop.kind != 3) {
                    var located = stop;
                    if (located.kind == 0 && !located.hasLocation) {
                        located.location = here(it);
                        located.hasLocation = true;
                    }
                    endTasks(it, mut stacks);
                    it.asyncCurrent = savedCurrent;
                    it.asyncTasks.truncate(savedTasks);
                    return Err(located);
                }
                if (it.asyncRetry) {
                    let top = stacks[k as usize].length - 1;
                    stacks[k as usize][top].next -= 1; // the scope's end runs again on resume
                    tasks[k as usize].onScope = true;
                    tasks[k as usize].parked = true;
                } else if (it.asyncDeadline != 0xFFFFFFFFFFFFFFFF) {
                    tasks[k as usize].parked = true;
                    tasks[k as usize].deadline = it.asyncDeadline;
                } else if (it.asyncFd >= 0) {
                    tasks[k as usize].parked = true; // until its socket is ready
                    tasks[k as usize].fd = it.asyncFd;
                    tasks[k as usize].fdEvents = it.asyncFdEvents;
                } else if (it.asyncOnWake) {
                    tasks[k as usize].parked = true; // until a channel's change (§40.8)
                } else if (it.asyncWritable) {
                    ready.push(k)!; // output is always writable here
                } else {
                    endTasks(it, mut stacks);
                    it.asyncCurrent = savedCurrent;
                    it.asyncTasks.truncate(savedTasks);
                    return Err(fault("a task parked with nothing to wake it"));
                }
            }
        }
    }
}

/// `Async.race` or `Async.all` (§40.4): starts both children once, parks until both have returned (running again
/// then), and is the index of the one that returned first.
fn asyncJoin(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    arguments: Range,
) -> Result<Value?, Stop> {
    let site = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 0))?.bits(0, 4)?);
    let isRace = operand(it, c, n, frame, n.at(arguments, 1))?.bits(0, 4)? != 0; // a timeout (2) is a race (ADR 0046)
    let scope = interpScope(it, site);
    if (!it.asyncScopes[scope as usize].started) {
        it.asyncScopes[scope as usize].started = true;
        it.asyncScopes[scope as usize].isJoin = true;
        it.asyncScopes[scope as usize].isRace = isRace;
        it.asyncScopes[scope as usize].results.push(uninitialisedValue(0))!;
        it.asyncScopes[scope as usize].results.push(uninitialisedValue(0))!;
        for (k in 0..2u32) {
            let child = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 2 + 2 * k))?.bits(0, 4)?);
            let closure = operand(it, c, n, frame, n.at(arguments, 3 + 2 * k))?;
            let function = nirFunctionOf(it, child, 0)?;
            var values = Vector<Value>.create();
            var environment: u64 = 0;
            if (c.hir.functions[child as usize].closureEnvironment != none()) {
                let envType = c.types.info(n.functions[function as usize].locals[0].typ).pointee;
                let size = typeSize(c, envType)?;
                environment = it.memory.allocate(allocationLocal(), size, true, "a child's environment".bytes())?;
                if (c.types.is(n.operandTypes[n.at(arguments, 3 + 2 * k) as usize], TypeKind.Reference)) {
                    let bytes = it.memory.load(closure.bits(0, 8)?, size)?;
                    it.memory.store(environment, bytes)?;
                } else {
                    it.memory.store(environment, closure)?; // an `async move` child's environment (ADR 0074 §2.3)
                }
                values.push(valueOf(environment, 8))!;
            } else if (c.hir.functions[child as usize].parameters.length == 1) {
                values.push(closure)!; // a timeout's deadline child, given the deadline (ADR 0046)
            }
            it.asyncScopes[scope as usize].live += 1;
            it.asyncSpawns.push(
                InterpSpawn {
                    function: function,
                    arguments: values,
                    scope: scope,
                    environment: environment,
                    environmentDrop: none(),
                    joinIndex: k,
                    release: none(),
                    releaseBlock: 0,
                    releaseSize: 0,
                },
            )!;
        }
    }
    if (it.asyncScopes[scope as usize].live > 0) {
        it.asyncScopes[scope as usize].waiting = true;
        it.asyncRetry = true;
        return Err(parkStop());
    }
    return Ok(valueOf(it.asyncScopes[scope as usize].first as u64, 4));
}

/// A join's child result, moved out; the join ends with the second.
fn asyncJoinResult(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    arguments: Range,
) -> Result<Value?, Stop> {
    let site = truncate<u32>(operand(it, c, n, frame, n.at(arguments, 0))?.bits(0, 4)?);
    let k = operand(it, c, n, frame, n.at(arguments, 1))?.bits(0, 4)?;
    let scope = interpScope(it, site);
    let value = copyValue(it.asyncScopes[scope as usize].results[k as usize]);
    if (k == 1) {
        it.asyncScopes[scope as usize].active = false;
    }
    return Ok(value);
}

/// ceesafe_chan_retain, _free, _end_send, _end_recv and _close: a channel handle and nothing else.
fn n0IsChannelHandleCall(name: Slice<u8>) -> bool =>
    sameText(name, "ceesafe_chan_retain") || sameText(name, "ceesafe_chan_free") ||
        sameText(name, "ceesafe_chan_end_send") || sameText(name, "ceesafe_chan_end_recv") ||
        sameText(name, "ceesafe_chan_close");

/// After a change: the epoch moves and every task parked on the channel runs again (§40.8).
fn channelChanged(it: borrow mut Interp, k: usize) {
    it.runtime.channels[k].epoch += 1;
    loop {
        match (it.runtime.channels[k].waiters.pop()) {
            Some(task) => { it.asyncWoken.push(task)!; }
            null => { break; }
        }
    }
}

/// runtime/hosted/ceesafe_rt_async.c's channels, one thread at a time: no lock; a blocking wait lets the other
/// threads run (waitHere), and a task's wait parks it until the next change (ADR 0032 §3.7).
fn channelService(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    name: Slice<u8>,
    arguments: borrow Vector<Value>,
) -> Result<Value?, Stop> {
    if (sameText(name, "ceesafe_chan_create")) {
        let capacity = arguments[0].bits(0, 8)?;
        let size = arguments[1].bits(0, 8)?;
        let align = arguments[2].bits(0, 8)?;
        let stride = if (size == 0) 1 else (size + align - 1) / align * align;
        let data = alloc(it, capacity * stride, 0)?;
        if (data == 0) {
            return Ok(valueOf(0, 8));
        }
        it.runtime.channels.push(
            InterpChannel {
                data: data,
                capacity: capacity,
                stride: stride,
                head: 0,
                count: 0,
                closed: false,
                refs: 1,
                epoch: 0,
                waiters: Vector<u32>.create(),
            },
        )!;
        return Ok(valueOf(it.runtime.channels.length as u64, 8));
    }
    let k = (arguments[0].bits(0, 8)? - 1) as usize;
    if (sameText(name, "ceesafe_chan_retain")) {
        it.runtime.channels[k].refs += 1;
        return Ok(null);
    }
    if (sameText(name, "ceesafe_chan_release")) {
        it.runtime.channels[k].refs -= 1;
        return Ok(valueOf(if (it.runtime.channels[k].refs == 0) 1 else 0, 1));
    }
    if (sameText(name, "ceesafe_chan_free")) {
        let data = it.runtime.channels[k].data;
        freeMemory(it, data)?;
        return Ok(null);
    }
    if (sameText(name, "ceesafe_chan_begin_send") || sameText(name, "ceesafe_chan_begin_recv")) {
        let sending = sameText(name, "ceesafe_chan_begin_send");
        let channel = borrow it.runtime.channels[k];
        var status: u64 = 0;
        var slot: u64 = 0;
        if (sending) {
            if (channel.closed) {
                status = 2;
            } else if (channel.count == channel.capacity) {
                status = 1;
            } else {
                slot = channel.data + ((channel.head + channel.count) % channel.capacity) * channel.stride;
            }
        } else if (channel.count > 0) {
            slot = channel.data + channel.head * channel.stride;
        } else {
            status = if (channel.closed) 2 else 1;
        }
        let epoch = channel.epoch;
        it.memory.storeBits(arguments[1].bits(0, 8)?, status, 4)?;
        it.memory.storeBits(arguments[2].bits(0, 8)?, epoch, 8)?;
        return Ok(valueOf(slot, 8));
    }
    if (sameText(name, "ceesafe_chan_end_send")) {
        it.runtime.channels[k].count += 1;
        channelChanged(it, k);
        return Ok(null);
    }
    if (sameText(name, "ceesafe_chan_end_recv")) {
        let capacity = it.runtime.channels[k].capacity;
        it.runtime.channels[k].head = (it.runtime.channels[k].head + 1) % capacity;
        it.runtime.channels[k].count -= 1;
        channelChanged(it, k);
        return Ok(null);
    }
    if (sameText(name, "ceesafe_chan_close")) {
        it.runtime.channels[k].closed = true;
        channelChanged(it, k);
        return Ok(null);
    }
    if (sameText(name, "ceesafe_chan_closed")) {
        return Ok(valueOf(if (it.runtime.channels[k].closed) 1 else 0, 1));
    }
    if (sameText(name, "ceesafe_chan_wait")) {
        let epoch = arguments[1].bits(0, 8)?;
        if (it.runtime.channels[k].epoch == epoch) {
            waitHere(it, c, n, 3, ((k as u64) << 40) | (epoch & 0xFFFFFFFFFF))?;
        }
        return Ok(null);
    }
    if (sameText(name, "ceesafe_chan_park")) {
        let epoch = arguments[2].bits(0, 8)?;
        if (it.runtime.channels[k].epoch != epoch) {
            return Ok(valueOf(0, 1));
        }
        it.runtime.channels[k].waiters.push(it.asyncCurrent)!;
        it.asyncOnWake = true;
        return Ok(valueOf(1, 1));
    }
    // ceesafe_chan_unpark: the task leaves the queue if a change has not already taken it out.
    let me = it.asyncCurrent;
    it.runtime.channels[k].waiters.retain((task) => task != me);
    return Ok(null);
}

fn n0IsAsyncSocketCall(name: Slice<u8>) -> bool =>
    sameText(name, "ceesafe_async_wait_readable") || sameText(name, "ceesafe_async_tcp_listen") ||
        sameText(name, "ceesafe_async_tcp_port") || sameText(name, "ceesafe_async_tcp_accept") ||
        sameText(name, "ceesafe_async_tcp_connect") || sameText(name, "ceesafe_async_tcp_connected") ||
        sameText(name, "ceesafe_async_read") || sameText(name, "ceesafe_async_send") ||
        sameText(name, "ceesafe_async_shutdown_write") || sameText(name, "ceesafe_async_close") ||
        sameText(name, "ceesafe_async_poll") || sameText(name, "ceesafe_async_op_read") ||
        sameText(name, "ceesafe_async_op_send") || sameText(name, "ceesafe_async_op_accept") ||
        sameText(name, "ceesafe_async_op_connect") || sameText(name, "ceesafe_async_op_cancel") ||
        sameText(name, "ceesafe_async_op_connect_at") || sameText(name, "ceesafe_async_tcp_listen_at") ||
        sameText(name, "ceesafe_async_tcp_connect_at") || sameText(name, "ceesafe_async_socket_name") ||
        sameText(name, "ceesafe_async_socket_option") || sameText(name, "ceesafe_async_shutdown_read") ||
        sameText(name, "ceesafe_interface_index") || sameText(name, "ceesafe_async_msg_part") ||
        sameText(name, "ceesafe_async_op_sendv") || sameText(name, "ceesafe_dns_start") ||
        sameText(name, "ceesafe_dns_poll") || sameText(name, "ceesafe_dns_count") ||
        sameText(name, "ceesafe_dns_address") || sameText(name, "ceesafe_dns_end") ||
        sameText(name, "ceesafe_async_udp_bind") || sameText(name, "ceesafe_async_msg_send_to") ||
        sameText(name, "ceesafe_async_op_sendmsg") || sameText(name, "ceesafe_async_op_recvmsg") ||
        sameText(name, "ceesafe_async_msg_address") || sameText(name, "ceesafe_async_msg_flags") ||
        sameText(name, "ceesafe_async_udp_send") || sameText(name, "ceesafe_async_udp_recv");

fn interpBytes(it: borrow Interp, address: u64, length: u64) -> Result<Vector<u8>, Stop> {
    var bytes = Vector<u8>.create();
    for (k in 0..length) {
        bytes.push(truncate<u8>(it.memory.loadBits(address + k, 1)?))!;
    }
    return Ok(bytes);
}

// ---- UDP (ADR 0050 §3.3) ----
//
// The host's raw AsyncSockets UDP calls, one try each. The message record's own layout here: the parts at 64 + 16 k
// (as the vectored send's), a send's destination from 200 (the socket's family, the family, 16 bytes, the port, the
// scope, the segment size), a receive's peer from 240 ((family << 16) | port, 16 bytes, the scope), its flags at 268
// and its local address from 272 (packed, or all ones for none; 16 bytes; the scope). The interpreter sends no
// segments in one call and reports no ECN bits; the local address of a datagram is the socket's own when it is bound
// to one (an unspecified one reports none), which is the packet info's on loopback.

fn udpService(it: borrow mut Interp, name: Slice<u8>, arguments: borrow Vector<Value>) -> Result<Value?, Stop> {
    let pending: u64 = 0x8000000000000001; // CEE_ASYNC_PENDING
    let wouldBlock: u64 = 0x8000000000000000;
    if (sameText(name, "ceesafe_async_udp_bind")) {
        let bytes = interpBytes(it, arguments[1].bits(0, 8)?, 16)?;
        let flags = truncate<u32>(arguments[4].bits(0, 4)?);
        let r = AsyncSockets.udpBind(
            truncate<u32>(arguments[0].bits(0, 4)?),
            bytes.view(),
            truncate<u16>(arguments[2].bits(0, 2)?),
            truncate<u32>(arguments[3].bits(0, 4)?),
            flags,
            truncate<u32>(arguments[5].bits(0, 4)?),
            truncate<u32>(arguments[6].bits(0, 4)?),
        );
        if (r >= 0 && (flags & 16) != 0) {
            it.udpLocal.push(truncate<i32>(r))!; // CEE_UDP_RECEIVE_LOCAL
        }
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_udp_send")) {
        let data = interpBytes(it, arguments[1].bits(0, 8)?, arguments[2].bits(0, 8)?)?;
        let bytes = interpBytes(it, arguments[5].bits(0, 8)?, 16)?;
        let r = AsyncSockets.udpSend(
            truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?)),
            data.view(),
            truncate<u32>(arguments[3].bits(0, 4)?),
            truncate<u32>(arguments[4].bits(0, 4)?),
            bytes.view(),
            truncate<u16>(arguments[6].bits(0, 2)?),
            truncate<u32>(arguments[7].bits(0, 4)?),
        );
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_udp_recv")) {
        let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        var buffer = zeros(arguments[2].bits(0, 8)?);
        var bytes = zeros(16);
        var scope: u32 = 0;
        var info: u32 = 0;
        let r = AsyncSockets.udpRecv(fd, buffer.viewMut(), bytes.viewMut(), mut scope, mut info);
        if (r >= 0) {
            storeBytes(it, arguments[1].bits(0, 8)?, buffer.view(), truncate<u64>(r))?;
            storeBytes(it, arguments[3].bits(0, 8)?, bytes.view(), 16)?;
            it.memory.storeBits(arguments[4].bits(0, 8)?, scope as u64, 4)?;
            it.memory.storeBits(arguments[5].bits(0, 8)?, info as u64, 4)?;
        }
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    let record = arguments[0].bits(0, 8)?;
    if (sameText(name, "ceesafe_async_msg_send_to")) {
        let bytes = interpBytes(it, arguments[3].bits(0, 8)?, 16)?;
        it.memory.storeBits(record + 200, arguments[1].bits(0, 4)?, 4)?;
        it.memory.storeBits(record + 204, arguments[2].bits(0, 4)?, 4)?;
        storeBytes(it, record + 208, bytes.view(), 16)?;
        it.memory.storeBits(record + 224, arguments[4].bits(0, 2)?, 2)?;
        it.memory.storeBits(record + 228, arguments[5].bits(0, 4)?, 4)?;
        it.memory.storeBits(record + 232, arguments[9].bits(0, 4)?, 4)?;
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_op_sendmsg")) {
        let fd = truncate<i32>(truncate<u32>(arguments[1].bits(0, 4)?));
        let count = arguments[2].bits(0, 4)?;
        var data = Vector<u8>.create();
        for (k in 0..(if (count > 8) 8 else count)) {
            let part = interpBytes(
                it,
                it.memory.loadBits(record + 64 + 16 * k, 8)?,
                it.memory.loadBits(record + 64 + 16 * k + 8, 8)?,
            )?;
            for (b in part.view()) {
                data.push(b)!;
            }
        }
        let segment = it.memory.loadBits(record + 232, 4)?;
        if (segment > 0 && data.length as u64 > segment) {
            return Ok(valueOf(0x8000000000000003, 8)); // CEE_ASYNC_NO_SEGMENTS: lib/std sends them one by one
        }
        let bytes = interpBytes(it, record + 208, 16)?;
        let r = truncate<u64>(AsyncSockets.udpSend(
            fd,
            data.view(),
            truncate<u32>(it.memory.loadBits(record + 200, 4)?),
            truncate<u32>(it.memory.loadBits(record + 204, 4)?),
            bytes.view(),
            truncate<u16>(it.memory.loadBits(record + 224, 2)?),
            truncate<u32>(it.memory.loadBits(record + 228, 4)?),
        ));
        if (r == wouldBlock) {
            it.asyncFd = fd;
            it.asyncFdEvents = 2;
            return Ok(valueOf(pending, 8));
        }
        return Ok(valueOf(r, 8));
    }
    if (sameText(name, "ceesafe_async_op_recvmsg")) {
        let fd = truncate<i32>(truncate<u32>(arguments[1].bits(0, 4)?));
        let length = arguments[3].bits(0, 8)?;
        var buffer = zeros(if (length > 65536) 65536 else length);
        var bytes = zeros(16);
        var scope: u32 = 0;
        var info: u32 = 0;
        let r = AsyncSockets.udpRecv(fd, buffer.viewMut(), bytes.viewMut(), mut scope, mut info);
        if (truncate<u64>(r) == wouldBlock) {
            it.asyncFd = fd;
            it.asyncFdEvents = 1;
            return Ok(valueOf(pending, 8));
        }
        if (r < 0) {
            return Ok(valueOf(truncate<u64>(r), 8));
        }
        storeBytes(it, arguments[2].bits(0, 8)?, buffer.view(), truncate<u64>(r))?;
        it.memory.storeBits(record + 240, ((info >> 24) as u64 << 16) | (info & 65535) as u64, 8)?;
        storeBytes(it, record + 248, bytes.view(), 16)?;
        it.memory.storeBits(record + 264, scope as u64, 4)?;
        it.memory.storeBits(record + 268, ((info >> 16) & 1) as u64, 4)?;
        // The local address: the socket's own, if it asked for it and is bound to one.
        var local: u64 = 0xFFFFFFFFFFFFFFFF;
        var bound = zeros(16);
        var ownScope: u32 = 0;
        var asked = false;
        for (d in it.udpLocal.view()) {
            if (d == fd) {
                asked = true;
            }
        }
        if (asked) {
            let named = AsyncSockets.name(fd, 0, bound.viewMut(), mut ownScope);
            var specified = false;
            for (b in bound.view()) {
                if (b != 0) {
                    specified = true;
                }
            }
            if (named >= 0 && specified) {
                local = (truncate<u64>(named) >> 16) << 16; // the port is lib/std's
            }
        }
        it.memory.storeBits(record + 272, local, 8)?;
        storeBytes(it, record + 280, bound.view(), 16)?;
        it.memory.storeBits(record + 296, ownScope as u64, 4)?;
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_msg_address")) {
        let which = arguments[1].bits(0, 4)?;
        let at = if (which == 0) record + 240 else record + 272;
        let packed = it.memory.loadBits(at, 8)?;
        if (packed == 0xFFFFFFFFFFFFFFFF) {
            return Ok(valueOf(packed, 8)); // none
        }
        let bytes = interpBytes(it, at + 8, 16)?;
        storeBytes(it, arguments[2].bits(0, 8)?, bytes.view(), 16)?;
        it.memory.storeBits(arguments[3].bits(0, 8)?, it.memory.loadBits(at + 24, 4)?, 4)?;
        return Ok(valueOf(packed, 8));
    }
    // ceesafe_async_msg_flags: the truncation; no ECN bits here.
    return Ok(valueOf(it.memory.loadBits(record + 268, 4)?, 4));
}

/// `length` zero bytes.
fn zeros(length: u64) -> Vector<u8> {
    var v = Vector<u8>.create();
    for (k in 0..length) {
        v.push(0)!;
    }
    return v;
}

/// The first `count` of `bytes` into the program's memory at `address`.
fn storeBytes(it: borrow mut Interp, address: u64, bytes: Slice<u8>, count: u64) -> Result<void, Stop> {
    for (k in 0..count) {
        it.memory.storeBits(address + k, bytes[k as usize] as u64, 1)?;
    }
    return Ok();
}

/// lib/std's async sockets on real descriptors, through lib/std's AsyncSockets (the interpreter cannot name the
/// runtime's functions itself): non-blocking, so a task waits for readiness as in C (§40.8).
fn asyncSocketService(it: borrow mut Interp, name: Slice<u8>, arguments: borrow Vector<Value>) -> Result<Value?, Stop> {
    if (sameText(name, "ceesafe_async_op_read") || sameText(name, "ceesafe_async_op_send") ||
        sameText(name, "ceesafe_async_op_accept") || sameText(name, "ceesafe_async_op_connect") ||
        sameText(name, "ceesafe_async_op_connect_at") || sameText(name, "ceesafe_async_op_cancel")) {
        return asyncOpStep(it, name, arguments);
    }
    // DNS (ADR 0048 §3.4): stage 0's library has no resolver, so the model knows `localhost` (any case), as 127.0.0.1
    // then ::1; any other name is Unsupported. A lookup is handle 1 (localhost) or 2 (any other); ending one is nothing.
    if (sameText(name, "ceesafe_dns_start")) {
        let host = interpBytes(it, arguments[0].bits(0, 8)?, arguments[1].bits(0, 8)?)?;
        var local = host.length == 9;
        if (local) {
            for (k in 0..9usize) {
                let c = host[k];
                let lower = if (c >= 'A' && c <= 'Z') c + 32 else c;
                if (lower != "localhost".bytes()[k]) {
                    local = false;
                }
            }
        }
        return Ok(valueOf(if (local) 1 else if (reservedInvalid(host.view())) 3 else 2, 8));
    }
    if (sameText(name, "ceesafe_dns_poll")) {
        let handle = arguments[0].bits(0, 8)?;
        let r: i64 = if (handle == 1) 1 else if (handle == 3) 0 - hostNotFound() else 0 - networkErrno(
            18,
            hostErrnos(),
        );
        return Ok(valueOf(truncate<u64>(r), 4));
    }
    if (sameText(name, "ceesafe_dns_count")) {
        return Ok(valueOf(2, 4));
    }
    if (sameText(name, "ceesafe_dns_address")) {
        let index = arguments[1].bits(0, 4)?;
        let bytes = arguments[2].bits(0, 8)?;
        for (k in 0..16u64) {
            it.memory.storeBits(bytes + k, 0, 1)?;
        }
        if (index == 0) {
            it.memory.storeBits(bytes, 127, 1)?;
            it.memory.storeBits(bytes + 3, 1, 1)?;
        } else {
            it.memory.storeBits(bytes + 15, 1, 1)?;
        }
        it.memory.storeBits(arguments[3].bits(0, 8)?, if (index == 0) 4 else 6, 4)?;
        it.memory.storeBits(arguments[4].bits(0, 8)?, 0, 4)?;
        return Ok(null);
    }
    if (sameText(name, "ceesafe_dns_end")) {
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_msg_part")) {
        // ADR 0045: the part's address and length in the record's words 8 + 2 × index (the interpreter's own layout).
        let index = arguments[1].bits(0, 4)?;
        if (index < 8) {
            let slot = arguments[0].bits(0, 8)? + 64 + 16 * index;
            it.memory.storeBits(slot, arguments[2].bits(0, 8)?, 8)?;
            it.memory.storeBits(slot + 8, arguments[3].bits(0, 8)?, 8)?;
        }
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_udp_bind") || sameText(name, "ceesafe_async_msg_send_to") ||
        sameText(name, "ceesafe_async_op_sendmsg") || sameText(name, "ceesafe_async_op_recvmsg") ||
        sameText(name, "ceesafe_async_msg_address") || sameText(name, "ceesafe_async_msg_flags") ||
        sameText(name, "ceesafe_async_udp_send") || sameText(name, "ceesafe_async_udp_recv")) {
        return udpService(it, name, arguments);
    }
    if (sameText(name, "ceesafe_async_op_sendv")) {
        // A vectored step sends the first non-empty part (ADR 0045 §3.5): a legal partial send, so a program sees the
        // same bytes in the same order. Stage 0's lib/std has no vectored send.
        let record = arguments[0].bits(0, 8)?;
        let fd = truncate<i32>(truncate<u32>(arguments[1].bits(0, 4)?));
        let count = arguments[2].bits(0, 4)?;
        for (k in 0..(if (count > 8) 8 else count)) {
            let length = it.memory.loadBits(record + 64 + 16 * k + 8, 8)?;
            if (length > 0) {
                let chunk = if (length > 65536) 65536 else length; // at most 64 KiB a step: still a partial send
                let bytes = interpBytes(it, it.memory.loadBits(record + 64 + 16 * k, 8)?, chunk)?;
                let r = truncate<u64>(AsyncSockets.send(fd, bytes.view()));
                if (r == 0x8000000000000000) {
                    it.asyncFd = fd;
                    it.asyncFdEvents = 2;
                    return Ok(valueOf(0x8000000000000001, 8)); // CEE_ASYNC_PENDING
                }
                return Ok(valueOf(r, 8));
            }
        }
        return Ok(valueOf(0, 8));
    }
    if (sameText(name, "ceesafe_async_tcp_listen_at") || sameText(name, "ceesafe_async_tcp_connect_at")) {
        // ADR 0044: an address's fields (family, its 16 bytes, port, scope), and for a listener the backlog and flags.
        let family = truncate<u32>(arguments[0].bits(0, 4)?);
        let bytes = interpBytes(it, arguments[1].bits(0, 8)?, 16)?;
        let port = truncate<u16>(arguments[2].bits(0, 2)?);
        let scope = truncate<u32>(arguments[3].bits(0, 4)?);
        let r = if (sameText(name, "ceesafe_async_tcp_listen_at")) AsyncSockets.listenAt(
            family,
            bytes.view(),
            port,
            scope,
            truncate<u32>(arguments[4].bits(0, 4)?),
            truncate<u32>(arguments[5].bits(0, 4)?),
        ) else AsyncSockets.connectAt(family, bytes.view(), port, scope);
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_socket_name")) {
        let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        var bytes = Vector<u8>.create();
        for (k in 0..16u32) {
            bytes.push(0)!;
        }
        var scope: u32 = 0;
        let r = AsyncSockets.name(fd, truncate<u32>(arguments[1].bits(0, 4)?), bytes.viewMut(), mut scope);
        if (r >= 0) {
            for (k in 0..16usize) {
                it.memory.storeBits(arguments[2].bits(0, 8)? + k as u64, bytes[k] as u64, 1)?;
            }
            it.memory.storeBits(arguments[3].bits(0, 8)?, scope as u64, 4)?;
        }
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_socket_option")) {
        let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        let option = truncate<u32>(arguments[1].bits(0, 4)?);
        let r = AsyncSockets.setOption(fd, option, truncate<i64>(arguments[2].bits(0, 8)?));
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_interface_index")) {
        let text = interpBytes(it, arguments[0].bits(0, 8)?, arguments[1].bits(0, 8)?)?;
        return Ok(valueOf(AsyncSockets.interfaceIndex(text.view()) as u64, 4));
    }
    if (sameText(name, "ceesafe_async_wait_readable")) {
        it.asyncFd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        it.asyncFdEvents = 1;
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_tcp_listen") || sameText(name, "ceesafe_async_tcp_connect")) {
        let text = interpBytes(it, arguments[0].bits(0, 8)?, arguments[1].bits(0, 8)?)?;
        let port = truncate<u16>(arguments[2].bits(0, 2)?);
        let address = match (StringView.fromUtf8(text.view())) {
            Some(v) => v,
            null => { return Ok(valueOf(0xFFFFFFFFFFFFFFEA, 8)); }, // -EINVAL
        };
        let r = if (sameText(
            name,
            "ceesafe_async_tcp_listen",
        )) AsyncSockets.listen(address, port) else AsyncSockets.connect(address, port);
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_read")) {
        let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        let address = arguments[1].bits(0, 8)?;
        let length = arguments[2].bits(0, 8)?;
        var buffer = Vector<u8>.create();
        for (k in 0..length) {
            buffer.push(0)!;
        }
        let r = AsyncSockets.read(fd, buffer.viewMut());
        if (r > 0) {
            for (k in 0..truncate<usize>(r)) {
                it.memory.storeBits(address + k as u64, buffer[k] as u64, 1)?;
            }
        }
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_send")) {
        let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
        let bytes = interpBytes(it, arguments[1].bits(0, 8)?, arguments[2].bits(0, 8)?)?;
        let r = AsyncSockets.send(fd, bytes.view());
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    if (sameText(name, "ceesafe_async_close")) {
        AsyncSockets.close(truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?)));
        return Ok(null);
    }
    if (sameText(name, "ceesafe_async_poll")) {
        let count = arguments[3].bits(0, 8)?;
        var fds = Vector<i32>.create();
        var events = Vector<u32>.create();
        var ready = Vector<u32>.create();
        for (k in 0..count) {
            fds.push(truncate<i32>(truncate<u32>(it.memory.loadBits(arguments[0].bits(0, 8)? + 4 * k, 4)?)))!;
            events.push(truncate<u32>(it.memory.loadBits(arguments[1].bits(0, 8)? + 4 * k, 4)?))!;
            ready.push(0)!;
        }
        let r = AsyncSockets.poll(fds.view(), events.view(), ready.viewMut(), truncate<i64>(arguments[4].bits(0, 8)?));
        for (k in 0..count) {
            it.memory.storeBits(arguments[2].bits(0, 8)? + 4 * k, ready[k as usize] as u64, 4)?;
        }
        return Ok(valueOf(truncate<u64>(r), 8));
    }
    let fd = truncate<i32>(truncate<u32>(arguments[0].bits(0, 4)?));
    let r = if (sameText(name, "ceesafe_async_tcp_port")) AsyncSockets.port(fd) else if (sameText(
        name,
        "ceesafe_async_tcp_accept",
    )) AsyncSockets.accept(fd) else if (sameText(
        name,
        "ceesafe_async_tcp_connected",
    )) AsyncSockets.connected(fd) else if (sameText(
        name,
        "ceesafe_async_shutdown_read",
    )) AsyncSockets.shutdownRead(fd) else AsyncSockets.shutdownWrite(fd);
    return Ok(valueOf(truncate<u64>(r), 8));
}

/// A user allocator's `allocate` (§30.3) for a frame of `size` bytes: the block's address, or 0 for Err.
fn interpAllocate(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    allocator: u32,
    size: u64,
    align: u64,
) -> Result<u64, Stop> {
    let definition = borrow c.types.structs[c.types.info(allocator).structDef as usize];
    let method = nirFunctionOf(it, definition.allocateMethod, 0)?;
    var arguments = Vector<Value>.create();
    let receiver = it.memory.allocate(allocationLocal(), 1, true, "an allocator".bytes())?;
    arguments.push(valueOf(receiver, 8))!;
    arguments.push(frameLayoutValue(c, allocator, size, align)?)!;
    let result = callFunction(it, c, n, method, arguments)?;
    it.memory.end(receiver);
    let value = match (result) {
        Some(v) => v,
        null => { return Ok(0); },
    };
    if (value.bits(0, 1)? != 0) {
        return Ok(0);
    }
    let resultType = c.hir.functions[definition.allocateMethod as usize].returnType;
    return value.bits(enumUnionOffset(c, resultType) as usize, 8);
}

/// A user allocator's `deallocate` of a frame's block.
fn interpDeallocate(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    allocator: u32,
    block: u64,
    size: u64,
    align: u64,
) -> Result<void, Stop> {
    let definition = borrow c.types.structs[c.types.info(allocator).structDef as usize];
    let method = nirFunctionOf(it, definition.deallocateMethod, 0)?;
    var arguments = Vector<Value>.create();
    let receiver = it.memory.allocate(allocationLocal(), 1, true, "an allocator".bytes())?;
    arguments.push(valueOf(receiver, 8))!;
    arguments.push(valueOf(block, 8))!;
    arguments.push(frameLayoutValue(c, allocator, size, align)?)!;
    callFunction(it, c, n, method, arguments)?;
    it.memory.end(receiver);
    return Ok();
}

/// lib/core's `Layout { size, align }` as a value.
fn frameLayoutValue(c: borrow Checker, allocator: u32, size: u64, align: u64) -> Result<Value, Stop> {
    let layout = layoutTypeOf(c, allocator);
    let fields = borrow c.types.structs[c.types.info(layout).structDef as usize].fields;
    var value = uninitialisedValue(typeSize(c, layout)?);
    value.put(c.types.fields[fields[0] as usize].offset as usize, valueOf(size, 8));
    value.put(c.types.fields[fields[1] as usize].offset as usize, valueOf(align, 8));
    return Ok(value);
}

/// ADR 0035's operation steps, as the C runtime's readiness backend takes them: an attempt; if it would block, the
/// task's wait and CEE_ASYNC_PENDING. A connect keeps its socket in the record's first word (the descriptor + 1)
/// between steps; cancelling closes it, and nothing is ever in flight.
fn asyncOpStep(it: borrow mut Interp, name: Slice<u8>, arguments: borrow Vector<Value>) -> Result<Value?, Stop> {
    let pending: u64 = 0x8000000000000001; // CEE_ASYNC_PENDING
    let wouldBlock: u64 = 0x8000000000000000;
    let record = arguments[0].bits(0, 8)?;
    if (sameText(name, "ceesafe_async_op_cancel")) {
        let held = it.memory.loadBits(record, 8)?;
        if (held != 0) {
            AsyncSockets.close(truncate<i32>(truncate<u32>(held - 1))); // a connection abandoned half made
            it.memory.storeBits(record, 0, 8)?;
        }
        return Ok(valueOf(0, 1));
    }
    if (sameText(name, "ceesafe_async_op_connect") || sameText(name, "ceesafe_async_op_connect_at")) {
        var held = it.memory.loadBits(record, 8)?;
        if (held == 0) {
            var started = Vector<Value>.create();
            for (k in 1..arguments.length) {
                started.push(copyValue(borrow arguments[k]))!;
            }
            let start = if (sameText(
                name,
                "ceesafe_async_op_connect",
            )) "ceesafe_async_tcp_connect" else "ceesafe_async_tcp_connect_at";
            let r = asyncSocketService(it, start.bytes(), started)?;
            let fd = match (r) {
                Some(v) => v.bits(0, 8)?,
                null => 0,
            };
            if ((fd >> 63) != 0) {
                return Ok(valueOf(fd, 8)); // a negated errno
            }
            held = fd + 1;
            it.memory.storeBits(record, held, 8)?;
        }
        let fd = truncate<i32>(truncate<u32>(held - 1));
        let done = truncate<u64>(AsyncSockets.connected(fd));
        if (done == wouldBlock) {
            it.asyncFd = fd;
            it.asyncFdEvents = 2;
            return Ok(valueOf(pending, 8));
        }
        it.memory.storeBits(record, 0, 8)?;
        if (done != 0) {
            AsyncSockets.close(fd);
            return Ok(valueOf(done, 8));
        }
        return Ok(valueOf(held - 1, 8));
    }
    var rest = Vector<Value>.create();
    for (k in 1..arguments.length) {
        rest.push(copyValue(borrow arguments[k]))!;
    }
    let plain = if (sameText(name, "ceesafe_async_op_read")) "ceesafe_async_read" else if (sameText(
        name,
        "ceesafe_async_op_send",
    )) "ceesafe_async_send" else "ceesafe_async_tcp_accept";
    let r = asyncSocketService(it, plain.bytes(), rest)?;
    let value = match (r) {
        Some(v) => v.bits(0, 8)?,
        null => 0,
    };
    if (value == wouldBlock) {
        it.asyncFd = truncate<i32>(truncate<u32>(arguments[1].bits(0, 4)?));
        it.asyncFdEvents = if (sameText(name, "ceesafe_async_op_send")) 2 else 1;
        return Ok(valueOf(pending, 8));
    }
    return Ok(valueOf(value, 8));
}

/// `f.readAt`, `f.writeAt`, `f.syncData`, `f.syncAll`, `f.length` and `f.setLength` (ADR 0075 §2.1), by reopening the
/// file at its path. A sync is done once the call returns: the interpreter has no crash to survive.
fn durableFileBuiltin(
    it: borrow mut Interp,
    c: borrow Checker,
    n: borrow NirProgram,
    frame: borrow mut Frame,
    b: u32,
    arguments: Range,
    resultType: u32,
) -> Result<Value?, Stop> {
    requireHostIo(it)?;
    let fd = descriptorArgument(it, c, n, frame, arguments, 0)?;
    var path = String.create();
    match (handleIndex(it, fd)) {
        Some(k) => {
            match (borrow it.runtime.handles[k]) {
                HostHandle.OpenFile(_, p) => { path.append(p.view())!; }
                HostHandle.PathFile(p, _) => { path.append(p.view())!; }
                _ => {}
            }
        }
        null => {}
    }
    if (path.view().length == 0) {
        return Ok(interpIoResult(c, resultType, 0, 9)?); // EBADF
    }
    if (b == bfFileSyncData() || b == bfFileSyncAll()) {
        return Ok(interpIoResult(c, resultType, 0, 0)?);
    }
    if (b == bfFileReadAt()) {
        let slice = argument(it, c, n, frame, arguments, 1)?;
        let offset = argumentInteger(it, c, n, frame, arguments, 2)?.magnitude;
        var buffer = readBuffer(it, slice)?;
        match (readFileAt(path.view(), mut buffer, offset)) {
            Ok(count) => {
                storeRead(it, slice, buffer, count)?;
                return Ok(interpIoResult(c, resultType, truncate<i64>(count), 0)?);
            }
            Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
        }
    }
    if (b == bfFileWriteAt()) {
        let value = argument(it, c, n, frame, arguments, 1)?;
        let bytes = bytesOf(it, value)?;
        let offset = argumentInteger(it, c, n, frame, arguments, 2)?.magnitude;
        return match (writeFileAt(path.view(), bytes.view(), offset)) {
            Ok() => Ok(interpIoResult(c, resultType, 0, 0)?),
            Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
        };
    }
    var contents = match (wholeFile(path.view())) {
        Ok(v) => v,
        Err(e) => { return Ok(interpIoResult(c, resultType, 0, errnoOf(e))?); }
    };
    if (b == bfFileLength()) {
        return Ok(interpIoResult(c, resultType, truncate<i64>(contents.length), 0)?);
    }
    let length = argumentInteger(it, c, n, frame, arguments, 1)?.magnitude;
    if ((contents.length as u64) > length) {
        contents.truncate(length as usize);
    }
    while ((contents.length as u64) < length) {
        contents.push(0)!;
    }
    return match (replaceFile(path.view(), contents.view())) {
        Ok() => Ok(interpIoResult(c, resultType, 0, 0)?),
        Err(e) => Ok(interpIoResult(c, resultType, 0, errnoOf(e))?),
    };
}

/// The whole file at `path`.
fn wholeFile(path: StringView) -> Result<Vector<u8>, IoError> {
    var file = File.open(path)?;
    var out = Vector<u8>.create();
    var chunk = [0u8; 4096];
    loop {
        let count = file.read(mut chunk[..])?;
        if (count == 0) {
            break;
        }
        for (i in 0..count) {
            out.push(chunk[i])!;
        }
    }
    return Ok(out);
}

/// Writes `bytes` as the whole file at `path`.
fn replaceFile(path: StringView, bytes: Slice<u8>) -> Result<void, IoError> {
    var file = File.create(path)?;
    return file.write(bytes);
}

/// Up to `buffer.length` bytes of the file at `path`, from `offset`; 0 at or past the end.
fn readFileAt(path: StringView, buffer: borrow mut Vector<u8>, offset: u64) -> Result<usize, IoError> {
    let contents = wholeFile(path)?;
    let size = contents.length as u64;
    if (offset >= size) {
        return Ok(0);
    }
    let start = offset as usize;
    var count = contents.length - start;
    if (count > buffer.length) {
        count = buffer.length;
    }
    for (i in 0..count) {
        buffer[i] = contents[start + i];
    }
    return Ok(count);
}

/// Writes `bytes` at `offset` of the file at `path`, zero-filling a gap after its end.
fn writeFileAt(path: StringView, bytes: Slice<u8>, offset: u64) -> Result<void, IoError> {
    var contents = wholeFile(path)?;
    while ((contents.length as u64) < offset) {
        contents.push(0)!;
    }
    let start = offset as usize;
    for (i in 0..bytes.length) {
        if (start + i < contents.length) {
            contents[start + i] = bytes[i];
        } else {
            contents.push(bytes[i])!;
        }
    }
    return replaceFile(path, contents.view());
}

/// A PathFile's position that means "at the end": `File.openAppend` (ADR 0077).
fn appendPosition() -> u64 => 0xFFFFFFFFFFFFFFFF;
