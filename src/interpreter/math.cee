// The float methods that are the C library's math functions (type-system.md §35.8, ADR 0218), in the interpreter:
// ceesafec calls the methods themselves, so it calls the runtime functions a compiled program calls
// (runtime/hosted/ceesafe_rt_math.c, which ceesafec therefore links), and `run --interp` prints what the program's
// build prints on the same machine (testing.md, "Interpreter agreement"), whichever C compiler built ceesafec: on
// Windows both are ucrtbase.dll's (ADR 0248). ceesafec links libm: the manifest's [target.linux] and
// [target.freebsd] name it, macOS's and Windows' C libraries hold it. The arguments are never constants in C, so no C
// compiler folds a call here either.

/// The libm method `b` (isLibmBuiltin) of `f64` operands; `n` is `scaleB`'s power of two.
fn libmF64(b: u32, x: f64, y: f64, z: f64, n: i32) -> f64 {
    return match (b) {
        145 => x.exp(),
        146 => x.exp2(),
        147 => x.expM1(),
        148 => x.ln(),
        149 => x.log2(),
        150 => x.log10(),
        151 => x.ln1p(),
        152 => x.sin(),
        153 => x.cos(),
        154 => x.tan(),
        155 => x.asin(),
        156 => x.acos(),
        157 => x.atan(),
        158 => x.sinh(),
        159 => x.cosh(),
        160 => x.tanh(),
        161 => x.asinh(),
        162 => x.acosh(),
        163 => x.atanh(),
        164 => x.cbrt(),
        165 => x.logB(),
        166 => x.pow(y),
        167 => x.atan2(y),
        168 => x.hypot(y),
        169 => x.remainder(y),
        170 => x.truncatingRemainder(y),
        171 => x.fma(y, z),
        _ => x.scaleB(n),
    };
}

/// The same for `f32` operands: an `f32` method is libm's `f` function (`expf` …), so an `f32` result is libm's
/// `f32` one.
fn libmF32(b: u32, x: f32, y: f32, z: f32, n: i32) -> f32 {
    return match (b) {
        145 => x.exp(),
        146 => x.exp2(),
        147 => x.expM1(),
        148 => x.ln(),
        149 => x.log2(),
        150 => x.log10(),
        151 => x.ln1p(),
        152 => x.sin(),
        153 => x.cos(),
        154 => x.tan(),
        155 => x.asin(),
        156 => x.acos(),
        157 => x.atan(),
        158 => x.sinh(),
        159 => x.cosh(),
        160 => x.tanh(),
        161 => x.asinh(),
        162 => x.acosh(),
        163 => x.atanh(),
        164 => x.cbrt(),
        165 => x.logB(),
        166 => x.pow(y),
        167 => x.atan2(y),
        168 => x.hypot(y),
        169 => x.remainder(y),
        170 => x.truncatingRemainder(y),
        171 => x.fma(y, z),
        _ => x.scaleB(n),
    };
}

/// `x` with the sign of `s` (`copySign`, and the sign of a zero result below).
fn withSign(x: f64, s: f64) -> f64 =>
    f64.fromBits((x.bits() & 0x7FFFFFFFFFFFFFFF) | (s.bits() & 0x8000000000000000));

/// `trunc`, `round` and `roundEven` (ADR 0218 §2.3), as rt.h's cee_trunc_f64 … compute them: exact, so an `f32`
/// operand, widened, gives its own result. `t` is `x` toward zero; `d = x - t` is exact and decides the step.
fn roundIntegral(b: u32, x: f64, bits: u32) -> f64 {
    let limit = if (bits == 32) 8388608.0 else 4503599627370496.0;
    if (!(x > -limit && x < limit)) {
        return x;
    }
    var t = if (x < 0.0) x.ceil() else x.floor();
    let d = x - t;
    if (b == bfFloatRound()) {
        if (d >= 0.5) {
            t += 1.0;
        } else if (d <= -0.5) {
            t -= 1.0;
        }
    } else if (b == bfFloatRoundEven()) {
        let odd = (t * 0.5).floor() != t * 0.5;
        if (d > 0.5 || (d == 0.5 && odd)) {
            t += 1.0;
        } else if (d < -0.5 || (d == -0.5 && odd)) {
            t -= 1.0;
        }
    }
    return withSign(t, x);
}
