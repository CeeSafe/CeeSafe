// The interpreter's memory (the reference's Interpreter/Memory.cs; intermediate-representation.md §5.2):
// byte-addressed allocations with the target layout, each byte carrying an initialised bit. Allocation i has base
// address (i + 1) << 32, which is 16-aligned like malloc's memory, so address arithmetic behaves as in the generated C.

fn allocationLocal() -> u32 => 0;
fn allocationHeap() -> u32 => 1;
fn allocationStatic() -> u32 => 2;

struct Allocation {
    kind: u32;
    data: Vector<u8>;
    init: Vector<bool>;
    what: Vector<u8>;
    live: bool;
    counted: bool; // in the interpreter's `live` count: a heap block from ceesafe_alloc's steps (runtime.cee)
    secret: bool;  // a SecretHeap block: its bytes are set to zero when it is freed (ADR 0197 §2.3)
}

/// An ended local of this many bytes or fewer keeps its buffers for `revive`.
fn keptLocalBytes() -> usize => 16;

fn allocationBase(id: usize) -> u64 => ((id as u64) + 1) << 32;

/// A value in transit: its bytes and which of them are initialised. A value of 8 bytes or fewer (an integer, a
/// pointer, a bool) is in `word` and `known` and has no memory of its own; a longer one is in `data` and `init`.
struct Value {
    length: usize;
    word: u64;  // length <= 8: the bytes, little-endian
    known: u64; // length <= 8: bit i is set where byte i is initialised
    data: Vector<u8>;
    init: Vector<bool>;

    fn size(borrow this) -> usize => this.length;

    fn byteAt(borrow this, i: usize) -> u8 {
        if (this.length <= 8) {
            return truncate<u8>(this.word >> ((8 * i) as u64));
        }
        return this.data[i];
    }

    fn initAt(borrow this, i: usize) -> bool {
        if (this.length <= 8) {
            return ((this.known >> (i as u64)) & 1) != 0;
        }
        return this.init[i];
    }

    fn setAt(borrow mut this, i: usize, b: u8, known: bool) {
        if (this.length <= 8) {
            let shift = (8 * i) as u64;
            this.word = (this.word & ((0xFFu64 << shift) ^ 0xFFFFFFFFFFFFFFFF)) | ((b as u64) << shift);
            let bit = 1u64 << (i as u64);
            this.known = if (known) this.known | bit else this.known & (bit ^ 0xFFFFFFFFFFFFFFFF);
            return;
        }
        this.data[i] = b;
        this.init[i] = known;
    }

    /// Whether every byte is initialised.
    fn allInitialised(borrow this) -> bool {
        if (this.length <= 8) {
            return this.known == lowBits(this.length);
        }
        for (b in this.init.view()) {
            if (!b) {
                return false;
            }
        }
        return true;
    }

    /// The bytes [offset, offset + size) as an unsigned number; a use, so they must be initialised.
    fn bits(borrow this, offset: usize, size: usize) -> Result<u64, Stop> {
        if (this.length <= 8 && offset + size <= this.length) {
            let wanted = lowBits(size) << (offset as u64);
            if ((this.known & wanted) != wanted) {
                return Err(fault("use of uninitialised memory"));
            }
            if (size == 0) {
                return Ok(0);
            }
            let shifted = this.word >> ((8 * offset) as u64);
            return Ok(if (size >= 8) shifted else shifted & ((1u64 << ((8 * size) as u64)) - 1));
        }
        var bits: u64 = 0;
        for (i in 0..size) {
            if (!this.init[offset + i]) {
                return Err(fault("use of uninitialised memory"));
            }
            bits = bits | ((this.data[offset + i] as u64) << ((8 * i) as u64));
        }
        return Ok(bits);
    }

    fn put(borrow mut this, offset: usize, part: borrow Value) {
        for (i in 0..part.length) {
            this.setAt(offset + i, part.byteAt(i), part.initAt(i));
        }
    }

    fn slice(borrow this, offset: usize, size: usize) -> Value {
        var value = uninitialisedValue(size);
        for (i in 0..size) {
            value.setAt(i, this.byteAt(offset + i), this.initAt(offset + i));
        }
        return value;
    }
}

/// The low `count` bits set, `count` at most 8.
fn lowBits(count: usize) -> u64 => (1u64 << (count as u64)) - 1;

fn smallValue(size: usize, word: u64, known: u64) -> Value =>
    Value { length: size, word: word, known: known, data: Vector<u8>.create(), init: Vector<bool>.create() };

fn uninitialisedValue(size: usize) -> Value {
    if (size <= 8) {
        return smallValue(size, 0, 0);
    }
    var data = Vector<u8>.withCapacity(size)!;
    var init = Vector<bool>.withCapacity(size)!;
    for (i in 0..size) {
        data.push(0)!;
        init.push(false)!;
    }
    return Value { length: size, word: 0, known: 0, data: data, init: init };
}

fn initialisedValue(bytes: Slice<u8>) -> Value {
    if (bytes.length <= 8) {
        var word: u64 = 0;
        for (i in 0..bytes.length) {
            word = word | ((bytes[i] as u64) << ((8 * i) as u64));
        }
        return smallValue(bytes.length, word, lowBits(bytes.length));
    }
    var data = Vector<u8>.withCapacity(bytes.length)!;
    var init = Vector<bool>.withCapacity(bytes.length)!;
    for (b in bytes) {
        data.push(b)!;
        init.push(true)!;
    }
    return Value { length: bytes.length, word: 0, known: 0, data: data, init: init };
}

/// `bits` as `size` little-endian bytes (x86-64 and AArch64), initialised.
fn valueOf(bits: u64, size: usize) -> Value {
    if (size <= 8) {
        return smallValue(size, if (size == 8) bits else bits & ((1u64 << ((8 * size) as u64)) - 1), lowBits(size));
    }
    var data = Vector<u8>.withCapacity(size)!;
    var init = Vector<bool>.withCapacity(size)!;
    for (i in 0..size) {
        data.push(if (i < 8) truncate<u8>(bits >> ((8 * i) as u64)) else 0)!;
        init.push(true)!;
    }
    return Value { length: size, word: 0, known: 0, data: data, init: init };
}

fn copyValue(v: borrow Value) -> Value => v.slice(0, v.length);

/// A value's bytes, as a vector: the value's own where it has one.
fn bytesOfValue(v: Value) -> Vector<u8> {
    if (v.length > 8) {
        return v.data;
    }
    var bytes = Vector<u8>.create();
    for (i in 0..v.length) {
        bytes.push(v.byteAt(i))!;
    }
    return bytes;
}

/// Why the interpreter stopped: a fault (§5.2: something no checked program can do), a panic, or `Process.exit`.
struct Stop {
    kind: u32; // 0 fault, 1 panic, 2 exit
    message: Vector<u8>;
    location: Vector<u8>;
    hasLocation: bool;
    code: i64;
}

fn fault(message: StringView) -> Stop => faultBytes(message.bytes());

fn faultBytes(message: Slice<u8>) -> Stop =>
    Stop { kind: 0, message: copyBytes(message)!, location: Vector<u8>.create(), hasLocation: false, code: 0 };

fn panicAt(reason: StringView, location: borrow Vector<u8>) -> Stop =>
    Stop {
        kind: 1,
        message: copyBytes(reason.bytes())!,
        location: copyBytes(location.view())!,
        hasLocation: true,
        code: 0,
    };

fn exitWith(code: i64) -> Stop =>
    Stop { kind: 2, message: Vector<u8>.create(), location: Vector<u8>.create(), hasLocation: false, code: code };

/// A message and a lower-case hexadecimal address: `prefix0x…suffix`.
fn addressMessage(prefix: StringView, address: u64, suffix: StringView) -> Stop {
    var m = copyBytes(prefix.bytes())!;
    appendText(mut m, "0x")!;
    appendLowerHex(mut m, address)!;
    appendText(mut m, suffix)!;
    return faultBytes(m.view());
}

fn appendLowerHex(out: borrow mut Vector<u8>, value: u64) -> Result<void, AllocError> {
    var digits = [0u8; 16];
    var n: usize = 0;
    var v = value;
    loop {
        let d = truncate<u8>(v & 15);
        digits[n] = if (d < 10) '0' + d else 'a' + (d - 10);
        n += 1;
        v = v >> 4;
        if (v == 0) {
            break;
        }
    }
    while (n > 0) {
        n -= 1;
        out.push(digits[n])?;
    }
    return Ok();
}

struct Memory {
    allocations: Vector<Allocation>;
    live: i64;  // the bytes of live allocations
    limit: i64; // the most there may be (0: no limit; tooling.md §6.3)
    /// `--scan-freed` (ADR 0197 §4.3): the bytes of every heap block freed, as they were at the free.
    scanFreed: bool;
    freed: Vector<Vector<u8>>;

    fn create(limit: i64) -> Memory => Memory {
        allocations: Vector<Allocation>.create(),
        live: 0,
        limit: limit,
        scanFreed: false,
        freed: Vector<Vector<u8>>.create(),
    };

    /// Whether a freed heap block's bytes, as they were at its free, hold `pattern` (Testing.freedHolds, ADR 0197
    /// §4.3); never while the scan is off.
    fn freedHolds(borrow this, pattern: Slice<u8>) -> bool {
        if (pattern.length == 0) {
            return this.scanFreed && this.freed.length != 0;
        }
        for (block in this.freed.view()) {
            let bytes = block.view();
            if (bytes.length >= pattern.length) {
                for (start in 0..bytes.length - pattern.length + 1) {
                    if (bytes[start..start + pattern.length] == pattern) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    /// Would `size` more bytes pass the limit? Then the heap reports out of memory instead.
    fn wouldExceed(borrow this, size: u64) -> bool =>
        this.limit > 0 && truncate<u64>(this.live) + size > truncate<u64>(this.limit);

    fn allocate(borrow mut this, kind: u32, size: usize, initialised: bool, what: Slice<u8>) -> Result<u64, Stop> {
        if (this.wouldExceed(size as u64)) {
            var m = copyBytes("the sandbox's memory limit of ".bytes())!;
            appendDecimal(mut m, truncate<u64>(this.limit))!;
            appendText(mut m, " bytes is reached")!;
            return Err(faultBytes(m.view()));
        }
        this.live += truncate<i64>(size);
        var data = Vector<u8>.withCapacity(size)!;
        var init = Vector<bool>.withCapacity(size)!;
        for (i in 0..size) {
            data.push(0)!;
            init.push(initialised)!;
        }
        this.allocations.push(
            Allocation {
                kind: kind,
                data: data,
                init: init,
                what: copyBytes(what)!,
                live: true,
                counted: false,
                secret: false,
            },
        )!;
        return Ok(allocationBase(this.allocations.length - 1));
    }

    fn staticBytes(borrow mut this, bytes: Slice<u8>, what: Slice<u8>) -> Result<u64, Stop> {
        let base = this.allocate(allocationStatic(), bytes.length, true, what)?;
        let id = (base >> 32) - 1;
        for (i in 0..bytes.length) {
            this.allocations[id as usize].data[i] = bytes[i];
        }
        return Ok(base);
    }

    /// Ends an allocation (its memory may no longer be used).
    fn end(borrow mut this, address: u64) {
        let id = ((address >> 32) - 1) as usize;
        if (this.allocations[id].live) {
            this.live -= truncate<i64>(this.allocations[id].data.length);
        }
        this.allocations[id].live = false;
        // The buffers themselves are given back, not only emptied: a record outlives its allocation (its id is never
        // reused, so a dangling address is still caught), and clear() kept their capacity with it for the whole run.
        // A local of a few bytes keeps its: most are revived at once (`revive`), by a loop's next turn or the
        // function's next call, and giving two buffers back to take two again was a tenth of a run's time.
        if (this.allocations[id].kind == allocationLocal() && this.allocations[id].data.length <= keptLocalBytes()) {
            return;
        }
        this.allocations[id].data = Vector<u8>.create();
        this.allocations[id].init = Vector<bool>.create();
    }

    /// Brings an ended local allocation at `address` (its base) back to life with `size` initialised zero bytes, for a
    /// new incarnation of a local no reference can name (interpreter.cee, `reincarnate`): true if it was, false if
    /// it is not such an allocation or the sandbox's limit would be passed (then a new allocation reports it).
    fn revive(borrow mut this, address: u64, size: usize) -> bool {
        let id = address >> 32;
        if (id == 0 || (id - 1) >= (this.allocations.length as u64) || (address & 0xFFFFFFFF) != 0) {
            return false;
        }
        let index = (id - 1) as usize;
        if (this.allocations[index].live || this.allocations[index].kind != allocationLocal() ||
            this.wouldExceed(size as u64)) {
            return false;
        }
        this.live += truncate<i64>(size);
        if (size > 0 && this.allocations[index].data.length == size) { // its buffers were kept (`end`)
            for (i in 0..size) {
                this.allocations[index].data[i] = 0;
                this.allocations[index].init[i] = true;
            }
            this.allocations[index].live = true;
            return true;
        }
        var data = Vector<u8>.withCapacity(size)!;
        var init = Vector<bool>.withCapacity(size)!;
        for (i in 0..size) {
            data.push(0)!;
            init.push(true)!;
        }
        this.allocations[index].data = data;
        this.allocations[index].init = init;
        this.allocations[index].live = true;
        return true;
    }

    fn isLive(borrow this, address: u64) -> bool {
        let id = (address >> 32);
        return id >= 1 && ((id - 1) as usize) < this.allocations.length && this.allocations[(id - 1) as usize].live;
    }

    /// The live allocation containing [address, address + size), and the offset in it.
    fn resolve(borrow this, address: u64, size: usize, write: bool) -> Result<usize, Stop> {
        if (address == 0) {
            return Err(fault("dereference of null"));
        }
        let id = address >> 32;
        if (id == 0 || (id - 1) >= (this.allocations.length as u64)) {
            return Err(addressMessage("access to an invalid address ", address, ""));
        }
        let allocation = borrow this.allocations[(id - 1) as usize];
        if (!allocation.live) {
            var m = copyBytes("access to ended memory (".bytes())!;
            appendBytes(mut m, allocation.what.view())!;
            m.push(')')!;
            return Err(faultBytes(m.view()));
        }
        let offset = address & 0xFFFFFFFF;
        if (offset + (size as u64) > (allocation.data.length as u64)) {
            var m = copyBytes("access out of bounds of ".bytes())!;
            appendBytes(mut m, allocation.what.view())!;
            appendText(mut m, " (")!;
            appendDecimal(mut m, size as u64)!;
            appendText(mut m, " bytes at offset ")!;
            appendDecimal(mut m, offset)!;
            appendText(mut m, " of ")!;
            appendDecimal(mut m, allocation.data.length as u64)!;
            m.push(')')!;
            return Err(faultBytes(m.view()));
        }
        if (write && allocation.kind == allocationStatic()) {
            var m = copyBytes("write to static memory (".bytes())!;
            appendBytes(mut m, allocation.what.view())!;
            m.push(')')!;
            return Err(faultBytes(m.view()));
        }
        return Ok(offset as usize);
    }

    fn load(borrow this, address: u64, size: usize) -> Result<Value, Stop> {
        if (size == 0) {
            return Ok(uninitialisedValue(0));
        }
        let offset = this.resolve(address, size, false)?;
        let allocation = borrow this.allocations[((address >> 32) - 1) as usize];
        if (size <= 8) {
            var word: u64 = 0;
            var known: u64 = 0;
            for (i in 0..size) {
                word = word | ((allocation.data[offset + i] as u64) << ((8 * i) as u64));
                if (allocation.init[offset + i]) {
                    known = known | (1u64 << (i as u64));
                }
            }
            return Ok(smallValue(size, word, known));
        }
        var value = uninitialisedValue(size);
        for (i in 0..size) {
            value.data[i] = allocation.data[offset + i];
            value.init[i] = allocation.init[offset + i];
        }
        return Ok(value);
    }

    fn store(borrow mut this, address: u64, value: borrow Value) -> Result<void, Stop> {
        if (value.length == 0) {
            return Ok();
        }
        let offset = this.resolve(address, value.length, true)?;
        let id = ((address >> 32) - 1) as usize;
        for (i in 0..value.length) {
            this.allocations[id].data[offset + i] = value.byteAt(i);
            this.allocations[id].init[offset + i] = value.initAt(i);
        }
        return Ok();
    }

    /// Marks bytes uninitialised: the value was moved out (type-system.md §14.3).
    fn uninitialise(borrow mut this, address: u64, size: usize) -> Result<void, Stop> {
        if (size == 0) {
            return Ok();
        }
        let offset = this.resolve(address, size, false)?;
        let id = ((address >> 32) - 1) as usize;
        for (i in 0..size) {
            this.allocations[id].init[offset + i] = false;
        }
        return Ok();
    }

    /// A scalar of `size` bytes (a use: they must be initialised).
    fn loadBits(borrow this, address: u64, size: usize) -> Result<u64, Stop> {
        let offset = this.resolve(address, size, false)?;
        let allocation = borrow this.allocations[((address >> 32) - 1) as usize];
        var bits: u64 = 0;
        for (i in 0..size) {
            if (!allocation.init[offset + i]) {
                return Err(fault("use of uninitialised memory"));
            }
            bits = bits | ((allocation.data[offset + i] as u64) << ((8 * i) as u64));
        }
        return Ok(bits);
    }

    fn storeBits(borrow mut this, address: u64, bits: u64, size: usize) -> Result<void, Stop> {
        let offset = this.resolve(address, size, true)?;
        let id = ((address >> 32) - 1) as usize;
        for (i in 0..size) {
            this.allocations[id].data[offset + i] = if (i < 8) truncate<u8>(bits >> ((8 * i) as u64)) else 0;
            this.allocations[id].init[offset + i] = true;
        }
        return Ok();
    }

    /// Copies bytes with their initialised bits (memmove semantics).
    fn copy(borrow mut this, destination: u64, source: u64, size: usize) -> Result<void, Stop> {
        if (size == 0) {
            return Ok();
        }
        let value = this.load(source, size)?;
        this.resolve(destination, size, true)?;
        return this.store(destination, value);
    }

    /// The allocation an address is in, or a fault.
    fn allocationAt(borrow this, address: u64) -> Result<usize, Stop> {
        let id = address >> 32;
        if (id == 0 || (id - 1) >= (this.allocations.length as u64)) {
            return Err(addressMessage("invalid address ", address, ""));
        }
        return Ok((id - 1) as usize);
    }

    /// Ends a heap allocation; only its base address may be freed.
    fn free(borrow mut this, address: u64) -> Result<void, Stop> {
        let id = address >> 32;
        if (id == 0 || (id - 1) >= (this.allocations.length as u64) || (address & 0xFFFFFFFF) != 0) {
            return Err(addressMessage("free of an address that is not an allocation (", address, ")"));
        }
        let index = (id - 1) as usize;
        if (this.allocations[index].kind != allocationHeap()) {
            var m = copyBytes("free of ".bytes())!;
            appendBytes(mut m, this.allocations[index].what.view())!;
            return Err(faultBytes(m.view()));
        }
        if (!this.allocations[index].live) {
            return Err(fault("double free"));
        }
        if (this.allocations[index].secret) {
            // A SecretHeap block is wiped before it goes back (ADR 0197 §2.3), as ceesafe_free does.
            for (i in 0..this.allocations[index].data.length) {
                this.allocations[index].data[i] = 0;
            }
        }
        if (this.scanFreed) {
            this.freed.push(copyBytes(this.allocations[index].data.view())!)!;
        }
        this.end(address);
        return Ok();
    }
}
