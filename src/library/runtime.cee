        "  if (s >= 10) {\n        /* One digit fewer: s' = floor(s / 10), with u' = 10 s' and w' = u' + 10. */\n        uint64_t sp10 = 10 * cee_umulh(s, UINT64_C(115292150460684698) << 4);\n        uint64_t tp10 = sp10 + 10;\n        bool upin = vbl + out <= sp10 << 2;\n        bool wpin = (tp10 << 2) + out <= vbr;\n        if (upin != wpin) return (cee_decimal){ upin ? sp10 : tp10, k };\n    }\n    uint64_t t = s + 1;\n    bool uin = vbl + out <= s << 2;\n    bool win = (t << 2) + out <= vbr;\n    if (uin != win) return (cee_decimal){ uin ? s : t, k };\n    /* Both in the interval: the nearer to v, and the even one on a tie. */\n    int64_t cmp = (int64_t)vb - (int64_t)((s + t) << 1);\n    return (cee_decimal){ cmp < 0 || (cmp == 0 && (s & 1u) == 0) ? s : t, k };\n}\n\nstatic cee_decimal cee_to_decimal32(int q, uint32_t c) {\n    uint64_t out = c & 1u;\n    uint64_t cb = (uint64_t)c << 2, cbr = cb + 2, cbl;\n    int k;\n    if (c != (UINT32_C(1) << 23) || q == -149) {\n        cbl = cb - 2;\n        k = cee_flog10pow2(q);\n    } else {\n        cbl = cb - 1;\n        k = cee_flog10threequarterspow2(q);\n    }\n    int h = q + cee_flog2pow10(-k) + 33;\n    uint64_t g = cee_g[k - CEE_K_MIN][0] + 1;\n    uint64_t vb = cee_rop32(g, cb << h);\n    uint64_t vbl = cee_rop32(g, cbl << h);\n    uint64_t vbr = cee_rop32(g, cbr << h);\n    uint64_t s = vb >> 2;\n    if (s >= 10) {\n        uint64_t sp10 = 10 * ((s * UINT64_C(1717986919)) >> 34);\n        uint64_t tp10 = sp10 + 10;\n        bool upin = vbl + out <= sp10 << 2;\n        bool wpin = (tp10 << 2) + out <= vbr;\n        if (upin != wpin) return (cee_decimal){ upin ? sp10 : tp10, k };\n    }\n    uint64_t t = s + 1;\n    bool uin = vbl + out <= s << 2;\n    bool win = (t << 2) + out <= vbr;\n    if (uin != win) return (cee_decimal){ uin ? s : t, k };\n    int64_t cmp = (int64_t)vb - (int64_t)((s + t) << 1);\n    return (cee_decimal){ cmp < 0 || (cmp == 0 && (s & 1u) == 0) ? s : t, k };\n}\n\n/* Lays out sign * 0.d1...dk * 10^n as ECMAScript does; `d` holds f * 10^e. Returns the text written into buf. */\nstatic cee_str cee_layout(bool negative, cee_decimal d, uint8_t *buf) {\n    uint8_t digits[20];\n    int count = 0;\n    uint64_t f = d.f;\n    int e = d.e;\n    while (f % 10 == 0) { f /= 10; e++; }\n    for (uint64_t r = f; r != 0; r /= 10) digits[count++] = (uint8_t)('0' + r % 10);\n    /* digits[] holds them last first */\n    int n = e + count;\n    uint8_t *p = buf;\n    if (negative) *p++ = '-';\n    if (count <= n && n <= 21) {\n        for (int i = count - 1; i >= 0; i--) *p++ = digits[i];\n        for (int i = 0; i < n - count; i++) *p++ = '0';\n    } else if (0 < n && n <= 21) {\n        for (int i = count - 1; i >= 0; i--) {\n            *p++ = digits[i];\n            if (i == count - n) *p++ = '.';\n        }\n    } else if (-6 < n && n <= 0) {\n        *p++ = '0';\n        *p++ = '.';\n        for (int i = 0; i < -n; i++) *p++ = '0';\n        for (int i = count - 1; i >= 0; i--) *p++ = digits[i];\n    } else {\n        *p++ = digits[count - 1];\n        if (count > 1) {\n            *p++ = '.';\n            for (int i = count - 2; i >= 0; i--) *p++ = digits[i];\n        }\n        int x = n - 1;\n        *p++ = 'e';\n        *p++ = x < 0 ? '-' : '+';\n        unsigned magnitude = (unsigned)(x < 0 ? -x : x);\n        uint8_t exponent[4];\n        int length = 0;\n        do { exponent[length++] = (uint8_t)('0' + magnitude % 10); magnitude /= 10; } while (magnitude != 0);\n        while (length > 0) *p++ = exponent[--length];\n    }\n    return (cee_str){ .ptr = buf, .len = (uint64_t)(p - buf) };\n}\n\nstatic cee_str cee_special(const char *text, uint8_t *buf) {\n    uint64_t length = 0;\n    while (text[length] != '\\0') { buf[length] = (uint8_t)text[length]; length++; }\n    return (cee_str){ .ptr = buf, .len = length };\n}\n\ncee_str ceesafe_format_f64(double value, uint8_t *buf) {\n    uint64_t bits = cee_f64_bits(value);\n    bool negative = (bits >> 63) != 0;\n    uint64_t fraction = bits & ((UINT64_C(1) << 52) - 1);\n    int biased = (int)((bits >> 52) & 0x7FF);\n   ",
