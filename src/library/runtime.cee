// The C runtime ceesafec embeds. GENERATED by tools/gen_runtime.py from runtime/: edit runtime/ and rerun it,
// do not edit this file. Each file is a run of chunks of at most 4,000 bytes,
// since C compilers need accept string literals of only 4,095 (C11 §5.2.4.1).

/// 0 rt.h, 1 the core, 2 hosted, 3 I/O, 4 the float formatter, 5 threads, 6 async, 7 foreign.h, 8 windows.
fn runtimeFileName(k: usize) -> StringView => match (k) {
    0 => "ceesafe/rt.h",
    1 => "ceesafe_rt_core.c",
    2 => "ceesafe_rt_hosted.c",
    3 => "ceesafe_rt_io.c",
    4 => "ceesafe_rt_float.c",
    5 => "ceesafe_rt_thread.c",
    6 => "ceesafe_rt_async.c",
    7 => "ceesafe/foreign.h",
    _ => "ceesafe_rt_window.c",
};

fn runtimeChunkCount(k: usize) -> usize => match (k) {
    0 => 26,
    1 => 6,
    2 => 1,
    3 => 21,
    4 => 15,
    5 => 2,
    6 => 43,
    7 => 1,
    _ => 24,
};

fn runtimeFirstChunk(k: usize) -> usize => match (k) {
    0 => 0,
    1 => 26,
    2 => 32,
    3 => 33,
    4 => 54,
    5 => 69,
    6 => 71,
    7 => 114,
    _ => 115,
};

