        " if (biased == 0x7FF) return cee_special(fraction != 0 ? \"NaN\" : negative ? \"-Infinity\" : \"Infinity\", buf);\n    if (biased != 0) {\n        int mq = 1075 - biased; /* v = c * 2^-mq */\n        uint64_t c = (UINT64_C(1) << 52) | fraction;\n        if (0 < mq && mq < 53) {\n            uint64_t f = c >> mq; /* an integer below 2^53 prints exactly: its digits are the shortest */\n            if (f << mq == c) return cee_layout(negative, (cee_decimal){ f, 0 }, buf);\n        }\n        return cee_layout(negative, cee_to_decimal64(-mq, c), buf);\n    }\n    if (fraction != 0) {\n        return cee_layout(negative, cee_to_decimal64(-1074, fraction), buf);\n    }\n    return cee_special(\"0\", buf); /* both zeros, as ECMAScript prints them */\n}\n\ncee_str ceesafe_format_f32(float value, uint8_t *buf) {\n    uint32_t bits = cee_f32_bits(value);\n    bool negative = (bits >> 31) != 0;\n    uint32_t fraction = bits & ((UINT32_C(1) << 23) - 1);\n    int biased = (int)((bits >> 23) & 0xFF);\n    if (biased == 0xFF) return cee_special(fraction != 0 ? \"NaN\" : negative ? \"-Infinity\" : \"Infinity\", buf);\n    if (biased != 0) {\n        int mq = 150 - biased;\n        uint32_t c = (UINT32_C(1) << 23) | fraction;\n        if (0 < mq && mq < 24) {\n            uint32_t f = c >> mq;\n            if (f << mq == c) return cee_layout(negative, (cee_decimal){ f, 0 }, buf);\n        }\n        return cee_layout(negative, cee_to_decimal32(-mq, c), buf);\n    }\n    if (fraction != 0) {\n        return cee_layout(negative, cee_to_decimal32(-149, fraction), buf);\n    }\n    return cee_special(\"0\", buf);\n}\n",
    101 =>
        "/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */\n/*\n * Threads and mutexes for the hosted profile (type-system.md §38, ADR 0016; the atomics are in ceesafe/rt.h): POSIX threads, Win32 on Windows,\n * or CosmoOS userland's cosmo_thread_* and cosmo_mutex_* (CEE_COSMOOS, set by integrations/cosmoos). Linked only into\n * programs that use them (c-backend.md §6). Thread and mutex memory comes from ceesafe_alloc,\n * so the fault-injection sweep reaches it.\n */\n#if defined(__linux__) && !defined(_GNU_SOURCE)\n/* nanosleep, for the test watchdog (ADR 0049), under glibc's strict C11 headers. */\n#define _GNU_SOURCE\n#endif\n#include \"ceesafe/rt.h\"\n\n#if defined(CEE_COSMOOS)\n#include <cosmo/thread.h>\n#elif defined(_WIN32)\n#define WIN32_LEAN_AND_MEAN\n#include <windows.h>\n#else\n#include <pthread.h>\n#include <time.h>\n#include <unistd.h>\n#endif\n\nstruct cee_thread {\n#if defined(CEE_COSMOOS)\n    cosmo_thread_t thread;\n#elif defined(_WIN32)\n    HANDLE handle;\n#else\n    pthread_t thread;\n#endif\n    void *(*body)(void *);\n    void *arg;\n};\n\n#if defined(_WIN32) && !defined(CEE_COSMOOS)\nstatic DWORD WINAPI ceesafe_thread_entry(LPVOID p) {\n    cee_thread *t = (cee_thread *)p;\n    (void)t->body(t->arg);\n    return 0;\n}\n#endif\n\ncee_thread *ceesafe_thread_start(void *(*body)(void *), void *arg) {\n    cee_thread *t = (cee_thread *)ceesafe_alloc(sizeof *t, CEE_ALLOC_SYSTEM);\n    if (t == NULL) {\n        return NULL;\n    }\n    t->body = body;\n    t->arg = arg;\n#if defined(CEE_COSMOOS)\n    if (cosmo_thread_start(&t->thread, body, arg, 0) != 0) {\n        ceesafe_free(t, CEE_ALLOC_SYSTEM);\n        return NULL;\n    }\n#elif defined(_WIN32)\n    t->handle = CreateThread(NULL, 0, ceesafe_thread_entry, t, 0, NULL);\n    if (t->handle == NULL) {\n        ceesafe_free(t, CEE_ALLOC_SYSTEM);\n        return NULL;\n    }\n#else\n    if (pthread_create(&t->thread, NULL, body, arg) != 0) {\n        ceesafe_free(t, CEE_ALLOC_SYSTEM);\n        return NULL;\n    }\n#endif\n    return t;\n}\n\nvoid ceesafe_thread_join(cee_thread *t) {\n#if defined(CEE_COSMOOS)\n    (void)cosmo_thread_join(&t->thread, NULL);\n#elif defined(_WIN32)\n    (void)WaitForSingleObject(t->handle, INFINITE);\n    (void)CloseHandle(t->handle);\n#else\n    (void)pthread_join(t->thread, NULL);\n#endif\n    ceesafe_free(t, CEE_ALLOC_SYSTEM);\n}\n\n/* ---- Mutexes (type-system.md §38.3): the platform lock, allocated so a Mutex<T> may move ---------------------- */\n\n#if defined(CEE_COSMOOS)\ntypedef cosmo_mutex_t cee_mutex_impl;\n#elif defined(_WIN32)\ntypedef SRWLOCK cee_mutex_impl;\n#else\ntypedef pthread_mutex_t cee_mutex_impl;\n#endif\n\nvoid *ceesafe_mutex_create(void) {\n    cee_mutex_impl *m = (cee_mutex_impl *)ceesafe_alloc(sizeof *m, CEE_ALLOC_SYSTEM);\n    if (m == NULL) {\n        return NULL;\n    }\n#if defined(CEE_COSMOOS)\n    m->state = 0u;\n#elif defined(_WIN32)\n    InitializeSRWLock(m);\n#else\n    if (pthread_mutex_init(m, NULL) != 0) {\n        ceesafe_free(m, CEE_ALLOC_SYSTEM);\n        return NULL;\n    }\n#endif\n    return m;\n}\n\nvoid ceesafe_mutex_lock(void *m) {\n#if defined(CEE_COSMOOS)\n    cosmo_mutex_lock((cee_mutex_impl *)m);\n#elif defined(_WIN32)\n    AcquireSRWLockExclusive((cee_mutex_impl *)m);\n#else\n    (void)pthread_mutex_lock((cee_mutex_impl *)m);\n#endif\n}\n\n/* Takes the lock if no thread holds it (ADR 0112): true if taken. It never waits; the thread that holds the lock\n   gets false too (the platform locks are not recursive). */\nbool ceesafe_mutex_try_lock(void *m) {\n#if defined(CEE_COSMOOS)\n    return cosmo_mutex_trylock((cee_mutex_impl *)m) == 0;\n#elif defined(_WIN32)\n    return TryAcquireSRWLockExclusive((cee_mutex_impl *)m) != 0;\n#else\n    return pthread_mutex_trylock((cee_mutex_impl *)m) == 0;\n#endif\n}\n\nvoid ceesafe_mutex_unlock(void *m) {\n#if defined(CEE_COSMOOS)\n    cosmo_mutex_unlock((cee_mutex_impl *)m);\n#elif defined(_WIN32)\n    ReleaseSRWLockExclusive((cee_mutex_impl *)m);\n#else\n    (void)pthread_mutex_unlock((cee_mutex_impl *)m);\n#endif\n}\n\nvoid ceesafe_mutex_destroy(void *m) {\n#if !define",
    102 =>
        "d(_WIN32) && !defined(CEE_COSMOOS)\n    (void)pthread_mutex_destroy((cee_mutex_impl *)m);\n#endif\n    ceesafe_free(m, CEE_ALLOC_SYSTEM);\n}\n\n/*\n * The lock of OnceLock's initialisers (ADR 0096). A OnceLock holds no lock of its own, so that it needs no\n * allocation and can be a static's initialiser; a thread that finds a cell empty takes this lock, looks again, and\n * runs the initialiser holding it. The owner's identity makes it recursive: an initialiser may fill another\n * OnceLock. The owner is read without the lock, so it is an atomic; only the owner reads or writes the depth.\n */\n#if defined(CEE_COSMOOS)\nstatic cee_mutex_impl cee_once_mutex = {0};\n#elif defined(_WIN32)\nstatic cee_mutex_impl cee_once_mutex = SRWLOCK_INIT;\n#else\nstatic cee_mutex_impl cee_once_mutex = PTHREAD_MUTEX_INITIALIZER;\n#endif\nstatic uint64_t cee_once_owner;\nstatic uint32_t cee_once_depth;\n\n/* The running thread, never 0. */\nstatic uint64_t cee_once_self(void) {\n#if defined(CEE_COSMOOS)\n    /* The thread's id from its thread block (cosmo/thread.h): no system call. One more, so that it is never 0. */\n    return (uint64_t)cosmo_thread_id() + 1u;\n#elif defined(_WIN32)\n    return (uint64_t)GetCurrentThreadId();\n#else\n    return (uint64_t)(uintptr_t)pthread_self();\n#endif\n}\n\nvoid ceesafe_mutex_once_lock(void) {\n    uint64_t self = cee_once_self();\n    if (ceesafe_atomic_load_u64(&cee_once_owner) == self) {\n        cee_once_depth++;\n        return;\n    }\n    ceesafe_mutex_lock(&cee_once_mutex);\n    ceesafe_atomic_store_u64(&cee_once_owner, self);\n    cee_once_depth = 1;\n}\n\nvoid ceesafe_mutex_once_unlock(void) {\n    if (--cee_once_depth == 0) {\n        ceesafe_atomic_store_u64(&cee_once_owner, 0);\n        ceesafe_mutex_unlock(&cee_once_mutex);\n    }\n}\n\n/* The atomics (§38.3, ADR 0021) are static inline in ceesafe/rt.h (ADR 0026). */\n\n/* `ceesafec test`'s timeout (ADR 0049 §8): a detached thread that ends the process with status 124 once `ms` pass,\n   after a line the runner reads. Its own platform thread, so the program's allocation report does not count it. */\n#if defined(CEE_COSMOOS)\nvoid ceesafe_thread_watchdog(uint64_t ms) { (void)ms; }\n#else\nstatic uint64_t cee_watchdog_ms;\n\n#if defined(_WIN32)\nstatic DWORD WINAPI cee_watchdog(LPVOID unused) {\n    (void)unused;\n    Sleep((DWORD)cee_watchdog_ms);\n    static const char line[] = \"ceesafe-test 1 timeout\\n\";\n    ceesafe_platform_write_stderr((const uint8_t *)line, sizeof line - 1u);\n    ExitProcess(124);\n    return 0;\n}\n\nvoid ceesafe_thread_watchdog(uint64_t ms) {\n    if (ms == 0u) {\n        return;\n    }\n    cee_watchdog_ms = ms;\n    HANDLE h = CreateThread(NULL, 0, cee_watchdog, NULL, 0, NULL);\n    if (h != NULL) {\n        CloseHandle(h);\n    }\n}\n#else\nstatic void *cee_watchdog(void *unused) {\n    (void)unused;\n    struct timespec t = {(time_t)(cee_watchdog_ms / 1000u), (long)(cee_watchdog_ms % 1000u) * 1000000L};\n    while (nanosleep(&t, &t) != 0) {\n    }\n    static const char line[] = \"ceesafe-test 1 timeout\\n\";\n    ceesafe_platform_write_stderr((const uint8_t *)line, sizeof line - 1u);\n    _exit(124);\n    return NULL;\n}\n\nvoid ceesafe_thread_watchdog(uint64_t ms) {\n    if (ms == 0u) {\n        return;\n    }\n    cee_watchdog_ms = ms;\n    pthread_t t;\n    if (pthread_create(&t, NULL, cee_watchdog, NULL) == 0) {\n        (void)pthread_detach(t);\n    }\n}\n#endif\n#endif\n",
    103 =>
        "/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */\n/*\n * Async tasks for the hosted profile (type-system.md §40, ADR 0031; c-backend.md §3a and §6). One executor per thread:\n * Async.run's root task and the children its scopes spawn, run in turn from a queue. A task that parks has registered\n * what wakes it: a deadline (lib/std's Timer), a descriptor becoming writable (its console output), or its scope's last\n * child. While no task can run, the executor waits in poll() for the earliest deadline or descriptor. Child tasks and\n * their frames come from ceesafe_alloc, so the fault-injection sweep reaches them. Linked only into programs that call\n * ceesafe_async_* (c-backend.md §6).\n */\n#if defined(CEE_FREESTANDING)\n/* The freestanding executor (ADR 0039): only the portable part below, over the environment's ceesafe_env_* hooks. */\n#include \"ceesafe/rt.h\"\n#else\n#if defined(__APPLE__) && !defined(__APPLE_USE_RFC_3542)\n#define __APPLE_USE_RFC_3542 1 /* IPV6_PKTINFO and IPV6_TCLASS as control messages (ADR 0050) */\n#endif\n#if defined(__linux__) && !defined(_GNU_SOURCE)\n/* ceesafec compiles with -std=c11, under which glibc hides POSIX's clock_gettime and CLOCK_MONOTONIC, and syscall(),\n   which io_uring needs (ADR 0035). (Not on macOS, where such a macro would hide the BSD interfaces instead.) */\n#define _GNU_SOURCE\n#endif\n#include \"ceesafe/rt.h\"\n\n#include <errno.h>\n#include <limits.h>\n#include <stdio.h>\n#include <string.h>\n#include <time.h>\n\n#if defined(_WIN32)\n#define WIN32_LEAN_AND_MEAN\n#include <winsock2.h> /* WSAPoll, WSAEventSelect, and POLLIN/POLLOUT for fd_events */\n#include <ws2tcpip.h> /* sockaddr_in6 (ADR 0044) */\n#include <windows.h>\n#if defined(_MSC_VER)\n#pragma comment(lib, \"ws2_32.lib\")\n#endif\n#elif defined(CEE_COSMOOS)\n/* CosmoOS userland (ADR 0040): no poll, pthreads, sched_yield or fcntl. The executor waits on its own condition\n   variable (cee_wait_cosmoos) and descriptors count as ready, so there is no reactor. */\n#include <cosmo/thread.h>\n#include <unistd.h>\n#define CEE_NO_REACTOR 1\n#define POLLIN 0x001 /* fd_events' two directions, numbered as poll.h numbers them */\n#define POLLOUT 0x004\n#else\n#include <poll.h>\n#include <pthread.h>\n#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__)\n#define CEE_KQUEUE 1\n#include <sys/event.h>\n#elif defined(__linux__)\n#define CEE_EPOLL 1\n#include <sys/epoll.h>\n#if defined(__has_include)\n#if __has_include(<linux/io_uring.h>)\n#define CEE_URING 1\n#include <linux/io_uring.h>\n#include <netinet/in.h>\n#include <sys/eventfd.h>\n#include <sys/mman.h>\n#include <sys/socket.h>\n#include <sys/syscall.h>\n#endif\n#endif\n#endif\n#include <fcntl.h>\n#include <sched.h>\n#include <netinet/in.h> /* in_pktinfo, in6_pktinfo (ADR 0050) */\n#include <sys/socket.h> /* sendmsg (ADR 0045) */\n#include <sys/uio.h>    /* struct iovec, writev */\n#if defined(__linux__)\n#include <netinet/udp.h> /* UDP_SEGMENT (ADR 0050) */\n#if !defined(UDP_SEGMENT)\n#define UDP_SEGMENT 103\n#endif\n#if !defined(SOL_UDP)\n#define SOL_UDP 17\n#endif\n#endif\n#if defined(__linux__)\n#include <signal.h>       /* pthread_sigmask, sigtimedwait: sendfile's SIGPIPE (ADR 0078 §2) */\n#include <sys/sendfile.h> /* sendfile (ADR 0051) */\n#endif\n#include <unistd.h>\n/* Empties a wake pipe, or reads an eventfd's counter, whose value nothing needs: how many bytes, and a failure\n   (EAGAIN: already empty), change nothing. glibc declares read warn_unused_result under _FORTIFY_SOURCE, which\n   Ubuntu's gcc defines at -O2, and gcc does not take a (void) cast as using a result: the result is kept, then\n   dropped, so -Werror builds pass there too. */\nstatic inline void cee_drain(int fd, void *buffer, size_t length) {\n    ssize_t got = read(fd, buffer, length);\n    (void)got;\n}\n#endif\n\n#ifndef PIPE_BUF\n#define PIPE_BUF 512 /* POSIX's minimum (_POSIX_PIPE_BUF) */\n#endif\n#endif /* CEE_FREESTANDING */\n\ntypedef struct cee_task {\n    /* Aligned to 16, so a child's frame after it (CEE_TASK_HEAD) is too",
