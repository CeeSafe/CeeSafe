    0 => "ceesafe/rt.h",
    1 => "ceesafe_rt_core.c",
    2 => "ceesafe_rt_hosted.c",
    3 => "ceesafe_rt_io.c",
    4 => "ceesafe_rt_float.c",
    5 => "ceesafe_rt_thread.c",
    6 => "ceesafe_rt_async.c",
    7 => "ceesafe/foreign.h",
    8 => "ceesafe_rt_window.c",
    _ => "ceesafe/embed.h",
};

