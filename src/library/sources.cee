    148 =>
        "Malformed => 1,\n    DecodeError.TooLarge => 2,\n    DecodeError.Unsupported => 3,\n    DecodeError.ChecksumMismatch => 4,\n    DecodeError.OutOfMemory(_) => 1,\n};\n\n/// The position of the highest set bit of `x`, which is not 0.\n@effects()\nfn zstdHighBit(x: u32) -> u32 => 31 - x.leadingZeros();\n\n// ---------------------------------------------------------------------------------------------------------------\n// Bit streams.\n\n/// A bit stream read backward (RFC 8878 §4.1): from its last byte, whose highest set bit marks where the stream\n/// ends, toward its first byte, most significant bits first. `buf` holds the next bits at its top, below them some of\n/// the stream's following bits, then zeros, so reading past the stream's first bit reads zeros; `count` then falls\n/// below 0. Between two refills a reader takes at most 56 bits.\nstruct ZstdBits {\n    buf: u64;\n    count: i64; // how many of buf's top bits are the stream's next ones\n    at: usize;  // the bytes from `start` to `at` are not in buf yet\n    start: usize;\n\n    /// The stream `data[start..end]`, or null if it is empty or its last byte is 0 (it has no end mark).\n    @effects()\n    fn open(data: Slice<u8>, start: usize, end: usize) -> ZstdBits? {\n        if (end <= start) { return null; }\n        let last = data[end - 1] as u32;\n        if (last == 0) { return null; }\n        let mark = zstdHighBit(last);\n        var bits = ZstdBits { buf: 0, count: mark as i64, at: end - 1, start: start };\n        if (mark > 0) { bits.buf = (last as u64) << (64 - mark); }\n        bits.refill(data);\n        return bits;\n    }\n\n    /// Loads bytes until more than 56 bits are held or the stream has none left: eight at once while eight remain.\n    @effects()\n    fn refill(borrow mut this, data: Slice<u8>) {\n        if (this.count > 56) { return; }\n        if (this.at - this.start >= 8) {\n            let word = data.readLE<u64>(this.at - 8);\n            this.buf = this.buf | (word >> truncate<u32>(this.count));\n            let bytes = truncate<usize>(64 - this.count) / 8;\n            this.at -= bytes;\n            this.count += truncate<i64>(bytes * 8);\n            return;\n        }\n        while (this.count <= 56 && this.at > this.start) {\n            this.at -= 1;\n            this.buf = this.buf | ((data[this.at] as u64) << truncate<u32>(56 - this.count));\n            this.count += 8;\n        }\n    }\n\n    /// The next `n` bits (at most 56), consumed.\n    @effects()\n    fn read(borrow mut this, n: u32) -> u64 {\n        let v = (this.buf >> 1) >> (63 - n);\n        this.buf = this.buf << n;\n        this.count -= n as i64;\n        return v;\n    }\n\n    /// The next `n` bits (1 to 56), not consumed.\n    @effects()\n    fn peek(borrow this, n: u32) -> u64 => (this.buf >> 1) >> (63 - n);\n\n    @effects()\n    fn skip(borrow mut this, n: u32) {\n        this.buf = this.buf << n;\n        this.count -= n as i64;\n    }\n\n    /// Every bit was read, and no more.\n    @effects()\n    fn finished(borrow this) -> bool => this.count == 0 && this.at == this.start;\n\n    /// More bits were read than the stream has.\n    @effects()\n    fn overflowed(borrow this) -> bool => this.count < 0;\n}\n\n/// 32 bits of `data` from bit `bit` on, read forward (the least significant bit of the first byte first), with zeros\n/// past the end.\n@effects()\nfn zstdForward(data: Slice<u8>, bit: usize) -> u32 {\n    let at = bit >> 3;\n    var v: u64 = 0;\n    if (at < data.length && data.length - at >= 8) {\n        v = data.readLE<u64>(at);\n    } else {\n        var k: usize = 0;\n        while (k < 8 && at + k < data.length) {\n            v = v | ((data[at + k] as u64) << truncate<u32>(8 * k));\n            k += 1;\n        }\n    }\n    return truncate<u32>(v >> truncate<u32>(bit & 7));\n}\n\n// ---------------------------------------------------------------------------------------------------------------\n// FSE tables (RFC 8878 §4.1). An entry is a u64: bits 0 to 7 the bits to read for the next state, 8 to 15 the\n// symbol's extra bits, 16 to 31 th",
    149 =>
        "e next state's base, 32 to 63 the symbol's base value (for a table of Huffman\n// weights, the symbol itself).\n\n/// What an FSE table description said: the accuracy log, how many symbols it gave counts for, and its bytes.\nstruct ZstdCounts {\n    log: u32;\n    symbols: usize;\n    used: usize;\n}\n\n/// Reads an FSE table description (RFC 8878 §4.1.1, as libzstd's FSE_readNCount) from the start of `data` into\n/// `norm`: each symbol's normalized count, -1 for a probability below 1. Null if its log is above `maxLog`, its\n/// counts do not add up, it names a symbol above `maxSymbol`, or it is cut short.\n@effects()\nfn zstdNormalized(data: Slice<u8>, maxSymbol: usize, maxLog: u32, norm: SliceMut<i16>) -> ZstdCounts? {\n    if (data.length == 0) { return null; }\n    let log = (zstdForward(data, 0) & 15) + 5;\n    if (log > maxLog) { return null; }\n    var bit: usize = 4;\n    var threshold: i32 = truncate<i32>(1u32 << log);\n    var remaining: i32 = threshold + 1;\n    var nbits: u32 = log + 1;\n    var n: usize = 0;\n    var previous0 = false;\n    while (remaining > 1 && n <= maxSymbol) {\n        if (previous0) {\n            var n0 = n;\n            while ((zstdForward(data, bit) & 3) == 3) {\n                n0 += 3;\n                bit += 2;\n                if (n0 > maxSymbol) { return null; }\n            }\n            n0 += (zstdForward(data, bit) & 3) as usize;\n            bit += 2;\n            if (n0 > maxSymbol) { return null; }\n            while (n < n0) {\n                norm[n] = 0;\n                n += 1;\n            }\n        }\n        let maximum = 2 * threshold - 1 - remaining;\n        let v = zstdForward(data, bit);\n        let low = truncate<i32>(v & truncate<u32>(threshold - 1));\n        var count: i32 = 0;\n        if (low < maximum) {\n            count = low;\n            bit += (nbits - 1) as usize;\n        } else {\n            count = truncate<i32>(v & truncate<u32>(2 * threshold - 1));\n            if (count >