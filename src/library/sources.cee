    34 =>
        "// Isolated tasks (ADR 0175; type-system.md §40.10): what a task set says of a child that trapped, and the critical\n// section a task declares. The bound on running without waiting (ADR 0186; type-system.md §40.11).\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_async_critical_enter() -> *mut void;\n    @effects()\n    fn ceesafe_async_critical_leave(unit: *mut void);\n    @effects()\n    fn ceesafe_async_run_bound(ms: u64, mode: u32) -> bool;\n    @effects()\n    fn ceesafe_async_overruns() -> u64;\n    @effects()\n    fn ceesafe_async_run_slice(ms: u64) -> bool;\n    @effects()\n    fn ceesafe_async_pauses() -> u64;\n}\n\n/// What kind of panic it was: the runtime's kinds (type-system.md §14.5).\npublic enum PanicKind {\n    Overflow,\n    DivideByZero,\n    Shift,\n    Unreachable,\n    Index,\n    Slice,\n    Unwrap,\n    Scratch,\n    UnwrapNull,\n    StringBoundary,\n    ForeignEnum,\n    Length,\n    FloatRange,\n    /// `panic(message)` or a failed `assert`.\n    Explicit,\n    /// A lock that an isolated task held when it trapped was taken (`Mutex.lock`, `AsyncMutex.lock`).\n    Poisoned,\n    /// A task ran past its bound without waiting (`Async.runBound`, `spawnIsolatedBound`; ADR 0186).\n    Overran,\n    /// One this enum has no name for.\n    Other,\n}\n\n/// An isolated child of a task set that trapped and ended alone (`set.spawnIsolated`): what the set's watcher is\n/// sent.\npublic struct TaskCrash {\n    /// The child: what `spawnIsolated` returned for it.\n    public task: u64;\n    /// What the child and the tasks under it held when it trapped, in bytes. It is never freed. 0 where a block's\n    /// size cannot be told (under a host's allocator hook).\n    public leakedBytes: u64;\n    private code: u32;\n\n    /// The panic's kind.\n    public fn kind(borrow this) -> PanicKind => match (this.code) {\n        1 => PanicKind.Overflow,\n        2 => PanicKind.DivideByZero,\n        3 => PanicKind.Shift,\n        4 => PanicKind.Unreachable,\n        5 => PanicKind.Index,\n        6 => PanicKind.Slice,\n        7 => PanicKind.Unwrap,\n        8 => PanicKind.Scratch,\n        9 => PanicKind.UnwrapNull,\n        10 => PanicKind.StringBoundary,\n        11 => PanicKind.ForeignEnum,\n        12 => PanicKind.Length,\n        13 => PanicKind.FloatRange,\n        16 => PanicKind.Explicit,\n        18 => PanicKind.Poisoned,\n        19 => PanicKind.Overran,\n        _ => PanicKind.Other,\n    };\n}\n\n/// A critical section: while this value lives in a task of an isolated unit, a trap in that unit ends the process,\n/// as a trap outside one does.\n///\n/// ```\n/// {\n///     let critical = Critical.enter();\n///     table.word(slot).store(key);        // two steps that must both happen\n///     table.word(slot + 1).store(value);\n/// }\n/// ```\n///\n/// An isolated task that traps leaves what it shared as it was at the trap. A lock it held is poisoned; state it\n/// was changing without one (several atomics that must agree, words of shared memory, anything reached through\n/// `unsafe`) has no such mark, and this is how the code that changes it says so. Outside an isolated task it does\n/// nothing.\n@noncopy\npublic struct Critical {\n    private unit: usize;\n\n    /// Enters a critical section, left when the value is dropped.\n    /// Safety: the runtime only counts.\n    public fn enter() -> Critical => Critical { unit: unsafe { ceesafe_async_critical_enter() } as usize };\n\n    /// Safety: the unit is the one `enter` was given, or none.\n    drop {\n        unsafe { ceesafe_async_critical_leave(this.unit as *mut void); }\n    }\n}\n\n/// What `Async.runBound(ms, mode)` does to a task in no isolated unit that runs past the bound (ADR 0186 §2.4). A task\n/// of an isolated unit is always ended, with `PanicKind.Overran`, as a trap would end it.\npublic enum RunBound {\n    /// It is counted (`Async.overruns()`), a line says so on standard error, and it goes on.\n    Count,\n    /// It panics with `PanicKind.Overran`, which ends the process.\n    Panic,\n}\n\n/// What `Async.runBound` and `Async.overruns` call (type-s",
    35 =>
        "ystem.md §40.11, ADR 0186).\npublic struct AsyncBound {\n    /// The program's bound: how long one resume of a task may run without waiting, in milliseconds; 0 is none. False\n    /// in a build without polls (one not built with `--cflag -DCEE_POLLS=1`), where nothing would see the bound.\n    /// Safety: the runtime records the numbers and starts its monitor thread.\n    public fn runBound(ms: u64, mode: RunBound) -> bool {\n        let code: u32 = match (mode) {\n            RunBound.Count => 0,\n            RunBound.Panic => 1,\n        };\n        return unsafe { ceesafe_async_run_bound(ms, code) };\n    }\n\n    /// How many tasks ran past their bound, ended or not.\n    /// Safety: the runtime only reads its count.\n    public fn overruns() -> u64 => unsafe { ceesafe_async_overruns() };\n\n    /// The slice (ADR 0189): how long one resume of a task of an isolated unit may run before it is paused at its next\n    /// poll and the executor's other tasks run, in milliseconds; 0 (the default) is none. With a bound as well, the\n    /// bound counts the time one resume ran over its slices (ADR 0193). False, and nothing changes, in a build without polls or on a target\n    /// without stack switching (32-bit, freestanding); the interpreter takes it and pauses nothing. A task is also\n    /// paused before its slice ends once its thread has I/O to serve (ADR 0203), except on Windows.\n    /// Safety: the runtime records the number and starts its monitor thread.\n    public fn runSlice(ms: u64) -> bool => unsafe { ceesafe_async_run_slice(ms) };\n\n    /// How many times a task has been paused past its slice.\n    /// Safety: the runtime only reads its count.\n    public fn pauses() -> u64 => unsafe { ceesafe_async_pauses() };\n}\n",
    36 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: the iterator interface (ADR 0086 §2.7). Bundled with ceesafec and part of every package.\n\n/// A source of values, one at a time: `next()` gives each, then null. `for (x in e)` calls it on a struct that has such\n/// a method (the shape is enough, ADR 0074 §2.8), on a type parameter bounded by `Iterator<T>`, and on a\n/// `borrow mut dyn Iterator<T>` or a `Box<dyn Iterator<T>>` (type-system.md §16.4). The item is a parameter, so callers\n/// fix it directly (`I: Iterator<u8>`) and `dyn Iterator<T>` has a table.\npublic interface Iterator<T> {\n    /// The next value, or null when there is none.\n    fn next(borrow mut this) -> T?;\n}\n",
    37 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: memory-mapped I/O (type-system.md §29.2). Bundled with ceesafec and part of every package.\n\n/// A cell read and written only by volatile accesses: a hardware register, or memory shared with a device.\n/// Not Copy: a copy would read the register with an ordinary access, once, instead of each time it is used.\n@noncopy\npublic struct Volatile<T: Copy> {\n    value: T;\n\n    /// Safety: `this.value` is a live, aligned `T` (it is a field), and the read is a single volatile access.\n    public fn read(borrow this) -> T {\n        let p = borrow this.value as *T;\n        return unsafe { p.readVolatile() };\n    }\n\n    /// Safety: as `read`; `borrow mut this` makes the write exclusive.\n    public fn write(borrow mut this, v: T) {\n        let p = borrow mut this.value as *mut T;\n        unsafe { p.writeVolatile(v); }\n    }\n}\n\n/// The address of a memory-mapped `T`, typically a `@repr(C)` struct of `Volatile` registers. Not Copy: two\n/// copies would be two owners of the same registers.\n@noncopy\npublic struct MmioPtr<T> {\n    base: *mut T;\n\n    /// Safety: `address` is mapped, aligned for `T`, and no other `MmioPtr` or reference aliases the registers.\n    public unsafe fn at(address: usize) -> MmioPtr<T> => MmioPtr<T> { base: address as *mut T };\n\n    /// Safety: `at`'s contract makes `base` a live `T` reached only through this value; the result borrows `this`.\n    public fn get(borrow this) -> borrow T => unsafe { Ptr.toBorrow(this.base) };\n\n    /// Safety: as `get`; `borrow mut this` makes the access exclusive.\n    public fn getMut(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.base) };\n\n    /// The address of the registers, as given to `at`.\n    public fn address(borrow this) -> usize => this.base as usize;\n}\n",
    38 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: numbers read from text (ADR 0071 §2.5). Bundled with ceesafec and part of every package. On a `StringView`\n// or a `Slice<u8>`, `s.parseInt<u32>()` is `NumberParsing.parseU32(bytes)`, `s.parseIntRadix<u32>(r)` is\n// `parseU32Radix(bytes, r)` and `s.parseFloat<f64>()` is `parseF64(bytes)`; each gives null for text that is not a\n// number of that type.\n//\n// Floats are correctly rounded (to nearest, ties to even) for every input. Inputs of at most 15 significant digits\n// (7 for f32) with a small exponent take Clinger's fast path: the digits and the power of ten are both exact floats,\n// so one IEEE operation rounds once. Every other input goes through FloatDecimal, an exact decimal that is shifted by\n// powers of two until it is a 54-bit (or 25-bit) integer, then rounded: the \"simple decimal conversion\" of Go's\n// strconv and Wuffs. It never uses the C library, so it does not depend on the locale.\n\n/// Parsing integers and floats from bytes: static functions; the struct has no fields and is never made.\npublic struct NumberParsing {\n    /// The value of a digit in bases up to 36 (`0`–`9`, `a`–`z`, `A`–`Z`), or 99.\n    fn digitValue(b: u8) -> u32 {\n        if (b >= '0' && b <= '9') {\n            return (b - '0') as u32;\n        }\n        if (b >= 'a' && b <= 'z') {\n            return (b - 'a') as u32 + 10;\n        }\n        if (b >= 'A' && b <= 'Z') {\n            return (b - 'A') as u32 + 10;\n        }\n        return 99;\n    }\n\n    /// The digits of `s` from `start` on, in `radix`, or null: none, a byte that is not a digit, or more than a `u64`.\n    fn magnitude(s: Slice<u8>, start: usize, radix: u32) -> u64? {\n        if (radix < 2 || radix > 36 || start >= s.length) {\n            return null;\n        }\n        var n: u64 = 0;\n        for (i in start..s.length) {\n            let d = NumberParsing.digitValue(s[i]);\n            if (d >= radix) {\n                return null;\n            }\n            n = n.checkedMul(radix as u64)?.checkedAdd(d as u64)?;\n        }\n        return n;\n    }\n\n    /// An optional `+`, then digits.\n    fn unsigned(s: Slice<u8>, radix: u32) -> u64? {\n        let start: usize = if (s.length > 0 && s[0] == '+') 1 else 0;\n        return NumberParsing.magnitude(s, start, radix);\n    }\n\n    /// An optional `-` or `+`, then digits, within an `i64`.\n    fn signed(s: Slice<u8>, radix: u32) -> i64? {\n        let negative = s.length > 0 && s[0] == '-';\n        let start: usize = if (s.length > 0 && (s[0] == '-' || s[0] == '+')) 1 else 0;\n        let m = NumberParsing.magnitude(s, start, radix)?;\n        if (negative) {\n            if (m == 0x8000_0000_0000_0000) {\n                return -9223372036854775807 - 1;\n            }\n            if (m > 0x8000_0000_0000_0000) {\n                return null;\n            }\n            return -truncate<i64>(m);\n        }\n        if (m > 0x7FFF_FFFF_FFFF_FFFF) {\n            return null;\n        }\n        return truncate<i64>(m);\n    }\n\n    /// Decimal text as a `u8`.\n    public fn parseU8(s: Slice<u8>) -> u8? => NumberParsing.parseU8Radix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as a `u8`.\n    public fn parseU8Radix(s: Slice<u8>, radix: u32) -> u8? {\n        let v = NumberParsing.unsigned(s, radix)?;\n        let t = truncate<u8>(v);\n        if (t as u64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Decimal text as a `u16`.\n    public fn parseU16(s: Slice<u8>) -> u16? => NumberParsing.parseU16Radix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as a `u16`.\n    public fn parseU16Radix(s: Slice<u8>, radix: u32) -> u16? {\n        let v = NumberParsing.unsigned(s, radix)?;\n        let t = truncate<u16>(v);\n        if (t as u64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Decimal text as a `u32`.\n    public