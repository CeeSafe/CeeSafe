        "ild)!;\n            this.nodes[child].parent = left;\n        }\n        this.release(right);\n        if (parent == this.root && this.nodes[parent].keys.length == 0) {\n            this.root = left;\n            this.nodes[left].parent = null;\n            this.release(parent);\n        }\n    }\n\n    /// Makes `parent`'s child `i` hold at least B entries before a removal descends into it: it borrows an entry\n    /// through `parent` from a sibling that can spare one, else merges with a sibling. The node to descend into.\n    fn fill(borrow mut this, parent: usize, i: usize) -> usize {\n        let child = this.nodes[parent].children[i];\n        let fewest = OrderedMap<K, V>.fewest();\n        if (this.nodes[child].keys.length > fewest) {\n            return child;\n        }\n        let last = this.nodes[parent].children.length - 1;\n        if (i > 0 && this.nodes[this.nodes[parent].children[i - 1]].keys.length > fewest) {\n            // From the left sibling: its last entry up into `parent`, the entry between them down to `child`'s front.\n            let left = this.nodes[parent].children[i - 1];\n            let key = this.nodes[left].keys.pop()!;\n            let value = this.nodes[left].values.pop()!;\n            orderedExchange(mut this.nodes[parent].keys, i - 1, key);\n            let down = this.nodes[parent].keys.pop()!;\n            orderedExchange(mut this.nodes[parent].values, i - 1, value);\n            let downValue = this.nodes[parent].values.pop()!;\n            orderedInsert(mut this.nodes[child].keys, 0, down);\n            orderedInsert(mut this.nodes[child].values, 0, downValue);\n            if (!this.nodes[left].isLeaf()) {\n                let moved = this.nodes[left].children.pop()!;\n                orderedInsert(mut this.nodes[child].children, 0, moved);\n                this.nodes[moved].parent = child;\n            }\n            return child;\n        }\n        if (i < last && this.nodes[this.nodes[parent].children[i + 1]].keys.length > fewest) {\n            // From the right sibling: its first entry up into `parent`, the entry between them down to `child`'s end.\n            let right = this.nodes[parent].children[i + 1];\n            orderedToEnd(mut this.nodes[right].keys, 0);\n            let key = this.nodes[right].keys.pop()!;\n            orderedToEnd(mut this.nodes[right].values, 0);\n            let value = this.nodes[right].values.pop()!;\n            orderedExchange(mut this.nodes[parent].keys, i, key);\n            let down = this.nodes[parent].keys.pop()!;\n            orderedExchange(mut this.nodes[parent].values, i, value);\n            let downValue = this.nodes[parent].values.pop()!;\n            this.nodes[child].keys.push(down)!;\n            this.nodes[child].values.push(downValue)!;\n            if (!this.nodes[right].isLeaf()) {\n                orderedToEnd(mut this.nodes[right].children, 0);\n                let moved = this.nodes[right].children.pop()!;\n                this.nodes[child].children.push(moved)!;\n                this.nodes[moved].parent = child;\n            }\n            return child;\n        }\n        if (i < last) {\n            this.merge(parent, i);\n            return child;\n        }\n        let left = this.nodes[parent].children[i - 1];\n        this.merge(parent, i - 1);\n        return left;\n    }\n\n    /// Takes the greatest entry of the subtree at `node` (which holds at least B entries, or is the root) out and puts\n    /// it in `into`'s slot `slot`: the value that was there.\n    fn replaceWithLast(borrow mut this, node: usize, into: usize, slot: usize) -> V {\n        var at = node;\n        while (!this.nodes[at].isLeaf()) {\n            at = this.fill(at, this.nodes[at].children.length - 1);\n        }\n        let key = this.nodes[at].keys.pop()!;\n        let value = this.nodes[at].values.pop()!;\n        return this.exchange(into, slot, key, value);\n    }\n\n    /// Puts `key` and `value` in `node`'s slot `slot`: the value that was there (the key is dropped).\n    fn exchange(borrow mut this, node: u",
