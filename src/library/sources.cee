  fn pushed(result: Result<void, AllocError>) -> Result<void, IoError> => match (result) {\n        Ok() => Ok(),\n        Err(_) => Err(IoError.OutOfMemory),\n    };\n\n    /// The whole file's bytes.\n    fn readAll(path: StringView) -> Result<Vector<u8>, IoError> {\n        var file = File.open(path)?;\n        var bytes = Vector<u8>.create();\n        var buffer = [0u8; 65536];\n        loop {\n            let n = file.read(mut buffer[..])?;\n            if (n == 0) {\n                break;\n            }\n            for (i in 0..n) {\n                match (bytes.push(buffer[i])) {\n                    Ok() => {}\n                    Err(_) => { return Err(IoError.OutOfMemory); }\n                }\n            }\n        }\n        return Ok(bytes);\n    }\n\n    /// Byte-wise order of two strings: negative, zero or positive.\n    fn compareText(a: borrow String, b: borrow String) -> i32 {\n        let n = if (a.length < b.length) a.length else b.length;\n        for (i in 0..n) {\n            if (a[i] != b[i]) {\n                return if (a[i] < b[i]) -1 else 1;\n            }\n        }\n        return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;\n    }\n\n    /// The IoError for a negated errno from the runtime (its kinds are CEE_IO_* in rt.h, in IoError's variant order).\n    /// Safety: ceesafe_io_kind only classifies the number.\n    fn hostError(code: i64) -> IoError {\n        let error = truncate<i32>(0 - code);\n        return match (unsafe { ceesafe_io_kind(error) }) {\n            0 => IoError.NotFound,\n            1 => IoError.PermissionDenied,\n            2 => IoError.AlreadyExists,\n            3 => IoError.IsDirectory,\n            4 => IoError.NotDirectory,\n            5 => IoError.InvalidInput,\n            6 => IoError.BrokenPipe,\n            7 => IoError.ConnectionRefused,\n            8 => IoError.AddressInUse,\n            9 => IoError.OutOfMemory,\n            11 => IoError.ConnectionReset,\n            12 =