      }\n                ZstdMode.Raw => {\n                    let left = this.blockSize - this.blockFill;\n                    let n = if (left < input.length - at) left else input.length - at;\n                    if (n == 0) { break; }\n                    let p = this.pos;\n                    this.ring[p..p + n].copyFrom(input[at..at + n]);\n                    at += n;\n                    this.blockFill += n;\n                    this.wrote(p, n);\n                    if (this.blockFill == this.blockSize) { this.endBlock(); }\n                }\n                ZstdMode.Rle => {\n                    if (at >= input.length) { break; }\n                    let p = this.pos;\n                    let n = this.blockSize;\n                    this.ring[p..p + n].fill(input[at]);\n                    at += 1;\n                    this.wrote(p, n);\n                    this.endBlock();\n                }\n                ZstdMode.Compressed => {\n                    let size = this.blockSize;\n                    var r: Result<usize, DecodeError> = Ok(0);\n                    if (this.blockFill == 0 && input.length - at >= size) {\n                        r = this.decodeBlock(input[at..at + size]);\n                        at += size;\n                    } else {\n                        let n = if (size - this.blockFill < input.length - at) size - this.blockFill\n                            else input.length - at;\n                        this.blockIn[this.blockFill..this.blockFill + n].copyFrom(input[at..at + n]);\n                        at += n;\n                        this.blockFill += n;\n                        if (this.blockFill < size) { break; }\n                        r = this.decodeGathered();\n                    }\n                    match (r) {\n                        Ok(end) => {\n                            let p = this.pos;\n                            this.wrote(p, end - p);\n                        }\n                        Err(e) => { retu