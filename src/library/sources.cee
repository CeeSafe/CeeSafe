h: u64, error: *mut i32) -> *mut void;\n    @effects(sleep)\n    fn ceesafe_host_dir_next(dir: *mut void, name: *mut (*u8), length: *mut u64) -> i64;\n    @effects(sleep)\n    fn ceesafe_host_dir_close(dir: *mut void);\n    @effects(sleep)\n    fn ceesafe_host_temporary(buffer: *mut u8, capacity: u64) -> i64;\n    @effects(sleep)\n    fn ceesafe_host_current(buffer: *mut u8, capacity: u64) -> i64;\n    @effects(sleep, alloc)\n    fn ceesafe_host_spawn(\n        arguments: *void,\n        count: u64,\n        input: *u8,\n        inputLength: u64,\n        output: *u8,\n        outputLength: u64,\n        errors: *u8,\n        errorsLength: u64,\n    ) -> i64;\n    @effects()\n    fn ceesafe_io_kind(error: i32) -> u32;\n}\n\n/// What is at a path (`File.kind`, type-system.md §26.8).\npublic enum PathKind {\n    File,\n    Directory,\n    Other,\n}\n\n/// A finished program's exit status and what it wrote (`Process.capture`, type-system.md §26.7).\npublic struct ProcessOutput {\n    /// The exit status, or 128 plus the signal that ended it, as `Process.run` reports it.\n    public status: i32;\n    public stdout: Vector<u8>;\n    public stderr: Vector<u8>;\n}\n\n/// The environment the program started with (type-system.md §26.9).\npublic struct Environment {\n    /// The value of the variable `name` as static text, or null if it is not set or not valid UTF-8.\n    /// Safety: the runtime returns getenv's text, which stays valid and unchanged: CeeSafe has no way to change the\n    /// environment (C code that calls setenv breaks this, as it does in C).\n    public fn variable(name: StringView) -> StringView? {\n        var value = 0 as *u8;\n        var length: u64 = 0;\n        let found = unsafe { ceesafe_host_env(\n            name.ptr,\n            name.length as u64,\n            borrow mut value as *mut (*u8),\n            borrow mut length as *mut u64,\n        ) };\n        if (found != 1) {\n            return null;\n        }\n        let bytes = unsafe { Sli