4, to.ptr, to.length as u64) };\n        return if (result < 0) Err(HostServices.hostError(result)) else Ok();\n    }\n\n    /// Safety: `texts` holds a view per argument and outlives the call; the runtime reads it and the paths during\n    /// the call only.\n    fn captureIn(\n        directory: StringView,\n        program: StringView,\n        arguments: borrow Vector<StringView>,\n        input: Slice<u8>?,\n    ) -> Result<ProcessOutput, IoError> {\n        let inPath = HostServices.stringOrIoError(HostServices.pathIn(directory, \"in\"))?;\n        let outPath = HostServices.stringOrIoError(HostServices.pathIn(directory, \"out\"))?;\n        let errPath = HostServices.stringOrIoError(HostServices.pathIn(directory, \"err\"))?;\n        var file = File.create(inPath.view())?;\n        match (input) {\n            Some(bytes) => { file.write(bytes)?; }\n            null => {}\n        }\n        var texts = Vector<HostServicesText>.create();\n        HostServices.pushed(texts.push(unsafe { HostServicesText { ptr: program.ptr, len: program.length as u64 } }))?;\n        for (argument in arguments) {\n            HostServices.pushed(\n                texts.push(unsafe { HostServicesText { ptr: argument.ptr, len: argument.length as u64 } }),\n            )?;\n        }\n        let status = unsafe { ceesafe_host_spawn(\n            texts.view().ptr as *void,\n            texts.length as u64,\n            inPath.view().ptr,\n            inPath.length as u64,\n            outPath.view().ptr,\n            outPath.length as u64,\n            errPath.view().ptr,\n            errPath.length as u64,\n        ) };\n        if (status < 0) {\n            return Err(HostServices.hostError(status));\n        }\n        return Ok(\n            ProcessOutput {\n                status: truncate<i32>(status),\n                stdout: HostServices.readAll(outPath.view())?,\n                stderr: HostServices.readAll(errPath.view())?,\n            },\n        );\n    }\n\n    /// 