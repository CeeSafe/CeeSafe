an the buffer (the rest is gone).\npublic struct Datagram {\n    public length: usize;\n    public from: SocketAddress;\n    public truncated: bool;\n}\n\n/// What `AsyncUdpSocket.recvMsg` gives (ADR 0050 §3.1).\npublic struct UdpReceived {\n    /// The bytes in the buffer.\n    public length: usize;\n    /// The datagram was longer than the buffer; the rest is gone.\n    public truncated: bool;\n    public from: SocketAddress;\n    /// The local address it arrived at, with the socket's port (with `receiveLocal`; else null).\n    public to: SocketAddress?;\n    /// Its ECN bits, 0 to 3 (with `receiveEcn`; else 0).\n    public ecn: u8;\n}\n\n/// A datagram for `AsyncUdpSocket.sendMsg` (ADR 0050 §3.1): its parts (ADR 0045), where it goes, and optionally the\n/// local address it leaves from, its ECN bits and a segment size.\npublic struct UdpMessage<region r> {\n    public parts: IoParts<r>;\n    public to: SocketAddress;\n    /// The source address (IP_PKTINFO); null: the system's choice.\n    public from: SocketAddress?;\n    /// 0: not set.\n    public ecn: u8;\n    /// 0: one datagram; else the parts are sent as datagrams of this many bytes, the last one shorter.\n    public segmentSize: u16;\n}\n\n/// Name resolution for tasks (ADR 0048).\npublic struct AsyncDns {\n    /// The addresses of `host`, each with `port`: both families, in the resolver's order, duplicates removed, never\n    /// empty. A literal address is itself, at once. Otherwise the system's resolver runs on one of at most four\n    /// resolver threads while the task waits; a cancelled task returns `Err(Cancelled)` at once, and the lookup is left\n    /// to its thread. Errors are `AsyncError.Io`: `HostNotFound` (no such name, or no address for it; ADR 0060),\n    /// `TimedOut` (a temporary failure: try again), `InvalidInput` (an empty name, one over 253 bytes or with a NUL),\n    /// `OutOfMemory`, `Unsupported` (no resolver: CosmoOS, the interpreter for names other than `localhost` and the\n    /// reserved `.invalid` ones).\n    /// Safety: the runtime copies the name during the start; the l",
    187 =>
        "ookup's record is the runtime's, ended once by\n    /// `DnsLookup`'s drop, so no path leaves it or ends it twice.\n    public async fn resolve(host: StringView, port: u16) -> Result<Vector<SocketAddress>, AsyncError> {\n        var out = Vector<SocketAddress>.create();\n        match (SocketAddresses.parseIp(host, port)) {\n            Some(address) => {\n                match (out.push(address)) {\n                    Ok() => { return Ok(out); }\n                    Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }\n                }\n            }\n            null => {}\n        }\n        let name = host.bytes();\n        var plain = name.length > 0 && name.length <= 253;\n        for (b in name) {\n            if (b == 0) {\n                plain = false;\n            }\n        }\n        if (!plain) {\n            return Err(AsyncError.Io(IoError.InvalidInput));\n        }\n        let raw = unsafe { ceesafe_dns_start(name.ptr, name.length as u64, port) };\n        if (raw.isNull()) {\n            return Err(AsyncError.Io(IoError.OutOfMemory));\n        }\n        let lookup = DnsLookup { raw: raw };\n        loop {\n            AsyncLeaf.status()?; // cancelled: the drop leaves the lookup to its thread\n            let r = unsafe { ceesafe_dns_poll(lookup.raw) };\n            if (r == 1) {\n                break;\n            }\n            if (r < 0) {\n                return Err(AsyncError.Io(AsyncIo.ioError(r as i64)));\n            }\n            await Async.park();\n        }\n        let count = unsafe { ceesafe_dns_count(lookup.raw) };\n        for (k in 0..count) {\n            var bytes = [0u8; 16];\n            var family: u32 = 0;\n            var scope: u32 = 0;\n            unsafe {\n                ceesafe_dns_address(\n                    lookup.raw,\n                    k,\n                    borrow mut bytes as *mut [u8; 16] as *mut u8,\n                    borrow mut family as *mut u32,\n                    borrow mut scope as *mut u32,\n                );\n            }\n            let address = if (family == 4) SocketAddress.V4(\n                [bytes[0], bytes[1], bytes[2], bytes[3]],\n                port,\n            ) else SocketAddress.V6(bytes, port, scope);\n            match (out.push(address)) {\n                Ok() => {}\n                Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }\n            }\n        }\n        return Ok(out);\n    }\n}\n\n/// A lookup the runtime holds (ADR 0048 §3.3), ended exactly once, here.\n@noncopy\nstruct DnsLookup {\n    raw: *mut void;\n\n    /// Safety: the record is this lookup's, and ended only here.\n    drop {\n        unsafe { ceesafe_dns_end(this.raw); }\n    }\n}\n",
    188 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// OrderedMap<K, V> (ADR 0075 §2.4): a B-tree over an arena of nodes linked by index, in safe CeeSafe, and its keys' OrderKey.\n\n/// A key of an OrderedMap (ADR 0075 §2.4): `K: OrderKey<K>`, since an interface has no `Self`. The order must be total\n/// and consistent: `a.compareKey(b)` is negative, zero or positive as `b.compareKey(a)` is positive, zero or negative.\npublic interface OrderKey<K> {\n    /// Negative if this key comes before `other`, zero if it is the same key, positive if it comes after.\n    fn compareKey(borrow this, other: borrow K) -> i32;\n}\n\nimpl OrderKey<u8> for u8 {\n    fn compareKey(borrow this, other: borrow u8) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<u16> for u16 {\n    fn compareKey(borrow this, other: borrow u16) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<u32> for u32 {\n    fn compareKey(borrow this, other: borrow u32) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<u64> for u64 {\n    fn compareKey(borrow this, other: borrow u64) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<usize> for usize {\n    fn compareKey(borrow this, other: borrow usize) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i8> for i8 {\n    fn compareKey(borrow this, other: borrow i8) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i16> for i16 {\n    fn compareKey(borrow this, other: borrow i16) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i32> for i32 {\n    fn compareKey(borrow this, other: borrow i32) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i64> for i64 {\n    fn compareKey(borrow this, other: borrow i64) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<isize> for isize {\n    fn compareKey(borrow this, other: borrow isize) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<bool> for bool {\n    /// `false` before `true`.\n    fn compareKey(borrow this, other: borrow bool) -> i32 => if (this == other) 0 else if (this) 1 else -1;\n}\n\nimpl OrderKey<String> for String {\n    /// Bytewise (UTF-8, so code point order), a prefix before the longer text.\n    fn compareKey(borrow this, other: borrow String) -> i32 => orderBytes(this.view().bytes(), other.view().bytes());\n}\n\nimpl OrderKey<Vector<u8>> for Vector<u8> {\n    /// Bytewise, a prefix before the longer vector.\n    fn compareKey(borrow this, other: borrow Vector<u8>) -> i32 => orderBytes(this.view(), other.view());\n}\n\nimpl OrderKey<ByteString> for ByteString {\n    /// Bytewise, a prefix before the longer text (ADR 0231).\n    fn compareKey(borrow this, other: borrow ByteString) -> i32 => this.view().compare(other.view());\n}\n\n/// `a.compareKey(b)`: what a derived `compareKey` does for each field (ADR 0087 §2.3). A field type without an\n/// `OrderKey` is N0268 at the `@derive`.\npublic fn deriveCompare<K: OrderKey<K>>(a: borrow K, b: borrow K) -> i32 => a.compareKey(b);\n\n/// The bytewise order of `a` and `b`, a prefix first.\nfn orderBytes(a: Slice<u8>, b: Slice<u8>) -> i32 {\n    let n = if (a.length < b.length) a.length else b.length;\n    for (k in 0..n) {\n        if (a[k] != b[k]) {\n            return if (a[k] < b[k]) -1 else 1;\n        }\n    }\n    return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;\n}\n\n/// A node of an OrderedMap: its entries in key order and, unless it is a leaf, one more child than entries. Its\n/// vectors are allocated once, with room for one entry more than a node holds, so nothing in a node allocates after\n/// that.\nstruct OrderedNode<K, V> {\n    keys: Vector<K>;\n    values: Vector<V>;\n    children: Vector<usize>; // empty for a leaf\n    parent: usize?;          // null for the root; for a free node, the next free one\n\n    fn isLeaf(b",
    189 =>
        "orrow this) -> bool => this.children.length == 0;\n}\n\n// The shifts within a node, in one place to replace with `Vector.insert` and `remove` (ADR 0075 §2.12). A node's\n// vectors are made with room for one element more than it holds, so the pushes never allocate and cannot fail. A\n// removal moves the element to the end and the caller pops it: a generic function that returned the element would tie\n// it to the vector's loan (type-system.md §25.6), and the map could not store it again.\n\n/// Puts `x` at `at`, moving the elements from `at` on up by one.\nfn orderedInsert<T>(v: borrow mut Vector<T>, at: usize, x: T) {\n    v.push(x)!;\n    var k = v.length - 1;\n    while (k > at) {\n        v.swap(k - 1, k);\n        k -= 1;\n    }\n}\n\n/// Moves the element at `at` to the end, the later ones down by one, so that a `pop` takes it out.\nfn orderedToEnd<T>(v: borrow mut Vector<T>, at: usize) {\n    for (k in at..(v.length - 1)) {\n        v.swap(k, k + 1);\n    }\n}\n\n/// Puts `x` at `at` and the element that was there at the end, so that a `pop` takes it out.\nfn orderedExchange<T>(v: borrow mut Vector<T>, at: usize, x: T) {\n    v.push(x)!;\n    let last = v.length - 1;\n    v.swap(at, last);\n}\n\n/// Reverses `v` in place.\nfn orderedReverse<T>(v: borrow mut Vector<T>) {\n    if (v.length < 2) {\n        return;\n    }\n    var i: usize = 0;\n    var j = v.length - 1;\n    while (i < j) {\n        v.swap(i, j);\n        i += 1;\n        j -= 1;\n    }\n}\n\n/// A position in an OrderedMap: a node, a slot in it, and the map's version when the cursor was made. A cursor is\n/// read through its map (`keyAt`, `valueAt`); one used after the map changed panics.\npublic struct OrderedCursor {\n    node: usize;\n    slot: usize;\n    version: u64;\n}\n\n/// A map whose iteration order is its keys' order (ADR 0075 §2.4): a B-tree of minimum degree 16 (at most 31 entries\n/// a node), its nodes in one arena vector and linked by index, so it needs no `unsafe`. A put past the last key or\n/// before the first splits the full nodes on its path unevenly, 29 entries to 1 with the one on the key's side (ADR\n/// 0194 §2.4), so a map loaded in key order, either way, ends up nearly full rather than half empty. Ordered access is through\n/// cursors (`first`, `last`, `seek`, `seekAfter`, `next`, `previous`); a put, a removal or a clear changes the map's\n/// version, and a cursor made before it panics when used (\"ordered map changed under a cursor\"). Only `put`\n/// allocates; a failed `put` leaves the map as it was.\npublic struct OrderedMap<K: OrderKey<K>, V> {\n    nodes: Vector<OrderedNode<K, V>>; // the arena; nodes[root] is the root once a put made it\n    root: usize;\n    free: usize?; // the first free node, the others linked by `parent`\n    spare: usize; // how many nodes are free\n    count: usize;\n    version: u64;\n\n    /// An empty map. It allocates nothing until the first put.\n    public fn create() -> OrderedMap<K, V> => OrderedMap {\n        nodes: Vector<OrderedNode<K, V>>.create(),\n        root: 0,\n        free: null,\n        spare: 0,\n        count: 0,\n        version: 0,\n    };\n\n    /// How many entries.\n    public fn length(borrow this) -> usize => this.count;\n\n    /// Whether there are none.\n    public fn isEmpty(borrow this) -> bool => this.count == 0;\n\n    // The most entries a node holds (2B − 1, B = 16), the fewest a node holds (B − 1) other than the root and the\n    // nodes on the tree's first and last paths, which hold at least one (ADR 0194 §2.4), and the room each node's\n    // vectors are made with: one entry and one child more, for the shifts.\n    fn most() -> usize => 31;\n    fn fewest() -> usize => 15;\n\n    /// The first slot of `node` whose key is not before `key`, and whether that key is `key`.\n    fn lowerBound(borrow this, node: usize, key: borrow K, found: borrow mut bool) -> usize {\n        let keys = borrow this.nodes[node].keys;\n        var lo: usize = 0;\n        var hi = keys.length;\n        while (lo < hi) {\n            let mid = lo + (hi - lo) / 2;",
