public fn programTitleBar(borrow this) -> bool => unsafe { ceesafe_window_program_title_bar(this.raw) } != 0;\n\n    /// Where the system's own buttons are in the program's title bar (ADR 0206), with their margins: on macOS the\n    /// traffic lights, which stay the system's, centered in the bar's height. A program leaves that area clear and\n    /// draws no minimize, maximize or close of its own then. 0 by 0 where the program draws them (Wayland, Windows,\n    /// X11) and for a window with the system's title bar. A change of it is a `Resized`.\n    /// Safety: the runtime writes the four numbers.\n    public fn systemButtons(borrow this) -> WindowArea {\n        var area = [0.0f32; 4];\n        unsafe { ceesafe_window_system_buttons(this.raw, borrow mut area[0] as *mut f32); }\n        return WindowArea { x: area[0], y: area[1], width: area[2], height: area[3] };\n    }\n\n    /// The program's title bar as it is drawn now (ADR 0206): given whenever its layout changes. The runtime moves,\n    /// maximizes and shows the window menu for presses in the bar outside its buttons, and resizes by the edges.\n    /// Safety: the runtime copies the seventeen numbers during the call only.\n    public fn setTitleBar(borrow mut this, bar: WindowTitleBar) {\n        let values = [\n            bar.height,\n            bar.minimize.x, bar.minimize.y, bar.minimize.width, bar.minimize.height,\n            bar.maximize.x, bar.maximize.y, bar.maximize.width, bar.maximize.height,\n            bar.close.x, bar.close.y, bar.close.width, bar.close.height,\n            bar.menu.x, bar.menu.y, bar.menu.width, bar.menu.height,\n        ];\n        unsafe { ceesafe_window_set_title_bar(this.raw, values[..].ptr); }\n    }\n\n    /// Minimizes the window, where the system lets a program do it (ADR 0206).\n    /// Safety: the runtime only asks the system.\n    public fn minimize(borrow mut this) {\n        unsafe { ceesafe_window_minimize(this.raw); }\n    }\n\n    /// Maximizes the window,