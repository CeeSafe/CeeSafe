     return t;\n    }\n\n    /// Decimal text as an `i32`.\n    public fn parseI32(s: Slice<u8>) -> i32? => NumberParsing.parseI32Radix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as an `i32`.\n    public fn parseI32Radix(s: Slice<u8>, radix: u32) -> i32? {\n        let v = NumberParsing.signed(s, radix)?;\n        let t = truncate<i32>(v);\n        if (t as i64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Decimal text as an `i64`.\n    public fn parseI64(s: Slice<u8>) -> i64? => NumberParsing.parseI64Radix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as an `i64`.\n    public fn parseI64Radix(s: Slice<u8>, radix: u32) -> i64? {\n        let v = NumberParsing.signed(s, radix)?;\n        let t = truncate<i64>(v);\n        if (t as i64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Decimal text as an `isize`.\n    public fn parseIsize(s: Slice<u8>) -> isize? => NumberParsing.parseIsizeRadix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as an `isize`.\n    public fn parseIsizeRadix(s: Slice<u8>, radix: u32) -> isize? {\n        let v = NumberParsing.signed(s, radix)?;\n        let t = truncate<isize>(v);\n        if (t as i64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Whether `s` from `at` on is `word`, ignoring ASCII case.\n    fn isWord(s: Slice<u8>, at: usize, word: StringView) -> bool {\n        if (s.length - at != word.length) {\n            return false;\n        }\n        for (k in 0..word.length) {\n            let b = s[at + k];\n            let lower = if (b >= 'A' && b <= 'Z') b + 32 else b;\n            if (lower != word[k]) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    /// Text as an `f64`, correctly rounded, or null. `[+-]digits[.digits][(e|E)[+-]digits]` with a digit on at least one\n    /// side of the point, or `inf`, `infinity` or `nan` in any case, with an optional sign. Too large is ±infinity.\n    public fn parseF64(s: Slice<u8>) -> f64? {\n        let bits = NumberPa",
