    41 =>
        "    i += 1;\n        }\n        return null;\n    }\n\n    /// Whether the bytes of `a` from `at` on begin with `b`.\n    fn matchesAt(a: Slice<u8>, at: usize, b: Slice<u8>) -> bool {\n        if (at > a.length || a.length - at < b.length) {\n            return false;\n        }\n        for (k in 0..b.length) {\n            if (a[at + k] != b[k]) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    /// Where `needle` first is in `s`: its first byte by indexOfByte, then the rest compared. Empty: 0.\n    fn indexOf(s: Slice<u8>, needle: Slice<u8>) -> usize? {\n        let n = needle.length;\n        if (n == 0) {\n            return 0;\n        }\n        if (n > s.length) {\n            return null;\n        }\n        let last = s.length - n; // the last start a match can have\n        let first = needle[0];\n        var i: usize = 0;\n        while (i <= last) {\n            let window = s[i..last + 1];\n            match (ByteScan.indexOfByte(window, first)) {\n                Some(k) => {\n                    i += k;\n                }\n                null => {\n                    return null;\n                }\n            }\n            if (ByteScan.matchesAt(s, i, needle)) {\n                return i;\n            }\n            i += 1;\n        }\n        return null;\n    }\n\n    /// Where `needle` last is in `s`. Empty: `s.length`.\n    fn lastIndexOf(s: Slice<u8>, needle: Slice<u8>) -> usize? {\n        let n = needle.length;\n        if (n > s.length) {\n            return null;\n        }\n        var i = s.length - n;\n        while (true) {\n            if (ByteScan.matchesAt(s, i, needle)) {\n                return i;\n            }\n            if (i == 0) {\n                return null;\n            }\n            i -= 1;\n        }\n        return null;\n    }\n\n    fn startsWith(s: Slice<u8>, prefix: Slice<u8>) -> bool => ByteScan.matchesAt(s, 0, prefix);\n\n    fn endsWith(s: Slice<u8>, suf