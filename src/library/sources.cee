ut Window,\n        kind: i32,\n        title: StringView,\n        name: StringView,\n        extensions: StringView,\n        out: borrow mut Vector<String>,\n    ) -> Result<void, WindowError> {\n        var answer = 0 as *u8;\n        let length = unsafe { ceesafe_window_dialog(\n            window.raw,\n            kind,\n            title.ptr,\n            title.length as u64,\n            name.ptr,\n            name.length as u64,\n            extensions.ptr,\n            extensions.length as u64,\n            borrow mut answer as *mut (*u8),\n        ) };\n        if (length < 0) {\n            return Err(Window.errorOf(truncate<i32>(0 - length)));\n        }\n        if (length == 0) {\n            return Ok();\n        }\n        let bytes = unsafe { Slice.fromRaw(answer, truncate<usize>(length)) };\n        var start: usize = 0;\n        for (k in 0..bytes.length) {\n            if (bytes[k] == 0) {\n                let path = match (StringView.fromUtf8(bytes[start..k])) {\n                    Some(p) => p,\n                    null => { return Err(WindowError.Unsupported); }\n                };\n                let copy = match (String.from(path)) {\n                    Ok(c) => c,\n                    Err(_) => { return Err(WindowError.Resources); }\n                };\n                match (out.push(copy)) {\n                    Ok() => {}\n                    Err(_) => { return Err(WindowError.Resources); }\n                }\n                start = k + 1;\n            }\n        }\n        return Ok();\n    }\n}\n",
