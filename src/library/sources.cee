an the buffer (the rest is gone).\npublic struct Datagram {\n    public length: usize;\n    public from: SocketAddress;\n    public truncated: bool;\n}\n\n/// What `AsyncUdpSocket.recvMsg` gives (ADR 0050 §3.1).\npublic struct UdpReceived {\n    /// The bytes in the buffer.\n    public length: usize;\n    /// The datagram was longer than the buffer; the rest is gone.\n    public truncated: bool;\n    public from: SocketAddress;\n    /// The local address it arrived at, with the socket's port (with `receiveLocal`; else null).\n    public to: SocketAddress?;\n    /// Its ECN bits, 0 to 3 (with `receiveEcn`; else 0).\n    public ecn: u8;\n}\n\n/// A datagram for `AsyncUdpSocket.sendMsg` (ADR 0050 §3.1): its parts (ADR 0045), where it goes, and optionally the\n/// local address it leaves from, its ECN bits and a segment size.\npublic struct UdpMessage<region r> {\n    public parts: IoParts<r>;\n    public to: SocketAddress;\n    /// The source address (IP_PKTINFO); null: the system's choice.\n    public from: SocketAddress?;\n    /// 0: not set.\n    public ecn: u8;\n    /// 0: one datagram; else the parts are sent as datagrams of this many bytes, the last one shorter.\n    public segmentSize: u16;\n}\n\n/// Name resolution for tasks (ADR 0048).\npublic struct AsyncDns {\n    /// The addresses of `host`, each with `port`: both families, in the resolver's order, duplicates removed, never\n    /// empty. A literal address is itself, at once. Otherwise the system's resolver runs on one of at most four\n    /// resolver threads while the task waits; a cancelled task returns `Err(Cancelled)` at once, and the lookup is left\n    /// to its thread. Errors are `AsyncError.Io`: `HostNotFound` (no such name, or no address for it; ADR 0060),\n    /// `TimedOut` (a temporary failure: try again), `InvalidInput` (an empty name, one over 253 bytes or with a NUL),\n    /// `OutOfMemory`, `Unsupported` (no resolver: CosmoOS, the interpreter for names other than `localhost` and the\n    /// reserved `.invalid` ones).\n    /// Safety: the runtime copies the name during the start; the l",
    99 =>
        "ookup's record is the runtime's, ended once by\n    /// `DnsLookup`'s drop, so no path leaves it or ends it twice.\n    public async fn resolve(host: StringView, port: u16) -> Result<Vector<SocketAddress>, AsyncError> {\n        var out = Vector<SocketAddress>.create();\n        match (SocketAddresses.parseIp(host, port)) {\n            Some(address) => {\n                match (out.push(address)) {\n                    Ok() => { return Ok(out); }\n                    Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }\n                }\n            }\n            null => {}\n        }\n        let name = host.bytes();\n        var plain = name.length > 0 && name.length <= 253;\n        for (b in name) {\n            if (b == 0) {\n                plain = false;\n            }\n        }\n        if (!plain) {\n            return Err(AsyncError.Io(IoError.InvalidInput));\n        }\n        let raw = unsafe { ceesafe_dns_start(name.ptr, name.length as u64, port) };\n        if (raw.isNull()) {\n            return Err(AsyncError.Io(IoError.OutOfMemory));\n        }\n        let lookup = DnsLookup { raw: raw };\n        loop {\n            AsyncLeaf.status()?; // cancelled: the drop leaves the lookup to its thread\n            let r = unsafe { ceesafe_dns_poll(lookup.raw) };\n            if (r == 1) {\n                break;\n            }\n            if (r < 0) {\n                return Err(AsyncError.Io(AsyncIo.ioError(r as i64)));\n            }\n            await Async.park();\n        }\n        let count = unsafe { ceesafe_dns_count(lookup.raw) };\n        for (k in 0..count) {\n            var bytes = [0u8; 16];\n            var family: u32 = 0;\n            var scope: u32 = 0;\n            unsafe {\n                ceesafe_dns_address(\n                    lookup.raw,\n                    k,\n                    borrow mut bytes as *mut [u8; 16] as *mut u8,\n                    borrow mut family as *mut u32,\n                    borrow mut scope as *mut u32,\n                );\n            }\n            let address = if (family == 4) SocketAddress.V4(\n                [bytes[0], bytes[1], bytes[2], bytes[3]],\n                port,\n            ) else SocketAddress.V6(bytes, port, scope);\n            match (out.push(address)) {\n                Ok() => {}\n                Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }\n            }\n        }\n        return Ok(out);\n    }\n}\n\n/// A lookup the runtime holds (ADR 0048 §3.3), ended exactly once, here.\n@noncopy\nstruct DnsLookup {\n    raw: *mut void;\n\n    /// Safety: the record is this lookup's, and ended only here.\n    drop {\n        unsafe { ceesafe_dns_end(this.raw); }\n    }\n}\n",
    100 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// OrderedMap<K, V> (ADR 0075 §2.4): a B-tree over an arena of nodes linked by index, in safe CeeSafe, and its keys' OrderKey.\n\n/// A key of an OrderedMap (ADR 0075 §2.4): `K: OrderKey<K>`, since an interface has no `Self`. The order must be total\n/// and consistent: `a.compareKey(b)` is negative, zero or positive as `b.compareKey(a)` is positive, zero or negative.\npublic interface OrderKey<K> {\n    /// Negative if this key comes before `other`, zero if it is the same key, positive if it comes after.\n    fn compareKey(borrow this, other: borrow K) -> i32;\n}\n\nimpl OrderKey<u8> for u8 {\n    fn compareKey(borrow this, other: borrow u8) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<u16> for u16 {\n    fn compareKey(borrow this, other: borrow u16) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<u32> for u32 {\n    fn compareKey(borrow this, other: borrow u32) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<u64> for u64 {\n    fn compareKey(borrow this, other: borrow u64) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<usize> for usize {\n    fn compareKey(borrow this, other: borrow usize) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i8> for i8 {\n    fn compareKey(borrow this, other: borrow i8) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i16> for i16 {\n    fn compareKey(borrow this, other: borrow i16) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i32> for i32 {\n    fn compareKey(borrow this, other: borrow i32) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<i64> for i64 {\n    fn compareKey(borrow this, other: borrow i64) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<isize> for isize {\n    fn compareKey(borrow this, other: borrow isize) -> i32 => if (this < other) -1 else if (this > other) 1 else 0;\n}\n\nimpl OrderKey<bool> for bool {\n    /// `false` before `true`.\n    fn compareKey(borrow this, other: borrow bool) -> i32 => if (this == other) 0 else if (this) 1 else -1;\n}\n\nimpl OrderKey<String> for String {\n    /// Bytewise (UTF-8, so code point order), a prefix before the longer text.\n    fn compareKey(borrow this, other: borrow String) -> i32 => orderBytes(this.view().bytes(), other.view().bytes());\n}\n\nimpl OrderKey<Vector<u8>> for Vector<u8> {\n    /// Bytewise, a prefix before the longer vector.\n    fn compareKey(borrow this, other: borrow Vector<u8>) -> i32 => orderBytes(this.view(), other.view());\n}\n\n/// `a.compareKey(b)`: what a derived `compareKey` does for each field (ADR 0087 §2.3). A field type without an\n/// `OrderKey` is N0268 at the `@derive`.\npublic fn deriveCompare<K: OrderKey<K>>(a: borrow K, b: borrow K) -> i32 => a.compareKey(b);\n\n/// The bytewise order of `a` and `b`, a prefix first.\nfn orderBytes(a: Slice<u8>, b: Slice<u8>) -> i32 {\n    let n = if (a.length < b.length) a.length else b.length;\n    for (k in 0..n) {\n        if (a[k] != b[k]) {\n            return if (a[k] < b[k]) -1 else 1;\n        }\n    }\n    return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;\n}\n\n/// A node of an OrderedMap: its entries in key order and, unless it is a leaf, one more child than entries. Its\n/// vectors are allocated once, with room for one entry more than a node holds, so nothing in a node allocates after\n/// that.\nstruct OrderedNode<K, V> {\n    keys: Vector<K>;\n    values: Vector<V>;\n    children: Vector<usize>; // empty for a leaf\n    parent: usize?;          // null for the root; for a free node, the next free one\n\n    fn isLeaf(borrow this) -> bool => this.children.length == 0;\n}\n\n// The shifts within a node, in one place to replace with `Vector.insert` and `remove` (ADR 0075 §2.12). A node's\n// vectors are made with room for one elem",
    101 =>
        "ent more than it holds, so the pushes never allocate and cannot fail. A\n// removal moves the element to the end and the caller pops it: a generic function that returned the element would tie\n// it to the vector's loan (type-system.md §25.6), and the map could not store it again.\n\n/// Puts `x` at `at`, moving the elements from `at` on up by one.\nfn orderedInsert<T>(v: borrow mut Vector<T>, at: usize, x: T) {\n    v.push(x)!;\n    var k = v.length - 1;\n    while (k > at) {\n        v.swap(k - 1, k);\n        k -= 1;\n    }\n}\n\n/// Moves the element at `at` to the end, the later ones down by one, so that a `pop` takes it out.\nfn orderedToEnd<T>(v: borrow mut Vector<T>, at: usize) {\n    for (k in at..(v.length - 1)) {\n        v.swap(k, k + 1);\n    }\n}\n\n/// Puts `x` at `at` and the element that was there at the end, so that a `pop` takes it out.\nfn orderedExchange<T>(v: borrow mut Vector<T>, at: usize, x: T) {\n    v.push(x)!;\n    let last = v.length - 1;\n    v.swap(at, last);\n}\n\n/// Reverses `v` in place.\nfn orderedReverse<T>(v: borrow mut Vector<T>) {\n    if (v.length < 2) {\n        return;\n    }\n    var i: usize = 0;\n    var j = v.length - 1;\n    while (i < j) {\n        v.swap(i, j);\n        i += 1;\n        j -= 1;\n    }\n}\n\n/// A position in an OrderedMap: a node, a slot in it, and the map's version when the cursor was made. A cursor is\n/// read through its map (`keyAt`, `valueAt`); one used after the map changed panics.\npublic struct OrderedCursor {\n    node: usize;\n    slot: usize;\n    version: u64;\n}\n\n/// A map whose iteration order is its keys' order (ADR 0075 §2.4): a B-tree of minimum degree 16 (at most 31 entries\n/// a node), its nodes in one arena vector and linked by index, so it needs no `unsafe`. Ordered access is through\n/// cursors (`first`, `last`, `seek`, `seekAfter`, `next`, `previous`); a put, a removal or a clear changes the map's\n/// version, and a cursor made before it panics when used (\"ordered map changed under a cursor\"). Only `put`\n/// allocates; a failed `put` leaves the map as it was.\npublic struct OrderedMap<K: OrderKey<K>, V> {\n    nodes: Vector<OrderedNode<K, V>>; // the arena; nodes[root] is the root once a put made it\n    root: usize;\n    free: usize?; // the first free node, the others linked by `parent`\n    spare: usize; // how many nodes are free\n    count: usize;\n    version: u64;\n\n    /// An empty map. It allocates nothing until the first put.\n    public fn create() -> OrderedMap<K, V> => OrderedMap {\n        nodes: Vector<OrderedNode<K, V>>.create(),\n        root: 0,\n        free: null,\n        spare: 0,\n        count: 0,\n        version: 0,\n    };\n\n    /// How many entries.\n    public fn length(borrow this) -> usize => this.count;\n\n    /// Whether there are none.\n    public fn isEmpty(borrow this) -> bool => this.count == 0;\n\n    // The most entries a node holds (2B − 1, B = 16), the fewest a node other than the root holds (B − 1), and the\n    // room each node's vectors are made with: one entry and one child more, for the shifts.\n    fn most() -> usize => 31;\n    fn fewest() -> usize => 15;\n\n    /// The first slot of `node` whose key is not before `key`, and whether that key is `key`.\n    fn lowerBound(borrow this, node: usize, key: borrow K, found: borrow mut bool) -> usize {\n        let keys = borrow this.nodes[node].keys;\n        var lo: usize = 0;\n        var hi = keys.length;\n        while (lo < hi) {\n            let mid = lo + (hi - lo) / 2;\n            if (keys[mid].compareKey(key) < 0) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        found = lo < keys.length && keys[lo].compareKey(key) == 0;\n        return lo;\n    }\n\n    /// The first slot of `node` whose key comes after `key`.\n    fn upperBound(borrow this, node: usize, key: borrow K) -> usize {\n        let keys = borrow this.nodes[node].keys;\n        var lo: usize = 0;\n        var hi = keys.length;\n        while (lo < hi) {\n            let mid = lo + (hi - lo) / 2;\n     ",
    102 =>
        "       if (keys[mid].compareKey(key) <= 0) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        return lo;\n    }\n\n    /// Where `key` is, if it is there.\n    fn find(borrow this, key: borrow K) -> OrderedCursor? {\n        if (this.count == 0) {\n            return null;\n        }\n        var node = this.root;\n        loop {\n            var found = false;\n            let slot = this.lowerBound(node, key, mut found);\n            if (found) {\n                return OrderedCursor { node: node, slot: slot, version: this.version };\n            }\n            if (this.nodes[node].isLeaf()) {\n                return null;\n            }\n            node = this.nodes[node].children[slot];\n        }\n    }\n\n    /// The value of `key`, if it is there.\n    public fn get(borrow this, key: borrow K) -> borrow(this) V? {\n        let at = this.find(key)?;\n        return borrow this.nodes[at.node].values[at.slot];\n    }\n\n    /// The same, to change it. Changing a value does not change the map's version.\n    public fn getMut(borrow mut this, key: borrow K) -> borrow mut(this) V? {\n        let at = this.find(key)?;\n        return borrow mut this.nodes[at.node].values[at.slot];\n    }\n\n    /// Whether `key` is there.\n    public fn contains(borrow this, key: borrow K) -> bool => this.find(key) != null;\n\n    /// A new free node, its vectors allocated.\n    fn grow(borrow mut this) -> Result<void, AllocError> {\n        let node = OrderedNode<K, V> {\n            keys: Vector<K>.withCapacity(OrderedMap<K, V>.most() + 1)?,\n            values: Vector<V>.withCapacity(OrderedMap<K, V>.most() + 1)?,\n            children: Vector<usize>.withCapacity(OrderedMap<K, V>.most() + 2)?,\n            parent: this.free,\n        };\n        this.nodes.push(node)?;\n        this.free = this.nodes.length - 1;\n        this.spare += 1;\n        return Ok();\n    }\n\n    /// A free node, taken off the free list; there is one.\n    fn take(borrow mut this) -> usize {\n        let node = this.free!;\n        this.free = this.nodes[node].parent;\n        this.spare -= 1;\n        this.nodes[node].parent = null;\n        return node;\n    }\n\n    /// Puts an emptied node on the free list.\n    fn release(borrow mut this, node: usize) {\n        this.nodes[node].children.clear();\n        this.nodes[node].parent = this.free;\n        this.free = node;\n        this.spare += 1;\n    }\n\n    /// Splits `parent`'s full child `i`: its upper B − 1 entries (and B children) go to a new node, child `i + 1`, and\n    /// its middle entry up into `parent` at `i`, which has room.\n    fn split(borrow mut this, parent: usize, i: usize) {\n        let left = this.nodes[parent].children[i];\n        let right = this.take();\n        let keep = OrderedMap<K, V>.fewest(); // entries left keeps, and right gets\n        while (this.nodes[left].keys.length > keep + 1) {\n            let key = this.nodes[left].keys.pop()!;\n            this.nodes[right].keys.push(key)!;\n            let value = this.nodes[left].values.pop()!;\n            this.nodes[right].values.push(value)!;\n        }\n        orderedReverse(mut this.nodes[right].keys);\n        orderedReverse(mut this.nodes[right].values);\n        if (!this.nodes[left].isLeaf()) {\n            while (this.nodes[left].children.length > keep + 1) {\n                let child = this.nodes[left].children.pop()!;\n                this.nodes[right].children.push(child)!;\n                this.nodes[child].parent = right;\n            }\n            orderedReverse(mut this.nodes[right].children);\n        }\n        this.nodes[right].parent = parent;\n        let key = this.nodes[left].keys.pop()!;\n        let value = this.nodes[left].values.pop()!;\n        orderedInsert(mut this.nodes[parent].keys, i, key);\n        orderedInsert(mut this.nodes[parent].values, i, value);\n        orderedInsert(mut this.nodes[parent].children, i + 1, right);\n    }\n\n    /// Puts `value` at `key`: the old value if the key was there, else null. A failure leaves ",
    103 =>
        "the map as it was. The\n    /// nodes a put may need are allocated before anything changes.\n    public fn put(borrow mut this, key: K, value: V) -> Result<V?, AllocError> {\n        if (this.nodes.length == 0) {\n            this.grow()?;\n            this.root = this.take();\n        }\n        // The key's path: the entry if it is there, else how many full nodes the descent splits.\n        var needed: usize = 0;\n        var node = this.root;\n        loop {\n            var found = false;\n            let slot = this.lowerBound(node, borrow key, mut found);\n            if (found) {\n                orderedExchange(mut this.nodes[node].values, slot, value);\n                this.version += 1;\n                return Ok(this.nodes[node].values.pop());\n            }\n            if (this.nodes[node].keys.length == OrderedMap<K, V>.most()) {\n                needed += 1;\n            }\n            if (this.nodes[node].isLeaf()) {\n                break;\n            }\n            node = this.nodes[node].children[slot];\n        }\n        if (this.nodes[this.root].keys.length == OrderedMap<K, V>.most()) {\n            needed += 1; // a new root above the old one\n        }\n        while (this.spare < needed) {\n            this.grow()?;\n        }\n        // Nothing allocates from here on. A full root gets a new root above it, then each full node on the path is\n        // split before the descent enters it, so a split always has room in its parent (CLRS's B-TREE-INSERT).\n        if (this.nodes[this.root].keys.length == OrderedMap<K, V>.most()) {\n            let old = this.root;\n            let top = this.take();\n            this.nodes[top].children.push(old)!;\n            this.nodes[old].parent = top;\n            this.root = top;\n            this.split(top, 0);\n        }\n        node = this.root;\n        loop {\n            var found = false;\n            var slot = this.lowerBound(node, borrow key, mut found);\n            if (this.nodes[node].isLeaf()) {\n                orderedInsert(mut this.nodes[node].keys, slot, key);\n                orderedInsert(mut this.nodes[node].values, slot, value);\n                break;\n            }\n            let child = this.nodes[node].children[slot];\n            if (this.nodes[child].keys.length == OrderedMap<K, V>.most()) {\n                this.split(node, slot);\n                if (this.nodes[node].keys[slot].compareKey(borrow key) < 0) {\n                    slot += 1;\n                }\n            }\n            node = this.nodes[node].children[slot];\n        }\n        this.count += 1;\n        this.version += 1;\n        return Ok(null);\n    }\n\n    /// Merges `parent`'s child `i + 1` and the entry between them into child `i`, which then holds 2B − 1 entries; the\n    /// emptied node is freed, and so is `parent` if it was the root and is now empty, child `i` becoming the root.\n    fn merge(borrow mut this, parent: usize, i: usize) {\n        let left = this.nodes[parent].children[i];\n        let right = this.nodes[parent].children[i + 1];\n        orderedToEnd(mut this.nodes[parent].keys, i);\n        let key = this.nodes[parent].keys.pop()!;\n        orderedToEnd(mut this.nodes[parent].values, i);\n        let value = this.nodes[parent].values.pop()!;\n        orderedToEnd(mut this.nodes[parent].children, i + 1);\n        let gone = this.nodes[parent].children.pop();\n        this.nodes[left].keys.push(key)!;\n        this.nodes[left].values.push(value)!;\n        orderedReverse(mut this.nodes[right].keys);\n        orderedReverse(mut this.nodes[right].values);\n        orderedReverse(mut this.nodes[right].children);\n        while (this.nodes[right].keys.length > 0) {\n            let k = this.nodes[right].keys.pop()!;\n            this.nodes[left].keys.push(k)!;\n            let v = this.nodes[right].values.pop()!;\n            this.nodes[left].values.push(v)!;\n        }\n        while (this.nodes[right].children.length > 0) {\n            let child = this.nodes[right].children.pop()!;\n            this.nodes[left].children.push(ch",
