    182 =>
        "if (b[i] == 58) {\n                if (colon != b.length) {\n                    return null; // IPv6 needs its brackets when a port follows\n                }\n                colon = i;\n            }\n        }\n        if (colon == b.length) {\n            return null;\n        }\n        var v4 = [0u8; 4];\n        if (!SocketAddresses.parseV4(b[..colon], mut v4)) {\n            return null;\n        }\n        return match (SocketAddresses.parsePort(b[colon + 1..])) {\n            Some(port) => SocketAddress.V4(v4, port),\n            null => null,\n        };\n    }\n\n    /// An address without a port (`127.0.0.1`, `::1`, `fe80::1%2`, `fe80::1%en0`) and `port`; null if the text is not\n    /// one.\n    public fn parseIp(text: StringView, port: u16) -> SocketAddress? {\n        let b = text.bytes();\n        var v4 = [0u8; 4];\n        if (SocketAddresses.parseV4(b, mut v4)) {\n            return SocketAddress.V4(v4, port);\n        }\n        return SocketAddresses.parseV6Zoned(b, port);\n    }\n\n    public fn v4Any(port: u16) -> SocketAddress => SocketAddress.V4([0u8; 4], port);\n\n    public fn v6Any(port: u16) -> SocketAddress => SocketAddress.V6([0u8; 16], port, 0);\n\n    public fn v4Loopback(port: u16) -> SocketAddress => SocketAddress.V4([127u8, 0, 0, 1], port);\n\n    public fn v6Loopback(port: u16) -> SocketAddress {\n        var a = [0u8; 16];\n        a[15] = 1;\n        return SocketAddress.V6(a, port, 0);\n    }\n\n    fn allZero(b: Slice<u8>) -> bool {\n        for (x in b) {\n            if (x != 0) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    /// 1 to 5 decimal digits, at most 65535.\n    fn parsePort(b: Slice<u8>) -> u16? {\n        if (b.length == 0 || b.length > 5) {\n            return null;\n        }\n        var v: u32 = 0;\n        for (c in b) {\n            if (c < 48 || c > 57) {\n                return null;\n            }\n            v = v * 10 + (c - 48) as u32;\n        }\n        return if (v > 65535) null else truncate<u16>(v);\n    }\n\n    /// Dotted IPv4: four decimal parts of 1 to 3 digits without leading zeros, each at most 255.\n    fn parseV4(b: Slice<u8>, out: borrow mut [u8; 4]) -> bool {\n        var i: usize = 0;\n        for (part in 0..4usize) {\n            if (part > 0) {\n                if (i >= b.length || b[i] != 46) {\n                    return false;\n                }\n                i += 1;\n            }\n            var v: u32 = 0;\n            var digits: u32 = 0;\n            while (i < b.length && b[i] >= 48 && b[i] <= 57 && digits < 3) {\n                v = v * 10 + (b[i] - 48) as u32;\n                i += 1;\n                digits += 1;\n            }\n            if (digits == 0 || v > 255 || (digits > 1 && b[i - digits as usize] == 48)) {\n                return false; // no leading zeros: 010 would read as octal elsewhere\n            }\n            out[part] = truncate<u8>(v);\n        }\n        return i == b.length;\n    }\n\n    fn hexValue(c: u8) -> i32 {\n        if (c >= 48 && c <= 57) {\n            return (c - 48) as i32;\n        }\n        if (c >= 97 && c <= 102) {\n            return (c - 87) as i32;\n        }\n        if (c >= 65 && c <= 70) {\n            return (c - 55) as i32;\n        }\n        return -1;\n    }\n\n    /// IPv6 text (RFC 4291 §2.2): eight groups of up to four hex digits, at most one `::`, a dotted IPv4 last.\n    fn parseV6(b: Slice<u8>, out: borrow mut [u8; 16]) -> bool {\n        var groups = [0u16; 8];\n        var count: usize = 0;\n        var gap: usize = 9; // where `::` stands, 9 if there is none\n        var i: usize = 0;\n        if (b.length >= 2 && b[0] == 58 && b[1] == 58) {\n            gap = 0;\n            i = 2;\n        } else if (b.length == 0 || b[0] == 58) {\n            return false;\n        }\n        while (i < b.length) {\n            let start = i;\n            var v: u32 = 0;\n            var digits: u32 = 0;\n            while (i < b.length && SocketAddresses.hexValue(b[i]) >= 0 && digits < 5) {\n                v = v * 16 + truncate<u32>(SocketAddres",
    183 =>
        "ses.hexValue(b[i])); // 0 to 15 here\n                i += 1;\n                digits += 1;\n            }\n            if (i < b.length && b[i] == 46) {\n                var v4 = [0u8; 4];\n                if (count > 6 || !SocketAddresses.parseV4(b[start..], mut v4)) {\n                    return false;\n                }\n                groups[count] = ((v4[0] as u16) << 8) | v4[1] as u16;\n                groups[count + 1] = ((v4[2] as u16) << 8) | v4[3] as u16;\n                count += 2;\n                i = b.length;\n                break;\n            }\n            if (digits == 0 || digits > 4 || count == 8) {\n                return false;\n            }\n            groups[count] = truncate<u16>(v);\n            count += 1;\n            if (i == b.length) {\n                break;\n            }\n            if (b[i] != 58) {\n                return false;\n            }\n            i += 1;\n            if (i < b.length && b[i] == 58) {\n                if (gap != 9) {\n                    return false;\n                }\n                gap = count;\n                i += 1;\n            } else if (i == b.length) {\n                return false; // one trailing colon\n            }\n        }\n        if (if (gap == 9) count != 8 else count > 7) {\n            return false;\n        }\n        var at: usize = 0;\n        for (k in 0..8usize) {\n            var g: u16 = 0;\n            if (gap == 9 || k < gap || k >= gap + (8 - count)) {\n                g = groups[at];\n                at += 1;\n            }\n            out[2 * k] = truncate<u8>(g >> 8);\n            out[2 * k + 1] = truncate<u8>(g);\n        }\n        return true;\n    }\n\n    /// IPv6 with an optional `%zone`: a number, or an interface's name the runtime knows.\n    /// Safety: the runtime reads the name during the call only.\n    fn parseV6Zoned(b: Slice<u8>, port: u16) -> SocketAddress? {\n        var end = b.length;\n        for (i in 0..b.length) {\n            if