ize;\n        owned.releaseBuffer(true);\n        return VectorParts<T> { pointer: address as *mut T, length: length, capacity: capacity };\n    }\n\n    /// `Vector.fromForeign(pointer, length, capacity)` for a vector of `FailingAllocator`. A capacity of 0 gives the empty vector.\n    /// Safety: the caller's, as type-system.md §23.3 states it: the parts of one vector of this type, given once.\n    public unsafe fn fromForeignFailing(\n        pointer: *mut T,\n        length: usize,\n        capacity: usize,\n    ) -> Vector<T, FailingAllocator> {\n        var v = Vector<T, FailingAllocator>.create();\n        if (capacity != 0) {\n            v.adoptBuffer(pointer, length, capacity, true);\n        }\n        return v;\n    }\n}\n",
    54 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: searching, trimming and splitting bytes and text (ADR 0071 §2.4). Bundled with ceesafec and part of every\n// package. On a `StringView`, `s.indexOf(n)` is `TextSearch<r>.indexOf(s, n)` and so on; on a `Slice<u8>` (or a\n// `Vector<u8>`'s elements) it is `ByteSearch<r>`'s function of that name.\n//\n// Every view these return is valid UTF-8 when `s` is: a match of valid UTF-8 inside valid UTF-8 starts and ends on\n// character boundaries, and ASCII whitespace is one byte that is never part of a longer character.\n\n/// The parts of a text before and after a separator: what `s.splitOnce(sep)` finds.\npublic struct TextHalves<region r> {\n    public left: StringView<r>;\n    public right: StringView<r>;\n}\n\n/// The parts of bytes before and after a separator: what `s.splitOnce(sep)` finds on a `Slice<u8>`.\npublic struct ByteHalves<region r> {\n    public left: Slice<r, u8>;\n    public right: Slice<r, u8>;\n}\n\n/// The pieces of a text between separators, in order: `s.split(sep)`. `next()` gives each piece, then null. `\"a,,b\"`\n/// split by `\",\"` is `\"a\"`, `\"\"`, `\"b\"`; an empty text is one empty piece; an empty separator gives the text whole.\npublic struct TextSplit<region r> {\n    text: StringView<r>;\n    separator: StringView<r>;\n    position: usize; // where the next piece starts\n    finished: bool;\n}\n\nimpl<region r> Iterator<StringView<r>> for TextSplit<r> {\n    /// The next piece, or null after the last.\n    fn next(borrow mut this) -> StringView<r>? {\n        if (this.finished) {\n            return null;\n        }\n        let text = this.text;\n        let start = this.position;\n        if (this.separator.length > 0) {\n            let all = text.bytes();\n            let rest = all[start..];\n            match (ByteScan.indexOf(rest, this.separator.bytes())) {\n                Some(i) => {\n                    this.position = start + i + this.separator.length;\n                    return text[start..start + i];\n                }\n                null => {}\n            }\n        }\n        this.finished = true;\n        return text[start..];\n    }\n}\n\n/// The pieces of bytes between separators, in order: `s.split(sep)` on a `Slice<u8>`, as TextSplit.\npublic struct ByteSplit<region r> {\n    bytes: Slice<r, u8>;\n    separator: Slice<r, u8>;\n    position: usize;\n    finished: bool;\n}\n\nimpl<region r> Iterator<Slice<r, u8>> for ByteSplit<r> {\n    /// The next piece, or null after the last.\n    fn next(borrow mut this) -> Slice<r, u8>? {\n        if (this.finished) {\n            return null;\n        }\n        let bytes = this.bytes;\n        let start = this.position;\n        if (this.separator.length > 0) {\n            let rest = bytes[start..];\n            match (ByteScan.indexOf(rest, this.separator)) {\n                Some(i) => {\n                    this.position = start + i + this.separator.length;\n                    return bytes[start..start + i];\n                }\n                null => {}\n            }\n        }\n        this.finished = true;\n        return bytes[start..];\n    }\n}\n\n/// The searches themselves, on bytes; TextSearch and ByteSearch call these.\nstruct ByteScan {\n    /// Where `b` first is in `s`. Eight bytes at a time: a word with no byte equal to `b` is passed over at once.\n    fn indexOfByte(s: Slice<u8>, b: u8) -> usize? {\n        let length = s.length;\n        let pattern = (b as u64) * 0x0101_0101_0101_0101;\n        var i: usize = 0;\n        while (length - i >= 8) {\n            let word = ByteOrder.readU64LE(s, i) ^ pattern;\n            // A zero byte in `word` (a byte equal to `b`) sets its high bit here; no other byte can.\n            if ((word.wrappingSub(\n                0x0101_0101_0101_0101,\n            ) & (word ^ 0xFFFF_FFFF_FFFF_FFFF) & 0x8080_8080_8080_8080) != 0) {\n                break;\n            }\n            i += 8;\n        }\n        while (i < length) {\n            if (s[i] == b) {\n                return i;\n            }\n        ",
    55 =>
        "    i += 1;\n        }\n        return null;\n    }\n\n    /// Whether the bytes of `a` from `at` on begin with `b`.\n    fn matchesAt(a: Slice<u8>, at: usize, b: Slice<u8>) -> bool {\n        if (at > a.length || a.length - at < b.length) {\n            return false;\n        }\n        for (k in 0..b.length) {\n            if (a[at + k] != b[k]) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    /// Where `needle` first is in `s`: its first byte by indexOfByte, then the rest compared. Empty: 0.\n    fn indexOf(s: Slice<u8>, needle: Slice<u8>) -> usize? {\n        let n = needle.length;\n        if (n == 0) {\n            return 0;\n        }\n        if (n > s.length) {\n            return null;\n        }\n        let last = s.length - n; // the last start a match can have\n        let first = needle[0];\n        var i: usize = 0;\n        while (i <= last) {\n            let window = s[i..last + 1];\n            match (ByteScan.indexOfByte(window, first)) {\n                Some(k) => {\n                    i += k;\n                }\n                null => {\n                    return null;\n                }\n            }\n            if (ByteScan.matchesAt(s, i, needle)) {\n                return i;\n            }\n            i += 1;\n        }\n        return null;\n    }\n\n    /// Where `needle` last is in `s`. Empty: `s.length`.\n    fn lastIndexOf(s: Slice<u8>, needle: Slice<u8>) -> usize? {\n        let n = needle.length;\n        if (n > s.length) {\n            return null;\n        }\n        var i = s.length - n;\n        while (true) {\n            if (ByteScan.matchesAt(s, i, needle)) {\n                return i;\n            }\n            if (i == 0) {\n                return null;\n            }\n            i -= 1;\n        }\n        return null;\n    }\n\n    fn startsWith(s: Slice<u8>, prefix: Slice<u8>) -> bool => ByteScan.matchesAt(s, 0, prefix);\n\n    fn endsWith(s: Slice<u8>, suf