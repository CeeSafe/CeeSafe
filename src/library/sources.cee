 `off_t`).\n    fn check(start: u64, length: u64) -> Result<void, IoError> {\n        le",
    178 =>
        "t limit: u64 = 0x7FFFFFFFFFFFFFFF;\n        if (length == 0 || start > limit || length > limit - start) {\n            return Err(IoError.InvalidInput);\n        }\n        return Ok();\n    }\n\n    fn code(kind: FileLock) -> u32 => match (kind) {\n        FileLock.Shared => 1,\n        FileLock.Exclusive => 2,\n    };\n}\n\n/// A standard stream, for `Console.isTerminal` (ADR 0221 §2.3).\npublic enum ConsoleStream {\n    Input,\n    Output,\n    Error,\n}\n\n/// A point in real time (ADR 0055): seconds since 1970-01-01T00:00:00Z, leap seconds not counted (POSIX time), negative\n/// before it, and the nanoseconds after them.\npublic struct UnixTime {\n    public seconds: i64;\n    /// 0 to 999 999 999.\n    public nanoseconds: u32;\n\n    /// The milliseconds since 1970, rounded toward minus infinity (the nanoseconds are never negative).\n    public fn millis(borrow this) -> i64 => this.seconds * 1000 + (this.nanoseconds / 1000000) as i64;\n}\n\n/// The system's real time (ADR 0055): the date, which may jump backward or forward (NTP, the user). Measure and wait\n/// with `Timer`, whose monotonic clock never jumps. The interpreter answers 2000-01-01T00:00:00Z plus its virtual\n/// clock, so its runs stay reproducible.\npublic struct Clock {\n    /// Now.\n    /// Safety: the runtime writes the two values during the call only.\n    public fn now() -> UnixTime {\n        var seconds: i64 = 0;\n        var nanoseconds: u32 = 0;\n        unsafe { ceesafe_clock_realtime(borrow mut seconds as *mut i64, borrow mut nanoseconds as *mut u32); }\n        return UnixTime { seconds: seconds, nanoseconds: nanoseconds };\n    }\n\n    /// Now, in milliseconds since 1970.\n    public fn unixMillis() -> i64 => Clock.now().millis();\n\n    /// The seconds to add to UTC to get the local time at `at`, as the system's time zone gives it, daylight saving\n    /// included (ADR 0153): 10800 for UTC+3, -18000 for New York in winter and -14400 in summer. 0 in the interpreter,\n    /// so its runs stay reproducible, and where the system has no time zone.\n    /// Safety: the runtime only reads the system's time zone.\n    public fn localOffset(at: UnixTime) -> i32 => unsafe { ceesafe_clock_local_offset(at.seconds) };\n\n    /// Nanoseconds on the monotonic clock, from an arbitrary start (ADR 0075 §2.6): for measuring durations and\n    /// latencies, never for the date. It never decreases within a process (`CLOCK_MONOTONIC`; `CLOCK_UPTIME_RAW` on\n    /// Apple systems; `QueryPerformanceCounter` on Windows). The interpreter answers its virtual clock.\n    /// Safety: the runtime only reads the clock.\n    public fn monotonicNanos() -> u64 => unsafe { ceesafe_clock_monotonic() };\n}\n\n/// Random bytes from the system's cryptographic source (ADR 0060): `getrandom` (or `/dev/urandom`) on Linux,\n/// `arc4random_buf` on macOS and the BSDs, `BCryptGenRandom` on Windows; for keys, nonces, masks and tokens. Each call\n/// reads the source, which is cheap enough to call per message. The interpreter answers a fixed sequence instead, so\n/// its runs stay reproducible: its bytes are not secret.\npublic struct Random {\n    /// Fills `into` with random bytes. `Err(Unsupported)` where the system has no source (CosmoOS userland); another\n    /// error if the source fails, with `into` partly written. It has no effect, so async code and a `drop` block may\n    /// call it.\n    /// Safety: the runtime writes at most the slice's length, during the call only.\n    public fn fill(into: SliceMut<u8>) -> Result<void, IoError> {\n        let result = unsafe { ceesafe_random_fill(into.ptr, into.length as u64) };\n        return if (result < 0) Err(HostServices.hostError(result)) else Ok();\n    }\n\n    /// A random integer `r` with `0 <= r < n`, each value equally likely (ADR 0106): `Random.below(100)! + 1` is a\n    /// number from 1 to 100. `Err(InvalidInput)` if `n` is 0, as no integer is below it; else `fill`'s error. It\n    /// draws eight bytes with `fill`, and again while they fall in the part of the 64-bit range that would make\n    //",
    179 =>
        "/ some values likelier (less than one time in two, whatever `n`), so there is no modulo bias. In the\n    /// interpreter it follows `fill`'s fixed sequence: the same numbers every run.\n    public fn below(n: u64) -> Result<u64, IoError> {\n        if (n == 0) {\n            return Err(IoError.InvalidInput);\n        }\n        let excess = 0u64.wrappingSub(n) % n; // 2^64 mod n: that many low draws are refused\n        var bytes = [0u8; 8];\n        loop {\n            Random.fill(mut bytes[..])?;\n            var draw: u64 = 0;\n            for (k in 0..8usize) {\n                draw = draw | ((bytes[k] as u64) << (8 * k));\n            }\n            if (draw >= excess) {\n                return Ok(draw % n);\n            }\n        }\n    }\n}\n",
    180 =>
        "// Isolated tasks (ADR 0175; type-system.md §40.10): the process's count of them, and a set's watcher.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_async_isolation_report(out: *mut u64);\n    @effects()\n    fn ceesafe_async_set_watch(set: *mut void, channel: *mut void) -> bool;\n}\n\n/// What the isolated tasks that trapped in this process have cost it (`Isolation.report()`).\npublic struct IsolationReport {\n    /// How many have trapped and ended alone.\n    public crashes: u64;\n    /// What they held, in bytes, none of which is ever freed. A program that goes on for long decides from this\n    /// when to stop and be started again.\n    public leakedBytes: u64;\n}\n\npublic struct Isolation {\n    /// The process's totals.\n    /// Safety: the runtime writes the two words of `out`.\n    public fn report() -> IsolationReport {\n        var out = [0u64; 2];\n        unsafe { ceesafe_async_isolation_report(borrow mut out[0] as *mut u64); }\n        return IsolationReport { crashes: out[0], leakedBytes: out[1] };\n    }\n\n    /// Has each crash of `set`'s isolated children put in `crashes` from now, without waiting: one that does not\n    /// fit is counted (`set.missedCrashes()`). The set keeps a handle of the channel until it ends. False if there\n    /// is no memory for it.\n    /// Safety: the runtime takes a count of the channel, which it gives back when the set ends.\n    public fn watch<E: Copy>(set: borrow TaskSet<E>, crashes: borrow Channel<TaskCrash>) -> bool =>\n        unsafe { ceesafe_async_set_watch(set.recordOf(), crashes.handle()) };\n}\n",
    181 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Socket addresses (type-system.md §40.4, ADR 0044): IPv4 and IPv6 endpoints, their text, and a listener's options.\n// Parsing and writing are pure CeeSafe; only an IPv6 zone given by an interface's name asks the runtime.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_interface_index(name: *u8, length: u64) -> u32;\n    @effects()\n    fn ceesafe_dns_start(host: *u8, length: u64, port: u16) -> *mut void;\n    @effects()\n    fn ceesafe_dns_poll(lookup: *mut void) -> i32;\n    @effects()\n    fn ceesafe_dns_count(lookup: *mut void) -> u32;\n    @effects()\n    fn ceesafe_dns_address(lookup: *mut void, index: u32, bytes: *mut u8, family: *mut u32, scope: *mut u32);\n    @effects()\n    fn ceesafe_dns_end(lookup: *mut void);\n}\n\n/// An IPv4 or IPv6 endpoint: the address bytes in network order and the port; an IPv6 address also has its scope id\n/// (0: none), which a link-local address needs to say which interface it is on.\npublic enum SocketAddress {\n    V4([u8; 4], u16),\n    V6([u8; 16], u16, u32),\n}\n\n/// What every SocketAddress answers (ADR 0044 §3.1).\npublic interface SocketEndpoint {\n    /// The port.\n    fn port(borrow this) -> u16;\n    /// The same address with port `p`.\n    fn withPort(borrow this, p: u16) -> SocketAddress;\n    /// 127.0.0.0/8, or ::1.\n    fn isLoopback(borrow this) -> bool;\n    /// 0.0.0.0, or ::.\n    fn isUnspecified(borrow this) -> bool;\n    /// The text: `127.0.0.1:8080`, `[::1]:8080`, `[fe80::1%2]:8080`; IPv6 in RFC 5952's canonical form.\n    fn write(borrow this, w: borrow mut TextWriter);\n}\n\nimpl SocketEndpoint for SocketAddress {\n    fn port(borrow this) -> u16 => match (this) {\n        SocketAddress.V4(_, p) => p,\n        SocketAddress.V6(_, p, _) => p,\n    };\n\n    fn withPort(borrow this, p: u16) -> SocketAddress => match (this) {\n        SocketAddress.V4(a, _) => SocketAddress.V4(a, p),\n        SocketAddress.V6(a, _, s) => SocketAddress.V6(a, p, s),\n    };\n\n    fn isLoopback(borrow this) -> bool => match (this) {\n        SocketAddress.V4(a, _) => a[0] == 127,\n        SocketAddress.V6(a, _, _) => SocketAddresses.allZero(a[..15]) && a[15] == 1,\n    };\n\n    fn isUnspecified(borrow this) -> bool => match (this) {\n        SocketAddress.V4(a, _) => SocketAddresses.allZero(a[..]),\n        SocketAddress.V6(a, _, _) => SocketAddresses.allZero(a[..]),\n    };\n\n    fn write(borrow this, w: borrow mut TextWriter) {\n        match (this) {\n            SocketAddress.V4(a, p) => {\n                SocketAddresses.writeV4(w, a);\n                w.byte(58);\n                w.decimal(p as u64);\n            }\n            SocketAddress.V6(a, p, s) => {\n                w.byte(91);\n                SocketAddresses.writeV6(w, a);\n                if (s != 0) {\n                    w.byte(37);\n                    w.decimal(s as u64);\n                }\n                w.text(\"]:\");\n                w.decimal(p as u64);\n            }\n        }\n    }\n}\n\n/// The ways to make a SocketAddress: from text, and the well-known ones. (An enum has no functions of its own,\n/// type-system.md §15.1, so they are here.)\npublic struct SocketAddresses {\n    /// `a.b.c.d:port`, `[v6]:port` or `[v6%zone]:port`, where the zone is a number or an interface's name; null if\n    /// the text is not one.\n    public fn parse(text: StringView) -> SocketAddress? {\n        let b = text.bytes();\n        if (b.length > 0 && b[0] == 91) {\n            var close: usize = 0;\n            while (close < b.length && b[close] != 93) {\n                close += 1;\n            }\n            if (close >= b.length || close + 1 >= b.length || b[close + 1] != 58) {\n                return null;\n            }\n            let inner = b[1..close];\n            return match (SocketAddresses.parsePort(b[close + 2..])) {\n                Some(port) => SocketAddresses.parseV6Zoned(inner, port),\n                null