        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: searching, trimming and splitting bytes and text (ADR 0071 §2.4). Bundled with ceesafec and part of every\n// package. On a `StringView`, `s.indexOf(n)` is `TextSearch<r>.indexOf(s, n)` and so on; on a `Slice<u8>` (or a\n// `Vector<u8>`'s elements) it is `ByteSearch<r>`'s function of that name.\n//\n// Every view these return is valid UTF-8 when `s` is: a match of valid UTF-8 inside valid UTF-8 starts and ends on\n// character boundaries, and ASCII whitespace is one byte that is never part of a longer character.\n\n/// The parts of a text before and after a separator: what `s.splitOnce(sep)` finds.\npublic struct TextHalves<region r> {\n    public left: StringView<r>;\n    public right: StringView<r>;\n}\n\n/// The parts of bytes before and after a separator: what `s.splitOnce(sep)` finds on a `Slice<u8>`.\npublic struct ByteHalves<region r> {\n    public left: Slice<r, u8>;\n    public right: Slice<r, u8>;\n}\n\n/// The pieces of a text between separators, in order: `s.split(sep)`. `next()` gives each piece, then null. `\"a,,b\"`\n/// split by `\",\"` is `\"a\"`, `\"\"`, `\"b\"`; an empty text is one empty piece; an empty separator gives the text whole.\npublic struct TextSplit<region r> {\n    text: StringView<r>;\n    separator: StringView<r>;\n    position: usize; // where the next piece starts\n    finished: bool;\n}\n\nimpl<region r> Iterator<StringView<r>> for TextSplit<r> {\n    /// The next piece, or null after the last.\n    fn next(borrow mut this) -> StringView<r>? {\n        if (this.finished) {\n            return null;\n        }\n        let text = this.text;\n        let start = this.position;\n        if (this.separator.length > 0) {\n            let all = text.bytes();\n            let rest = all[start..];\n            match (ByteScan.indexOf(rest, this.separator.bytes())) {\n                Some(i) => {\n                    this.position = start + i + thi