        "AccessRole.List => 12,\n                WindowAccessRole.Menu => 13,\n                WindowAccessRole.MenuBar => 14,\n                WindowAccessRole.TabList => 15,\n                WindowAccessRole.Table => 16,\n                WindowAccessRole.Row => 17,\n                WindowAccessRole.Cell => 18,\n                WindowAccessRole.ColumnHeader => 19,\n            };\n            // Fourteen words a node, as the runtime reads them.\n            let words = [\n                n.id,\n                n.min.bits(),\n                n.max.bits(),\n                n.now.bits(),\n                (n.x.bits() as u64) | ((n.y.bits() as u64) << 32),\n                (n.width.bits() as u64) | ((n.height.bits() as u64) << 32),\n                (role as u64) | ((n.flags as u64) << 32),\n                (n.labelStart as u64) | ((n.labelLength as u64) << 32),\n                (n.valueStart as u64) | ((n.valueLength as u64) << 32),\n                (n.caret as u64) | ((n.anchor as u64) << 32),\n                n.layer as u64,\n                n.parent,\n                (n.row as u64) | ((n.column as u64) << 32),\n                (n.rows as u64) | ((n.columns as u64) << 32),\n            ];\n            for (word in words) {\n                match (raw.push(word)) {\n                    Ok() => {}\n                    Err(_) => { return; }\n                }\n            }\n        }\n        let view = raw.view();\n        let result = unsafe { ceesafe_window_set_access(\n            this.raw,\n            view.ptr,\n            truncate<u32>(nodes.length),\n            text.ptr,\n            truncate<u32>(text.length),\n        ) };\n        if (result == -1) {\n            panic(\"Window.setAccessNodes: an element's id is given twice\");\n        }\n        if (result < 0) {\n            panic(\"Window.setAccessNodes: an element's parent is not a container before it in the list\");\n        }\n    }\n\n    /// The oldest request of a screen reader not yet taken, or n