d: u8) -> Result<u8, u8> {\n        let old = unsafe { ceesafe_atomic_cas_u8(this.cell(), expected, desired) };\n        if (old == expected) {\n            return Ok(old);\n        }\n        return Err(old);\n    }\n\n    /// load, with an ordering (ADR 0021).\n    /// Safety: as load.\n    public fn loadWith(borrow this, order: LoadOrdering) -> u8 =>\n        unsafe { ceesafe_atomic_load_ord_u8(this.cell(), loadCode(order)) };\n\n    /// store, with an ordering.\n    /// Safety: as load.\n    public fn storeWith(borrow this, value: u8, order: StoreOrdering) {\n        unsafe { ceesafe_atomic_store_ord_u8(this.cell(), value, storeCode(order)); }\n    }\n\n    fn cell(borrow this) -> *mut u8 => borrow this.value as *u8 as *mut u8;\n}\n\n/// A usize that threads may read and change at once, as AtomicU64 (usize is 64 bits on every target, §29.3).\n@threadSafe\n@noncopy\npublic struct AtomicUSize {\n    private inner: AtomicU64;\n\n    /// A new atomic holding `value`.\n    public fn create(value: usize) -> AtomicUSize => AtomicUSize { inner: AtomicU64.create(value as u64) };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4).\n    @constant\n    public fn constant(value: usize) -> AtomicUSize => AtomicUSize { inner: AtomicU64.constant(value as u64) };\n\n    /// The value, sequentially consistent.\n    public fn load(borrow this) -> usize => truncate<usize>(this.inner.load());\n\n    /// Stores `value`, sequentially consistent.\n    public fn store(borrow this, value: usize) { this.inner.store(value as u64); }\n\n    /// Stores `value` and returns the old value, sequentially consistent.\n    public fn swap(borrow this, value: usize) -> usize => truncate<usize>(this.inner.swap(value as u64));\n\n    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).\n    public fn compareExchange(borrow this, expected: usize, desired: usize) -> Result<usize, usize> {\n        match (this.inner.compareExchange(expected as u64, desired as u64)) {\n            Ok(old) => { return Ok(truncate<usize>(old)); }\n      ",
