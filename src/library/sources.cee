    19 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: text of any bytes (ADR 0231). `String` and `StringView` hold UTF-8 only; a `ByteString` (owned) and a\n// `ByteStringView<r>` (borrowed) hold text that is usually UTF-8 but need not be, as C's `char *`, a file name, or\n// SQLite's TEXT may. Bundled with ceesafec and part of every package. HashKey and OrderKey for them are in lib/std,\n// beside the interfaces.\n//\n// The bytes are kept as they are: nothing is replaced or checked until a program asks for UTF-8 (`toUtf8`, a view\n// when the bytes are valid; `toUtf8Lossy`, a string with U+FFFD for each maximal subpart of an ill-formed sequence;\n// `chunks`, the valid runs and the bytes between them).\n\n/// A borrowed text of any bytes, valid for region `r` as a `StringView<r>` is: a view of a `ByteString`, of a\n/// `StringView`'s bytes or of any `Slice<u8>`. Copy; `==` compares the bytes. A field of this type needs a region\n/// parameter, as a view's does.\n@derive(Equal)\npublic struct ByteStringView<region r> {\n    private data: Slice<r, u8>;\n\n    /// The bytes of `text`, as a byte string: no copy. A string literal, a `StringView` or a `String` (lent).\n    public fn fromText(text: StringView<r>) -> ByteStringView<r> => ByteStringView { data: text.bytes() };\n\n    /// `bytes`, as a byte string: no copy, and no check.\n    public fn fromBytes(bytes: Slice<r, u8>) -> ByteStringView<r> => ByteStringView { data: bytes };\n\n    /// The bytes.\n    public fn bytes(borrow this) -> Slice<r, u8> => this.data;\n\n    /// The length in bytes.\n    public fn length(borrow this) -> usize => this.data.length;\n\n    /// Whether there are no bytes.\n    public fn isEmpty(borrow this) -> bool => this.data.length == 0;\n\n    /// The byte at `index`; panics past the end, as `s[index]` does.\n    public fn byteAt(borrow this, index: usize) -> u8 => this.data[index];\n\n    /// The bytes from `start` up to `end`; panics as `s[start..end]` does when they are not inside. A slice may cut\n    /// a UTF-8 sequence: the bytes are any bytes.\n    public fn slice(borrow this, start: usize, end: usize) -> ByteStringView<r> {\n        let all = this.data;\n        return ByteStringView { data: all[start..end] };\n    }\n\n    /// The bytes from `start` to the end.\n    public fn sliceFrom(borrow this, start: usize) -> ByteStringView<r> {\n        let all = this.data;\n        return ByteStringView { data: all[start..] };\n    }\n\n    /// The first `end` bytes.\n    public fn sliceTo(borrow this, end: usize) -> ByteStringView<r> {\n        let all = this.data;\n        return ByteStringView { data: all[..end] };\n    }\n\n    /// The text as a `StringView` when the bytes are UTF-8 (the Unicode Standard's Table 3-7, as\n    /// `StringView.fromUtf8` checks), with no copy; null when they are not.\n    public fn toUtf8(borrow this) -> StringView<r>? => StringView.fromUtf8(this.data);\n\n    /// Whether the bytes are UTF-8.\n    public fn isUtf8(borrow this) -> bool => StringView.fromUtf8(this.data) != null;\n\n    /// A new string of the text, each maximal subpart of an ill-formed sequence replaced by U+FFFD (the Unicode\n    /// Standard's §3.9 \"U+FFFD substitution of maximal subparts\", which the WHATWG Encoding Standard's decoder and\n    /// Python's `bytes.decode('utf-8', 'replace')` follow). Valid UTF-8 is copied as it is.\n    public fn toUtf8Lossy(borrow this) -> Result<String, AllocError> {\n        var out = String.withCapacity(this.data.length)?;\n        this.appendLossyTo(mut out)?;\n        return Ok(out);\n    }\n\n    /// Appends `toUtf8Lossy`'s text to `out`. On failure `out` holds the text appended before it.\n    public fn appendLossyTo(borrow this, out: borrow mut String) -> Result<void, AllocError> {\n        var pieces = this.chunks();\n        for (chunk in pieces) {\n            out.append(chunk.valid)?;\n            if (chunk.invalid.length > 0) {\n                out.append(\"\\u{FFFD}\")?;\n            }\n        }\n        return Ok();\n    }\n\n    /// The text in piec",
    20 =>
        "es, for a printer that escapes what is not UTF-8: each `Utf8Chunk` is a run of valid UTF-8\n    /// and then one maximal subpart of an ill-formed sequence (1 to 3 bytes), which only the last chunk may lack.\n    /// Empty bytes give no chunk.\n    public fn chunks(borrow this) -> Utf8Chunks<r> => Utf8Chunks { data: this.data, position: 0 };\n\n    /// Whether the bytes are the same as `other`'s: `==` across regions.\n    public fn equals(borrow this, other: ByteStringView) -> bool => ByteScanOrder.compare(this.data, other.data) == 0;\n\n    /// Bytewise order: negative, zero or positive as this text comes before, is the same as or comes after\n    /// `other`; a prefix comes before the longer text. For UTF-8 it is code point order, as for `String`.\n    public fn compare(borrow this, other: ByteStringView) -> i32 => ByteScanOrder.compare(this.data, other.data);\n\n    /// Where `needle` first is, in bytes; 0 for an empty needle.\n    public fn indexOf(borrow this, needle: Slice<u8>) -> usize? => ByteSearch.indexOf(this.data, needle);\n\n    /// Where `needle` last is; the length for an empty needle.\n    public fn lastIndexOf(borrow this, needle: Slice<u8>) -> usize? => ByteSearch.lastIndexOf(this.data, needle);\n\n    /// Where the byte `b` first is.\n    public fn indexOfByte(borrow this, b: u8) -> usize? => ByteSearch.indexOfByte(this.data, b);\n\n    /// Whether `needle` occurs.\n    public fn contains(borrow this, needle: Slice<u8>) -> bool => ByteSearch.contains(this.data, needle);\n\n    /// Whether the bytes begin with `prefix`.\n    public fn startsWith(borrow this, prefix: Slice<u8>) -> bool => ByteSearch.startsWith(this.data, prefix);\n\n    /// Whether the bytes end with `suffix`.\n    public fn endsWith(borrow this, suffix: Slice<u8>) -> bool => ByteSearch.endsWith(this.data, suffix);\n\n    /// Whether the bytes are `other`'s, `A`–`Z` and `a`–`z` taken as the same.\n    public fn equalsIgnoreAsciiCase(borrow this, other: Slice<u8>) -> bool =>\n        ByteSearch.equalsIgnoreAsciiCase(this.data, other);\n\n    /// Without ASCII whitespace at either end.\n    public fn trim(borrow this) -> ByteStringView<r> => ByteStringView { data: ByteSearch.trim(this.data) };\n\n    /// Without ASCII whitespace at the start.\n    public fn trimStart(borrow this) -> ByteStringView<r> => ByteStringView { data: ByteSearch.trimStart(this.data) };\n\n    /// Without ASCII whitespace at the end.\n    public fn trimEnd(borrow this) -> ByteStringView<r> => ByteStringView { data: ByteSearch.trimEnd(this.data) };\n\n    /// The bytes before the first `separator` and after it, or null if it does not occur. An empty separator is\n    /// found at the start.\n    public fn splitOnce(borrow this, separator: Slice<u8>) -> ByteStringHalves<r>? {\n        let halves = ByteSearch.splitOnce(this.data, separator)?;\n        return ByteStringHalves {\n            left: ByteStringView { data: halves.left },\n            right: ByteStringView { data: halves.right },\n        };\n    }\n\n    /// The pieces between separators, in order, as `StringView`'s `split`: `\"a,,b\"` by `\",\"` is `\"a\"`, `\"\"`, `\"b\"`;\n    /// empty bytes are one empty piece; an empty separator gives the bytes whole.\n    public fn split(borrow this, separator: Slice<r, u8>) -> ByteStringSplit<r> =>\n        ByteStringSplit { pieces: ByteSearch.split(this.data, separator) };\n\n    /// A new byte string with a copy of the bytes.\n    public fn toByteString(borrow this) -> Result<ByteString, AllocError> => ByteString.copyOf(this.data);\n\n    /// Writes the bytes, as they are, to `w`.\n    public fn writeTo(borrow this, w: borrow mut TextWriter) {\n        w.bytes(this.data);\n    }\n}\n\n/// An owned text of any bytes, in a growable buffer: a `String` that may hold bytes that are not UTF-8. A move type,\n/// as `Vector<u8>` is; `==` compares the bytes. Text enters it as text (`append`, numbers, characters) or as bytes\n/// (`appendBytes`, `appendByte`), and nothing