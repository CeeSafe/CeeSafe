    40 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Shared state between threads (type-system.md §38.3, ADR 0016): Arc and Mutex, over the hosted runtime\n// (runtime/hosted/ceesafe_rt_thread.c). Their unsafe code keeps ownership.md T1–T3. The atomics are in lib/core (ADR 0026).\n\nextern \"C\" {\n    @effects(alloc)\n    fn ceesafe_mutex_create() -> *mut void;\n    @effects(sleep)\n    fn ceesafe_mutex_lock(m: *mut void);\n    @effects()\n    fn ceesafe_mutex_unlock(m: *mut void);\n    @effects()\n    fn ceesafe_mutex_destroy(m: *mut void);\n}\n\n/// Mutual exclusion: the data is reached only through a guard, which one thread holds at a time.\n@threadSafe\n@noncopy\npublic struct Mutex<T: Send> {\n    private raw: *mut void;\n    private data: T;\n\n    /// A mutex holding `data`; its platform lock is allocated.\n    /// Safety: a null lock is reported, never stored.\n    public fn create(data: T) -> Result<Mutex<T>, AllocError> {\n        let raw = unsafe { ceesafe_mutex_create() };\n        if (raw.isNull()) {\n            return Err(AllocError.OutOfMemory);\n        }\n        return Ok(Mutex { raw: raw, data: data });\n    }\n\n    /// Waits for the lock; the guard lends the data until it is dropped.\n    /// Safety: `raw` is the lock made in create, destroyed only in drop, when no guard can be live (B-rules).\n    public fn lock(borrow this) -> MutexGuard<T> {\n        unsafe { ceesafe_mutex_lock(this.raw); }\n        return MutexGuard { lock: this };\n    }\n\n    /// Safety: no guard is live once the mutex can be dropped, so the lock is free.\n    drop {\n        unsafe { ceesafe_mutex_destroy(this.raw); }\n    }\n}\n\n/// Holding a Mutex: `data()` lends the protected value; dropping the guard unlocks.\npublic struct MutexGuard<region r, T: Send> {\n    private lock: borrow(r) Mutex<T>;\n\n    /// Safety: the guard holds the lock, so no other thread reaches the data, and the loan ends before the guard's drop.\n    public fn data(borrow mut this) -> borrow mut T =>\n        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };\n\n    /// Safety: the guard took the lock in Mutex.lock and releases it once.\n    drop {\n        unsafe { ceesafe_mutex_unlock(this.lock.raw); }\n    }\n}\n\nstruct ArcInner<T> {\n    count: AtomicU64;\n    value: T;\n}\n\n/// Shared ownership across threads: each clone is an owner, and the last owner's drop destroys the value.\n@threadSafe\n@noncopy\npublic struct Arc<T: Share> {\n    private inner: *mut ArcInner<T>;\n\n    /// Safety: the pointer comes from Box.intoRaw and is given back once, by the last owner's drop.\n    public fn create(value: T) -> Result<Arc<T>, AllocError> {\n        let boxed = Box.create(ArcInner { count: AtomicU64.create(1), value: value })?;\n        return Ok(Arc { inner: Box.intoRaw(boxed) });\n    }\n\n    /// Another owner of the same value.\n    /// Safety: this owner keeps the value alive while the count is raised.\n    public fn clone(borrow this) -> Arc<T> {\n        this.shared().count.fetchAdd(1);\n        return Arc { inner: this.inner };\n    }\n\n    /// The shared value, for as long as this owner is borrowed.\n    /// Safety: the value lives while any owner does; T is Share, so shared references to it may cross threads.\n    public fn get(borrow this) -> borrow T => borrow this.shared().value;\n\n    /// Safety: as get.\n    fn shared(borrow this) -> borrow ArcInner<T> => unsafe { Ptr.toBorrow(this.inner as *ArcInner<T>) };\n\n    /// Safety: only the owner that brings the count from one to zero gives the box back.\n    drop {\n        if (this.shared().count.fetchSub(1) == 1) {\n            let last: Box<ArcInner<T>> = unsafe { Box.fromRaw(this.inner) };\n        }\n    }\n}\n\n/// Why Thread.spawn failed: the thread, its record or its closure could not be allocated (type-system.md §38.2).\npublic enum SpawnError {\n    Resources,\n}\n",
    41 =>
        "// Tests (ADR 0049): what a failed check returns, the checks, and the generated harness's side of the runner protocol.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_test_begin(failAllocAt: u64, cancelAt: u64);\n    @effects()\n    fn ceesafe_thread_watchdog(ms: u64);\n}\n\n/// What a failed check returns (ADR 0049 §3.2): a message, owned, so it borrows nothing from the test. `ceesafec test`\n/// shows it with the test's name.\npublic struct TestFailure {\n    public message: Vector<u8>;\n\n    /// A failure with `message`. If the message cannot be allocated, the failure has an empty one: it still fails.\n    public fn create(message: StringView) -> TestFailure {\n        var bytes = Vector<u8>.create();\n        for (b in message.bytes()) {\n            match (bytes.push(b)) {\n                Ok() => {}\n                Err(_) => { return TestFailure { message: bytes }; }\n            }\n        }\n        return TestFailure { message: bytes };\n    }\n\n    /// A failure with what `w` wrote.\n    fn written(w: borrow TextWriter) -> TestFailure {\n        var bytes = Vector<u8>.create();\n        for (b in w.written()) {\n            match (bytes.push(b)) {\n                Ok() => {}\n                Err(_) => { return TestFailure { message: bytes }; }\n            }\n        }\n        return TestFailure { message: bytes };\n    }\n}\n\n/// The checks of a test (ADR 0049 §3.2): each is `Ok` when it holds, and otherwise `Err` with what was expected, for\n/// `?`. The comparisons are typed: CeeSafe has no equality interface yet for a generic one.\npublic struct Check {\n    /// `condition` holds; `what` says what it is.\n    public fn isTrue(condition: bool, what: StringView) -> Result<void, TestFailure> {\n        if (condition) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected true: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `condition` does not hold.\n    public fn isFalse(condition: bool, what: StringView) -> Result<void, TestFailure> {\n        if (!condition) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected false: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is `expected`.\n    public fn equalU64(expected: u64, actual: u64) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 128];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \");\n        w.decimal(expected);\n        w.text(\", got \");\n        w.decimal(actual);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is `expected`.\n    public fn equalI64(expected: i64, actual: i64) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 128];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \");\n        w.signed(expected);\n        w.text(\", got \");\n        w.signed(actual);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is the text `expected`.\n    public fn equalText(expected: StringView, actual: StringView) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 1024];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \\\"\");\n        w.text(expected);\n        w.text(\"\\\", got \\\"\");\n        w.text(actual);\n        w.text(\"\\\"\");\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` has the bytes of `expected`; else where they first differ.\n    public fn equalBytes(expected: Slice<u8>, actual: Slice<u8>) -> Result<void, TestFailure> {\n        var at: usize = 0;\n        while (at < expected.length && at < actual.length && expected[at] == actual[at]) {\n            at +",
    42 =>
        "= 1;\n        }\n        if (at == expected.length && at == actual.length) {\n            return Ok();\n        }\n        var buffer = [0u8; 256];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"the bytes differ at \");\n        w.decimal(at as u64);\n        w.text(\": expected \");\n        if (at < expected.length) {\n            w.text(\"0x\");\n            w.hex(expected[at] as u64, 2);\n        } else {\n            w.text(\"the end\");\n        }\n        w.text(\", got \");\n        if (at < actual.length) {\n            w.text(\"0x\");\n            w.hex(actual[at] as u64, 2);\n        } else {\n            w.text(\"the end\");\n        }\n        w.text(\" (lengths \");\n        w.decimal(expected.length as u64);\n        w.text(\" and \");\n        w.decimal(actual.length as u64);\n        w.text(\")\");\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// A failure with `message`, always.\n    public fn fail(message: StringView) -> Result<void, TestFailure> => Err(TestFailure.create(message));\n}\n\n/// The checks of a `Result` (ADR 0049 §3.2), a generic struct's since a method declares no type parameters of its own:\n/// `CheckResult<u32, ParseError>.isOk(borrow parsed, \"the line parses\")?`.\npublic struct CheckResult<T, E> {\n    /// `r` is `Ok`.\n    public fn isOk(r: borrow Result<T, E>, what: StringView) -> Result<void, TestFailure> {\n        let failed = match (r) {\n            Err(_) => true,\n            _ => false,\n        };\n        if (!failed) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected Ok: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `r` is `Err`.\n    public fn isErr(r: borrow Result<T, E>, what: StringView) -> Result<void, TestFailure> {\n        let failed = match (r) {\n            Err(_) => true,\n            _ => false,\n        };\n        if (failed) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected Err: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n}\n\n/// The generated harness's side of the runner protocol, version 1 (ADR 0049 §3.4). Not for tests to call.\npublic struct TestRun {\n    /// Before the test: the arguments after the test's name, `<fail-alloc-at> <cancel-at> <timeout-ms>` (0: none),\n    /// turn the runtime's reports and hooks on and arm the timeout.\n    /// Safety: the runtime only records the numbers, and the watchdog only waits and ends the process.\n    public fn begin() {\n        let failAt = TestRun.number(3);\n        let cancelAt = TestRun.number(4);\n        let timeout = TestRun.number(5);\n        unsafe {\n            ceesafe_test_begin(failAt, cancelAt);\n            ceesafe_thread_watchdog(timeout);\n        }\n    }\n\n    /// Argument `k` as a decimal number, or 0.\n    fn number(k: usize) -> u64 {\n        var value: u64 = 0;\n        match (Process.argument(k)) {\n            Some(text) => {\n                for (b in text.bytes()) {\n                    if (b >= '0' && b <= '9' && value < 0x0CCCCCCCCCCCCCCC) {\n                        value = value * 10 + (b - '0') as u64;\n                    }\n                }\n            }\n            null => {}\n        }\n        return value;\n    }\n\n    /// The test passed: its line, and the exit status 0.\n    public fn passed() -> i32 {\n        Console.writeErrorLine(\"ceesafe-test 1 passed\");\n        return 0;\n    }\n\n    /// The test failed with `message`: its lines, and the exit status 1.\n    public fn failed(message: Slice<u8>) -> i32 {\n        Console.writeErrorLine(\"ceesafe-test 1 failed\");\n        match (StringView.fromUtf8(message)) {\n            Some(text) => { Console.writeErrorLine(text); }\n            null => { Console.writeErrorLine(\"(a message that is not UTF-8)\"); }\n        }\n        Console.writeErrorLine(\"ceesafe-test 1 end\");\n        return 1;\n    }\n\n    /// The same with a",
