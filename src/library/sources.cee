        "}\n        return i;\n    }\n\n    /// The least entry, or null if the map is empty.\n    public fn first(borrow this) -> OrderedCursor? {\n        if (this.count == 0) {\n            return null;\n        }\n        return this.cursor(this.leftmost(this.root), 0);\n    }\n\n    /// The greatest entry, or null if the map is empty.\n    public fn last(borrow this) -> OrderedCursor? {\n        if (this.count == 0) {\n            return null;\n        }\n        let leaf = this.rightmost(this.root);\n        return this.cursor(leaf, this.nodes[leaf].keys.length - 1);\n    }\n\n    /// The first entry whose key is not before `key`, or null if there is none.\n    public fn seek(borrow this, key: borrow K) -> OrderedCursor? {\n        if (this.count == 0) {\n            return null;\n        }\n        var best: OrderedCursor? = null;\n        var node = this.root;\n        loop {\n            var found = false;\n            let slot = this.lowerBound(node, key, mut found);\n            if (found) {\n                return this.cursor(node, slot);\n            }\n            if (slot < this.nodes[node].keys.length) {\n                best = this.cursor(node, slot);\n            }\n            if (this.nodes[node].isLeaf()) {\n                return best;\n            }\n            node = this.nodes[node].children[slot];\n        }\n    }\n\n    /// The first entry whose key comes after `key`, or null if there is none.\n    public fn seekAfter(borrow this, key: borrow K) -> OrderedCursor? {\n        if (this.count == 0) {\n            return null;\n        }\n        var best: OrderedCursor? = null;\n        var node = this.root;\n        loop {\n            let slot = this.upperBound(node, key);\n            if (slot < this.nodes[node].keys.length) {\n                best = this.cursor(node, slot);\n            }\n            if (this.nodes[node].isLeaf()) {\n                return best;\n            }\n            node = this.nodes[node].children[slot];\n      