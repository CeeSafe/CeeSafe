        "size, slot: usize, key: K, value: V) -> V {\n        orderedExchange(mut this.nodes[node].keys, slot, key);\n        let oldKey = this.nodes[node].keys.pop();\n        orderedExchange(mut this.nodes[node].values, slot, value);\n        return this.nodes[node].values.pop()!;\n    }\n\n    /// The same with the least entry.\n    fn replaceWithFirst(borrow mut this, node: usize, into: usize, slot: usize) -> V {\n        var at = node;\n        while (!this.nodes[at].isLeaf()) {\n            at = this.fill(at, 0);\n        }\n        orderedToEnd(mut this.nodes[at].keys, 0);\n        let key = this.nodes[at].keys.pop()!;\n        orderedToEnd(mut this.nodes[at].values, 0);\n        let value = this.nodes[at].values.pop()!;\n        return this.exchange(into, slot, key, value);\n    }\n\n    /// Takes `key` out: its value, or null. The descent keeps every node it enters above the minimum, borrowing from a\n    /// sibling or else merging (CLRS's B-TREE-DELETE), so the tree stays balanced. Nothing allocates.\n    public fn remove(borrow mut this, key: borrow K) -> V? {\n        if (this.find(key) == null) {\n            return null;\n        }\n        var node = this.root;\n        let fewest = OrderedMap<K, V>.fewest();\n        loop {\n            var found = false;\n            let slot = this.lowerBound(node, key, mut found);\n            if (found && this.nodes[node].isLeaf()) {\n                orderedToEnd(mut this.nodes[node].keys, slot);\n                let gone = this.nodes[node].keys.pop();\n                orderedToEnd(mut this.nodes[node].values, slot);\n                let value = this.nodes[node].values.pop();\n                this.count -= 1;\n                this.version += 1;\n                return value;\n            }\n            if (found) {\n                let left = this.nodes[node].children[slot];\n                let right = this.nodes[node].children[slot + 1];\n                if (this.nodes[left].keys.length > fewest) {\n                    let value = this.replaceWithLast(left, node, slot);\n                    this.count -= 1;\n                    this.version += 1;\n                    return value;\n                }\n                if (this.nodes[right].keys.length > fewest) {\n                    let value = this.replaceWithFirst(right, node, slot);\n                    this.count -= 1;\n                    this.version += 1;\n                    return value;\n                }\n                this.merge(node, slot); // the key moves down into `left`\n                node = left;\n            } else {\n                node = this.fill(node, slot);\n            }\n        }\n    }\n\n    /// Takes every entry out and frees the nodes.\n    public fn clear(borrow mut this) {\n        this.nodes.clear();\n        this.root = 0;\n        this.free = null;\n        this.spare = 0;\n        this.count = 0;\n        this.version += 1;\n    }\n\n    /// Panics if `at` was made before the map last changed.\n    fn check(borrow this, at: OrderedCursor) {\n        if (at.version != this.version) {\n            panic(\"ordered map changed under a cursor\");\n        }\n    }\n\n    fn cursor(borrow this, node: usize, slot: usize) -> OrderedCursor => OrderedCursor {\n        node: node,\n        slot: slot,\n        version: this.version,\n    };\n\n    /// The leftmost leaf under `node`.\n    fn leftmost(borrow this, node: usize) -> usize {\n        var at = node;\n        while (!this.nodes[at].isLeaf()) {\n            at = this.nodes[at].children[0];\n        }\n        return at;\n    }\n\n    /// The rightmost leaf under `node`.\n    fn rightmost(borrow this, node: usize) -> usize {\n        var at = node;\n        while (!this.nodes[at].isLeaf()) {\n            at = this.nodes[at].children[this.nodes[at].children.length - 1];\n        }\n        return at;\n    }\n\n    /// The slot of `parent`'s children that holds `child`.\n    fn childSlot(borrow this, parent: usize, child: usize) -> usize {\n        var i: usize = 0;\n        while (this.nodes[parent].children[i] != child) {\n            i += 1;\n        ",
