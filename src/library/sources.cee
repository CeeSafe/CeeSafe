elow 1\n    for (s in 0..norm.length) {\n        if (norm[s] == -1) {\n            high -= 1;\n        ",
    150 =>
        "    symbols[high] = truncate<u8>(s);\n        }\n    }\n    let step = (size >> 1) + (size >> 3) + 3;\n    let mask = size - 1;\n    var pos: usize = 0;\n    for (s in 0..norm.length) {\n        var k: i16 = 0;\n        while (k < norm[s]) {\n            symbols[pos] = truncate<u8>(s);\n            pos = (pos + step) & mask;\n            while (pos >= high) {\n                pos = (pos + step) & mask;\n            }\n            k += 1;\n        }\n    }\n    if (pos != 0) { return false; }\n    var next = [0u32; 256];\n    for (s in 0..norm.length) {\n        next[s] = if (norm[s] == -1) 1 else truncate<u32>(norm[s]);\n    }\n    for (state in 0..size) {\n        let s = symbols[state] as usize;\n        let x = next[s];\n        next[s] = x + 1;\n        let nb = log - zstdHighBit(x);\n        let base = (x << nb) - truncate<u32>(size);\n        table[state] = zstdSymbol(which, s) | zstdEntry(0, 0, base, nb);\n    }\n    return true;\n}\n\n// ---------------------------------------------------------------------------------------------------------------\n// Huffman (RFC 8878 §4.2). A table entry is a u16: the symbol in the high byte, its code's length in the low.\n\n/// A Huffman tree description: how many weights (the implied last one included), the table's log, and its bytes.\nstruct ZstdWeights {\n    count: usize;\n    log: u32;\n    used: usize;\n}\n\n/// Reads a Huffman tree description from the start of `data` into `weights` (as libzstd's HUF_readStats): weights\n/// written 4 bits each, or compressed with FSE (two states, a log of at most 6), then the implied last weight. Null if\n/// it is cut short, a weight is above 12, the code would be longer than 12 bits, or the weights do not make a complete\n/// code.\n@effects()\nfn zstdWeights(data: Slice<u8>, weights: SliceMut<u8>) -> ZstdWeights? {\n    if (data.length == 0) { return null; }\n    let header = data[0] as usize;\n    var n: usize = 0;\n    var used: usize = 0;\n    if (header >= 128) {\n