ile (i < b.length && SocketAddresses.hexValue(b[i]) >= 0 && digits < 5) {\n                v = v * 16 + truncate<u32>(SocketAddres",
    36 =>
        "ses.hexValue(b[i])); // 0 to 15 here\n                i += 1;\n                digits += 1;\n            }\n            if (i < b.length && b[i] == 46) {\n                var v4 = [0u8; 4];\n                if (count > 6 || !SocketAddresses.parseV4(b[start..], mut v4)) {\n                    return false;\n                }\n                groups[count] = ((v4[0] as u16) << 8) | v4[1] as u16;\n                groups[count + 1] = ((v4[2] as u16) << 8) | v4[3] as u16;\n                count += 2;\n                i = b.length;\n                break;\n            }\n            if (digits == 0 || digits > 4 || count == 8) {\n                return false;\n            }\n            groups[count] = truncate<u16>(v);\n            count += 1;\n            if (i == b.length) {\n                break;\n            }\n            if (b[i] != 58) {\n                return false;\n            }\n            i += 1;\n            if (i < b.length && b[i] == 58) {\n                if (gap != 9) {\n                    return false;\n                }\n                gap = count;\n                i += 1;\n            } else if (i == b.length) {\n                return false; // one trailing colon\n            }\n        }\n        if (if (gap == 9) count != 8 else count > 7) {\n            return false;\n        }\n        var at: usize = 0;\n        for (k in 0..8usize) {\n            var g: u16 = 0;\n            if (gap == 9 || k < gap || k >= gap + (8 - count)) {\n                g = groups[at];\n                at += 1;\n            }\n            out[2 * k] = truncate<u8>(g >> 8);\n            out[2 * k + 1] = truncate<u8>(g);\n        }\n        return true;\n    }\n\n    /// IPv6 with an optional `%zone`: a number, or an interface's name the runtime knows.\n    /// Safety: the runtime reads the name during the call only.\n    fn parseV6Zoned(b: Slice<u8>, port: u16) -> SocketAddress? {\n        var end = b.length;\n        for (i in 0..b.length) {\n            if