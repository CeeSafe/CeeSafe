lgorithms<T>.insertion(s, low, high, cmp);\n            if (waiting == 0) {\n                return;\n            }\n            waiting -= 1;\n            low = lows[waiting];\n            high = highs[waiting];\n            left = depths[waiting];\n        }\n    }\n\n    /// Moves the median of `s[lo]`, the middle element and `s[hi - 1]` to `s[hi - 1]`, the pivot's place while\n    /// partitioning (`s[lo..hi]` has at least 3 elements).\n    @effectsOf(cmp)\n    fn pivot(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {\n        let last = hi - 1;\n        let mid = lo + (hi - lo) / 2;\n        if (cmp(borrow s[mid], borrow s[lo]) < 0) { s.swap(mid, lo); }\n        if (cmp(borrow s[last], borrow s[mid]) < 0) {\n            s.swap(last, mid);\n            if (cmp(borrow s[mid], borrow s[lo]) < 0) { s.swap(mid, lo); }\n        }\n        s.swap(mid, last);\n    }\n\n    /// Partitions `s[lo..hi]` around the pivot at `s[hi - 1]`; returns the pivot's index. Everything before it\n    /// compares below the pivot, nothing after it does. Without a branch on `cmp`'s result: each element is swapped\n    /// with `s[store]` (itself, or one not below the pivot), and `store` advances when it was below.\n    @effectsOf(cmp)\n    fn partition(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) -> usize {\n        let last = hi - 1;\n        var store = lo;\n        for (i in lo..last) {\n            let below: usize = if (cmp(borrow s[i], borrow s[last]) < 0) 1 else 0;\n            s.swap(i, store);\n            store += below;\n        }\n        s.swap(store, last);\n        return store;\n    }\n\n    /// As partition, with the elements not above the pivot before it.\n    @effectsOf(cmp)\n    fn partitionEqual(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) -> usize {\n        let last = hi - 1;\n        var store = lo;\n        for (i in lo..last) {\n            let n