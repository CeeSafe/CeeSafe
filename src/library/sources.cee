          n: parts.n,\n                },\n                4 => IoParts {\n                    p0: parts.p0,\n                    p1: parts.p1,\n                    p2: parts.p2,\n                    p3: parts.p3,\n                    p4: cut,\n                    p5: parts.p5,\n                    p6: parts.p6,\n                    p7: parts.p7,\n                    n: parts.n,\n                },\n                5 => IoParts {\n                    p0: parts.p0,\n                    p1: parts.p1,\n                    p2: parts.p2,\n                    p3: parts.p3,\n                    p4: parts.p4,\n                    p5: cut,\n                    p6: parts.p6,\n                    p7: parts.p7,\n                    n: parts.n,\n                },\n                6 => IoParts {\n                    p0: parts.p0,\n                    p1: parts.p1,\n                    p2: parts.p2,\n                    p3: parts.p3,\n                    p4: parts.p4,\n                    p5: parts.p5,\n                    p6: cut,\n                    p7: parts.p7,\n                    n: parts.n,\n                },\n                _ => IoParts {\n                    p0: parts.p0,\n                    p1: parts.p1,\n                    p2: parts.p2,\n                    p3: parts.p3,\n                    p4: parts.p4,\n                    p5: parts.p5,\n                    p6: parts.p6,\n                    p7: cut,\n                    n: parts.n,\n                },\n            };\n            left -= keep;\n            k += 1;\n        }\n        return parts;\n    }\n\n    /// The bytes after the first `skip`, as parts: whole parts dropped, the part where byte `skip` falls cut. Empty\n    /// (no parts) from `totalLength()` on. What a write loop sends after a partial send.\n    public fn after(this, skip: usize) -> IoParts<r> {\n        var k: u32 = 0;\n        var left = skip;\n        while (k < this.n && left >= this.part(k).length) {\n            left -= this.part(k).