        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Socket addresses (type-system.md §40.4, ADR 0044): IPv4 and IPv6 endpoints, their text, and a listener's options.\n// Parsing and writing are pure CeeSafe; only an IPv6 zone given by an interface's name asks the runtime.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_interface_index(name: *u8, length: u64) -> u32;\n    @effects()\n    fn ceesafe_dns_start(host: *u8, length: u64, port: u16) -> *mut void;\n    @effects()\n    fn ceesafe_dns_poll(lookup: *mut void) -> i32;\n    @effects()\n    fn ceesafe_dns_count(lookup: *mut void) -> u32;\n    @effects()\n    fn ceesafe_dns_address(lookup: *mut void, index: u32, bytes: *mut u8, family: *mut u32, scope: *mut u32);\n    @effects()\n    fn ceesafe_dns_end(lookup: *mut void);\n}\n\n/// An IPv4 or IPv6 endpoint: the address bytes in network order and the port; an IPv6 address also has its scope id\n/// (0: none), which a link-local address needs to say which interface it is on.\npublic enum SocketAddress {\n    V4([u8; 4], u16),\n    V6([u8; 16], u16, u32),\n}\n\n/// What every SocketAddress answers (ADR 0044 §3.1).\npublic interface SocketEndpoint {\n    /// The port.\n    fn port(borrow this) -> u16;\n    /// The same address with port `p`.\n    fn withPort(borrow this, p: u16) -> SocketAddress;\n    /// 127.0.0.0/8, or ::1.\n    fn isLoopback(borrow this) -> bool;\n    /// 0.0.0.0, or ::.\n    fn isUnspecified(borrow this) -> bool;\n    /// The text: `127.0.0.1:8080`, `[::1]:8080`, `[fe80::1%2]:8080`; IPv6 in RFC 5952's canonical form.\n    fn write(borrow this, w: borrow mut TextWriter);\n}\n\nimpl SocketEndpoint for SocketAddress {\n    fn port(borrow this) -> u16 => match (this) {\n        SocketAddress.V4(_, p) => p,\n        SocketAddress.V6(_, p, _) => p,\n    };\n\n    fn withPort(borrow this, p: u16) -> SocketAddress => match (this) {\n        SocketAddress.V4(a, _) => SocketAddress.V4(a, p),\n        SocketAddress.V6(a, _, s)