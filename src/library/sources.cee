>(this.inner.fetchSubWith(value as u64, order));\n\n    /// As fetchOrWith.\n    public fn fetchOrWith(borrow this, value: usize, order: Ordering) -> usize =>\n        truncate<usize>(this.inner.fetchOrWith(value as u64, order));\n\n    /// As fetchAndWith.\n    public fn fetchAndWith(borrow this, value: usize, order: Ordering) -> usize =>\n        truncate<usize>(this.inner.fetchAndWith(value as u64, order));\n}\n\n/// A bool that threads may read and change at once.\n@threadSafe\n@noncopy\npublic struct AtomicBool {\n    private inner: AtomicU32;\n\n    /// A new atomic holding `value`.\n    public fn create(value: bool) -> AtomicBool => AtomicBool { inner: AtomicU32.create(if (value) 1 else 0) };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4).\n    @constant\n    public fn constant(value: bool) -> AtomicBool => AtomicBool { inner: AtomicU32.constant(value as u32) };\n\n    /// The value, sequentially consistent.\n    public fn load(borrow this) -> bool => this.inner.load() != 0;\n\n    /// Stores `value`, sequentially consistent.\n    public fn store(borrow this, value: bool) { this.inner.store(if (value) 1 else 0); }\n\n    /// Stores `value` and returns the old value, sequentially consistent.\n    public fn swap(borrow this, value: bool) -> bool => this.inner.swap(if (value) 1 else 0) != 0;\n\n    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).\n    public fn compareExchange(borrow this, expected: bool, desired: bool) -> Result<bool, bool> {\n        match (this.inner.compareExchange(if (expected) 1 else 0, if (desired) 1 else 0)) {\n            Ok(old) => { return Ok(old != 0); }\n            Err(old) => { return Err(old != 0); }\n        }\n    }\n\n    /// As load, with `order`.\n    public fn loadWith(borrow this, order: LoadOrdering) -> bool => this.inner.loadWith(order) != 0;\n\n    /// As store, with `order`.\n    public fn storeWith(borrow this, value: bool, order: StoreOrdering) {\n        this.inner.storeWith(if (value) 1 else 0, order);\n    }\n\n    /// As swap, with `ord",
