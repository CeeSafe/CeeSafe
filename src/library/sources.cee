at can spare one, else merges with a sibling, which stays within 2B − 1 since neither holds more than B − 1.\n    /// The node to descend into.\n    fn fill(borrow mut this, parent: usize, i: usize) -> usize {\n        let child = this.nodes[parent].children[i];\n        let fewest = OrderedMap<K, V>.fewest();\n        if (this.nodes[child].keys.length > fewest) {\n            return child;\n        }\n        let last = this.nodes[parent].children.length - 1;\n        if (i > 0 && this.nodes[this.nodes[parent].children[i - 1]].keys.length > fewest) {\n            // From the left sibling: its last entry up into `parent`, the entry between them down to `child`'s front.\n            let left = this.nodes[parent].children[i - 1];\n            let key = this.nodes[left].keys.pop()!;\n            let value = this.nodes[left].values.pop()!;\n            orderedExchange(mut this.nodes[parent].keys, i - 1, key);\n            let down = this.nodes[parent].keys.pop()!;\n            orderedExchange(mut this.nodes[parent].values, i - 1, value);\n            let downValue = this.nodes[parent].values.pop()!;\n            orderedInsert(mut this.nodes[child].keys, 0, down);\n            orderedInsert(mut this.nodes[child].values, 0, downValue);\n            if (!this.nodes[left].isLeaf()) {\n                let moved = this.nodes[left].children.pop()!;\n                orderedInsert(mut this.nodes[child].children, 0, moved);\n                this.nodes[moved].parent = child;\n            }\n            return child;\n        }\n        if (i < last && this.nodes[this.nodes[parent].children[i + 1]].keys.length > fewest) {\n            // From the right sibling: its first entry up into `parent`, the entry between them down to `child`'s end.\n            let right = this.nodes[parent].children[i + 1];\n            orderedToEnd(mut this.nodes[right].keys, 0);\n            let key = this.nodes[right].keys.pop()!;\n            orderedToEnd(mut this.nodes[right].values, 0);\n            