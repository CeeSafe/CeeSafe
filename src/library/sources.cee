        "oses the window when dropped. It is used on the program's first\n/// thread only.\npublic struct Window {\n    raw: *mut void;\n\n    /// Opens a resizable window of `width` × `height` points titled `title`.\n    /// Safety: the runtime reads the title's bytes during the call only, and the handle it returns is this window's\n    /// until the drop closes it.\n    public fn open(title: StringView, width: u32, height: u32) -> Result<Window, WindowError> {\n        var error: i32 = 0;\n        let raw = unsafe { ceesafe_window_open(\n            title.ptr,\n            title.length as u64,\n            width,\n            height,\n            borrow mut error as *mut i32,\n        ) };\n        if (raw.isNull()) {\n            return Err(Window.errorOf(error));\n        }\n        return Ok(Window { raw: raw });\n    }\n\n    /// The next pending event, or null; it never blocks.\n    /// Safety: the runtime writes four fields and two coordinates, the sizes of the arrays it is given.\n    public fn nextEvent(borrow mut this) -> WindowEvent? {\n        var fields = [0i32; 4];\n        var position = [0.0f32; 2];\n        let kind = unsafe { ceesafe_window_poll(\n            this.raw,\n            borrow mut fields[0] as *mut i32,\n            borrow mut position[0] as *mut f32,\n        ) };\n        let x = position[0];\n        let y = position[1];\n        return match (kind) {\n            1 => WindowEvent.Closed,\n            2 => WindowEvent.Resized(WindowSize { width: truncate<u32>(fields[0]), height: truncate<u32>(fields[1]) }),\n            3 => WindowEvent.Focus(fields[0] != 0),\n            4 => WindowEvent.PointerMoved(x, y),\n            5 => WindowEvent.PointerButton(Window.buttonOf(fields[0]), fields[1] != 0, x, y),\n            6 => WindowEvent.Wheel(x, y),\n            7 => WindowEvent.Key(\n                Window.keyOf(fields[0]),\n                fields[1] != 0,\n                fields[2] != 0,\n                Window.modifiersOf(fields[3]),\n            ),\n            8 => WindowEvent.Text(truncate<u32>(fields[0])),\n            _ => null,\n        };\n    }\n\n    /// Shows a `width` × `height` image of premultiplied RGBA8 pixels (bytes R, G, B, A), rows top to bottom, scaled\n    /// to the content.\n    /// Safety: the runtime reads `width × height` pixels, which `pixels` is checked to hold, during the call only.\n    public fn present(borrow mut this, pixels: Slice<u32>, width: u32, height: u32) -> Result<void, WindowError> {\n        if (width == 0 || height == 0 || (pixels.length as u64) < (width as u64) * (height as u64)) {\n            return Err(WindowError.Resources);\n        }\n        let result = unsafe { ceesafe_window_present(this.raw, pixels.ptr, width, height) };\n        return if (result < 0) Err(Window.errorOf(0 - result)) else Ok();\n    }\n\n    /// Like `present`, but only the pixels inside `changed` differ from the last frame presented (§26.13, ADR 0070):\n    /// the window shows just those, which saves copying the rest. Without a last frame of this size, with a box\n    /// outside the image, or with more than 64 boxes, it is `present`. An empty `changed` shows nothing new.\n    /// Safety: the runtime reads `width × height` pixels, which `pixels` is checked to hold, and the boxes, during\n    /// the call only.\n    public fn presentChanged(\n        borrow mut this,\n        pixels: Slice<u32>,\n        width: u32,\n        height: u32,\n        changed: Slice<WindowBox>,\n    ) -> Result<void, WindowError> {\n        if (width == 0 || height == 0 || (pixels.length as u64) < (width as u64) * (height as u64)) {\n            return Err(WindowError.Resources);\n        }\n        if (changed.length > 64) {\n            return this.present(pixels, width, height);\n        }\n        var flat = [0u32; 256];\n        for (k in 0..changed.length) {\n            flat[4 * k] = changed[k].x;\n            flat[4 * k + 1] = changed[k].y;\n            flat[4 * k + 2] = changed[k].width;\n            flat[4 * k + 3] = changed[k].height;\n        }\n        let result = unsafe { ",
    116 =>
        "ceesafe_window_present_changed(\n            this.raw,\n            pixels.ptr,\n            width,\n            height,\n            borrow flat[0] as *u32,\n            changed.length as u64,\n        ) };\n        return if (result < 0) Err(Window.errorOf(0 - result)) else Ok();\n    }\n\n    /// The content's size in points.\n    /// Safety: the runtime writes the two sizes.\n    public fn size(borrow this) -> WindowSize {\n        var width: u32 = 0;\n        var height: u32 = 0;\n        unsafe { ceesafe_window_size(this.raw, borrow mut width as *mut u32, borrow mut height as *mut u32); }\n        return WindowSize { width: width, height: height };\n    }\n\n    /// Pixels per point: 2.0 on a Retina display.\n    /// Safety: the runtime writes the scale.\n    public fn scale(borrow this) -> f32 {\n        var scale: f32 = 1.0;\n        unsafe { ceesafe_window_scale(this.raw, borrow mut scale as *mut f32); }\n        return scale;\n    }\n\n    /// The pointer's shape while it is over the content.\n    /// Safety: the runtime only reads the cursor's number.\n    public fn setCursor(borrow mut this, cursor: WindowCursor) {\n        let code: i32 = match (cursor) {\n            WindowCursor.Default => 0,\n            WindowCursor.Pointer => 1,\n            WindowCursor.Text => 2,\n            WindowCursor.Crosshair => 3,\n            WindowCursor.Grab => 4,\n            WindowCursor.ResizeHorizontal => 5,\n            WindowCursor.ResizeVertical => 6,\n        };\n        unsafe { ceesafe_window_set_cursor(this.raw, code); }\n    }\n\n    /// Sets the title.\n    /// Safety: the runtime reads the title's bytes during the call only.\n    public fn setTitle(borrow mut this, title: StringView) {\n        unsafe { ceesafe_window_set_title(this.raw, title.ptr, title.length as u64); }\n    }\n\n    /// Returns about 1/60 s after the previous call, or earlier when an event arrives.\n    /// Safety: the runtime only waits on the window it was given.\n    public fn waitFrame(borrow mut this) {\n        unsafe { ceesafe_window_wait(this.raw); }\n    }\n\n    fn errorOf(code: i32) -> WindowError => match (code) {\n        1 => WindowError.Unsupported,\n        2 => WindowError.NoDisplay,\n        3 => WindowError.NotMainThread,\n        _ => WindowError.Resources,\n    };\n\n    fn buttonOf(code: i32) -> WindowButton => match (code) {\n        1 => WindowButton.Secondary,\n        2 => WindowButton.Middle,\n        _ => WindowButton.Primary,\n    };\n\n    /// The runtime's key numbers (ceesafe_rt_window.c): 1-14 the named keys, 100 + n F(n), 0x10000 + c a character,\n    /// 0x20000 + code any other key.\n    fn keyOf(code: i32) -> WindowKey {\n        if (code >= 0x20000) {\n            return WindowKey.Other(truncate<u32>(code - 0x20000));\n        }\n        if (code >= 0x10000) {\n            return WindowKey.Character(truncate<u32>(code - 0x10000));\n        }\n        if (code > 100 && code <= 112) {\n            return WindowKey.Function(truncate<u8>(code - 100));\n        }\n        return match (code) {\n            1 => WindowKey.Tab,\n            2 => WindowKey.Enter,\n            3 => WindowKey.Escape,\n            4 => WindowKey.Backspace,\n            5 => WindowKey.Delete,\n            6 => WindowKey.Left,\n            7 => WindowKey.Right,\n            8 => WindowKey.Up,\n            9 => WindowKey.Down,\n            10 => WindowKey.Home,\n            11 => WindowKey.End,\n            12 => WindowKey.PageUp,\n            13 => WindowKey.PageDown,\n            14 => WindowKey.Space,\n            _ => WindowKey.Other(truncate<u32>(code)),\n        };\n    }\n\n    fn modifiersOf(code: i32) -> WindowModifiers {\n        let bits = truncate<u32>(code);\n        return WindowModifiers {\n            shift: (bits & 1) != 0,\n            control: (bits & 2) != 0,\n            alt: (bits & 4) != 0,\n            command: (bits & 8) != 0,\n        };\n    }\n\n    /// Closes the window.\n    /// Safety: the handle is this window's, and nothing uses it after the drop.\n    drop {\n        unsafe { ceesafe_window_close(this.raw); }\n    }\n}",
