        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Async I/O (type-system.md §40.4, ADR 0031): console output, sockets and files for tasks, over the hosted runtime's\n// ceesafe_async_* (runtime/hosted/ceesafe_rt_async.c). Each one that waits registers what wakes the task, then parks.\n// Hosted only. Timers, cancellation, the joins and AsyncSignal are lib/core's async.cee, in every profile (ADR 0039).\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_async_wait_writable(fd: i32);\n    @effects()\n    fn ceesafe_async_write(fd: i32, bytes: *u8, length: u64) -> i64;\n    @effects()\n    fn ceesafe_async_wait_readable(fd: i32);\n    @effects()\n    fn ceesafe_async_fd_waits() -> i32;\n    @effects()\n    fn ceesafe_async_fd_closing(fd: i32);\n    @effects()\n    fn ceesafe_async_tcp_listen(address: *u8, length: u64, port: u16) -> i64;\n    @effects()\n    fn ceesafe_async_tcp_port(fd: i32) -> i64;\n    @effects()\n    fn ceesafe_async_tcp_accept(fd: i32) -> i64;\n    @effects()\n    fn ceesafe_async_tcp_connect(address: *u8, length: u64, port: u16) -> i64;\n    @effects()\n    fn ceesafe_async_tcp_connected(fd: i32) -> i64;\n    @effects()\n    fn ceesafe_async_read(fd: i32, buffer: *mut u8, length: u64) -> i64;\n    @effects()\n    fn ceesafe_async_send(fd: i32, bytes: *u8, length: u64) -> i64;\n    @effects()\n    fn ceesafe_async_shutdown_write(fd: i32) -> i64;\n    @effects()\n    fn ceesafe_async_close(fd: i32);\n    @effects(sleep)\n    fn ceesafe_async_poll(fds: *i32, events: *u32, ready: *mut u32, count: u64, timeout: i64) -> i64;\n    @effects()\n    fn ceesafe_async_op_read(op: *mut void, fd: i32, buffer: *mut u8, length: u64) -> i64;\n    @effects()\n    fn ceesafe_async_op_send(op: *mut void, fd: i32, bytes: *u8, length: u64) -> i64;\n    @effects()\n    fn ceesafe_async_op_accept(op: *mut void, fd: i32) -> i64;\n    @effects()\n    fn ceesafe_async_op_connect(op: *mut void, address: *u8, length: u64, port: u16) -> i64;\n   