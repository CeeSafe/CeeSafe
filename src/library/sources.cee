s.count + room;\n        var n: u64 = 0;\n        while (r > 0) {\n            r -= 1;\n            n += (this.digits[r] as u64) << k;\n            let quotient = n / 10;\n            let remainder = n - 10 * quotient;\n            w -= 1;\n            if (w < 800) {\n                this.digits[w] = truncate<u8>(remainder);\n            } else if (remainder != 0) {\n                this.truncated = true;\n            }\n            n = quotient;\n        }\n        while (n > 0) {\n            let quotient = n / 10;\n            let remainder = n - 10 * quotient;\n            w -= 1;\n            if (w < 800) {\n                this.digits[w] = truncate<u8>(remainder);\n            } else if (remainder != 0) {\n                this.truncated = true;\n            }\n            n = quotient;\n        }\n        let end = (this.count + room).min(800);\n        for (k2 in w..end) {\n            this.digits[k2 - w] = this.digits[k2];\n        }\n        this.count = end - w;\n        this.point += truncate<i32>(room) - truncate<i32>(w);\n        this.trim();\n    }\n\n    /// Divides by 2^k, 1 ≤ k ≤ 60: long division from the first digit.\n    fn shiftRight(borrow mut this, k: u32) {\n        var r: usize = 0;\n        var w: usize = 0;\n        var n: u64 = 0;\n        while ((n >> k) == 0) {\n            if (r >= this.count) {\n                if (n == 0) {\n                    this.count = 0;\n                    this.point = 0;\n                    return;\n                }\n                while ((n >> k) == 0) {\n                    n = n * 10;\n                    r += 1;\n                }\n                break;\n            }\n            n = n * 10 + (this.digits[r] as u64);\n            r += 1;\n        }\n        this.point -= truncate<i32>(r) - 1;\n        let mask = (1u64 << k) - 1;\n        while (r < this.count) {\n            let digit = n >> k;\n            n = n & mask;\n            this.digits[w] = truncate<u8>(digit);\n            w += 1;\n      