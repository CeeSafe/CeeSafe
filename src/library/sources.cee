        " }\n\n    /// The kind of text the focused field takes (ADR 0157): which soft keyboard `setTextInput(true)` shows on iOS and\n    /// Android, at once when it is already shown; for `Password`, the input method neither learns nor suggests.\n    /// Desktop systems ignore it.\n    /// Safety: the runtime only reads the number.\n    public fn setTextInputKind(borrow mut this, kind: WindowTextKind) {\n        let number = match (kind) {\n            WindowTextKind.Text => 0,\n            WindowTextKind.Number => 1,\n            WindowTextKind.Decimal => 2,\n            WindowTextKind.Email => 3,\n            WindowTextKind.Url => 4,\n            WindowTextKind.Password => 5,\n        };\n        unsafe { ceesafe_window_set_text_kind(this.raw, number); }\n    }\n\n    /// What the soft keyboard's Return key says in the focused field (ADR 0161), on iOS and Android, at once when the\n    /// keyboard is shown. It changes the key's face only: the key is `Key.Enter`, and what Enter does is the\n    /// program's. Desktop systems ignore it.\n    /// Safety: the runtime only reads the number.\n    public fn setReturnKey(borrow mut this, key: WindowReturnKey) {\n        let number = match (key) {\n            WindowReturnKey.Default => 0,\n            WindowReturnKey.Done => 1,\n            WindowReturnKey.Go => 2,\n            WindowReturnKey.Next => 3,\n            WindowReturnKey.Search => 4,\n            WindowReturnKey.Send => 5,\n        };\n        unsafe { ceesafe_window_set_return_key(this.raw, number); }\n    }\n\n    /// The window's elements for a screen reader, in reading order, replacing the last list whole (ADR 0164). `text`\n    /// holds the names and values the nodes' ranges point into. The runtime copies both, compares the list with the\n    /// last by `id`, and tells the system what was added, removed, renamed, moved, or changed value, state or focus.\n    /// A range outside `text`, a caret or anchor outside its value, an `id` of 0, an `id` given twice, and a\n    /// `parent` that is not a container before the element in the list (ADR 0207) are panics. Where the system's\n    /// part is not there yet, and when memory runs out, the last list stays; where it has no containers yet, they\n    /// are left out and what they hold is the window's.\n    /// Safety: the runtime reads fourteen words for each node and `text.length` bytes during the call.\n    public fn setAccessNodes(borrow mut this, nodes: Slice<WindowAccessNode>, text: Slice<u8>) {\n        if (nodes.length > 0x7FFFFFFF || text.length > 0x7FFFFFFF) {\n            panic(\"Window.setAccessNodes: a list or a text longer than 2^31\");\n        }\n        var raw = match (Vector<u64>.withCapacity(nodes.length * 14)) {\n            Ok(v) => v,\n            Err(_) => { return; }\n        };\n        let limit = text.length as u64;\n        for (n in nodes) {\n            if (n.id == 0) {\n                panic(\"Window.setAccessNodes: an element's id is 0\");\n            }\n            if ((n.labelStart as u64) + (n.labelLength as u64) > limit ||\n                (n.valueStart as u64) + (n.valueLength as u64) > limit) {\n                panic(\"Window.setAccessNodes: an element's label or value is outside the text\");\n            }\n            if (n.caret > n.valueLength || n.anchor > n.valueLength) {\n                panic(\"Window.setAccessNodes: an element's caret or anchor is outside its value\");\n            }\n            let role: u32 = match (n.role) {\n                WindowAccessRole.Text => 0,\n                WindowAccessRole.Button => 1,\n                WindowAccessRole.Checkbox => 2,\n                WindowAccessRole.Radio => 3,\n                WindowAccessRole.TextField => 4,\n                WindowAccessRole.Slider => 5,\n                WindowAccessRole.Tab => 6,\n                WindowAccessRole.ListItem => 7,\n                WindowAccessRole.MenuItem => 8,\n                WindowAccessRole.Dropdown => 9,\n                WindowAccessRole.Image => 10,\n                WindowAccessRole.Group => 11,\n                Window",
