    77 =>
        "// Checksums and hashes (ADR 0075 §2.5): CRC-32C, CRC-64/NVME, MD5, SHA-256 and HMAC-SHA-256, in pure CeeSafe. Each is\n// incremental (`create`, `update`, `finish`) and has a one-call `of`. The CRC tables and the round constants are in\n// checksum_tables.cee, which tools/gen_checksums.py writes. The CRCs are table-driven, slicing-by-8. Crc32c uses the\n// CPU's CRC-32C instruction where the runtime finds one (ADR 0089), with the same results and the same API.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_crc32c_available() -> u32;\n    @effects()\n    fn ceesafe_crc32c_update(crc: u32, bytes: *u8, length: u64) -> u32;\n}\n\n/// CRC-32C (Castagnoli: polynomial 0x1EDC6F41, reflected, initial value and final XOR all ones), the checksum of\n/// iSCSI, ext4, Btrfs and the S3 `x-amz-checksum-crc32c` header. `Crc32c.of(\"123456789\".bytes())` is 0xE3069283.\npublic struct Crc32c {\n    state: u32; // the register, before the final XOR\n\n    /// A checksum of no bytes yet.\n    public fn create() -> Crc32c => Crc32c { state: 0xFFFFFFFF };\n\n    /// Feeds `bytes`: through the CPU's CRC-32C instruction where it has one (SSE4.2 on x86-64, the CRC extension on\n    /// AArch64; ADR 0089), else eight at a time through the slicing tables, then the rest one at a time.\n    /// Safety: the runtime reads at most the slice's length, during the call only, and keeps no pointer.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        if (unsafe { ceesafe_crc32c_available() } != 0) {\n            this.state = unsafe { ceesafe_crc32c_update(this.state, bytes.ptr, bytes.length as u64) };\n            return;\n        }\n        var c = this.state;\n        var i: usize = 0;\n        let n = bytes.length;\n        while (n - i >= 8) {\n            let lo = c ^ bytes.readLE<u32>(i);\n            let hi = bytes.readLE<u32>(i + 4);\n            c = CRC32C_SLICES[7 * 256 + (lo & 0xFF) as usize] ^ CRC32C_SLICES[6 * 256 + ((lo >> 8) & 0xFF) as usize] ^\n                CRC32C_SLICES[5 * 256 + ((lo >> 16) & 0xFF) as usize] ^ CRC32C_SLICES[4 * 256 + (lo >> 24) as usize] ^\n                CRC32C_SLICES[3 * 256 + (hi & 0xFF) as usize] ^ CRC32C_SLICES[2 * 256 + ((hi >> 8) & 0xFF) as usize] ^\n                CRC32C_SLICES[256 + ((hi >> 16) & 0xFF) as usize] ^ CRC32C_SLICES[(hi >> 24) as usize];\n            i += 8;\n        }\n        while (i < n) {\n            c = CRC32C_SLICES[((c ^ bytes[i] as u32) & 0xFF) as usize] ^ (c >> 8);\n            i += 1;\n        }\n        this.state = c;\n    }\n\n    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> u32 => this.state ^ 0xFFFFFFFF;\n\n    /// The checksum of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> u32 {\n        var c = Crc32c.create();\n        c.update(bytes);\n        return c.finish();\n    }\n}\n\n/// CRC-64/NVME (polynomial 0xAD93D23594C93659, reflected, initial value and final XOR all ones), the checksum of the\n/// S3 `x-amz-checksum-crc64nvme` header. `Crc64Nvme.of(\"123456789\".bytes())` is 0xAE8B14860A799888.\npublic struct Crc64Nvme {\n    state: u64; // the register, before the final XOR\n\n    /// A checksum of no bytes yet.\n    public fn create() -> Crc64Nvme => Crc64Nvme { state: 0xFFFFFFFFFFFFFFFF };\n\n    /// Feeds `bytes`: eight at a time through the slicing tables, then the rest one at a time.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        var c = this.state;\n        var i: usize = 0;\n        let n = bytes.length;\n        while (n - i >= 8) {\n            let w = c ^ bytes.readLE<u64>(i);\n            c = CRC64_NVME_SLICES[7 * 256 + (w & 0xFF) as usize] ^\n                CRC64_NVME_SLICES[6 * 256 + ((w >> 8) & 0xFF) as usize] ^\n                CRC64_NVME_SLICES[5 * 256 + ((w >> 16) & 0xFF) as usize] ^\n                CRC64_NVME_SLICES[4 * 256 + ((w >> 24) & 0xFF) as usize] ^\n                CRC64_NVME_SLICES[3 * 256 + ((w >> 32) & 0xFF) as usize] ^\n                CRC64_NVME_SLICES[2 * 256 + ((w >> 40) & 0xFF) ",
    78 =>
        "as usize] ^\n                CRC64_NVME_SLICES[256 + ((w >> 48) & 0xFF) as usize] ^ CRC64_NVME_SLICES[(w >> 56) as usize];\n            i += 8;\n        }\n        while (i < n) {\n            c = CRC64_NVME_SLICES[((c ^ bytes[i] as u64) & 0xFF) as usize] ^ (c >> 8);\n            i += 1;\n        }\n        this.state = c;\n    }\n\n    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> u64 => this.state ^ 0xFFFFFFFFFFFFFFFF;\n\n    /// The checksum of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> u64 {\n        var c = Crc64Nvme.create();\n        c.update(bytes);\n        return c.finish();\n    }\n}\n\n/// MD5 (RFC 1321): a 16-byte digest. **MD5 is broken as a signature**: collisions are cheap to make, so it must\n/// never authenticate anything or stand for a value an attacker chooses. It is here for S3 ETags and `Content-MD5`\n/// only, which detect accidental corruption. For anything else use Sha256 or HmacSha256.\npublic struct Md5 {\n    state: [u32; 4];\n    block: [u8; 64]; // a partial block of `used` bytes\n    used: usize;\n    length: u64; // bytes fed, modulo 2^64\n\n    /// A digest of no bytes yet.\n    public fn create() -> Md5 => Md5 {\n        state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476],\n        block: [0u8; 64],\n        used: 0,\n        length: 0,\n    };\n\n    /// Compresses the 64 bytes at `at` of `data` into `state` (RFC 1321 §3.4).\n    fn compress(state: borrow mut [u32; 4], data: Slice<u8>, at: usize) {\n        let block = data[at..at + 64];\n        var m = [0u32; 16];\n        for (k in 0..16usize) {\n            m[k] = block.readLE<u32>(4 * k);\n        }\n        var a = state[0];\n        var b = state[1];\n        var c = state[2];\n        var d = state[3];\n        for (i in 0..16usize) {\n            let f = (b & c) | ((b ^ 0xFFFFFFFF) & d);\n            let s: u32 = match (i & 3) {\n                0 => 7,\n                1 => 12,\n                2 => 17,\n                _ => 22,\n            };\n            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[i]);\n            a = d;\n            d = c;\n            c = b;\n            b = b.wrappingAdd(t.rotateLeft(s));\n        }\n        for (i in 16..32usize) {\n            let f = (d & b) | ((d ^ 0xFFFFFFFF) & c);\n            let s: u32 = match (i & 3) {\n                0 => 5,\n                1 => 9,\n                2 => 14,\n                _ => 20,\n            };\n            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[(5 * i + 1) & 15]);\n            a = d;\n            d = c;\n            c = b;\n            b = b.wrappingAdd(t.rotateLeft(s));\n        }\n        for (i in 32..48usize) {\n            let f = b ^ c ^ d;\n            let s: u32 = match (i & 3) {\n                0 => 4,\n                1 => 11,\n                2 => 16,\n                _ => 23,\n            };\n            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[(3 * i + 5) & 15]);\n            a = d;\n            d = c;\n            c = b;\n            b = b.wrappingAdd(t.rotateLeft(s));\n        }\n        for (i in 48..64usize) {\n            let f = c ^ (b | (d ^ 0xFFFFFFFF));\n            let s: u32 = match (i & 3) {\n                0 => 6,\n                1 => 10,\n                2 => 15,\n                _ => 21,\n            };\n            let t = a.wrappingAdd(f).wrappingAdd(MD5_SINES[i]).wrappingAdd(m[(7 * i) & 15]);\n            a = d;\n            d = c;\n            c = b;\n            b = b.wrappingAdd(t.rotateLeft(s));\n        }\n        state[0] = state[0].wrappingAdd(a);\n        state[1] = state[1].wrappingAdd(b);\n        state[2] = state[2].wrappingAdd(c);\n        state[3] = state[3].wrappingAdd(d);\n    }\n\n    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        let n = bytes.length;\n        var k: usize = 0;\n        this.length = this.length.wr",
    79 =>
        "appingAdd(n as u64);\n        if (this.used > 0) {\n            while (this.used < 64 && k < n) {\n                this.block[this.used] = bytes[k];\n                this.used += 1;\n                k += 1;\n            }\n            if (this.used < 64) {\n                return;\n            }\n            Md5.compress(mut this.state, this.block[..], 0);\n            this.used = 0;\n        }\n        while (n - k >= 64) {\n            Md5.compress(mut this.state, bytes, k);\n            k += 64;\n        }\n        while (k < n) {\n            this.block[this.used] = bytes[k];\n            this.used += 1;\n            k += 1;\n        }\n    }\n\n    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> [u8; 16] {\n        var h = Md5 { state: this.state, block: this.block, used: this.used, length: this.length };\n        let bits = this.length.wrappingMul(8);\n        var pad = [0u8; 72];\n        pad[0] = 0x80;\n        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;\n        for (k in 0..8usize) {\n            pad[zeros + k] = truncate<u8>(bits >> (8 * k as u64));\n        }\n        h.update(pad[..zeros + 8]);\n        var digest = [0u8; 16];\n        for (k in 0..4usize) {\n            digest[..].writeLE(4 * k, h.state[k]);\n        }\n        return digest;\n    }\n\n    /// The digest of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> [u8; 16] {\n        var h = Md5.create();\n        h.update(bytes);\n        return h.finish();\n    }\n}\n\n/// SHA-256 (FIPS 180-4): a 32-byte digest.\npublic struct Sha256 {\n    state: [u32; 8];\n    block: [u8; 64]; // a partial block of `used` bytes\n    used: usize;\n    length: u64; // bytes fed, modulo 2^64\n\n    /// A digest of no bytes yet.\n    public fn create() -> Sha256 => Sha256 {\n        state: [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19],\n        block: [0u8; 64],\n        used: 0,\n        length: 0,\n    };\n\n    /// Compresses the 64 bytes at `at` of `data` into `state` (FIPS 180-4 §6.2.2).\n    fn compress(state: borrow mut [u32; 8], data: Slice<u8>, at: usize) {\n        let block = data[at..at + 64];\n        var w = [0u32; 64];\n        for (t in 0..16usize) {\n            w[t] = block.readBE<u32>(4 * t);\n        }\n        for (t in 16..64usize) {\n            let x = w[t - 15];\n            let y = w[t - 2];\n            let s0 = x.rotateRight(7) ^ x.rotateRight(18) ^ (x >> 3);\n            let s1 = y.rotateRight(17) ^ y.rotateRight(19) ^ (y >> 10);\n            w[t] = w[t - 16].wrappingAdd(s0).wrappingAdd(w[t - 7]).wrappingAdd(s1);\n        }\n        var a = state[0];\n        var b = state[1];\n        var c = state[2];\n        var d = state[3];\n        var e = state[4];\n        var f = state[5];\n        var g = state[6];\n        var h = state[7];\n        for (t in 0..64usize) {\n            let s1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25);\n            let choice = (e & f) ^ ((e ^ 0xFFFFFFFF) & g);\n            let t1 = h.wrappingAdd(s1).wrappingAdd(choice).wrappingAdd(SHA256_ROUNDS[t]).wrappingAdd(w[t]);\n            let s0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22);\n            let majority = (a & b) ^ (a & c) ^ (b & c);\n            h = g;\n            g = f;\n            f = e;\n            e = d.wrappingAdd(t1);\n            d = c;\n            c = b;\n            b = a;\n            a = t1.wrappingAdd(s0.wrappingAdd(majority));\n        }\n        state[0] = state[0].wrappingAdd(a);\n        state[1] = state[1].wrappingAdd(b);\n        state[2] = state[2].wrappingAdd(c);\n        state[3] = state[3].wrappingAdd(d);\n        state[4] = state[4].wrappingAdd(e);\n        state[5] = state[5].wrappingAdd(f);\n        state[6] = state[6].wrappingAdd(g);\n        state[7] = state[7].wrappingAdd(h);\n    }\n\n    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.\n    public fn update(borrow mut th",
    80 =>
        "is, bytes: Slice<u8>) {\n        let n = bytes.length;\n        var k: usize = 0;\n        this.length = this.length.wrappingAdd(n as u64);\n        if (this.used > 0) {\n            while (this.used < 64 && k < n) {\n                this.block[this.used] = bytes[k];\n                this.used += 1;\n                k += 1;\n            }\n            if (this.used < 64) {\n                return;\n            }\n            Sha256.compress(mut this.state, this.block[..], 0);\n            this.used = 0;\n        }\n        while (n - k >= 64) {\n            Sha256.compress(mut this.state, bytes, k);\n            k += 64;\n        }\n        while (k < n) {\n            this.block[this.used] = bytes[k];\n            this.used += 1;\n            k += 1;\n        }\n    }\n\n    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> [u8; 32] {\n        var h = Sha256 { state: this.state, block: this.block, used: this.used, length: this.length };\n        let bits = this.length.wrappingMul(8);\n        var pad = [0u8; 72];\n        pad[0] = 0x80;\n        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;\n        for (k in 0..8usize) {\n            pad[zeros + k] = truncate<u8>(bits >> (8 * (7 - k) as u64));\n        }\n        h.update(pad[..zeros + 8]);\n        var digest = [0u8; 32];\n        for (k in 0..8usize) {\n            digest[..].writeBE(4 * k, h.state[k]);\n        }\n        return digest;\n    }\n\n    /// The digest of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> [u8; 32] {\n        var h = Sha256.create();\n        h.update(bytes);\n        return h.finish();\n    }\n}\n\n/// HMAC-SHA-256 (RFC 2104, FIPS 198-1): a 32-byte message authentication code under a key of any length. A key longer\n/// than SHA-256's 64-byte block is first replaced by its SHA-256. Compare two codes in constant time, not with an\n/// early exit, where an attacker can time the comparison.\npublic struct HmacSha256 {\n    inner: Sha256;      // fed the inner padded key, then the message\n    outerKey: [u8; 64]; // the key, padded to a block, XOR 0x5C\n\n    /// A code under `key` of no bytes yet.\n    public fn create(key: Slice<u8>) -> HmacSha256 {\n        var padded = [0u8; 64];\n        if (key.length > 64) {\n            let digest = Sha256.of(key);\n            for (k in 0..32usize) {\n                padded[k] = digest[k];\n            }\n        } else {\n            for (k in 0..key.length) {\n                padded[k] = key[k];\n            }\n        }\n        var innerKey = [0u8; 64];\n        var outerKey = [0u8; 64];\n        for (k in 0..64usize) {\n            innerKey[k] = padded[k] ^ 0x36;\n            outerKey[k] = padded[k] ^ 0x5C;\n        }\n        var inner = Sha256.create();\n        inner.update(innerKey[..]);\n        return HmacSha256 { inner: inner, outerKey: outerKey };\n    }\n\n    /// Feeds `bytes` of the message.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        this.inner.update(bytes);\n    }\n\n    /// The code of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> [u8; 32] {\n        let inner = this.inner.finish();\n        var outer = Sha256.create();\n        outer.update(this.outerKey[..]);\n        outer.update(inner[..]);\n        return outer.finish();\n    }\n\n    /// The code of `bytes` under `key`, in one call.\n    public fn of(key: Slice<u8>, bytes: Slice<u8>) -> [u8; 32] {\n        var h = HmacSha256.create(key);\n        h.update(bytes);\n        return h.finish();\n    }\n}\n",
