        "rs += 1;\n            }\n        }\n        let pad = if (width > characters) width - characters else 0;\n        let before = match (align) {\n            TextAlign.Left => 0,\n            TextAlign.Right => pad,\n            TextAlign.Center => pad / 2,\n        };\n        var encoded = [0u8; 4];\n        let size = Formatted.encode(fill, mut encoded[..]);\n        for (k in 0..before) {\n            out.extend(encoded[..size])?;\n        }\n        out.extend(text.bytes())?;\n        for (k in 0..(pad - before)) {\n            out.extend(encoded[..size])?;\n        }\n        return Ok();\n    }\n\n    /// The UTF-8 bytes of `c` in `to`, and how many; panics if `c` is not a Unicode scalar value.\n    fn encode(c: u32, to: SliceMut<u8>) -> usize {\n        assert(c < 0x110000 && (c < 0xD800 || c > 0xDFFF), \"the fill is not a Unicode scalar value\");\n        if (c < 0x80) {\n            to[0] = truncate<u8>(c);\n            return 1;\n        }\n        if (c < 0x800) {\n            to[0] = truncate<u8>(0xC0 | (c >> 6));\n            to[1] = truncate<u8>(0x80 | (c & 0x3F));\n            return 2;\n        }\n        if (c < 0x10000) {\n            to[0] = truncate<u8>(0xE0 | (c >> 12));\n            to[1] = truncate<u8>(0x80 | ((c >> 6) & 0x3F));\n            to[2] = truncate<u8>(0x80 | (c & 0x3F));\n            return 3;\n        }\n        to[0] = truncate<u8>(0xF0 | (c >> 18));\n        to[1] = truncate<u8>(0x80 | ((c >> 12) & 0x3F));\n        to[2] = truncate<u8>(0x80 | ((c >> 6) & 0x3F));\n        to[3] = truncate<u8>(0x80 | (c & 0x3F));\n        return 4;\n    }\n}\n\n/// `s.appendHex(…)` and the other helpers (ADR 0087 §2.9), through `Formatted`: implemented here for a `Vector<u8>`,\n/// and in lib/std for a `String`. Each appends ASCII, or for `appendPadded` the text and its fill, so a string stays\n/// UTF-8.\npublic interface AppendFormatted {\n    /// `value` in hexadecimal, at least `minWidth` digits, uppercase when `upper`: Rust's `{:x}`, `{:08X}`.\n    fn appendHex(borrow mut this, value: u64, minWidth: u32, upper: bool) -> Result<void, AllocError>;\n    /// `value` in octal: Rust's `{:o}`.\n    fn appendOctal(borrow mut this, value: u64) -> Result<void, AllocError>;\n    /// `value` with `digits` digits after the point, rounded half to even: Rust's `{:.N}`.\n    fn appendFixed(borrow mut this, value: f64, digits: u32) -> Result<void, AllocError>;\n    /// `text` in a field `width` characters wide, filled with `fill` where `align` puts it: Rust's `{:>8}`, `{:*^9}`.\n    fn appendPadded(\n        borrow mut this,\n        text: StringView,\n        width: usize,\n        align: TextAlign,\n        fill: u32,\n    ) -> Result<void, AllocError>;\n}\n\nimpl AppendFormatted for Vector<u8> {\n    fn appendHex(borrow mut this, value: u64, minWidth: u32, upper: bool) -> Result<void, AllocError> =>\n        Formatted.hex(this, value, minWidth, upper);\n\n    fn appendOctal(borrow mut this, value: u64) -> Result<void, AllocError> => Formatted.octal(this, value);\n\n    fn appendFixed(borrow mut this, value: f64, digits: u32) -> Result<void, AllocError> =>\n        Formatted.fixed(this, value, digits);\n\n    fn appendPadded(\n        borrow mut this,\n        text: StringView,\n        width: usize,\n        align: TextAlign,\n        fill: u32,\n    ) -> Result<void, AllocError> =>\n        Formatted.padded(this, text, width, align, fill);\n}\n\n/// `s.appendChar(c)` and `s.appendUtf8(bytes)` (ADR 0138 §6): text added a character, or a run of bytes, at a time.\n/// Implemented here for a `Vector<u8>`, and in lib/std for a `String`, which stays UTF-8: a character is encoded\n/// straight in, and bytes are checked once, with no copy before they are appended.\npublic interface AppendText {\n    /// The character `c` in UTF-8. False, appending nothing, if `c` is not a Unicode scalar value (a surrogate, from\n    /// 0xD800 to 0xDFFF, or past 0x10FFFF).\n    fn appendChar(borrow mut this, c: u32) -> Result<bool, AllocError>;\n    /// `bytes`, when they are UTF-8 (the Unicode Standard's Table 3-7, as `StringView.",
