    31 =>
        "hout a word.\n    /// Safety: the listing is closed on every path out (`defer`), and each name is copied before the next call\n    /// reuses the runtime's buffer.\n    public fn list(path: StringView) -> Result<Vector<String>, IoError> {\n        var error: i32 = 0;\n        let listing = unsafe { ceesafe_host_dir_open(path.ptr, path.length as u64, borrow mut error as *mut i32) };\n        if (listing.isNull()) {\n            return Err(HostServices.hostError(0 - (error as i64)));\n        }\n        defer {\n            unsafe { ceesafe_host_dir_close(listing); }\n        }\n        var names = Vector<String>.create();\n        loop {\n            var name = 0 as *u8;\n            var length: u64 = 0;\n            let next = unsafe { ceesafe_host_dir_next(\n                listing,\n                borrow mut name as *mut (*u8),\n                borrow mut length as *mut u64,\n            ) };\n            if (next == 0) {\n                break;\n            }\n            if (next < 0) {\n                return Err(HostServices.hostError(next));\n            }\n            let bytes = unsafe { Slice.fromRaw(name, truncate<usize>(length)) };\n            let text = match (StringView.fromUtf8(bytes)) {\n                Some(t) => t,\n                null => { return Err(IoError.InvalidInput); }\n            };\n            let copy = HostServices.stringOrIoError(HostServices.copyText(text))?;\n            HostServices.pushed(names.push(copy))?;\n        }\n        // An insertion sort rather than sortBy: an instance of lib/core's generic sort made here would be emitted in every\n        // hosted program, used or not.\n        for (i in 1..names.length) {\n            var j = i;\n            while (j > 0 && HostServices.compareText(names[j - 1], names[j]) > 0) {\n                names.swap(j - 1, j);\n                j -= 1;\n            }\n        }\n        return Ok(names);\n    }\n\n    /// A new, empty directory that only this user can enter, under the platform's temporary directory. The caller\n    /// removes it.\n    /// Safety: the runtime writes at most the buffer's length.\n    public fn temporary() -> Result<String, IoError> {\n        var buffer = [0u8; 4096];\n        let length = unsafe { ceesafe_host_temporary(borrow mut buffer[0] as *mut u8, 4096) };\n        return HostServices.textOf(buffer, length);\n    }\n\n    /// The working directory.\n    /// Safety: the runtime writes at most the buffer's length.\n    public fn current() -> Result<String, IoError> {\n        var buffer = [0u8; 4096];\n        let length = unsafe { ceesafe_host_current(borrow mut buffer[0] as *mut u8, 4096) };\n        return HostServices.textOf(buffer, length);\n    }\n}\n\n/// A program's argument as the runtime's `cee_str` (a struct is laid out by C's rules, type-system §12; not @repr(C), which would put it in every program's ceesafe_exports.h).\nstruct HostServicesText {\n    ptr: *u8;\n    len: u64;\n}\n\n/// The functions behind `Process.capture` and `File.kind`.\npublic struct HostServices {\n    /// `Process.capture(program, arguments, input)` (type-system.md §26.7): runs `program`, found on `PATH`, with\n    /// `arguments`, `input` as its standard input (empty if null), and returns its exit status and what it wrote to\n    /// standard output and standard error. The streams go through files in a private temporary directory, removed\n    /// before this returns, so a program that writes much to both cannot block (ADR 0028).\n    public fn capture(\n        program: StringView,\n        arguments: borrow Vector<StringView>,\n        input: Slice<u8>?,\n    ) -> Result<ProcessOutput, IoError> {\n        let directory = Directory.temporary()?;\n        let result = HostServices.captureIn(directory.view(), program, arguments, input);\n        HostServices.clean(directory.view());\n        return result;\n    }\n\n    /// `File.kind(path)` (type-system.md §26.8): what is at `path`, following symbolic links, or null if nothing is.\n    /// Safety: the runtime reads the path's bytes during the call only.\n    public",
    32 =>
        " fn kind(path: StringView) -> Result<PathKind?, IoError> {\n        let kind = unsafe { ceesafe_host_path_kind(path.ptr, path.length as u64) };\n        return match (kind) {\n            0 => Ok(null),\n            1 => Ok(PathKind.File),\n            2 => Ok(PathKind.Directory),\n            _ => if (kind < 0) Err(HostServices.hostError(kind)) else Ok(PathKind.Other),\n        };\n    }\n\n    /// Safety: `texts` holds a view per argument and outlives the call; the runtime reads it and the paths during\n    /// the call only.\n    fn captureIn(\n        directory: StringView,\n        program: StringView,\n        arguments: borrow Vector<StringView>,\n        input: Slice<u8>?,\n    ) -> Result<ProcessOutput, IoError> {\n        let inPath = HostServices.stringOrIoError(HostServices.pathIn(directory, \"in\"))?;\n        let outPath = HostServices.stringOrIoError(HostServices.pathIn(directory, \"out\"))?;\n        let errPath = HostServices.stringOrIoError(HostServices.pathIn(directory, \"err\"))?;\n        var file = File.create(inPath.view())?;\n        match (input) {\n            Some(bytes) => { file.write(bytes)?; }\n            null => {}\n        }\n        var texts = Vector<HostServicesText>.create();\n        HostServices.pushed(texts.push(unsafe { HostServicesText { ptr: program.ptr, len: program.length as u64 } }))?;\n        for (argument in arguments) {\n            HostServices.pushed(\n                texts.push(unsafe { HostServicesText { ptr: argument.ptr, len: argument.length as u64 } }),\n            )?;\n        }\n        let status = unsafe { ceesafe_host_spawn(\n            texts.view().ptr as *void,\n            texts.length as u64,\n            inPath.view().ptr,\n            inPath.length as u64,\n            outPath.view().ptr,\n            outPath.length as u64,\n            errPath.view().ptr,\n            errPath.length as u64,\n        ) };\n        if (status < 0) {\n            return Err(HostServices.hostError(status));\n        }\n        return Ok(\n            ProcessOutput {\n                status: truncate<i32>(status),\n                stdout: HostServices.readAll(outPath.view())?,\n                stderr: HostServices.readAll(errPath.view())?,\n            },\n        );\n    }\n\n    /// Removes the three files and the directory, ignoring what is not there.\n    fn clean(directory: StringView) {\n        for (k in 0..3) {\n            let name: StringView = match (k) {\n                0 => \"in\",\n                1 => \"out\",\n                _ => \"err\",\n            };\n            match (HostServices.pathIn(directory, name)) {\n                Ok(path) => { let removed = File.remove(path.view()); }\n                Err(_) => {}\n            }\n        }\n        let removed = Directory.remove(directory);\n    }\n\n    // The helpers below are this struct's, not lib/std's top-level names: every hosted package shares those, so a\n    // top-level `pathIn` or `readAll` here would clash with a program's own (N0201; fixed after 0.4.0).\n\n    /// The text of a runtime call that wrote `length` bytes into `buffer`, or its error.\n    fn textOf(buffer: [u8; 4096], length: i64) -> Result<String, IoError> {\n        if (length < 0) {\n            return Err(HostServices.hostError(length));\n        }\n        let bytes = buffer;\n        let text = match (StringView.fromUtf8(bytes[..truncate<usize>(length)])) {\n            Some(t) => t,\n            null => { return Err(IoError.InvalidInput); }\n        };\n        return HostServices.stringOrIoError(HostServices.copyText(text));\n    }\n\n    /// `directory/name`.\n    fn pathIn(directory: StringView, name: StringView) -> Result<String, AllocError> {\n        var path = String.create();\n        path.append(directory)?;\n        path.append(\"/\")?;\n        path.append(name)?;\n        return Ok(path);\n    }\n\n    fn copyText(text: StringView) -> Result<String, AllocError> {\n        var copy = String.create();\n        copy.append(text)?;\n        return Ok(copy);\n    }\n\n    fn stringOrIoError(result: Result<String, AllocError>) -> Result",
