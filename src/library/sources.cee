        ",\n};\n\nfn code(order: Ordering) -> i32 => match (order) {\n    Ordering.Relaxed => 0,\n    Ordering.Acquire => 1,\n    Ordering.Release => 2,\n    Ordering.AcquireRelease => 3,\n    Ordering.SequentiallyConsistent => 4,\n};\n\n/// A u64 that threads may read and change at once: every operation is atomic and sequentially consistent.\n@threadSafe\n@noncopy\npublic struct AtomicU64 {\n    private value: u64;\n\n    /// A new atomic holding `value`.\n    public fn create(value: u64) -> AtomicU64 => AtomicU64 { value: value };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU64 = AtomicU64.constant(0);`.\n    @constant\n    public fn constant(value: u64) -> AtomicU64 => AtomicU64 { value: value };\n\n    /// Safety: the runtime accesses `value` only atomically, and safe code reaches it only through these methods.\n    public fn load(borrow this) -> u64 => unsafe { ceesafe_atomic_load_u64(this.cell()) };\n\n    /// Safety: as load.\n    public fn store(borrow this, value: u64) { unsafe { ceesafe_atomic_store_u64(this.cell(), value); } }\n\n    /// Safety: as load.\n    public fn swap(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_swap_u64(this.cell(), value) };\n\n    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).\n    /// Safety: as load.\n    public fn compareExchange(borrow this, expected: u64, desired: u64) -> Result<u64, u64> {\n        let old = unsafe { ceesafe_atomic_cas_u64(this.cell(), expected, desired) };\n        if (old == expected) {\n            return Ok(old);\n        }\n        return Err(old);\n    }\n\n    /// Adds, wrapping; returns the old value.\n    /// Safety: as load.\n    public fn fetchAdd(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_add_u64(this.cell(), value) };\n\n    /// Subtracts, wrapping; returns the old value.\n    /// Safety: as load.\n    public fn fetchSub(borrow this, value: u64) -> u64 =>\n        un