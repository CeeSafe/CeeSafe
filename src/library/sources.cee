 rest one at a time.\n    @effects()\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n     ",
    106 =>
        "   var a = this.a;\n        var b = this.b;\n        var i: usize = 0;\n        let n = bytes.length;\n        while (i < n) {\n            let end = if (n - i > 5552) i + 5552 else n;\n            while (end - i >= 8) {\n                a += bytes[i] as u32;\n                b += a;\n                a += bytes[i + 1] as u32;\n                b += a;\n                a += bytes[i + 2] as u32;\n                b += a;\n                a += bytes[i + 3] as u32;\n                b += a;\n                a += bytes[i + 4] as u32;\n                b += a;\n                a += bytes[i + 5] as u32;\n                b += a;\n                a += bytes[i + 6] as u32;\n                b += a;\n                a += bytes[i + 7] as u32;\n                b += a;\n                i += 8;\n            }\n            while (i < end) {\n                a += bytes[i] as u32;\n                b += a;\n                i += 1;\n            }\n            a %= 65521;\n            b %= 65521;\n        }\n        this.a = a;\n        this.b = b;\n    }\n\n    /// The checksum of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> u32 => (this.b << 16) | this.a;\n\n    /// The checksum of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> u32 {\n        var c = Adler32.create();\n        c.update(bytes);\n        return c.finish();\n    }\n}\n\nfn xxhPrime1() -> u64 => 0x9E3779B185EBCA87;\nfn xxhPrime2() -> u64 => 0xC2B2AE3D27D4EB4F;\nfn xxhPrime3() -> u64 => 0x165667B19E3779F9;\nfn xxhPrime4() -> u64 => 0x85EBCA77C2B2AE63;\nfn xxhPrime5() -> u64 => 0x27D4EB2F165667C5;\n\n/// One lane of XXH64's stripe: `acc` takes in 8 bytes.\n@effects()\nfn xxhRound(acc: u64, lane: u64) -> u64 =>\n    acc.wrappingAdd(lane.wrappingMul(xxhPrime2())).rotateLeft(31).wrappingMul(xxhPrime1());\n\n@effects()\nfn xxhMerge(acc: u64, v: u64) -> u64 => (acc ^ xxhRound(0, v)).wrappingMul(xxhPrime1()).wrappingAdd(xxhPrime4());\n\n/// XXH64 (xxHash's specification), a fast 64-bit hash with a seed: zstd's content checksum is the low 32 bits of the\n/// XXH64 of a frame's bytes with seed 0 (ADR 0196). `Xxh64.of(\"123456789\".bytes(), 0)` is 0x8CB841DB40E6AE83. It is\n/// not a cryptographic hash: anyone can make collisions, so it detects accidents only.\npublic struct Xxh64 {\n    v: [u64; 4]; // the four lanes' accumulators\n    seed: u64;\n    total: u64;       // bytes fed, modulo 2^64\n    buffer: [u8; 32]; // a partial stripe of `used` bytes\n    used: usize;\n\n    /// A hash of no bytes yet, with `seed`.\n    public fn create(seed: u64) -> Xxh64 => Xxh64 {\n        v: [\n            seed.wrappingAdd(xxhPrime1()).wrappingAdd(xxhPrime2()),\n            seed.wrappingAdd(xxhPrime2()),\n            seed,\n            seed.wrappingSub(xxhPrime1()),\n        ],\n        seed: seed,\n        total: 0,\n        buffer: [0u8; 32],\n        used: 0,\n    };\n\n    /// Takes in the 32-byte stripe at `at` of `data`.\n    @effects()\n    fn stripe(v: borrow mut [u64; 4], data: Slice<u8>, at: usize) {\n        v[0] = xxhRound(v[0], data.readLE<u64>(at));\n        v[1] = xxhRound(v[1], data.readLE<u64>(at + 8));\n        v[2] = xxhRound(v[2], data.readLE<u64>(at + 16));\n        v[3] = xxhRound(v[3], data.readLE<u64>(at + 24));\n    }\n\n    /// Feeds `bytes`: 32 at a time, the rest kept for the next call or `finish`.\n    @effects()\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        let n = bytes.length;\n        this.total = this.total.wrappingAdd(n as u64);\n        var i: usize = 0;\n        if (this.used > 0) {\n            let take = if (32 - this.used < n) 32 - this.used else n;\n            this.buffer[this.used..this.used + take].copyFrom(bytes[0..take]);\n            this.used += take;\n            i = take;\n            if (this.used < 32) { return; }\n            let stripe = this.buffer;\n            Xxh64.stripe(mut this.v, stripe[..], 0);\n            this.used = 0;\n   