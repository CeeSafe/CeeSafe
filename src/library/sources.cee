    111 =>
        "// Tests (ADR 0049): what a failed check returns, the checks, and the generated harness's side of the runner protocol.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_test_begin(failAllocAt: u64, cancelAt: u64);\n    @effects()\n    fn ceesafe_thread_watchdog(ms: u64);\n}\n\n/// What a failed check returns (ADR 0049 §3.2): a message, owned, so it borrows nothing from the test. `ceesafec test`\n/// shows it with the test's name.\npublic struct TestFailure {\n    public message: Vector<u8>;\n\n    /// A failure with `message`. If the message cannot be allocated, the failure has an empty one: it still fails.\n    public fn create(message: StringView) -> TestFailure {\n        var bytes = Vector<u8>.create();\n        for (b in message.bytes()) {\n            match (bytes.push(b)) {\n                Ok() => {}\n                Err(_) => { return TestFailure { message: bytes }; }\n            }\n        }\n        return TestFailure { message: bytes };\n    }\n\n    /// A failure with what `w` wrote.\n    fn written(w: borrow TextWriter) -> TestFailure {\n        var bytes = Vector<u8>.create();\n        for (b in w.written()) {\n            match (bytes.push(b)) {\n                Ok() => {}\n                Err(_) => { return TestFailure { message: bytes }; }\n            }\n        }\n        return TestFailure { message: bytes };\n    }\n}\n\n/// The checks of a test (ADR 0049 §3.2): each is `Ok` when it holds, and otherwise `Err` with what was expected, for\n/// `?`. The comparisons are typed: CeeSafe has no equality interface yet for a generic one.\npublic struct Check {\n    /// `condition` holds; `what` says what it is.\n    public fn isTrue(condition: bool, what: StringView) -> Result<void, TestFailure> {\n        if (condition) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected true: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `condition` does not hold.\n    public fn isFalse(condition: bool, what: StringView) -> Result<void, TestFailure> {\n        if (!condition) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected false: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is `expected`.\n    public fn equalU64(expected: u64, actual: u64) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 128];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \");\n        w.decimal(expected);\n        w.text(\", got \");\n        w.decimal(actual);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is `expected`.\n    public fn equalI64(expected: i64, actual: i64) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 128];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \");\n        w.signed(expected);\n        w.text(\", got \");\n        w.signed(actual);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is the text `expected`.\n    public fn equalText(expected: StringView, actual: StringView) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 1024];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \\\"\");\n        w.text(expected);\n        w.text(\"\\\", got \\\"\");\n        w.text(actual);\n        w.text(\"\\\"\");\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` has the bytes of `expected`; else where they first differ.\n    public fn equalBytes(expected: Slice<u8>, actual: Slice<u8>) -> Result<void, TestFailure> {\n        var at: usize = 0;\n        while (at < expected.length && at < actual.length && expected[at] == actual[at]) {\n            at +",
