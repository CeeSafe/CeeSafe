        " at once), then each to its end. False if one has\n/// no end mark or is not used up exactly.\n@effects()\nfn zstdHuffman4(\n    data: Slice<u8>,\n    bounds: [usize; 5],\n    table: Slice<u16>,\n    log: u32,\n    out: SliceMut<u8>,\n    segment: usize,\n    n: usize,\n) -> bool {\n    var b1 = match (ZstdBits.open(data, bounds[0], bounds[1])) {\n        Some(b) => b,\n        null => { return false; },\n    };\n    var b2 = match (ZstdBits.open(data, bounds[1], bounds[2])) {\n        Some(b) => b,\n        null => { return false; },\n    };\n    var b3 = match (ZstdBits.open(data, bounds[2], bounds[3])) {\n        Some(b) => b,\n        null => { return false; },\n    };\n    var b4 = match (ZstdBits.open(data, bounds[3], bounds[4])) {\n        Some(b) => b,\n        null => { return false; },\n    };\n    let shift = 64 - log;\n    var p: usize = 0; // each stream's position in its segment\n    let last = n - 3 * segment;\n    var x1 = b1.buf;\n    var x2 = b2.buf;\n    var x3 = b3.buf;\n    var x4 = b4.buf;\n    while (last - p >= 4 && b1.at - b1.start >= 8 && b2.at - b2.start >= 8 && b3.at - b3.start >= 8 &&\n        b4.at - b4.start >= 8) {\n        b1.buf = x1;\n        b2.buf = x2;\n        b3.buf = x3;\n        b4.buf = x4;\n        b1.refill(data);\n        b2.refill(data);\n        b3.refill(data);\n        b4.refill(data);\n        x1 = b1.buf;\n        x2 = b2.buf;\n        x3 = b3.buf;\n        x4 = b4.buf;\n        var used1: u32 = 0;\n        var used2: u32 = 0;\n        var used3: u32 = 0;\n        var used4: u32 = 0;\n        for (j in 0..4usize) {\n            let e1 = table[truncate<usize>(x1 >> shift)];\n            let e2 = table[truncate<usize>(x2 >> shift)];\n            let e3 = table[truncate<usize>(x3 >> shift)];\n            let e4 = table[truncate<usize>(x4 >> shift)];\n            let n1 = (e1 & 255) as u32;\n            let n2 = (e2 & 255) as u32;\n            let n3 = (e3 & 255) as u32;\n            let n4 = (e4 & 255) as u32;\n            x1 = x1 << n1;\n            x2 = x2 << n2;\n            x3 = x3 << n3;\n            x4 = x4 << n4;\n            used1 += n1;\n            used2 += n2;\n            used3 += n3;\n            used4 += n4;\n            out[p + j] = truncate<u8>(e1 >> 8);\n            out[segment + p + j] = truncate<u8>(e2 >> 8);\n            out[2 * segment + p + j] = truncate<u8>(e3 >> 8);\n            out[3 * segment + p + j] = truncate<u8>(e4 >> 8);\n        }\n        b1.count -= used1 as i64;\n        b2.count -= used2 as i64;\n        b3.count -= used3 as i64;\n        b4.count -= used4 as i64;\n        p += 4;\n    }\n    b1.buf = x1;\n    b2.buf = x2;\n    b3.buf = x3;\n    b4.buf = x4;\n    return zstdHuffmanTail(mut b1, data, table, log, out, p, segment) &&\n        zstdHuffmanTail(mut b2, data, table, log, out, segment + p, 2 * segment) &&\n        zstdHuffmanTail(mut b3, data, table, log, out, 2 * segment + p, 3 * segment) &&\n        zstdHuffmanTail(mut b4, data, table, log, out, 3 * segment + p, n);\n}\n\n// ---------------------------------------------------------------------------------------------------------------\n// Copies.\n\n/// Copies `length` bytes to `out[to..]` from `offset` bytes back, where the ranges may overlap, with room for 8 bytes\n/// past the copy (written over by what follows): eight at a time from `offset` back when that is 8 or more; one value\n/// when it is 1; else the first 8 bytes one at a time, then eight at a time from the least multiple of `offset` that\n/// is 8 or more back, since the copy repeats every `offset` bytes.\n@effects()\nfn zstdCopy(out: SliceMut<u8>, to: usize, offset: usize, length: usize) {\n    var k: usize = 0;\n    var back = offset;\n    if (offset < 8) {\n        if (offset == 1) {\n            let b = out[to - 1];\n            out[to..to + length].fill(b);\n            return;\n        }\n        let first = if (length < 8) length else 8;\n        while (k < first) {\n            out[to + k] = out[to + k - offset];\n            k += 1;\n        }\n        back = offset * ((offset + 7) / offset);\n    }\n    while (k < length) ",
    153 =>
        "{\n        let word = out.readLE<u64>(to + k - back);\n        out.writeLE(to + k, word);\n        k += 8;\n    }\n}\n\n/// Where a block is decoded: into `out`, from `start`. The history a match may reach is `out[segment..start]` and,\n/// in a decoder's ring that has wrapped, the end of the segment before, which ended at `oldEnd`. The block may write\n/// up to `blockEnd` (its maximum: further is Malformed) and `end` (the frame's content size, Malformed, or the\n/// limit, TooLarge: `endCode`); `out` has room for `zstdSlack()` bytes past both. `before` is how many bytes the\n/// frame wrote before the block.\nstruct ZstdPlace {\n    start: usize;\n    segment: usize;\n    oldEnd: usize;\n    blockEnd: usize;\n    end: usize;\n    endCode: u32;\n    before: u64;\n}\n\n/// Refuses writing `n` bytes at `pos`: past the block's maximum, then past the end.\n@effects()\nfn zstdRoom(w: borrow ZstdPlace, pos: usize, n: usize) -> u32 {\n    if (n > w.blockEnd - pos) { return 1; }\n    if (n > w.end - pos) { return w.endCode; }\n    return 0;\n}\n\n/// What a literals section held: how many literals, and its bytes.\nstruct ZstdLiterals {\n    count: usize;\n    used: usize;\n}\n\n// ---------------------------------------------------------------------------------------------------------------\n// A frame's decoding state.\n\n/// What lasts across a frame's blocks: the literals of the block being decoded, the last Huffman table, the last FSE\n/// table of each sequence field, the repeated offsets, and the window.\nstruct ZstdState {\n    literals: Vector<u8>; // a block's literals, and room past them\n    huffman: Vector<u16>; // 4,096 entries, the last Huffman table\n    huffmanLog: u32;\n    hasHuffman: bool;\n    tables: Vector<u64>; // literal lengths at 0, offsets at 512, match lengths at 768\n    logs: [u32; 3];\n    hasTable: [bool; 3];\n    reps: [u64; 3];\n    window: u64;\n    blockMax: usize;\n\n    /// Allocates the tables and the literals' buffer, about 150 KiB.\n    fn create() -> Result<ZstdState, AllocError> {\n        var literals = Vector<u8>.create();\n        literals.resize(zstdBlockMax() + zstdSlack(), 0)?;\n        var huffman = Vector<u16>.create();\n        huffman.resize(4096, 0)?;\n        var tables = Vector<u64>.create();\n        tables.resize(1280, 0)?;\n        return Ok(ZstdState {\n            literals: literals,\n            huffman: huffman,\n            huffmanLog: 0,\n            hasHuffman: false,\n            tables: tables,\n            logs: [0u32; 3],\n            hasTable: [false; 3],\n            reps: [1u64, 4, 8],\n            window: 0,\n            blockMax: 0,\n        });\n    }\n\n    /// A new frame: no tables to repeat, the first repeated offsets, its window.\n    @effects()\n    fn begin(borrow mut this, window: u64) {\n        this.hasHuffman = false;\n        this.hasTable = [false; 3];\n        this.reps = [1u64, 4, 8];\n        this.window = window;\n        this.blockMax = if (window < zstdBlockMax() as u64) truncate<usize>(window) else zstdBlockMax();\n    }\n\n    /// Decodes the compressed block `block` at `w.start` of `out`; where its output ends.\n    @effects()\n    fn block(borrow mut this, block: Slice<u8>, out: SliceMut<u8>, w: borrow ZstdPlace) -> Result<usize, DecodeError> {\n        if (block.length < 2) { return Err(DecodeError.Malformed); }\n        let lits = this.literalsSection(block)?;\n        return this.sequences(block[lits.used..], lits.count, out, w);\n    }\n\n    /// Decodes the literals section at the start of `block` into `literals`.\n    @effects()\n    fn literalsSection(borrow mut this, block: Slice<u8>) -> Result<ZstdLiterals, DecodeError> {\n        let b0 = block[0] as usize;\n        let kind = b0 & 3;\n        let format = (b0 >> 2) & 3;\n        if (kind < 2) {\n            var n: usize = 0;\n            var h: usize = 0;\n            if (format == 0 || format == 2) {\n                n = b0 >> 3;\n                h = 1;\n           