fn libraryChunk(j: usize) -> StringView => match (j) {
    0 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: address types (type-system.md §29.2, cosmoos/kernel-memory-and-lifetimes.md). Distinct types with\n// no implicit conversions, so a physical address cannot be used where a virtual one is meant.\n\n/// A physical address.\npublic struct PhysAddr {\n    raw: u64;\n\n    /// The address whose value is `bits`.\n    public fn of(bits: u64) -> PhysAddr => PhysAddr { raw: bits };\n\n    /// The address's value.\n    public fn bits(this) -> u64 => this.raw;\n\n    /// The address `n` bytes further on; panics if that overflows a `u64`.\n    public fn offset(this, n: u64) -> PhysAddr => PhysAddr { raw: this.raw + n };\n}\n\n/// A virtual address.\npublic struct VirtAddr {\n    raw: u64;\n\n    /// The address whose value is `bits`.\n    public fn of(bits: u64) -> VirtAddr => VirtAddr { raw: bits };\n\n    /// The address's value.\n    public fn bits(this) -> u64 => this.raw;\n\n    /// The address `n` bytes further on; panics if that overflows a `u64`.\n    public fn offset(this, n: u64) -> VirtAddr => VirtAddr { raw: this.raw + n };\n}\n",
    1 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: user-defined allocators (type-system.md §30, memory-model.md §3.2). Bundled with ceesafec.\n\n/// The size in bytes and the alignment (a power of two) of a block of memory.\npublic struct Layout {\n    size: usize;\n    align: usize;\n}\n\n/// An allocator a `Box<T, A>` can use: a struct without fields that implements this (type-system.md §30.2).\npublic interface Allocator {\n    /// A block of at least `layout.size` bytes aligned to `layout.align`, or Err; never a null Ok.\n    fn allocate(borrow this, layout: Layout) -> Result<*mut u8, AllocError>;\n\n    /// Returns a block. Safety: `p` came from `allocate` of this allocator type with the same layout,\n    /// and is returned once.\n    unsafe fn deallocate(borrow this, p: *mut u8, layout: Layout);\n}\n",
    2 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Async tasks in every profile (type-system.md §40.4, ADR 0031, ADR 0039): errors, timers, cancellation, the joins of\n// Async.race and Async.all, and AsyncSignal, over the executor's ceesafe_async_* (runtime/hosted/ceesafe_rt_async.c).\n// In the freestanding profile the executor runs over its environment's hooks (ceesafe_env_*, profiles.md §4.2), so\n// what waits here waits there too. I/O for tasks is lib/std's (hosted only).\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_async_now() -> u64;\n    @effects()\n    fn ceesafe_async_wait_until(deadline: u64);\n    @effects()\n    fn ceesafe_async_status() -> u32;\n    @effects()\n    fn ceesafe_async_shield_enter(ms: u64);\n    @effects()\n    fn ceesafe_async_shield_leave();\n    @effects()\n    fn ceesafe_async_signal_take(signal: *mut void) -> bool;\n    @effects()\n    fn ceesafe_async_signal_forget(signal: *mut void);\n    @effects()\n    fn ceesafe_async_signal_raise(signal: *mut void);\n    @effects()\n    fn ceesafe_async_set_init(set: *mut void, limit: u32, error: *mut void);\n    @effects()\n    fn ceesafe_async_set_admit(set: *mut void, wait: bool) -> u32;\n    @effects()\n    fn ceesafe_async_set_done(set: *mut void) -> bool;\n    @effects()\n    fn ceesafe_async_isolate_next(set: *mut void, crashed: *void, size: u64);\n    @effects()\n    fn ceesafe_async_isolated_last() -> u64;\n    @effects()\n    fn ceesafe_async_isolate_bound(ms: u64);\n    @effects()\n    fn ceesafe_async_set_crashes(set: *mut void) -> u64;\n    @effects()\n    fn ceesafe_async_set_missed(set: *mut void) -> u64;\n    @effects()\n    fn ceesafe_async_set_end(set: *mut void);\n    @effects()\n    fn ceesafe_async_set_cancel(set: *mut void);\n    @effects()\n    fn ceesafe_async_set_oom(set: *mut void) -> bool;\n}\n\n/// Why an async operation failed (type-system.md §40.4, §40.7). `Io` is `@from` (ADR 0111): in a function that\n/// returns `Result<_, AsyncError>`, `?` on a `Result<_, IoError>` (a socket's `bind`, `port`, `shutdownWrite`)\n/// returns `Err(AsyncError.Io(e))`. `Closed` (ADR 0128): the other side of this channel, or this endpoint, was closed,\n/// so the operation can never succeed; it is what `?` makes of a send to a closed channel (`SendError.reason`).\npublic enum AsyncError {\n    Cancelled,\n    TimedOut,\n    @from Io(IoError),\n    Closed,\n}\n\n/// Time for tasks: the monotonic clock in milliseconds.\npublic struct Timer {\n    /// Milliseconds on the monotonic clock, from an arbitrary start.\n    /// Safety: ceesafe_async_now only reads the clock.\n    public fn now() -> u64 => unsafe { ceesafe_async_now() };\n\n    /// Waits at least `ms` milliseconds without blocking the thread: other tasks run meanwhile.\n    /// Safety: ceesafe_async_wait_until only records the deadline for the executor.\n    /// A cancelled task's sleep returns `Err(AsyncError.Cancelled)` at once (type-system.md §40.7).\n    public async fn sleep(ms: u64) -> Result<void, AsyncError> {\n        let start = Timer.now();\n        let deadline = if (ms > 0xFFFFFFFFFFFFFFFF - start) 0xFFFFFFFFFFFFFFFF else start + ms;\n        loop {\n            AsyncLeaf.status()?;\n            if (Timer.now() >= deadline) {\n                return Ok();\n            }\n            unsafe { ceesafe_async_wait_until(deadline); }\n            await Async.park();\n        }\n    }\n}\n\n/// What `Async.isCancelled()` and `Async.checkpoint(cancelled)` call (type-system.md §40.4).\npublic struct AsyncControl<E> {\n    /// Whether the current task is cancelled and not shielded.\n    /// Safety: ceesafe_async_status only reads the executor's state.\n    public fn isCancelled() -> bool => unsafe { ceesafe_async_status() } == 1;\n\n    /// `Async.shield`'s start (type-system.md §40.7).\n    /// Safety: it only counts the current task's shields.\n    public fn enterShield(ms: u64) {\n        unsafe { ceesafe_async_shield_enter(ms); }\n    }\n\n    /// `Async.shield`'s end.\n    /// Safety: it only counts the current task's shields, after enterS",
    3 =>
        "hield.\n    public fn leaveShield() {\n        unsafe { ceesafe_async_shield_leave(); }\n    }\n\n    /// `Err(cancelled)` if the current task is cancelled and not shielded, else `Ok`.\n    public fn checkpoint(cancelled: E) -> Result<void, E> {\n        if (AsyncControl<E>.isCancelled()) {\n            return Err(cancelled);\n        }\n        return Ok();\n    }\n}\n\n/// The library's own steps for its waiting operations: not for programs (type-system.md §40.4).\npublic struct AsyncLeaf {\n    /// Err(Cancelled) if the current task is cancelled, Err(TimedOut) if its shield's time is up (type-system.md §40.7).\n    /// Safety: ceesafe_async_status only reads the executor's state.\n    public fn status() -> Result<void, AsyncError> {\n        let status = unsafe { ceesafe_async_status() };\n        if (status == 1) {\n            return Err(AsyncError.Cancelled);\n        }\n        if (status == 2) {\n            return Err(AsyncError.TimedOut);\n        }\n        return Ok();\n    }\n}\n\n/// `Async.race`'s result (type-system.md §40.4): the child that returned `Ok` first (0 or 1), its value, and the\n/// other's value if it also returned `Ok` before it saw its cancellation.\npublic struct Raced<T> {\n    public winner: u32;\n    public value: T;\n    public other: T?;\n}\n\n/// What `Async.race` returns once both children have: `first` is the one that returned first, which decides.\nstruct AsyncRaceJoin<T, E> {\n    fn settle(first: u32, a: Result<T, E>, b: Result<T, E>) -> Result<Raced<T>, E> {\n        if (first == 0) {\n            return AsyncRaceJoin<T, E>.decide(0, a, b);\n        }\n        return AsyncRaceJoin<T, E>.decide(1, b, a);\n    }\n\n    fn decide(index: u32, early: Result<T, E>, late: Result<T, E>) -> Result<Raced<T>, E> {\n        match (early) {\n            Ok(value) => {\n                let other: T? = match (late) {\n                    Ok(w) => Some(w),\n                    Err(_) => null,\n                };\n                return Ok(Raced { winner: index, value: value, other: other });\n            }\n            Err(e) => { return Err(e); }\n        }\n    }\n}\n\n/// `Async.timeout` and `Async.deadline` (type-system.md §40.4, ADR 0046): the deadline, the deadline child (the join's\n/// second, beside the body), and the result once both have returned.\nstruct AsyncTimeoutJoin<T, E> {\n    /// The deadline `ms` milliseconds from now, saturated.\n    fn after(ms: u64) -> u64 {\n        let start = Timer.now();\n        return if (ms > 0xFFFFFFFFFFFFFFFF - start) 0xFFFFFFFFFFFFFFFF else start + ms;\n    }\n\n    /// Returns `Ok` once the clock reaches `at`, or `Err(Cancelled)` if the task is cancelled first: the body\n    /// returned, or the caller was cancelled.\n    /// Safety: ceesafe_async_wait_until only records the deadline for the executor.\n    async fn until(at: u64) -> Result<void, AsyncError> {\n        loop {\n            AsyncLeaf.status()?;\n            if (Timer.now() >= at) {\n                return Ok();\n            }\n            unsafe { ceesafe_async_wait_until(at); }\n            await Async.park();\n        }\n    }\n\n    /// The body decides when it returned first, or when the deadline child did not reach the deadline (the caller was\n    /// cancelled). After the deadline, a late `Ok` is kept and any `Err` is `timedOut` (ADR 0046 §3.2).\n    fn settle(first: u32, body: Result<T, E>, deadline: Result<void, AsyncError>, timedOut: E) -> Result<T, E> {\n        if (first == 0) {\n            return body;\n        }\n        // No `Ok` payload is bound, so T may be void (bug B6: `Ok(value)` was invalid for Result<void, E>).\n        let reached = match (deadline) {\n            Ok() => true,\n            Err(_) => false,\n        };\n        let failed = match (body) {\n            Err(_) => true,\n            _ => false,\n        };\n        if (reached && failed) {\n            return Err(timedOut);\n        }\n        return body;\n    }\n}\n\n/// What `Async.all` returns once both children have: the first error in the order they returned, else `Ok`.\nstruct AsyncAllJoin",
    4 =>
        "<E> {\n    fn settle(first: u32, a: Result<void, E>, b: Result<void, E>) -> Result<void, E> {\n        if (first == 0) {\n            return AsyncAllJoin<E>.decide(a, b);\n        }\n        return AsyncAllJoin<E>.decide(b, a);\n    }\n\n    fn decide(early: Result<void, E>, late: Result<void, E>) -> Result<void, E> {\n        match (early) {\n            Err(e) => { return Err(e); }\n            Ok() => { return late; }\n        }\n    }\n}\n\n/// A task set's record (ADR 0053 §3.4): the runtime's ceesafe_task_set, then the slot where a child's first error is\n/// copied. It lives in the frame of AsyncTasks.run's task, which never moves.\nstruct TaskSetRecord<E> {\n    words: [u64; 12];\n    first: Result<void, E>;\n}\n\n/// The set `Async.tasks`' body is given (ADR 0053 §3.1). The body, and the functions it passes the set to, start\n/// children with `await set.spawn(async move () => …)`, which waits while the set's limit of children run, and\n/// `set.trySpawn(async move () => …)`, which is false instead. `await set.spawnIsolated(crashed, async move () => …)`\n/// and `set.trySpawnIsolated(crashed, …)` start a child that ends alone if it traps (ADR 0175);\n/// `set.spawnIsolatedBound(ms, crashed, …)` and `set.trySpawnIsolatedBound(ms, crashed, …)` one whose tasks may run\n/// `ms` milliseconds without waiting (ADR 0186). A child owns what it captures: no loans, so it cannot\n/// capture the set (N0349). The calls are the checker's (src/check/async.cee): these are the steps it joins.\n@noncopy // the one handle of its record\npublic struct TaskSet<E: Copy> {\n    private record: *mut void;\n    private oom: E;\n\n    /// Waits until a child may start: 0, or 2 once the set or this task is cancelled (the child is then not started).\n    /// Safety: the record outlives the set, which the body holds by borrow while AsyncTasks.run waits for it.\n    async fn room(borrow this) -> u32 {\n        loop {\n            let admitted = unsafe { ceesafe_async_set_admit