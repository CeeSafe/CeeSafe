    44 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// The methods of `Result<T, E>` and an optional's `okOr` (ADR 0075 §2.3): `r.isOk()`, `r.isErr()`, `r.ok()`,\n// `r.err()`, `r.map(f)`, `r.mapErr(f)` and `o.okOr(e)` are calls of these, instantiated with the types (src/check/members.cee).\n\n/// `Result<T, E>`'s methods.\npublic struct ResultMethods<T, E> {\n    /// Whether `r` is `Ok`.\n    public fn isOk(r: borrow Result<T, E>) -> bool => match (r) {\n        Ok(_) => true,\n        Err(_) => false,\n    };\n\n    /// Whether `r` is `Err`.\n    public fn isErr(r: borrow Result<T, E>) -> bool => match (r) {\n        Ok(_) => false,\n        Err(_) => true,\n    };\n\n    /// The `Ok` value, or null; an `Err` value is destroyed.\n    public fn ok(r: Result<T, E>) -> T? => match (r) {\n        Ok(v) => Some(v),\n        Err(_) => null,\n    };\n\n    /// The `Err` value, or null; an `Ok` value is destroyed.\n    public fn err(r: Result<T, E>) -> E? => match (r) {\n        Ok(_) => null,\n        Err(e) => Some(e),\n    };\n}\n\n/// `r.map(f)`, apart from `ResultMethods` so that a `Result<void, E>`, which has no value to map, has the others.\npublic struct ResultMapping<T, E> {\n    /// `Ok(f(v))` for `Ok(v)`; an `Err` as it is. `U` is `Send`, as any result of a call of a function value is\n    /// (type-system.md §25.6): a type that borrows cannot be mapped to.\n    @effectsOf(f)\n    public fn map<U: Send>(r: Result<T, E>, f: borrow mut fn(T) -> U) -> Result<U, E> => match (r) {\n        Ok(v) => Ok(f(v)),\n        Err(e) => Err(e),\n    };\n}\n\n/// `r.mapErr(f)`.\npublic struct ResultErrorMapping<T, E> {\n    /// `Err(f(e))` for `Err(e)`; an `Ok` as it is. `F` is `Send`, as `map`'s `U` is.\n    @effectsOf(f)\n    public fn mapErr<F: Send>(r: Result<T, E>, f: borrow mut fn(E) -> F) -> Result<T, F> => match (r) {\n        Ok(v) => Ok(v),\n        Err(e) => Err(f(e)),\n    };\n}\n\n/// `o.okOr(e)`: an optional as a `Result`.\npublic struct OptionalResults<T, E> {\n    /// `Ok` with the value, or `Err(e)` for null; `e` is destroyed when there is a value.\n    public fn okOr(o: T?, e: E) -> Result<T, E> => match (o) {\n        Some(v) => Ok(v),\n        null => Err(e),\n    };\n}\n",
