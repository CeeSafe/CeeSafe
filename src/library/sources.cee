    27 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: memory-mapped I/O (type-system.md §29.2). Bundled with ceesafec and part of every package.\n\n/// A cell read and written only by volatile accesses: a hardware register, or memory shared with a device.\n/// Not Copy: a copy would read the register with an ordinary access, once, instead of each time it is used.\n@noncopy\npublic struct Volatile<T: Copy> {\n    value: T;\n\n    /// Safety: `this.value` is a live, aligned `T` (it is a field), and the read is a single volatile access.\n    public fn read(borrow this) -> T {\n        let p = borrow this.value as *T;\n        return unsafe { p.readVolatile() };\n    }\n\n    /// Safety: as `read`; `borrow mut this` makes the write exclusive.\n    public fn write(borrow mut this, v: T) {\n        let p = borrow mut this.value as *mut T;\n        unsafe { p.writeVolatile(v); }\n    }\n}\n\n/// The address of a memory-mapped `T`, typically a `@repr(C)` struct of `Volatile` registers. Not Copy: two\n/// copies would be two owners of the same registers.\n@noncopy\npublic struct MmioPtr<T> {\n    base: *mut T;\n\n    /// Safety: `address` is mapped, aligned for `T`, and no other `MmioPtr` or reference aliases the registers.\n    public unsafe fn at(address: usize) -> MmioPtr<T> => MmioPtr<T> { base: address as *mut T };\n\n    /// Safety: `at`'s contract makes `base` a live `T` reached only through this value; the result borrows `this`.\n    public fn get(borrow this) -> borrow T => unsafe { Ptr.toBorrow(this.base) };\n\n    /// Safety: as `get`; `borrow mut this` makes the access exclusive.\n    public fn getMut(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.base) };\n\n    /// The address of the registers, as given to `at`.\n    public fn address(borrow this) -> usize => this.base as usize;\n}\n",
    28 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: numbers read from text (ADR 0071 §2.5). Bundled with ceesafec and part of every package. On a `StringView`\n// or a `Slice<u8>`, `s.parseInt<u32>()` is `NumberParsing.parseU32(bytes)`, `s.parseIntRadix<u32>(r)` is\n// `parseU32Radix(bytes, r)` and `s.parseFloat<f64>()` is `parseF64(bytes)`; each gives null for text that is not a\n// number of that type.\n//\n// Floats are correctly rounded (to nearest, ties to even) for every input. Inputs of at most 15 significant digits\n// (7 for f32) with a small exponent take Clinger's fast path: the digits and the power of ten are both exact floats,\n// so one IEEE operation rounds once. Every other input goes through FloatDecimal, an exact decimal that is shifted by\n// powers of two until it is a 54-bit (or 25-bit) integer, then rounded: the \"simple decimal conversion\" of Go's\n// strconv and Wuffs. It never uses the C library, so it does not depend on the locale.\n\n/// Parsing integers and floats from bytes: static functions; the struct has no fields and is never made.\npublic struct NumberParsing {\n    /// The value of a digit in bases up to 36 (`0`–`9`, `a`–`z`, `A`–`Z`), or 99.\n    fn digitValue(b: u8) -> u32 {\n        if (b >= '0' && b <= '9') {\n            return (b - '0') as u32;\n        }\n        if (b >= 'a' && b <= 'z') {\n            return (b - 'a') as u32 + 10;\n        }\n        if (b >= 'A' && b <= 'Z') {\n            return (b - 'A') as u32 + 10;\n        }\n        return 99;\n    }\n\n    /// The digits of `s` from `start` on, in `radix`, or null: none, a byte that is not a digit, or more than a `u64`.\n    fn magnitude(s: Slice<u8>, start: usize, radix: u32) -> u64? {\n        if (radix < 2 || radix > 36 || start >= s.length) {\n            return null;\n        }\n        var n: u64 = 0;\n        for (i in start..s.length) {\n            let d = NumberParsing.digitValue(s[i]);\n            if (d >= radix) {\n                return null;\n            }\n            n = n.checkedMul(radix as u64)?.checkedAdd(d as u64)?;\n        }\n        return n;\n    }\n\n    /// An optional `+`, then digits.\n    fn unsigned(s: Slice<u8>, radix: u32) -> u64? {\n        let start: usize = if (s.length > 0 && s[0] == '+') 1 else 0;\n        return NumberParsing.magnitude(s, start, radix);\n    }\n\n    /// An optional `-` or `+`, then digits, within an `i64`.\n    fn signed(s: Slice<u8>, radix: u32) -> i64? {\n        let negative = s.length > 0 && s[0] == '-';\n        let start: usize = if (s.length > 0 && (s[0] == '-' || s[0] == '+')) 1 else 0;\n        let m = NumberParsing.magnitude(s, start, radix)?;\n        if (negative) {\n            if (m == 0x8000_0000_0000_0000) {\n                return -9223372036854775807 - 1;\n            }\n            if (m > 0x8000_0000_0000_0000) {\n                return null;\n            }\n            return -truncate<i64>(m);\n        }\n        if (m > 0x7FFF_FFFF_FFFF_FFFF) {\n            return null;\n        }\n        return truncate<i64>(m);\n    }\n\n    /// Decimal text as a `u8`.\n    public fn parseU8(s: Slice<u8>) -> u8? => NumberParsing.parseU8Radix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as a `u8`.\n    public fn parseU8Radix(s: Slice<u8>, radix: u32) -> u8? {\n        let v = NumberParsing.unsigned(s, radix)?;\n        let t = truncate<u8>(v);\n        if (t as u64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Decimal text as a `u16`.\n    public fn parseU16(s: Slice<u8>) -> u16? => NumberParsing.parseU16Radix(s, 10);\n\n    /// Text in `radix` (2 to 36; null otherwise) as a `u16`.\n    public fn parseU16Radix(s: Slice<u8>, radix: u32) -> u16? {\n        let v = NumberParsing.unsigned(s, radix)?;\n        let t = truncate<u16>(v);\n        if (t as u64 != v) {\n            return null;\n        }\n        return t;\n    }\n\n    /// Decimal text as a `u32`.\n    public