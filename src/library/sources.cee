        "  data: *u8,\n        length: u64,\n        socketFamily: u32,\n        family: u32,\n        bytes: *u8,\n        port: u16,\n        scope: u32,\n    ) -> i64;\n    @effects()\n    fn ceesafe_async_udp_recv(\n        fd: i32,\n        buffer: *mut u8,\n        length: u64,\n        bytes: *mut u8,\n        scope: *mut u32,\n        info: *mut u32,\n    ) -> i64;\n}\n\n/// Console output for tasks: in order with Console's, and never blocking the thread (ADR 0031 §3.5).\npublic struct AsyncConsole {\n    /// Writes `text` to standard output.\n    public async fn write(text: StringView) -> Result<void, AsyncError> => await AsyncIo.writeAll(1, text.bytes());\n\n    /// Writes `text` and a newline to standard output.\n    public async fn writeLine(text: StringView) -> Result<void, AsyncError> {\n        await AsyncIo.writeAll(1, text.bytes())?;\n        return await AsyncIo.writeAll(1, \"\\n\".bytes());\n    }\n\n    /// Writes `text` to standard error.\n    public async fn writeError(text: StringView) -> Result<void, AsyncError> =>\n        await AsyncIo.writeAll(2, text.bytes());\n}\n\n/// Readiness of a descriptor the program owns, for tasks (ADR 0183; type-system.md §40.4): a device's or a pipe's, set\n/// non-blocking by the program, which does its own I/O on it. The executor waits for it with every other descriptor it\n/// waits for (kqueue, epoll edge-triggered, or poll), so the task parks with no thread of its own.\n///\n/// The executor learns readiness from edges: call `readable` or `writable` only after an operation on the descriptor\n/// would have blocked (EAGAIN), and retry the operation when it returns, which may be early. A descriptor the program\n/// closes itself is announced first with `closing`, so a later one under the same number is waited for again.\n///\n/// POSIX hosts only: on Windows, whose executor waits for sockets only, both return `Err(Io(Unsupported))`.\npublic struct AsyncFd {\n    /// Parks the task until `fd` may be readable (POLLIN): Err(Cancelled) or Err(TimedOut) if the task is cancelled\n    /// or its shield's time is up, before or while it waits (type-system.md §40.7).\n    /// Safety: the runtime only records the descriptor for the executor's wait.\n    public async fn readable(fd: i32) -> Result<void, AsyncError> {\n        AsyncFd.supported()?;\n        AsyncLeaf.status()?;\n        unsafe { ceesafe_async_wait_readable(fd); }\n        await Async.park();\n        return AsyncLeaf.status();\n    }\n\n    /// Parks the task until `fd` may be writable (POLLOUT; usbfs reports a finished URB so): as `readable`.\n    /// Safety: as `readable`.\n    public async fn writable(fd: i32) -> Result<void, AsyncError> {\n        AsyncFd.supported()?;\n        AsyncLeaf.status()?;\n        unsafe { ceesafe_async_wait_writable(fd); }\n        await Async.park();\n        return AsyncLeaf.status();\n    }\n\n    /// Before the program closes `fd` with its own call: the executor forgets what it knew of the number.\n    /// Safety: the runtime only moves a counter.\n    public fn closing(fd: i32) {\n        unsafe { ceesafe_async_fd_closing(fd); }\n    }\n\n    /// Safety: the runtime only answers a constant.\n    fn supported() -> Result<void, AsyncError> {\n        if (unsafe { ceesafe_async_fd_waits() } == 0) {\n            return Err(AsyncError.Io(IoError.Unsupported));\n        }\n        return Ok();\n    }\n}\n\n/// lib/std's own steps for its waiting I/O: not for programs (type-system.md §40.4).\nstruct AsyncIo {\n    /// Writes every byte to `fd`, a step of at most PIPE_BUF bytes whenever it is writable, parking until it is.\n    /// Safety: the pointer and length are the slice's, read by the runtime during the call only.\n    async fn writeAll(fd: i32, bytes: Slice<u8>) -> Result<void, AsyncError> {\n        var done: usize = 0;\n        while (done < bytes.length) {\n            AsyncLeaf.status()?; // a cancelled task writes no further step (type-system.md §40.7)\n            let rest 