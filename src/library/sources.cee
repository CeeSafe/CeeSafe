        ") + 1;\n    if (log > 12) { return null; }\n    let rest = (1u32 << log) - total;\n    if ((rest & (rest - 1)) != 0) { return null; }\n    weights[n] = truncate<u8>(zstdHighBit(rest) + 1);\n    n += 1;\n    var ones: usize = 0;\n    for (k in 0..n) {\n        if (weights[k] == 1) { ones += 1; }\n    }\n    if (ones < 2 || ones % 2 == 1) { return null; }\n    return ZstdWeights { count: n, log: log, used: used };\n}\n\n/// Fills a table of 2^log entries from the weights: codes are given by weight, the lowest (longest code) first, and\n/// within a weight by symbol; a symbol of weight w has 2^(w - 1) entries and a code of log + 1 - w bits.\n@effects()\nfn zstdHuffmanTable(weights: Slice<u8>, log: u32, table: SliceMut<u16>) {\n    var position: usize = 0;\n    var w: u32 = 1;\n    while (w <= log) {\n        let span = 1usize << (w - 1);\n        let entry = log + 1 - w;\n        for (s in 0..weights.length) {\n            if (weights[s] as u32 == w) {\n                table[position..position + span].fill(truncate<u16>((truncate<u32>(s) << 8) | entry));\n                position += span;\n            }\n        }\n        w += 1;\n    }\n}\n\n/// Decodes the `n` symbols of the Huffman stream `data[from..to]` into `out[op..op + n]`: four symbols per refill\n/// while eight bytes remain, then one at a time. False if the stream has no end mark, or is not used up exactly.\n@effects()\nfn zstdHuffmanStream(\n    data: Slice<u8>,\n    from: usize,\n    to: usize,\n    table: Slice<u16>,\n    log: u32,\n    out: SliceMut<u8>,\n    op: usize,\n    n: usize,\n) -> bool {\n    var bits = match (ZstdBits.open(data, from, to)) {\n        Some(b) => b,\n        null => { return false; },\n    };\n    let end = op + n;\n    var p = op;\n    // The fast loop keeps the reader in locals (the C compiler does not inline its methods here): while eight bytes\n    // remain, a refill leaves at least 57 bits, and four symbols take at most 48.\n    var buf = bits.buf;\n    var count