eOpenFiles(to: u64) -> Result<u64, IoError> {\n        var now: u64 = 0;\n        let result = unsafe { ceesafe_host_raise_open_files(to, borrow mut now as *mut u64) };\n        if (result < 0) {\n            return Err(HostServices.hostError(result));\n        }\n        return Ok(now);\n    }\n}\n\n/// A request to the process from outside it (`ProcessSignals`, type-system.md §26.15, ADRs 0125 and 0140).\npublic enum ProcessSignal {\n    /// The user's interrupt: POSIX `SIGINT` (Ctrl+C in a terminal); on Windows, Ctrl+C.\n    Interrupt,\n    /// A request to terminate: POSIX `SIGTERM` (`kill`, a service manager, a container's stop); on Windows,\n    /// Ctrl+Break (which `ChildProcess.terminate` sends) and the console's close, logoff and shutdown.\n    Terminate,\n    /// POSIX `SIGHUP` (ADR 0140): the terminal went away, or, for a daemon, which has none, by convention a request\n    /// to read its configuration again (`kill -HUP`, systemd's `ExecReload`). Windows has no such request, so it never\n    /// comes there.\n    Hangup,\n}\n\n/// The process's subscription to the requests to end it (type-system.md §26.15, ADR 0125). Before a program\n/// subscribes, and after the subscription is dropped, such a request ends the process at once, as the system's\n/// default does. While the subscription lives, each request is kept for the program instead: `poll` asks without\n/// waiting, `wait` blocks a thread, and `waitAsync` parks a task (so `Async.race(server, signals.waitAsync())` is a\n/// server's shutdown). There is one subscription for the process at a time; threads and tasks share it by\n/// reference. Requests that arrive faster than they are taken are merged: up to eight are kept. `SIGHUP` is kept\n/// as `Hangup` (ADR 0140), and no other signal is touched. Hosted only.\n@noncopy\npublic struct ProcessSignals {\n    private queue: Channel<u32>;\n\n    /// Subscribes. `Err(IoError.AlreadyExists)` while another subscription lives, `Err(IoError.Unsupported)` where\n    /// the system has no such requests.\n    /// Safety: the runtime takes its own",
    170 =>
        " count of the channel, and gives it back when the subscription ends, which\n    /// is this value's drop.\n    public fn subscribe() -> Result<ProcessSignals, IoError> {\n        let queue = match (Channel<u32>.create(8)) {\n            Ok(q) => q,\n            Err(_) => { return Err(IoError.OutOfMemory); }\n        };\n        let result = unsafe { ceesafe_signal_subscribe(queue.handle()) };\n        if (result < 0) {\n            return Err(HostServices.hostError(result));\n        }\n        return Ok(ProcessSignals { queue: queue });\n    }\n\n    /// The oldest request not yet taken, or `null` at once if there is none. It never waits, so async code may call\n    /// it.\n    public fn poll(borrow this) -> ProcessSignal? => match (this.queue.tryRecv()) {\n        Some(n) => Some(ProcessSignals.named(n)),\n        null => null,\n    };\n\n    /// Waits for a request, blocking the thread. In async code use `waitAsync` (N0295).\n    public fn wait(borrow this) -> ProcessSignal {\n        loop {\n            match (this.queue.recv()) {\n                Some(n) => { return ProcessSignals.named(n); }\n                null => {} // the queue is never closed\n            }\n        }\n    }\n\n    /// Waits for a request, parking the task: other tasks run meanwhile. `Err(AsyncError.Cancelled)` if the task is\n    /// cancelled first; a request is then still there for the next call.\n    public async fn waitAsync(borrow this) -> Result<ProcessSignal, AsyncError> {\n        loop {\n            match (await this.queue.recvAsync()?) {\n                Some(n) => { return Ok(ProcessSignals.named(n)); }\n                null => {} // the queue is never closed\n            }\n        }\n    }\n\n    /// The runtime's value: 1 an interrupt, 2 a request to terminate, 3 a hangup.\n    fn named(n: u32) -> ProcessSignal => if (n == 1) ProcessSignal.Interrupt else if (n == 3) ProcessSignal.Hangup\n        else ProcessSignal.Terminate;\n\n    /// Ends the subscription: the next request ends the process, as before it.\n    /// Safety: the runtime ends the subscription only if it is this value's channel, which it holds a count of. In\n    /// a process made by `fork` from one that had subscribed it is not, and nothing is ended.\n    drop {\n        unsafe { ceesafe_signal_unsubscribe(this.queue.handle()); }\n    }\n}\n\n/// Directories (type-system.md §26.10).\n/// A volume's bytes (`Directory.space`, ADR 0077).\npublic struct VolumeSpace {\n    /// The volume's size.\n    public total: u64;\n    /// The bytes no file uses.\n    public free: u64;\n    /// The bytes this process may still write: at most `free`.\n    public available: u64;\n}\n\npublic struct Directory {\n    /// Makes one directory; `AlreadyExists` if something is there already.\n    /// Safety: the runtime reads the path's bytes during the call only.\n    public fn create(path: StringView) -> Result<void, IoError> {\n        let result = unsafe { ceesafe_host_dir_create(path.ptr, path.length as u64) };\n        return if (result < 0) Err(HostServices.hostError(result)) else Ok();\n    }\n\n    /// Removes an empty directory.\n    /// Safety: the runtime reads the path's bytes during the call only.\n    public fn remove(path: StringView) -> Result<void, IoError> {\n        let result = unsafe { ceesafe_host_dir_remove(path.ptr, path.length as u64) };\n        return if (result < 0) Err(HostServices.hostError(result)) else Ok();\n    }\n\n    /// The bytes of the volume that holds `path` (ADR 0077): `total`, `free`, and `available` to this process, which\n    /// is at most `free` where the system keeps a reserve for its administrator. POSIX `statvfs`; Windows\n    /// `GetDiskFreeSpaceExA`. A storage engine stops writing before `available` runs out. The interpreter answers\n    /// `Unsupported`.\n    /// Safety: the runtime reads the path's bytes and writes the three values during the call only.\n    public fn space(path: StringView) -> Result<VolumeSpace, IoError> {\n  