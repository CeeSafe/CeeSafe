    196 =>
        "// Memory that processes reach by a name (ADR 0172; type-system.md §26.17).\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_host_shared_map(name: *u8, nameLength: u64, bytes: u64, create: u32, out: *mut u64) -> i64;\n    @effects()\n    fn ceesafe_host_shared_unmap(address: u64, length: u64, handle: u64);\n    @effects()\n    fn ceesafe_host_shared_remove(name: *u8, nameLength: u64) -> i64;\n}\n\n/// Memory that two processes which share nothing else both reach, by a name one tells the other.\n///\n/// ```\n/// let counters = SharedMemory.create(\"myserver-counters\", 4096)?;   // the parent\n/// let counters = SharedMemory.open(\"myserver-counters\")?;           // each child, told the name\n/// counters.word(3).fetchAdd(1);\n/// ```\n///\n/// What it gives safely is 64-bit atomic words: what two processes can read and write with no rule between them.\n/// It starts as zeros and its size is fixed. It is mapped at another address in each process, so what is kept in\n/// it is numbers and offsets, never a pointer, a `Box` or a view. Dropping the value unmaps the memory; dropping\n/// the one `create` returned also removes the name, and the memory lives until the last process lets go of it. A\n/// creator that is killed leaves its name behind on POSIX: `remove` takes it.\n///\n/// A name is 1 to 30 bytes of letters, digits, `.`, `_` and `-`, and is the user's (the session's on Windows): a\n/// program picks one that is its own, with `Process.id()` in it. Hosted, on Linux, macOS, FreeBSD and Windows;\n/// `Unsupported` elsewhere and under `ceesafec run --interp`.\n@noncopy\npublic struct SharedMemory {\n    /// The mapping's address, as a number: the value is Send and Share, since what it gives safely is atomics.\n    private base: usize;\n    private size: usize;\n    /// What the system needs to let go of it, and to hand it to a child (POSIX: its descriptor plus one; Windows:\n    /// the mapping's handle).\n    private handle: u64;\n    /// The name, kept by the value `create` returned, which removes it.\n    private made: [u8; 30];\n    private madeLength: usize;\n\n    /// Whether `name` is one: 1 to 30 bytes of `A`-`Z`, `a`-`z`, `0`-`9`, `.`, `_`, `-`.\n    fn named(name: StringView) -> bool {\n        let bytes = name.bytes();\n        if (bytes.length == 0 || bytes.length > 30) {\n            return false;\n        }\n        for (b in bytes) {\n            let letter = (b >= 'a' as u8 && b <= 'z' as u8) || (b >= 'A' as u8 && b <= 'Z' as u8);\n            let other = (b >= '0' as u8 && b <= '9' as u8) || b == '.' as u8 || b == '_' as u8 || b == '-' as u8;\n            if (!letter && !other) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    /// Safety: the runtime reads the name during the call and writes the three words of `out`.\n    fn map(name: StringView, bytes: usize, create: bool) -> Result<SharedMemory, IoError> {\n        if (!SharedMemory.named(name) || (create && bytes == 0)) {\n            return Err(IoError.InvalidInput);\n        }\n        var out = [0u64; 3];\n        let status = unsafe { ceesafe_host_shared_map(\n            name.ptr,\n            name.length as u64,\n            bytes as u64,\n            if (create) 1u32 else 0u32,\n            borrow mut out[0] as *mut u64,\n        ) };\n        if (status < 0) {\n            return Err(HostServices.hostError(status));\n        }\n        var made = [0u8; 30];\n        var madeLength: usize = 0;\n        if (create) {\n            for (b in name.bytes()) {\n                made[madeLength] = b;\n                madeLength += 1;\n            }\n        }\n        return Ok(SharedMemory {\n            base: truncate<usize>(out[0]),\n            size: truncate<usize>(out[1]),\n            handle: out[2],\n            made: made,\n            madeLength: madeLength,\n        });\n    }\n\n    /// Makes memory of at least `bytes` bytes, zeroed, under `name`. `AlreadyExists` if the name is taken;\n    /// `InvalidInput` for a name that is not one, or for no bytes.\n    public fn create(name: StringView, b",
    197 =>
        "ytes: usize) -> Result<SharedMemory, IoError> =>\n        SharedMemory.map(name, bytes, true);\n\n    /// Memory of at least `bytes` bytes, zeroed, with no name: for a child to be handed (`Handover.memory`, ADR\n    /// 0173), which is the only way another process reaches it. `InvalidInput` for no bytes.\n    /// Safety: the runtime writes the three words of `out`.\n    public fn anonymous(bytes: usize) -> Result<SharedMemory, IoError> {\n        if (bytes == 0) {\n            return Err(IoError.InvalidInput);\n        }\n        var out = [0u64; 3];\n        let status = unsafe { ceesafe_host_shared_map(0 as *u8, 0, bytes as u64, 2u32, borrow mut out[0] as *mut u64) };\n        if (status < 0) {\n            return Err(HostServices.hostError(status));\n        }\n        return Ok(SharedMemory.adopt(out));\n    }\n\n    /// What the system holds the memory by, for `Handover` (ADR 0173).\n    fn held(borrow this) -> u64 => this.handle;\n\n    /// The memory of what the runtime gave: its address, its length and what unmapping needs.\n    fn adopt(out: [u64; 3]) -> SharedMemory => SharedMemory {\n        base: truncate<usize>(out[0]),\n        size: truncate<usize>(out[1]),\n        handle: out[2],\n        made: [0u8; 30],\n        madeLength: 0,\n    };\n\n    /// Maps the memory made under `name`, all of it. `NotFound` if there is none.\n    public fn open(name: StringView) -> Result<SharedMemory, IoError> => SharedMemory.map(name, 0, false);\n\n    /// Removes a name, for one a process that was killed left behind; the memory goes when the last process that\n    /// maps it lets go. `NotFound` if there is no such name, and always on Windows, where none is ever left.\n    /// Safety: the runtime reads the name during the call.\n    public fn remove(name: StringView) -> Result<void, IoError> {\n        if (!SharedMemory.named(name)) {\n            return Err(IoError.InvalidInput);\n        }\n        let status = unsafe { ceesafe_host_shared_remove(name.ptr, name.length as u64) };\n        if (status < 0) {\n            return Err(HostServices.hostError(status));\n        }\n        return Ok();\n    }\n\n    /// Its size in bytes: what `create` was asked for, rounded up to the system's pages.\n    public fn length(borrow this) -> usize => this.size;\n\n    /// How many 64-bit words it holds.\n    public fn words(borrow this) -> usize => this.size / 8;\n\n    /// Word `index`, as an atomic. Panics if `index >= words()`.\n    /// Safety: the word is inside the mapping, which lives as long as this value, is aligned (a mapping starts on\n    /// a page) and is only ever read and written as an atomic through this function.\n    public fn word(borrow this, index: usize) -> borrow AtomicU64 {\n        if (index >= this.size / 8) {\n            panic(\"SharedMemory.word: the index is past the memory's words\");\n        }\n        return unsafe { Ptr.toBorrow((this.base as *mut AtomicU64).add(index)) };\n    }\n\n    /// The mapping's address, for code with a layout and a protocol of its own. Reading or writing through it is\n    /// `unsafe`: another process may write the same bytes at any moment.\n    public fn address(borrow this) -> *mut u8 => this.base as *mut u8;\n\n    /// Unmaps the memory; the value `create` returned also removes the name.\n    /// Safety: the address, length and handle are what the runtime gave, given back once.\n    drop {\n        unsafe { ceesafe_host_shared_unmap(this.base as u64, this.size as u64, this.handle); }\n        if (this.madeLength != 0) {\n            let _ = unsafe { ceesafe_host_shared_remove(borrow this.made[0] as *u8, this.madeLength as u64) };\n        }\n    }\n}\n",
    198 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Shared state between threads (type-system.md §38.3, ADR 0016): Arc and Mutex, over the hosted runtime\n// (runtime/hosted/ceesafe_rt_thread.c). Their unsafe code keeps ownership.md T1–T3. The atomics are in lib/core (ADR 0026).\n\nextern \"C\" {\n    @effects(alloc)\n    fn ceesafe_mutex_create() -> *mut void;\n    @effects(sleep)\n    fn ceesafe_mutex_lock(m: *mut void);\n    @effects()\n    fn ceesafe_mutex_try_lock(m: *mut void) -> bool;\n    @effects()\n    fn ceesafe_mutex_unlock(m: *mut void);\n    @effects()\n    fn ceesafe_async_lock_held(kind: u32, lock: *mut void, flag: *mut u32);\n    @effects()\n    fn ceesafe_async_lock_released(lock: *mut void);\n    @effects()\n    fn ceesafe_panic_poisoned();\n    @effects()\n    fn ceesafe_mutex_destroy(m: *mut void);\n    @effects(sleep)\n    fn ceesafe_mutex_once_lock();\n    @effects()\n    fn ceesafe_mutex_once_unlock();\n    @effects(sleep)\n    fn ceesafe_thread_sleep(ms: u64);\n}\n\n/// Thread services that are not a thread's own (ADR 0222): `Thread.sleep(ms)` is the checker's name for\n/// ThreadServices.sleep(ms), as `Console.flush()` is HostServices.flush().\npublic struct ThreadServices {\n    /// `Thread.sleep(ms)`: the calling thread waits at least `ms` milliseconds; 0 returns at once. It blocks the\n    /// thread, so an async function cannot call it (its effect is `sleep`): a task waits with `Timer.sleep(ms)`.\n    /// Safety: the runtime only waits.\n    public fn sleep(ms: u64) {\n        unsafe { ceesafe_thread_sleep(ms); }\n    }\n}\n\n/// Mutual exclusion: the data is reached only through a guard, which one thread holds at a time.\n@threadSafe\n@noncopy\npublic struct Mutex<T: Send> {\n    /// The platform lock's address, or 0 before the first use of a mutex made by `constant`.\n    private raw: AtomicUSize;\n    private data: RawCell<T>; // changed through the guard while the mutex is shared (type-system.md §41.1)\n    /// 1 once an isolated task that held the lock trapped (ADR 0175 §2.6), until `heal`.\n    private poisoned: AtomicU32;\n\n    /// A mutex holding `data`; its platform lock is allocated.\n    /// Safety: a null lock is reported, never stored.\n    public fn create(data: T) -> Result<Mutex<T>, AllocError> {\n        let raw = unsafe { ceesafe_mutex_create() };\n        if (raw.isNull()) {\n            return Err(AllocError.OutOfMemory);\n        }\n        return Ok(\n            Mutex {\n                raw: AtomicUSize.create(raw as usize),\n                data: RawCell<T>.create(data),\n                poisoned: AtomicU32.create(0),\n            },\n        );\n    }\n\n    /// A mutex holding `data`, as a static initialiser when `data` is one (type-system.md §39.4):\n    /// `static TABLE: Mutex<Vector<u64>> = Mutex<Vector<u64>>.constant(Vector<u64>.empty());`. Its platform lock is\n    /// allocated at its first use, where running out of memory panics: `create` reports it instead.\n    @constant\n    public fn constant(data: T) -> Mutex<T> =>\n        Mutex { raw: AtomicUSize.constant(0), data: RawCell<T>.constant(data), poisoned: AtomicU32.constant(0) };\n\n    /// The platform lock, made now if this mutex came from `constant` and was never used. Two threads that arrive\n    /// together both make one, and the one that loses the exchange destroys its own.\n    /// Safety: a lock is stored only once, never replaced, and destroyed only in drop or here before any use.\n    fn lockHandle(borrow this) -> *mut void {\n        let have = this.raw.load();\n        if (have != 0) {\n            return have as *mut void;\n        }\n        let made = unsafe { ceesafe_mutex_create() };\n        if (made.isNull()) {\n            panic(\"out of memory making a constant Mutex's lock\");\n        }\n        match (this.raw.compareExchange(0, made as usize)) {\n            Ok(_) => { return made; }\n            Err(other) => {\n                unsafe { ceesafe_mutex_destroy(made); }\n                return other as *mut void;\n            }\n        }\n    }\n\n    //",
    199 =>
        "/ Waits for the lock; the guard lends the data until it is dropped. It panics (`PanicKind.Poisoned`) if an\n    /// isolated task that held the lock trapped (ADR 0175 §2.6): the data may break its invariant. `recover` is for\n    /// code that can repair it.\n    /// Safety: `raw` is the lock made in create, destroyed only in drop, when no guard can be live (B-rules).\n    public fn lock(borrow this) -> MutexGuard<T> {\n        unsafe { ceesafe_mutex_lock(this.lockHandle()); }\n        if (this.poisoned.load() != 0) {\n            unsafe {\n                ceesafe_mutex_unlock(this.lockHandle());\n                ceesafe_panic_poisoned();\n            }\n        }\n        this.held();\n        return MutexGuard { lock: this };\n    }\n\n    /// `lock`, whether or not the mutex is poisoned: `guard.poisoned()` says which, and `guard.heal()` clears the\n    /// mark once the data is whole again.\n    /// Safety: as `lock`.\n    public fn recover(borrow this) -> MutexGuard<T> {\n        unsafe { ceesafe_mutex_lock(this.lockHandle()); }\n        this.held();\n        return MutexGuard { lock: this };\n    }\n\n    /// `tryLock`, whether or not the mutex is poisoned: for async code, which cannot wait for a lock.\n    /// Safety: as `tryLock`.\n    public fn tryRecover(borrow this) -> MutexGuard<T>? {\n        if (!unsafe { ceesafe_mutex_try_lock(this.lockHandle()) }) {\n            return null;\n        }\n        this.held();\n        return Some(MutexGuard { lock: this });\n    }\n\n    /// Tells the runtime that the running task holds the lock: if it is an isolated task that traps, the lock is\n    /// poisoned and released.\n    /// Safety: the flag is this mutex's, which outlives the guard that holds the lock.\n    fn held(borrow this) {\n        unsafe { ceesafe_async_lock_held(1, this.lockHandle(), borrow this.poisoned as *AtomicU32 as *mut u32); }\n    }\n\n    /// The guard if no thread holds the lock, else null, at once: it never waits (ADR 0112). The thread that holds\n    /// the lock gets null too. It has no effect, so async code may call it.\n    /// Safety: as `lock`; the guard exists only when the lock was taken.\n    public fn tryLock(borrow this) -> MutexGuard<T>? {\n        if (!unsafe { ceesafe_mutex_try_lock(this.lockHandle()) }) {\n            return null;\n        }\n        if (this.poisoned.load() != 0) {\n            unsafe {\n                ceesafe_mutex_unlock(this.lockHandle());\n                ceesafe_panic_poisoned();\n            }\n        }\n        this.held();\n        return Some(MutexGuard { lock: this });\n    }\n\n    /// Safety: no guard is live once the mutex can be dropped, so the lock is free.\n    drop {\n        let have = this.raw.load();\n        if (have != 0) {\n            unsafe { ceesafe_mutex_destroy(have as *mut void); }\n        }\n    }\n}\n\n/// Holding a Mutex: `data()` lends the protected value; dropping the guard unlocks.\npublic struct MutexGuard<region r, T: Send> {\n    private lock: borrow(r) Mutex<T>;\n\n    /// Safety: the guard holds the lock, so no other thread reaches the cell's contents, and the loan ends before the\n    /// guard's drop (a RawCell's contents may change while the mutex is shared, §41.1).\n    public fn data(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.lock.data.pointer()) };\n\n    /// Whether an isolated task that held the lock trapped, and nothing has healed it since (ADR 0175 §2.6).\n    public fn poisoned(borrow this) -> bool => this.lock.poisoned.load() != 0;\n\n    /// Clears the mark: the data is whole again.\n    public fn heal(borrow this) {\n        this.lock.poisoned.store(0);\n    }\n\n    /// Safety: the guard took the lock in Mutex.lock and releases it once.\n    drop {\n        unsafe {\n            ceesafe_async_lock_released(this.lock.lockHandle());\n            ceesafe_mutex_unlock(this.lock.lockHandle());\n        }\n    }\n}\n\nstruct ArcInner<T> {\n    count: AtomicU64;\n    value: T;\n}\n\n/// Shared ownership across threads: each clone is an owner, and the last owner's drop destroys the value.",
    200 =>
        "\n@threadSafe\n@noncopy\npublic struct Arc<T: Share> {\n    private inner: *mut ArcInner<T>;\n\n    /// Safety: the pointer comes from Box.intoRaw and is given back once, by the last owner's drop.\n    public fn create(value: T) -> Result<Arc<T>, AllocError> {\n        let boxed = Box.create(ArcInner { count: AtomicU64.create(1), value: value })?;\n        return Ok(Arc { inner: Box.intoRaw(boxed) });\n    }\n\n    /// Another owner of the same value.\n    /// Safety: this owner keeps the value alive while the count is raised.\n    public fn clone(borrow this) -> Arc<T> {\n        this.shared().count.fetchAdd(1);\n        return Arc { inner: this.inner };\n    }\n\n    /// The shared value, for as long as this owner is borrowed.\n    /// Safety: the value lives while any owner does; T is Share, so shared references to it may cross threads.\n    public fn get(borrow this) -> borrow T => borrow this.shared().value;\n\n    /// The value, to change in place, when this is its only owner (ADR 0224); null while another owner exists, which\n    /// may be reading it on another thread. Values that several owners change go in a `Mutex`: `Arc<Mutex<T>>`.\n    /// Safety: a count of one is this owner alone. No other owner can appear while it is borrowed exclusively, since\n    /// only an owner makes another (`clone`, through a borrow of it), and Arc has no weak references. The load is\n    /// sequentially consistent, so it is ordered after every earlier owner's drop, as the last owner's drop is.\n    public fn getMut(borrow mut this) -> (borrow mut T)? {\n        if (this.shared().count.load() != 1) {\n            return null;\n        }\n        let inner: borrow mut ArcInner<T> = unsafe { Ptr.toBorrowMut(this.inner) };\n        return Some(borrow mut inner.value);\n    }\n\n    /// Safety: as get.\n    fn shared(borrow this) -> borrow ArcInner<T> => unsafe { Ptr.toBorrow(this.inner as *ArcInner<T>) };\n\n    /// Safety: only the owner that brings the count from one to zero gives the box back.\n    drop {\n        if (this.shared().count.fetchSub(1) == 1) {\n            let last: Box<ArcInner<T>> = unsafe { Box.fromRaw(this.inner) };\n        }\n    }\n}\n\n/// Why Thread.spawn failed: the thread, its record or its closure could not be allocated (type-system.md §38.2).\npublic enum SpawnError {\n    Resources,\n}\n\n/// A value written at most once and then read from any thread (§38.3, ADR 0096): `OnceCell` (lib/core, §41.4) for\n/// values that threads share. Empty at first, then full for as long as the lock is shared, lending `borrow T`. One\n/// thread runs an initialiser at a time, under one lock for the process; a thread that finds a full cell reads it\n/// with one atomic load and takes no lock. A full cell changes only through an exclusive borrow (`take`, `getMut`).\n/// The state is one byte: 0 empty, 1 the initialiser is running, 2 full.\n@threadSafe\n@noncopy\npublic struct OnceLock<T: Send + Share> {\n    private state: AtomicU8;\n    private raw: RawCell<T?>;\n\n    /// An empty cell.\n    public fn create() -> OnceLock<T> => OnceLock { state: AtomicU8.create(0), raw: RawCell<T?>.create(null) };\n\n    /// An empty cell, as a static initialiser (type-system.md §39.4): `static CONFIG: OnceLock<Config> =\n    /// OnceLock<Config>.constant();`, filled once with `getOrInit` or `tryInit`.\n    @constant\n    public fn constant() -> OnceLock<T> => OnceLock { state: AtomicU8.constant(0), raw: RawCell<T?>.constant(null) };\n\n    /// The value, or null while the cell is empty.\n    public fn get(borrow this) -> borrow T? {\n        if (this.state.load() != 2) {\n            return null;\n        }\n        return this.contents().asBorrow();\n    }\n\n    /// The value; an empty cell runs `init` and stores its result first. Threads that arrive while another runs\n    /// `init` wait for it and read its value. Panics if `init` asks this cell for its value (\"cell initialised\n    /// recursively\").\n    /// Safety: the write happens under the lock with the state 0 seen there, so no reference to the contents has",
    201 =>
        "\n    /// been lent and no other thread writes; the old contents are null and need no drop. The lock is released on\n    /// every path.\n    public fn getOrInit(borrow this, init: borrow mut fn() -> T) -> borrow(this) T {\n        if (this.state.load() != 2) {\n            unsafe { ceesafe_mutex_once_lock(); }\n            let state = this.state.load();\n            if (state == 1) {\n                unsafe { ceesafe_mutex_once_unlock(); }\n                panic(\"cell initialised recursively\");\n            }\n            if (state == 0) {\n                // The process's once-lock is held, and the cell is half made: a trap in `init` in an isolated\n                // task ends the process, as it always did (ADR 0175 §2.6).\n                let critical = Critical.enter();\n                this.state.store(1);\n                let value = init();\n                unsafe { this.raw.pointer().write(value); }\n                this.state.store(2);\n            }\n            unsafe { ceesafe_mutex_once_unlock(); }\n        }\n        return this.contents().asBorrow()!;\n    }\n\n    /// Fills an empty cell from an initialiser that can fail: on `Err` the cell stays empty and the error is\n    /// returned. A full cell is left as it is, and `init` does not run. `get` or `getOrInit` then lends the value.\n    /// Panics as getOrInit.\n    /// Safety: as getOrInit.\n    public fn tryInit<E>(borrow this, init: borrow mut fn() -> Result<T, E>) -> Result<void, E> {\n        if (this.state.load() == 2) {\n            return Ok();\n        }\n        unsafe { ceesafe_mutex_once_lock(); }\n        let state = this.state.load();\n        if (state == 1) {\n            unsafe { ceesafe_mutex_once_unlock(); }\n            panic(\"cell initialised recursively\");\n        }\n        if (state == 0) {\n            let critical = Critical.enter(); // as getOrInit\n            this.state.store(1);\n            match (init()) {\n                Ok(value) => {\n                    unsafe { this.raw.pointer().write(value); }\n                    this.state.store(2);\n                }\n                Err(error) => {\n                    this.state.store(0);\n                    unsafe { ceesafe_mutex_once_unlock(); }\n                    return Err(error);\n                }\n            }\n        }\n        unsafe { ceesafe_mutex_once_unlock(); }\n        return Ok();\n    }\n\n    /// Stores `value` in an empty cell. A cell that is full, or whose initialiser is running, gives the value back.\n    /// Safety: as getOrInit.\n    public fn set(borrow this, value: T) -> Result<void, T> {\n        unsafe { ceesafe_mutex_once_lock(); }\n        if (this.state.load() != 0) {\n            unsafe { ceesafe_mutex_once_unlock(); }\n            return Err(value);\n        }\n        unsafe { this.raw.pointer().write(value); }\n        this.state.store(2);\n        unsafe { ceesafe_mutex_once_unlock(); }\n        return Ok();\n    }\n\n    /// The value, for as long as the cell is borrowed exclusively; null while the cell is empty.\n    public fn getMut(borrow mut this) -> (borrow mut T)? => this.raw.getMut().asBorrowMut();\n\n    /// The value, leaving the cell empty: no reference to it can be live while the cell is borrowed exclusively.\n    /// Safety: the contents are read out and null written in their place, so they have one owner.\n    public fn take(borrow mut this) -> T? {\n        let p = this.raw.pointer();\n        let old = unsafe { p.read() };\n        unsafe { p.write(null); }\n        this.state.store(0);\n        return old;\n    }\n\n    /// The value, the cell consumed.\n    public fn intoInner(this) -> T? => this.raw.intoInner();\n\n    /// The contents as a shared reference.\n    /// Safety: nothing writes the contents of a full cell while it is shared, and an empty cell's are null until the\n    /// write that fills it, which happens before any reference from here is used again.\n    fn contents(borrow this) -> borrow (T?) => unsafe { Ptr.toBorrow(this.raw.pointer() as *(T?)) };\n}\n",
    202 =>
        "// Tests (ADR 0049): what a failed check returns, the checks, and the generated harness's side of the runner protocol.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_test_begin(failAllocAt: u64, cancelAt: u64);\n    @effects()\n    fn ceesafe_thread_watchdog(ms: u64);\n    @effects()\n    fn ceesafe_scan_begin();\n    @effects()\n    fn ceesafe_freed_holds(p: *u8, n: u64) -> u32;\n}\n\n/// The freed-block scan (ADR 0197 §4.3, type-system.md §42.4): with `ceesafec test --scan-freed`, or\n/// `CEESAFE_SCAN_FREED=1` for a built program, every freed block of every CeeSafe allocator is kept as it was at its\n/// free. A test then asks whether a secret was left behind.\npublic struct Testing {\n    /// Whether a block freed since the scan began holds the bytes of `pattern`, anywhere in it; `false` while the scan\n    /// is off. An empty pattern is found in any kept block.\n    /// Safety: the runtime reads the pattern's length of bytes, during the call only.\n    public fn freedHolds(pattern: Slice<u8>) -> bool =>\n        unsafe { ceesafe_freed_holds(pattern.ptr, pattern.length as u64) } != 0;\n}\n\n/// What a failed check returns (ADR 0049 §3.2): a message, owned, so it borrows nothing from the test. `ceesafec test`\n/// shows it with the test's name.\npublic struct TestFailure {\n    public message: Vector<u8>;\n\n    /// A failure with `message`. If the message cannot be allocated, the failure has an empty one: it still fails.\n    public fn create(message: StringView) -> TestFailure {\n        var bytes = Vector<u8>.create();\n        for (b in message.bytes()) {\n            match (bytes.push(b)) {\n                Ok() => {}\n                Err(_) => { return TestFailure { message: bytes }; }\n            }\n        }\n        return TestFailure { message: bytes };\n    }\n\n    /// A failure with what `w` wrote.\n    fn written(w: borrow TextWriter) -> TestFailure {\n        var bytes = Vector<u8>.create();\n        for (b in w.written()) {\n            match (bytes.push(b)) {\n                Ok() => {}\n                Err(_) => { return TestFailure { message: bytes }; }\n            }\n        }\n        return TestFailure { message: bytes };\n    }\n}\n\n/// The checks of a test (ADR 0049 §3.2): each is `Ok` when it holds, and otherwise `Err` with what was expected, for\n/// `?`. The comparisons are typed: CeeSafe has no equality interface yet for a generic one.\npublic struct Check {\n    /// `condition` holds; `what` says what it is.\n    public fn isTrue(condition: bool, what: StringView) -> Result<void, TestFailure> {\n        if (condition) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected true: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `condition` does not hold.\n    public fn isFalse(condition: bool, what: StringView) -> Result<void, TestFailure> {\n        if (!condition) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected false: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is `expected`.\n    public fn equalU64(expected: u64, actual: u64) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 128];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \");\n        w.decimal(expected);\n        w.text(\", got \");\n        w.decimal(actual);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` is `expected`.\n    public fn equalI64(expected: i64, actual: i64) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 128];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \");\n        w.signed(expected);\n        w.text(\", got \");\n        w.signed(actual);\n        return Err(Tes",
    203 =>
        "tFailure.written(borrow w));\n    }\n\n    /// `actual` is the text `expected`.\n    public fn equalText(expected: StringView, actual: StringView) -> Result<void, TestFailure> {\n        if (expected == actual) {\n            return Ok();\n        }\n        var buffer = [0u8; 1024];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected \\\"\");\n        w.text(expected);\n        w.text(\"\\\", got \\\"\");\n        w.text(actual);\n        w.text(\"\\\"\");\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `actual` has the bytes of `expected`; else where they first differ.\n    public fn equalBytes(expected: Slice<u8>, actual: Slice<u8>) -> Result<void, TestFailure> {\n        var at: usize = 0;\n        while (at < expected.length && at < actual.length && expected[at] == actual[at]) {\n            at += 1;\n        }\n        if (at == expected.length && at == actual.length) {\n            return Ok();\n        }\n        var buffer = [0u8; 256];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"the bytes differ at \");\n        w.decimal(at as u64);\n        w.text(\": expected \");\n        if (at < expected.length) {\n            w.text(\"0x\");\n            w.hex(expected[at] as u64, 2);\n        } else {\n            w.text(\"the end\");\n        }\n        w.text(\", got \");\n        if (at < actual.length) {\n            w.text(\"0x\");\n            w.hex(actual[at] as u64, 2);\n        } else {\n            w.text(\"the end\");\n        }\n        w.text(\" (lengths \");\n        w.decimal(expected.length as u64);\n        w.text(\" and \");\n        w.decimal(actual.length as u64);\n        w.text(\")\");\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// A failure with `message`, always.\n    public fn fail(message: StringView) -> Result<void, TestFailure> => Err(TestFailure.create(message));\n}\n\n/// The checks of a `Result` (ADR 0049 §3.2), a generic struct's since a method declares no type parameters of its own:\n/// `CheckResult<u32, ParseError>.isOk(borrow parsed, \"the line parses\")?`.\npublic struct CheckResult<T, E> {\n    /// `r` is `Ok`.\n    public fn isOk(r: borrow Result<T, E>, what: StringView) -> Result<void, TestFailure> {\n        let failed = match (r) {\n            Err(_) => true,\n            _ => false,\n        };\n        if (!failed) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected Ok: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n\n    /// `r` is `Err`.\n    public fn isErr(r: borrow Result<T, E>, what: StringView) -> Result<void, TestFailure> {\n        let failed = match (r) {\n            Err(_) => true,\n            _ => false,\n        };\n        if (failed) {\n            return Ok();\n        }\n        var buffer = [0u8; 512];\n        var w = TextWriter.create(mut buffer[..]);\n        w.text(\"expected Err: \");\n        w.text(what);\n        return Err(TestFailure.written(borrow w));\n    }\n}\n\n/// The generated harness's side of the runner protocol, version 1 (ADR 0049 §3.4). Not for tests to call.\npublic struct TestRun {\n    /// Before the test: the arguments after the test's name, `<fail-alloc-at> <cancel-at> <timeout-ms>` (0: none),\n    /// and `1` after them for `--scan-freed` (ADR 0197 §4.3), turn the runtime's reports and hooks on and arm the\n    /// timeout.\n    /// Safety: the runtime only records the numbers, and the watchdog only waits and ends the process.\n    public fn begin() {\n        let failAt = TestRun.number(3);\n        let cancelAt = TestRun.number(4);\n        let timeout = TestRun.number(5);\n        let scan = TestRun.number(6);\n        unsafe {\n            ceesafe_test_begin(failAt, cancelAt);\n            ceesafe_thread_watchdog(timeout);\n            if (scan != 0) {\n                ceesafe_scan_begin();\n            }\n        }\n    }\n\n    /// Argument `k` as a decimal number, or 0.\n    fn number(k: usize) -> u64 {\n        var value: u64 = 0;\n        ma",
