    17 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Interior mutability (type-system.md §41; ADR 0084): RawCell, the one type whose contents may change while shared\n// loans of it are live, and the checked cells over it. A type that reaches a RawCell is Send when its contents are, but\n// not Share (§38.1), so a cell is used from one thread at a time. Their unsafe code keeps ownership.md T1–T3.\n\n/// The primitive (§41.1): a `T` that may be read and written through `pointer()` while shared loans of the cell, or of\n/// a value holding it, are live. It has `T`'s size and alignment. `T` may not hold loans (N0351).\n@interiorMutable\n@noncopy\npublic struct RawCell<T> {\n    private value: T;\n\n    /// A cell holding `value`.\n    public fn create(value: T) -> RawCell<T> => RawCell { value: value };\n\n    /// The contents' address: safe to take, `unsafe` to use. Unsafe code must not make two live `borrow mut T` from\n    /// it, nor write while a `borrow T` it made is live (unsafe.md §2).\n    public fn pointer(borrow this) -> *mut T => borrow this.value as *T as *mut T;\n\n    /// The contents, for as long as the cell is borrowed exclusively: no other loan of it can be live.\n    public fn getMut(borrow mut this) -> borrow mut T => borrow mut this.value;\n\n    /// The contents, the cell consumed.\n    public fn intoInner(this) -> T => this.value;\n}\n\n/// A `Copy` value that may be read and replaced through a shared reference (§41.2): `get` copies it out, `set` stores\n/// a new one. No method lends a reference to the contents, so no change can be seen through a stale one, and a call\n/// between two methods (a re-entrant callback) is harmless. `==` and `!=` compare the contents when `T` has them.\npublic struct Cell<T: Copy> {\n    private raw: RawCell<T>;\n\n    /// A cell holding `value`.\n    public fn create(value: T) -> Cell<T> => Cell { raw: RawCell<T>.create(value) };\n\n    /// A copy of the contents.\n    /// Safety: no reference to the contents is ever lent, so nothing writes them during the read; `T` is Copy.\n    public fn get(borrow this) -> T => unsafe { this.raw.pointer().read() };\n\n    /// Stores `value`; the old contents need no drop (`T` is Copy), so no user code runs.\n    /// Safety: as get; nothing reads the contents during the write.\n    public fn set(borrow this, value: T) {\n        unsafe { this.raw.pointer().write(value); }\n    }\n\n    /// Stores `value` and returns the old contents.\n    /// Safety: as set.\n    public fn replace(borrow this, value: T) -> T {\n        let p = this.raw.pointer();\n        let old = unsafe { p.read() };\n        unsafe { p.write(value); }\n        return old;\n    }\n\n    /// The contents, for as long as the cell is borrowed exclusively.\n    public fn getMut(borrow mut this) -> borrow mut T => this.raw.getMut();\n\n    /// The contents, the cell consumed.\n    public fn intoInner(this) -> T => this.raw.intoInner();\n}\n\n/// A value lent through a shared reference with checked access (§41.3): any number of `read` guards, or one `write`\n/// guard, at a time. A conflict panics (\"cell already borrowed\"); `tryRead` and `tryWrite` return null instead. The\n/// state is one word: 0 free, n > 0 readers, -1 writing.\npublic struct RefCell<T> {\n    private state: Cell<isize>;\n    private raw: RawCell<T>;\n\n    /// A cell holding `value`, free.\n    public fn create(value: T) -> RefCell<T> => RefCell { state: Cell<isize>.create(0), raw: RawCell<T>.create(value) };\n\n    /// Shared access until the guard is dropped; panics while a `write` guard is live.\n    public fn read(borrow this) -> CellRef<T> {\n        let state = this.state.get();\n        if (state < 0 || state == 0x7FFFFFFF) {\n            panic(\"cell already borrowed\");\n        }\n        this.state.set(state + 1);\n        return CellRef { cell: this };\n    }\n\n    /// As read, or null while a `write` guard is live.\n    public fn tryRead(borrow this) -> CellRef<T>? {\n        let state = this.state.get();\n        if (state < 0 || state == 0x7FFFFFF",
    18 =>
        "F) {\n            return null;\n        }\n        this.state.set(state + 1);\n        return CellRef { cell: this };\n    }\n\n    /// Exclusive access until the guard is dropped; panics while any guard is live.\n    public fn write(borrow this) -> CellRefMut<T> {\n        if (this.state.get() != 0) {\n            panic(\"cell already borrowed\");\n        }\n        this.state.set(-1);\n        return CellRefMut { cell: this };\n    }\n\n    /// As write, or null while any guard is live.\n    public fn tryWrite(borrow this) -> CellRefMut<T>? {\n        if (this.state.get() != 0) {\n            return null;\n        }\n        this.state.set(-1);\n        return CellRefMut { cell: this };\n    }\n\n    /// Stores `value` and returns the old contents, moved out before the return: their drop runs in the caller, with\n    /// no guard live. Panics while any guard is live.\n    /// Safety: no guard is live, so no reference to the contents is; the old value is read out before the write.\n    public fn replace(borrow this, value: T) -> T {\n        if (this.state.get() != 0) {\n            panic(\"cell already borrowed\");\n        }\n        let p = this.raw.pointer();\n        let old = unsafe { p.read() };\n        unsafe { p.write(value); }\n        return old;\n    }\n\n    /// The contents, for as long as the cell is borrowed exclusively: no guard can be live.\n    public fn getMut(borrow mut this) -> borrow mut T => this.raw.getMut();\n\n    /// The contents, the cell consumed.\n    public fn intoInner(this) -> T => this.raw.intoInner();\n\n    /// The contents as a shared reference, for a guard.\n    /// Safety: only a live guard calls it, and the state it set keeps every writer out while the reference is used.\n    fn shared(borrow this) -> borrow T => unsafe { Ptr.toBorrow(this.raw.pointer() as *T) };\n\n    /// A `read` guard's drop.\n    fn releaseRead(borrow this) {\n        this.state.set(this.state.get() - 1);\n    }\n\n    /// A `write` guard's drop.\n    fn releaseWrite(borrow this) {\n        this.state.set(0);\n    }\n}\n\n/// `RefCell.take` on a `RefCell<T?>` (§41.3): the contents, leaving null.\npublic struct RefCellTaking<T> {\n    /// Panics while any guard is live, as replace.\n    public fn take(cell: borrow RefCell<T?>) -> T? => cell.replace(null);\n}\n\n/// A `read` guard of a RefCell (§41.3): `data()` lends the contents shared; dropping it gives the access back.\npublic struct CellRef<region r, T> {\n    private cell: borrow(r) RefCell<T>;\n\n    /// The contents, for as long as the guard is borrowed.\n    public fn data(borrow this) -> borrow T => this.cell.shared();\n\n    drop {\n        this.cell.releaseRead();\n    }\n}\n\n/// A `write` guard of a RefCell (§41.3): `data()` lends the contents exclusively; dropping it gives the access back.\npublic struct CellRefMut<region r, T> {\n    private cell: borrow(r) RefCell<T>;\n\n    /// The contents, for as long as the guard is borrowed exclusively.\n    /// Safety: the guard set the state to -1, so no other guard is live and none can be made while it is; the loan\n    /// ends before the guard's drop gives the access back (a RawCell's contents may change while the cell is\n    /// shared, type-system.md §41.1).\n    public fn data(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.cell.raw.pointer()) };\n\n    drop {\n        this.cell.releaseWrite();\n    }\n}\n\n/// A value written at most once through a shared reference (§41.4, ADR 0096): empty at first, then full for as long\n/// as the cell is shared, lending `borrow T`. `getOrInit` fills an empty cell from its initialiser; `set` fills it\n/// with a value. A full cell changes only through an exclusive borrow (`take`, `getMut`), when no reference to the\n/// contents can be live. The state is one byte: 0 empty, 1 the initialiser is running, 2 full.\npublic struct OnceCell<T> {\n    private state: Cell<u8>;\n    private raw: RawCell<T?>;\n\n    /// An empty cell.\n    public fn create() -> OnceCell<T> => OnceCell { state: Cell<u8>.create(0), raw: RawCell<T?>.create(null) };\n\n    /// T",
    19 =>
        "he value, or null while the cell is empty.\n    public fn get(borrow this) -> borrow T? {\n        if (this.state.get() != 2) {\n            return null;\n        }\n        return this.contents().asBorrow();\n    }\n\n    /// The value; an empty cell runs `init` and stores its result first. Panics if `init` asks this cell for its\n    /// value (\"cell initialised recursively\").\n    /// Safety: the state is 0, so no reference to the contents has been lent and `init` cannot get one (a nested\n    /// call panics); the old contents are null and need no drop.\n    public fn getOrInit(borrow this, init: borrow mut fn() -> T) -> borrow(this) T {\n        let state = this.state.get();\n        if (state == 1) {\n            panic(\"cell initialised recursively\");\n        }\n        if (state == 0) {\n            this.state.set(1);\n            let value = init();\n            unsafe { this.raw.pointer().write(value); }\n            this.state.set(2);\n        }\n        return this.contents().asBorrow()!;\n    }\n\n    /// Fills an empty cell from an initialiser that can fail: on `Err` the cell stays empty and the error is\n    /// returned. A full cell is left as it is, and `init` does not run. `get` or `getOrInit` then lends the value.\n    /// Panics as getOrInit.\n    /// Safety: as getOrInit.\n    public fn tryInit<E>(borrow this, init: borrow mut fn() -> Result<T, E>) -> Result<void, E> {\n        let state = this.state.get();\n        if (state == 1) {\n            panic(\"cell initialised recursively\");\n        }\n        if (state == 0) {\n            this.state.set(1);\n            match (init()) {\n                Ok(value) => {\n                    unsafe { this.raw.pointer().write(value); }\n                    this.state.set(2);\n                }\n                Err(error) => {\n                    this.state.set(0);\n                    return Err(error);\n                }\n            }\n        }\n        return Ok();\n    }\n\n    /// Stores `value` in an empty cell. A cell that is full, or whose initialiser is running, gives the value back.\n    /// Safety: as getOrInit.\n    public fn set(borrow this, value: T) -> Result<void, T> {\n        if (this.state.get() != 0) {\n            return Err(value);\n        }\n        unsafe { this.raw.pointer().write(value); }\n        this.state.set(2);\n        return Ok();\n    }\n\n    /// The value, for as long as the cell is borrowed exclusively; null while the cell is empty.\n    public fn getMut(borrow mut this) -> (borrow mut T)? => this.raw.getMut().asBorrowMut();\n\n    /// The value, leaving the cell empty: no reference to it can be live while the cell is borrowed exclusively.\n    /// Safety: the contents are read out and null written in their place, so they have one owner.\n    public fn take(borrow mut this) -> T? {\n        let p = this.raw.pointer();\n        let old = unsafe { p.read() };\n        unsafe { p.write(null); }\n        this.state.set(0);\n        return old;\n    }\n\n    /// The value, the cell consumed.\n    public fn intoInner(this) -> T? => this.raw.intoInner();\n\n    /// The contents as a shared reference.\n    /// Safety: nothing writes the contents of a full cell while it is shared, and an empty cell's are null until the\n    /// write that fills it, which happens before any reference from here is used again.\n    fn contents(borrow this) -> borrow (T?) => unsafe { Ptr.toBorrow(this.raw.pointer() as *(T?)) };\n}\n",
    20 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: C strings (ADR 0087 §2.4, type-system.md §22.3). `c\"…\"` is a `CStr<static>`; `CStr.fromBytesWithNul`\n// makes one from bytes that end in their only NUL. Bundled with ceesafec and part of every package.\n\n/// A view of UTF-8 text with a NUL byte after its end, valid for region `r` as a `StringView<r>` is: what a C\n/// function taking a `const char *` needs. Copy; a field of this type needs a region parameter, as a view's does.\npublic struct CStr<region r> {\n    private text: StringView<r>; // the text, without the NUL\n    private bytes: Slice<r, u8>; // the text and its NUL, which is its only one\n\n    /// Bytes ending in a NUL that is their only one, as valid UTF-8 text before it; else null.\n    public fn fromBytesWithNul(b: Slice<r, u8>) -> CStr<r>? {\n        if (b.length == 0 || b[b.length - 1] != 0) {\n            return null;\n        }\n        for (k in 0..(b.length - 1)) {\n            if (b[k] == 0) {\n                return null;\n            }\n        }\n        return match (StringView.fromUtf8(b[..(b.length - 1)])) {\n            Some(text) => CStr { text: text, bytes: b },\n            null => null,\n        };\n    }\n\n    /// The address of the first byte, for C: the text is followed by its NUL.\n    public fn ptr(borrow this) -> *CChar => this.bytes.ptr as *CChar;\n\n    /// The text, without the NUL.\n    public fn view(borrow this) -> StringView<r> => this.text;\n\n    /// The text's length in bytes, without the NUL.\n    public fn length(borrow this) -> usize => this.text.length;\n\n    /// The text and its NUL: `length + 1` bytes.\n    public fn bytesWithNul(borrow this) -> Slice<r, u8> => this.bytes;\n}\n",
    21 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: what `@derive(Equal)` writes (ADR 0087 §2.3, type-system.md §28.1). Bundled with ceesafec and part of every\n// package.\n\n/// The equality `@derive(Equal)` gives a struct or enum: `a == b` on the type calls `a.derivedEqual(b)`, and `a != b`\n/// negates it. Only the compiler implements it: an `impl` written by hand is N0290, so `==` keeps one meaning\n/// (language-spec.md §6).\npublic interface DerivedEqual<T> {\n    /// Whether `other` has the same fields, compared in declaration order; for an enum, the same variant and payloads.\n    fn derivedEqual(borrow this, other: borrow T) -> bool;\n}\n\n/// `==` on slices, arrays and vectors of a type `@derive(Equal)` gave equality (ADR 0087 §2.3): the same length, and\n/// each element equal to the other's, in order. The compiler calls it for `a == b`; a program has no need to.\npublic struct DerivedEqualElements<T: DerivedEqual<T>> {\n    /// Whether `a` and `b` have the same length and equal elements.\n    public fn equal(a: Slice<T>, b: Slice<T>) -> bool {\n        if (a.length != b.length) {\n            return false;\n        }\n        for (k in 0..a.length) {\n            if (!a[k].derivedEqual(borrow b[k])) {\n                return false;\n            }\n        }\n        return true;\n    }\n}\n",
    22 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Text formatted into a caller's buffer, with no allocation, in every profile (ADR 0041 §3.3): what C code builds with\n// snprintf, built in safe CeeSafe. lib/kernel's KernelLog sends such a line to the kernel log.\n\n/// A writer of text into a caller's byte buffer, as C's `snprintf` writes: what does not fit is cut off, the text is\n/// always zero-terminated in a buffer of at least one byte (so `cText` can be handed to C), and `wanted` counts every\n/// byte asked for, as `snprintf`'s result does, so a caller can tell that the text was cut.\npublic struct TextWriter<region r> {\n    private buffer: SliceMut<r, u8>;\n    private used: usize;  // bytes written: at most buffer.length - 1, followed by a zero\n    private asked: usize; // bytes asked for, written or not\n\n    /// A writer at the start of `buffer`, which it empties (a zero first byte, if it has one).\n    public fn create(buffer: SliceMut<r, u8>) -> TextWriter<r> {\n        if (buffer.length > 0) {\n            buffer[0] = 0;\n        }\n        return TextWriter { buffer: buffer, used: 0, asked: 0 };\n    }\n\n    /// Appends one byte.\n    public fn byte(borrow mut this, b: u8) {\n        this.asked = this.asked.wrappingAdd(1);\n        if (this.used + 1 < this.buffer.length) {\n            this.buffer[this.used] = b;\n            this.used += 1;\n            this.buffer[this.used] = 0;\n        }\n    }\n\n    /// Appends bytes.\n    public fn bytes(borrow mut this, data: Slice<u8>) {\n        for (b in data) {\n            this.byte(b);\n        }\n    }\n\n    /// Appends text.\n    public fn text(borrow mut this, s: StringView) {\n        this.bytes(s.bytes());\n    }\n\n    /// Appends an unsigned integer in decimal.\n    public fn decimal(borrow mut this, value: u64) {\n        var digits: [u8; 20] = [0; 20];\n        var count: usize = 0;\n        var v = value;\n        loop {\n            digits[count] = truncate<u8>(v % 10) + 48;\n            count += 1;\n            v = v / 10;\n            if (v == 0) {\n                break;\n            }\n        }\n        while (count > 0) {\n            count -= 1;\n            this.byte(digits[count]);\n        }\n    }\n\n    /// Appends a signed integer in decimal, with a `-` if it is negative.\n    public fn signed(borrow mut this, value: i64) {\n        if (value < 0) {\n            this.byte(45);\n            // The magnitude, in two's complement: right for i64's least value too, whose negation an i64 cannot hold.\n            this.decimal(0u64.wrappingSub(truncate<u64>(value)));\n        } else {\n            this.decimal(truncate<u64>(value)); // not negative here\n        }\n    }\n\n    /// Appends an unsigned integer in lowercase hexadecimal, with at least `width` digits (zeros before it), as\n    /// `%0*llx`; no `0x`.\n    public fn hex(borrow mut this, value: u64, width: u32) {\n        var digits: [u8; 16] = [0; 16];\n        var count: usize = 0;\n        var v = value;\n        loop {\n            let d = truncate<u8>(v & 15);\n            digits[count] = if (d < 10) d + 48 else d + 87;\n            count += 1;\n            v = v >> 4;\n            if (v == 0) {\n                break;\n            }\n        }\n        var pad = width as usize;\n        while (pad > count) {\n            this.byte(48);\n            pad -= 1;\n        }\n        while (count > 0) {\n            count -= 1;\n            this.byte(digits[count]);\n        }\n    }\n\n    /// The bytes written, without the terminating zero.\n    public fn written(borrow this) -> Slice<u8> => this.buffer[..this.used];\n\n    /// How many bytes were written (at most the buffer's length less one).\n    public fn length(borrow this) -> usize => this.used;\n\n    /// How many bytes were asked for: more than `length()` when the text was cut, as `snprintf`'s result.\n    public fn wanted(borrow this) -> usize => this.asked;\n\n    /// Whether some text did not fit.\n    public fn truncated(borrow this) -> bool => this.asked > this.used;\n\n    /// The text as a zero-ter",
    23 =>
        "minated C string, valid while the writer's buffer is. An empty buffer, which can hold no\n    /// terminator, gives an empty string that is not in it.\n    public fn cText(borrow this) -> *CChar {\n        if (this.buffer.length == 0) {\n            return \"\\0\".ptr as *CChar;\n        }\n        let all = this.written(); // starts where the buffer does\n        return all.ptr as *CChar;\n    }\n}\n\n/// Where `appendPadded` puts text in a wider field (ADR 0087 §2.9): Rust's `{:<w}`, `{:>w}` and `{:^w}`. A centred\n/// text's extra fill character goes after it.\npublic enum TextAlign { Left, Right, Center }\n\n/// The formatting helpers of `String` and `VectorBytes` (ADR 0087 §2.9): what Rust's `{:x}`, `{:08X}`, `{:o}`,\n/// `{:.3}` and `{:>8}` write. Each appends to a byte vector; static functions, the struct is never made.\npublic struct Formatted {\n    /// `value` in hexadecimal, at least `minWidth` digits (zeros before it), uppercase when `upper`; no `0x`.\n    public fn hex(out: borrow mut Vector<u8>, value: u64, minWidth: u32, upper: bool) -> Result<void, AllocError> {\n        var digits = [0u8; 16];\n        var count: usize = 0;\n        var v = value;\n        loop {\n            let d = truncate<u8>(v & 15);\n            digits[count] = if (d < 10) d + 48 else if (upper) d + 55 else d + 87;\n            count += 1;\n            v = v >> 4;\n            if (v == 0) {\n                break;\n            }\n        }\n        return Formatted.digitsOut(out, digits[..count], minWidth as usize);\n    }\n\n    /// `value` in octal; no `0o`.\n    public fn octal(out: borrow mut Vector<u8>, value: u64) -> Result<void, AllocError> {\n        var digits = [0u8; 22];\n        var count: usize = 0;\n        var v = value;\n        loop {\n            digits[count] = truncate<u8>(v & 7) + 48;\n            count += 1;\n            v = v >> 3;\n            if (v == 0) {\n                break;\n            }\n        }\n        return Formatted.digitsOut(out, digits[..count], 0);\n    }\n\n    /// Least significant first, as the digit loops make them: at least `width` digits, zeros before.\n    fn digitsOut(out: borrow mut Vector<u8>, reversed: Slice<u8>, width: usize) -> Result<void, AllocError> {\n        var pad = width;\n        while (pad > reversed.length) {\n            out.push(48)?;\n            pad -= 1;\n        }\n        var k = reversed.length;\n        while (k > 0) {\n            k -= 1;\n            out.push(reversed[k])?;\n        }\n        return Ok();\n    }\n\n    /// `value` in decimal with exactly `digits` digits after the point (none, and no point, for 0), rounded half to\n    /// even on its exact binary value, as Rust's `{:.N}` and C's `%.Nf` round; `NaN`, `inf` and `-inf` as Rust writes\n    /// them. A negative zero keeps its sign.\n    public fn fixed(out: borrow mut Vector<u8>, value: f64, digits: u32) -> Result<void, AllocError> {\n        let bits = value.bits();\n        let negative = (bits >> 63) != 0;\n        let exponent = truncate<u32>((bits >> 52) & 0x7FF);\n        let fraction = bits & 0xFFFFFFFFFFFFF;\n        if (exponent == 0x7FF) {\n            if (fraction != 0) {\n                return out.extend(\"NaN\".bytes());\n            }\n            if (negative) {\n                out.push(45)?;\n            }\n            return out.extend(\"inf\".bytes());\n        }\n        // value = m · 2^e exactly; its decimal digits, least significant first, are m · 2^e, or m · 5^k with k of\n        // them after the point (k = -e). With the zeros before the point, at most 1,075 digits (k ≤ 1074).\n        var m = fraction;\n        var e: i64 = -1074;\n        if (exponent != 0) {\n            m = fraction | 0x10000000000000;\n            e = (exponent as i64) - 1075;\n        }\n        if (m == 0) {\n            e = 0; // a zero has no digits to scale\n        }\n        var d = [0u8; 1100];\n        var length: usize = 0;\n        var rest = m;\n        loop {\n            d[length] = truncate<u8>(rest % 10);\n            length += 1;\n            rest = rest / 10;\n            if (rest ",
    24 =>
        "== 0) {\n                break;\n            }\n        }\n        var point: usize = 0; // how many of the digits are after the decimal point\n        // Scaled 30 twos (2^30) or 13 fives (5^13) at a time, both below 2^31, then by the rest.\n        if (e > 0) {\n            var left = e;\n            while (left > 0) {\n                let step: i64 = if (left > 30) 30 else left;\n                length = Formatted.multiply(mut d[..], length, 1u64 << truncate<u64>(step));\n                left -= step;\n            }\n        } else if (e < 0) {\n            let k = truncate<usize>(0 - e);\n            var left = k;\n            while (left > 0) {\n                let step: usize = if (left > 13) 13 else left;\n                var factor: u64 = 1;\n                for (j in 0..step) {\n                    factor *= 5;\n                }\n                length = Formatted.multiply(mut d[..], length, factor);\n                left -= step;\n            }\n            point = k;\n        }\n        while (length <= point) {\n            d[length] = 0; // a zero before the point, and the leading zeros after it\n            length += 1;\n        }\n        let wanted = digits as usize;\n        if (point > wanted) {\n            // Drop the extra digits, rounding half to even on all of them.\n            let dropped = point - wanted;\n            let first = d[dropped - 1];\n            var below = false;\n            for (k in 0..(dropped - 1)) {\n                if (d[k] != 0) {\n                    below = true;\n                }\n            }\n            let up = first > 5 || (first == 5 && (below || d[dropped] % 2 == 1));\n            for (k in dropped..length) {\n                d[k - dropped] = d[k];\n            }\n            length -= dropped;\n            if (up) {\n                var k: usize = 0;\n                loop {\n                    if (k == length) {\n                        d[length] = 1;\n                        length += 1;\n     