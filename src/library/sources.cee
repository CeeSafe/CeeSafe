    46 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// The kernel heap (ADR 0025; from C5, docs/cosmoos/c5-report.md, type-system.md §30). CosmoOS's allocator is used as\n// it is: kmalloc and kfree, both exported (kernel/memory/kmalloc.c).\n\n@header(\"kernel/kmalloc.h\")\nextern \"C\" {\n    // Effects (type-system.md §32): kmalloc never sleeps (kmalloc.h: \"non-blocking and interrupt-safe\"), so it is\n    // allowed in atomic contexts; whether an IRQ handler may allocate is KQ-1, and CeeSafe's @context(irq) says no.\n    @effects(alloc)\n    fn kmalloc(size: usize, flags: u32) -> *mut void;\n    @effects()\n    fn kfree(p: *mut void);\n}\n\n/// CosmoOS's kernel heap (kernel/include/kernel/kmalloc.h): non-blocking and interrupt-safe; blocks are at least\n/// 16-byte aligned; at most KMALLOC_MAX_SIZE (4 MiB). `Box<T, KernelHeap>` is one pointer, freed with kfree.\npublic struct KernelHeap {}\n\nimpl Allocator for KernelHeap {\n    /// Safety: kmalloc returns null or a block of `layout.size` bytes, 16-byte aligned (kmalloc.h); larger\n    /// alignments are refused here, so an Ok block always meets `layout`.\n    fn allocate(borrow this, layout: Layout) -> Result<*mut u8, AllocError> {\n        if (layout.align > 16) {\n            return Err(AllocError.OutOfMemory);\n        }\n        let p = unsafe { kmalloc(layout.size, 0) } as *mut u8;\n        if (p.isNull()) {\n            return Err(AllocError.OutOfMemory);\n        }\n        return Ok(p);\n    }\n\n    /// Safety: the caller (Box) passes a block from `allocate`, once: kfree's contract (kmalloc.h).\n    unsafe fn deallocate(borrow this, p: *mut u8, layout: Layout) {\n        kfree(p as *mut void);\n    }\n}\n",
    47 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Kernel objects (ADR 0025; from C7d). A CeeSafe-defined kernel object embeds CosmoOS's own struct kobject (kernel/include/kernel/object.h)\n// and its struct kobject_type; KRef<T> is an owned, counted reference to one (kobject_get / kobject_put). The last\n// put runs the type's release, a generated C callback (type-system.md §34.1) that drops the CeeSafe data and frees the\n// object. CeeSafe never frees a kernel object any other way.\n//\n// CosmoOS's rules these follow (kernel/object/object.c; audit in docs/cosmoos/c7-report.md):\n// - kobject_init(obj, type) needs a type with a release; the count starts at 1; the kernel keeps `type`, so it lives\n//   inside the object here, and nothing reads it after release returns (kobject_release_final, object.c:61-72);\n// - the object's owner is the module whose text holds `release` (module_owner_of): module unload waits for it;\n// - the final put runs release, which may block, and nothing checks that it is not done under a spinlock: here\n//   kobject_put has the `sleep` effect, so a final put under a spin guard does not compile (type-system.md §32).\n\n@header(\"kernel/object.h\")\nextern \"C\" {\n    struct kobject;\n    struct kobject_type {\n        name: *CChar;\n        release: extern \"C\" fn(*mut kobject);\n        flags: u32;\n    }\n    @effects()\n    fn kobject_init(obj: *mut kobject, kind: *kobject_type);\n    @effects()\n    fn kobject_get(obj: *mut kobject);\n    @effects(sleep)\n    fn kobject_put(obj: *mut kobject);\n    @effects()\n    fn kobject_refcount(obj: *kobject) -> u32;\n}\n\n/// A kernel object: CosmoOS's kobject first (so the kernel's `struct kobject *` is the object's address, type-system.md\n/// §34.3), then its type, then the CeeSafe data. Made only by KRef<T>.create, and never moved.\npublic struct KObject<T> {\n    private obj: kobject;\n    private kind: kobject_type;\n    private name: *CChar;\n    private data: T;\n\n    /// Safety: runs once, at the object's final address, before anything else can see it (type-system.md §33.3); the\n    /// type it registers lives in the object, so it outlives every use the kernel makes of it.\n    @placed\n    fn init(borrow mut this) {\n        this.kind.name = this.name;\n        this.kind.release = release<T>;\n        unsafe { kobject_init(borrow mut this.obj as *mut kobject, borrow this.kind as *kobject_type); }\n    }\n}\n\n/// An owned reference to a kernel object. Cloning takes a count; dropping gives one back, and the last one releases\n/// the object. The data is shared, as the object is: state that changes goes behind a lock inside it.\npublic struct KRef<T> {\n    private object: *mut KObject<T>;\n\n    /// Makes an object with one reference. `name` is its type's name: a static string ending in a zero byte.\n    public fn create(name: *CChar, data: T) -> Result<KRef<T>, AllocError> {\n        match (Box.createIn(KernelHeap {}, KObject { name: name, data: data })) {\n            Ok(object) => { return Ok(KRef { object: Box.intoRaw(object) }); }\n            Err(e) => { return Err(e); }\n        }\n    }\n\n    /// Another reference to the same object.\n    /// Safety: this reference holds a count, so the object is live, as kobject_get needs.\n    public fn clone(borrow this) -> KRef<T> {\n        unsafe { kobject_get(this.header()); }\n        return KRef { object: this.object };\n    }\n\n    /// The data, while this reference is borrowed.\n    /// Safety: the object lives as long as a reference to it does, and the data is only read through it.\n    public fn get(borrow this) -> borrow T {\n        let object = unsafe { Ptr.toBorrow(this.object as *KObject<T>) };\n        return borrow object.data;\n    }\n\n    /// The object's reference count (kobject_refcount), for tests and diagnostics.\n    /// Safety: as get.\n    public fn count(borrow this) -> u32 => unsafe { kobject_refcount(this.header() as *kobject) };\n\n    fn header(borrow this) -> *mut kobject => this.object as *mut kobject;\n\n    /// Safety: ",
    48 =>
        "this reference held one count, which goes back here; the last put runs release<T>.\n    drop {\n        unsafe { kobject_put(this.header()); }\n    }\n}\n\n/// The release of every KObject<T>: the last reference is gone, so the data is dropped and the object freed.\n/// Safety: the kernel calls this once per object, after its count reached zero (kobject_release_final), with the\n/// kobject that KRef<T>.create made as the first field of a Box<KObject<T>, KernelHeap>.\n@callback\nunsafe fn release<T>(obj: *mut kobject) {\n    let object: Box<KObject<T>, KernelHeap> = Box.fromRaw(obj as *mut KObject<T>);\n}\n",
    49 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Intrusive lists (ADR 0030): CosmoOS's struct list_node (kernel/include/kernel/list.h), a circular doubly linked\n// list whose head and nodes are embedded in other structs. Its helpers are list.h's static inline functions, which an\n// extern declaration may call (type-system.md §28.2). A node's struct is recovered with containerOf over offsetOf.\n//\n// A walk that may remove the node it is on reads the next node first, as list_for_each_entry_safe does:\n//\n//     var node = List.first(head);\n//     while (!node.isNull()) {\n//         let after = List.next(head, node);\n//         let entry = containerOf(node, offsetOf<wait_entry>(link)) as *mut wait_entry;\n//         ...                                  // may List.remove(node)\n//         node = after;\n//     }\n\n@header(\"kernel/list.h\")\nextern \"C\" {\n    struct list_node {\n        next: *mut list_node;\n        prev: *mut list_node;\n    }\n    @effects()\n    fn list_init(head: *mut list_node);\n    @effects()\n    fn list_empty(head: *list_node) -> bool;\n    @effects()\n    fn list_push_back(head: *mut list_node, node: *mut list_node);\n    @effects()\n    fn list_push_front(head: *mut list_node, node: *mut list_node);\n    @effects()\n    fn list_remove(node: *mut list_node);\n}\n\n/// The operations on an intrusive list. Every one is unsafe: the nodes are raw C state that other code links and\n/// unlinks, so the caller holds whatever lock protects the list and keeps every node alive while it is linked.\npublic struct List {\n    /// Makes `head` an empty list (it points to itself).\n    /// Safety: `head` is writable and on no list.\n    @effects()\n    public unsafe fn init(head: *mut list_node) => list_init(head);\n\n    /// Safety: `head` is an initialised list.\n    @effects()\n    public unsafe fn isEmpty(head: *list_node) -> bool => list_empty(head);\n\n    /// Safety: `head` is an initialised list and `node` is on none.\n    @effects()\n    public unsafe fn pushBack(head: *mut list_node, node: *mut list_node) => list_push_back(head, node);\n\n    /// Safety: `head` is an initialised list and `node` is on none.\n    @effects()\n    public unsafe fn pushFront(head: *mut list_node, node: *mut list_node) => list_push_front(head, node);\n\n    /// Unlinks `node` from its list (list.h leaves it pointing to itself).\n    /// Safety: `node` is on a list.\n    @effects()\n    public unsafe fn remove(node: *mut list_node) => list_remove(node);\n\n    /// The first node after `head`, or null when the list is empty.\n    /// Safety: `head` is an initialised list.\n    @effects()\n    public unsafe fn first(head: *list_node) -> *mut list_node {\n        let n = Ptr.toBorrow(head).next;\n        return if (n as *list_node == head) 0 as *mut list_node else n;\n    }\n\n    /// The node after `node` on the list `head`, or null when `node` is the last.\n    /// Safety: `head` is an initialised list and `node` is on it.\n    @effects()\n    public unsafe fn next(head: *list_node, node: *mut list_node) -> *mut list_node {\n        let n = Ptr.toBorrow(node as *list_node).next;\n        return if (n as *list_node == head) 0 as *mut list_node else n;\n    }\n}\n\n/// The address of the struct whose field at `offset` (offsetOf<T>(field)) is `node`: C's container_of, cast by the\n/// caller to `*mut T`. Not generic, since `T` is usually C-laid-out (it embeds the node), which no type argument may be\n/// (type-system.md §33.1).\n/// Safety: `node` is that field of a live struct.\n@effects()\npublic unsafe fn containerOf(node: *mut list_node, offset: usize) -> *mut void =>\n    (node as *mut u8).sub(offset) as *mut void;\n",
    50 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// The kernel log from CeeSafe (ADR 0041 §3.3): a line built with lib/core's TextWriter, sent to CosmoOS's klog with one\n// call whose format is the fixed \"%s\", so a port's messages are safe code and no format string comes from it. A\n// formatted panic ends in CosmoOS's panic the same way.\n\n@header(\"kernel/log.h\", \"kernel/panic.h\")\nextern \"C\" {\n    // log.h: \"output never sleeps or allocates\"; panic does not return.\n    @effects()\n    fn klog(level: u32, format: *CChar, ...);\n    @effects()\n    fn panic(format: *CChar, ...);\n}\n\n/// log.h's `enum klog_level`, but KLOG_PANIC, which `KernelLog.panic` is.\npublic enum LogLevel {\n    Debug,\n    Info,\n    Warn,\n    Error,\n}\n\n/// log.h's KLOG_LINE_MAX: klog cuts a longer line, so a buffer of this many bytes holds any line it writes.\npublic const LOG_LINE_MAX: usize = 256;\n\n/// CosmoOS's kernel log (kernel/include/kernel/log.h).\npublic struct KernelLog {\n    /// Sends the writer's text as one line at `level`, as `klog(level, \"%s\", text)`.\n    /// Safety: the format is \"%s\" and the argument the writer's zero-terminated text (TextWriter.cText).\n    public fn send(level: LogLevel, line: borrow TextWriter) {\n        unsafe { klog(levelCode(level), \"%s\\0\".ptr as *CChar, line.cText()); }\n    }\n\n    /// Sends a fixed message as one line at `level`.\n    public fn write(level: LogLevel, message: StringView) {\n        var buffer: [u8; 256] = [0; 256];\n        var line = TextWriter.create(mut buffer[..]);\n        line.text(message);\n        KernelLog.send(level, line);\n    }\n\n    /// Panics with the writer's text, as `panic(\"%s\", text)`: CosmoOS's panic, which prints it and does not return.\n    /// Safety: as send.\n    public fn panic(line: borrow TextWriter) {\n        unsafe { panic(\"%s\\0\".ptr as *CChar, line.cText()); }\n    }\n}\n\n/// log.h's values of `enum klog_level`.\nfn levelCode(level: LogLevel) -> u32 => match (level) {\n    LogLevel.Debug => 0,\n    LogLevel.Info => 1,\n    LogLevel.Warn => 2,\n    LogLevel.Error => 3,\n};\n",
    51 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Quiescence (ADR 0025; from C7d; kernel/include/kernel/quiesce.h).\n// A read side is any preemption-disabled region, so holding a\n// spin guard (sync.cee) is one; a grace period ends when every CPU has passed a quiescent state. Readers that\n// found an object under a read section may use it until they leave the section, so an object unlinked from what\n// readers walk is freed only after a grace period: synchronously (Quiesce.synchronize, which sleeps) or deferred\n// (deferDrop, through call_quiesce and an embedded quiesce_head).\n//\n// Not here: explicit read sections (quiesce_read_lock/unlock) in modules. They are inline and call preempt_enable,\n// which CosmoOS does not export (KQ-2); a spin guard is a read section a module can take.\n\n@header(\"kernel/quiesce.h\")\nextern \"C\" {\n    struct quiesce_head;\n    @effects(sleep)\n    fn synchronize_quiesce();\n    @effects()\n    fn call_quiesce(head: *mut quiesce_head, f: extern \"C\" fn(*mut quiesce_head));\n}\n\npublic struct Quiesce {\n    /// Waits for a grace period over the CPUs online now. Sleeps, so it is not allowed under a spin guard.\n    /// Safety: synchronize_quiesce asks for nothing but a context that may sleep, which its effect enforces.\n    public fn synchronize() {\n        unsafe { synchronize_quiesce(); }\n    }\n}\n\n/// A value that can be freed after a grace period: its quiesce_head first (type-system.md §34.3), then the value.\n/// Made in a KernelHeap box and never moved.\npublic struct Deferred<T> {\n    private head: quiesce_head;\n    private data: T;\n\n    /// The head is zero-filled, as call_quiesce requires of a head that never ran.\n    public fn create(data: T) -> Result<Box<Deferred<T>, KernelHeap>, AllocError> =>\n        Box.createIn(KernelHeap {}, Deferred { data: data });\n\n    public fn get(borrow this) -> borrow T => borrow this.data;\n\n    public fn getMut(borrow mut this) -> borrow mut T => borrow mut this.data;\n}\n\n/// The deferred free of a Deferred<T>: drops the value and frees it, in thread context, after the grace period.\n/// Safety: call_quiesce passes the head that deferDrop gave it, the first field of a Box<Deferred<T>, KernelHeap>\n/// that deferDrop gave up, once.\n@callback\nunsafe fn reclaim<T>(head: *mut quiesce_head) {\n    let value: Box<Deferred<T>, KernelHeap> = Box.fromRaw(head as *mut Deferred<T>);\n}\n\n/// Drops `value` after a grace period that begins now; returns at once, in any context. The box is moved in, so\n/// nothing can use it, or submit it again, while the free is pending.\n/// Safety: no new reader can find the value any more (it was unlinked from everything readers walk), and the code of\n/// reclaim<T> stays loaded until the callback has run: module unload does not wait for pending callbacks\n/// (kernel/module/module.c:627-631; KQ-3).\npublic unsafe fn deferDrop<T>(value: Box<Deferred<T>, KernelHeap>) {\n    call_quiesce(Box.intoRaw(value) as *mut quiesce_head, reclaim<T>);\n}\n",
    52 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Locks, guards and per-CPU data (ADR 0025; the locks from C7c). CosmoOS's spinlocks and mutexes as CeeSafe types that hold the data they protect (docs/cosmoos/c7-report.md;\n// ADR 0009; type-system.md §32-§33). The lock is CosmoOS's own C state, imported from its headers and embedded by\n// value, so the C compiler lays it out and it never moves; the data is reachable only through a guard; holding a\n// spin guard is an atomic context, so CeeSafe code that could sleep there does not compile.\n//\n// CosmoOS's rules these follow (kernel/include/kernel/spinlock.h, mutex.h; audit in c7-report.md):\n// - spinlock_init(lock, name) before first use; `name` is the lockdep class name and is kept, so it is static;\n// - spin_lock disables preemption until spin_unlock; re-acquiring a held lock on the same CPU panics;\n// - spin_lock_irqsave also disables interrupts and returns the state that spin_unlock_irqrestore puts back;\n//   nested irqsave locks are released in the reverse order (guards in locals are dropped in that order);\n// - mutex_lock sleeps (it calls might_sleep), so it is forbidden with a spinlock held or in an interrupt;\n// - an initialised struct mutex points into itself (its wait queue's list heads), so it must never move.\n\n@header(\"kernel/spinlock.h\", \"kernel/mutex.h\", \"kernel/percpu.h\", \"arch/irq.h\", \"arch/cpu.h\")\nextern \"C\" {\n    @ctype(\"spinlock_t\")\n    struct spinlock_t;\n    struct mutex;\n    // Static initialisers (type-system.md §39.4): C macros that expand to a lock as spinlock_init and mutex_init\n    // would leave it. A mutex points into itself (its wait queue's and pi_link's list heads), so MUTEX_INIT_AT takes its\n    // own address, `here` (ADR 0027); CosmoOS's mutex.h defines it.\n    @constant\n    fn SPINLOCK_INIT(name: *CChar) -> spinlock_t;\n    @constant\n    fn MUTEX_INIT_AT(at: *mut mutex, name: *CChar) -> mutex;\n    @effects()\n    fn preempt_disable();\n    @effects()\n    fn preempt_enable();\n    // arch_irq_state_t is `unsigned long`, which is `size_t` on every CosmoOS target.\n    @effects()\n    fn arch_irq_save() -> usize;\n    @effects()\n    fn arch_irq_restore(state: usize);\n    @effects()\n    fn arch_cpu_id() -> u32;\n    @effects()\n    fn spinlock_init(lock: *mut spinlock_t, name: *CChar);\n    @effects()\n    fn spin_lock(lock: *mut spinlock_t);\n    @effects()\n    fn spin_unlock(lock: *mut spinlock_t);\n    // arch_irq_state_t is `unsigned long`, which is `size_t` on every CosmoOS target (and on the hosts).\n    @effects()\n    fn spin_lock_irqsave(lock: *mut spinlock_t) -> usize;\n    @effects()\n    fn spin_unlock_irqrestore(lock: *mut spinlock_t, state: usize);\n    @effects()\n    fn mutex_init(m: *mut mutex, name: *CChar);\n    @effects(sleep)\n    fn mutex_lock(m: *mut mutex);\n    @effects()\n    fn mutex_unlock(m: *mut mutex);\n}\n\n/// A spinlock and the data it protects. Make one with `SpinLock<T>.create(name, data)`: it holds C state, so it lives\n/// in its box and never moves (type-system.md §33). Its fields are private (type-system.md §12), so the data is\n/// reached only through a guard, and a guard exists only while the lock is held.\n@threadSafe\n@noncopy\npublic struct SpinLock<T: Send> {\n    private raw: spinlock_t;\n    /// The lockdep class name: a static string ending in a zero byte (spinlock_init keeps the pointer).\n    private name: *CChar;\n    private data: T;\n\n    /// A lock for a static (type-system.md §39): `static TABLE: SpinLock<Table> = SpinLock.constant(\"table\\0\".ptr as\n    /// *CChar, Table.empty());`. SPINLOCK_INIT leaves it as `init` would.\n    @constant\n    public fn constant(name: *CChar, data: T) -> SpinLock<T> =>\n        SpinLock { raw: SPINLOCK_INIT(name), name: name, data: data };\n\n    /// Makes one in a KernelHeap box, initialised in place before this returns (type-system.md §33.3). `name` is its\n    /// lockdep class name: a static string ending in a zero byte.\n    public fn create(name: *CChar, data: T) -> R",
    53 =>
        "esult<Box<SpinLock<T>, KernelHeap>, AllocError> =>\n        Box.createIn(KernelHeap {}, SpinLock { name: name, data: data });\n\n    /// Safety: runs once, at the lock's final address, before anything else can see it (type-system.md §33.3).\n    @placed\n    fn init(borrow mut this) {\n        unsafe { spinlock_init(borrow mut this.raw as *mut spinlock_t, this.name); }\n    }\n\n    /// Takes the lock, spinning; preemption is off until the guard is dropped.\n    /// Safety: `raw` was initialised by `init`, and spin_lock needs nothing else.\n    public fn lock(borrow this) -> SpinGuard<T> {\n        unsafe { spin_lock(this.cLock()); }\n        return SpinGuard { lock: this };\n    }\n\n    /// The C lock. Locking mutates it through a shared reference: the C code synchronises that itself.\n    fn cLock(borrow this) -> *mut spinlock_t => borrow this.raw as *spinlock_t as *mut spinlock_t;\n}\n\n/// Holding the lock. An atomic context while it is live (type-system.md §32.3); unlocks when dropped.\n@context(atomic)\npublic struct SpinGuard<region r, T: Send> {\n    private lock: borrow(r) SpinLock<T>;\n\n    /// The protected data, for as long as the guard is borrowed.\n    /// Safety: the lock is held, so this guard is the only way to the data until it is dropped: every access goes\n    /// through a guard, and a second guard cannot exist meanwhile (spin_lock does not return, and panics on the\n    /// same CPU).\n    public fn data(borrow mut this) -> borrow mut T =>\n        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };\n\n    /// Safety: the guard holds the lock, which it took in `lock`.\n    drop {\n        unsafe { spin_unlock(this.lock.cLock()); }\n    }\n}\n\n/// A spinlock that also disables interrupts while held, for data an interrupt handler shares.\n@threadSafe\n@noncopy\npublic struct IrqSpinLock<T: Send> {\n    private raw: spinlock_t;\n    private name: *CChar;\n    private data: T;\n\n    /// A lock for a static, as SpinLock.constant.\n    @constant\n    public fn constant(name: *CChar, data: T) -> IrqSpinLock<T> =>\n        IrqSpinLock { raw: SPINLOCK_INIT(name), name: name, data: data };\n\n    /// Makes one in a KernelHeap box, initialised in place before this returns (type-system.md §33.3). `name` is its\n    /// lockdep class name: a static string ending in a zero byte.\n    public fn create(name: *CChar, data: T) -> Result<Box<IrqSpinLock<T>, KernelHeap>, AllocError> =>\n        Box.createIn(KernelHeap {}, IrqSpinLock { name: name, data: data });\n\n    /// Safety: as SpinLock.init.\n    @placed\n    fn init(borrow mut this) {\n        unsafe { spinlock_init(borrow mut this.raw as *mut spinlock_t, this.name); }\n    }\n\n    /// Takes the lock with interrupts disabled; the guard restores them.\n    /// Safety: as SpinLock.lock.\n    public fn lock(borrow this) -> IrqSpinGuard<T> {\n        let state = unsafe { spin_lock_irqsave(this.cLock()) };\n        return IrqSpinGuard { lock: this, state: state };\n    }\n\n    fn cLock(borrow this) -> *mut spinlock_t => borrow this.raw as *spinlock_t as *mut spinlock_t;\n}\n\n@context(atomic)\npublic struct IrqSpinGuard<region r, T: Send> {\n    private lock: borrow(r) IrqSpinLock<T>;\n    private state: usize;\n\n    /// Safety: as SpinGuard.data.\n    public fn data(borrow mut this) -> borrow mut T =>\n        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };\n\n    /// Safety: the guard holds the lock and the interrupt state spin_lock_irqsave returned.\n    drop {\n        unsafe { spin_unlock_irqrestore(this.lock.cLock(), this.state); }\n    }\n}\n\n/// A sleeping lock and the data it protects. Its C state points into itself once initialised, which is why it is\n/// made in place and never moved.\n@threadSafe\n@noncopy\npublic struct Mutex<T: Send> {\n    private raw: mutex;\n    private name: *CChar;\n    private data: T;\n\n    /// A mutex for a static (type-system.md §39): `static TABLE: Mutex<Table> = Mutex.constant(\"table\\0\".ptr as *CChar,\n    /// Table.empty());`. MUTEX_INIT_AT, given the mutex's own address, leave",
    54 =>
        "s it as `init` would (ADR 0027).\n    @constant\n    public fn constant(name: *CChar, data: T) -> Mutex<T> =>\n        Mutex { raw: MUTEX_INIT_AT(here, name), name: name, data: data };\n\n    /// Makes one in a KernelHeap box, initialised in place before this returns (type-system.md §33.3). `name` is its\n    /// lockdep class name: a static string ending in a zero byte.\n    public fn create(name: *CChar, data: T) -> Result<Box<Mutex<T>, KernelHeap>, AllocError> =>\n        Box.createIn(KernelHeap {}, Mutex { name: name, data: data });\n\n    /// Safety: as SpinLock.init.\n    @placed\n    fn init(borrow mut this) {\n        unsafe { mutex_init(borrow mut this.raw as *mut mutex, this.name); }\n    }\n\n    /// Takes the mutex, sleeping until it is free: forbidden in atomic contexts (its effect is `sleep`).\n    /// Safety: `raw` was initialised by `init`.\n    public fn lock(borrow this) -> MutexGuard<T> {\n        unsafe { mutex_lock(this.cLock()); }\n        return MutexGuard { lock: this };\n    }\n\n    fn cLock(borrow this) -> *mut mutex => borrow this.raw as *mutex as *mut mutex;\n}\n\n/// Holding the mutex. Not an atomic context: code under a mutex may sleep.\npublic struct MutexGuard<region r, T: Send> {\n    private lock: borrow(r) Mutex<T>;\n\n    /// Safety: as SpinGuard.data, for the mutex.\n    public fn data(borrow mut this) -> borrow mut T =>\n        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };\n\n    /// Safety: the guard holds the mutex, which it took in `lock`.\n    drop {\n        unsafe { mutex_unlock(this.lock.cLock()); }\n    }\n}\n\n/// Preemption off on this CPU until dropped (CosmoOS's preempt_disable, nestable): an atomic context, so nothing\n/// under it may sleep. The thread stays on this CPU, but its interrupt handlers still run.\n@context(atomic)\n@noncopy\npublic struct PreemptGuard {\n    private unused: u8;\n\n    /// Safety: preempt_disable needs nothing; the guard's drop is its matching preempt_enable.\n    public fn enter() -> PreemptGuard {\n        unsafe { preempt_disable(); }\n        return PreemptGuard { unused: 0 };\n    }\n\n    /// Safety: the guard disabled preemption in `enter`, once.\n    drop {\n        unsafe { preempt_enable(); }\n    }\n}\n\n/// Interrupts off on this CPU until dropped (arch_irq_save, nestable): an atomic context, in which this CPU's thread\n/// cannot be preempted and its interrupt handlers cannot run.\n@context(atomic)\n@noncopy\npublic struct IrqGuard {\n    private state: usize;\n\n    /// Safety: arch_irq_save needs nothing and nests; the guard's drop restores the state it returned.\n    public fn enter() -> IrqGuard => IrqGuard { state: unsafe { arch_irq_save() } };\n\n    /// Safety: the state is the one arch_irq_save returned in `enter`, restored once.\n    drop {\n        unsafe { arch_irq_restore(this.state); }\n    }\n}\n\n/// The number of CPUs a PerCpu<T> holds a value for: CosmoOS's CONFIG_MAX_CPUS (kernel/include/kernel/percpu.h).\npublic const MAX_CPUS: usize = 64;\n\n/// One value of `T` per CPU (ADR 0024 §3.3, ADR 0025 §3.3). `p.local(borrow guard)` lends the calling CPU's value\n/// while interrupts are off, so neither another thread nor an interrupt handler on this CPU can reach it meanwhile, and\n/// no other CPU ever does. A second `local` of the same value on the same CPU, while the first is lent, panics.\n@threadSafe\n@noncopy\npublic struct PerCpu<T: Copy + Send> {\n    private values: [T; 64];\n    private lent: [bool; 64];\n\n    /// A per-CPU value for a static: `v` on every CPU.\n    @constant\n    public fn constant(v: T) -> PerCpu<T> => PerCpu { values: [v; 64], lent: [false; 64] };\n\n    /// This CPU's value, lent until the PerCpuRef drops, which also drops `guard` and so turns interrupts back on:\n    /// `TICKS.local(IrqGuard.enter())`.\n    /// Safety: with interrupts off on this CPU, the code that runs here until the guard drops is this thread's; the\n    /// value is this CPU's, which no other CPU's code reaches; `lent` makes a second loan on this CPU panic. So the\n    /// PerCpuRef this",
    _ =>
        " returns is the only way to the value while it lives.\n    public fn local(borrow this, guard: IrqGuard) -> PerCpuRef<T> {\n        let cpu = unsafe { arch_cpu_id() } as usize;\n        let lent = unsafe { Ptr.toBorrowMut(borrow this.lent[cpu] as *bool as *mut bool) };\n        if (lent) {\n            alreadyLent();\n        }\n        lent = true;\n        return PerCpuRef { owner: this, guard: guard, cpu: cpu };\n    }\n}\n\n/// A loan of one CPU's value of a PerCpu<T>, made by PerCpu.local; dropping it ends the loan.\n@noncopy\npublic struct PerCpuRef<region r, T: Copy + Send> {\n    private owner: borrow(r) PerCpu<T>;\n    private guard: IrqGuard;\n    private cpu: usize;\n\n    /// The value, for as long as this is borrowed.\n    /// Safety: as PerCpu.local: this loan is the only way to the value while it lives.\n    public fn get(borrow mut this) -> borrow mut T =>\n        unsafe { Ptr.toBorrowMut(borrow this.owner.values[this.cpu] as *T as *mut T) };\n\n    /// Safety: this loan set `lent` in PerCpu.local and is its only holder.\n    drop {\n        let lent = unsafe { Ptr.toBorrowMut(borrow this.owner.lent[this.cpu] as *bool as *mut bool) };\n        lent = false;\n    }\n}\n\n/// A second loan of one CPU's value of a PerCpu: a panic, through the runtime's ceesafe_panic (the kernel's), as an\n/// empty optional's unwrap is (type-system.md §22).\nfn alreadyLent() {\n    let none: u8? = null;\n    let unreachable = none!;\n}\n",
};

/// The whole text of file `k`.
fn libraryText(k: usize) -> Result<Vector<u8>, AllocError> {
    var text = Vector<u8>.create();
    for (j in 0..libraryChunkCount(k)) {
        appendText(mut text, libraryChunk(libraryFirstChunk(k) + j))?;
    }
    return Ok(text);
}
