        " { ceesafe_chan_unpark(this.raw, borrow mut node as *mut ChannelWait as *mut void); }\n            }\n        }\n    }\n\n    /// The next value for a task, parking it while the channel is empty; `null` once it is closed and empty;\n    /// `Err(AsyncError.Cancelled)` only while it has taken nothing, so no value is lost.\n    /// Safety: as `recv`; the wait node is in this task's frame and leaves the queue before the task returns.\n    public async fn recvAsync(borrow this) -> Result<T?, AsyncError> {\n        var node = ChannelWait { words: [0u64; 6] };\n        loop {\n            if (AsyncControl<u8>.isCancelled()) {\n                return Err(AsyncError.Cancelled);\n            }\n            var status: u32 = 0;\n            var epoch: u64 = 0;\n            let slot = unsafe { ceesafe_chan_begin_recv(this.raw, borrow mut status as *mut u32, borrow mut epoch as *mut u64) };\n            if (status == 0) {\n                let value = unsafe { (slot as *mut T).read() };\n                unsafe { ceesafe_chan_end_recv(this.raw); }\n                return Ok(Some(value));\n            }\n            if (status == 2) {\n                return Ok(null);\n            }\n            if (unsafe { ceesafe_chan_park(this.raw, borrow mut node as *mut ChannelWait as *mut void, epoch) }) {\n                await Async.park();\n                unsafe { ceesafe_chan_unpark(this.raw, borrow mut node as *mut ChannelWait as *mut void); }\n            }\n        }\n    }\n\n    /// The last handle drops the values still buffered, in order, then frees the channel.\n    /// Safety: after the last release no other handle exists, so the buffer is this drop's alone.\n    drop {\n        if (unsafe { ceesafe_chan_release(this.raw) }) {\n            loop {\n                var status: u32 = 0;\n                var epoch: u64 = 0;\n                let slot = unsafe { ceesafe_chan_begin_recv(this.raw, borrow mut status as *mut u32, borrow mut epoch as *mut u64) };\n              