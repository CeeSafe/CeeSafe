ength: usize = 1; // a run must be at least two groups\n        var k: usize = 0;\n        while (k < 8) {\n            if (grou",
    184 =>
        "ps[k] != 0) {\n                k += 1;\n                continue;\n            }\n            let start = k;\n            while (k < 8 && groups[k] == 0) {\n                k += 1;\n            }\n            if (k - start > bestLength) {\n                bestStart = start;\n                bestLength = k - start;\n            }\n        }\n        var g: usize = 0;\n        while (g < 8) {\n            if (g == bestStart) {\n                w.text(\"::\");\n                g += bestLength;\n                continue;\n            }\n            if (g > 0 && g != bestStart + bestLength) {\n                w.byte(58);\n            }\n            w.hex(groups[g] as u64, 0);\n            g += 1;\n        }\n    }\n}\n\n/// How a listener is made (ADR 0044 §3.2). `defaults()`: the platform's largest backlog, the address reusable (as\n/// the runtime always did), no port sharing, and dual stack for an IPv6 address.\npublic struct ListenOptions {\n    /// The queue of connections not yet accepted; 0: the platform's largest (SOMAXCONN).\n    public backlog: u32;\n    /// SO_REUSEADDR: listen again at once on a port whose connections are still closing (POSIX; Windows: ignored).\n    public reuseAddress: bool;\n    /// SO_REUSEPORT: several listeners on one port, the kernel spreading the connections; refused where the platform\n    /// has no such option (Windows: IoError.Unsupported).\n    public reusePort: bool;\n    /// IPV6_V6ONLY for an IPv6 address: false (dual stack) also accepts IPv4 peers, reported as V4.\n    public v6Only: bool;\n\n    public fn defaults() -> ListenOptions =>\n        ListenOptions { backlog: 0, reuseAddress: true, reusePort: false, v6Only: false };\n\n    /// The runtime's flags (rt.h's CEE_LISTEN_*).\n    fn flags(borrow this) -> u32 =>\n        (if (this.reuseAddress) 1u32 else 0) | (if (this.reusePort) 2u32 else 0) | (if (this.v6Only) 4u32 else 0);\n}\n\n/// A list of up to eight byte parts sent as one (ADR 0045 §3.1): an HTTP response