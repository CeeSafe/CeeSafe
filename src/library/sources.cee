        "state[0];\n        var b = state[1];\n        var c = state[2];\n        var d = state[3];\n        var e = state[4];\n        for (t in 0..20usize) {\n            let f = (b & c) | ((b ^ 0xFFFFFFFF) & d); // Ch\n            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0x5A827999).wrappingAdd(w[t]);\n            e = d;\n            d = c;\n            c = b.rotateLeft(30);\n            b = a;\n            a = x;\n        }\n        for (t in 20..40usize) {\n            let f = b ^ c ^ d; // Parity\n            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0x6ED9EBA1).wrappingAdd(w[t]);\n            e = d;\n            d = c;\n            c = b.rotateLeft(30);\n            b = a;\n            a = x;\n        }\n        for (t in 40..60usize) {\n            let f = (b & c) | (b & d) | (c & d); // Maj\n            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0x8F1BBCDC).wrappingAdd(w[t]);\n            e = d;\n            d = c;\n            c = b.rotateLeft(30);\n            b = a;\n            a = x;\n        }\n        for (t in 60..80usize) {\n            let f = b ^ c ^ d; // Parity\n            let x = a.rotateLeft(5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(0xCA62C1D6).wrappingAdd(w[t]);\n            e = d;\n            d = c;\n            c = b.rotateLeft(30);\n            b = a;\n            a = x;\n        }\n        state[0] = state[0].wrappingAdd(a);\n        state[1] = state[1].wrappingAdd(b);\n        state[2] = state[2].wrappingAdd(c);\n        state[3] = state[3].wrappingAdd(d);\n        state[4] = state[4].wrappingAdd(e);\n    }\n\n    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        let n = bytes.length;\n        var k: usize = 0;\n        this.length = this.length.wrappingAdd(n as u64);\n        if (this.used > 0) {\n            while (this.used < 64 && k < n) {\n                this.block[this.used] = bytes[k];\n                this.used += 1;\n                k += 1;\n            }\n            if (this.used < 64) {\n                return;\n            }\n            Sha1.compress(mut this.state, this.block[..], 0);\n            this.used = 0;\n        }\n        while (n - k >= 64) {\n            Sha1.compress(mut this.state, bytes, k);\n            k += 64;\n        }\n        while (k < n) {\n            this.block[this.used] = bytes[k];\n            this.used += 1;\n            k += 1;\n        }\n    }\n\n    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> [u8; 20] {\n        var h = Sha1 { state: this.state, block: this.block, used: this.used, length: this.length };\n        let bits = this.length.wrappingMul(8);\n        var pad = [0u8; 72];\n        pad[0] = 0x80;\n        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;\n        for (k in 0..8usize) {\n            pad[zeros + k] = truncate<u8>(bits >> (8 * (7 - k) as u64));\n        }\n        h.update(pad[..zeros + 8]);\n        var digest = [0u8; 20];\n        for (k in 0..5usize) {\n            digest[..].writeBE(4 * k, h.state[k]);\n        }\n        return digest;\n    }\n\n    /// The digest of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> [u8; 20] {\n        var h = Sha1.create();\n        h.update(bytes);\n        return h.finish();\n    }\n}\n\n/// SHA-256 (FIPS 180-4): a 32-byte digest.\npublic struct Sha256 {\n    state: [u32; 8];\n    block: [u8; 64]; // a partial block of `used` bytes\n    used: usize;\n    length: u64; // bytes fed, modulo 2^64\n\n    /// Its state and partial block set to zero, in a way the C compiler keeps (ADR 0194 §2.1, ADR 0197 §2.2): for a\n    /// digest that absorbed a key.\n    fn wipe(borrow mut this) {\n        Secret.wipe(mut this);\n    }\n\n    /// A digest of no bytes yet.\n    public fn create() -> Sha256 => Sha256 {\n        state: [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C,",
    110 =>
        " 0x1F83D9AB, 0x5BE0CD19],\n        block: [0u8; 64],\n        used: 0,\n        length: 0,\n    };\n\n    /// Compresses the 64 bytes at `at` of `data` into `state` (FIPS 180-4 §6.2.2).\n    fn compress(state: borrow mut [u32; 8], data: Slice<u8>, at: usize) {\n        let block = data[at..at + 64];\n        var w = [0u32; 64];\n        for (t in 0..16usize) {\n            w[t] = block.readBE<u32>(4 * t);\n        }\n        for (t in 16..64usize) {\n            let x = w[t - 15];\n            let y = w[t - 2];\n            let s0 = x.rotateRight(7) ^ x.rotateRight(18) ^ (x >> 3);\n            let s1 = y.rotateRight(17) ^ y.rotateRight(19) ^ (y >> 10);\n            w[t] = w[t - 16].wrappingAdd(s0).wrappingAdd(w[t - 7]).wrappingAdd(s1);\n        }\n        var a = state[0];\n        var b = state[1];\n        var c = state[2];\n        var d = state[3];\n        var e = state[4];\n        var f = state[5];\n        var g = state[6];\n        var h = state[7];\n        for (t in 0..64usize) {\n            let s1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25);\n            let choice = (e & f) ^ ((e ^ 0xFFFFFFFF) & g);\n            let t1 = h.wrappingAdd(s1).wrappingAdd(choice).wrappingAdd(SHA256_ROUNDS[t]).wrappingAdd(w[t]);\n            let s0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22);\n            let majority = (a & b) ^ (a & c) ^ (b & c);\n            h = g;\n            g = f;\n            f = e;\n            e = d.wrappingAdd(t1);\n            d = c;\n            c = b;\n            b = a;\n            a = t1.wrappingAdd(s0.wrappingAdd(majority));\n        }\n        state[0] = state[0].wrappingAdd(a);\n        state[1] = state[1].wrappingAdd(b);\n        state[2] = state[2].wrappingAdd(c);\n        state[3] = state[3].wrappingAdd(d);\n        state[4] = state[4].wrappingAdd(e);\n        state[5] = state[5].wrappingAdd(f);\n        state[6] = state[6].wrappingAdd(g);\n        state[7] = state[7].wrappingAdd(h);\n    }\n\n    /// Feeds `bytes`. Whole blocks are compressed straight from `bytes`; only a partial block is copied.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        let n = bytes.length;\n        var k: usize = 0;\n        this.length = this.length.wrappingAdd(n as u64);\n        if (this.used > 0) {\n            while (this.used < 64 && k < n) {\n                this.block[this.used] = bytes[k];\n                this.used += 1;\n                k += 1;\n            }\n            if (this.used < 64) {\n                return;\n            }\n            Sha256.compress(mut this.state, this.block[..], 0);\n            this.used = 0;\n        }\n        while (n - k >= 64) {\n            Sha256.compress(mut this.state, bytes, k);\n            k += 64;\n        }\n        while (k < n) {\n            this.block[this.used] = bytes[k];\n            this.used += 1;\n            k += 1;\n        }\n    }\n\n    /// The digest of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> [u8; 32] {\n        var h = Sha256 { state: this.state, block: this.block, used: this.used, length: this.length };\n        let bits = this.length.wrappingMul(8);\n        var pad = [0u8; 72];\n        pad[0] = 0x80;\n        let zeros: usize = if (this.used < 56) 56 - this.used else 120 - this.used;\n        for (k in 0..8usize) {\n            pad[zeros + k] = truncate<u8>(bits >> (8 * (7 - k) as u64));\n        }\n        h.update(pad[..zeros + 8]);\n        var digest = [0u8; 32];\n        for (k in 0..8usize) {\n            digest[..].writeBE(4 * k, h.state[k]);\n        }\n        return digest;\n    }\n\n    /// The digest of `bytes`, in one call.\n    public fn of(bytes: Slice<u8>) -> [u8; 32] {\n        var h = Sha256.create();\n        h.update(bytes);\n        return h.finish();\n    }\n}\n\n/// HMAC-SHA-256 (RFC 2104, FIPS 198-1): a 32-byte message authentication code under a key of any length. A key longer\n/// than SHA-256's 64-byte block is first replaced by its SHA-256. Compare two codes in constant time, not with an\n///",
    111 =>
        " early exit, where an attacker can time the comparison.\npublic struct HmacSha256 {\n    inner: Sha256;      // fed the inner padded key, then the message\n    outerKey: [u8; 64]; // the key, padded to a block, XOR 0x5C\n\n    /// A code under `key` of no bytes yet.\n    public fn create(key: Slice<u8>) -> HmacSha256 {\n        var padded = [0u8; 64];\n        if (key.length > 64) {\n            let digest = Sha256.of(key);\n            for (k in 0..32usize) {\n                padded[k] = digest[k];\n            }\n        } else {\n            for (k in 0..key.length) {\n                padded[k] = key[k];\n            }\n        }\n        var innerKey = [0u8; 64];\n        var outerKey = [0u8; 64];\n        for (k in 0..64usize) {\n            innerKey[k] = padded[k] ^ 0x36;\n            outerKey[k] = padded[k] ^ 0x5C;\n        }\n        var inner = Sha256.create();\n        inner.update(innerKey[..]);\n        let mac = HmacSha256 { inner: inner, outerKey: outerKey };\n        // The key's copies here, wiped (ADR 0194 §2.1, G34): the code keeps only its own.\n        Secret.wipe(mut padded);\n        Secret.wipe(mut innerKey);\n        Secret.wipe(mut outerKey);\n        inner.wipe();\n        return mac;\n    }\n\n    /// A second code with the same key and the bytes fed so far, to feed apart. A code is not copied by `=`, since\n    /// its drop wipes its key (ADR 0194 §2.1).\n    public fn clone(borrow this) -> HmacSha256 => HmacSha256 { inner: this.inner, outerKey: this.outerKey };\n\n    /// Feeds `bytes` of the message.\n    public fn update(borrow mut this, bytes: Slice<u8>) {\n        this.inner.update(bytes);\n    }\n\n    /// The code of the bytes fed so far. It does not change the state: more bytes may be fed after it.\n    public fn finish(borrow this) -> [u8; 32] {\n        var inner = this.inner.finish();\n        var outer = Sha256.create();\n        outer.update(this.outerKey[..]);\n        outer.update(inner[..]);\n        let code = outer.finish();\n        Secret.wipe(mut inner);\n        outer.wipe(); // it absorbed the padded key\n        return code;\n    }\n\n    /// The code of `bytes` under `key`, in one call.\n    public fn of(key: Slice<u8>, bytes: Slice<u8>) -> [u8; 32] {\n        var h = HmacSha256.create(key);\n        h.update(bytes);\n        return h.finish();\n    }\n\n    /// The key's state wiped when the code is dropped (ADR 0194 §2.1, G34): the padded key XOR 0x5C, and the inner\n    /// digest that absorbed it XOR 0x36.\n    drop {\n        this.inner.wipe();\n        Secret.wipe(mut this.outerKey);\n    }\n}\n",
    112 =>
        "// Ciphers (ADR 0135): AES-256-GCM, authenticated encryption in place. Where the CPU has AES and carry-less multiply\n// instructions (AES-NI and PCLMULQDQ on x86-64, the AES extension on AArch64) the runtime runs them; elsewhere, and in\n// the interpreter, the code below runs: the same cipher with no table indexed by a secret, the S-box as a circuit over\n// the bits of 64 bytes at once and GHASH as a shift-and-add multiply with masks in place of branches. Both give the\n// same bytes. And ConstantTime.equal, a comparison whose time does not depend on where two slices differ.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_aes256gcm_available() -> u32;\n    @effects()\n    fn ceesafe_aes256gcm_expand(key: *u8, schedule: *mut u8);\n    @effects()\n    fn ceesafe_aes256gcm_seal(\n        schedule: *u8,\n        nonce: *u8,\n        aad: *u8,\n        aadLength: u64,\n        data: *mut u8,\n        length: u64,\n        tag: *mut u8,\n    );\n    @effects()\n    fn ceesafe_aes256gcm_open(\n        schedule: *u8,\n        nonce: *u8,\n        aad: *u8,\n        aadLength: u64,\n        data: *mut u8,\n        length: u64,\n        tag: *u8,\n    ) -> u32;\n}\n\n/// The most bytes one call seals or opens: GCM's limit for one nonce, 2^36 - 32. (A function: a library's constant\n/// would be listed in every program's HIR.)\nfn aesGcmMostBytes() -> u64 => 68719476704;\n\n/// AES-256 in Galois/Counter Mode: `seal` encrypts a buffer in place and returns a 16-byte tag over it and over\n/// associated data that is authenticated and not encrypted; `open` checks the tag and decrypts, or refuses.\n///\n/// **A nonce must never be used twice with one key.** Two messages sealed under the same key and nonce give away the\n/// XOR of their texts and let tags be forged. Use a counter that never repeats under the key, or a key made for one\n/// message; `Random.fill` gives keys. The value holds the expanded key, and wipes it when it is dropped.\npublic struct Aes256Gcm {\n    // With the CPU's instructions: the 15 round keys and four powers of the GHASH key, as the runtime wrote them.\n    // Without: the round keys, and the GHASH key in `h0` and `h1`.\n    schedule: [u8; 304];\n    h0: u64;\n    h1: u64;\n    hardware: bool;\n\n    /// A cipher for `key`; null unless the key is 32 bytes.\n    /// Safety: the runtime reads 32 bytes of the key and writes the 304 of the schedule, during the call only.\n    public fn create(key: Slice<u8>) -> Aes256Gcm? {\n        if (key.length != 32) { return null; }\n        var c = Aes256Gcm { schedule: [0u8; 304], h0: 0, h1: 0, hardware: false };\n        if (unsafe { ceesafe_aes256gcm_available() } != 0) {\n            c.hardware = true;\n            hardExpand(key, mut c.schedule[..]);\n            return c;\n        }\n        softExpand(mut c, key);\n        return c;\n    }\n\n    /// Encrypts `data` in place under `nonce` and returns the tag of `associated` and the ciphertext. Panics if\n    /// `data` is longer than 2^36 - 32 bytes, GCM's limit for one nonce.\n    /// Safety: the runtime reads the schedule, the nonce's 12 bytes and the associated data, reads and writes\n    /// `data`'s length, and writes the tag's 16 bytes, during the call only.\n    public fn seal(borrow this, nonce: [u8; 12], associated: Slice<u8>, data: SliceMut<u8>) -> [u8; 16] {\n        if (data.length as u64 > aesGcmMostBytes()) {\n            panic(\"Aes256Gcm seals at most 2^36 - 32 bytes under one nonce\");\n        }\n        if (!this.hardware) {\n            softCtr(this, borrow nonce, data);\n            return softTag(this, borrow nonce, associated, data);\n        }\n        var tag = [0u8; 16];\n        hardSeal(this.schedule[..], nonce[..], associated, data, mut tag[..]);\n        return tag;\n    }\n\n    /// Checks `tag` against `associated` and the ciphertext `data`, in time that does not depend on where they\n    /// differ. True, and `data` decrypted in place, when the tag is theirs; false, and `data` zeroed, when it is not:\n    /// nothing of a text that was changed is given back. Panics as `se",
    113 =>
        "al` does for a longer `data`.\n    /// Safety: as `seal`; the tag's 16 bytes are read.\n    public fn open(\n        borrow this,\n        nonce: [u8; 12],\n        associated: Slice<u8>,\n        data: SliceMut<u8>,\n        tag: [u8; 16],\n    ) -> bool {\n        if (data.length as u64 > aesGcmMostBytes()) {\n            panic(\"Aes256Gcm opens at most 2^36 - 32 bytes under one nonce\");\n        }\n        if (this.hardware) {\n            return unsafe { ceesafe_aes256gcm_open(\n                this.schedule[..].ptr,\n                nonce[..].ptr,\n                associated.ptr,\n                associated.length as u64,\n                data.ptr,\n                data.length as u64,\n                tag[..].ptr,\n            ) } != 0;\n        }\n        let expected = softTag(this, borrow nonce, associated, data);\n        if (!ConstantTime.equal(expected[..], tag[..])) {\n            for (i in 0..data.length) { data[i] = 0; }\n            return false;\n        }\n        softCtr(this, borrow nonce, data);\n        return true;\n    }\n\n    /// The schedule and the GHASH key wiped, in a way the C compiler keeps (ADR 0197 §2.1, §2.5): plain stores to a\n    /// value about to die are dead to the optimiser, and a local cipher kept its schedule (CosmoStore's G43).\n    drop {\n        Secret.wipe(mut this.schedule);\n        Secret.wipe(mut this.h0);\n        Secret.wipe(mut this.h1);\n    }\n}\n\n/// Comparisons for secrets.\npublic struct ConstantTime {\n    /// Whether two slices hold the same bytes, in time that depends on their lengths only: every byte is compared,\n    /// wherever the first difference is. For tags, digests and tokens, where `==` would tell an attacker how much of a\n    /// guess was right. Slices of different lengths are different.\n    public fn equal(a: Slice<u8>, b: Slice<u8>) -> bool {\n        if (a.length != b.length) { return false; }\n        var diff: u8 = 0;\n        for (i in 0..a.length) { diff = diff | (a[i] ^ b[i]); }\n        return diff == 0;\n    }\n}\n\n// ---- With the CPU's instructions ----\n\n/// Safety: the runtime reads 32 bytes of the key and writes the 304 of the schedule, during the call only.\nfn hardExpand(key: Slice<u8>, schedule: SliceMut<u8>) {\n    unsafe { ceesafe_aes256gcm_expand(key.ptr, schedule.ptr); }\n}\n\n/// Safety: the runtime reads the schedule's 304 bytes, the nonce's 12 and the associated data, reads and writes\n/// `data`'s length, and writes the tag's 16 bytes, during the call only.\nfn hardSeal(schedule: Slice<u8>, nonce: Slice<u8>, associated: Slice<u8>, data: SliceMut<u8>, tag: SliceMut<u8>) {\n    unsafe {\n        ceesafe_aes256gcm_seal(\n            schedule.ptr,\n            nonce.ptr,\n            associated.ptr,\n            associated.length as u64,\n            data.ptr,\n            data.length as u64,\n            tag.ptr,\n        );\n    }\n}\n\n// ---- Without the CPU's instructions ----\n\n/// The key schedule of AES-256 into `k`, and the GHASH key, the zero block encrypted.\nfn softExpand(k: borrow mut Aes256Gcm, key: Slice<u8>) {\n    for (i in 0..32) { k.schedule[i] = key[i]; }\n    let rcon = [0x01u8, 0x02u8, 0x04u8, 0x08u8, 0x10u8, 0x20u8, 0x40u8];\n    var box = [0u8; 64];\n    for (i in 8..60) {\n        var t = [k.schedule[i * 4 - 4], k.schedule[i * 4 - 3], k.schedule[i * 4 - 2], k.schedule[i * 4 - 1]];\n        if (i % 4 == 0) {\n            // SubWord by the circuit, after RotWord for the first word of each key.\n            if (i % 8 == 0) { t = [t[1], t[2], t[3], t[0]]; }\n            for (j in 0..4) { box[j] = t[j]; }\n            softSubBytes(mut box);\n            for (j in 0..4) { t[j] = box[j]; }\n            if (i % 8 == 0) { t[0] = t[0] ^ rcon[i / 8 - 1]; }\n        }\n        for (j in 0..4) { k.schedule[i * 4 + j] = k.schedule[i * 4 - 32 + j] ^ t[j]; }\n    }\n    var zero = [0u8; 64];\n    softEncrypt4(k, mut zero);\n    for (i in 0..8) {\n        k.h0 = (k.h0 << 8) | (zero[i] as u64);\n        k.h1 = (k.h1 << 8) | (zero[8 + i] as u64);\n    }\n    for (i in 0..64) { box[i] = 0; }\n}\n\n/// SubBytes of 64 bytes ",
