fn libraryChunk(j: usize) -> StringView => match (j) {
    0 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: address types (type-system.md §29.2, cosmoos/kernel-memory-and-lifetimes.md). Distinct types with\n// no implicit conversions, so a physical address cannot be used where a virtual one is meant.\n\n/// A physical address.\npublic struct PhysAddr {\n    raw: u64;\n\n    /// The address whose value is `bits`.\n    public fn of(bits: u64) -> PhysAddr => PhysAddr { raw: bits };\n\n    /// The address's value.\n    public fn bits(this) -> u64 => this.raw;\n\n    /// The address `n` bytes further on; panics if that overflows a `u64`.\n    public fn offset(this, n: u64) -> PhysAddr => PhysAddr { raw: this.raw + n };\n}\n\n/// A virtual address.\npublic struct VirtAddr {\n    raw: u64;\n\n    /// The address whose value is `bits`.\n    public fn of(bits: u64) -> VirtAddr => VirtAddr { raw: bits };\n\n    /// The address's value.\n    public fn bits(this) -> u64 => this.raw;\n\n    /// The address `n` bytes further on; panics if that overflows a `u64`.\n    public fn offset(this, n: u64) -> VirtAddr => VirtAddr { raw: this.raw + n };\n}\n",
    1 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// lib/core: user-defined allocators (type-system.md §30, memory-model.md §3.2). Bundled with ceesafec.\n\n/// The size in bytes and the alignment (a power of two) of a block of memory.\npublic struct Layout {\n    size: usize;\n    align: usize;\n}\n\n/// An allocator a `Box<T, A>` can use: a struct without fields that implements this (type-system.md §30.2).\npublic interface Allocator {\n    /// A block of at least `layout.size` bytes aligned to `layout.align`, or Err; never a null Ok.\n    fn allocate(borrow this, layout: Layout) -> Result<*mut u8, AllocError>;\n\n    /// Returns a block. Safety: `p` came from `allocate` of this allocator type with the same layout,\n    /// and is returned once.\n    unsafe fn deallocate(borrow this, p: *mut u8, layout: Layout);\n}\n",
    2 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Async tasks in every profile (type-system.md §40.4, ADR 0031, ADR 0039): errors, timers, cancellation, the joins of\n// Async.race and Async.all, and AsyncSignal, over the executor's ceesafe_async_* (runtime/hosted/ceesafe_rt_async.c).\n// In the freestanding profile the executor runs over its environment's hooks (ceesafe_env_*, profiles.md §4.2), so\n// what waits here waits there too. I/O for tasks is lib/std's (hosted only).\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_async_now() -> u64;\n    @effects()\n    fn ceesafe_async_wait_until(deadline: u64);\n    @effects()\n    fn ceesafe_async_status() -> u32;\n    @effects()\n    fn ceesafe_async_shield_enter(ms: u64);\n    @effects()\n    fn ceesafe_async_shield_leave();\n    @effects()\n    fn ceesafe_async_signal_take(signal: *mut void) -> bool;\n    @effects()\n    fn ceesafe_async_signal_forget(signal: *mut void);\n    @effects()\n    fn ceesafe_async_signal_raise(signal: *mut void);\n    @effects()\n    fn ceesafe_async_set_init(set: *mut void, limit: u32, error: *mut void);\n    @effects()\n    fn ceesafe_async_set_admit(set: *mut void, wait: bool) -> u32;\n    @effects()\n    fn ceesafe_async_set_done(set: *mut void) -> bool;\n    @effects()\n    fn ceesafe_async_set_cancel(set: *mut void);\n    @effects()\n    fn ceesafe_async_set_oom(set: *mut void) -> bool;\n}\n\n/// Why an async operation failed (type-system.md §40.4, §40.7).\npublic enum AsyncError {\n    Cancelled,\n    TimedOut,\n    Io(IoError),\n}\n\n/// Time for tasks: the monotonic clock in milliseconds.\npublic struct Timer {\n    /// Milliseconds on the monotonic clock, from an arbitrary start.\n    /// Safety: ceesafe_async_now only reads the clock.\n    public fn now() -> u64 => unsafe { ceesafe_async_now() };\n\n    /// Waits at least `ms` milliseconds without blocking the thread: other tasks run meanwhile.\n    /// Safety: ceesafe_async_wait_until only records the deadline for the executor.\n    /// A cancelled task's sleep returns `Err(AsyncError.Cancelled)` at once (type-system.md §40.7).\n    public async fn sleep(ms: u64) -> Result<void, AsyncError> {\n        let start = Timer.now();\n        let deadline = if (ms > 0xFFFFFFFFFFFFFFFF - start) 0xFFFFFFFFFFFFFFFF else start + ms;\n        loop {\n            AsyncLeaf.status()?;\n            if (Timer.now() >= deadline) {\n                return Ok();\n            }\n            unsafe { ceesafe_async_wait_until(deadline); }\n            await Async.park();\n        }\n    }\n}\n\n/// What `Async.isCancelled()` and `Async.checkpoint(cancelled)` call (type-system.md §40.4).\npublic struct AsyncControl<E> {\n    /// Whether the current task is cancelled and not shielded.\n    /// Safety: ceesafe_async_status only reads the executor's state.\n    public fn isCancelled() -> bool => unsafe { ceesafe_async_status() } == 1;\n\n    /// `Async.shield`'s start (type-system.md §40.7).\n    /// Safety: it only counts the current task's shields.\n    public fn enterShield(ms: u64) {\n        unsafe { ceesafe_async_shield_enter(ms); }\n    }\n\n    /// `Async.shield`'s end.\n    /// Safety: it only counts the current task's shields, after enterShield.\n    public fn leaveShield() {\n        unsafe { ceesafe_async_shield_leave(); }\n    }\n\n    /// `Err(cancelled)` if the current task is cancelled and not shielded, else `Ok`.\n    public fn checkpoint(cancelled: E) -> Result<void, E> {\n        if (AsyncControl<E>.isCancelled()) {\n            return Err(cancelled);\n        }\n        return Ok();\n    }\n}\n\n/// The library's own steps for its waiting operations: not for programs (type-system.md §40.4).\npublic struct AsyncLeaf {\n    /// Err(Cancelled) if the current task is cancelled, Err(TimedOut) if its shield's time is up (type-system.md §40.7).\n    /// Safety: ceesafe_async_status only reads the executor's state.\n    public fn status() -> Result<void, AsyncError> {\n        let status = unsafe { ceesafe_async_status() };\n        if (status == 1) {\n            re",
    3 =>
        "turn Err(AsyncError.Cancelled);\n        }\n        if (status == 2) {\n            return Err(AsyncError.TimedOut);\n        }\n        return Ok();\n    }\n}\n\n/// `Async.race`'s result (type-system.md §40.4): the child that returned `Ok` first (0 or 1), its value, and the\n/// other's value if it also returned `Ok` before it saw its cancellation.\npublic struct Raced<T> {\n    public winner: u32;\n    public value: T;\n    public other: T?;\n}\n\n/// What `Async.race` returns once both children have: `first` is the one that returned first, which decides.\nstruct AsyncRaceJoin<T, E> {\n    fn settle(first: u32, a: Result<T, E>, b: Result<T, E>) -> Result<Raced<T>, E> {\n        if (first == 0) {\n            return AsyncRaceJoin<T, E>.decide(0, a, b);\n        }\n        return AsyncRaceJoin<T, E>.decide(1, b, a);\n    }\n\n    fn decide(index: u32, early: Result<T, E>, late: Result<T, E>) -> Result<Raced<T>, E> {\n        match (early) {\n            Ok(value) => {\n                let other: T? = match (late) {\n                    Ok(w) => Some(w),\n                    Err(_) => null,\n                };\n                return Ok(Raced { winner: index, value: value, other: other });\n            }\n            Err(e) => { return Err(e); }\n        }\n    }\n}\n\n/// `Async.timeout` and `Async.deadline` (type-system.md §40.4, ADR 0046): the deadline, the deadline child (the join's\n/// second, beside the body), and the result once both have returned.\nstruct AsyncTimeoutJoin<T, E> {\n    /// The deadline `ms` milliseconds from now, saturated.\n    fn after(ms: u64) -> u64 {\n        let start = Timer.now();\n        return if (ms > 0xFFFFFFFFFFFFFFFF - start) 0xFFFFFFFFFFFFFFFF else start + ms;\n    }\n\n    /// Returns `Ok` once the clock reaches `at`, or `Err(Cancelled)` if the task is cancelled first: the body\n    /// returned, or the caller was cancelled.\n    /// Safety: ceesafe_async_wait_until only records the deadline for the executor.\n    async fn until(at: u64) -> Result<void, AsyncError> {\n        loop {\n            AsyncLeaf.status()?;\n            if (Timer.now() >= at) {\n                return Ok();\n            }\n            unsafe { ceesafe_async_wait_until(at); }\n            await Async.park();\n        }\n    }\n\n    /// The body decides when it returned first, or when the deadline child did not reach the deadline (the caller was\n    /// cancelled). After the deadline, a late `Ok` is kept and any `Err` is `timedOut` (ADR 0046 §3.2).\n    fn settle(first: u32, body: Result<T, E>, deadline: Result<void, AsyncError>, timedOut: E) -> Result<T, E> {\n        if (first == 0) {\n            return body;\n        }\n        // No `Ok` payload is bound, so T may be void (bug B6: `Ok(value)` was invalid for Result<void, E>).\n        let reached = match (deadline) {\n            Ok() => true,\n            Err(_) => false,\n        };\n        let failed = match (body) {\n            Err(_) => true,\n            _ => false,\n        };\n        if (reached && failed) {\n            return Err(timedOut);\n        }\n        return body;\n    }\n}\n\n/// What `Async.all` returns once both children have: the first error in the order they returned, else `Ok`.\nstruct AsyncAllJoin<E> {\n    fn settle(first: u32, a: Result<void, E>, b: Result<void, E>) -> Result<void, E> {\n        if (first == 0) {\n            return AsyncAllJoin<E>.decide(a, b);\n        }\n        return AsyncAllJoin<E>.decide(b, a);\n    }\n\n    fn decide(early: Result<void, E>, late: Result<void, E>) -> Result<void, E> {\n        match (early) {\n            Err(e) => { return Err(e); }\n            Ok() => { return late; }\n        }\n    }\n}\n\n/// A task set's record (ADR 0053 §3.4): the runtime's ceesafe_task_set, then the slot where a child's first error is\n/// copied. It lives in the frame of AsyncTasks.run's task, which never moves.\nstruct TaskSetRecord<E> {\n    words: [u64; 12];\n    first: Result<void, E>;\n}\n\n/// The set `Async.tasks`' body is given (ADR 0053 §3.1). The body, and the functions it passes the set to, start\n//",
    4 =>
        "/ children with `await set.spawn(async move () => …)`, which waits while the set's limit of children run, and\n/// `set.trySpawn(async move () => …)`, which is false instead. A child owns what it captures: no loans, so it cannot\n/// capture the set (N0349). The calls are the checker's (src/check/async.cee): these are the steps it joins.\n@noncopy // the one handle of its record\npublic struct TaskSet<E: Copy> {\n    private record: *mut void;\n    private oom: E;\n\n    /// Waits until a child may start: 0, or 2 once the set or this task is cancelled (the child is then not started).\n    /// Safety: the record outlives the set, which the body holds by borrow while AsyncTasks.run waits for it.\n    async fn room(borrow this) -> u32 {\n        loop {\n            let admitted = unsafe { ceesafe_async_set_admit(this.record, true) };\n            if (admitted != 1) {\n                return admitted;\n            }\n            await Async.park(); // a returning child wakes this task\n        }\n    }\n\n    /// 0 if a child may start now, 1 while the limit run, 2 once cancelled.\n    /// Safety: as room.\n    fn tryRoom(borrow this) -> u32 => unsafe { ceesafe_async_set_admit(this.record, false) };\n\n    fn recordOf(borrow this) -> *mut void => this.record;\n\n    /// `spawn`'s result for the start's code: 0 started; else (full and cancelled, or no frame) `Err(oom)`.\n    async fn spawned(borrow this, code: u32) -> Result<void, E> {\n        if (code == 0) {\n            return Ok();\n        }\n        return Err(this.oom);\n    }\n\n    /// `trySpawn`'s result: whether the child started.\n    fn started(borrow this, code: u32) -> bool => code == 0;\n}\n\n/// `await Async.tasks(limit, oom, async (set) => …)` (ADR 0053): `Async.tasksIn` with the system heap.\npublic struct AsyncTasks<E: Copy> {\n    @effectsOf(body)\n    public async fn run(\n        limit: u32,\n        oom: E,\n        body: borrow mut fn(borrow TaskSet<E>) -> Result<void, E>,\n    ) -> Result<void, E> => await AsyncTasksIn<E, SystemHeap>.run(SystemHeap {}, limit, oom, body);\n}\n\n/// `await Async.tasksIn(alloc, limit, oom, async (set) => …)` (ADR 0053): the body runs in the awaiting task, as the\n/// set's owner, with the set; then every child it started is waited for. The children's tasks and frames come from\n/// `alloc`'s allocator type. The result is the body's error, else the first child's, else `oom` if a child's frame\n/// could not be allocated, else Ok. The body's error cancels the children; a child's error cancels no sibling.\npublic struct AsyncTasksIn<E: Copy, A> {\n    /// Safety: the record is this frame's, which outlives every child: the set waits for them before it returns.\n    @effectsOf(body)\n    public async fn run(\n        alloc: A,\n        limit: u32,\n        oom: E,\n        body: borrow mut fn(borrow TaskSet<E>) -> Result<void, E>,\n    ) -> Result<void, E> {\n        var record = TaskSetRecord<E> { words: [0u64; 12], first: Ok() };\n        let raw = borrow mut record.words as *mut [u64; 12] as *mut void;\n        unsafe { ceesafe_async_set_init(raw, limit, borrow mut record.first as *mut Result<void, E> as *mut void); }\n        Async.setAllocator(raw, alloc); // the children's frames from A's adapters (c-backend.md §3a)\n        let set = TaskSet<E> { record: raw, oom: oom };\n        let result = body(borrow set);\n        match (result) {\n            Err(_) => { unsafe { ceesafe_async_set_cancel(raw); } }\n            Ok() => {}\n        }\n        while (!unsafe { ceesafe_async_set_done(raw) }) {\n            await Async.park(); // the last child wakes this task\n        }\n        match (result) {\n            Err(e) => { return Err(e); }\n            Ok() => {}\n        }\n        match (record.first) {\n            Err(e) => { return Err(e); }\n            Ok() => {}\n        }\n        if (unsafe { ceesafe_async_set_oom(raw) }) {\n            return Err(oom);\n        }\n        return Ok();\n    }\n}\n\n/// A one-shot wake-up from anywhere, to a task (ADR 0039): `await signal.wait()` parks the tas",
    5 =>
        "k until `signal.raise()`.\n/// `raise` has no effects, so an interrupt handler (`@context(irq)`) or another thread may call it, the way a driver\n/// tells the task waiting for its device. A raise before the wait is kept: the wait then returns at once. One task\n/// waits on a signal at a time.\n@noncopy // one signal, shared: a copy would never be raised\npublic struct AsyncSignal {\n    private words: [u64; 4]; // the runtime's record: raised, the waiting task, its executor, a raise in progress\n\n    /// A signal not raised.\n    public fn create() -> AsyncSignal => AsyncSignal { words: [0u64; 4] };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4): `static READY: AsyncSignal =\n    /// AsyncSignal.constant();`, which an interrupt handler can raise.\n    @constant\n    public fn constant() -> AsyncSignal => AsyncSignal { words: [0u64; 4] };\n\n    /// Raises the signal: the task waiting on it, if any, runs again.\n    /// Safety: the runtime changes the record atomically, and only wakes the task it names.\n    @effects()\n    public fn raise(borrow this) {\n        unsafe { ceesafe_async_signal_raise(this.record()); }\n    }\n\n    /// Waits until the signal is raised, then lowers it. A cancelled task returns `Err(AsyncError.Cancelled)` and no\n    /// longer waits (type-system.md §40.7).\n    /// Safety: the record names this task only while it waits here; ceesafe_async_signal_forget takes it out.\n    public async fn wait(borrow this) -> Result<void, AsyncError> {\n        loop {\n            match (AsyncLeaf.status()) {\n                Ok() => {}\n                Err(e) => {\n                    unsafe { ceesafe_async_signal_forget(this.record()); }\n                    return Err(e);\n                }\n            }\n            if (unsafe { ceesafe_async_signal_take(this.record()) }) {\n                return Ok();\n            }\n            await Async.park();\n        }\n    }\n\n    fn record(borrow this) -> *mut void => borrow this.words as *[u64; 4] as *mut [u64; 4] as *mut void;\n}\n",
    6 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Atomics (type-system.md §38.3; ADR 0016, ADR 0021), in every profile since ADR 0026: their operations are the\n// runtime header's static inline functions (ceesafe/rt.h), so they compile to the machine's atomic instructions and need\n// no runtime of their own. Their unsafe code keeps ownership.md T1–T3.\n\nextern \"C\" {\n    @effects()\n    fn ceesafe_atomic_load_u64(p: *mut u64) -> u64;\n    @effects()\n    fn ceesafe_atomic_store_u64(p: *mut u64, v: u64);\n    @effects()\n    fn ceesafe_atomic_swap_u64(p: *mut u64, v: u64) -> u64;\n    @effects()\n    fn ceesafe_atomic_cas_u64(p: *mut u64, expected: u64, desired: u64) -> u64;\n    @effects()\n    fn ceesafe_atomic_add_u64(p: *mut u64, v: u64) -> u64;\n    @effects()\n    fn ceesafe_atomic_load_u32(p: *mut u32) -> u32;\n    @effects()\n    fn ceesafe_atomic_store_u32(p: *mut u32, v: u32);\n    @effects()\n    fn ceesafe_atomic_swap_u32(p: *mut u32, v: u32) -> u32;\n    @effects()\n    fn ceesafe_atomic_cas_u32(p: *mut u32, expected: u32, desired: u32) -> u32;\n    @effects()\n    fn ceesafe_atomic_add_u32(p: *mut u32, v: u32) -> u32;\n    @effects()\n    fn ceesafe_atomic_load_u8(p: *mut u8) -> u8;\n    @effects()\n    fn ceesafe_atomic_store_u8(p: *mut u8, v: u8);\n    @effects()\n    fn ceesafe_atomic_swap_u8(p: *mut u8, v: u8) -> u8;\n    @effects()\n    fn ceesafe_atomic_cas_u8(p: *mut u8, expected: u8, desired: u8) -> u8;\n    @effects()\n    fn ceesafe_atomic_load_ord_u8(p: *mut u8, order: i32) -> u8;\n    @effects()\n    fn ceesafe_atomic_store_ord_u8(p: *mut u8, v: u8, order: i32);\n    @effects()\n    fn ceesafe_atomic_load_ord_u64(p: *mut u64, order: i32) -> u64;\n    @effects()\n    fn ceesafe_atomic_store_ord_u64(p: *mut u64, v: u64, order: i32);\n    @effects()\n    fn ceesafe_atomic_swap_ord_u64(p: *mut u64, v: u64, order: i32) -> u64;\n    @effects()\n    fn ceesafe_atomic_cas_ord_u64(p: *mut u64, expected: u64, desired: u64, order: i32) -> u64;\n    @effects()\n    fn ceesafe_atomic_add_ord_u64(p: *mut u64, v: u64, order: i32) -> u64;\n    @effects()\n    fn ceesafe_atomic_load_ord_u32(p: *mut u32, order: i32) -> u32;\n    @effects()\n    fn ceesafe_atomic_store_ord_u32(p: *mut u32, v: u32, order: i32);\n    @effects()\n    fn ceesafe_atomic_swap_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;\n    @effects()\n    fn ceesafe_atomic_cas_ord_u32(p: *mut u32, expected: u32, desired: u32, order: i32) -> u32;\n    @effects()\n    fn ceesafe_atomic_add_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;\n    @effects()\n    fn ceesafe_atomic_or_u64(p: *mut u64, v: u64) -> u64;\n    @effects()\n    fn ceesafe_atomic_or_ord_u64(p: *mut u64, v: u64, order: i32) -> u64;\n    @effects()\n    fn ceesafe_atomic_or_u32(p: *mut u32, v: u32) -> u32;\n    @effects()\n    fn ceesafe_atomic_or_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;\n    @effects()\n    fn ceesafe_atomic_and_u64(p: *mut u64, v: u64) -> u64;\n    @effects()\n    fn ceesafe_atomic_and_ord_u64(p: *mut u64, v: u64, order: i32) -> u64;\n    @effects()\n    fn ceesafe_atomic_and_u32(p: *mut u32, v: u32) -> u32;\n    @effects()\n    fn ceesafe_atomic_and_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;\n}\n\n/// The ordering of an atomic load (ADR 0021): C11's memory_order_relaxed, _acquire and _seq_cst.\npublic enum LoadOrdering { Relaxed, Acquire, SequentiallyConsistent }\n\n/// The ordering of an atomic store: C11's memory_order_relaxed, _release and _seq_cst.\npublic enum StoreOrdering { Relaxed, Release, SequentiallyConsistent }\n\n/// The ordering of an atomic read-modify-write (swap, compare-exchange, add, subtract): C11's memory_order_relaxed,\n/// _acquire, _release, _acq_rel and _seq_cst. A compare-exchange that fails orders as a load: AcquireRelease as\n/// Acquire, Release as Relaxed, the others as themselves.\npublic enum Ordering { Relaxed, Acquire, Release, AcquireRelease, SequentiallyConsistent }\n\n// The runtime's codes (ceesafe/rt.h): 0 relaxed, 1 acquire, 2 release, 3 acquire-release, 4 sequentially\n//",
    7 =>
        " consistent. A load never passes 2 or 3, and a store never 1 or 3, so no ordering C11 leaves undefined is used.\nfn loadCode(order: LoadOrdering) -> i32 => match (order) {\n    LoadOrdering.Relaxed => 0,\n    LoadOrdering.Acquire => 1,\n    LoadOrdering.SequentiallyConsistent => 4,\n};\n\nfn storeCode(order: StoreOrdering) -> i32 => match (order) {\n    StoreOrdering.Relaxed => 0,\n    StoreOrdering.Release => 2,\n    StoreOrdering.SequentiallyConsistent => 4,\n};\n\nfn code(order: Ordering) -> i32 => match (order) {\n    Ordering.Relaxed => 0,\n    Ordering.Acquire => 1,\n    Ordering.Release => 2,\n    Ordering.AcquireRelease => 3,\n    Ordering.SequentiallyConsistent => 4,\n};\n\n/// A u64 that threads may read and change at once: every operation is atomic and sequentially consistent.\n@threadSafe\n@noncopy\npublic struct AtomicU64 {\n    private value: u64;\n\n    /// A new atomic holding `value`.\n    public fn create(value: u64) -> AtomicU64 => AtomicU64 { value: value };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU64 = AtomicU64.constant(0);`.\n    @constant\n    public fn constant(value: u64) -> AtomicU64 => AtomicU64 { value: value };\n\n    /// Safety: the runtime accesses `value` only atomically, and safe code reaches it only through these methods.\n    public fn load(borrow this) -> u64 => unsafe { ceesafe_atomic_load_u64(this.cell()) };\n\n    /// Safety: as load.\n    public fn store(borrow this, value: u64) { unsafe { ceesafe_atomic_store_u64(this.cell(), value); } }\n\n    /// Safety: as load.\n    public fn swap(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_swap_u64(this.cell(), value) };\n\n    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).\n    /// Safety: as load.\n    public fn compareExchange(borrow this, expected: u64, desired: u64) -> Result<u64, u64> {\n        let old = unsafe { ceesafe_atomic_cas_u64(this.cell(), expected, desired) };\n        if (old == expected) {\n            return Ok(old);\n        }\n        return Err(old);\n    }\n\n    /// Adds, wrapping; returns the old value.\n    /// Safety: as load.\n    public fn fetchAdd(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_add_u64(this.cell(), value) };\n\n    /// Subtracts, wrapping; returns the old value.\n    /// Safety: as load.\n    public fn fetchSub(borrow this, value: u64) -> u64 =>\n        unsafe { ceesafe_atomic_add_u64(this.cell(), 0u64.wrappingSub(value)) };\n\n    /// Sets the bits of `value`; the value before (ADR 0041).\n    /// Safety: as load.\n    public fn fetchOr(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_or_u64(this.cell(), value) };\n\n    /// Keeps only the bits of `value`; the value before (ADR 0041).\n    /// Safety: as load.\n    public fn fetchAnd(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_and_u64(this.cell(), value) };\n\n    /// load, with an ordering (ADR 0021).\n    /// Safety: as load.\n    public fn loadWith(borrow this, order: LoadOrdering) -> u64 =>\n        unsafe { ceesafe_atomic_load_ord_u64(this.cell(), loadCode(order)) };\n\n    /// store, with an ordering.\n    /// Safety: as load.\n    public fn storeWith(borrow this, value: u64, order: StoreOrdering) {\n        unsafe { ceesafe_atomic_store_ord_u64(this.cell(), value, storeCode(order)); }\n    }\n\n    /// swap, with an ordering.\n    /// Safety: as load.\n    public fn swapWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_swap_ord_u64(this.cell(), value, code(order)) };\n\n    /// compareExchange, with an ordering; a failure orders as Ordering says.\n    /// Safety: as load.\n    public fn compareExchangeWith(borrow this, expected: u64, desired: u64, order: Ordering) -> Result<u64, u64> {\n        let old = unsafe { ceesafe_atomic_cas_ord_u64(this.cell(), expected, desired, code(order)) };\n        if (old == expected) {\n            return Ok(old);\n        }\n        return Err(old);\n    }\n\n    /// fetchAdd, with an ordering.\n    /// Safety:",
    8 =>
        " as load.\n    public fn fetchAddWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_add_ord_u64(this.cell(), value, code(order)) };\n\n    /// fetchSub, with an ordering.\n    /// Safety: as load.\n    public fn fetchSubWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_add_ord_u64(this.cell(), 0u64.wrappingSub(value), code(order)) };\n\n    /// fetchOr, with an ordering.\n    /// Safety: as load.\n    public fn fetchOrWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_or_ord_u64(this.cell(), value, code(order)) };\n\n    /// fetchAnd, with an ordering.\n    /// Safety: as load.\n    public fn fetchAndWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_and_ord_u64(this.cell(), value, code(order)) };\n\n    fn cell(borrow this) -> *mut u64 => borrow this.value as *u64 as *mut u64;\n}\n\n/// A u32 that threads may read and change at once, as AtomicU64.\n@threadSafe\n@noncopy\npublic struct AtomicU32 {\n    private value: u32;\n\n    /// A new atomic holding `value`.\n    public fn create(value: u32) -> AtomicU32 => AtomicU32 { value: value };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU32 = AtomicU32.constant(0);`.\n    @constant\n    public fn constant(value: u32) -> AtomicU32 => AtomicU32 { value: value };\n\n    /// Safety: as AtomicU64.load.\n    public fn load(borrow this) -> u32 => unsafe { ceesafe_atomic_load_u32(this.cell()) };\n\n    /// Safety: as AtomicU64.load.\n    public fn store(borrow this, value: u32) { unsafe { ceesafe_atomic_store_u32(this.cell(), value); } }\n\n    /// Safety: as AtomicU64.load.\n    public fn swap(borrow this, value: u32) -> u32 => unsafe { ceesafe_atomic_swap_u32(this.cell(), value) };\n\n    /// Safety: as AtomicU64.load.\n    public fn compareExchange(borrow this, expected: u32, desired: u32) -> Result<u32, u32> 