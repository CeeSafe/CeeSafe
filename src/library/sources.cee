    84 =>
        " slot's entry field); one more is OutOfMemory.\n    public fn put(borrow mut this, key: K, value: V) -> Result<V?, AllocError> {\n        let hash = this.hashOf(borrow key);\n        var empty: usize = 0;\n        match (this.probe(borrow key, hash, mut empty)) {\n            Some(slot) => {\n                // The new value in at the end, swapped into the entry's place, and the old one taken from the end. A\n                // failed push leaves the map as it was.\n                let entry = this.entryAt(slot);\n                this.values.push(value)?;\n                let last = this.values.length - 1;\n                this.values.swap(entry, last);\n                return Ok(this.values.pop());\n            }\n            null => {}\n        }\n        if (this.keys.length >= 0xFFFFFFFF) {\n            return Err(AllocError.OutOfMemory);\n        }\n        let grows = (this.keys.length + 1) * 4 > this.slots.length * 3;\n        if (grows) {\n            this.grow()?;\n        }\n        this.keys.push(key)?;\n        match (this.values.push(value)) {\n            Ok() => {}\n            Err(e) => {\n                this.keys.pop();\n                return Err(e);\n            }\n        }\n        let word = ((hash & 0xFFFFFFFF) << 32) | this.keys.length as u64;\n        if (grows) {\n            HashMap<K, V>.place(mut this.slots, word);\n        } else {\n            this.slots[empty] = word; // where the probe for the key stopped\n        }\n        return Ok(null);\n    }\n\n    /// Takes `key` out: its value, or null. The last entry moves into its place (ADR 0052 §2).\n    public fn remove(borrow mut this, key: borrow K) -> V? {\n        let hash = this.hashOf(key);\n        var empty: usize = 0;\n        let found = this.probe(key, hash, mut empty)?;\n        let entry = this.entryAt(found);\n        // The table: empty the slot, then shift back the run after it (backward-shift deletion: no tombstones).\n        let mask = this.slots.length - 1;