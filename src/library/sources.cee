's head and body, or a chunk's size\n/// line, data and CRLF, in one system call and without a copy. It is a value built by copying, since a slice cannot be\n/// an array element: `IoParts.of(head).then(body)`. Empty parts are allowed and send nothing.\npublic struct IoParts<region r> {\n    private p0: Slice<r, u8>;\n    private p1: Slice<r, u8>;\n    private p2: Slice<r, u8>;\n    private p3: Slice<r, u8>;\n    private p4: Slice<r, u8>;\n    private p5: Slice<r, u8>;\n    private p6: Slice<r, u8>;\n    private p7: Slice<r, u8>;\n    private n: u32;\n\n    /// One part.\n    public fn of(part: Slice<r, u8>) -> IoParts<r> {\n        let e = part[0..0];\n        return IoParts { p0: part, p1: e, p2: e, p3: e, p4: e, p5: e, p6: e, p7: e, n: 1 };\n    }\n\n    /// These parts and `part` after them, or null when there are eight already.\n    public fn then(this, part: Slice<r, u8>) -> IoParts<r>? {\n        if (this.n >= 8) {\n            return null;\n        }\n        return Some(IoParts {\n            p0: this.p0,\n            p1: if (this.n == 1) part else this.p1,\n            p2: if (this.n == 2) part else this.p2,\n            p3: if (this.n == 3) part else this.p3,\n            p4: if (this.n == 4) part else this.p4,\n            p5: if (this.n == 5) part else this.p5,\n            p6: if (this.n == 6) part else this.p6,\n            p7: if (this.n == 7) part else this.p7,\n            n: this.n + 1,\n        });\n    }\n\n    /// How many parts (0 to 8; 0 only from `after`).\n    public fn count(borrow this) -> u32 => this.n;\n\n    /// Part `i` (from 0); empty past the last.\n    public fn part(this, i: u32) -> Slice<r, u8> {\n        if (i >= this.n) {\n            let first = this.p0;\n            return first[0..0];\n        }\n        return match (i) {\n            0 => this.p0,\n            1 => this.p1,\n            2 => this.p2,\n            3 => this.p3,\n            4 => this.p4,\n            5 => this.p5,\n            6 => this.p6,\n            _ => this.p7,\n        };\n    }\n\n    /// The number of bytes in every part.\n    public fn totalLength(borrow this) -> ",
