        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Channels (ADR 0032): a bounded buffer of values between threads and between tasks, over the hosted runtime's\n// ceesafe_chan_* (runtime/hosted/ceesafe_rt_async.c). Values move in and out under the channel's spin lock and are\n// dropped after it is released, so no user code runs under it. Its unsafe code keeps ownership.md T1-T3: only Send\n// values cross, and the buffer is reached only under the lock.\n\nextern \"C\" {\n    @effects(alloc)\n    fn ceesafe_chan_create(capacity: u64, size: u64, align: u64) -> *mut void;\n    @effects()\n    fn ceesafe_chan_retain(channel: *mut void);\n    @effects()\n    fn ceesafe_chan_release(channel: *mut void) -> bool;\n    @effects()\n    fn ceesafe_chan_free(channel: *mut void);\n    @effects()\n    fn ceesafe_chan_begin_send(channel: *mut void, status: *mut u32, epoch: *mut u64) -> *mut void;\n    @effects()\n    fn ceesafe_chan_end_send(channel: *mut void);\n    @effects()\n    fn ceesafe_chan_begin_recv(channel: *mut void, status: *mut u32, epoch: *mut u64) -> *mut void;\n    @effects()\n    fn ceesafe_chan_end_recv(channel: *mut void);\n    @effects()\n    fn ceesafe_chan_close(channel: *mut void);\n    @effects()\n    fn ceesafe_chan_closed(channel: *mut void) -> bool;\n    @effects(sleep)\n    fn ceesafe_chan_wait(channel: *mut void, epoch: u64);\n    @effects(sleep)\n    fn ceesafe_chan_wait_until(channel: *mut void, epoch: u64, deadline: u64);\n    @effects()\n    fn ceesafe_chan_park(channel: *mut void, node: *mut void, epoch: u64) -> bool;\n    @effects()\n    fn ceesafe_chan_unpark(channel: *mut void, node: *mut void);\n}\n\n/// A task's place in a channel's queue of waiters: in its frame, which never moves (type-system.md §40.6).\nstruct ChannelWait {\n    words: [u64; 6];\n}\n\n/// Why `sendAsync` gave a value back: the channel is closed, or the task was cancelled (ADR 0032 §3.3).\npublic enum SendError<T> {\n    Closed(T),\n    Cancelled(T),\n}\n\nimpl<T> SendError<T> {\n    /// Why the send failed, without the value, which is dropped: `AsyncError.Closed` or `AsyncError.Cancelled`. It is\n    /// `@into` (ADR 0128; type-system.md §17.4): in a function that returns `Result<_, AsyncError>`,\n    /// `await channel.sendAsync(v)?` returns `Err(error.reason())`. Match on the error instead to keep the value.\n    @into\n    public fn reason(this) -> AsyncError => match (borrow this) {\n        SendError.Closed(_) => AsyncError.Closed,\n        SendError.Cancelled(_) => AsyncError.Cancelled,\n    };\n}\n\n/// A bounded channel (ADR 0032): every handle may send and receive; `clone` makes another handle to the same channel,\n/// and the last handle's drop drops the values still in it.\n@threadSafe\n@noncopy\npublic struct Channel<T: Send> {\n    private raw: *mut void;\n\n    /// A channel of `capacity` values, its buffer allocated once. A capacity of 0 panics: rendezvous channels are not\n    /// in v1 (ADR 0032 §5).\n    /// Safety: the runtime's channel is reference counted; this handle holds one count until its drop.\n    public fn create(capacity: usize) -> Result<Channel<T>, AllocError> {\n        if (capacity == 0) {\n            panic(\"a channel needs a capacity of at least 1\"); // ADR 0032 §3.1\n        }\n        let layout = layoutOf<T>();\n        let raw = unsafe { ceesafe_chan_create(capacity as u64, layout.size as u64, layout.align as u64) };\n        if (raw.isNull()) {\n            return Err(AllocError.OutOfMemory);\n        }\n        return Ok(Channel { raw: raw });\n    }\n\n    /// Another handle to the same channel.\n    /// Safety: it takes a count of the runtime's channel, given back by its drop.\n    public fn clone(borrow this) -> Channel<T> {\n        unsafe { ceesafe_chan_retain(this.raw); }\n        return Channel { raw: this.raw };\n    }\n\n    /// Every later send fails; receivers take what is buffered, then see the end.\n    /// Safety: the runtime's channel is ali