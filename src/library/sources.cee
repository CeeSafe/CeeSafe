    21 =>
        " Vector<u8>;\n\n    /// An empty byte string; no allocation.\n    public fn create() -> ByteString => ByteString { data: Vector<u8>.create() };\n\n    /// An empty byte string with room for `capacity` bytes.\n    public fn withCapacity(capacity: usize) -> Result<ByteString, AllocError> =>\n        Ok(ByteString { data: Vector<u8>.withCapacity(capacity)? });\n\n    /// The bytes of `bytes`, which it takes: no copy.\n    public fn fromBytes(bytes: Vector<u8>) -> ByteString => ByteString { data: bytes };\n\n    /// A new byte string with a copy of `bytes`: one allocation, none for no bytes.\n    public fn copyOf(bytes: Slice<u8>) -> Result<ByteString, AllocError> {\n        var copy = Vector<u8>.withCapacity(bytes.length)?;\n        copy.extend(bytes)?;\n        return Ok(ByteString { data: copy });\n    }\n\n    /// A new byte string with a copy of `text`'s bytes (a literal, a `StringView`, or a `String`, lent).\n    public fn fromText(text: StringView) -> Result<ByteString, AllocError> => ByteString.copyOf(text.bytes());\n\n    /// A new byte string with a copy of the bytes.\n    public fn clone(borrow this) -> Result<ByteString, AllocError> => ByteString.copyOf(this.data.view());\n\n    /// The bytes, which the byte string gives up: no copy.\n    public fn intoBytes(this) -> Vector<u8> => this.data;\n\n    /// A view of the text, a loan of the byte string.\n    public fn view(borrow this) -> ByteStringView => ByteStringView { data: this.data.view() };\n\n    /// The bytes, a loan of the byte string.\n    public fn bytes(borrow this) -> Slice<u8> => this.data.view();\n\n    /// The length in bytes.\n    public fn length(borrow this) -> usize => this.data.length;\n\n    /// How many bytes it can hold before it grows.\n    public fn capacity(borrow this) -> usize => this.data.capacity;\n\n    /// Whether there are no bytes.\n    public fn isEmpty(borrow this) -> bool => this.data.length == 0;\n\n    /// Removes every byte; the capacity stays.\n    public fn clear(borrow mut this) {\n        this.data.clear();\n    }\n\n    /// Keeps the first `length` bytes (all of them if there are no more).\n    public fn truncate(borrow mut this, length: usize) {\n        this.data.truncate(length);\n    }\n\n    /// The text as a `StringView` when the bytes are UTF-8, a loan of the byte string; null when they are not.\n    public fn toUtf8(borrow this) -> StringView? => StringView.fromUtf8(this.data.view());\n\n    /// `view().toUtf8Lossy()`: a new string, U+FFFD for each maximal subpart of an ill-formed sequence.\n    public fn toUtf8Lossy(borrow this) -> Result<String, AllocError> {\n        let v = this.view();\n        return v.toUtf8Lossy();\n    }\n\n    /// Appends the bytes of `text`. Each append grows the buffer at most once and leaves it as it was if that fails.\n    public fn append(borrow mut this, text: StringView) -> Result<void, AllocError> => this.data.extend(text.bytes());\n\n    /// Appends `bytes`, whatever they are.\n    public fn appendBytes(borrow mut this, bytes: Slice<u8>) -> Result<void, AllocError> => this.data.extend(bytes);\n\n    /// Appends the byte `b`.\n    public fn appendByte(borrow mut this, b: u8) -> Result<void, AllocError> => this.data.push(b);\n\n    /// Appends `value` in decimal, with a `-` before a negative value, as `String.appendNumber` writes an integer.\n    public fn appendNumber(borrow mut this, value: i64) -> Result<void, AllocError> {\n        var digits = [0u8; 24];\n        var w = TextWriter.create(mut digits[..]);\n        w.signed(value);\n        return this.data.extend(w.written());\n    }\n\n    /// Appends `value` in decimal: `appendNumber` for a `u64` past `i64`'s range.\n    public fn appendUnsigned(borrow mut this, value: u64) -> Result<void, AllocError> {\n        var digits = [0u8; 24];\n        var w = TextWriter.create(mut digits[..]);\n        w.decimal(value);\n        return this.data.extend(w.written());\n    }\n}\n\nimpl AppendFormatted for ByteString {\n    fn appendHex(borrow mut this, value: u64, minWidth: u32, upper: bool) -> Result<void, AllocError> =>\n  ",
    22 =>
        "      Formatted.hex(mut this.data, value, minWidth, upper);\n\n    fn appendOctal(borrow mut this, value: u64) -> Result<void, AllocError> => Formatted.octal(mut this.data, value);\n\n    fn appendFixed(borrow mut this, value: f64, digits: u32) -> Result<void, AllocError> =>\n        Formatted.fixed(mut this.data, value, digits);\n\n    fn appendPadded(\n        borrow mut this,\n        text: StringView,\n        width: usize,\n        align: TextAlign,\n        fill: u32,\n    ) -> Result<void, AllocError> =>\n        Formatted.padded(mut this.data, text, width, align, fill);\n}\n\nimpl AppendText for ByteString {\n    fn appendChar(borrow mut this, c: u32) -> Result<bool, AllocError> => this.data.appendChar(c);\n\n    fn appendUtf8(borrow mut this, bytes: Slice<u8>) -> Result<bool, AllocError> => this.data.appendUtf8(bytes);\n}\n\n/// The parts of a byte string before and after a separator: what `s.splitOnce(sep)` finds.\npublic struct ByteStringHalves<region r> {\n    public left: ByteStringView<r>;\n    public right: ByteStringView<r>;\n}\n\n/// The pieces of a byte string between separators, in order: `s.split(sep)`.\npublic struct ByteStringSplit<region r> {\n    pieces: ByteSplit<r>;\n}\n\nimpl<region r> Iterator<ByteStringView<r>> for ByteStringSplit<r> {\n    /// The next piece, or null after the last.\n    fn next(borrow mut this) -> ByteStringView<r>? {\n        let piece = this.pieces.next()?;\n        return ByteStringView.fromBytes(piece);\n    }\n}\n\n/// A piece of a byte string (`s.chunks()`): a run of valid UTF-8, then the bytes of one maximal subpart of an\n/// ill-formed sequence after it, empty only in the last chunk. A printer writes `valid` and escapes `invalid`.\npublic struct Utf8Chunk<region r> {\n    public valid: StringView<r>;\n    public invalid: Slice<r, u8>;\n}\n\n/// The chunks of a byte string, in order: `s.chunks()`. `next()` gives each, then null.\npublic struct Utf8Chunks<region r> {\n    data: Slice<r, u8>;\n    position: usize; // where the next chunk starts\n}\n\nimpl<region r> Iterator<Utf8Chunk<r>> for Utf8Chunks<r> {\n    /// The next chunk, or null after the last.\n    fn next(borrow mut this) -> Utf8Chunk<r>? {\n        let data = this.data;\n        let start = this.position;\n        if (start >= data.length) {\n            return null;\n        }\n        var i = start;\n        while (i < data.length) {\n            let n = Utf8Sequence.validLength(data, i);\n            if (n == 0) {\n                break;\n            }\n            i += n;\n        }\n        // Every sequence from start to i is well-formed, so the view is always there.\n        let valid = StringView.fromUtf8(data[start..i])!;\n        if (i == data.length) {\n            this.position = i;\n            return Utf8Chunk { valid: valid, invalid: data[i..i] };\n        }\n        let bad = Utf8Sequence.maximalSubpart(data, i);\n        this.position = i + bad;\n        return Utf8Chunk { valid: valid, invalid: data[i..i + bad] };\n    }\n}\n\n/// UTF-8 sequences, by the Unicode Standard's Table 3-7.\nstruct Utf8Sequence {\n    /// The second byte's least and greatest values after the first byte `b`; the later bytes are 0x80 to 0xBF.\n    fn secondLow(b: u8) -> u8 => if (b == 0xE0) 0xA0 else if (b == 0xF0) 0x90 else 0x80;\n\n    fn secondHigh(b: u8) -> u8 => if (b == 0xED) 0x9F else if (b == 0xF4) 0x8F else 0xBF;\n\n    /// How many bytes a sequence that starts with `b` has; 0 if no well-formed sequence starts with it.\n    fn sizeOf(b: u8) -> usize {\n        if (b < 0x80) {\n            return 1;\n        }\n        if (b >= 0xC2 && b <= 0xDF) {\n            return 2;\n        }\n        if (b >= 0xE0 && b <= 0xEF) {\n            return 3;\n        }\n        if (b >= 0xF0 && b <= 0xF4) {\n            return 4;\n        }\n        return 0;\n    }\n\n    /// How many of the bytes of the sequence at `at` (0 < at's size) are as Table 3-7 allows, from the first.\n    fn matched(s: Slice<u8>, at: usize) -> usize {\n        let first = s[at];\n        let size = Utf8Sequence.sizeOf(first);\n        if (size == 0) {\n     ",
    23 =>
        "       return 0;\n        }\n        var k: usize = 1;\n        while (k < size) {\n            if (at + k >= s.length) {\n                return k;\n            }\n            let b = s[at + k];\n            let low: u8 = if (k == 1) Utf8Sequence.secondLow(first) else 0x80;\n            let high: u8 = if (k == 1) Utf8Sequence.secondHigh(first) else 0xBF;\n            if (b < low || b > high) {\n                return k;\n            }\n            k += 1;\n        }\n        return k;\n    }\n\n    /// The length of the well-formed sequence at `at`, or 0 if the bytes there are not one.\n    fn validLength(s: Slice<u8>, at: usize) -> usize {\n        let size = Utf8Sequence.sizeOf(s[at]);\n        if (size == 0) {\n            return 0;\n        }\n        return if (Utf8Sequence.matched(s, at) == size) size else 0;\n    }\n\n    /// The length of the maximal subpart at `at`, where no well-formed sequence starts: the longest prefix of a\n    /// well-formed sequence there, or 1 if the first byte begins none.\n    fn maximalSubpart(s: Slice<u8>, at: usize) -> usize {\n        let k = Utf8Sequence.matched(s, at);\n        return if (k == 0) 1 else k;\n    }\n}\n\n/// The bytewise order of two byte strings.\nstruct ByteScanOrder {\n    fn compare(a: Slice<u8>, b: Slice<u8>) -> i32 {\n        let n = if (a.length < b.length) a.length else b.length;\n        for (k in 0..n) {\n            if (a[k] != b[k]) {\n                return if (a[k] < b[k]) -1 else 1;\n            }\n        }\n        return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;\n    }\n}\n",
    24 =>
        "// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0\n// Interior mutability (type-system.md §41; ADR 0084): RawCell, the one type whose contents may change while shared\n// loans of it are live, and the checked cells over it. A type that reaches a RawCell is Send when its contents are, but\n// not Share (§38.1), so a cell is used from one thread at a time. Their unsafe code keeps ownership.md T1–T3.\n\n/// The primitive (§41.1): a `T` that may be read and written through `pointer()` while shared loans of the cell, or of\n/// a value holding it, are live. It has `T`'s size and alignment. `T` may not hold loans (N0351).\n@interiorMutable\n@noncopy\npublic struct RawCell<T> {\n    private value: T;\n\n    /// A cell holding `value`.\n    public fn create(value: T) -> RawCell<T> => RawCell { value: value };\n\n    /// `create`, as a static initialiser when `value` is one (type-system.md §39.4).\n    @constant\n    public fn constant(value: T) -> RawCell<T> => RawCell { value: value };\n\n    /// The contents' address: safe to take, `unsafe` to use. Unsafe code must not make two live `borrow mut T` from\n    /// it, nor write while a `borrow T` it made is live (unsafe.md §2).\n    public fn pointer(borrow this) -> *mut T => borrow this.value as *T as *mut T;\n\n    /// The contents, for as long as the cell is borrowed exclusively: no other loan of it can be live.\n    public fn getMut(borrow mut this) -> borrow mut T => borrow mut this.value;\n\n    /// The contents, the cell consumed.\n    public fn intoInner(this) -> T => this.value;\n}\n\n/// A `Copy` value that may be read and replaced through a shared reference (§41.2): `get` copies it out, `set` stores\n/// a new one. No method lends a reference to the contents, so no change can be seen through a stale one, and a call\n/// between two methods (a re-entrant callback) is harmless. `==` and `!=` compare the contents when `T` has them.\npublic struct Cell<T: Copy> {\n    private raw: RawCell<T>;\n\n    /// A cell holding `value`.\n    public fn create(value: T) -> Cell<T> => Cell { raw: RawCell<T>.create(value) };\n\n    /// A copy of the contents.\n    /// Safety: no reference to the contents is ever lent, so nothing writes them during the read; `T` is Copy.\n    public fn get(borrow this) -> T => unsafe { this.raw.pointer().read() };\n\n    /// Stores `value`; the old contents need no drop (`T` is Copy), so no user code runs.\n    /// Safety: as get; nothing reads the contents during the write.\n    public fn set(borrow this, value: T) {\n        unsafe { this.raw.pointer().write(value); }\n    }\n\n    /// Stores `value` and returns the old contents.\n    /// Safety: as set.\n    public fn replace(borrow this, value: T) -> T {\n        let p = this.raw.pointer();\n        let old = unsafe { p.read() };\n        unsafe { p.write(value); }\n        return old;\n    }\n\n    /// The contents, for as long as the cell is borrowed exclusively.\n    public fn getMut(borrow mut this) -> borrow mut T => this.raw.getMut();\n\n    /// The contents, the cell consumed.\n    public fn intoInner(this) -> T => this.raw.intoInner();\n}\n\n/// A value lent through a shared reference with checked access (§41.3): any number of `read` guards, or one `write`\n/// guard, at a time. A conflict panics (\"cell already borrowed\"); `tryRead` and `tryWrite` return null instead. The\n/// state is one word: 0 free, n > 0 readers, -1 writing.\npublic struct RefCell<T> {\n    private state: Cell<isize>;\n    private raw: RawCell<T>;\n\n    /// A cell holding `value`, free.\n    public fn create(value: T) -> RefCell<T> => RefCell { state: Cell<isize>.create(0), raw: RawCell<T>.create(value) };\n\n    /// Shared access until the guard is dropped; panics while a `write` guard is live.\n    public fn read(borrow this) -> CellRef<T> {\n        let state = this.state.get();\n        if (state < 0 || state == 0x7FFFFFFF) {\n            panic(\"cell already borrowed\");\n        }\n        this.state.set(state + 1);\n        return CellRef { cell: this };\n    }\n\n    /// As ",
    25 =>
        "read, or null while a `write` guard is live.\n    public fn tryRead(borrow this) -> CellRef<T>? {\n        let state = this.state.get();\n        if (state < 0 || state == 0x7FFFFFFF) {\n            return null;\n        }\n        this.state.set(state + 1);\n        return CellRef { cell: this };\n    }\n\n    /// Exclusive access until the guard is dropped; panics while any guard is live.\n    public fn write(borrow this) -> CellRefMut<T> {\n        if (this.state.get() != 0) {\n            panic(\"cell already borrowed\");\n        }\n        this.state.set(-1);\n        return CellRefMut { cell: this };\n    }\n\n    /// As write, or null while any guard is live.\n    public fn tryWrite(borrow this) -> CellRefMut<T>? {\n        if (this.state.get() != 0) {\n            return null;\n        }\n        this.state.set(-1);\n        return CellRefMut { cell: this };\n    }\n\n    /// Stores `value` and returns the old contents, moved out before the return: their drop runs in the caller, with\n    /// no guard live. Panics while any guard is live.\n    /// Safety: no guard is live, so no reference to the contents is; the old value is read out before the write.\n    public fn replace(borrow this, value: T) -> T {\n        if (this.state.get() != 0) {\n            panic(\"cell already borrowed\");\n        }\n        let p = this.raw.pointer();\n        let old = unsafe { p.read() };\n        unsafe { p.write(value); }\n        return old;\n    }\n\n    /// The contents, for as long as the cell is borrowed exclusively: no guard can be live.\n    public fn getMut(borrow mut this) -> borrow mut T => this.raw.getMut();\n\n    /// The contents, the cell consumed.\n    public fn intoInner(this) -> T => this.raw.intoInner();\n\n    /// The contents as a shared reference, for a guard.\n    /// Safety: only a live guard calls it, and the state it set keeps every writer out while the reference is used.\n    fn shared(borrow this) -> borrow T => unsafe { Ptr.toBorrow(this.raw.pointer() as *T) };\n\n    /// A `read` guard's drop.\n    fn releaseRead(borrow this) {\n        this.state.set(this.state.get() - 1);\n    }\n\n    /// A `write` guard's drop.\n    fn releaseWrite(borrow this) {\n        this.state.set(0);\n    }\n}\n\n/// `RefCell.take` on a `RefCell<T?>` (§41.3): the contents, leaving null.\npublic struct RefCellTaking<T> {\n    /// Panics while any guard is live, as replace.\n    public fn take(cell: borrow RefCell<T?>) -> T? => cell.replace(null);\n}\n\n/// A `read` guard of a RefCell (§41.3): `data()` lends the contents shared; dropping it gives the access back.\npublic struct CellRef<region r, T> {\n    private cell: borrow(r) RefCell<T>;\n\n    /// The contents, for as long as the guard is borrowed.\n    public fn data(borrow this) -> borrow T => this.cell.shared();\n\n    drop {\n        this.cell.releaseRead();\n    }\n}\n\n/// A `write` guard of a RefCell (§41.3): `data()` lends the contents exclusively; dropping it gives the access back.\npublic struct CellRefMut<region r, T> {\n    private cell: borrow(r) RefCell<T>;\n\n    /// The contents, for as long as the guard is borrowed exclusively.\n    /// Safety: the guard set the state to -1, so no other guard is live and none can be made while it is; the loan\n    /// ends before the guard's drop gives the access back (a RawCell's contents may change while the cell is\n    /// shared, type-system.md §41.1).\n    public fn data(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.cell.raw.pointer()) };\n\n    drop {\n        this.cell.releaseWrite();\n    }\n}\n\n/// A value written at most once through a shared reference (§41.4, ADR 0096): empty at first, then full for as long\n/// as the cell is shared, lending `borrow T`. `getOrInit` fills an empty cell from its initialiser; `set` fills it\n/// with a value. A full cell changes only through an exclusive borrow (`take`, `getMut`), when no reference to the\n/// contents can be live. The state is one by