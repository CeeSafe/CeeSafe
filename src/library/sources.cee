        "rsing.floatBits(s, 52, 11, -1023)?;\n        return f64.fromBits(bits);\n    }\n\n    /// Text as an `f32`, correctly rounded (once: not through an `f64`), or null; the grammar of parseF64.\n    public fn parseF32(s: Slice<u8>) -> f32? {\n        let bits = NumberParsing.floatBits(s, 23, 8, -127)?;\n        return f32.fromBits(truncate<u32>(bits));\n    }\n\n    /// The IEEE representation of the text in a format with `mantissaBits` and `exponentBits` (bias `bias`), or null.\n    fn floatBits(s: Slice<u8>, mantissaBits: u32, exponentBits: u32, bias: i32) -> u64? {\n        let negative = s.length > 0 && s[0] == '-';\n        let start: usize = if (s.length > 0 && (s[0] == '-' || s[0] == '+')) 1 else 0;\n        let signBit = if (negative) 1u64 << (mantissaBits + exponentBits) else 0;\n        let infinity = ((1u64 << exponentBits) - 1) << mantissaBits;\n        if (NumberParsing.isWord(s, start, \"inf\") || NumberParsing.isWord(s, start, \"infinity\")) {\n            return signBit | infinity;\n        }\n        if (NumberParsing.isWord(s, start, \"nan\")) {\n            return signBit | infinity | (1u64 << (mantissaBits - 1)); // the quiet NaN\n        }\n        var d = FloatDecimal { digits: [0u8; 800], count: 0, point: 0, truncated: false };\n        if (!d.read(s, start)) {\n            return null;\n        }\n        let fast = NumberParsing.fastPath(borrow d, mantissaBits);\n        if (fast != null) {\n            return signBit | fast!;\n        }\n        return signBit | d.toBits(mantissaBits, exponentBits, bias);\n    }\n\n    /// Clinger's fast path: the magnitude's bits when the digits and the power of ten are exact in the format, so one\n    /// multiplication or division rounds correctly; otherwise null.\n    fn fastPath(d: borrow FloatDecimal, mantissaBits: u32) -> u64? {\n        let double = mantissaBits == 52;\n        let maxDigits: usize = if (double) 15 else 7;\n        let maxPower: i32 = if (double) 22 else 10;\n        if (d.trun