ublic async fn resolve(host: StringView, port: u16) -> Result<Vector<SocketAddress>, AsyncError> {\n        var out = Vector<SocketAddress>.create();\n        match (SocketAddresses.parseIp(host, port)) {\n            Some(address) => {\n                match (out.push(address)) {\n                    Ok() => { return Ok(out); }\n                    Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }\n                }\n            }\n            null => {}\n        }\n        let name = host.bytes();\n        var plain = name.length > 0 && name.length <= 253;\n        for (b in name) {\n            if (b == 0) {\n                plain = false;\n            }\n        }\n        if (!plain) {\n            return Err(AsyncError.Io(IoError.InvalidInput));\n        }\n        let raw = unsafe { ceesafe_dns_start(name.ptr, name.length as u64, port) };\n        if (raw.isNull()) {\n            return Err(AsyncError.Io(IoError.OutOfMemory));\n        }\n        let lookup = DnsLookup { raw: raw };\n        loop {\n            AsyncLeaf.status()?; // cancelled: the drop leaves the lookup to its thread\n            let r = unsafe { ceesafe_dns_poll(lookup.raw) };\n            if (r == 1) {\n                break;\n            }\n            if (r < 0) {\n                return Err(AsyncError.Io(AsyncIo.ioError(r as i64)));\n            }\n            await Async.park();\n        }\n        let count = unsafe { ceesafe_dns_count(lookup.raw) };\n        for (k in 0..count) {\n            var bytes = [0u8; 16];\n            var family: u32 = 0;\n            var scope: u32 = 0;\n            unsafe {\n                ceesafe_dns_address(\n                    lookup.raw,\n                    k,\n                    borrow mut bytes as *mut [u8; 16] as *mut u8,\n                    borrow mut family as *mut u32,\n                    borrow mut scope as *mut u32,\n                );\n            }\n            let address = if (family == 4) SocketAddress.V4(\n            