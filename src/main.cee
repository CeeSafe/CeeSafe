/// ceesafec: the CeeSafe compiler (ROADMAP.md, spec/tooling.md). A command not yet implemented names its phase.
/// The usage text: every command and option, as `ceesafec --help` prints it.
fn appendUsage(out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    appendText(out, "usage: ceesafec <command> [options] <file.cee>... [<file.c>...] [-- <program arguments>]\n")?;
    appendText(out, "\n")?;
    appendText(
        out,
        "Without files, parse, check, build, run, doc and fmt use the package of the nearest ceesafe.toml\n",
    )?;
    appendText(out, "(tooling.md §4); --offline uses only what is already fetched.\n")?;
    appendText(out, "\n")?;
    appendText(out, "commands:\n")?;
    appendText(out, "  parse    lex and parse the files, report syntax errors\n")?;
    appendText(
        out,
        "  check    parse and type-check the files as one package; in a package, the package with every package\n",
    )?;
    appendText(
        out,
        "           it depends on, each from its interface record where the cache holds a valid one (ADR 0082\n",
    )?;
    appendText(
        out,
        "           §2.7), and one N0364 at the manifest for a dependency with errors (tooling.md §4.4):\n",
    )?;
    appendText(out, "           --package <name>  check that package of the lock instead, from anywhere in it\n")?;
    appendText(
        out,
        "           --all             check every package of the lock, their tests included, reported by package\n",
    )?;
    appendText(
        out,
        "           --whole-program   check the packages as one program, without records, every package's own\n",
    )?;
    appendText(out, "                             diagnostics in full (the oracle the others agree with)\n")?;
    appendText(out, "           It takes no --jobs: the check is one process, which then makes the records it can\n")?;
    appendText(out, "  build    compile the package to C, and by default to an executable; .c files are compiled\n")?;
    appendText(out, "           and linked with it (type-system.md §28.6)\n")?;
    appendText(out, "  run      run the package with the NIR reference interpreter (--interp)\n")?;
    appendText(
        out,
        "  test     run the package's @test functions, each as its own process (ADR 0049): --filter <text>, --list,\n           --interp, --jobs <n>, --timeout <seconds>, --sweep alloc|cancel, --format text|json\n",
    )?;
    appendText(out, "  fmt      rewrite the files (or the .cee files under a directory) in the canonical style\n")?;
    appendText(out, "           (formatting.md); --check lists the files that would change, --stdout prints one\n")?;
    appendText(
        out,
        "  new      make a package: ceesafec new <name> [--lib] [--agent <names>] [--no-agent] (tooling.md §4.4);\n",
    )?;
    appendText(
        out,
        "           it writes AGENTS.md for AI agents, and with --agent claude,gemini,copilot,cursor their files\n",
    )?;
    appendText(out, "           and MCP configurations too (tooling.md §7)\n")?;
    appendText(
        out,
        "  agents   write or refresh the package's agent instructions: ceesafec agents [--agent <names>] (tooling.md §7.3)\n",
    )?;
    appendText(
        out,
        "  fetch    resolve the package's dependencies and write ceesafe.lock (--offline: no git; --update [name]:\n",
    )?;
    appendText(out, "           choose registry versions afresh, tooling.md §4.7)\n")?;
    appendText(
        out,
        "  publish  check that the package can be published and print its index entry (tooling.md §4.8)\n",
    )?;
    appendText(
        out,
        "  index-check  check a package index's entries against their commits, for the index's CI (tooling.md §4.8)\n",
    )?;
    appendText(out, "  lsp      serve the Language Server Protocol on standard input and output (tooling.md §2)\n")?;
    appendText(
        out,
        "  mcp      serve the Model Context Protocol on standard input and output, for AI agents (tooling.md §6)\n",
    )?;
    appendText(
        out,
        "  fix      apply the compiler's fixes to the files (or the package) and check again, until none\n",
    )?;
    appendText(out, "           applies (tooling.md §5.3); --dry-run prints the edits instead\n")?;
    appendText(out, "  explain  print what a diagnostic code means: ceesafec explain N0249 (tooling.md §5.4)\n")?;
    appendText(out, "  doc      write a Markdown page of the files' public items (tooling.md §1): -o <file>,\n")?;
    appendText(out, "           --title <text>; --missing lists the public items without a doc comment\n")?;
    appendText(out, "options:\n")?;
    appendText(
        out,
        "  --deny-warnings   (check, build, test) treat warnings as errors: they are reported as errors and fail\n",
    )?;
    appendText(out, "                    the command (ADR 0073 §2.4)\n")?;
    appendText(out, "  --diagnostics-format text|json\n")?;
    appendText(
        out,
        "                    (parse, check, build, run, fmt, fix) diagnostics as text on standard error (default),\n",
    )?;
    appendText(out, "                    or as one JSON document on standard output, with fixes (tooling.md §5.1)\n")?;
    appendText(out, "  --dump-ast        (parse) print the AST of each file\n")?;
    appendText(out, "  --dump-hir        (check) print the typed HIR of the package\n")?;
    appendText(out, "  --dump-nir        (build) print the NIR of the package\n")?;
    appendText(
        out,
        "  --emit c|exe|obj  (build) write C sources (to the -o directory), an executable (default), or one\n",
    )?;
    appendText(out, "                    relocatable object (profiles.md §4.3)\n")?;
    appendText(
        out,
        "  --kernel cosmoos  (build, check, with --profile freestanding) include lib/kernel, the library for a kernel\n",
    )?;
    appendText(
        out,
        "                    with CosmoOS's C API: locks, guards, per-CPU data, kernel objects (ADR 0025)\n",
    )?;
    appendText(out, "  --profile hosted|freestanding\n")?;
    appendText(
        out,
        "                    (build, check) the profile: hosted (default) or freestanding, with no C library\n",
    )?;
    appendText(out, "                    and no operating system (profiles.md §4)\n")?;
    appendText(
        out,
        "  --no-float        (build, check) reject every float type and literal, for code built without FP\n",
    )?;
    appendText(out, "                    registers such as a kernel (type-system.md §35.9)\n")?;
    appendText(out, "  -o <path>         (build) output file or directory; default: name of the first input\n")?;
    appendText(
        out,
        "  --cc <compiler>   (build) C compiler for --emit exe; default: $CC, else cc, or on Windows clang, gcc or\n",
    )?;
    appendText(out, "                    Visual Studio's cl, found and set up (tooling.md §8)\n")?;
    appendText(out, "  --cflag <flag>    (build) extra flag for the C compiler (repeatable)\n")?;
    appendText(
        out,
        "  --ld <linker>     (build --emit obj) join the objects with '<linker> -r' (e.g. ld.lld for ELF\n",
    )?;
    appendText(out, "                    cross builds) instead of the C compiler\n")?;
    appendText(out, "  --line-directives (build) map the generated C to CeeSafe lines with #line\n")?;
    appendText(
        out,
        "  -g                (build) debug build: #line directives, C compiled with -g -O0, debug assertions on\n",
    )?;
    appendText(
        out,
        "  --debug-assertions, --no-debug-assertions  (build, run) evaluate debugAssert or not; default: on with -g,\n",
    )?;
    appendText(out, "                    under test and in the interpreter (type-system.md §8)\n")?;
    appendText(
        out,
        "  --flat-c          (build) emit the flat form: one label per block, no if/loop reconstruction\n",
    )?;
    appendText(out, "  --interp          (run) interpret the checked NIR (intermediate-representation.md §5)\n")?;
    appendText(
        out,
        "  --no-placement    (build, run) keep every box on the heap (placement is on by default, optimisations.md §4)\n",
    )?;
    appendText(out, "  --explain-allocations  (build) print where every allocation site's memory comes from\n")?;
    appendText(out, "  --explain-frames  (build) print each async fn's frame size and what makes it large\n")?;
    appendText(
        out,
        "  --no-bce          (build, run) keep every index check (no bounds-check elimination, optimisations.md §2)\n",
    )?;
    appendText(out, "  --explain-bounds-checks  (build) print each index check and whether it was removed\n")?;
    appendText(
        out,
        "  --no-oce          (build, run) keep every overflow check (no overflow-check elimination, optimisations.md §3)\n",
    )?;
    appendText(
        out,
        "  --explain-overflow-checks  (build) print each checked + - * and negation and whether its check was removed\n",
    )?;
    appendText(
        out,
        "  --no-closure-specialisation  (build, run) keep every call through a closure indirect (optimisations.md §5)\n",
    )?;
    appendText(
        out,
        "  --split           (build) write the C as ceesafe_program.h, c/<package>/<path>.c per CeeSafe file and\n",
    )?;
    appendText(out, "                    ceesafe_instances.c, so it compiles in parallel (c-backend.md §2.4)\n")?;
    appendText(
        out,
        "  --jobs <n>        (build --split) compile at most n C files at once; default: the number of CPUs\n",
    )?;
    appendText(
        out,
        "  --program <name>  (build --split) the name external C names carry; default: the package's, or the\n",
    )?;
    appendText(out, "                    first file's\n")?;
    appendText(
        out,
        "  --explain-closure-calls  (build) print each call through a closure, whether it became direct, and each variant made\n",
    )?;
    return Ok();
}

/// The roadmap phase that brings a command to parity, or null if the reference compiler has no such command.
fn phaseOf(command: StringView) -> StringView? {
    if (command == "parse") {
        return "P2";
    }
    if (command == "check") {
        return "P4";
    }
    if (command == "build") {
        return "P5";
    }
    if (command == "run" || command == "fmt" || command == "new" || command == "agents" || command == "fetch" ||
        command == "publish" || command == "index-check" || command == "lsp" || command == "mcp" || command == "fix" ||
        command == "explain" || command == "doc" || command == "test") {
        return "P8";
    }
    return null;
}

/// The options of a file command, after `--diagnostics-format` is taken out (Program.cs's TakeDiagnosticsFormat and
/// ParseOptions).
struct Options {
    json: bool;
    dumpTokens: bool;
    dumpAst: bool;
    dumpHir: bool;
    noFloat: bool;
    denyWarnings: bool;          // --deny-warnings (check, build, test): warnings are errors (ADR 0073 §2.4)
    libraryDiagnostics: bool;    // report diagnostics in the libraries' files too (porting gaps there; the reference compiler has none)
    freestanding: bool;          // --profile freestanding (profiles.md §4)
    kernel: bool;                // --kernel cosmoos: lib/kernel, in the freestanding profile (ADR 0025)
    profileGiven: bool;          // --profile was given: package mode keeps it over the manifest's
    building: bool;              // `build`: until P5, only `--dump-nir`, which prints the NIR and stops
    dumpNir: bool;               // --dump-nir (build)
    closureSpecialisation: bool; // on unless --no-closure-specialisation (optimisations.md §5)
    explainClosureCalls: bool;   // --explain-closure-calls
    placement: bool;             // on unless --no-placement (memory-model.md §5)
    explainAllocations: bool;    // --explain-allocations
    explainFrames: bool;         // --explain-frames (type-system.md §40.6)
    bce: bool;                   // on unless --no-bce (optimisations.md §2)
    explainBoundsChecks: bool;   // --explain-bounds-checks
    oce: bool;                   // on unless --no-oce (optimisations.md §3)
    explainOverflowChecks: bool; // --explain-overflow-checks
    structured: bool;            // on unless --flat-c (c-backend.md §3)
    emit: Vector<u8>;            // --emit c|exe|obj (build)
    output: Vector<u8>;          // -o (build), or empty
    exportsHeader: Vector<u8>;   // --exports-header (build)
    emitGiven: bool;
    lineDirectives: bool;       // --line-directives or -g (build)
    debug: bool;                // -g (build)
    debugAssertions: u8;        // --debug-assertions 1, --no-debug-assertions 2, else 0 (build, run; ADR 0087 §2.5)
    split: bool;                // --split (build)
    programName: Vector<u8>;    // --program (build), or the package's name
    cc: Vector<u8>;             // --cc, else $CC (build)
    cflags: Vector<Vector<u8>>; // --cflag (build)
    linker: Vector<u8>;         // --ld (build --emit obj)
    cNames: Vector<Vector<u8>>; // C files given or the manifest's (type-system.md §28.6): names
    cTexts: Vector<Vector<u8>>; // and texts
    native: NativeBuild;        // the manifests' libraries and separately compiled C (ADR 0047)
    entryName: Vector<u8>;      // the program's entry: "main", or the test harness's (ADR 0049)
    testing: bool;              // `test` (ADR 0049)
    includeTests: bool;         // the root package's test directories are sources (`check`, `test`)
    harness: Vector<u8>;        // a generated harness file to add to the sources, or empty
    testFilter: Vector<u8>;     // test --filter
    testList: bool;             // test --list
    testJobs: u32;              // test --jobs, and build --jobs when `jobsGiven`
    jobsGiven: bool;            // --jobs was given (build: else the number of CPUs, ADR 0082 §2.5)
    testTimeout: u64;           // test --timeout, in seconds
    testSweep: u32;             // test --sweep: 0 none, 1 alloc, 2 cancel
    testSweepStrict: bool;      // test --sweep-strict (ADR 0075 §2.16)
    testJson: bool;             // test --format json
    defaultOutput: Vector<u8>;  // package mode: <package>/out/<name>
    files: Vector<String>;
    offline: bool;                          // --offline: package mode uses only what is fetched
    running: bool;                          // `run`
    interp: bool;                           // run --interp
    programArguments: Vector<Vector<u8>>;   // run: after `--`
    absolutePaths: bool;                    // package files named by their absolute paths (Workspace.Packages without a mapping)
    packageDirectories: Vector<Vector<u8>>; // package mode: each package's directory, root first (ADR 0082 §2.1)
    fixing: bool;                           // `fix`: check, then apply the fixes (tooling.md §5.3)
    dryRun: bool;                           // fix --dry-run
    fixRound: u32;
    checking: bool;           // `check` (not `fix`): package mode checks each package with interface records (ADR 0082 §2.7)
    checkAll: bool;           // check --all: every package of the lock
    wholeProgram: bool;       // check --whole-program: every package as one program, without records (ADR 0013 D4)
    checkPackage: Vector<u8>; // check --package <name>: that package of the lock, as from its directory
    recordOnly: bool;         // check --record: the check that makes the package's interface record, which it prints
}

/// A usage error: the message and the usage text on stderr (Program.Fail).
fn fail(message: StringView) -> i32 {
    var out = copyBytes("ceesafec: ".bytes())!;
    appendText(mut out, message)!;
    out.push('\n')!;
    appendUsage(mut out)!;
    Console.writeError(StringView.fromUtf8(out.view())!);
    return 2;
}

fn copyText(text: StringView) -> String {
    var s = String.create();
    s.append(text)!;
    return s;
}

/// The arguments after the command without `--diagnostics-format` (Program.TakeDiagnosticsFormat), for the commands
/// that read no diagnostics options; or the exit status of a usage error.
fn plainArguments(arguments: borrow mut Vector<Vector<u8>>, json: borrow mut bool) -> i32 {
    var a: usize = 2;
    while (a < Process.argumentCount()) {
        let arg = Process.argument(a)!;
        a += 1;
        if (arg == "--") {
            arguments.push(copyBytes(arg.bytes())!)!;
            while (a < Process.argumentCount()) {
                arguments.push(copyBytes(Process.argument(a)!.bytes())!)!;
                a += 1;
            }
            return 0;
        }
        let bytes = arg.bytes();
        var value: StringView? = null;
        if (bytes.length >= 21 && sameText(bytes[0..21], "--diagnostics-format=")) {
            value = StringView.fromUtf8(bytes[21..])!;
        } else if (arg == "--diagnostics-format") {
            value = match (Process.argument(a)) {
                Some(v) => v,
                null => "",
            };
            a += 1;
        } else {
            arguments.push(copyBytes(arg.bytes())!)!;
            continue;
        }
        let given = value!;
        if (given != "text" && given != "json") {
            var message = String.create();
            message.append("--diagnostics-format must be 'text' or 'json', not '")!;
            message.append(given)!;
            message.append("'")!;
            return fail(message.view());
        }
        json = given == "json";
    }
    return 0;
}

/// Reads the arguments after the command, or returns the exit status of a usage error.
fn readOptions(options: borrow mut Options) -> i32 {
    // The format is taken out first, so its errors come before any other (Program.Run).
    var ignored = Vector<Vector<u8>>.create();
    let formatStatus = plainArguments(mut ignored, mut options.json);
    if (formatStatus != 0) {
        return formatStatus;
    }
    var a: usize = 2;
    while (a < Process.argumentCount()) {
        let arg = Process.argument(a)!;
        a += 1;
        let bytes = arg.bytes();
        if (bytes.length >= 21 && sameText(bytes[0..21], "--diagnostics-format=")) {
            // taken out above
        } else if (arg == "--diagnostics-format") {
            a += 1;
        } else if (arg == "--dump-ast") {
            options.dumpAst = true;
        } else if (arg == "--dump-hir") {
            options.dumpHir = true;
        } else if (options.building && arg == "--dump-nir") {
            options.dumpNir = true;
        } else if (options.building && arg == "--line-directives") {
            options.lineDirectives = true;
        } else if (options.building && arg == "-g") {
            options.lineDirectives = true;
            options.debug = true;
        } else if ((options.building || options.running) && arg == "--debug-assertions") {
            options.debugAssertions = 1;
        } else if ((options.building || options.running) && arg == "--no-debug-assertions") {
            options.debugAssertions = 2;
        } else if (options.building && arg == "--split") {
            options.split = true;
        } else if (options.building && (arg == "--emit" || arg == "-o" || arg == "--exports-header" || arg == "--cc" ||
            arg == "--cflag" || arg == "--ld" || arg == "--program")) {
            let value = match (Process.argument(a)) {
                Some(v) => v,
                null => {
                    var message = String.create();
                    message.append("option '")!;
                    message.append(arg)!;
                    message.append("' needs a value")!;
                    return fail(message.view());
                }
            };
            a += 1;
            if (arg == "--emit") {
                if (value != "c" && value != "exe" && value != "obj") {
                    var message = String.create();
                    message.append("--emit must be 'c', 'exe' or 'obj', not '")!;
                    message.append(value)!;
                    message.append("'")!;
                    return fail(message.view());
                }
                options.emit = copyBytes(value.bytes())!;
                options.emitGiven = true;
            } else if (arg == "-o") {
                options.output = copyBytes(value.bytes())!;
            } else if (arg == "--cc") {
                options.cc = copyBytes(value.bytes())!;
            } else if (arg == "--cflag") {
                options.cflags.push(copyBytes(value.bytes())!)!;
            } else if (arg == "--ld") {
                options.linker = copyBytes(value.bytes())!;
            } else if (arg == "--program") {
                options.programName = copyBytes(value.bytes())!;
            } else {
                options.exportsHeader = copyBytes(value.bytes())!;
            }
        } else if ((options.building || options.running) && arg == "--no-closure-specialisation") {
            options.closureSpecialisation = false;
        } else if (options.building && arg == "--explain-closure-calls") {
            options.explainClosureCalls = true;
        } else if ((options.building || options.running) && arg == "--no-placement") {
            options.placement = false;
        } else if (options.building && arg == "--explain-allocations") {
            options.explainAllocations = true;
        } else if (options.building && arg == "--explain-frames") {
            options.explainFrames = true;
        } else if ((options.building || options.running) && arg == "--no-bce") {
            options.bce = false;
        } else if (options.building && arg == "--explain-bounds-checks") {
            options.explainBoundsChecks = true;
        } else if ((options.building || options.running) && arg == "--no-oce") {
            options.oce = false;
        } else if (options.building && arg == "--explain-overflow-checks") {
            options.explainOverflowChecks = true;
        } else if (options.building && arg == "--flat-c") {
            options.structured = false;
        } else if (arg == "--no-float") {
            options.noFloat = true;
        } else if (!options.running && arg == "--deny-warnings") {
            options.denyWarnings = true;
        } else if (arg == "--library-diagnostics") {
            options.libraryDiagnostics = true;
        } else if (arg == "--profile" || arg == "--kernel") {
            let value = match (Process.argument(a)) {
                Some(v) => v,
                null => {
                    var message = String.create();
                    message.append("option '")!;
                    message.append(arg)!;
                    message.append("' needs a value")!;
                    return fail(message.view());
                }
            };
            a += 1;
            if (arg == "--kernel") {
                // lib/kernel, for a kernel with CosmoOS's C API (ADR 0025); the only kernel so far.
                if (value != "cosmoos") {
                    var message = String.create();
                    message.append("--kernel must be 'cosmoos', not '")!;
                    message.append(value)!;
                    message.append("'")!;
                    return fail(message.view());
                }
                options.kernel = true;
            } else if (value == "hosted") {
                options.freestanding = false;
                options.profileGiven = true;
            } else if (value == "freestanding") {
                options.freestanding = true;
                options.profileGiven = true;
            } else {
                var message = String.create();
                message.append("--profile must be 'hosted' or 'freestanding', not '")!;
                message.append(value)!;
                message.append("'")!;
                return fail(message.view());
            }
        } else if (arg == "--dump-tokens") {
            options.dumpTokens = true;
        } else if (options.testing && arg == "--sweep-strict") {
            options.testSweepStrict = true; // ADR 0075 §2.16: a test's own unwraps fail the sweep too
        } else if (options.testing && (arg == "--list" || arg == "--interp")) {
            if (arg == "--list") {
                options.testList = true;
            } else {
                options.interp = true;
            }
        } else if ((options.testing &&
            (arg == "--filter" || arg == "--jobs" || arg == "--timeout" || arg == "--sweep" ||
                arg == "--format")) || (options.running && arg == "--ceesafe-harness") ||
            (options.building && !options.testing && arg == "--jobs")) {
            let value = match (Process.argument(a)) {
                Some(v) => v,
                null => {
                    var message = String.create();
                    message.append("option '")!;
                    message.append(arg)!;
                    message.append("' needs a value")!;
                    return fail(message.view());
                }
            };
            a += 1;
            let status = readTestOption(mut options, arg, value);
            if (status != 0) {
                return status;
            }
        } else if (options.running && arg == "--interp") {
            options.interp = true;
        } else if (options.running && arg == "--") {
            // The program's arguments.
            while (a < Process.argumentCount()) {
                options.programArguments.push(copyBytes(Process.argument(a)!.bytes())!)!;
                a += 1;
            }
        } else if (options.checking && arg == "--all") {
            options.checkAll = true;
        } else if (options.checking && arg == "--whole-program") {
            options.wholeProgram = true;
        } else if (options.checking && arg == "--record") {
            options.recordOnly = true;
        } else if (options.checking && arg == "--package") {
            match (Process.argument(a)) {
                Some(v) => { options.checkPackage = copyBytes(v.bytes())!; }
                null => { return fail("option '--package' needs a value"); }
            }
            a += 1;
        } else if (arg == "--offline") {
            options.offline = true;
        } else if (options.fixing && arg == "--dry-run") {
            options.dryRun = true;
        } else if (arg.length > 0 && arg[0] == '-') {
            var message = String.create();
            message.append("unknown option '")!;
            message.append(arg)!;
            message.append("'")!;
            return fail(message.view());
        } else {
            options.files.push(copyText(arg))!;
        }
    }
    if (options.building && !options.testing && options.jobsGiven && !options.split) {
        // Without --split the C is one compile, so a --jobs that did nothing would mislead (ADR 0082 §2.5).
        return fail("build's --jobs needs --split: without it, the C is compiled in one command");
    }
    return 0;
}

/// One of `test`'s options with its value (ADR 0049 §3.3), or `run`'s hidden `--ceesafe-harness`.
fn readTestOption(options: borrow mut Options, arg: StringView, value: StringView) -> i32 {
    if (arg == "--filter") {
        options.testFilter = copyBytes(value.bytes())!;
    } else if (arg == "--format") {
        if (value != "text" && value != "json") {
            return fail("--format is 'text' or 'json'");
        }
        options.testJson = value == "json";
    } else if (arg == "--sweep") {
        if (value != "alloc" && value != "cancel") {
            return fail("--sweep is 'alloc' or 'cancel'");
        }
        options.testSweep = if (value == "alloc") 1 else 2;
    } else if (arg == "--ceesafe-harness") {
        options.harness = copyBytes(value.bytes())!;
        options.includeTests = true;
        options.entryName = copyBytes(harnessEntry().bytes())!;
    } else {
        var n: u64 = 0;
        for (b in value.bytes()) {
            if (b < '0' || b > '9' || n > 100000000) {
                var message = String.create();
                message.append(arg)!;
                message.append(" takes a number")!;
                return fail(message.view());
            }
            n = n * 10 + (b - '0') as u64;
        }
        if (n == 0) {
            var message = String.create();
            message.append(arg)!;
            message.append(" takes a number above 0")!;
            return fail(message.view());
        }
        if (arg == "--jobs") {
            options.testJobs = truncate<u32>(n);
            options.jobsGiven = true;
        } else {
            options.testTimeout = n;
        }
    }
    return 0;
}

/// The generated harness's entry function (ADR 0049 §3.4).
fn harnessEntry() -> StringView => "ceesafeTestMain";

/// The path diagnostics name (SourceText.SourcePath, c-backend.md §7): `/` separators; an absolute path under the
/// working directory becomes relative to it, and any other absolute path is reduced to its file name.
fn sourcePath(path: StringView) -> Vector<u8> {
    var result = Vector<u8>.create();
    let host = slashedPath(path.bytes())!;
    let bytes = host.view();
    if (isRooted(bytes)) {
        match (currentDirectory()) {
            Ok(cwd) => {
                let base = cwd.view();
                if (bytes.length > base.length + 1 && sameBytes(
                    bytes[..base.length],
                    base,
                ) && bytes[base.length] == '/') {
                    appendBytes(mut result, bytes[(base.length + 1)..])!;
                    return result;
                }
            }
            Err(_) => {}
        }
        var name = bytes.length;
        while (name > 0 && bytes[name - 1] != '/') {
            name -= 1;
        }
        appendBytes(mut result, bytes[name..])!;
        return result;
    }
    for (b in bytes) {
        result.push(if (b == '\\') '/' else b)!;
    }
    return result;
}

/// Whether `path` names a CeeSafe source: the command line reads only `.cee` files, and `.c` files for the C compiler
/// (Decision 0005). 0, or the usage error's exit status.
fn requireSourceName(path: Slice<u8>) -> i32 {
    if (path.length > 4 && sameText(path[path.length - 4..], ".cee")) {
        return 0;
    }
    var message = copyBytes("'".bytes())!;
    appendBytes(mut message, path)!;
    appendText(mut message, "' is not a .cee or .c file")!;
    return fail(StringView.fromUtf8(message.view())!);
}

/// Loads each file into a source text, or returns the exit status after an error.
fn loadFiles(files: borrow Vector<String>, sources: borrow mut Vector<SourceText>) -> i32 {
    for (i in 0..files.length) {
        let status = requireSourceName(files[i].view().bytes());
        if (status != 0) {
            return status;
        }
    }
    for (i in 0..files.length) {
        let path = files[i].view();
        let bytes = match (readFile(path)) {
            Ok(b) => b,
            Err(ReadError.Io(e)) => {
                var message = String.create();
                message.append("cannot read '")!;
                message.append(path)!;
                message.append("': ")!;
                message.append(e.message())!;
                return fail(message.view());
            }
            Err(ReadError.Memory) => { return fail("out of memory"); }
        };
        let name = sourcePath(path);
        var source = SourceText.create(name.view(), bytes.view())!;
        source.diskPath = absolutePath(path.bytes());
        sources.push(source)!;
    }
    return 0;
}

/// `path` (from the working directory, or absolute) as an absolute, normalised path with `/` separators; empty if the
/// working directory is unknown (`embed` then finds no file, ADR 0087 §2.8).
fn absolutePath(path: Slice<u8>) -> Vector<u8> {
    let slashed = slashedPath(path)!;
    if (isRooted(slashed.view())) {
        return joinPath("/".bytes(), slashed.view())!;
    }
    return match (currentDirectory()) {
        Ok(cwd) => joinPath(cwd.view(), slashed.view())!,
        Err(_) => Vector<u8>.create(),
    };
}

/// A diagnostic as text with a source excerpt and caret (DiagnosticRenderer.Render).
/// `render` with the diagnostic's own source, or a placeholder when the list lacks its file (bug B6).
fn renderAny(
    out: borrow mut Vector<u8>,
    d: borrow Diagnostic,
    sources: borrow Vector<SourceText>,
) -> Result<void, AllocError> {
    if ((d.file as usize) < sources.length) {
        return render(out, d, sources[d.file as usize], sources);
    }
    let placeholder = placeholderSource(d)?;
    return render(out, d, placeholder, sources);
}

/// `sources` gives a note in another file than the diagnostic's its path (ADR 0081 §2.2).
fn render(
    out: borrow mut Vector<u8>,
    d: borrow Diagnostic,
    source: borrow SourceText,
    sources: borrow Vector<SourceText>,
) -> Result<void, AllocError> {
    let position = source.position(d.start as usize);
    appendBytes(out, source.shownPath())?;
    out.push(':')?;
    appendDecimal(out, position.line as u64)?;
    out.push(':')?;
    appendDecimal(out, position.column as u64)?;
    appendText(out, if (d.isError) ": error[" else ": warning[")?;
    appendCode(out, d.code)?;
    appendText(out, "]: ")?;
    appendBytes(out, d.message.view())?;
    out.push('\n')?;

    var gutter = Vector<u8>.create();
    appendDecimal(mut gutter, position.line as u64)?;
    let line = source.lineText(position.line as usize);
    for (k in 0..gutter.length) {
        out.push(' ')?;
    }
    appendText(out, " |\n")?;
    appendBytes(out, gutter.view())?;
    appendText(out, " | ")?;
    var shown = Vector<u8>.create();
    appendDecoded(mut shown, line)?;
    for (b in shown) {
        out.push(if (b == '\t') ' ' else b)?;
    }
    out.push('\n')?;

    // Underline the span, clipped to the first line it touches; at least one caret. Lengths are UTF-16 units.
    let lineStart = source.lineStarts[(position.line - 1) as usize] as usize;
    let lineUnits = source.utf16Length(lineStart, lineStart + line.length) as i64;
    let spanUnits = source.utf16Length(d.start as usize, d.end as usize) as i64;
    let room = lineUnits - position.column as i64 + 1;
    var underline: i64 = if (spanUnits < room) spanUnits else room;
    if (underline < 1) {
        underline = 1;
    }
    for (k in 0..gutter.length) {
        out.push(' ')?;
    }
    appendText(out, " | ")?;
    for (k in 1..position.column) {
        out.push(' ')?;
    }
    for (k in 0..underline) {
        out.push('^')?;
    }
    out.push('\n')?;
    for (note in d.notes.view()) {
        for (k in 0..gutter.length) {
            out.push(' ')?;
        }
        appendText(out, " = note: ")?;
        appendBytes(out, note.message.view())?;
        appendText(out, " (")?;
        let elsewhere = note.file != d.file && (note.file as usize) < sources.length;
        let noteSource = if (elsewhere) borrow sources[note.file as usize] else source;
        if (elsewhere) {
            appendBytes(out, noteSource.shownPath())?; // a dependency's file by its package path (ADR 0082 §2.1)
            out.push(':')?;
        }
        let at = noteSource.position(note.start as usize);
        appendDecimal(out, at.line as u64)?;
        out.push(':')?;
        appendDecimal(out, at.column as u64)?;
        appendText(out, ")\n")?;
    }
    return Ok();
}

fn parseCommand() -> i32 {
    var options = Options {
        json: false,
        dumpTokens: false,
        dumpAst: false,
        dumpHir: false,
        noFloat: false,
        denyWarnings: false,
        libraryDiagnostics: false,
        freestanding: false,
        kernel: false,
        profileGiven: false,
        building: false,
        dumpNir: false,
        closureSpecialisation: true,
        explainClosureCalls: false,
        placement: true,
        explainAllocations: false,
        explainFrames: false,
        bce: true,
        explainBoundsChecks: false,
        oce: true,
        explainOverflowChecks: false,
        structured: true,
        emit: copyBytes("exe".bytes())!,
        output: Vector<u8>.create(),
        exportsHeader: copyBytes("ceesafe_exports.h".bytes())!,
        emitGiven: false,
        lineDirectives: false,
        debug: false,
        debugAssertions: 0,
        split: false,
        programName: Vector<u8>.create(),
        cc: match (Environment.variable("CC")) {
            Some(v) => copyBytes(v.bytes())!,
            null => Vector<u8>.create(),
        },
        cflags: Vector<Vector<u8>>.create(),
        linker: Vector<u8>.create(),
        cNames: Vector<Vector<u8>>.create(),
        cTexts: Vector<Vector<u8>>.create(),
        native: NativeBuild.create(),
        entryName: copyBytes("main".bytes())!,
        testing: false,
        includeTests: false,
        harness: Vector<u8>.create(),
        testFilter: Vector<u8>.create(),
        testList: false,
        testJobs: 1,
        jobsGiven: false,
        testTimeout: 60,
        testSweep: 0,
        testSweepStrict: false,
        testJson: false,
        defaultOutput: Vector<u8>.create(),
        files: Vector<String>.create(),
        offline: false,
        running: false,
        interp: false,
        programArguments: Vector<Vector<u8>>.create(),
        absolutePaths: false,
        packageDirectories: Vector<Vector<u8>>.create(),
        fixing: false,
        dryRun: false,
        fixRound: 0,
        checking: false,
        checkAll: false,
        wholeProgram: false,
        checkPackage: Vector<u8>.create(),
        recordOnly: false,
    };
    let status = readOptions(mut options);
    if (status != 0) {
        return status;
    }
    if (options.files.length == 0) {
        // Package mode (tooling.md §4.4): the root package's sources.
        var packages = Vector<PackageInfo>.create();
        var packageFiles = Vector<Vector<Vector<u8>>>.create();
        let loaded = loadPackage(mut options, mut packages, mut packageFiles);
        if (loaded != 0) {
            return loaded;
        }
        for (f in packageFiles[0].view()) {
            options.files.push(copyText(StringView.fromUtf8(f.view())!))!;
        }
    }
    var sources = Vector<SourceText>.create();
    let loaded = loadFiles(options.files, mut sources);
    if (loaded != 0) {
        return loaded;
    }

    var front = Frontend.create();
    var dump = Vector<u8>.create();
    for (i in 0..sources.length) {
        let source = borrow sources[i];
        let file = truncate<u32>(i);
        let lexed = lex(source.text.view(), file, mut front.symbols, mut front.diagnostics)!;
        if (options.dumpTokens) {
            dumpTokens(mut dump, source, lexed, front.symbols)!;
            dumpDiagnostics(mut dump, source, file, front.diagnostics)!;
        }
        front = parseFile(file, lexed, front)!;
        if (options.dumpAst) {
            var printer = AstPrinter.create();
            printer.printUnit(front.ast, front.symbols, front.ast.units[i])!;
            appendBytes(mut dump, printer.out.view())!;
        }
    }
    Console.writeBytes(dump.view());

    let diagnostics = borrow front.diagnostics;
    if (options.json) {
        let json = diagnosticsJson(diagnostics, sources)!;
        Console.writeBytes(json.view());
        Console.writeLine("");
    } else {
        var text = Vector<u8>.create();
        for (i in 0..diagnostics.items.length) {
            let d = borrow diagnostics.items[i];
            renderAny(mut text, d, sources)!;
        }
        // Valid UTF-8: paths come from arguments, and source lines are decoded with U+FFFD.
        Console.writeError(StringView.fromUtf8(text.view())!);
    }
    return if (diagnostics.hasErrors()) 1 else 0;
}

/// Prints the diagnostics as text on stderr or as the JSON document on stdout, and returns the exit status (Report).
fn report(json: bool, diagnostics: borrow Diagnostics, sources: borrow Vector<SourceText>) -> i32 {
    if (json) {
        let document = diagnosticsJson(diagnostics, sources)!;
        Console.writeBytes(document.view());
        Console.writeLine("");
    } else {
        var text = Vector<u8>.create();
        for (i in 0..diagnostics.items.length) {
            let d = borrow diagnostics.items[i];
            renderAny(mut text, d, sources)!;
        }
        // Valid UTF-8: paths come from arguments, and source lines are decoded with U+FFFD.
        Console.writeError(StringView.fromUtf8(text.view())!);
    }
    return if (diagnostics.hasErrors()) 1 else 0;
}

/// Package mode's loading (Program.LoadPackage): the package and its dependencies, resolved through the lock, root
/// first, and their files; the root manifest's profile, float and kernel where the command line does not say
/// otherwise. Returns the exit status of a failure.
fn loadPackage(
    options: borrow mut Options,
    packages: borrow mut Vector<PackageInfo>,
    files: borrow mut Vector<Vector<Vector<u8>>>,
) -> i32 {
    let cwd = match (currentDirectory()) {
        Ok(d) => d,
        Err(_) => { return fail("cannot read the current directory"); }
    };
    let directory = match (findManifestDirectory(cwd.view())!) {
        Some(d) => d,
        null => {
            fail("no CeeSafe input files, and no ceesafe.toml here or above");
            return 1;
        }
    };
    var report = PackageReport.create();
    let noUpdate = Vector<Vector<u8>>.create();
    let resolved = resolveWorkspace(directory.view(), mut report, false, options.offline, false, noUpdate)!;
    if (report.count() > 0) {
        reportPackage(options.json, report);
    }
    let workspace = match (resolved) {
        Some(w) => w,
        null => { return 1; }
    };
    var rootFiles = Vector<Vector<u8>>.create();
    manifestSourceFiles(workspace.root, mut rootFiles)!;
    if (rootFiles.length == 0) {
        var message = String.create();
        message.append("package '")!;
        message.append(StringView.fromUtf8(workspace.root.name.view())!)!;
        message.append("' has no .cee files under ")!;
        for (k in 0..workspace.root.sources.length) {
            if (k > 0) {
                message.append(", ")!;
            }
            message.append(StringView.fromUtf8(workspace.root.sources[k].view())!)!;
        }
        fail(message.view());
        return 1;
    }
    if (!options.profileGiven) {
        options.freestanding = workspace.root.freestanding;
    }
    if (!workspace.root.floatAllowed) {
        options.noFloat = true;
    }
    if (workspace.root.kernel) {
        options.kernel = true;
    }
    if (!options.emitGiven && workspace.root.kind == 2) {
        options.emit = copyBytes("obj".bytes())!;
    }
    options.defaultOutput = joinPath(workspace.root.directory.view(), "out".bytes())!;
    options.defaultOutput.push('/')!;
    appendBytes(mut options.defaultOutput, workspace.root.name.view())!;
    if (options.programName.length == 0) {
        options.programName = copyBytes(workspace.root.name.view())!;
    }
    // The C files of every package, root first (Workspace.CFiles); a package with include directories has its own
    // compiled apart with them (ADR 0047 §3.3).
    for (p in 0..workspace.resolved.length + 1) {
        let manifest = workspace.dependentManifest(if (p == 0) none() else truncate<u32>(p - 1));
        for (c in manifest.cFiles.view()) {
            let path = joinPath(manifest.directory.view(), c.view())!;
            if (manifest.includeDirs.length > 0) {
                var includes = Vector<Vector<u8>>.create();
                for (d in manifest.includeDirs.view()) {
                    includes.push(copyBytes(d.view())!)!;
                }
                options.native.separate.push(SeparateC { path: path, includeDirs: includes })!;
                continue;
            }
            let status = addCFile(mut options, path.view());
            if (status != 0) {
                return 1;
            }
            if (addHeadersBeside(mut options, path.view()) != 0) {
                return 1;
            }
        }
    }
    collectNativeLinks(borrow workspace, mut options.native)!;
    for (p in 0..workspace.resolved.length + 1) {
        let manifest = workspace.dependentManifest(if (p == 0) none() else truncate<u32>(p - 1));
        packages.push(workspace.packageInfo(p)!)!;
        options.packageDirectories.push(copyBytes(manifest.directory.view())!)!;
        var paths = Vector<Vector<u8>>.create();
        manifestSourceFiles(manifest, mut paths)!;
        if (p == 0 && options.includeTests) {
            manifestTestFiles(manifest, mut paths)!; // the root package's tests (ADR 0049 §3.1)
        }
        files.push(paths)!;
    }
    return 0;
}

/// Package diagnostics, as text on stderr or as the JSON document on stdout.
fn reportPackage(json: bool, packageReport: borrow PackageReport) {
    report(json, packageReport.diagnostics, packageReport.sources);
}

/// `run --interp` after checking (Program.Run): the C is generated as `build` would (its diagnostics reported, the code
/// discarded), then the NIR it was made from is interpreted.
fn interpretChecked(
    options: Options,
    checker: borrow mut Checker,
    nir: borrow mut NirProgram,
    sources: borrow Vector<SourceText>,
) -> i32 {
    var files = Vector<CFile>.create();
    let build = CBuildOptions {
        requireMain: true,
        freestanding: false,
        lineDirectives: false,
        split: false,
        programName: copyBytes("program".bytes())!,
        exportsHeader: copyBytes(options.exportsHeader.view())!,
        closureSpecialisation: options.closureSpecialisation,
        placement: options.placement,
        bce: options.bce,
        oce: options.oce,
        structured: options.structured,
        debugAssertions: false,
    };
    if (!generateC(checker, nir, sources, build, mut files)!) {
        return report(options.json, checker.front.diagnostics, sources);
    }
    var user: usize = 0;
    while (user + 1 < sources.length && checker.fileIsLibrary[user]) {
        user += 1;
    }
    var arguments = Vector<Vector<u8>>.create();
    arguments.push(copyBytes(sources[user].path.view())!)!;
    for (a in options.programArguments.view()) {
        arguments.push(copyBytes(a.view())!)!;
    }
    let interpreterOptions = InterpreterOptions {
        arguments: arguments,
        failAllocationAt: environmentNumber("CEESAFE_FAIL_ALLOC_AT"),
        allocationReport: environmentNumber("CEESAFE_ALLOC_REPORT") != 0,
        placement: options.placement,
        bce: options.bce,
        oce: options.oce,
        stepLimit: 0,
        memoryLimit: 0,
        sandboxed: false,
        workingDirectory: Vector<u8>.create(),
        capture: false,
        outputLimit: 0,
        input: Vector<u8>.create(),
        debugAssertions: options.debugAssertions != 2,
    };
    return interpretProgram(checker, nir, sources, interpreterOptions)!;
}

/// A number from the environment, as ceesafe_platform_config reads it: leading digits, else 0.
fn environmentNumber(name: StringView) -> u64 {
    var value: u64 = 0;
    match (Environment.variable(name)) {
        Some(text) => {
            for (c in text.bytes()) {
                if (c < '0' || c > '9') {
                    break;
                }
                value = value.wrappingMul(10).wrappingAdd((c - '0') as u64);
            }
        }
        null => {}
    }
    return value;
}

/// The end of `check` (or of one round of `fix`): the diagnostics reported, or the fixes applied.
fn finish(
    options: borrow Options,
    diagnostics: borrow Diagnostics,
    sources: borrow Vector<SourceText>,
    inputs: borrow Vector<bool>,
) -> i32 {
    if (!options.fixing) {
        return report(options.json, diagnostics, sources);
    }
    return finishFixRound(options.json, options.dryRun, options.fixRound == 7, diagnostics, sources, inputs);
}

fn checkCommand() -> i32 => fileCommand(false, false, 0);

/// `fix` (Program.FixFiles): checks, applies every fix, writes the files and checks again, until no fix applies or
/// after 8 rounds; then reports what remains. Only the given files (or the root package's own sources) are edited.
fn fixCommand() -> i32 {
    for (round in 0..8) {
        let status = fileCommand(false, true, truncate<u32>(round));
        if (status != fixAgain()) {
            return status;
        }
    }
    return 0;
}

/// `build --dump-nir` (P4): the checks, then the NIR after drop elaboration, printed as the reference compiler prints it with the
/// optimisations turned off. Building C is P5.
fn buildCommand() -> i32 => fileCommand(true, false, 0);

/// The options of a file command before the command line is read.
fn defaultOptions(building: bool) -> Options => Options {
    json: false,
    dumpTokens: false,
    dumpAst: false,
    dumpHir: false,
    noFloat: false,
    denyWarnings: false,
    libraryDiagnostics: false,
    freestanding: false,
    kernel: false,
    profileGiven: false,
    building: building,
    dumpNir: false,
    closureSpecialisation: true,
    explainClosureCalls: false,
    placement: true,
    explainAllocations: false,
    explainFrames: false,
    bce: true,
    explainBoundsChecks: false,
    oce: true,
    explainOverflowChecks: false,
    structured: true,
    emit: copyBytes("exe".bytes())!,
    output: Vector<u8>.create(),
    exportsHeader: copyBytes("ceesafe_exports.h".bytes())!,
    emitGiven: false,
    lineDirectives: false,
    debug: false,
    debugAssertions: 0,
    split: false,
    programName: Vector<u8>.create(),
    cc: match (Environment.variable("CC")) {
        Some(v) => copyBytes(v.bytes())!,
        null => Vector<u8>.create(),
    },
    cflags: Vector<Vector<u8>>.create(),
    linker: Vector<u8>.create(),
    cNames: Vector<Vector<u8>>.create(),
    cTexts: Vector<Vector<u8>>.create(),
    native: NativeBuild.create(),
    entryName: copyBytes("main".bytes())!,
    testing: false,
    includeTests: false,
    harness: Vector<u8>.create(),
    testFilter: Vector<u8>.create(),
    testList: false,
    testJobs: 1,
    jobsGiven: false,
    testTimeout: 60,
    testSweep: 0,
    testSweepStrict: false,
    testJson: false,
    defaultOutput: Vector<u8>.create(),
    files: Vector<String>.create(),
    offline: false,
    running: false,
    interp: false,
    programArguments: Vector<Vector<u8>>.create(),
    absolutePaths: false,
    packageDirectories: Vector<Vector<u8>>.create(),
    fixing: false,
    dryRun: false,
    fixRound: 0,
    checking: false,
    checkAll: false,
    wholeProgram: false,
    checkPackage: Vector<u8>.create(),
    recordOnly: false,
};

fn runCommand() -> i32 => fileCommandIn(false, true, false, 0);

fn fileCommand(building: bool, fixing: bool, fixRound: u32) -> i32 => fileCommandIn(building, false, fixing, fixRound);

fn fileCommandIn(building: bool, running: bool, fixing: bool, fixRound: u32) -> i32 {
    var options = defaultOptions(building);
    options.running = running;
    options.fixing = fixing;
    options.includeTests = !building && !running; // `check` and `fix` check the tests too (ADR 0049 §3.1)
    options.fixRound = fixRound;
    options.checking = !building && !running && !fixing;
    let status = readOptions(mut options);
    if (status != 0) {
        return status;
    }
    if (options.checking && options.checkAll && (options.files.length > 0 || options.wholeProgram ||
        options.checkPackage.length > 0)) {
        return fail(
            "check --all checks every package of the lock: run it in a package, without files, --package or --whole-program",
        );
    }
    if (options.checking && (options.checkPackage.length > 0 || options.recordOnly) &&
        (options.files.length > 0 || options.wholeProgram)) {
        return fail("check --package and --record take a package of the lock: run them in a package, without files");
    }
    if (options.checking && options.files.length == 0 && !options.wholeProgram && !options.dumpHir &&
        !options.dumpAst && !options.dumpTokens && !options.libraryDiagnostics) {
        // Package mode: the package checked fully, its dependencies from their interface records (ADR 0082 §2.7).
        return packageCheckCommand(options);
    }
    if (running && !options.interp) {
        return fail("'run' needs --interp (the only way to run without building is the interpreter)");
    }
    // C sources go to the C compiler with the generated code (type-system.md §28.6).
    var sourceFiles = Vector<String>.create();
    for (k in 0..options.files.length) {
        let file = copyText(options.files[k].view());
        let bytes = file.view().bytes();
        if (bytes.length > 2 && bytes[bytes.length - 2] == '.' && bytes[bytes.length - 1] == 'c') {
            let added = addCFile(mut options, bytes);
            if (added != 0) {
                return added;
            }
        } else {
            sourceFiles.push(file)!;
        }
    }
    if (options.files.length > 0 && sourceFiles.length == 0) {
        return fail("no CeeSafe input files");
    }
    var packages = Vector<PackageInfo>.create();
    var packageFiles = Vector<Vector<Vector<u8>>>.create();
    if (options.files.length == 0) {
        // Package mode (tooling.md §4.4): the nearest manifest's package and its path dependencies.
        let loaded = loadPackage(mut options, mut packages, mut packageFiles);
        if (loaded != 0) {
            return loaded;
        }
    } else {
        packages.push(
            loosePackage(),
        )!;
    }
    return compileFiles(options, building, sourceFiles, packages, packageFiles);
}

/// The type checking (and with `building`, the C) of the files named, or of the packages and their files (package
/// mode); the diagnostics reported as `finish` does.
fn compileFiles(
    given: Options,
    building: bool,
    sourceFiles: borrow Vector<String>,
    packages: Vector<PackageInfo>,
    packageFiles: Vector<Vector<Vector<u8>>>,
) -> i32 {
    var options = given;
    if (options.running) {
        // The interpreter runs hosted code with floats (Program.Run's compilation).
        options.freestanding = false;
        options.noFloat = false;
        options.kernel = false;
    }
    var sources = Vector<SourceText>.create();
    var fileIsLibrary = Vector<bool>.create();
    // lib/core, then lib/std (hosted) or lib/kernel (freestanding with --kernel): library files come first
    // (CoreLibrary.SourcesFor).
    for (k in 0..libraryFileCount()) {
        let group = libraryGroup(k);
        if (group == 0 || (group == 1 && !options.freestanding) ||
            (group == 2 && options.freestanding && options.kernel)) {
            let text = libraryText(k)!;
            sources.push(SourceText.create(libraryPath(k).bytes(), text.view())!)!;
            fileIsLibrary.push(true)!;
        }
    }
    var filePackage = Vector<u32>.create();
    while (filePackage.length < sources.length) {
        filePackage.push(0xFFFFFFFF)!;
    }
    if (options.files.length > 0) {
        let loaded = loadFiles(sourceFiles, mut sources);
        if (loaded != 0) {
            return loaded;
        }
        while (filePackage.length < sources.length) {
            filePackage.push(0)!;
        }
    } else {
        for (p in 0..packageFiles.length) {
            for (f in packageFiles[p].view()) {
                let path = StringView.fromUtf8(f.view())!;
                let bytes = match (readFile(path)) {
                    Ok(b) => b,
                    Err(_) => {
                        var message = String.create();
                        message.append("cannot read '")!;
                        message.append(path)!;
                        message.append("'")!;
                        return fail(message.view());
                    }
                };
                // A dependency's file is named by its package, `alpha/src/util.cee`, and diagnostics name it by its
                // path from the working directory (ADR 0082 §2.1).
                let directory = if (p < options.packageDirectories.length) options.packageDirectories[p].view()
                    else "".bytes();
                let slashed = slashedPath(path.bytes())!;
                let inPackage = pathBelow(slashed.view(), directory)!;
                var openPath = Vector<u8>.create();
                var name = Vector<u8>.create();
                if (options.absolutePaths) {
                    name = copyBytes(path.bytes())!;
                } else if (p == 0 || inPackage.length == 0 || packages[p].name.length == 0) {
                    name = sourcePath(path);
                } else {
                    appendBytes(mut name, packages[p].name.view())!;
                    name.push('/')!;
                    appendBytes(mut name, inPackage.view())!;
                    match (currentDirectory()) {
                        Ok(cwd) => { openPath = pathFrom(cwd.view(), slashed.view())!; }
                        Err(_) => {}
                    }
                }
                var source = SourceText.create(name.view(), bytes.view())!;
                source.package = copyBytes(packages[p].name.view())!;
                source.packagePath = inPackage;
                source.openPath = openPath;
                source.diskPath = absolutePath(path.bytes());
                sources.push(source)!;
                filePackage.push(truncate<u32>(p))!;
            }
        }
        if (options.harness.length > 0) {
            // `test`'s generated harness, in the root package (ADR 0049 §3.4).
            let path = StringView.fromUtf8(options.harness.view())!;
            let bytes = match (readFile(path)) {
                Ok(b) => b,
                Err(_) => { return fail("cannot read the test harness"); }
            };
            let name = sourcePath(path);
            var source = SourceText.create(name.view(), bytes.view())!;
            source.package = copyBytes(packages[0].name.view())!;
            sources.push(source)!;
            filePackage.push(0)!;
        }
    }
    while (fileIsLibrary.length < sources.length) {
        fileIsLibrary.push(false)!;
    }
    var inputs = Vector<bool>.create(); // the files `fix` may edit: the root package's or the command line's
    for (p in filePackage.view()) {
        inputs.push(p == 0)!;
    }
    var front = Frontend.create();
    for (i in 0..sources.length) {
        let source = borrow sources[i];
        let file = truncate<u32>(i);
        let lexed = lex(source.text.view(), file, mut front.symbols, mut front.diagnostics)!;
        let marks = astMarks(front);
        front = parseFile(file, lexed, front)!;
        // PackageNames.Rewrite: a package file, rewritten while nothing has failed yet.
        if (!fileIsLibrary[i] && !front.diagnostics.hasErrors()) {
            let unit = truncate<u32>(front.ast.units.length - 1);
            rewritePackageNames(mut front, unit, packages[filePackage[i] as usize].dependencies, marks)!;
        }
    }
    if (front.diagnostics.hasErrors()) {
        return finish(options, front.diagnostics, sources, inputs);
    }
    var texts = Vector<Vector<u8>>.create();
    var paths = Vector<Vector<u8>>.create();
    var diskPaths = Vector<Vector<u8>>.create();
    for (i in 0..sources.length) {
        texts.push(copyBytes(sources[i].text.view())!)!;
        paths.push(copyBytes(sources[i].path.view())!)!;
        diskPaths.push(copyBytes(sources[i].diskPath.view())!)!;
    }
    var checker = checkProgram(
        front,
        fileIsLibrary,
        texts,
        paths,
        diskPaths,
        options.noFloat,
        options.freestanding,
        packages,
        filePackage,
        copyBytes(options.entryName.view())!,
    )!;
    if (!options.libraryDiagnostics) {
        // The reference's libraries check cleanly: what is reported in them here is a porting gap (docs/p3-plan.md S5).
        // A library function that did not check (one over `Vector` in a freestanding build) is left out of the
        // ownership analyses, which would only report the type errors' consequences in it.
        markUncheckedLibrary(mut checker);
        checker.front.diagnostics.removeFiles(checker.fileIsLibrary.view());
    }
    // The ownership analyses run on NIR, after type checking succeeded (lifetimes.md).
    var nir = NirProgram.create();
    if (!checker.front.diagnostics.hasErrors()) {
        nir = analyzeProgram(mut checker)!;
    }
    if (options.denyWarnings) {
        checker.front.diagnostics.denyWarnings();
    }
    // Warnings when nothing failed (ADR 0073 §2.4): before the work as text, after it as the JSON document. A test
    // harness's run checks the root package again, so its warnings were reported by `test`'s first step.
    let warnings = !checker.front.diagnostics.hasErrors() && checker.front.diagnostics.count(false) > 0 &&
        options.harness.length == 0 && !options.dumpHir;
    if (warnings && !options.json && (options.testing || options.running || building)) {
        report(false, checker.front.diagnostics, sources);
    }
    if (options.dumpHir && !building) {
        var printer = HirPrinter.create();
        printer.printProgram(checker.hir, checker.types, checker.front.symbols)!;
        Console.writeBytes(printer.out.view());
    }
    if (options.testing && options.harness.length == 0) {
        // `test`'s first step (ADR 0049 §3.3): the package and its tests checked, the harness written.
        if (checker.front.diagnostics.hasErrors()) {
            return report(options.json, checker.front.diagnostics, sources);
        }
        return writeHarness(options, checker, borrow sources);
    }
    if (options.running) {
        if (checker.front.diagnostics.hasErrors()) {
            return report(options.json, checker.front.diagnostics, sources);
        }
        let json = options.json;
        let status = interpretChecked(options, mut checker, mut nir, sources);
        if (warnings && json) {
            report(true, checker.front.diagnostics, sources);
        }
        return status;
    }
    if (building) {
        if (checker.front.diagnostics.hasErrors()) {
            return report(options.json, checker.front.diagnostics, sources);
        }
        // The report is of a fresh specialisation of the checked NIR, made whether or not the C uses it (§5.3).
        var closureReport = ClosureReport {
            calls: Vector<ClosureCall>.create(),
            variants: Vector<PendingVariant>.create(),
        };
        if (options.explainClosureCalls) {
            closureReport = specialiseClosures(checker, mut nir, false)!;
        }
        // The name split mode's external C names carry: --program, the package's, or the first file's.
        var programName = copyBytes(options.programName.view())!;
        if (programName.length == 0) {
            if (options.files.length > 0) {
                appendStem(mut programName, options.files[0].view().bytes())!;
            } else {
                appendText(mut programName, "program")!;
            }
        }
        // With C files, `main` may be in C (type-system.md §28.6).
        let requireMain = sameText(options.emit.view(), "exe") && options.cNames.length == 0 && !options.freestanding;
        var files = Vector<CFile>.create();
        let build = CBuildOptions {
            requireMain: requireMain,
            freestanding: options.freestanding,
            lineDirectives: options.lineDirectives,
            split: options.split,
            programName: programName,
            exportsHeader: copyBytes(options.exportsHeader.view())!,
            closureSpecialisation: options.closureSpecialisation,
            placement: options.placement,
            bce: options.bce,
            oce: options.oce,
            structured: options.structured,
            debugAssertions: options.debugAssertions == 1 ||
                (options.debugAssertions == 0 && (options.debug || options.testing)),
        };
        if (!generateC(mut checker, mut nir, sources, build, mut files)!) {
            return report(options.json, checker.front.diagnostics, sources);
        }
        var printed = Vector<u8>.create();
        if (options.dumpNir) {
            printNir(checker, nir, mut printed)!; // the NIR the C was made from (closure variants included)
        }
        if (options.explainAllocations) {
            // The decisions placement acts on unless --no-placement is given (memory-model.md §5, rule 4).
            let placement = analyzePlacement(checker, nir, sources)!;
            explainAllocations(checker, sources, placement, mut printed)!;
        }
        if (options.explainFrames) {
            explainFrames(checker, nir, sources, mut printed)!;
        }
        if (options.explainBoundsChecks) {
            // What the C backend omits unless --no-bce is given (optimisations.md §2.7).
            let checks = analyzeChecks(checker, nir)!;
            explainChecks(checker, nir, sources, checks, false, mut printed)!;
        }
        if (options.explainClosureCalls) {
            explainClosureCalls(checker, nir, sources, closureReport, mut printed)!;
        }
        if (options.explainOverflowChecks) {
            // What the C backend omits unless --no-oce is given (optimisations.md §3.4).
            let checks = analyzeChecks(checker, nir)!;
            explainChecks(checker, nir, sources, checks, true, mut printed)!;
        }
        Console.writeBytes(printed.view());
        for (k in 0..options.cNames.length) {
            var name = copyBytes("c/".bytes())!;
            appendBytes(mut name, options.cNames[k].view())!;
            files.push(CFile { name: name, text: copyBytes(options.cTexts[k].view())! })!;
        }
        var user: usize = 0;
        while (user + 1 < sources.length && checker.fileIsLibrary[user]) {
            user += 1;
        }
        let status = buildFiles(options, files, sources[user].path.view());
        if (warnings && options.json) {
            report(true, checker.front.diagnostics, sources);
        }
        return status;
    }
    return finish(options, checker.front.diagnostics, sources, inputs);
}

fn main() -> i32 {
    let argument = Process.argument(1);
    if (argument == null) {
        var out = Vector<u8>.create();
        appendUsage(mut out)!;
        Console.writeBytes(out.view());
        return 2;
    }
    let command = argument!;
    if (command == "--version") {
        Console.writeLine(compilerBanner());
        return 0;
    }
    if (command == "-h" || command == "--help") {
        var out = Vector<u8>.create();
        appendUsage(mut out)!;
        Console.writeBytes(out.view());
        return 0;
    }
    if (command == "parse") {
        return parseCommand();
    }
    if (command == "check") {
        return checkCommand();
    }
    if (command == "build") {
        return buildCommand();
    }
    if (command == "fix") {
        return fixCommand();
    }
    if (command == "run") {
        return runCommand();
    }
    if (command == "test") {
        return testCommand();
    }
    if (command == "fmt") {
        var arguments = Vector<Vector<u8>>.create();
        var json = false;
        let status = plainArguments(mut arguments, mut json);
        if (status != 0) {
            return status;
        }
        return fmtCommand(arguments, json);
    }
    if (command == "fetch" || command == "publish" || command == "index-check" || command == "new" ||
        command == "agents") {
        var arguments = Vector<Vector<u8>>.create();
        var json = false;
        let status = plainArguments(mut arguments, mut json);
        if (status != 0) {
            return status;
        }
        if (command == "fetch") {
            return fetchCommand(arguments, json);
        }
        if (command == "publish") {
            return publishCommand(arguments, json);
        }
        if (command == "index-check") {
            return indexCheckCommand(arguments, json);
        }
        if (command == "new") {
            return newCommand(arguments);
        }
        return agentsCommand(arguments);
    }
    if (command == "doc") {
        var arguments = Vector<Vector<u8>>.create();
        var json = false;
        let status = plainArguments(mut arguments, mut json);
        if (status != 0) {
            return status;
        }
        return docCommand(arguments, json);
    }
    if (command == "lsp") {
        return lspCommand();
    }
    if (command == "mcp") {
        return mcpCommand();
    }
    if (command == "explain") {
        var arguments = Vector<Vector<u8>>.create();
        var json = false;
        let status = plainArguments(mut arguments, mut json);
        if (status != 0) {
            return status;
        }
        return explainCommand(arguments);
    }
    match (phaseOf(command)) {
        Some(phase) => {
            var message = String.create();
            message.append("'")!;
            message.append(command)!;
            message.append("' is not implemented yet (ROADMAP ")!;
            message.append(phase)!;
            message.append(")")!;
            return fail(message.view());
        }
        null => {
            var message = String.create();
            message.append("unknown command '")!;
            message.append(command)!;
            message.append("'")!;
            return fail(message.view());
        }
    }
}

/// A C file for the C compiler: its name and text; two files may not share a name.
/// The libraries and library directories of every package, in link order (ADR 0047 §3.2): packages dependents first
/// (by their longest path from the root), a package's entries in its manifest's order; a library named again keeps
/// its last place, a directory its first.
fn collectNativeLinks(workspace: borrow Workspace, native: borrow mut NativeBuild) -> Result<void, AllocError> {
    let count = workspace.resolved.length + 1;
    var depth = Vector<u32>.create();
    for (k in 0..count) {
        depth.push(0)?;
    }
    for (round in 0..count) {
        for (p in 0..count) {
            let manifest = workspace.dependentManifest(if (p == 0) none() else truncate<u32>(p - 1));
            for (d in manifest.dependencies.view()) {
                for (q in 1..count) {
                    let other = workspace.dependentManifest(truncate<u32>(q - 1));
                    if (sameBytes(
                        other.name.view(),
                        d.name.view(),
                    ) && depth[q] < depth[p] + 1 && (depth[p] as usize) < count) {
                        depth[q] = depth[p] + 1;
                    }
                }
            }
        }
    }
    var links = Vector<Vector<u8>>.create();
    for (level in 0..count) {
        for (p in 0..count) {
            if (depth[p] as usize != level) {
                continue;
            }
            let manifest = workspace.dependentManifest(if (p == 0) none() else truncate<u32>(p - 1));
            for (l in manifest.links.view()) {
                links.push(copyBytes(l.view())?)?;
            }
            for (d in manifest.libDirs.view()) {
                var seen = false;
                for (x in native.libDirs.view()) {
                    seen = seen || sameBytes(x.view(), d.view());
                }
                if (!seen) {
                    native.libDirs.push(copyBytes(d.view())?)?;
                }
            }
        }
    }
    for (k in 0..links.length) {
        var later = false;
        for (j in (k + 1)..links.length) {
            later = later || sameBytes(links[j].view(), links[k].view());
        }
        if (!later) {
            native.links.push(copyBytes(links[k].view())?)?;
        }
    }
    return Ok();
}

fn addCFile(options: borrow mut Options, path: Slice<u8>) -> i32 {
    var name = Vector<u8>.create();
    var start = path.length;
    while (start > 0 && path[start - 1] != '/' && path[start - 1] != '\\') { // a Windows path's own separator too
        start -= 1;
    }
    appendBytes(mut name, path[start..])!;
    for (other in options.cNames.view()) {
        if (sameBytes(other.view(), name.view())) {
            var message = copyBytes("two C files are named '".bytes())!;
            appendBytes(mut message, name.view())!;
            message.push('\'')!;
            return failBytes(message.view());
        }
    }
    let text = match (readFile(StringView.fromUtf8(path)!)) {
        Ok(t) => t,
        Err(_) => {
            var message = copyBytes("cannot read '".bytes())!;
            appendBytes(mut message, path)!;
            message.push('\'')!;
            return failBytes(message.view());
        }
    };
    options.cNames.push(name)!;
    options.cTexts.push(text)!;
    return 0;
}

/// The headers beside a package's C file go with it into the build's `c/` directory (ADR 0075 §2.16), so its
/// `#include "x.h"` finds them, in `--emit c`'s output too. Two different headers of one name are an error; the same
/// header twice (two C files of one directory) is copied once.
fn addHeadersBeside(options: borrow mut Options, path: Slice<u8>) -> i32 {
    var end = path.length;
    while (end > 0 && path[end - 1] != '/' && path[end - 1] != '\\') {
        end -= 1;
    }
    var directory = Vector<u8>.create();
    appendBytes(mut directory, if (end > 0) path[0..(end - 1)] else ".".bytes())!;
    let names = match (Directory.list(StringView.fromUtf8(directory.view())!)) {
        Ok(found) => found,
        Err(_) => { return 0; }
    };
    for (name in names.view()) {
        let bytes = name.view().bytes();
        if (bytes.length < 3 || bytes[bytes.length - 2] != '.' || bytes[bytes.length - 1] != 'h') {
            continue;
        }
        var full = Vector<u8>.create();
        appendBytes(mut full, directory.view())!;
        full.push('/')!;
        appendBytes(mut full, bytes)!;
        let text = match (readFile(StringView.fromUtf8(full.view())!)) {
            Ok(t) => t,
            Err(_) => { continue; }
        };
        var known = false;
        for (k in 0..options.cNames.length) {
            if (sameBytes(options.cNames[k].view(), bytes)) {
                if (!sameBytes(options.cTexts[k].view(), text.view())) {
                    var message = copyBytes("two different C headers are named '".bytes())!;
                    appendBytes(mut message, bytes)!;
                    message.push('\'')!;
                    return failBytes(message.view());
                }
                known = true;
            }
        }
        if (!known) {
            options.cNames.push(copyBytes(bytes)!)!;
            options.cTexts.push(text)!;
        }
    }
    return 0;
}

/// The library functions with an error inside their syntax (Checker.uncheckedLibrary), before the libraries'
/// diagnostics are dropped.
fn markUncheckedLibrary(c: borrow mut Checker) {
    for (f in 0..c.hir.functions.length) {
        c.uncheckedLibrary.push(false)!;
        let function = borrow c.hir.functions[f];
        let file = function.file;
        if (file == none() || !c.fileIsLibrary[file as usize] || function.syntax == none() || function.isClosure) {
            continue;
        }
        let syntax = borrow c.front.ast.functions[function.syntax as usize];
        for (d in c.front.diagnostics.items.view()) {
            if (d.isError && d.file == file && d.start >= syntax.start && d.start < syntax.end) {
                c.uncheckedLibrary[f] = true;
                break;
            }
        }
    }
}
