// The NLL borrow checker of docs/lifetimes.md on one NIR function (the reference's Analysis/BorrowChecker.cs): loans
// and points-to sets (§3), accesses and conflicts (§4), liveness (§5), temporaries (§6), and returned references (§7).
// Diagnostics are reported in the reference's order, which follows the iteration order of its .NET sets: points-to
// sets only grow, so they keep insertion order; live sets also lose members, so they are kept as .NET's HashSet keeps
// its entries (NetSet).

fn writeWhileBorrowed() -> u32 => 240;
fn conflictingBorrow() -> u32 => 241;
fn readWhileMutablyBorrowed() -> u32 => 242;
fn deadWhileBorrowed() -> u32 => 243;
fn returnsLocalReference() -> u32 => 244;
fn foreignLoanStored() -> u32 => 272;

// Access kinds (AccessKind).
fn accessRead() -> u32 => 0;
fn accessWrite() -> u32 => 1;
fn accessBorrowShared() -> u32 => 2;
fn accessBorrowMut() -> u32 => 3;
fn accessDead() -> u32 => 4;
fn accessMove() -> u32 => 5; // a move out of a place: invalidates it like a write (type-system.md §14.3)

/// A place as a local and its projections (NirProgram.projections), so a bare local needs no arena entry.
struct PlaceRef {
    local: u32;
    projections: Range;
}

struct Access {
    kind: u32;
    place: PlaceRef;
}

/// A loan (Loan). `hasPlace` is false for the placeholder of a reference parameter.
struct Loan {
    isMutable: bool;
    hasPlace: bool;
    /// A reference parameter (not a view) has two placeholders (ADR 0074 §2.4): the loan of the reference itself
    /// (`outer`), and the loans of what it refers to. A value read through the reference carries only the second.
    outer: bool;
    place: PlaceRef;
    block: u32; // a block position, or none for a placeholder
    index: u32;
    span: Span;
    parameterIndex: u32; // a placeholder's parameter, else none
}

/// A write of a value that may hold loans through the reference (or reference-holding value) `holder` (§25.7 rules
/// 2–4): the loans also reach what the holder's mutable loans point to (ThroughWrite).
struct ThroughWrite {
    holder: u32;
    sources: Vector<u32>;
    /// By source: the parameter whose outer placeholder it does not carry (a deep flow's source, ADR 0131), or none.
    drops: Vector<u32>;
    shared: bool;
    span: Span;
}

struct LoanEdge {
    from: u32;
    to: u32;
    dropOuter: u32; // a parameter whose outer placeholder the edge does not carry (ADR 0074 §2.4), or none
}

/// A set of locals that enumerates as .NET's HashSet<T> does: entries in slot order, a removed entry's slot reused
/// first by the next add (its free list is a stack).
struct NetSet {
    values: Vector<u32>;
    used: Vector<bool>;
    free: Vector<u32>;

    fn create() -> NetSet =>
        NetSet { values: Vector<u32>.create(), used: Vector<bool>.create(), free: Vector<u32>.create() };

    fn slotOf(borrow this, value: u32) -> usize {
        for (k in 0..this.values.length) {
            if (this.used[k] && this.values[k] == value) {
                return k;
            }
        }
        return this.values.length;
    }

    fn contains(borrow this, value: u32) -> bool => this.slotOf(value) < this.values.length;

    fn add(borrow mut this, value: u32) -> Result<void, AllocError> {
        if (this.contains(value)) {
            return Ok();
        }
        if (this.free.length > 0) {
            let slot = this.free.pop()!;
            this.values[slot as usize] = value;
            this.used[slot as usize] = true;
            return Ok();
        }
        this.values.push(value)?;
        return this.used.push(true);
    }

    fn remove(borrow mut this, value: u32) -> Result<void, AllocError> {
        let slot = this.slotOf(value);
        if (slot < this.values.length) {
            this.used[slot] = false;
            this.free.push(truncate<u32>(slot))?;
        }
        return Ok();
    }

    /// The members in enumeration order.
    fn members(borrow this) -> Result<Vector<u32>, AllocError> {
        var out = Vector<u32>.create();
        for (k in 0..this.values.length) {
            if (this.used[k]) {
                out.push(this.values[k])?;
            }
        }
        return Ok(out);
    }

    fn setEquals(borrow this, other: borrow NetSet) -> bool {
        var count: usize = 0;
        for (k in 0..this.values.length) {
            if (this.used[k]) {
                count += 1;
                if (!other.contains(this.values[k])) {
                    return false;
                }
            }
        }
        var otherCount: usize = 0;
        for (k in 0..other.values.length) {
            if (other.used[k]) {
                otherCount += 1;
            }
        }
        return count == otherCount;
    }
}

struct Borrows {
    function: u32;
    file: u32;
    parameterCount: u32;
    loans: Vector<Loan>;
    pointsTo: Vector<Vector<u32>>;     // by local: its loans in insertion order
    pointsToBits: Vector<Vector<u64>>; // by local: membership, sized when every loan is known
    loanAt: Vector<Vector<u32>>;       // by block position and statement: the loan made there, or none
    throughWrites: Vector<ThroughWrite>;
    unclassified: bool; // a built-in that builtinLoans does not name was met
    blockOf: Vector<u32>;          // block id to position
    reached: Vector<Vector<bool>>; // by loan: the blocks reachable from where it is made, once asked
    holders: Vector<u64>;          // (scope site << 32) | local: a spawned child's environment (ADR 0033 §3.2)
}

/// A scope's children hold what their environments captured until the scope returns (type-system.md §40.5, ADR 0033
/// §3.2): each spawn's environment is a holder, used by its scope's wait and never ended by being made again, so its
/// loans (every iteration's: points-to sets only grow) stay live from the spawn until the wait. A child copies its
/// environment when it starts, so the environment's own storage needs to outlive only the spawn.
fn collectHolders(c: borrow Checker, n: borrow NirProgram, b: borrow mut Borrows) -> Result<void, AllocError> {
    let function = borrow n.functions[b.function as usize];
    for (block in function.blocks.view()) {
        for (s in block.statements.view()) {
            let r = statementRvalue(n, s);
            if (r == none() || builtinOf(n, r) != bfAsyncSpawn()) {
                continue;
            }
            let site = constArgument(n, r, 0);
            let child = operandPlace(n, n.at(builtinArguments(n, r), 2));
            if (site == none() || child == none()) {
                continue;
            }
            // The child operand is a reference to the environment (`t = &env.code`): the environment holds the loans.
            let childLocal = n.places[child as usize].local;
            var holder = childLocal;
            for (other in function.blocks.view()) {
                for (d in other.statements.view()) {
                    match (n.statements[d as usize]) {
                        NirStatement.Assign(target, value) => {
                            if (n.places[target as usize].local == childLocal &&
                                n.places[target as usize].projections.count == 0) {
                                match (n.rvalues[value as usize]) {
                                    NirRvalue.Ref(_, place) => { holder = n.places[place as usize].local; }
                                    _ => {}
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            if (holdsLoans(c, n, b, holder)) {
                b.holders.push(((site as u64) << 32) | (holder as u64))?;
            }
        }
    }
    return Ok();
}

fn isHolder(b: borrow Borrows, local: u32) -> bool {
    for (h in b.holders.view()) {
        if (truncate<u32>(h & 0xFFFFFFFF) == local) {
            return true;
        }
    }
    return false;
}

/// The holders a scope's start ends: those of its own children.
fn holdersStartedBy(
    n: borrow NirProgram,
    b: borrow Borrows,
    s: u32,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    let r = statementRvalue(n, s);
    if (r == none() || builtinOf(n, r) != bfAsyncScopeStart()) {
        return Ok();
    }
    let site = constArgument(n, r, 0);
    for (h in b.holders.view()) {
        if (truncate<u32>(h >> 32) == site) {
            out.push(truncate<u32>(h & 0xFFFFFFFF))?;
        }
    }
    return Ok();
}

/// The holders a statement uses: those of the scope it waits for, if it is a scope's wait.
fn holdersUsedBy(
    n: borrow NirProgram,
    b: borrow Borrows,
    s: u32,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    let r = statementRvalue(n, s);
    if (r == none() || builtinOf(n, r) != bfAsyncScopeWait()) {
        return Ok();
    }
    let site = constArgument(n, r, 0);
    for (h in b.holders.view()) {
        if (truncate<u32>(h >> 32) == site) {
            out.push(truncate<u32>(h & 0xFFFFFFFF))?;
        }
    }
    return Ok();
}

fn toPlaceRef(n: borrow NirProgram, place: u32) -> PlaceRef =>
    PlaceRef { local: n.places[place as usize].local, projections: n.places[place as usize].projections };

fn barePlace(local: u32) -> PlaceRef => PlaceRef { local: local, projections: Range { start: 0, count: 0 } };

fn localType(n: borrow NirProgram, b: borrow Borrows, local: u32) -> u32 =>
    n.functions[b.function as usize].locals[local as usize].typ;

/// A local that may hold loans (IsReference): of a scoped type, or in generic code of a type that mentions a type
/// parameter (§25.7 rule 5).
fn holdsLoans(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, local: u32) -> bool =>
    mayHoldLoans(c, localType(n, b, local));

fn holdsScoped(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, local: u32) -> bool =>
    c.types.isScoped(localType(n, b, local));

fn isReferenceType(c: borrow Checker, typ: u32) -> bool => c.types.is(typ, TypeKind.Reference);

fn isMutableReferenceType(c: borrow Checker, typ: u32) -> bool =>
    c.types.is(typ, TypeKind.Reference) && c.types.info(typ).mutableReference;

fn placeRefType(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, p: PlaceRef) -> u32 {
    var typ = localType(n, b, p.local);
    for (k in 0..p.projections.count) {
        typ = applyNirProjection(c, typ, n.projections[(p.projections.start + k) as usize]);
    }
    return typ;
}

/// Does the place go through a reference (DerefsReference)? A box deref does not: the box owns what it points to.
fn derefsReference(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, p: PlaceRef) -> bool {
    var typ = localType(n, b, p.local);
    for (k in 0..p.projections.count) {
        let projection = n.projections[(p.projections.start + k) as usize];
        if (isDerefProjectionN(projection) && isReferenceType(c, typ)) {
            return true;
        }
        typ = applyNirProjection(c, typ, projection);
    }
    return false;
}

/// Is `written` a proper prefix of `loaned`, with a reference on the loaned path after it (ReferenceOnTheWay)? The
/// write replaces a reference on the way, and the loaned object is beyond it (lifetimes.md §5, M11).
fn referenceOnTheWay(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    written: PlaceRef,
    loaned: PlaceRef,
) -> bool {
    if (written.local != loaned.local || written.projections.count >= loaned.projections.count) {
        return false;
    }
    var typ = localType(n, b, loaned.local);
    for (k in 0..loaned.projections.count) {
        let projection = n.projections[(loaned.projections.start + k) as usize];
        if (k >= written.projections.count && isDerefProjectionN(projection) && isReferenceType(c, typ)) {
            return true;
        }
        typ = applyNirProjection(c, typ, projection);
    }
    return false;
}

fn constantIndex(n: borrow NirProgram, operand: u32) -> bool => match (n.operands[operand as usize]) {
    NirOperand.Const(_) => true,
    _ => false,
};

fn constantValue(n: borrow NirProgram, operand: u32) -> IntValue => match (n.operands[operand as usize]) {
    NirOperand.Const(v) => v,
    _ => intValue(0),
};

/// Two fields of one union of an imported C struct or union (ADR 0041 §3.2).
fn sameUnion(c: borrow Checker, x: u32, y: u32) -> bool {
    if (x == none() || y == none()) {
        return false;
    }
    let group = c.types.fields[x as usize].unionGroup;
    return group != none() && group == c.types.fields[y as usize].unionGroup;
}

/// Same root, and one projection list is a prefix of the other (elements at different constant indices excepted).
/// Two members of one C union overlap too.
fn overlap(c: borrow Checker, n: borrow NirProgram, a: PlaceRef, b: PlaceRef) -> bool {
    if (a.local != b.local) {
        return false;
    }
    let common = if (a.projections.count < b.projections.count) a.projections.count else b.projections.count;
    for (k in 0..common) {
        let x = n.projections[(a.projections.start + k) as usize];
        let y = n.projections[(b.projections.start + k) as usize];
        if (projectionKindIndex(x.kind) != projectionKindIndex(y.kind)) {
            return false;
        }
        let same = match (x.kind) {
            // The members of one C union share storage: one place (ADR 0041 §3.2).
            ProjectionKind.Field => x.field == y.field || sameUnion(c, x.field, y.field),
            ProjectionKind.Downcast => x.variant == y.variant,
            // Two different constant indices name different elements (M13 G5, lifetimes.md §8).
            ProjectionKind.Index => !(constantIndex(n, x.index) && constantIndex(n, y.index) &&
                !sameIntValue(constantValue(n, x.index), constantValue(n, y.index))),
            _ => true,
        };
        if (!same) {
            return false;
        }
    }
    return true;
}

fn projectionKindIndex(k: ProjectionKind) -> u32 => match (k) {
    ProjectionKind.Field => 0,
    ProjectionKind.Deref => 1,
    ProjectionKind.Downcast => 2,
    ProjectionKind.Index => 3,
};

fn sameIntValue(a: IntValue, b: IntValue) -> bool =>
    a.magnitude == b.magnitude && (a.negative == b.negative || a.magnitude == 0);

fn conflicts(loan: borrow Loan, access: u32) -> bool =>
    loan.isMutable || access == accessWrite() || access == accessBorrowMut() || access == accessDead() ||
        access == accessMove();

// ---- §3 Loans and points-to sets ----

fn addLoan(b: borrow mut Borrows, loan: Loan) -> Result<u32, AllocError> {
    b.loans.push(loan)?;
    return Ok(truncate<u32>(b.loans.length - 1));
}

fn loansContain(b: borrow Borrows, local: u32, loan: u32) -> bool {
    let bits = borrow b.pointsToBits[local as usize];
    let word = (loan / 64) as usize;
    return word < bits.length && (bits[word] >> ((loan % 64) as u64)) & 1 == 1;
}

/// Adds `loan` to `local`'s points-to set; whether it was new.
fn addPointsTo(b: borrow mut Borrows, local: u32, loan: u32) -> Result<bool, AllocError> {
    if (loansContain(b, local, loan)) {
        return Ok(false);
    }
    let word = (loan / 64) as usize;
    while (b.pointsToBits[local as usize].length <= word) {
        b.pointsToBits[local as usize].push(0)?;
    }
    b.pointsToBits[local as usize][word] = b.pointsToBits[local as usize][word] | (1u64 << ((loan % 64) as u64));
    b.pointsTo[local as usize].push(loan)?;
    return Ok(true);
}

fn addEdge(edges: borrow mut Vector<LoanEdge>, from: u32, to: u32) -> Result<void, AllocError> =>
    edges.push(LoanEdge { from: from, to: to, dropOuter: none() });

/// An edge that carries what parameter `parameter` refers to, not the loan of the parameter itself (ADR 0074 §2.4).
fn addDeepEdge(edges: borrow mut Vector<LoanEdge>, from: u32, to: u32, parameter: u32) -> Result<void, AllocError> =>
    edges.push(LoanEdge { from: from, to: to, dropOuter: parameter });

/// Does the parameter have two placeholders, its own loan and its referent's (ADR 0074 §2.4)? A reference parameter
/// that is not a view: a view's loans are those of the data it views.
fn hasOuterPlaceholder(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, local: u32) -> bool {
    if (local >= b.parameterCount) {
        return false;
    }
    let t = localType(n, b, local);
    return isReferenceType(c, t) && !c.types.isSlice(t) && !c.types.isStringView(t);
}

/// The reference parameter a place reads through first (`(*p)…`), if it has an outer placeholder; none otherwise.
fn throughParameter(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, p: PlaceRef) -> u32 =>
    if (p.projections.count > 0 && isDerefProjectionN(n.projections[p.projections.start as usize]) &&
        hasOuterPlaceholder(c, n, b, p.local)) p.local else none();

/// Does the place, after its first projection, go through another reference? Then what it names is not stored in
/// what its root refers to (ADR 0074 §2.4).
fn beyondReference(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, p: PlaceRef) -> bool {
    if (p.projections.count == 0) {
        return false;
    }
    var typ = applyNirProjection(c, localType(n, b, p.local), n.projections[p.projections.start as usize]);
    for (k in 1..p.projections.count) {
        let projection = n.projections[(p.projections.start + k) as usize];
        if (isDerefProjectionN(projection) && isReferenceType(c, typ)) {
            return true;
        }
        typ = applyNirProjection(c, typ, projection);
    }
    return false;
}

/// The loan-carrying locals an operand list reads (Carriers): those of operands whose value may hold loans.
fn carriers(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    operands: borrow Vector<u32>,
) -> Result<Vector<u32>, AllocError> {
    var out = Vector<u32>.create();
    for (o in operands.view()) {
        match (n.operands[o as usize]) {
            NirOperand.Place(place, _) => {
                let local = n.places[place as usize].local;
                if (mayHoldLoans(
                    c,
                    n.operandTypes[o as usize],
                ) && holdsLoans(c, n, b, local) && !containsU32(out, local)) {
                    out.push(local)?;
                }
            }
            _ => {}
        }
    }
    return Ok(out);
}

fn recordWrite(
    b: borrow mut Borrows,
    edges: borrow mut Vector<LoanEdge>,
    holder: u32,
    sources: Vector<u32>,
    throughReference: bool,
    shared: bool,
    span: Span,
) -> Result<void, AllocError> {
    if (sources.length == 0) {
        return Ok();
    }
    var drops = Vector<u32>.create();
    for (source in sources.view()) {
        addEdge(edges, source, holder)?;
        drops.push(none())?;
    }
    if (throughReference) {
        b.throughWrites.push(
            ThroughWrite { holder: holder, sources: sources, drops: drops, shared: shared, span: span },
        )?;
    }
    return Ok();
}

/// Is there an edge that carries at least what one from `from` to `to` without `dropOuter`'s outer placeholder does?
fn hasEdgeDropping(edges: borrow Vector<LoanEdge>, from: u32, to: u32, dropOuter: u32) -> bool {
    for (edge in edges.view()) {
        if (edge.from == from && edge.to == to && (edge.dropOuter == dropOuter || edge.dropOuter == none())) {
            return true;
        }
    }
    return false;
}

// ---- What each built-in does with loans (type-system.md §25.7 rule 3, ADR 0131 §2.12) ----

/// A built-in the table below does not name: ceesafec's own defect, reported where the built-in is used.
fn loansUnclassified() -> u32 => 0;
/// Stores nothing; its result carries the loans of the operands it reads (what a reference operand refers to
/// holds, for a result that is not a reference, slice or view).
fn loansRead() -> u32 => 1;
/// Writes its other operands through its first (`push`, `insert`, `extend`, `resize`, `fill`, `copyFrom`).
fn loansStoreThroughFirst() -> u32 => 2;
/// Exchanges what its two operands refer to (`swap`; `replace` is a swap with a temporary): each is written
/// through the other.
fn loansExchange() -> u32 => 3;
/// Writes through, or makes a value from, a raw pointer: no loan is followed (§27.1), the caller's `unsafe` answers.
fn loansRaw() -> u32 => 4;
/// A call through a function value, a closure or a C function pointer: its result carries every argument's loans,
/// and a closure's what its captures hold; it stores nothing, since a function type carries no flows (§36.1).
fn loansCall() -> u32 => 5;

/// The class of every built-in, each named: a new one is unclassified until it is added here, and a program that
/// uses it does not check (collectWrites).
fn builtinLoans(f: u32) -> u32 {
    if (f == bfVectorPush() || f == bfStableVectorPush() || f == bfSlotMapInsert() || f == bfVectorExtend()
        || f == bfVectorResize() || f == bfSliceFill() || f == bfSliceCopy()) {
        return loansStoreThroughFirst();
    }
    if (f == bfSwap() || f == bfReplace()) {
        return loansExchange();
    }
    if (f == bfPtrWrite() || f == bfPtrWriteVolatile() || f == bfPtrWriteUnaligned() || f == bfVectorAdopt()
        || f == bfBoxFromRaw() || f == bfSliceFromRaw()) {
        return loansRaw();
    }
    if (f == bfCallFunction() || f == bfCallClosure() || f == bfCallPointer()) {
        return loansCall();
    }
    if (f == bfConsoleWrite() || f == bfConsoleWriteLine() || f == bfProcessExit() || f == bfBoxCreate()
        || f == bfFailAfter() || f == bfFailReset() || f == bfArenaCreate() || f == bfArenaAlloc()
        || f == bfArenaAllocArray() || f == bfArenaReset() || f == bfFixedBufferOver() || f == bfScratchEnter()
        || f == bfScratchNest() || f == bfPoolCreate() || f == bfPoolTake() || f == bfVectorCreate()
        || f == bfVectorWithCapacity() || f == bfVectorPop() || f == bfVectorClear() || f == bfVectorTruncate()
        || f == bfVectorRetain() || f == bfVectorCapacity() || f == bfStringAppend() || f == bfSlotMapGet()
        || f == bfSlotMapRemove() || f == bfSlotMapContains() || f == bfSlotMapLength() || f == bfFileOpen()
        || f == bfFileCreate() || f == bfFileRemove() || f == bfResourceRead() || f == bfResourceWrite()
        || f == bfConsoleRead() || f == bfConsoleWriteBytes() || f == bfConsoleWriteError()
        || f == bfConsoleWriteErrorLine() || f == bfTcpListen() || f == bfTcpPort() || f == bfTcpAccept()
        || f == bfTcpConnect() || f == bfTcpShutdownWrite() || f == bfIoErrorMessage() || f == bfArgumentCount()
        || f == bfArgument() || f == bfProcessRun() || f == bfPtrRead() || f == bfPtrAdd() || f == bfPtrSub()
        || f == bfPtrOffset() || f == bfPtrIsNull() || f == bfSlicePtr() || f == bfStringViewFromUtf8()
        || f == bfSliceSwap() || f == bfStringAppendNumber() || f == bfFloatBits() || f == bfFloatFromBits()
        || f == bfFloatSqrt() || f == bfFloatAbs() || f == bfFloatFloor() || f == bfFloatCeil()
        || f == bfFloatMin() || f == bfFloatMax() || f == bfWrappingAdd() || f == bfWrappingSub()
        || f == bfWrappingMul() || f == bfCheckedAdd() || f == bfCheckedSub() || f == bfCheckedMul()
        || f == bfSaturatingAdd() || f == bfSaturatingSub() || f == bfSaturatingMul()
        || f == bfPtrReadVolatile() || f == bfSpinHint() || f == bfPtrPlace() || f == bfLayoutOf()
        || f == bfOffsetOf() || f == bfCallerAddress() || f == bfTargetIsX8664() || f == bfTargetIsAArch64()
        || f == bfTargetPointerBits() || f == bfBoxIntoRaw() || f == bfThreadSpawn() || f == bfThreadJoin()
        || f == bfThreadSpawnBoxed() || f == bfThreadBoth() || f == bfTcpSetNoDelay()
        || f == bfTcpSetKeepAlive() || f == bfTcpSetSendBuffer() || f == bfTcpSetRecvBuffer()
        || f == bfTcpSetLinger() || f == bfTcpShutdownRead() || f == bfIntMin() || f == bfIntMax()
        || f == bfIntAbs() || f == bfIntUnsignedAbs() || f == bfIntRotateLeft() || f == bfIntRotateRight()
        || f == bfIntWrappingShl() || f == bfIntWrappingShr() || f == bfIntLeadingZeros()
        || f == bfIntTrailingZeros() || f == bfIntCountOnes() || f == bfIntByteSwap() || f == bfVectorReserve()
        || f == bfAssert() || f == bfPanic() || f == bfFileOpenReadWrite() || f == bfFileOpenOrCreate()
        || f == bfFileCreateNew() || f == bfFileReadAt() || f == bfFileWriteAt() || f == bfFileSyncData()
        || f == bfFileSyncAll() || f == bfFileLength() || f == bfFileSetLength() || f == bfFileOpenAppend()
        || f == bfFileOpenRegular() || f == bfDebugAssert() || f == bfVariantIndex() || f == bfVectorSetLength()
        || f == bfVectorRelease() || f == bfIntMulHigh() || f == bfPtrReadUnaligned()
        || f == bfTcpListenerShutdown()) {
        return loansRead();
    }
    // The async built-ins (src/check/async.cee): a child owns what it captures (§40.4), so none stores a loan, and a
    // join's result carries what its operands hold.
    if (f == bfAsyncPark() || f == bfAsyncSpawn() || f == bfAsyncScopeWait() || f == bfAsyncJoin() ||
        f == bfAsyncJoinResult() || f == bfAsyncBlocking() || f == bfAsyncBoxed() || f == bfAsyncScopeStart() ||
        f == bfAsyncWorkers() || f == bfAsyncRunWorkers() || f == bfAsyncSetSpawn() || f == bfAsyncSetAllocator()) {
        return loansRead();
    }
    return loansUnclassified();
}

fn operandPlaceLocal(n: borrow NirProgram, operand: u32) -> u32 {
    let place = operandPlace(n, operand);
    return if (place == none()) none() else n.places[place as usize].local;
}

/// A write of operand `source` through the reference (or slice) local `receiver`. A source that is itself a
/// reference or a slice gives what it refers to holds, not its own loan: its elements or its referent are what is
/// copied in (`extend`, `copyFrom`, `swap`), so the receiver does not come to borrow the source.
fn storeThrough(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow mut Borrows,
    edges: borrow mut Vector<LoanEdge>,
    references: borrow Vector<u32>,
    throughs: borrow Vector<u32>,
    receiver: u32,
    source: u32,
    shared: bool,
    span: Span,
) -> Result<void, AllocError> {
    let given = operandPlaceLocal(n, source);
    if (given == none() || !mayHoldLoans(c, n.operandTypes[source as usize]) || !holdsLoans(c, n, b, given)) {
        return Ok();
    }
    // What the receiver refers to must be able to hold a loan: bytes copied into a `Vector<u8>` bring none.
    let receiverType = localType(n, b, receiver);
    if (isReferenceType(c, receiverType) && !mayHoldLoans(c, c.types.info(receiverType).pointee)) {
        return Ok();
    }
    if (isReferenceType(c, n.operandTypes[source as usize]) && !c.types.isStringView(n.operandTypes[source as usize])) {
        var deep = Vector<LoanEdge>.create();
        deepSourceEdge(c, n, b, mut deep, references, throughs, given, receiver, 0)?;
        var sources = Vector<u32>.create();
        var drops = Vector<u32>.create();
        for (edge in deep.view()) {
            edges.push(LoanEdge { from: edge.from, to: edge.to, dropOuter: edge.dropOuter })?;
            sources.push(edge.from)?;
            drops.push(edge.dropOuter)?;
        }
        if (sources.length > 0) {
            b.throughWrites.push(
                ThroughWrite { holder: receiver, sources: sources, drops: drops, shared: shared, span: span },
            )?;
        }
        return Ok();
    }
    var sources = Vector<u32>.create();
    sources.push(given)?;
    return recordWrite(b, edges, receiver, sources, true, shared, span);
}

/// Writes that store loans somewhere other than a fresh local (CollectWrites, §25.7 rules 1–4): into a place of a
/// local, through a reference, into a collection, or into a `borrow mut` argument of a call.
fn collectWrites(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow mut Borrows,
    s: u32,
    edges: borrow mut Vector<LoanEdge>,
    references: borrow Vector<u32>,
    throughs: borrow Vector<u32>,
) -> Result<void, AllocError> {
    let span = n.statementSpans[s as usize];
    let value = match (n.statements[s as usize]) {
        NirStatement.Assign(_, v) => v,
        NirStatement.Eval(v) => v,
        _ => none(),
    };
    if (value == none()) {
        return Ok();
    }
    // Rule 1/2: a value stored into a place that is not a whole local.
    match (n.statements[s as usize]) {
        NirStatement.Assign(target, _) => {
            let t = toPlaceRef(n, target);
            if (t.projections.count > 0 && mayHoldLoans(c, placeRefType(c, n, b, t))) {
                var operands = Vector<u32>.create();
                rvalueOperands(n, value, mut operands)?;
                let sources = carriers(c, n, b, operands)?;
                let through = derefsReference(c, n, b, t);
                recordWrite(b, edges, t.local, sources, through, false, span)?;
            }
        }
        _ => {}
    }
    match (n.rvalues[value as usize]) {
        // A closure whose body stores what it captures through one of its captures (`() => into.keep(v)`): the
        // statements are the enclosing function's, so the store is too, where the closure is made (§36.2, ADR 0131).
        // The capture that is written through receives the loans of every other capture.
        NirRvalue.Aggregate(fields) => {
            let made = match (n.statements[s as usize]) {
                NirStatement.Assign(target, _) => closureOfEnvironment(c, n, b, n.places[target as usize].local),
                _ => none(),
            };
            if (made != none()) {
                for (k in c.hir.functions[made as usize].captureStores.view()) {
                    if (k + 1 >= fields.count) {
                        continue;
                    }
                    let receiver = operandPlaceLocal(n, n.at(fields, k + 1));
                    if (receiver == none()) {
                        continue;
                    }
                    var operands = Vector<u32>.create();
                    for (j in 1..fields.count) {
                        if (j != k + 1) {
                            operands.push(n.at(fields, j))?;
                        }
                    }
                    let sources = carriers(c, n, b, operands)?;
                    recordWrite(b, edges, receiver, sources, true, false, span)?;
                }
            }
        }
        // Rule 3: a built-in that writes stores what it is given through its receiver. Every built-in is classified
        // (builtinLoans): one that is not is ceesafec's defect, said here and not passed over.
        NirRvalue.Builtin(function, arguments) => {
            let effect = builtinLoans(function);
            if (effect == loansUnclassified()) {
                b.unclassified = true;
            } else if (effect == loansStoreThroughFirst() && arguments.count > 0) {
                let receiver = operandPlaceLocal(n, n.at(arguments, 0));
                if (receiver != none()) {
                    for (k in 1..arguments.count) {
                        storeThrough(
                            c,
                            n,
                            b,
                            edges,
                            references,
                            throughs,
                            receiver,
                            n.at(arguments, k),
                            function == bfStableVectorPush(),
                            span,
                        )?;
                    }
                }
            } else if (effect == loansExchange() && arguments.count == 2) {
                let first = operandPlaceLocal(n, n.at(arguments, 0));
                let second = operandPlaceLocal(n, n.at(arguments, 1));
                if (first != none() && second != none()) {
                    storeThrough(c, n, b, edges, references, throughs, first, n.at(arguments, 1), false, span)?;
                    storeThrough(c, n, b, edges, references, throughs, second, n.at(arguments, 0), false, span)?;
                }
            }
        }
        // Rule 4: a call may store an argument's loans through a `borrow mut` argument (§25.6 flows).
        NirRvalue.Call(callee, arguments) => {
            let count = c.hir.functions[callee as usize].mutableFlows.length;
            for (k in 0..count) {
                let flow = c.hir.functions[callee as usize].mutableFlows[k];
                let target = flowTarget(flow);
                let source = flowSource(flow);
                if (target < arguments.count && source < arguments.count) {
                    let receiver = operandPlaceLocal(n, n.at(arguments, target));
                    let given = operandPlaceLocal(n, n.at(arguments, source));
                    if (receiver != none() && given != none() && flowIsDeep(flow)) {
                        // A deep flow stores what the source argument refers to holds, as a deep result carries it
                        // (ADR 0131): not the loan of the argument itself.
                        var deep = Vector<LoanEdge>.create();
                        deepSourceEdge(c, n, b, mut deep, references, throughs, given, receiver, 0)?;
                        var sources = Vector<u32>.create();
                        var drops = Vector<u32>.create();
                        for (edge in deep.view()) {
                            edges.push(LoanEdge { from: edge.from, to: edge.to, dropOuter: edge.dropOuter })?;
                            sources.push(edge.from)?;
                            drops.push(edge.dropOuter)?;
                        }
                        if (sources.length > 0) {
                            b.throughWrites.push(
                                ThroughWrite {
                                    holder: receiver,
                                    sources: sources,
                                    drops: drops,
                                    shared: false,
                                    span: span,
                                },
                            )?;
                        }
                    } else if (receiver != none()) {
                        var operands = Vector<u32>.create();
                        operands.push(n.at(arguments, source))?;
                        let sources = carriers(c, n, b, operands)?;
                        recordWrite(b, edges, receiver, sources, true, false, span)?;
                    }
                }
            }
        }
        _ => {}
    }
    return Ok();
}

/// The closure whose environment local `local` is, when it is one (a HIR function), or none.
fn closureOfEnvironment(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, local: u32) -> u32 {
    let t = localType(n, b, local);
    let definition = c.types.info(t).structDef;
    if (definition == none() || !c.types.structs[definition as usize].isClosureEnvironment) {
        return none();
    }
    for (k in 0..c.hir.functions.length) {
        if (c.hir.functions[k].closureEnvironment == t) {
            return truncate<u32>(k);
        }
    }
    return none();
}

/// A closure's body, checked: the captures through which it stores what its environment holds (HirFunction.
/// captureStores), for the function that makes the closure (collectWrites). A write through a place reached through
/// the environment's field `k + 1` (a captured `borrow mut`, or a local captured by mutable reference) that stores
/// a loan the environment gave: another capture's, since a closure's own parameter stored so is N0272 in its body.
fn noteCaptureStores(c: borrow mut Checker, n: borrow NirProgram, b: borrow Borrows) -> Result<void, AllocError> {
    let source = n.functions[b.function as usize].source;
    let environment = c.hir.functions[source as usize].closureEnvironment;
    if (environment == none()) {
        return Ok();
    }
    let definition = c.types.info(environment).structDef;
    var found = Vector<u32>.create();
    for (write in b.throughWrites.view()) {
        var given = false;
        for (k in 0..write.sources.length) {
            for (id in b.pointsTo[write.sources[k] as usize].view()) {
                let loan = borrow b.loans[id as usize];
                if ((loan.hasPlace && loan.place.local == 0) || (!loan.hasPlace && loan.parameterIndex == 0)) {
                    given = true;
                }
            }
        }
        if (!given) {
            continue;
        }
        for (id in b.pointsTo[write.holder as usize].view()) {
            let loan = borrow b.loans[id as usize];
            if (!loan.hasPlace || loan.place.local != 0 || loan.place.projections.count < 2) {
                continue;
            }
            let second = n.projections[(loan.place.projections.start + 1) as usize];
            for (k in 1..c.types.structs[definition as usize].fields.length) {
                if (c.types.structs[definition as usize].fields[k] == second.field &&
                    !containsU32(found, truncate<u32>(k - 1))) {
                    found.push(truncate<u32>(k - 1))?;
                }
            }
        }
    }
    // A value assigned to a place reached through a capture (`into.text = v`, `into = Holder { text: v }`).
    for (block in n.functions[b.function as usize].blocks.view()) {
        for (statement in block.statements.view()) {
            match (n.statements[statement as usize]) {
                NirStatement.Assign(target, value) => {
                    let t = toPlaceRef(n, target);
                    if (t.local != 0 || t.projections.count < 3 || !mayHoldLoans(c, placeRefType(c, n, b, t))) {
                        continue;
                    }
                    var operands = Vector<u32>.create();
                    rvalueOperands(n, value, mut operands)?;
                    let sources = carriers(c, n, b, operands)?;
                    var given = false;
                    for (local in sources.view()) {
                        for (id in b.pointsTo[local as usize].view()) {
                            let loan = borrow b.loans[id as usize];
                            if ((loan.hasPlace && loan.place.local == 0) ||
                                (!loan.hasPlace && loan.parameterIndex == 0)) {
                                given = true;
                            }
                        }
                    }
                    if (!given) {
                        continue;
                    }
                    let second = n.projections[(t.projections.start + 1) as usize];
                    for (k in 1..c.types.structs[definition as usize].fields.length) {
                        if (c.types.structs[definition as usize].fields[k] == second.field &&
                            !containsU32(found, truncate<u32>(k - 1))) {
                            found.push(truncate<u32>(k - 1))?;
                        }
                    }
                }
                _ => {}
            }
        }
    }
    c.hir.functions[source as usize].captureStores = found;
    return Ok();
}

/// LoanEdge.dropOuter for an edge that carries no parameter's own loan (its outer placeholder), whichever it is.
fn everyOuter() -> u32 => 0xFFFFFFFE;

fn propagate(b: borrow mut Borrows, edges: borrow Vector<LoanEdge>) -> Result<void, AllocError> {
    var changed = true;
    while (changed) {
        changed = false;
        for (edge in edges.view()) {
            if (edge.from == edge.to) {
                continue;
            }
            let count = b.pointsTo[edge.from as usize].length;
            for (k in 0..count) {
                let loan = b.pointsTo[edge.from as usize][k];
                if (edge.dropOuter != none() && b.loans[loan as usize].outer &&
                    (edge.dropOuter == everyOuter() || b.loans[loan as usize].parameterIndex == edge.dropOuter)) {
                    continue;
                }
                if (addPointsTo(b, edge.to, loan)?) {
                    changed = true;
                }
            }
        }
    }
    return Ok();
}

fn hasEdge(edges: borrow Vector<LoanEdge>, from: u32, to: u32) -> bool {
    for (edge in edges.view()) {
        if (edge.from == from && edge.to == to) {
            return true;
        }
    }
    return false;
}

fn computeLoans(c: borrow Checker, n: borrow NirProgram, b: borrow mut Borrows) -> Result<void, AllocError> {
    // Placeholder loans for reference parameters.
    for (i in 0..b.parameterCount) {
        if (holdsLoans(c, n, b, i)) {
            let isMutable = isMutableReferenceType(c, localType(n, b, i));
            let outer = hasOuterPlaceholder(c, n, b, i);
            let loan = addLoan(
                b,
                Loan {
                    isMutable: isMutable,
                    hasPlace: false,
                    outer: outer,
                    place: barePlace(i),
                    block: none(),
                    index: none(),
                    span: Span { start: 0, end: 0 },
                    parameterIndex: i,
                },
            )?;
            addPointsTo(b, i, loan)?;
            if (outer) {
                let deep = addLoan(
                    b,
                    Loan {
                        isMutable: isMutable,
                        hasPlace: false,
                        outer: false,
                        place: barePlace(i),
                        block: none(),
                        index: none(),
                        span: Span { start: 0, end: 0 },
                        parameterIndex: i,
                    },
                )?;
                addPointsTo(b, i, deep)?;
            }
        }
    }
    var edges = Vector<LoanEdge>.create();
    let references = referenceDefinitions(n, b)?;
    let throughs = throughDefinitions(c, n, b)?;
    let blockCount = n.functions[b.function as usize].blocks.length;
    for (position in 0..blockCount) {
        let statementCount = n.functions[b.function as usize].blocks[position].statements.length;
        for (i in 0..statementCount) {
            let s = n.functions[b.function as usize].blocks[position].statements[i];
            collectWrites(c, n, b, s, mut edges, references, throughs)?;
            var assignTarget: u32 = none();
            var assignValue: u32 = none();
            match (n.statements[s as usize]) {
                NirStatement.Unpack(source, _, targets) => {
                    let sourceLocal = n.places[source as usize].local;
                    if (holdsLoans(c, n, b, sourceLocal)) {
                        // The payloads of a scoped result carry its loans (lifetimes.md §3, M4a).
                        for (k in 0..targets.count) {
                            let payload = n.at(targets, k);
                            if (payload != none() && holdsLoans(c, n, b, payload)) {
                                addEdge(mut edges, sourceLocal, payload)?;
                            }
                        }
                        continue;
                    }
                }
                NirStatement.Assign(target, value) => {
                    assignTarget = target;
                    assignValue = value;
                }
                _ => {}
            }
            if (assignTarget == none()) {
                continue;
            }
            let t = toPlaceRef(n, assignTarget);
            if (t.projections.count != 0 || !holdsLoans(c, n, b, t.local)) {
                continue;
            }
            let span = n.statementSpans[s as usize];
            var loanPlace: u32 = none();
            var loanMutable = false;
            match (n.rvalues[assignValue as usize]) {
                NirRvalue.Ref(mutable, place) => {
                    loanPlace = place;
                    loanMutable = mutable;
                }
                NirRvalue.Slice(mutable, base, _, _) => {
                    loanPlace = base;
                    loanMutable = mutable;
                }
                _ => {}
            }
            if (loanPlace != none()) {
                // A slice is a loan of the whole array or slice it views (type-system.md §16.3).
                let place = toPlaceRef(n, loanPlace);
                let loan = addLoan(
                    b,
                    Loan {
                        isMutable: loanMutable,
                        hasPlace: true,
                        outer: false,
                        place: place,
                        block: truncate<u32>(position),
                        index: truncate<u32>(i),
                        span: span,
                        parameterIndex: none(),
                    },
                )?;
                b.loanAt[position][i] = loan;
                addPointsTo(b, t.local, loan)?;
                // A reborrow through q, or a borrow of a scoped value of q, keeps q's loans alive while the new
                // reference lives.
                if (holdsLoans(c, n, b, place.local) &&
                    (derefsReference(c, n, b, place) || mayHoldLoans(c, placeRefType(c, n, b, place)))) {
                    let through = throughParameter(c, n, b, place);
                    if (through != none() && beyondReference(c, n, b, place)) {
                        // A borrow of what a reference stored in the parameter's referent points to.
                        addDeepEdge(mut edges, place.local, t.local, through)?;
                    } else {
                        addEdge(mut edges, place.local, t.local)?;
                    }
                }
                continue;
            }
            match (n.rvalues[assignValue as usize]) {
                NirRvalue.Call(callee, arguments) => {
                    let count = c.hir.functions[callee as usize].returnSources.length;
                    for (k in 0..count) {
                        let index = c.hir.functions[callee as usize].returnSources[k];
                        if (index < arguments.count) {
                            let argument = operandPlace(n, n.at(arguments, index));
                            if (argument == none()) {
                                continue;
                            }
                            let local = n.places[argument as usize].local;
                            if (containsU32(c.hir.functions[callee as usize].deepSources, index)) {
                                deepSourceEdge(c, n, b, mut edges, references, throughs, local, t.local, 0)?;
                            } else if (holdsLoans(c, n, b, local)) {
                                addEdge(mut edges, local, t.local)?;
                            }
                        }
                    }
                    continue;
                }
                _ => {}
            }
            // Copies, moves, payload reads, aggregates and built-in results take the loans of every scoped value
            // they read. A region allocation borrows only from its region (argument 0), and the allocated value's
            // loans are the allocation's too (§19.5, §25.4).
            var sources = Vector<u32>.create();
            var builtIn = false;
            // A built-in that gives a value of a type parameter's type gives what its operand holds (an element, a
            // payload, what a pointer reads), never a borrow of the operand's own storage: its result is not a
            // reference, a slice or a view, the only things a built-in borrows into. A call through a function value
            // or a closure is not such a built-in: its result may borrow from anything it was given (ADR 0131).
            var stored = false;
            // A closure's result may hold what the closure's captures hold, not a borrow of the closure itself
            // (§36.2): its first operand, the closure, is a deep source.
            var closureCall = false;
            match (n.rvalues[assignValue as usize]) {
                NirRvalue.Builtin(function, arguments) => {
                    builtIn = true;
                    closureCall = function == bfCallClosure();
                    stored = !holdsScoped(c, n, b, t.local) && function != bfCallClosure() &&
                        function != bfCallFunction() && function != bfCallPointer();
                    if (function == bfArenaAlloc()) {
                        sources.push(n.at(arguments, 0))?;
                        sources.push(n.at(arguments, 1))?;
                    } else if (function == bfArenaAllocArray()) {
                        sources.push(n.at(arguments, 0))?;
                    } else {
                        rvalueOperands(n, assignValue, mut sources)?;
                    }
                }
                _ => { rvalueOperands(n, assignValue, mut sources)?; }
            }
            for (o in sources.view()) {
                let place = operandPlace(n, o);
                if (place == none()) {
                    continue;
                }
                let p = toPlaceRef(n, place);
                // A value whose type mentions a type parameter carries its loans as a scoped value does (§25.7
                // rule 5, ADR 0131).
                if (holdsLoans(c, n, b, p.local) &&
                    (mayHoldLoans(c, n.operandTypes[o as usize]) || derefsReference(c, n, b, p))) {
                    // A value read through a reference parameter carries what its referent holds, not the
                    // parameter's own loan (ADR 0074 §2.4).
                    let through = throughParameter(c, n, b, p);
                    if (through != none()) {
                        addDeepEdge(mut edges, p.local, t.local, through)?;
                    } else if (closureCall && o == sources[0] && p.projections.count == 0 &&
                        !hasOuterPlaceholder(c, n, b, p.local) && references[p.local as usize] == none()) {
                        // A copy of a reference to a closure: every loan it holds but a parameter's own.
                        edges.push(LoanEdge { from: p.local, to: t.local, dropOuter: everyOuter() })?;
                    } else if ((stored || (closureCall && o == sources[0])) && p.projections.count == 0 &&
                        isReferenceType(c, localType(n, b, p.local)) &&
                        !c.types.isSlice(localType(n, b, p.local)) && !c.types.isStringView(localType(n, b, p.local))) {
                        deepSourceEdge(c, n, b, mut edges, references, throughs, p.local, t.local, 0)?;
                    } else if ((!builtIn || stored) && readsThroughLocalReference(c, n, b, p)) {
                        // A value read through a local reference carries what that reference's referent holds, as
                        // a deep result does: not the reference's own loan (a `for` over a field's elements or over
                        // an iterator field reads its items so). A built-in's result may point into what it was
                        // given (a region's allocation), so it keeps every loan of the reference.
                        deepSourceEdge(c, n, b, mut edges, references, throughs, p.local, t.local, 0)?;
                    } else {
                        addEdge(mut edges, p.local, t.local)?;
                    }
                }
            }
        }
    }
    // Writes through references reach what the references' loans point to, which depends on the loans computed so
    // far: iterate until nothing changes (§25.7 rule 2).
    while (true) {
        propagate(b, edges)?;
        var added = false;
        for (w in 0..b.throughWrites.length) {
            let holder = b.throughWrites[w].holder;
            let shared = b.throughWrites[w].shared;
            let loanCount = b.pointsTo[holder as usize].length;
            for (k in 0..loanCount) {
                let loan = borrow b.loans[b.pointsTo[holder as usize][k] as usize];
                if (!loan.hasPlace || !(loan.isMutable || shared)) {
                    continue;
                }
                let to = loan.place.local;
                for (j in 0..b.throughWrites[w].sources.length) {
                    let source = b.throughWrites[w].sources[j];
                    let dropOuter = b.throughWrites[w].drops[j];
                    if (!hasEdgeDropping(edges, source, to, dropOuter)) {
                        edges.push(LoanEdge { from: source, to: to, dropOuter: dropOuter })?;
                        added = true;
                    }
                }
            }
        }
        if (!added) {
            break;
        }
    }
    return Ok();
}

/// The place each local is defined to borrow (`t = &p` or `t = &mut p`, its only assignment), or none.
fn referenceDefinitions(n: borrow NirProgram, b: borrow Borrows) -> Result<Vector<u32>, AllocError> {
    var places = Vector<u32>.create();
    var assigned = Vector<u32>.create();
    for (k in 0..n.functions[b.function as usize].locals.length) {
        places.push(none())?;
        assigned.push(0)?;
    }
    for (block in n.functions[b.function as usize].blocks.view()) {
        for (s in block.statements.view()) {
            match (n.statements[s as usize]) {
                NirStatement.Assign(target, value) => {
                    let local = n.places[target as usize].local;
                    assigned[local as usize] += 1;
                    if (n.places[target as usize].projections.count == 0) {
                        match (n.rvalues[value as usize]) {
                            NirRvalue.Ref(_, place) => { places[local as usize] = place; }
                            _ => {}
                        }
                    }
                }
                NirStatement.Unpack(_, _, targets) => {
                    for (k in 0..targets.count) {
                        let payload = n.at(targets, k);
                        if (payload != none()) {
                            assigned[payload as usize] += 1;
                        }
                    }
                }
                _ => {}
            }
        }
    }
    for (k in 0..places.length) {
        if (assigned[k] != 1 || k < b.parameterCount as usize) {
            places[k] = none();
        }
    }
    return Ok(places);
}

/// The argument local each local is defined to pass through (its only assignment is `t = f(…)` with a result that
/// passes through that argument, `resultThrough`, B18), or none.
fn throughDefinitions(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows) -> Result<Vector<u32>, AllocError> {
    var locals = Vector<u32>.create();
    var assigned = Vector<u32>.create();
    for (k in 0..n.functions[b.function as usize].locals.length) {
        locals.push(none())?;
        assigned.push(0)?;
    }
    for (block in n.functions[b.function as usize].blocks.view()) {
        for (s in block.statements.view()) {
            match (n.statements[s as usize]) {
                NirStatement.Assign(target, value) => {
                    let local = n.places[target as usize].local;
                    assigned[local as usize] += 1;
                    if (n.places[target as usize].projections.count == 0) {
                        match (n.rvalues[value as usize]) {
                            NirRvalue.Call(callee, arguments) => {
                                let index = c.hir.functions[callee as usize].resultThrough;
                                if (index != none() && index < arguments.count) {
                                    let argument = operandPlace(n, n.at(arguments, index));
                                    if (argument != none() && n.places[argument as usize].projections.count == 0) {
                                        locals[local as usize] = n.places[argument as usize].local;
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                NirStatement.Unpack(_, _, targets) => {
                    for (k in 0..targets.count) {
                        let payload = n.at(targets, k);
                        if (payload != none()) {
                            assigned[payload as usize] += 1;
                        }
                    }
                }
                _ => {}
            }
        }
    }
    for (k in 0..locals.length) {
        if (assigned[k] != 1 || k < b.parameterCount as usize) {
            locals[k] = none();
        }
    }
    return Ok(locals);
}

/// A deep result's loans from its argument (ADR 0074 §2.4): what the argument refers to holds, not the argument's own
/// loan. For `t = &p`, the loans of `p`'s local (less its outer placeholder, when `p` is reached through a reference
/// parameter); for a reference parameter, its loans less its outer placeholder; for `t = f(a)` whose result passes
/// through `a` (B18), what `a` refers to holds, as a deep source of its own; otherwise all the argument's loans.
fn deepSourceEdge(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    edges: borrow mut Vector<LoanEdge>,
    references: borrow Vector<u32>,
    throughs: borrow Vector<u32>,
    argument: u32,
    result: u32,
    depth: u32,
) -> Result<void, AllocError> {
    if (hasOuterPlaceholder(c, n, b, argument)) {
        return addDeepEdge(edges, argument, result, argument);
    }
    let borrowed = references[argument as usize];
    if (borrowed == none()) {
        let through = throughs[argument as usize];
        if (through != none() && through != argument && depth < 64) {
            return deepSourceEdge(c, n, b, edges, references, throughs, through, result, depth + 1);
        }
        return if (holdsLoans(c, n, b, argument)) addEdge(edges, argument, result) else Ok();
    }
    let place = toPlaceRef(n, borrowed);
    if (!holdsLoans(c, n, b, place.local)) {
        return Ok();
    }
    let through = throughParameter(c, n, b, place);
    if (through != none()) {
        return addDeepEdge(edges, place.local, result, through);
    }
    if (readsThroughLocalReference(c, n, b, place) && place.local != argument && depth < 64) {
        // `t = &(*x).f` for a local reference `x`: what `t` refers to is part of what `x` refers to, so it holds no
        // more than that does.
        return deepSourceEdge(c, n, b, edges, references, throughs, place.local, result, depth + 1);
    }
    return addEdge(edges, place.local, result);
}

/// Is the place `(*x)…` for a reference `x` (a view too), with no other reference on the way? What it names is then
/// stored in what `x` refers to (ADR 0074 §2.4).
fn readsThroughLocalReference(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, p: PlaceRef) -> bool =>
    p.projections.count > 0 && isDerefProjectionN(n.projections[p.projections.start as usize]) &&
        isReferenceType(c, localType(n, b, p.local)) && !beyondReference(c, n, b, p);

/// The parameter index if the place starts with a deref of a reference parameter; none otherwise (DerefOfParameter).
fn derefOfParameter(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, p: PlaceRef) -> u32 =>
    if (p.local < b.parameterCount && holdsLoans(c, n, b, p.local) && p.projections.count > 0 &&
        isDerefProjectionN(n.projections[p.projections.start as usize])) p.local else none();

fn loanOrigin(c: borrow Checker, n: borrow NirProgram, b: borrow Borrows, loan: borrow Loan) -> u32 =>
    if (!loan.hasPlace) loan.parameterIndex else derefOfParameter(c, n, b, loan.place);

fn appendLocalNameOr(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    local: u32,
    fallback: StringView,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    let name = n.functions[b.function as usize].locals[local as usize].name;
    if (name == none()) {
        return appendText(out, fallback);
    }
    return appendBytes(out, c.name(name));
}

/// N0272 (§25.7 rule 2): a write that reaches memory a `borrow mut` parameter refers to may only store loans of
/// parameters that the signature lets flow into that parameter (CheckParameterWrites).
fn checkParameterWrites(c: borrow mut Checker, n: borrow NirProgram, b: borrow Borrows) -> Result<void, AllocError> {
    let source = n.functions[b.function as usize].source;
    var reported = Vector<u64>.create();
    for (write in b.throughWrites.view()) {
        var targets = Vector<u32>.create();
        for (id in b.pointsTo[write.holder as usize].view()) {
            let loan = borrow b.loans[id as usize];
            if (!(loan.isMutable || write.shared)) {
                continue;
            }
            let p = loanOrigin(c, n, b, loan);
            if (p != none() && isMutableReferenceType(c, localType(n, b, p)) && !containsU32(targets, p)) {
                targets.push(p)?;
            }
        }
        if (targets.length == 0) {
            continue;
        }
        var stored = Vector<u32>.create();
        for (k in 0..write.sources.length) {
            for (id in b.pointsTo[write.sources[k] as usize].view()) {
                let dropped = write.drops[k] != none() && b.loans[id as usize].outer &&
                    b.loans[id as usize].parameterIndex == write.drops[k];
                if (!dropped && !containsU32(stored, id)) {
                    stored.push(id)?;
                }
            }
        }
        for (target in targets.view()) {
            var foreign: u32 = none();
            for (id in stored.view()) {
                let storedLoan = borrow b.loans[id as usize];
                let from = loanOrigin(c, n, b, storedLoan);
                // What the target's referent already holds may go back into it (ADR 0075 §8): its deep placeholder,
                // never the loan of the reference itself.
                let ownContents = !storedLoan.hasPlace && !storedLoan.outer && from == target;
                let flow = (target as u64) << 32 | from as u64;
                // Through a deep flow only what the source's referent holds may be stored (ADR 0131): not the loan
                // of the reference itself, nor a borrow of its referent's own storage.
                let itself = if (storedLoan.hasPlace) !beyondReference(c, n, b, storedLoan.place) else storedLoan.outer;
                let allowed = from != none() && (containsU64(c.hir.functions[source as usize].mutableFlows, flow) ||
                    (!itself && containsU64(c.hir.functions[source as usize].mutableFlows, flow | deepFlowBit())));
                if (!ownContents && !allowed) {
                    foreign = id;
                    break;
                }
            }
            if (foreign == none()) {
                continue;
            }
            // One call may write the same loan to a target by two of its flows: one report.
            let key = (write.span.start as u64) << 32 | foreign as u64;
            if (containsU64(reported, key)) {
                break;
            }
            reported.push(key)?;
            let loan = borrow b.loans[foreign as usize];
            var name = Vector<u8>.create();
            appendLocalNameOr(c, n, b, target, "?", mut name)?;
            var message = Vector<u8>.create();
            appendText(mut message, "this stores a value borrowed from ")?;
            var notes = Vector<DiagnosticNote>.create();
            if (!loan.hasPlace) {
                appendText(mut message, "parameter '")?;
                appendLocalNameOr(c, n, b, loan.parameterIndex, "?", mut message)?;
                appendText(mut message, "'")?;
            } else {
                appendQuotedPlace(c, n, b, loan.place, mut message)?;
                var note = Vector<u8>.create();
                appendText(mut note, "borrowed here")?;
                notes.push(DiagnosticNote { file: b.file, start: loan.span.start, end: loan.span.end, message: note })?;
            }
            appendText(mut message, " into what '")?;
            appendBytes(mut message, name.view())?;
            appendText(
                mut message,
                "' refers to, which outlives this call; the signature must let it flow there, e.g. with a shared region: 'fn f<region r>(",
            )?;
            appendBytes(mut message, name.view())?;
            appendText(mut message, ": borrow mut X<r>, v: Y<r>)' (type-system.md §25.6)")?;
            if (c.hir.functions[source as usize].keepsInterfaceFlows) {
                appendText(
                    mut message,
                    "; the interface's method declares no such flow, so a caller through the interface would not know of the borrow: give the interface a type parameter for the stored type (type-system.md §21.1)",
                )?;
            } else {
                let targetType = localType(n, b, target);
                if (isReferenceType(c, targetType)) {
                    appendSendHint(c, c.types.info(targetType).pointee, mut message)?;
                }
            }
            c.front.diagnostics.errorWithNotes(
                foreignLoanStored(),
                b.file,
                write.span.start,
                write.span.end,
                message,
                notes,
            )?;
            break;
        }
    }
    return Ok();
}

/// The static whose address local `local` holds (`local = StaticAddress(s)`, §39.2), or none.
fn addressedStatic(n: borrow NirProgram, b: borrow Borrows, local: u32) -> u32 {
    let function = borrow n.functions[b.function as usize];
    for (block in function.blocks.view()) {
        for (s in block.statements.view()) {
            match (n.statements[s as usize]) {
                NirStatement.Assign(target, value) => {
                    if (n.places[target as usize].local == local && n.places[target as usize].projections.count == 0) {
                        match (n.rvalues[value as usize]) {
                            NirRvalue.StaticAddress(index) => { return index; }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
    }
    return none();
}

/// N0272 (§39.3, ADR 0067): a static outlives every loan, so a write into one (a `static mut`, the only kind that can
/// be written) may store no loan at all; only static data, such as a string literal, may go there.
fn checkStaticWrites(c: borrow mut Checker, n: borrow NirProgram, b: borrow Borrows) -> Result<void, AllocError> {
    for (write in b.throughWrites.view()) {
        let index = addressedStatic(n, b, write.holder);
        if (index == none()) {
            continue;
        }
        var stored: u32 = none();
        for (s in write.sources.view()) {
            if (b.pointsTo[s as usize].length > 0) {
                stored = b.pointsTo[s as usize][0];
                break;
            }
        }
        if (stored == none()) {
            continue;
        }
        let loan = borrow b.loans[stored as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "this stores a value borrowed from ")?;
        var notes = Vector<DiagnosticNote>.create();
        if (!loan.hasPlace) {
            appendText(mut message, "parameter '")?;
            appendLocalNameOr(c, n, b, loan.parameterIndex, "?", mut message)?;
            appendText(mut message, "'")?;
        } else {
            appendQuotedPlace(c, n, b, loan.place, mut message)?;
            var note = Vector<u8>.create();
            appendText(mut note, "borrowed here")?;
            notes.push(DiagnosticNote { file: b.file, start: loan.span.start, end: loan.span.end, message: note })?;
        }
        appendText(mut message, " into static '")?;
        appendBytes(mut message, c.name(c.hir.statics[index as usize].name))?;
        appendText(
            mut message,
            "', which outlives every borrow; a static may hold only static data, such as a string literal (type-system.md §39.3)",
        )?;
        c.front.diagnostics.errorWithNotes(
            foreignLoanStored(),
            b.file,
            write.span.start,
            write.span.end,
            message,
            notes,
        )?;
    }
    return Ok();
}

fn containsU64(values: borrow Vector<u64>, value: u64) -> bool {
    for (v in values.view()) {
        if (v == value) {
            return true;
        }
    }
    return false;
}

// ---- §4 Accesses ----

fn operandAccess(n: borrow NirProgram, operand: u32, out: borrow mut Vector<Access>) -> Result<void, AllocError> {
    if (operand == none()) {
        return Ok();
    }
    match (n.operands[operand as usize]) {
        NirOperand.Place(place, isMove) => {
            out.push(Access { kind: if (isMove) accessMove() else accessRead(), place: toPlaceRef(n, place) })?;
        }
        _ => {}
    }
    return Ok();
}

fn operandsAccess(n: borrow NirProgram, operands: Range, out: borrow mut Vector<Access>) -> Result<void, AllocError> {
    for (k in 0..operands.count) {
        operandAccess(n, n.at(operands, k), out)?;
    }
    return Ok();
}

fn rvalueAccesses(n: borrow NirProgram, rvalue: u32, out: borrow mut Vector<Access>) -> Result<void, AllocError> {
    match (n.rvalues[rvalue as usize]) {
        NirRvalue.Use(o) => { operandAccess(n, o, out)?; }
        NirRvalue.Binary(_, l, r) => {
            operandAccess(n, l, out)?;
            operandAccess(n, r, out)?;
        }
        NirRvalue.Unary(_, o) => { operandAccess(n, o, out)?; }
        NirRvalue.Cast(o) => { operandAccess(n, o, out)?; }
        NirRvalue.Truncate(o) => { operandAccess(n, o, out)?; }
        NirRvalue.FloatToInt(o, _) => { operandAccess(n, o, out)?; }
        NirRvalue.Aggregate(fields) => { operandsAccess(n, fields, out)?; }
        NirRvalue.Call(_, arguments) => { operandsAccess(n, arguments, out)?; }
        NirRvalue.Builtin(_, arguments) => { operandsAccess(n, arguments, out)?; }
        NirRvalue.Ref(mutable, place) => {
            out.push(
                Access { kind: if (mutable) accessBorrowMut() else accessBorrowShared(), place: toPlaceRef(n, place) },
            )?;
        }
        NirRvalue.Slice(mutable, base, low, high) => {
            operandAccess(n, low, out)?;
            operandAccess(n, high, out)?;
            out.push(
                Access { kind: if (mutable) accessBorrowMut() else accessBorrowShared(), place: toPlaceRef(n, base) },
            )?;
        }
        NirRvalue.Length(place) => { out.push(Access { kind: accessRead(), place: toPlaceRef(n, place) })?; }
        NirRvalue.Array(elements) => { operandsAccess(n, elements, out)?; }
        NirRvalue.ArrayRepeat(o) => { operandAccess(n, o, out)?; }
        NirRvalue.Discriminant(place) => { out.push(Access { kind: accessRead(), place: toPlaceRef(n, place) })?; }
        NirRvalue.EnumAggregate(_, payload) => { operandsAccess(n, payload, out)?; }
        _ => {}
    }
    return Ok();
}

fn statementAccesses(n: borrow NirProgram, s: u32, out: borrow mut Vector<Access>) -> Result<void, AllocError> {
    match (n.statements[s as usize]) {
        NirStatement.Assign(target, value) => {
            rvalueAccesses(n, value, out)?;
            out.push(Access { kind: accessWrite(), place: toPlaceRef(n, target) })?;
        }
        NirStatement.Eval(value) => { rvalueAccesses(n, value, out)?; }
        NirStatement.Unpack(source, _, targets) => {
            out.push(Access { kind: accessMove(), place: toPlaceRef(n, source) })?;
            for (k in 0..targets.count) {
                let target = n.at(targets, k);
                if (target != none()) {
                    out.push(Access { kind: accessWrite(), place: barePlace(target) })?;
                }
            }
        }
        NirStatement.BoxFree(place, _) => { out.push(Access { kind: accessDead(), place: toPlaceRef(n, place) })?; }
        NirStatement.BoundsCheck(index, length) => {
            operandAccess(n, index, out)?;
            operandAccess(n, length, out)?;
        }
        NirStatement.LengthCheck(left, right) => {
            operandAccess(n, left, out)?;
            operandAccess(n, right, out)?;
        }
        NirStatement.RangeCheck(low, high, length, _) => {
            operandAccess(n, low, out)?;
            operandAccess(n, high, out)?;
            operandAccess(n, length, out)?;
        }
        NirStatement.StorageDead(local) => { out.push(Access { kind: accessDead(), place: barePlace(local) })?; }
        NirStatement.Drop(place, _) => { out.push(Access { kind: accessDead(), place: toPlaceRef(n, place) })?; }
    }
    return Ok();
}

fn terminatorAccesses(
    n: borrow NirProgram,
    terminator: u32,
    out: borrow mut Vector<Access>,
) -> Result<void, AllocError> {
    match (n.terminators[terminator as usize]) {
        NirTerminator.Branch(condition, _, _) => { operandAccess(n, condition, out)?; }
        NirTerminator.Switch(value, _, _) => { operandAccess(n, value, out)?; }
        NirTerminator.Return(value) => { operandAccess(n, value, out)?; }
        NirTerminator.Exit(code) => { operandAccess(n, code, out)?; }
        _ => {}
    }
    return Ok();
}

/// The accesses at a position: a statement's, or the terminator's at index `statements.length`.
fn accessesAt(
    n: borrow NirProgram,
    b: borrow Borrows,
    position: usize,
    i: usize,
    out: borrow mut Vector<Access>,
) -> Result<void, AllocError> {
    let block = borrow n.functions[b.function as usize].blocks[position];
    if (i < block.statements.length) {
        return statementAccesses(n, block.statements[i], out);
    }
    return terminatorAccesses(n, block.terminator, out);
}

fn spanAt(n: borrow NirProgram, b: borrow Borrows, position: usize, i: usize) -> Span {
    let block = borrow n.functions[b.function as usize].blocks[position];
    return if (i < block.statements.length) n.statementSpans[block.statements[i] as usize]
        else n.terminatorSpans[block.terminator as usize];
}

// ---- §5 Liveness ----

/// The reference locals a list of accesses reads (Uses): its root, if it is a reference.
fn accessUses(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    accesses: borrow Vector<Access>,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    for (a in accesses.view()) {
        let local = a.place.local;
        if (!holdsLoans(c, n, b, local)) {
            continue;
        }
        if (a.kind == accessDead()) {
            var visiting = Vector<u32>.create();
            if (!c.types.dropReadsLoans(localType(n, b, local), mut visiting)?) { // §25.7 rule 6
                continue;
            }
        }
        if (a.kind == accessWrite() && a.place.projections.count == 0) {
            continue;
        }
        out.push(local)?;
    }
    return Ok();
}

/// The reference locals a statement defines (Definitions): an assignment's target, or an Unpack's payload bindings.
fn definitions(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    s: u32,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    match (n.statements[s as usize]) {
        NirStatement.Assign(target, _) => {
            let t = toPlaceRef(n, target);
            if (t.projections.count == 0 && holdsLoans(c, n, b, t.local)) {
                out.push(t.local)?;
            }
        }
        NirStatement.Unpack(_, _, targets) => {
            for (k in 0..targets.count) {
                let target = n.at(targets, k);
                if (target != none() && holdsLoans(c, n, b, target)) {
                    out.push(target)?;
                }
            }
        }
        _ => {}
    }
    return Ok();
}

/// Live-in sets per statement position, index `statements.length` the terminator's (ComputeLiveness).
fn computeLiveness(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
) -> Result<Vector<Vector<Vector<u32>>>, AllocError> {
    let blockCount = n.functions[b.function as usize].blocks.length;
    var liveIn = Vector<NetSet>.create();
    var positions = Vector<Vector<Vector<u32>>>.create();
    for (k in 0..blockCount) {
        liveIn.push(NetSet.create())?;
        positions.push(Vector<Vector<u32>>.create())?;
    }
    var changed = true;
    while (changed) {
        changed = false;
        var position = blockCount;
        while (position > 0) {
            position -= 1;
            var live = NetSet.create();
            for (successor in n.functions[b.function as usize].blocks[position].successors.view()) {
                let next = b.blockOf[successor as usize];
                let members = liveIn[next as usize].members()?;
                for (local in members.view()) {
                    live.add(local)?;
                }
            }
            let statementCount = n.functions[b.function as usize].blocks[position].statements.length;
            var perPosition = Vector<Vector<u32>>.create();
            for (k in 0..(statementCount + 1)) {
                perPosition.push(Vector<u32>.create())?;
            }
            var accesses = Vector<Access>.create();
            accessesAt(n, b, position, statementCount, mut accesses)?;
            var uses = Vector<u32>.create();
            accessUses(c, n, b, accesses, mut uses)?;
            for (local in uses.view()) {
                live.add(local)?;
            }
            perPosition[statementCount] = live.members()?;
            var i = statementCount;
            while (i > 0) {
                i -= 1;
                let s = n.functions[b.function as usize].blocks[position].statements[i];
                var defined = Vector<u32>.create();
                definitions(c, n, b, s, mut defined)?;
                for (local in defined.view()) {
                    if (!isHolder(b, local)) {
                        live.remove(local)?; // a holder's earlier loans stay live when it is made again
                    }
                }
                var started = Vector<u32>.create();
                holdersStartedBy(n, b, s, mut started)?;
                for (local in started.view()) {
                    live.remove(local)?; // before its scope's body, no child holds anything
                }
                var statementAccesses = Vector<Access>.create();
                accessesAt(n, b, position, i, mut statementAccesses)?;
                var used = Vector<u32>.create();
                accessUses(c, n, b, statementAccesses, mut used)?;
                holdersUsedBy(n, b, s, mut used)?;
                for (local in used.view()) {
                    live.add(local)?;
                }
                perPosition[i] = live.members()?;
            }
            positions[position] = perPosition;
            if (!live.setEquals(liveIn[position])) {
                liveIn[position] = live;
                changed = true;
            }
        }
    }
    return Ok(positions);
}

/// Is position (`position`, `index`) reachable from where `loan` is made (Reached)? A loan does not exist before that,
/// even in a holder that is live there (§25.7: holders such as a vector receive loans after they are defined).
fn loanReached(
    n: borrow NirProgram,
    b: borrow mut Borrows,
    loan: u32,
    position: u32,
    index: u32,
) -> Result<bool, AllocError> {
    let origin = b.loans[loan as usize].block;
    if (origin == none()) {
        return Ok(true);
    }
    if (position == origin && index > b.loans[loan as usize].index) {
        return Ok(true);
    }
    if (b.reached[loan as usize].length == 0) {
        let blockCount = n.functions[b.function as usize].blocks.length;
        var reached = Vector<bool>.create();
        for (k in 0..blockCount) {
            reached.push(false)?;
        }
        var work = Vector<u32>.create();
        var head: usize = 0;
        for (successor in n.functions[b.function as usize].blocks[origin as usize].successors.view()) {
            work.push(b.blockOf[successor as usize])?;
        }
        while (head < work.length) {
            let next = work[head];
            head += 1;
            if (!reached[next as usize]) {
                reached[next as usize] = true;
                for (successor in n.functions[b.function as usize].blocks[next as usize].successors.view()) {
                    work.push(b.blockOf[successor as usize])?;
                }
            }
        }
        b.reached[loan as usize] = reached;
    }
    return Ok(b.reached[loan as usize][position as usize]);
}

/// The live loans at a position (LiveLoans): those of its live locals, without the loan made there.
fn liveLoans(
    n: borrow NirProgram,
    b: borrow mut Borrows,
    live: borrow Vector<u32>,
    created: u32,
    position: u32,
    index: u32,
) -> Result<Vector<u32>, AllocError> {
    var out = Vector<u32>.create();
    var seen = Vector<u32>.create();
    for (local in live.view()) {
        let count = b.pointsTo[local as usize].length;
        for (k in 0..count) {
            let id = b.pointsTo[local as usize][k];
            if (containsU32(seen, id)) {
                continue;
            }
            seen.push(id)?;
            if (b.loans[id as usize].hasPlace && id != created && loanReached(n, b, id, position, index)?) {
                out.push(id)?;
            }
        }
    }
    return Ok(out);
}

fn checkConflicts(c: borrow mut Checker, n: borrow NirProgram, b: borrow mut Borrows) -> Result<void, AllocError> {
    var anyPlaced = false;
    for (loan in b.loans.view()) {
        if (loan.hasPlace) {
            anyPlaced = true;
        }
    }
    if (!anyPlaced) {
        return Ok();
    }
    let liveness = computeLiveness(c, n, b)?;
    // Loans carried by a returned reference are judged by the return check (E1/E2, §7), not as "dropped while
    // borrowed" when the function's locals end at the return.
    var returned = Vector<u32>.create();
    let blockCount = n.functions[b.function as usize].blocks.length;
    for (position in 0..blockCount) {
        let terminator = n.functions[b.function as usize].blocks[position].terminator;
        match (n.terminators[terminator as usize]) {
            NirTerminator.Return(value) => {
                let local = if (value == none()) none() else operandPlaceLocal(n, value);
                if (local != none()) {
                    for (id in b.pointsTo[local as usize].view()) {
                        if (!containsU32(returned, id)) {
                            returned.push(id)?;
                        }
                    }
                }
            }
            _ => {}
        }
    }
    for (position in 0..blockCount) {
        let statementCount = n.functions[b.function as usize].blocks[position].statements.length;
        for (i in 0..(statementCount + 1)) {
            var accesses = Vector<Access>.create();
            accessesAt(n, b, position, i, mut accesses)?;
            let span = spanAt(n, b, position, i);
            let created = if (i < statementCount) b.loanAt[position][i] else none();
            let live = liveLoans(n, b, liveness[position][i], created, truncate<u32>(position), truncate<u32>(i))?;
            // An assignment writes its target after the value is computed: loans only used by the value
            // (`a[0] = sum(a[..])`) have ended by then, so the write is judged after the statement.
            var isAssign = false;
            if (i < statementCount) {
                let s = n.functions[b.function as usize].blocks[position].statements[i];
                isAssign = match (n.statements[s as usize]) {
                    NirStatement.Assign(_, _) => true,
                    _ => false,
                };
            }
            let liveAfter = if (isAssign) liveLoans(
                n,
                b,
                liveness[position][i + 1],
                created,
                truncate<u32>(position),
                truncate<u32>(i),
            )? else Vector<u32>.create();
            var reported = Vector<u32>.create();
            for (a in 0..accesses.length) {
                let access = accesses[a];
                let isWrite = isAssign && a == accesses.length - 1;
                let count = if (isWrite) liveAfter.length else live.length;
                for (k in 0..count) {
                    let id = if (isWrite) liveAfter[k] else live[k];
                    let loanPlace = b.loans[id as usize].place;
                    // A reference going out of scope does not end what it refers to.
                    var throughReference = access.kind == accessDead() &&
                        (derefsReference(c, n, b, loanPlace) || containsU32(returned, id));
                    // Overwriting a reference is not a use of its referent (lifetimes.md §5, M11).
                    if (access.kind == accessWrite() && referenceOnTheWay(c, n, b, access.place, loanPlace)) {
                        throughReference = true;
                    }
                    if (!throughReference && overlap(c, n, loanPlace, access.place) &&
                        conflicts(b.loans[id as usize], access.kind) && !containsU32(reported, id)) {
                        reported.push(id)?;
                        reportConflict(c, n, b, id, access, span, truncate<u32>(position), truncate<u32>(i))?;
                    }
                }
            }
        }
    }
    return Ok();
}

/// A place as the user wrote it (Describe): fields, and indices (`[2]` for a constant, else `[_]`).
fn appendDescribedPlace(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    p: PlaceRef,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    appendLocalNameOr(c, n, b, p.local, "a temporary", out)?;
    for (k in 0..p.projections.count) {
        let projection = n.projections[(p.projections.start + k) as usize];
        match (projection.kind) {
            ProjectionKind.Field => {
                appendText(out, ".")?;
                appendBytes(out, c.name(c.types.fields[projection.field as usize].name))?;
            }
            ProjectionKind.Index => {
                if (constantIndex(n, projection.index)) {
                    appendText(out, "[")?;
                    appendIntValue(out, constantValue(n, projection.index))?;
                    appendText(out, "]")?;
                } else {
                    appendText(out, "[_]")?;
                }
            }
            _ => {}
        }
    }
    return Ok();
}

/// The place in quotes, or "a temporary value" for an unnamed temporary (Quoted).
fn appendQuotedPlace(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    p: PlaceRef,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    if (n.functions[b.function as usize].locals[p.local as usize].name == none()) {
        return appendText(out, "a temporary value");
    }
    appendText(out, "'")?;
    appendDescribedPlace(c, n, b, p, out)?;
    return appendText(out, "'");
}

fn reportConflict(
    c: borrow mut Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    loan: u32,
    access: Access,
    span: Span,
    position: u32,
    index: u32,
) -> Result<void, AllocError> {
    let loanPlace = b.loans[loan as usize].place;
    let isMutable = b.loans[loan as usize].isMutable;
    let loanSpan = b.loans[loan as usize].span;
    let borrowKind = if (isMutable) "mutably borrowed" else "borrowed";
    var message = Vector<u8>.create();
    var code: u32 = 0;
    let kind = access.kind;
    if (kind == accessMove() || kind == accessWrite()) {
        code = writeWhileBorrowed();
        appendText(mut message, if (kind == accessMove()) "cannot move out of " else "cannot assign to ")?;
        appendQuotedPlace(c, n, b, access.place, mut message)?;
        appendText(mut message, " while ")?;
        appendQuotedPlace(c, n, b, loanPlace, mut message)?;
        appendText(mut message, " is ")?;
        appendText(mut message, borrowKind)?;
    } else if (kind == accessBorrowShared() || kind == accessBorrowMut()) {
        code = conflictingBorrow();
        appendText(mut message, "cannot borrow ")?;
        appendQuotedPlace(c, n, b, access.place, mut message)?;
        if (kind == accessBorrowMut()) {
            appendText(mut message, " as mutable")?;
        }
        appendText(mut message, " while ")?;
        appendQuotedPlace(c, n, b, loanPlace, mut message)?;
        appendText(mut message, " is ")?;
        appendText(mut message, borrowKind)?;
    } else if (kind == accessRead()) {
        code = readWhileMutablyBorrowed();
        appendText(mut message, "cannot use ")?;
        appendQuotedPlace(c, n, b, access.place, mut message)?;
        appendText(mut message, " while ")?;
        appendQuotedPlace(c, n, b, loanPlace, mut message)?;
        appendText(mut message, " is mutably borrowed")?;
    } else {
        code = deadWhileBorrowed();
        if (n.functions[b.function as usize].locals[access.place.local as usize].name == none()) {
            appendText(
                mut message,
                "a temporary value is dropped at the end of this statement while still borrowed; bind it to a local first",
            )?;
        } else {
            appendText(mut message, "'")?;
            appendDescribedPlace(c, n, b, access.place, mut message)?;
            appendText(mut message, "' goes out of scope while still borrowed")?;
        }
    }
    var notes = Vector<DiagnosticNote>.create();
    var first = Vector<u8>.create();
    appendQuotedPlace(c, n, b, loanPlace, mut first)?;
    appendText(mut first, " is ")?;
    appendText(mut first, borrowKind)?;
    appendText(mut first, " here")?;
    notes.push(DiagnosticNote { file: b.file, start: loanSpan.start, end: loanSpan.end, message: first })?;
    // A temporary dies inside the statement that made it, and that statement's own store of its value (a `let`
    // whose initialiser holds the borrow) is not the use a reader looks for: prefer one after the statement.
    let ownStatement = if (code == deadWhileBorrowed() &&
        n.functions[b.function as usize].locals[access.place.local as usize].name == none()) span else Span {
        start: none(),
        end: none(),
    };
    let later = findLaterUse(c, n, b, loan, position, index, ownStatement)?;
    if (later.start != none()) {
        var second = Vector<u8>.create();
        appendText(mut second, "the borrow is used later here")?;
        notes.push(DiagnosticNote { file: b.file, start: later.start, end: later.end, message: second })?;
    }
    return c.front.diagnostics.errorWithNotes(code, b.file, span.start, span.end, message, notes);
}

/// The first use, strictly after the given position, of a reference that may hold the loan (FindLaterUse); a span
/// whose start is none if there is none. A use by a statement that contains `within` (when its start is not none)
/// is passed over while another use follows it.
fn findLaterUse(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    loan: u32,
    position: u32,
    index: u32,
    within: Span,
) -> Result<Span, AllocError> {
    var passedOver = Span { start: none(), end: none() };
    let blockCount = n.functions[b.function as usize].blocks.length;
    var visited = Vector<bool>.create();
    for (k in 0..blockCount) {
        visited.push(false)?;
    }
    var work = Vector<u32>.create(); // pairs: block position, start
    var head: usize = 0;
    work.push(position)?;
    work.push(index + 1)?;
    while (head < work.length) {
        let block = work[head] as usize;
        let start = work[head + 1] as usize;
        head += 2;
        let statementCount = n.functions[b.function as usize].blocks[block].statements.length;
        var i = start;
        while (i <= statementCount) {
            var accesses = Vector<Access>.create();
            accessesAt(n, b, block, i, mut accesses)?;
            var uses = Vector<u32>.create();
            accessUses(c, n, b, accesses, mut uses)?;
            for (local in uses.view()) {
                if (loansContain(b, local, loan)) {
                    let found = spanAt(n, b, block, i);
                    if (within.start == none() || found.start > within.start || found.end < within.end) {
                        return Ok(found);
                    }
                    if (passedOver.start == none()) {
                        passedOver = found;
                    }
                }
            }
            i += 1;
        }
        for (successor in n.functions[b.function as usize].blocks[block].successors.view()) {
            let next = b.blockOf[successor as usize];
            if (!visited[next as usize]) {
                visited[next as usize] = true;
                work.push(next)?;
                work.push(0)?;
            }
        }
    }
    return Ok(passedOver);
}

// ---- §7 Returned references ----

/// For a value whose type mentions a type parameter that may be a reference (§25.7 rule 5): how the program says
/// that it is not one.
fn appendSendHint(c: borrow Checker, typ: u32, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    let parameter = c.types.loanParameter(typ);
    if (parameter == none()) {
        return Ok();
    }
    appendText(out, "; a value of type '")?;
    appendBytes(out, c.typeName(parameter))?;
    appendText(out, "' may hold a borrow: if '")?;
    appendBytes(out, c.typeName(parameter))?;
    // An associated type `P.Item` is bounded where its interface declares it: `P.Item: Send` cannot be written.
    var dot: usize = 0;
    let name = c.typeName(parameter);
    for (k in 0..name.length) {
        if (name[k] == '.') {
            dot = k + 1;
        }
    }
    if (dot > 0) {
        appendText(out, "' never holds one, bound the associated type where its interface declares it: 'type ")?;
        appendBytes(out, name[dot..])?;
        return appendText(out, ": Send;' (type-system.md §25.7)");
    }
    appendText(out, "' never holds one, bound it: '")?;
    appendBytes(out, name)?;
    return appendText(out, ": Send' (type-system.md §25.7)");
}

fn checkReturns(c: borrow mut Checker, n: borrow NirProgram, b: borrow Borrows) -> Result<void, AllocError> {
    let source = n.functions[b.function as usize].source;
    if (!mayHoldLoans(c, c.hir.functions[source as usize].returnType)) {
        return Ok();
    }
    let blockCount = n.functions[b.function as usize].blocks.length;
    for (position in 0..blockCount) {
        let terminator = n.functions[b.function as usize].blocks[position].terminator;
        let value = match (n.terminators[terminator as usize]) {
            NirTerminator.Return(v) => v,
            _ => none(),
        };
        if (value == none()) {
            continue;
        }
        let place = operandPlace(n, value);
        if (place == none() || n.places[place as usize].projections.count != 0) {
            continue;
        }
        let span = n.terminatorSpans[terminator as usize];
        // A reborrow of a local reference is reported through that reference's own loans, and one local loan per
        // return is enough (an allocation and its region are both local).
        var ids = copyU32s(b.pointsTo[n.places[place as usize].local as usize].view())?;
        sortU32(mut ids);
        var reportedLocal = false;
        var reportedDeep = false;
        var reportedParameters = Vector<u32>.create(); // a reference parameter has two placeholders
        for (id in ids.view()) {
            let loan = borrow b.loans[id as usize];
            if (loan.hasPlace && derefsReference(c, n, b, loan.place) && loan.place.local >= b.parameterCount) {
                continue;
            }
            let parameter = loanOrigin(c, n, b, loan);
            if (parameter == none()) {
                if (reportedLocal) {
                    continue;
                }
                reportedLocal = true;
                var message = Vector<u8>.create();
                appendText(mut message, "cannot return a reference to ")?;
                appendQuotedPlace(c, n, b, loan.place, mut message)?;
                appendText(mut message, ", which is local to '")?;
                appendBytes(mut message, c.name(c.hir.functions[source as usize].name))?;
                appendText(mut message, "'")?;
                appendSendHint(c, c.hir.functions[source as usize].returnType, mut message)?;
                var notes = Vector<DiagnosticNote>.create();
                var note = Vector<u8>.create();
                appendText(mut note, "borrowed here")?;
                notes.push(DiagnosticNote { file: b.file, start: loan.span.start, end: loan.span.end, message: note })?;
                c.front.diagnostics.errorWithNotes(
                    returnsLocalReference(),
                    b.file,
                    span.start,
                    span.end,
                    message,
                    notes,
                )?;
            } else if (containsU32(
                c.hir.functions[source as usize].deepSources,
                parameter,
            ) && (if (loan.hasPlace) !beyondReference(c, n, b, loan.place) else loan.outer)) {
                // A deep result carries only what the parameter's referent holds (ADR 0074 §2.4); one report per
                // return, at the borrow when there is one.
                if (reportedDeep || (!loan.hasPlace && deepPlaceViolation(c, n, b, ids, parameter))) {
                    continue;
                }
                reportedDeep = true;
                var message = Vector<u8>.create();
                if (c.hir.functions[source as usize].keepsInterfaceFlows) {
                    // Narrowed to the interface's flows (§21.1, ADR 0131): the advice is the impl's.
                    appendText(mut message, "the result may borrow from '")?;
                    appendLocalNameOr(c, n, b, parameter, "?", mut message)?;
                    appendText(
                        mut message,
                        "' itself, but the interface's method lets its result hold only what that parameter's referent holds, such as a copy of a view field: generic code is checked against the interface, where this result is a type parameter. Name the type's region in the result ('StringView<r>' under 'impl<region r>'), write 'StringView<static>' for static data, or have the interface's method return the borrowing type itself (type-system.md §21.1, §25.6)",
                    )?;
                } else {
                    appendText(mut message, "the returned reference may point into what parameter '")?;
                    appendLocalNameOr(c, n, b, parameter, "?", mut message)?;
                    appendText(
                        mut message,
                        "' refers to, but the return type names only regions that its referent holds; name the parameter's own region instead (e.g. '-> Slice<u8>', elided)",
                    )?;
                    appendSendHint(c, c.hir.functions[source as usize].returnType, mut message)?;
                }
                var notes = Vector<DiagnosticNote>.create();
                if (loan.hasPlace) {
                    var note = Vector<u8>.create();
                    appendText(mut note, "borrowed here")?;
                    notes.push(
                        DiagnosticNote { file: b.file, start: loan.span.start, end: loan.span.end, message: note },
                    )?;
                }
                c.front.diagnostics.errorWithNotes(
                    returnSourceMismatch(),
                    b.file,
                    span.start,
                    span.end,
                    message,
                    notes,
                )?;
            } else if (!containsU32(c.hir.functions[source as usize].returnSources, parameter) &&
                !containsU32(reportedParameters, parameter)) {
                reportedParameters.push(parameter)?;
                var message = Vector<u8>.create();
                if (parameter == 0 && c.hir.functions[source as usize].closureEnvironment != none()) {
                    // A closure's body: its first parameter is its environment, which the user never wrote (§36.2).
                    appendText(
                        mut message,
                        "this closure's result may hold a reference derived from what the closure captures, and a closure's result cannot borrow from the closure; a type parameter without a 'Send' bound may be a reference, so return a value of a type known to own its data (type-system.md §36.2, §25.7)",
                    )?;
                } else if (c.hir.functions[source as usize].keepsInterfaceFlows) {
                    appendText(mut message, "the result may be derived from parameter '")?;
                    appendLocalNameOr(c, n, b, parameter, "?", mut message)?;
                    appendText(
                        mut message,
                        "', but the interface's method declares no such flow, so a caller through the interface would not know of the borrow (type-system.md §21.1)",
                    )?;
                } else {
                    appendText(mut message, "the returned reference may be derived from parameter '")?;
                    appendLocalNameOr(c, n, b, parameter, "?", mut message)?;
                    appendText(mut message, "', which the return type does not list")?;
                    if (c.hir.functions[source as usize].returnSources.length == 0 &&
                        c.types.isScoped(c.hir.functions[source as usize].returnType)) {
                        appendText(
                            mut message,
                            "; a 'static' result may hold only static data, such as a string literal",
                        )?;
                    }
                    appendSendHint(c, c.hir.functions[source as usize].returnType, mut message)?;
                }
                c.front.diagnostics.error(returnSourceMismatch(), b.file, span.start, span.end, message)?;
            }
        }
    }
    return Ok();
}

/// Does a returned loan borrow a place in what parameter `parameter` refers to (ADR 0074 §2.4)?
fn deepPlaceViolation(
    c: borrow Checker,
    n: borrow NirProgram,
    b: borrow Borrows,
    ids: borrow Vector<u32>,
    parameter: u32,
) -> bool {
    for (id in ids.view()) {
        let loan = borrow b.loans[id as usize];
        if (loan.hasPlace && derefOfParameter(c, n, b, loan.place) == parameter && !beyondReference(
            c,
            n,
            b,
            loan.place,
        )) {
            return true;
        }
    }
    return false;
}

fn copyU32s(values: Slice<u32>) -> Result<Vector<u32>, AllocError> {
    var out = Vector<u32>.create();
    for (v in values) {
        out.push(v)?;
    }
    return Ok(out);
}

fn checkBorrows(c: borrow mut Checker, n: borrow NirProgram, function: u32) -> Result<void, AllocError> {
    let localCount = n.functions[function as usize].locals.length;
    let blockCount = n.functions[function as usize].blocks.length;
    var b = Borrows {
        function: function,
        file: functionFile(c, n, function),
        parameterCount: n.functions[function as usize].parameterCount,
        loans: Vector<Loan>.create(),
        pointsTo: Vector<Vector<u32>>.create(),
        pointsToBits: Vector<Vector<u64>>.create(),
        loanAt: Vector<Vector<u32>>.create(),
        throughWrites: Vector<ThroughWrite>.create(),
        unclassified: false,
        blockOf: Vector<u32>.create(),
        reached: Vector<Vector<bool>>.create(),
        holders: Vector<u64>.create(),
    };
    for (k in 0..localCount) {
        b.pointsTo.push(Vector<u32>.create())?;
        b.pointsToBits.push(Vector<u64>.create())?;
    }
    var maxId: u32 = 0;
    for (position in 0..blockCount) {
        var at = Vector<u32>.create();
        for (k in 0..n.functions[function as usize].blocks[position].statements.length) {
            at.push(none())?;
        }
        b.loanAt.push(at)?;
        let id = n.functions[function as usize].blocks[position].id;
        if (id > maxId) {
            maxId = id;
        }
    }
    for (k in 0..(maxId + 1)) {
        b.blockOf.push(none())?;
    }
    for (position in 0..blockCount) {
        b.blockOf[n.functions[function as usize].blocks[position].id as usize] = truncate<u32>(position);
    }
    computeLoans(c, n, mut b)?;
    noteCaptureStores(c, n, b)?;
    if (b.unclassified) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "ceesafec's internal check: this function uses a built-in whose effect on loans is not classified (builtinLoans, ADR 0131 §2.12), so its borrows cannot be checked; please report this",
        )?;
        c.front.diagnostics.error(unsupported(), b.file, 0, 1, message)?;
    }
    collectHolders(c, n, mut b)?;
    for (k in 0..b.loans.length) {
        b.reached.push(Vector<bool>.create())?;
    }
    checkParameterWrites(c, n, b)?;
    checkStaticWrites(c, n, b)?;
    checkConflicts(c, n, mut b)?;
    return checkReturns(c, n, b);
}
