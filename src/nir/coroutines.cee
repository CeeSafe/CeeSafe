// The coroutine pass (intermediate-representation.md §3, ADR 0031 §3.6): after the effect checker, over async fns. It
// finds the awaited calls and reports recursion through `await` (N0343): a frame cannot contain itself (type-system.md
// §40.1). It changes nothing.

fn awaitRecursion() -> u32 => 343;

/// An awaited call: the NIR function that makes it, the HIR callee, the rvalue.
struct AwaitEdge {
    caller: u32; // HIR function
    callee: u32; // HIR function
    rvalue: u32;
}

fn awaitEdges(n: borrow NirProgram, out: borrow mut Vector<AwaitEdge>) -> Result<void, AllocError> {
    for (f in n.functions.view()) {
        for (block in f.blocks.view()) {
            for (s in block.statements.view()) {
                let r = match (n.statements[s as usize]) {
                    NirStatement.Assign(_, value) => value,
                    NirStatement.Eval(value) => value,
                    _ => none(),
                };
                if (r == none()) {
                    continue;
                }
                match (n.rvalues[r as usize]) {
                    NirRvalue.Call(callee, _) => {
                        if (n.rvalueTasks[r as usize] == taskAwait()) {
                            out.push(AwaitEdge { caller: f.source, callee: callee, rvalue: r })?;
                        }
                    }
                    NirRvalue.Builtin(function, arguments) => {
                        if (function == bfAsyncJoin()) {
                            // race and all embed both children's frames (§40.4).
                            for (k in [2u32, 4u32]) {
                                let child = match (n.operands[n.at(arguments, k) as usize]) {
                                    NirOperand.Const(v) => truncate<u32>(v.magnitude),
                                    _ => none(),
                                };
                                out.push(AwaitEdge { caller: f.source, callee: child, rvalue: r })?;
                            }
                        }
                    }
                    _ => {}
                }
            }
        }
    }
    return Ok();
}

/// Whether `target` is reachable from `from` along the await edges.
fn awaitReaches(edges: borrow Vector<AwaitEdge>, from: u32, target: u32) -> Result<bool, AllocError> {
    var seen = Vector<u32>.create();
    var work = Vector<u32>.create();
    work.push(from)?;
    loop {
        match (work.pop()) {
            Some(f) => {
                if (f == target) {
                    return Ok(true);
                }
                if (containsU32(seen, f)) {
                    continue;
                }
                seen.push(f)?;
                for (edge in edges.view()) {
                    if (edge.caller == f) {
                        work.push(edge.callee)?;
                    }
                }
            }
            null => { return Ok(false); }
        }
    }
}

fn checkCoroutines(c: borrow mut Checker, n: borrow NirProgram) -> Result<void, AllocError> {
    var edges = Vector<AwaitEdge>.create();
    awaitEdges(n, mut edges)?;
    for (edge in edges.view()) {
        // An await on a cycle: its callee reaches its caller again.
        if (!awaitReaches(edges, edge.callee, edge.caller)?) {
            continue;
        }
        var message = Vector<u8>.create();
        appendText(mut message, "this await makes the frame of ")?;
        appendQuotedName(mut message, c, c.hir.functions[edge.caller as usize].name)?;
        appendText(
            mut message,
            " contain itself: recursion through 'await' needs a frame from an allocator: 'Async.boxed(alloc, …)' (type-system.md §40.1)",
        )?;
        let file = c.hir.functions[edge.caller as usize].file;
        let span = n.rvalueSpans[edge.rvalue as usize];
        let isCall = match (n.rvalues[edge.rvalue as usize]) {
            NirRvalue.Call(_, _) => true,
            _ => false,
        };
        if (!isCall) {
            // race or all embedding a child that awaits back: no single call to box.
            c.front.diagnostics.error(awaitRecursion(), file, span.start, span.end, message)?;
            continue;
        }
        // The sure fix (ADR 0031 §3.1.4): the recursive call's frame from the heap, with `!` on the awaited Result.
        var title = Vector<u8>.create();
        appendText(mut title, "box the recursive call: Async.boxed(SystemHeap {}, …)!")?;
        var text = Vector<u8>.create();
        appendText(mut text, "Async.boxed(SystemHeap {}, ")?;
        appendBytes(mut text, c.fileTexts[file as usize][(span.start as usize)..(span.end as usize)])?;
        appendText(mut text, ")!")?;
        c.front.diagnostics.errorWithEdit(
            awaitRecursion(),
            file,
            span.start,
            span.end,
            message,
            title,
            span.start,
            span.end,
            text,
        )?;
    }
    return Ok();
}
