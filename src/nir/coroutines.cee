// The coroutine pass (intermediate-representation.md §3, ADR 0031 §3.6): after the effect checker, over async fns. It
// finds the awaited calls on cycles of the await graph (recursion through `await`, directly or through `dyn`), whose
// frames would contain themselves (type-system.md §40.1). In the hosted profile each such call is stacked: its frame
// comes from the task's frame stack and its awaiter holds a pointer (ADR 0056). N0343 remains in the freestanding
// profile, which has no frame stack, for a race or all child, and for an async instance calling itself (ADR 0037).

fn awaitRecursion() -> u32 => 343;

/// An awaited call: the NIR function that makes it, the HIR callee, the rvalue.
struct AwaitEdge {
    caller: u32; // HIR function
    callee: u32; // HIR function
    rvalue: u32;
}

fn awaitEdges(n: borrow NirProgram, out: borrow mut Vector<AwaitEdge>) -> Result<void, AllocError> {
    for (f in n.functions.view()) {
        for (block in f.blocks.view()) {
            for (s in block.statements.view()) {
                let r = match (n.statements[s as usize]) {
                    NirStatement.Assign(_, value) => value,
                    NirStatement.Eval(value) => value,
                    _ => none(),
                };
                if (r == none()) {
                    continue;
                }
                match (n.rvalues[r as usize]) {
                    NirRvalue.Call(callee, _) => {
                        if (isAwaitRole(n.rvalueTasks[r as usize])) {
                            out.push(AwaitEdge { caller: f.source, callee: callee, rvalue: r })?;
                        }
                    }
                    NirRvalue.Builtin(function, arguments) => {
                        if (function == bfAsyncJoin()) {
                            // race and all embed both children's frames (§40.4).
                            for (k in [2u32, 4u32]) {
                                let child = match (n.operands[n.at(arguments, k) as usize]) {
                                    NirOperand.Const(v) => truncate<u32>(v.magnitude),
                                    _ => none(),
                                };
                                out.push(AwaitEdge { caller: f.source, callee: child, rvalue: r })?;
                            }
                        }
                    }
                    _ => {}
                }
            }
        }
    }
    return Ok();
}

/// Whether `target` is reachable from `from` along the await edges.
/// A call through `dyn I` (ADR 0036 §3.5) reaches every impl its table may hold.
fn awaitReaches(
    c: borrow Checker,
    edges: borrow Vector<AwaitEdge>,
    from: u32,
    target: u32,
) -> Result<bool, AllocError> {
    var seen = Vector<u32>.create();
    var work = Vector<u32>.create();
    work.push(from)?;
    loop {
        match (work.pop()) {
            Some(f) => {
                if (f == target) {
                    return Ok(true);
                }
                if (containsU32(seen, f)) {
                    continue;
                }
                seen.push(f)?;
                if (isDynAsync(c, f)) {
                    let impls = dynAsyncImpls(c, f)?;
                    for (m in impls.view()) {
                        work.push(m)?;
                    }
                }
                for (edge in edges.view()) {
                    if (edge.caller == f) {
                        work.push(edge.callee)?;
                    }
                }
            }
            null => { return Ok(false); }
        }
    }
}

fn checkCoroutines(c: borrow mut Checker, n: borrow mut NirProgram) -> Result<void, AllocError> {
    var edges = Vector<AwaitEdge>.create();
    awaitEdges(n, mut edges)?;
    for (edge in edges.view()) {
        // An await on a cycle: its callee reaches its caller again.
        if (!awaitReaches(c, edges, edge.callee, edge.caller)?) {
            continue;
        }
        let isAwaitCall = match (n.rvalues[edge.rvalue as usize]) {
            NirRvalue.Call(_, _) => true,
            _ => false,
        };
        if (!c.freestanding && isAwaitCall && c.hir.functions[edge.caller as usize].asyncInstanceOf == none()) {
            n.rvalueTasks[edge.rvalue as usize] = taskStacked(); // every await on the cycle (ADR 0056 §3.1)
            continue;
        }
        var message = Vector<u8>.create();
        appendText(mut message, "this await makes the frame of ")?;
        appendQuotedName(mut message, c, c.hir.functions[edge.caller as usize].name)?;
        if (isDynAsync(c, edge.callee)) {
            // Through a table: the frame holds room for every impl the call may reach (ADR 0036 §3.5).
            appendText(mut message, " contain itself through '")?;
            appendBytes(mut message, c.typeName(c.hir.functions[edge.callee as usize].owner))?;
            message.push('.')?;
            appendBytes(mut message, c.name(c.hir.functions[edge.callee as usize].name))?;
            appendText(mut message, "', which may be its own")?;
        } else {
            appendText(mut message, " contain itself")?;
        }
        appendText(
            mut message,
            ": recursion through 'await' needs a frame from an allocator: 'Async.boxed(alloc, …)' (type-system.md §40.1)",
        )?;
        let original = c.hir.functions[edge.caller as usize].asyncInstanceOf;
        if (original != none()) {
            // An async instance calling itself with its closure (ADR 0037 §3.4): at the call that made it.
            var recursion = Vector<u8>.create();
            appendQuotedName(mut recursion, c, c.hir.functions[original as usize].name)?;
            appendText(
                mut recursion,
                " is called with an async closure, so it runs as a task, but it calls itself with that closure: its frame would contain itself (type-system.md §32.5, §40.1)",
            )?;
            let siteFile = c.hir.functions[edge.caller as usize].siteFile;
            let siteStart = c.hir.functions[edge.caller as usize].siteStart;
            let siteEnd = c.hir.functions[edge.caller as usize].siteEnd;
            c.front.diagnostics.error(awaitRecursion(), siteFile, siteStart, siteEnd, recursion)?;
            continue;
        }
        let file = c.hir.functions[edge.caller as usize].file;
        let span = n.rvalueSpans[edge.rvalue as usize];
        let isCall = match (n.rvalues[edge.rvalue as usize]) {
            NirRvalue.Call(_, _) => true,
            _ => false,
        };
        if (!isCall) {
            // race or all embedding a child that awaits back: no single call to box.
            c.front.diagnostics.error(awaitRecursion(), file, span.start, span.end, message)?;
            continue;
        }
        // The sure fix (ADR 0031 §3.1.4): the recursive call's frame from the heap, with `!` on the awaited Result.
        var title = Vector<u8>.create();
        appendText(mut title, "box the recursive call: Async.boxed(SystemHeap {}, …)!")?;
        var text = Vector<u8>.create();
        appendText(mut text, "Async.boxed(SystemHeap {}, ")?;
        appendBytes(mut text, c.fileTexts[file as usize][(span.start as usize)..(span.end as usize)])?;
        appendText(mut text, ")!")?;
        c.front.diagnostics.errorWithEdit(
            awaitRecursion(),
            file,
            span.start,
            span.end,
            message,
            title,
            span.start,
            span.end,
            text,
        )?;
    }
    return Ok();
}
