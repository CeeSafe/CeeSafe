// Context effects (the reference's Analysis/EffectChecker.cs; type-system.md §32): infers the `sleep` and `alloc`
// effects of every compiled function over the package, then reports each operation whose effect is forbidden where it
// runs: in an `@context` function, while an `@context(atomic)` value is live, or beyond a function's `@effects` bound.
// Runs on NIR after drop elaboration, so drops are explicit operations. An operation's description (the reference's
// Witness) is kept as its parts and spelled out only when a message needs it.

fn maxEffectChain() -> u32 => 6;

/// The internal fourth fact (ADR 0087 §2.5): the operation may change something that existed before its function
/// was called, other than through the function's own `borrow mut` parameters. No `@effects` list names it, and every
/// check against a list masks it out (maskEffects()); only `debugAssert`'s N0360 reads it.
fn writeEffect() -> u32 => 8;
fn inferredEffects() -> u32 => 15; // maskEffects() | writeEffect()

// Operation kinds: what the description says.
fn opDrop() -> u32 => 0;         // drops a 'T'
fn opFree() -> u32 => 1;         // frees a 'T'
fn opCall() -> u32 => 2;         // calls 'f'
fn opCallLiteral() -> u32 => 3;  // calls 'f' with the closure at path:line
fn opCallTyped() -> u32 => 4;    // calls 'f' with a 'T'
fn opBoxAllocate() -> u32 => 5;  // allocates a 'T'
fn opBoxHeap() -> u32 => 6;      // allocates a 'T' from the heap
fn opBoxPlaced() -> u32 => 7;    // places a 'T', which runs 'f'
fn opMayAllocate() -> u32 => 8;  // may allocate (…), `builtin` says what
fn opDestroys() -> u32 => 9;     // destroys elements, each a 'T'
fn opText() -> u32 => 10;        // fixed text, `builtin` says which
fn opCallThrough() -> u32 => 11; // calls through a closure or function value of type 'T'
fn opNames() -> u32 => 12;       // names 'f'

/// An operation with effects, and why (Witness): `next` is the function to follow for the rest of the chain.
struct EffectOp {
    effects: u32;
    kind: u32;
    typ: u32;      // the type the description names, or none
    function: u32; // the callee or method the description names, or none
    literal: u32;  // a closure literal's HIR function, or none
    builtin: u32;
    next: u32;
}

fn effectOp(effects: u32, kind: u32, typ: u32, function: u32, next: u32) -> EffectOp =>
    EffectOp {
        effects: effects,
        kind: kind,
        typ: typ,
        function: function,
        literal: none(),
        builtin: none(),
        next: next,
    };

struct InferredEffects {
    present: bool;
    effects: u32;
    hasSleep: bool;
    sleep: EffectOp;
    hasAlloc: bool;
    alloc: EffectOp;
    hasSuspend: bool;
    suspend: EffectOp;
    hasWrite: bool; // ADR 0087 §2.5
    write: EffectOp;
}

struct DropEffect {
    stamp: u32; // the inference round it was computed in; 0 for never
    effects: u32;
    via: u32;
}

struct Origins {
    computed: bool;
    literalLocals: Vector<u32>;
    literalBodies: Vector<u32>;
    ownLocals: Vector<bool>;    // by local
    staticLocals: Vector<bool>; // by local: holds a `static mut`'s address (ADR 0087 §2.5)
}

struct EffectReport {
    file: u32;
    start: u32;
    message: Vector<u8>;
}

struct Effects {
    functions: Vector<u32>;            // NirProgram.functions that are not generic
    inferred: Vector<InferredEffects>; // by HIR function
    dropEffects: Vector<DropEffect>;   // by type
    round: u32;
    holdsAtomic: Vector<u32>; // by type: 0 unknown, 1 no (or being computed), 2 yes
    origins: Vector<Origins>; // by NIR function
    current: u32;             // the NIR function being looked at, or none
    reported: Vector<EffectReport>;
    lengths: Vector<Vector<u32>>; // by effect slot (effectSlot), by HIR function: its explanation's steps, or none
}

fn blankOp() -> EffectOp => effectOp(0, 0, none(), none(), none());

fn growTo<T: Copy>(values: borrow mut Vector<T>, length: usize, value: T) -> Result<void, AllocError> {
    while (values.length < length) {
        values.push(value)?;
    }
    return Ok();
}

/// The effects of a function as a callee (EffectsOf): an extern's or a `dyn` method's declaration (§37.3; an async
/// one without a list has `suspend` and `alloc`), a CeeSafe function's inference; nothing for generic code, which is never compiled.
fn effectsOf(c: borrow Checker, e: borrow Effects, function: u32) -> u32 {
    let f = borrow c.hir.functions[function as usize];
    if (f.isDynMethod && f.declaredEffects == none() && isAsyncFunction(c, function)) {
        return suspendEffect() | allocEffect() | writeEffect(); // an async body cannot sleep (ADR 0036 §3.3)
    }
    if (isExternFunction(c, function) || f.isDynMethod) {
        // C and `dyn` calls may write anything (ADR 0087 §2.5), whatever their list says; lib/core's atomic loads
        // only read.
        let writes = if (isAtomicLoad(c, function)) 0u32 else writeEffect();
        return writes | (if (f.declaredEffects == none()) allEffects() else f.declaredEffects);
    }
    return if ((function as usize) < e.inferred.length &&
        e.inferred[function as usize].present) e.inferred[function as usize].effects else 0;
}

/// One of lib/core's atomic loads (`ceesafe_atomic_load_…`, lib/core/atomics.cee): a C function that only reads.
fn isAtomicLoad(c: borrow Checker, function: u32) -> bool {
    let f = borrow c.hir.functions[function as usize];
    if (!f.library || !isExternFunction(c, function)) {
        return false;
    }
    let name = c.name(f.name);
    let prefix = "ceesafe_atomic_load_".bytes();
    return name.length > prefix.length && sameBytes(name[0..prefix.length], prefix);
}

/// The effect list of a function or closure type (TypeEffects, §36.3): both effects without one.
fn typeEffects(c: borrow Checker, typ: u32) -> u32 {
    if (c.types.is(typ, TypeKind.Function)) {
        return c.types.info(typ).effects;
    }
    if (c.types.isClosure(typ)) {
        return c.types.info(c.types.info(typ).pointee).effects;
    }
    return allEffects();
}

/// A function's effects as a value (EffectsAsValue, §32.5): its own, and its `@effectsOf` parameters' type lists.
fn effectsAsValue(c: borrow Checker, e: borrow Effects, function: u32) -> u32 {
    var effects = effectsOf(c, e, function);
    for (index in c.hir.functions[function as usize].effectsOfParameters.view()) {
        let local = c.hir.functions[function as usize].parameters[index as usize];
        effects = effects | typeEffects(c, c.hir.locals[local as usize].typ);
    }
    return effects;
}

fn structOf(c: borrow Checker, typ: u32) -> u32 =>
    if (typ != none() && c.types.is(typ, TypeKind.Struct)) c.types.info(typ).structDef else none();

fn allocatorMethod(c: borrow Checker, typ: u32, deallocate: bool) -> u32 {
    let allocator = c.types.info(typ).allocator;
    let definition = structOf(c, allocator);
    if (definition == none()) {
        return none();
    }
    return if (deallocate) c.types.structs[definition as usize]
        .deallocateMethod else c.types.structs[definition as usize].allocateMethod;
}

/// The effects of destroying a value of `typ`, and the function that explains them (DropEffects).
fn dropEffects(c: borrow Checker, e: borrow mut Effects, typ: u32) -> Result<DropEffect, AllocError> {
    growTo(mut e.dropEffects, c.types.types.length, DropEffect { stamp: 0, effects: 0, via: none() })?;
    if (e.dropEffects[typ as usize].stamp == e.round) {
        return Ok(e.dropEffects[typ as usize]);
    }
    e.dropEffects[typ as usize] = DropEffect { stamp: e.round, effects: 0, via: none() }; // a recursive type adds nothing
    var effects: u32 = 0;
    var via: u32 = none();
    var parts = Vector<DropEffect>.create();
    let info = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Struct)) {
        let definition = info.structDef;
        let dropFn = c.types.structs[definition as usize].dropFunction;
        if (dropFn != none()) {
            parts.push(DropEffect { stamp: 0, effects: effectsOf(c, e, dropFn), via: dropFn })?;
        }
        let count = c.types.structs[definition as usize].fields.length;
        for (k in 0..count) {
            let field = c.types.structs[definition as usize].fields[k];
            parts.push(dropEffects(c, e, c.types.fields[field as usize].typ)?)?;
        }
    } else if (c.types.is(typ, TypeKind.Enum)) {
        let definition = info.enumDef;
        let variantCount = c.types.enums[definition as usize].variants.length;
        for (v in 0..variantCount) {
            let variant = c.types.enums[definition as usize].variants[v];
            let payloadCount = c.types.variants[variant as usize].payload.length;
            for (k in 0..payloadCount) {
                let field = c.types.variants[variant as usize].payload[k];
                parts.push(dropEffects(c, e, c.types.fields[field as usize].typ)?)?;
            }
        }
    } else if (c.types.is(typ, TypeKind.Thread)) {
        parts.push(DropEffect { stamp: 0, effects: sleepEffect(), via: none() })?; // dropping a thread waits for it (§38.2)
        parts.push(dropEffects(c, e, info.element)?)?;
    } else if (c.types.is(typ, TypeKind.Box)) {
        parts.push(dropEffects(c, e, info.pointee)?)?;
        let deallocate = allocatorMethod(c, typ, true);
        if (deallocate != none()) {
            parts.push(DropEffect { stamp: 0, effects: effectsOf(c, e, deallocate), via: deallocate })?;
        }
    } else if (c.types.is(typ, TypeKind.Array) || c.types.is(typ, TypeKind.StableVector) ||
        c.types.is(typ, TypeKind.SlotMap) || c.types.is(typ, TypeKind.Vector)) {
        var element = info.element;
        if (element == none() && info.pointee != none()) {
            element = c.types.info(info.pointee).element;
        }
        if (element != none()) {
            parts.push(dropEffects(c, e, element)?)?;
        }
    }
    for (part in parts.view()) {
        if ((part.effects & (inferredEffects() ^ effects)) != 0 && via == none()) {
            via = part.via;
        }
        effects = effects | part.effects;
    }
    let result = DropEffect { stamp: e.round, effects: effects, via: via };
    e.dropEffects[typ as usize] = result;
    return Ok(result);
}

/// The `@placed` methods placing C state of `typ` runs (PlacedMethods, §33.3): its fields', then its own.
fn placedMethods(c: borrow Checker, typ: u32, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    let definition = structOf(c, typ);
    if (definition == none() || c.types.structs[definition as usize].isImported || !c.types.isCLaidOut(typ, 0)) {
        return Ok();
    }
    let count = c.types.structs[definition as usize].fields.length;
    for (k in 0..count) {
        let field = c.types.structs[definition as usize].fields[k];
        placedMethods(c, c.types.fields[field as usize].typ, out)?;
    }
    let placed = c.types.structs[definition as usize].placedMethod;
    if (placed != none()) {
        out.push(placed)?;
    }
    return Ok();
}

// ---- Origins of closure locals (§32.5) ----

fn assignedValues(
    n: borrow NirProgram,
    function: u32,
    bareOnly: bool,
    locals: borrow mut Vector<u32>,
    values: borrow mut Vector<Vector<u32>>,
) -> Result<void, AllocError> {
    for (block in n.functions[function as usize].blocks.view()) {
        for (s in block.statements.view()) {
            match (n.statements[s as usize]) {
                NirStatement.Assign(target, value) => {
                    let p = n.places[target as usize];
                    noteAssignment(locals, values, p.local, if (p.projections.count == 0) value else none())?;
                }
                NirStatement.Unpack(_, _, targets) => {
                    for (k in 0..targets.count) {
                        let target = n.at(targets, k);
                        if (target != none()) {
                            noteAssignment(locals, values, target, none())?;
                        }
                    }
                }
                _ => {}
            }
        }
    }
    return Ok();
}

fn noteAssignment(
    locals: borrow mut Vector<u32>,
    values: borrow mut Vector<Vector<u32>>,
    local: u32,
    value: u32,
) -> Result<void, AllocError> {
    for (k in 0..locals.length) {
        if (locals[k] == local) {
            return values[k].push(value);
        }
    }
    locals.push(local)?;
    var list = Vector<u32>.create();
    list.push(value)?;
    return values.push(list);
}

fn lookup(keys: borrow Vector<u32>, values: borrow Vector<u32>, key: u32) -> u32 {
    for (k in 0..keys.length) {
        if (keys[k] == key) {
            return values[k];
        }
    }
    return none();
}

/// The bare local a place operand reads, or none.
fn bareOperandLocal(n: borrow NirProgram, operand: u32) -> u32 {
    let place = operandPlace(n, operand);
    if (place == none() || n.places[place as usize].projections.count != 0) {
        return none();
    }
    return n.places[place as usize].local;
}

/// `Ref` of a place whose projections are exactly one deref: its local, else none.
fn reborrowedLocal(n: borrow NirProgram, place: u32) -> u32 {
    let p = n.places[place as usize];
    if (p.projections.count != 1 || !isDerefProjectionN(n.projections[p.projections.start as usize])) {
        return none();
    }
    return p.local;
}

/// The body of the closure a value makes or carries, if known (ClosureSpecialisation.Closure).
fn closureOf(
    c: borrow Checker,
    n: borrow NirProgram,
    function: u32,
    value: u32,
    knownLocals: borrow Vector<u32>,
    knownBodies: borrow Vector<u32>,
    codeLocals: borrow Vector<u32>,
    codeBodies: borrow Vector<u32>,
    locals: borrow Vector<u32>,
    values: borrow Vector<Vector<u32>>,
) -> u32 {
    if (value == none()) {
        return none();
    }
    match (n.rvalues[value as usize]) {
        NirRvalue.Ref(_, place) => {
            let p = n.places[place as usize];
            if (p.projections.count == 1 && isFieldProjectionN(n.projections[p.projections.start as usize])) {
                // A closure made here: a reference to field 0 of its environment, whose field 0 is the body's address.
                let definition = structOf(c, n.functions[function as usize].locals[p.local as usize].typ);
                if (definition == none() || c.types.structs[definition as usize].fields.length == 0 ||
                    c.types.structs[definition as usize].fields[0] !=
                        n.projections[p.projections.start as usize].field) {
                    return none();
                }
                var index = locals.length;
                for (k in 0..locals.length) {
                    if (locals[k] == p.local) {
                        index = k;
                    }
                }
                if (index == locals.length) {
                    return none();
                }
                var agreed: u32 = none();
                for (environment in values[index].view()) {
                    var one: u32 = none();
                    if (environment != none()) {
                        match (n.rvalues[environment as usize]) {
                            NirRvalue.Aggregate(fields) => {
                                if (fields.count > 0) {
                                    let code = bareOperandLocal(n, n.at(fields, 0));
                                    if (code != none()) {
                                        one = lookup(codeLocals, codeBodies, code);
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    if (one == none() || (agreed != none() && agreed != one)) {
                        return none();
                    }
                    agreed = one;
                }
                return agreed;
            }
            let reborrowed = reborrowedLocal(n, place);
            return if (reborrowed == none()) none() else lookup(knownLocals, knownBodies, reborrowed);
        }
        NirRvalue.Use(operand) => {
            let local = bareOperandLocal(n, operand);
            return if (local == none()) none() else lookup(knownLocals, knownBodies, local);
        }
        NirRvalue.Cast(operand) => {
            let local = bareOperandLocal(n, operand);
            return if (local == none()) none() else lookup(knownLocals, knownBodies, local);
        }
        _ => { return none(); }
    }
}

fn closureCode(c: borrow Checker, n: borrow NirProgram, value: u32) -> u32 {
    if (value == none()) {
        return none();
    }
    return match (n.rvalues[value as usize]) {
        NirRvalue.FunctionAddress(f) => if (c.hir.functions[f as usize].isClosure) f else none(),
        _ => none(),
    };
}

/// The closure literal each local is known to hold (ClosureSpecialisation.KnownClosures, with no bindings).
fn knownClosures(
    c: borrow Checker,
    n: borrow NirProgram,
    function: u32,
    outLocals: borrow mut Vector<u32>,
    outBodies: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    var locals = Vector<u32>.create();
    var values = Vector<Vector<u32>>.create();
    assignedValues(n, function, true, mut locals, mut values)?;
    var codeLocals = Vector<u32>.create();
    var codeBodies = Vector<u32>.create();
    var changed = true;
    while (changed) {
        changed = false;
        for (k in 0..locals.length) {
            let local = locals[k];
            if (lookup(codeLocals, codeBodies, local) == none()) {
                var agreed: u32 = none();
                var ok = true;
                for (v in values[k].view()) {
                    let one = closureCode(c, n, v);
                    if (one == none() || (agreed != none() && agreed != one)) {
                        ok = false;
                        break;
                    }
                    agreed = one;
                }
                if (ok && agreed != none()) {
                    codeLocals.push(local)?;
                    codeBodies.push(agreed)?;
                    changed = true;
                }
            }
            if (lookup(outLocals, outBodies, local) == none() &&
                c.types.isClosure(n.functions[function as usize].locals[local as usize].typ)) {
                var agreed: u32 = none();
                var ok = true;
                for (v in values[k].view()) {
                    let one = closureOf(
                        c,
                        n,
                        function,
                        v,
                        outLocals,
                        outBodies,
                        codeLocals,
                        codeBodies,
                        locals,
                        values,
                    );
                    if (one == none() || (agreed != none() && agreed != one)) {
                        ok = false;
                        break;
                    }
                    agreed = one;
                }
                if (ok && agreed != none()) {
                    outLocals.push(local)?;
                    outBodies.push(agreed)?;
                    changed = true;
                }
            }
        }
    }
    return Ok();
}

fn originsOf(
    c: borrow Checker,
    n: borrow NirProgram,
    e: borrow mut Effects,
    function: u32,
) -> Result<void, AllocError> {
    if (e.origins[function as usize].computed) {
        return Ok();
    }
    var literalLocals = Vector<u32>.create();
    var literalBodies = Vector<u32>.create();
    knownClosures(c, n, function, mut literalLocals, mut literalBodies)?;
    var ownLocals = Vector<bool>.create();
    growTo(mut ownLocals, n.functions[function as usize].locals.length, false)?;
    let source = n.functions[function as usize].source;
    var ownCount: usize = 0;
    for (index in c.hir.functions[source as usize].effectsOfParameters.view()) {
        ownLocals[index as usize] = true;
        ownCount += 1;
    }
    if (ownCount > 0) {
        // A local holds the parameter if every assignment to it copies, casts or reborrows one that does.
        var locals = Vector<u32>.create();
        var values = Vector<Vector<u32>>.create();
        assignedValues(n, function, true, mut locals, mut values)?;
        var changed = true;
        while (changed) {
            changed = false;
            for (k in 0..locals.length) {
                let local = locals[k];
                if (ownLocals[local as usize]) {
                    continue;
                }
                var all = true;
                for (v in values[k].view()) {
                    var held = false;
                    if (v != none()) {
                        match (n.rvalues[v as usize]) {
                            NirRvalue.Use(operand) => {
                                let from = bareOperandLocal(n, operand);
                                held = from != none() && ownLocals[from as usize];
                            }
                            NirRvalue.Cast(operand) => {
                                let from = bareOperandLocal(n, operand);
                                held = from != none() && ownLocals[from as usize];
                            }
                            NirRvalue.Ref(_, place) => {
                                let from = reborrowedLocal(n, place);
                                held = from != none() && ownLocals[from as usize];
                            }
                            _ => {}
                        }
                    }
                    if (!held) {
                        all = false;
                        break;
                    }
                }
                if (all) {
                    ownLocals[local as usize] = true;
                    changed = true;
                }
            }
        }
    }
    let staticLocals = mutableStaticLocals(c, n, function)?;
    e.origins[function as usize] = Origins {
        computed: true,
        literalLocals: literalLocals,
        literalBodies: literalBodies,
        ownLocals: ownLocals,
        staticLocals: staticLocals,
    };
    return Ok();
}

/// The literal an operand of the current function is known to hold, or none (Origin's first half).
fn originLiteral(n: borrow NirProgram, e: borrow Effects, operand: u32) -> u32 {
    let local = bareOperandLocal(n, operand);
    if (e.current == none() || local == none()) {
        return none();
    }
    let o = borrow e.origins[e.current as usize];
    return lookup(o.literalLocals, o.literalBodies, local);
}

/// Is the operand the current function's own @effectsOf parameter (Origin's second half)?
fn originOwn(n: borrow NirProgram, e: borrow Effects, operand: u32) -> bool {
    let local = bareOperandLocal(n, operand);
    if (e.current == none() || local == none()) {
        return false;
    }
    return e.origins[e.current as usize].ownLocals[local as usize];
}

// ---- Operations ----

/// A call's effects (CallEffects, §32.1, §32.5): the callee's own, and for each of its `@effectsOf` parameters, the
/// argument's: a known closure literal's body, nothing for the caller's own such parameter passed on, else its type's.
fn callOperations(
    c: borrow Checker,
    n: borrow NirProgram,
    e: borrow Effects,
    callee: u32,
    arguments: Range,
    out: borrow mut Vector<EffectOp>,
) -> Result<void, AllocError> {
    let calleeEffects = effectsOf(c, e, callee);
    if (calleeEffects != 0) {
        out.push(effectOp(calleeEffects, opCall(), none(), callee, callee))?;
    }
    for (index in c.hir.functions[callee as usize].effectsOfParameters.view()) {
        if (index >= arguments.count) {
            continue;
        }
        let argument = n.at(arguments, index);
        if (originOwn(n, e, argument)) {
            continue;
        }
        let literal = originLiteral(n, e, argument);
        if (literal != none()) {
            let effects = effectsOf(c, e, literal);
            if (effects != 0) {
                var op = effectOp(effects, opCallLiteral(), none(), callee, literal);
                op.literal = literal;
                out.push(op)?;
            }
        } else {
            let typ = n.operandTypes[argument as usize];
            let typed = typeEffects(c, typ);
            if (typed != 0) {
                out.push(effectOp(typed, opCallTyped(), typ, callee, none()))?;
            }
        }
    }
    return Ok();
}

fn textOp(effects: u32, text: u32) -> EffectOp {
    var op = effectOp(effects, opText(), none(), none(), none());
    op.builtin = text;
    return op;
}

/// The effects of built-in operations (BuiltinEffects, the table of §32.1); effects 0 for none.
fn builtinOperation(
    c: borrow Checker,
    n: borrow NirProgram,
    e: borrow mut Effects,
    rvalue: u32,
    function: u32,
    arguments: Range,
) -> Result<EffectOp, AllocError> {
    let sleep = sleepEffect();
    let alloc = allocEffect();
    if (function == bfBoxCreate()) {
        let typ = n.rvalueTypes[rvalue as usize];
        var box: u32 = none();
        if (c.types.is(typ, TypeKind.Enum)) {
            box = c.types.enums[c.types.info(typ).enumDef as usize].resultOk;
        }
        let allocate = if (box == none()) none() else allocatorMethod(c, box, false);
        var op = if (allocate != none()) effectOp(
            effectsOf(c, e, allocate),
            opBoxAllocate(),
            box,
            none(),
            allocate,
        ) else effectOp(
            alloc,
            opBoxHeap(),
            box,
            none(),
            none(),
        );
        if (box != none()) {
            // Placing C state runs the `@placed` methods (type-system.md §33.3).
            var placed = Vector<u32>.create();
            placedMethods(c, c.types.info(box).pointee, mut placed)?;
            for (method in placed.view()) {
                let extra = effectsOf(c, e, method) & (maskEffects() ^ op.effects);
                if (extra != 0) {
                    let effects = op.effects;
                    op = effectOp(effects, opBoxPlaced(), c.types.info(box).pointee, method, method);
                }
                op.effects = op.effects | extra;
            }
        }
        return Ok(op);
    }
    if (function == bfArenaAlloc() || function == bfArenaAllocArray()) {
        let region = n.operandTypes[n.at(arguments, 0) as usize];
        if (c.types.is(region, TypeKind.Reference) && regionIndex(
            c.types.info(c.types.info(region).pointee).region,
        ) == regionIndex(RegionKind.FixedBuffer)) {
            return Ok(blankOp()); // a fixed buffer never asks a heap (§19.4)
        }
    }
    if (function == bfArenaCreate() || function == bfArenaAlloc() || function == bfArenaAllocArray() ||
        function == bfScratchEnter() || function == bfPoolCreate() || function == bfVectorWithCapacity() ||
        function == bfVectorPush() || function == bfStringAppend() || function == bfStringAppendNumber() ||
        function == bfStableVectorPush() || function == bfSlotMapInsert() || function == bfVectorExtend() ||
        function == bfVectorResize() || function == bfVectorReserve()) {
        var op = effectOp(alloc, opMayAllocate(), none(), none(), none());
        op.builtin = function;
        return Ok(op);
    }
    if (function == bfVectorClear() || function == bfVectorTruncate()) {
        // Destroying the elements runs their drops (§32.1: dropping a value).
        let receiver = n.operandTypes[n.at(arguments, 0) as usize];
        let element = c.types.info(c.types.info(c.types.info(receiver).pointee).pointee).element;
        let d = dropEffects(c, e, element)?;
        return Ok(effectOp(d.effects, opDestroys(), element, none(), d.via));
    }
    if (function == bfProcessRun()) {
        return Ok(textOp(sleep | alloc, 0));
    }
    if (function == bfConsoleWrite() || function == bfConsoleWriteLine() || function == bfConsoleRead() ||
        function == bfConsoleWriteBytes() ||
        function == bfConsoleWriteError() || function == bfConsoleWriteErrorLine()) {
        return Ok(textOp(sleep, 1));
    }
    if (function == bfFileOpen() || function == bfFileCreate() || function == bfFileRemove() ||
        isDurableFileBuiltin(function) ||
        function == bfResourceRead() || function == bfResourceWrite() || function == bfTcpListen() ||
        function == bfTcpAccept() || function == bfTcpConnect() || function == bfTcpShutdownWrite() ||
        function == bfTcpShutdownRead()) {
        return Ok(textOp(sleep, 2));
    }
    if (function == bfThreadSpawn() || function == bfThreadSpawnBoxed()) {
        return Ok(textOp(sleep | alloc, 3));
    }
    if (function == bfThreadJoin()) {
        return Ok(textOp(sleep, 4));
    }
    if (function == bfThreadBoth()) {
        return Ok(textOp(sleep | alloc, 5));
    }
    if (function == bfAsyncPark()) {
        return Ok(textOp(suspendEffect(), 9));
    }
    if (function == bfAsyncSpawn() || function == bfAsyncSetSpawn()) {
        return Ok(textOp(alloc, 10));
    }
    if (function == bfAsyncScopeWait()) {
        return Ok(textOp(suspendEffect(), 11));
    }
    if (function == bfAsyncJoin()) {
        return Ok(textOp(suspendEffect(), 12));
    }
    if (function == bfAsyncBlocking()) {
        return Ok(textOp(suspendEffect(), 13)); // the body's effects are its worker's
    }
    if (function == bfCallPointer()) {
        return Ok(textOp(sleep | alloc | writeEffect(), 6));
    }
    if (function == bfPtrWrite() || function == bfPtrWriteVolatile() || function == bfPtrWriteUnaligned() ||
        function == bfPtrPlace()) {
        return Ok(textOp(writeEffect(), 14)); // ADR 0087 §2.5
    }
    if (function == bfCallClosure() || function == bfCallFunction()) {
        let argument = n.at(arguments, 0);
        // A call through the function's own @effectsOf parameter is its callers' effect (§32.5), but for
        // `debugAssert` a call through any closure or function value may write (ADR 0087 §2.5).
        if (originOwn(n, e, argument)) {
            var through = effectOp(writeEffect(), opCallThrough(), n.operandTypes[argument as usize], none(), none());
            through.builtin = function;
            return Ok(through);
        }
        // The type's effect list (type-system.md §36.3): every value of the type is checked against it.
        let argumentType = n.operandTypes[argument as usize];
        let typ = if (function == bfCallClosure()) c.types.info(argumentType).pointee else argumentType;
        var op = effectOp(c.types.info(typ).effects | writeEffect(), opCallThrough(), argumentType, none(), none());
        op.builtin = function;
        return Ok(op);
    }
    return Ok(blankOp());
}

/// The operations of a statement with effects (Operations).
fn statementOperations(
    c: borrow Checker,
    n: borrow NirProgram,
    e: borrow mut Effects,
    s: u32,
    out: borrow mut Vector<EffectOp>,
) -> Result<void, AllocError> {
    let locals = borrow n.functions[e.current as usize].locals;
    var rvalue: u32 = none();
    match (n.statements[s as usize]) {
        NirStatement.Assign(_, value) => { rvalue = value; }
        NirStatement.Eval(value) => { rvalue = value; }
        NirStatement.Drop(place, _) => {
            let typ = nirPlaceType(c, n, locals, place);
            let d = dropEffects(c, e, typ)?;
            if (d.effects != 0) {
                out.push(effectOp(d.effects, opDrop(), typ, none(), d.via))?;
            }
        }
        NirStatement.BoxFree(place, _) => {
            let typ = nirPlaceType(c, n, locals, place);
            let deallocate = allocatorMethod(c, typ, true);
            if (deallocate != none()) {
                out.push(effectOp(effectsOf(c, e, deallocate), opFree(), typ, none(), deallocate))?;
            }
        }
        _ => {}
    }
    if (rvalue == none()) {
        return Ok();
    }
    match (n.rvalues[rvalue as usize]) {
        NirRvalue.Call(callee, arguments) => {
            let role = n.rvalueTasks[rvalue as usize];
            if (role == taskRun()) {
                // `Async.run` blocks this thread until the task returns; the task's suspensions stay inside it (§40.4).
                let first = out.length;
                callOperations(c, n, e, callee, arguments, out)?;
                for (k in first..out.length) {
                    out[k].effects = out[k].effects & (maskEffects() ^ suspendEffect());
                }
                out.push(textOp(sleepEffect() | allocEffect(), 8))?;
            } else {
                if (role == taskAwait()) {
                    out.push(textOp(suspendEffect(), 7))?;
                }
                callOperations(c, n, e, callee, arguments, out)?;
            }
        }
        NirRvalue.Builtin(function, arguments) => {
            if (function == bfAsyncBoxed()) {
                // A boxed task (type-system.md §40.1): it suspends, runs its callee, and allocates its frame.
                out.push(textOp(suspendEffect(), 7))?;
                let callee = constOperandValue(n, n.at(arguments, 1));
                let rest = Range { start: arguments.start + 2, count: arguments.count - 2 };
                callOperations(c, n, e, callee, rest, out)?;
                allocatorOperations(c, e, constOperandValue(n, n.at(arguments, 0)), out)?;
                return Ok();
            }
            if (function == bfAsyncSpawn() && arguments.count > 3) {
                let allocator = constOperandValue(n, n.at(arguments, 3));
                if (allocator != none()) {
                    allocatorOperations(c, e, allocator, out)?; // Async.scopeIn's allocator (§40.5)
                    return Ok();
                }
            }
            let op = builtinOperation(c, n, e, rvalue, function, arguments)?;
            if (op.effects != 0) {
                out.push(op)?;
            }
        }
        _ => {}
    }
    return Ok();
}

// ---- Descriptions ----

/// 'f' or 'Owner.f' (Describe).
fn appendDescribedFunction(c: borrow Checker, function: u32, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    let f = borrow c.hir.functions[function as usize];
    appendText(out, "'")?;
    if (f.owner != none()) {
        appendBytes(out, c.typeName(f.owner))?;
        appendText(out, ".")?;
    }
    appendBytes(out, c.name(f.name))?;
    return appendText(out, "'");
}

fn lineOfOffset(text: borrow Vector<u8>, offset: u32) -> u64 {
    var line: u64 = 1;
    var i: usize = 0;
    while (i < offset as usize && i < text.length) {
        if (text[i] == '\r') {
            if (i + 1 < text.length && text[i + 1] == '\n') {
                i += 1;
            }
            if (i < offset as usize) {
                line += 1;
            }
        } else if (text[i] == '\n') {
            line += 1;
        }
        i += 1;
    }
    return line;
}

fn appendOpDescription(c: borrow Checker, op: borrow EffectOp, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    let kind = op.kind;
    if (kind == opDrop() || kind == opFree() || kind == opBoxAllocate() || kind == opDestroys()) {
        appendText(
            out,
            if (kind == opDrop()) "drops a "
                else if (kind == opFree()) "frees a "
                else if (kind == opBoxAllocate()) "allocates a "
                else "destroys elements, each a ",
        )?;
        return appendQuotedType(out, c, op.typ);
    }
    if (kind == opCall() || kind == opCallLiteral() || kind == opCallTyped()) {
        appendText(out, "calls ")?;
        appendDescribedFunction(c, op.function, out)?;
        if (kind == opCallLiteral()) {
            // By its place in its function, not its line: the explanation holds no position (ADR 0082 §2.7).
            appendText(out, " with the closure ")?;
            appendClosurePlace(c, out, op.literal)?;
        } else if (kind == opCallTyped()) {
            appendText(out, " with a ")?;
            appendQuotedType(out, c, op.typ)?;
            if (op.effects == allEffects()) {
                appendText(out, ", which has no effect list (type-system.md §36.3)")?;
            }
        }
        return Ok();
    }
    if (kind == opBoxHeap()) {
        appendText(out, "allocates a '")?;
        if (op.typ == none()) {
            appendText(out, "Box")?;
        } else {
            appendBytes(out, c.typeName(op.typ))?;
        }
        return appendText(out, "' from the heap");
    }
    if (kind == opBoxPlaced()) {
        appendText(out, "places a ")?;
        appendQuotedType(out, c, op.typ)?;
        appendText(out, ", which runs ")?;
        return appendDescribedFunction(c, op.function, out);
    }
    if (kind == opMayAllocate()) {
        let b = op.builtin;
        appendText(out, "may allocate (")?;
        appendText(
            out,
            if (b == bfArenaCreate() ||
                b == bfPoolCreate()) "makes a region"
                else if (b == bfArenaAlloc() ||
                    b == bfArenaAllocArray()) "allocates from a region"
                else if (b == bfScratchEnter()) "enters a scratch frame"
                else "grows a collection",
        )?;
        return appendText(out, ")");
    }
    if (kind == opText()) {
        let text = match (op.builtin) {
            0 => "runs a process",
            1 => "does console I/O",
            2 => "does file or socket I/O",
            3 => "starts a thread (type-system.md §38.2)",
            4 => "waits for a thread (type-system.md §38.2)",
            5 => "runs two closures on two threads (type-system.md §38.6)",
            7 => "awaits a task (type-system.md §40.2)",
            8 => "runs a task until it returns (type-system.md §40.4)",
            9 => "parks the task until the runtime wakes it (type-system.md §40.4)",
            10 => "starts a child task, whose frame it allocates (type-system.md §40.5)",
            11 => "waits for a scope's children (type-system.md §40.5)",
            12 => "runs two children and waits for both (type-system.md §40.4)",
            13 => "waits for a worker thread (type-system.md §40.4)",
            14 => "writes through a raw pointer",
            15 => "assigns through a raw pointer",
            16 => "writes a 'static mut'",
            17 => "exits the process",
            _ => "calls through a C function pointer, which may do anything (type-system.md §32.1)",
        };
        return appendText(out, text);
    }
    if (kind == opCallThrough()) {
        appendText(
            out,
            if (op.builtin == bfCallClosure()) "calls through a closure of type "
                else "calls through a function value of type ",
        )?;
        appendQuotedType(out, c, op.typ)?;
        if ((op.effects & maskEffects()) == allEffects()) {
            appendText(out, ", which has no effect list (type-system.md §36.3)")?;
        }
        return Ok();
    }
    appendText(out, "names ")?;
    return appendDescribedFunction(c, op.function, out);
}

/// The chain of calls from an operation to where the effect comes from (Explain).
fn explainOp(
    c: borrow Checker,
    e: borrow Effects,
    op: borrow EffectOp,
    effect: u32,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    appendOpDescription(c, op, out)?;
    let chain = chainFrom(c, e, op.next, effect)?;
    var depth: u32 = 0;
    for (step in chain.steps.view()) {
        if (depth == maxEffectChain()) {
            appendText(out, ", …")?;
            return Ok();
        }
        appendText(out, ", which ")?;
        appendBytes(out, step.view())?;
        depth += 1;
    }
    if (!chain.truncated) {
        appendBytes(out, chain.terminal.view())?;
    }
    return Ok();
}

/// The rest of an explanation from `first`, the function an operation reaches, as explainOp prints it: each step's
/// description (at most maxEffectChain() + 1, enough for any depth), then what ends the chain, an extern's or a `dyn`
/// method's text or nothing. A function whose body was not checked, its package's interface record standing for it
/// (ADR 0082 §2.7), continues with the steps its record kept.
fn chainFrom(c: borrow Checker, e: borrow Effects, first: u32, effect: u32) -> Result<RecordedChain, AllocError> {
    var chain = emptyChain();
    let limit = (maxEffectChain() + 1) as usize;
    var seen = Vector<u32>.create();
    var next = first;
    while (next != none() && !containsU32(seen, next)) {
        seen.push(next)?;
        if (isExternFunction(c, next)) {
            let declared = c.hir.functions[next as usize].declaredEffects;
            if (effect == writeEffect()) {
                appendText(mut chain.terminal, ", a C function, which may write anything (ADR 0087 §2.5)")?;
            } else if (declared != none()) {
                appendText(mut chain.terminal, ", declared @effects(")?;
                appendEffectNames(mut chain.terminal, declared)?;
                appendText(mut chain.terminal, ")")?;
            } else {
                appendText(mut chain.terminal, ", a C function without @effects, which may do anything")?;
            }
            break;
        }
        if (c.hir.functions[next as usize].isDynMethod) {
            // A call through `dyn` has the interface method's declared effects, all of them without a list (§37.3):
            // the fix is usually on the interface, not at the call.
            let declared = c.hir.functions[next as usize].declaredEffects;
            if (effect == writeEffect()) {
                appendText(
                    mut chain.terminal,
                    ", an interface method called through 'dyn', which may write anything (ADR 0087 §2.5)",
                )?;
            } else if (declared != none()) {
                appendText(mut chain.terminal, ", declared @effects(")?;
                appendEffectNames(mut chain.terminal, declared)?;
                appendText(mut chain.terminal, ")")?;
            } else {
                appendText(
                    mut chain.terminal,
                    ", an interface method without @effects, which may do anything: if no implementation may block or allocate, declare it '@effects() fn …' in the interface (type-system.md §37.3)",
                )?;
            }
            break;
        }
        if ((next as usize) >= e.inferred.length || !e.inferred[next as usize].present) {
            break;
        }
        let inferred = borrow e.inferred[next as usize];
        let has =
            if (effect == sleepEffect()) inferred.hasSleep
                else if (effect == allocEffect()) inferred.hasAlloc
                else if (effect == writeEffect()) inferred.hasWrite
                else inferred.hasSuspend;
        if (!has) {
            break;
        }
        let recorded = recordedEntryOf(c, next);
        if (recorded != none()) {
            // The rest is the record's: its steps, then its end.
            let kept = borrow c.recordedEffects[recorded as usize].chains[effectSlot(effect)];
            for (step in kept.steps.view()) {
                if (chain.steps.length == limit) {
                    chain.truncated = true;
                    return Ok(chain);
                }
                chain.steps.push(copyBytes(step.view())?)?;
            }
            chain.truncated = kept.truncated;
            appendBytes(mut chain.terminal, kept.terminal.view())?;
            break;
        }
        if (chain.steps.length == limit) {
            chain.truncated = true;
            break;
        }
        let step =
            if (effect == sleepEffect()) inferred.sleep
                else if (effect == allocEffect()) inferred.alloc
                else if (effect == writeEffect()) inferred.write
                else inferred.suspend;
        var text = Vector<u8>.create();
        appendOpDescription(c, step, mut text)?;
        chain.steps.push(text)?;
        next = step.next;
    }
    return Ok(chain);
}

// ---- Inference (§32.1) ----

/// Does the terminator end the process (`Process.exit`)?
fn exitsProcess(n: borrow NirProgram, terminator: u32) -> bool {
    if (terminator == none()) {
        return false;
    }
    return match (n.terminators[terminator as usize]) {
        NirTerminator.Exit(_) => true,
        _ => false,
    };
}

fn inferEffects(c: borrow Checker, n: borrow NirProgram, e: borrow mut Effects) -> Result<void, AllocError> {
    for (k in e.functions.view()) {
        e.inferred[n.functions[k as usize].source as usize].present = true;
    }
    // Effects only grow, so iterating to a fixed point terminates (two bits per function).
    var changed = true;
    while (changed) {
        changed = false;
        e.round += 1; // a new round forgets the drop effects of the last
        for (i in 0..e.functions.length) {
            let function = e.functions[i];
            e.current = function;
            originsOf(c, n, e, function)?;
            let source = n.functions[function as usize].source;
            for (block in n.functions[function as usize].blocks.view()) {
                for (s in block.statements.view()) {
                    var ops = Vector<EffectOp>.create();
                    statementOperations(c, n, e, s, mut ops)?;
                    writeOperations(c, n, e, s, mut ops)?;
                    for (op in ops.view()) {
                        let inferred = borrow mut e.inferred[source as usize];
                        if ((op.effects & (inferredEffects() ^ inferred.effects)) == 0) {
                            continue;
                        }
                        changed = true;
                        if ((op.effects & sleepEffect()) != 0 && !inferred.hasSleep) {
                            inferred.hasSleep = true;
                            inferred.sleep = op;
                        }
                        if ((op.effects & allocEffect()) != 0 && !inferred.hasAlloc) {
                            inferred.hasAlloc = true;
                            inferred.alloc = op;
                        }
                        if ((op.effects & suspendEffect()) != 0 && !inferred.hasSuspend) {
                            inferred.hasSuspend = true;
                            inferred.suspend = op;
                        }
                        if ((op.effects & writeEffect()) != 0 && !inferred.hasWrite) {
                            inferred.hasWrite = true;
                            inferred.write = op;
                        }
                        inferred.effects = inferred.effects | op.effects;
                    }
                }
                if (exitsProcess(n, block.terminator)) {
                    // A process exit skips everything after it, so through a call it writes (ADR 0087 §2.5).
                    let inferred = borrow mut e.inferred[source as usize];
                    if (!inferred.hasWrite) {
                        changed = true;
                        inferred.hasWrite = true;
                        inferred.write = textOp(writeEffect(), 17);
                        inferred.effects = inferred.effects | writeEffect();
                    }
                }
            }
        }
    }
    return Ok();
}

/// What ranks an explanation that ends in a call it cannot see into, saying only that the callee "may do anything"
/// (or, for writes, "may write anything"): a C function or a `dyn` method without an effect list. Such an
/// explanation comes after every one that ends in an operation, whatever their lengths (chooseWitnesses).
fn vagueEnd() -> u32 => 0x40000000;

/// The rank of an explanation after `op`, for `effect`: its length in steps, plus vagueEnd() if it ends in a call
/// that may do anything. 0 where explainOp stops after it at an operation, vagueEnd() where it stops at such a call,
/// else its next function's; none while that is not known yet.
fn continuationLength(
    c: borrow Checker,
    e: borrow Effects,
    op: borrow EffectOp,
    effect: u32,
    length: borrow Vector<u32>,
) -> u32 {
    let next = op.next;
    if (next == none()) {
        return 0;
    }
    if (isExternFunction(c, next) || c.hir.functions[next as usize].isDynMethod) {
        let declared = c.hir.functions[next as usize].declaredEffects;
        return if (effect == writeEffect() || declared == none()) vagueEnd() else 0;
    }
    if ((next as usize) >= e.inferred.length || !e.inferred[next as usize].present ||
        (e.inferred[next as usize].effects & effect) == 0) {
        return 0;
    }
    return length[next as usize];
}

/// After the fixed point, each function's witness for each effect, the operation its explanation starts from
/// (type-system.md §32.1): one whose chain ends in an operation rather than a call that may do anything (vagueEnd),
/// then the shortest, then the first in the function's order among those. The fixed point found a witness in
/// whatever round the effect reached the function, which depends on the order the functions are looked at; this
/// ranking does not, so a dependency's interface record explains a call into it as the check of the whole program
/// does (ADR 0082 §2.7).
fn chooseWitnesses(c: borrow Checker, n: borrow NirProgram, e: borrow mut Effects) -> Result<void, AllocError> {
    e.round += 1;                                // drop effects afresh, at the fixed point
    var ops = Vector<Vector<EffectOp>>.create(); // by e.functions' index
    for (i in 0..e.functions.length) {
        let function = e.functions[i];
        e.current = function;
        originsOf(c, n, e, function)?;
        var list = Vector<EffectOp>.create();
        for (block in n.functions[function as usize].blocks.view()) {
            for (s in block.statements.view()) {
                statementOperations(c, n, e, s, mut list)?;
                writeOperations(c, n, e, s, mut list)?;
            }
            if (exitsProcess(n, block.terminator)) {
                list.push(textOp(writeEffect(), 17))?;
            }
        }
        ops.push(list)?;
    }
    for (slot in 0..4usize) {
        let effect = slotEffect(slot);
        var length = Vector<u32>.create();
        while (length.length < c.hir.functions.length) {
            length.push(none())?;
        }
        for (f in 0..c.recordedFunction.length) {
            let r = c.recordedFunction[f];
            if (r != none() && (c.recordedEffects[r as usize].effects & effect) != 0) {
                length[f] = c.recordedEffects[r as usize].chains[slot].length;
            }
        }
        // Shortest lengths, by relaxing until nothing changes; then the first operation of that length.
        var changed = true;
        while (changed) {
            changed = false;
            for (i in 0..e.functions.length) {
                let source = n.functions[e.functions[i] as usize].source;
                if ((e.inferred[source as usize].effects & effect) == 0) {
                    continue;
                }
                for (op in ops[i].view()) {
                    if ((op.effects & effect) == 0) {
                        continue;
                    }
                    let rest = continuationLength(c, e, op, effect, length);
                    if (rest != none() && rest + 1 < length[source as usize]) {
                        length[source as usize] = rest + 1;
                        changed = true;
                    }
                }
            }
        }
        for (i in 0..e.functions.length) {
            let source = n.functions[e.functions[i] as usize].source;
            if ((e.inferred[source as usize].effects & effect) == 0 || length[source as usize] == none()) {
                continue;
            }
            for (op in ops[i].view()) {
                if ((op.effects & effect) == 0) {
                    continue;
                }
                let rest = continuationLength(c, e, op, effect, length);
                if (rest != none() && rest + 1 == length[source as usize]) {
                    if (slot == 0) {
                        e.inferred[source as usize].sleep = op;
                    } else if (slot == 1) {
                        e.inferred[source as usize].alloc = op;
                    } else if (slot == 2) {
                        e.inferred[source as usize].suspend = op;
                    } else {
                        e.inferred[source as usize].write = op;
                    }
                    break;
                }
            }
        }
        e.lengths.push(length)?;
    }
    return Ok();
}

// ---- Where an atomic-context value is live (§32.3) ----

/// Does a value of this type hold an `@context(atomic)` struct by value, or in a box it owns (HoldsAtomic)?
fn holdsAtomic(c: borrow Checker, e: borrow mut Effects, typ: u32) -> Result<bool, AllocError> {
    growTo(mut e.holdsAtomic, c.types.types.length, 0)?;
    if (e.holdsAtomic[typ as usize] != 0) {
        return Ok(e.holdsAtomic[typ as usize] == 2);
    }
    e.holdsAtomic[typ as usize] = 1;
    var holds = false;
    let info = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Struct)) {
        let definition = info.structDef;
        holds = c.types.structs[definition as usize].isAtomicContext;
        let count = c.types.structs[definition as usize].fields.length;
        for (k in 0..count) {
            if (holds) {
                break;
            }
            let field = c.types.structs[definition as usize].fields[k];
            holds = holdsAtomic(c, e, c.types.fields[field as usize].typ)?;
        }
    } else if (c.types.is(typ, TypeKind.Enum)) {
        let definition = info.enumDef;
        let variantCount = c.types.enums[definition as usize].variants.length;
        for (v in 0..variantCount) {
            let variant = c.types.enums[definition as usize].variants[v];
            let payloadCount = c.types.variants[variant as usize].payload.length;
            for (k in 0..payloadCount) {
                if (!holds) {
                    let field = c.types.variants[variant as usize].payload[k];
                    holds = holdsAtomic(c, e, c.types.fields[field as usize].typ)?;
                }
            }
        }
    } else if (c.types.is(typ, TypeKind.Box)) {
        holds = holdsAtomic(c, e, info.pointee)?;
    } else if (c.types.is(typ, TypeKind.Array)) {
        holds = holdsAtomic(c, e, info.element)?;
    }
    e.holdsAtomic[typ as usize] = if (holds) 2 else 1;
    return Ok(holds);
}

/// Moves of whole locals an rvalue makes (Moved).
fn movedLocals(n: borrow NirProgram, rvalue: u32, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    match (n.rvalues[rvalue as usize]) {
        NirRvalue.Use(o) => { return movedLocal(n, o, out); }
        NirRvalue.Call(_, arguments) => { return movedLocalsIn(n, arguments, out); }
        NirRvalue.Builtin(_, arguments) => { return movedLocalsIn(n, arguments, out); }
        NirRvalue.Aggregate(fields) => { return movedLocalsIn(n, fields, out); }
        NirRvalue.EnumAggregate(_, payload) => { return movedLocalsIn(n, payload, out); }
        NirRvalue.Array(elements) => { return movedLocalsIn(n, elements, out); }
        _ => { return Ok(); }
    }
}

fn movedLocalsIn(n: borrow NirProgram, operands: Range, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    for (k in 0..operands.count) {
        movedLocal(n, n.at(operands, k), out)?;
    }
    return Ok();
}

fn movedLocal(n: borrow NirProgram, operand: u32, out: borrow mut Vector<u32>) -> Result<void, AllocError> {
    match (n.operands[operand as usize]) {
        NirOperand.Place(place, isMove) => {
            if (isMove && n.places[place as usize].projections.count == 0) {
                out.push(n.places[place as usize].local)?;
            }
        }
        _ => {}
    }
    return Ok();
}

/// Holder locals a statement ends: moved away, dropped, or whose storage ends (Killed).
fn killedHolders(
    n: borrow NirProgram,
    s: u32,
    holders: borrow Vector<bool>,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    var ids = Vector<u32>.create();
    match (n.statements[s as usize]) {
        NirStatement.Drop(place, _) => {
            if (n.places[place as usize].projections.count == 0) {
                ids.push(n.places[place as usize].local)?;
            }
        }
        NirStatement.StorageDead(local) => { ids.push(local)?; }
        NirStatement.Assign(_, value) => { movedLocals(n, value, mut ids)?; }
        NirStatement.Eval(value) => { movedLocals(n, value, mut ids)?; }
        _ => {}
    }
    for (id in ids.view()) {
        if (holders[id as usize]) {
            out.push(id)?;
        }
    }
    return Ok();
}

fn transferHolders(
    n: borrow NirProgram,
    live: borrow mut Vector<bool>,
    s: u32,
    holders: borrow Vector<bool>,
) -> Result<void, AllocError> {
    var killed = Vector<u32>.create();
    killedHolders(n, s, holders, mut killed)?;
    for (id in killed.view()) {
        live[id as usize] = false;
    }
    match (n.statements[s as usize]) {
        NirStatement.Assign(target, _) => {
            let p = n.places[target as usize];
            if (p.projections.count == 0 && holders[p.local as usize]) {
                live[p.local as usize] = true;
            }
        }
        _ => {}
    }
    return Ok();
}

fn copyBools(values: borrow Vector<bool>) -> Result<Vector<bool>, AllocError> {
    var out = Vector<bool>.create();
    for (v in values.view()) {
        out.push(v)?;
    }
    return Ok(out);
}

/// For each block position, the holder locals that may be live on entry: a forward, may analysis (LiveHolders).
fn liveHolders(
    n: borrow NirProgram,
    function: u32,
    holders: borrow Vector<bool>,
) -> Result<Vector<Vector<bool>>, AllocError> {
    let blockCount = n.functions[function as usize].blocks.length;
    let count = n.functions[function as usize].locals.length;
    var blockOf = Vector<u32>.create();
    var liveIn = Vector<Vector<bool>>.create();
    for (position in 0..blockCount) {
        var bits = Vector<bool>.create();
        growTo(mut bits, count, false)?;
        liveIn.push(bits)?;
        let id = n.functions[function as usize].blocks[position].id;
        growTo(mut blockOf, (id + 1) as usize, none())?;
        blockOf[id as usize] = truncate<u32>(position);
    }
    for (p in 0..n.functions[function as usize].parameterCount) {
        if (holders[p as usize]) {
            liveIn[0][p as usize] = true;
        }
    }
    var work = Vector<u32>.create();
    var head: usize = 0;
    var queued = Vector<bool>.create();
    for (position in 0..blockCount) {
        work.push(truncate<u32>(position))?;
        queued.push(true)?;
    }
    while (head < work.length) {
        let position = work[head] as usize;
        head += 1;
        queued[position] = false;
        var live = copyBools(liveIn[position])?;
        for (s in n.functions[function as usize].blocks[position].statements.view()) {
            transferHolders(n, mut live, s, holders)?;
        }
        for (successor in n.functions[function as usize].blocks[position].successors.view()) {
            let target = blockOf[successor as usize] as usize;
            var changed = false;
            for (k in 0..count) {
                if (live[k] && !liveIn[target][k]) {
                    liveIn[target][k] = true;
                    changed = true;
                }
            }
            if (changed && !queued[target]) {
                queued[target] = true;
                work.push(truncate<u32>(target))?;
            }
        }
    }
    return Ok(liveIn);
}

// ---- Checking (§32.2–§32.3) ----

// What a report's context says.
fn contextOfFunction() -> u32 => 0; // 'f' is @context(…)
fn contextLive() -> u32 => 1;       // a 'T' is live here, …
fn contextBound() -> u32 => 2;      // 'f' is declared @effects(…), or the closure's type list
fn contextValue() -> u32 => 3;      // 'f' is used as a 'T'

fn reportEffect(
    c: borrow mut Checker,
    n: borrow NirProgram,
    e: borrow mut Effects,
    function: u32,
    s: u32,
    forbidden: u32,
    op: borrow EffectOp,
    context: u32,
    typ: u32,
    named: u32,
) -> Result<void, AllocError> {
    if (forbidden == 0) {
        return Ok();
    }
    let effect =
        if ((forbidden &
            sleepEffect()) != 0) sleepEffect() else if ((forbidden &
            allocEffect()) != 0) allocEffect() else suspendEffect();
    let source = n.functions[function as usize].source;
    if (context == contextOfFunction() && op.function != none() &&
        c.hir.functions[op.function as usize].asyncInstanceOf != none()) {
        return Ok(); // an async instance reports what it does itself, at the call that made it (ADR 0037 §3.4)
    }
    let instance = c.hir.functions[source as usize].asyncInstanceOf != none();
    var message = Vector<u8>.create();
    if (context == contextOfFunction() && instance && c.hir.functions[source as usize].context == 0) {
        appendDescribedFunction(c, source, mut message)?;
        appendText(
            mut message,
            " is called with an async closure, so it runs as a task, which must not block its thread (type-system.md §32.5, §40.1)",
        )?;
    } else if (context == contextOfFunction()) {
        appendDescribedFunction(c, source, mut message)?;
        let declaredContext = c.hir.functions[source as usize].context;
        appendText(
            mut message,
            if (declaredContext == 2) " is @context(irq)"
                else if (declaredContext == 1) " is @context(atomic)"
                else " is an async fn, which must not block its thread (type-system.md §40.1)",
        )?;
    } else if (context == contextLive()) {
        appendText(mut message, "a ")?;
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " is live here, which makes this an atomic context (type-system.md §32.3)")?;
    } else if (context == contextBound()) {
        var declared = c.hir.functions[source as usize].declaredEffects;
        if (declared == none()) {
            declared = 0;
        }
        if (c.hir.functions[source as usize].isClosure) {
            appendText(mut message, "this closure's type has the effect list @effects(")?;
            appendEffectNames(mut message, declared)?;
            appendText(mut message, ") (type-system.md §36.3)")?;
        } else {
            appendDescribedFunction(c, source, mut message)?;
            appendText(mut message, " is declared @effects(")?;
            appendEffectNames(mut message, declared)?;
            appendText(mut message, ")")?;
        }
    } else {
        appendDescribedFunction(c, named, mut message)?;
        appendText(mut message, " is used as a ")?;
        appendQuotedType(mut message, c, typ)?;
    }
    appendText(
        mut message,
        if (effect == sleepEffect()) ", but this may sleep: it "
            else if (effect == allocEffect()) ", but this may allocate: it "
            else ", but this may suspend: it ",
    )?;
    explainOp(c, e, op, effect, mut message)?;
    var file = c.hir.functions[source as usize].file;
    var span = n.statementSpans[s as usize];
    if (instance) {
        // At the call that made the instance: its code may be the library's (ADR 0037 §3.4).
        file = c.hir.functions[source as usize].siteFile;
        span = Span {
            start: c.hir.functions[source as usize].siteStart,
            end: c.hir.functions[source as usize].siteEnd,
        };
    }
    for (r in e.reported.view()) {
        if (r.file == file && r.start == span.start && sameBytes(r.message.view(), message.view())) {
            return Ok();
        }
    }
    e.reported.push(EffectReport { file: file, start: span.start, message: copyBytes(message.view())? })?;
    return c.front.diagnostics.error(effectViolation(), file, span.start, span.end, message);
}

fn checkFunctionEffects(
    c: borrow mut Checker,
    n: borrow NirProgram,
    e: borrow mut Effects,
    function: u32,
) -> Result<void, AllocError> {
    e.current = function;
    originsOf(c, n, e, function)?;
    let source = n.functions[function as usize].source;
    let context = c.hir.functions[source as usize].context;
    // atomic forbids sleep and suspend, irq every effect (§32.3); an async fn's body must not block (§40.1).
    var contextForbids =
        if (context == 1) sleepEffect() | suspendEffect() else if (context == 2) maskEffects() else 0;
    if (isAsyncFunction(c, source)) {
        contextForbids = contextForbids | sleepEffect();
    }
    let declared = c.hir.functions[source as usize].declaredEffects;
    let boundForbids = if (isExternFunction(
        c,
        source,
    ) || declared == none()) 0 else maskEffects() & (maskEffects() ^ declared);
    let localCount = n.functions[function as usize].locals.length;
    var holders = Vector<bool>.create();
    var anyHolder = false;
    for (k in 0..localCount) {
        let holds = holdsAtomic(c, e, n.functions[function as usize].locals[k].typ)?;
        holders.push(holds)?;
        if (holds) {
            anyHolder = true;
        }
    }
    var liveIn = Vector<Vector<bool>>.create();
    if (anyHolder) {
        liveIn = liveHolders(n, function, holders)?;
    }
    // A RefCell guard live where the task may suspend is N0405 (ADR 0084 §2.6), in the program's own async code.
    var guards = Vector<bool>.create();
    var anyGuard = false;
    if (isAsyncFunction(c, source) && !c.hir.functions[source as usize].library) {
        for (k in 0..localCount) {
            let holds = holdsCellGuard(c, n.functions[function as usize].locals[k].typ, 0);
            guards.push(holds)?;
            if (holds) {
                anyGuard = true;
            }
        }
    }
    var guardsIn = Vector<Vector<bool>>.create();
    if (anyGuard) {
        guardsIn = liveHolders(n, function, guards)?;
    }
    let blockCount = n.functions[function as usize].blocks.length;
    for (position in 0..blockCount) {
        var live = if (anyHolder) copyBools(liveIn[position])? else Vector<bool>.create();
        var liveGuards = if (anyGuard) copyBools(guardsIn[position])? else Vector<bool>.create();
        let statementCount = n.functions[function as usize].blocks[position].statements.length;
        for (i in 0..statementCount) {
            let s = n.functions[function as usize].blocks[position].statements[i];
            if (anyGuard) {
                guardAcrossSuspension(c, n, e, function, s, guards, liveGuards)?;
                transferHolders(n, mut liveGuards, s, guards)?;
            }
            var firstLive: u32 = none();

            if (anyHolder) {
                var killed = Vector<u32>.create();
                killedHolders(n, s, holders, mut killed)?;
                for (k in 0..localCount) {
                    if (live[k] && !containsU32(killed, truncate<u32>(k))) {
                        firstLive = truncate<u32>(k);
                        break;
                    }
                }
            }
            let guarded = if (firstLive != none()) sleepEffect() | suspendEffect() else 0;
            let liveType =
                if (firstLive != none()) n.functions[function as usize].locals[firstLive as usize].typ else none();
            var ops = Vector<EffectOp>.create();
            statementOperations(c, n, e, s, mut ops)?;
            for (op in ops.view()) {
                reportEffect(
                    c,
                    n,
                    e,
                    function,
                    s,
                    op.effects & contextForbids,
                    op,
                    contextOfFunction(),
                    none(),
                    none(),
                )?;
                reportEffect(
                    c,
                    n,
                    e,
                    function,
                    s,
                    op.effects & guarded & (maskEffects() ^ contextForbids),
                    op,
                    contextLive(),
                    liveType,
                    none(),
                )?;
                reportEffect(c, n, e, function, s, op.effects & boundForbids, op, contextBound(), none(), none())?;
            }
            // A named function given a type with an effect list must have no other effects (§36.3). A closure body is
            // bounded by its type's list instead, and checked as a function.
            let value = match (n.statements[s as usize]) {
                NirStatement.Assign(_, v) => v,
                NirStatement.Eval(v) => v,
                _ => none(),
            };
            if (value != none()) {
                match (n.rvalues[value as usize]) {
                    NirRvalue.FunctionAddress(target) => {
                        let typ = n.rvalueTypes[value as usize];
                        if ((c.types.is(typ, TypeKind.Function) || c.types.is(typ, TypeKind.Closure)) &&
                            !c.hir.functions[target as usize].isClosure) {
                            let op = effectOp(0, opNames(), none(), target, target);
                            let forbidden = effectsAsValue(c, e, target) & (maskEffects() ^ c.types.info(typ).effects);
                            reportEffect(c, n, e, function, s, forbidden, op, contextValue(), typ, target)?;
                        }
                    }
                    _ => {}
                }
            }
            if (anyHolder) {
                transferHolders(n, mut live, s, holders)?;
            }
        }
    }
    return Ok();
}

/// EffectChecker.Check: inference over every compiled function, then each one checked.
fn checkEffects(c: borrow mut Checker, n: borrow NirProgram) -> Result<void, AllocError> {
    var e = Effects {
        functions: Vector<u32>.create(),
        inferred: Vector<InferredEffects>.create(),
        dropEffects: Vector<DropEffect>.create(),
        round: 0,
        holdsAtomic: Vector<u32>.create(),
        origins: Vector<Origins>.create(),
        current: none(),
        reported: Vector<EffectReport>.create(),
        lengths: Vector<Vector<u32>>.create(),
    };
    for (k in 0..n.functions.length) {
        if (!functionIsGeneric(c, n.functions[k].source)) {
            e.functions.push(truncate<u32>(k))?;
        }
        e.origins.push(
            Origins {
                computed: false,
                literalLocals: Vector<u32>.create(),
                literalBodies: Vector<u32>.create(),
                ownLocals: Vector<bool>.create(),
                staticLocals: Vector<bool>.create(),
            },
        )?;
    }
    for (k in 0..c.hir.functions.length) {
        e.inferred.push(
            InferredEffects {
                present: false,
                effects: 0,
                hasSleep: false,
                sleep: blankOp(),
                hasAlloc: false,
                hasSuspend: false,
                alloc: blankOp(),
                suspend: blankOp(),
                hasWrite: false,
                write: blankOp(),
            },
        )?;
    }
    seedRecordedEffects(c, mut e); // the effects of bodies an interface record stands for (ADR 0082 §2.7)
    inferEffects(c, n, mut e)?;
    chooseWitnesses(c, n, mut e)?;
    if (c.recording) {
        recordEffects(c, e)?;
    }
    c.effectsRecorded = true;
    for (k in 0..e.functions.length) {
        let function = e.functions[k];
        checkFunctionEffects(c, n, mut e, function)?;
    }
    checkDebugAsserts(c, n, mut e)?; // N0360 (ADR 0087 §2.5)
    return Ok();
}

/// A constant operand's value (a builtin's type or function argument), or none.
fn constOperandValue(n: borrow NirProgram, operand: u32) -> u32 => match (n.operands[operand as usize]) {
    NirOperand.Const(v) => truncate<u32>(v.magnitude),
    _ => none(),
};

/// The effects of taking a frame from `allocator` and giving it back: a user allocator's methods (§30), else the heap's.
fn allocatorOperations(
    c: borrow Checker,
    e: borrow Effects,
    allocator: u32,
    out: borrow mut Vector<EffectOp>,
) -> Result<void, AllocError> {
    let s = if (allocator == none()) none() else c.types.info(allocator).structDef;
    if (s != none() && c.types.structs[s as usize].allocateMethod != none()) {
        let allocate = c.types.structs[s as usize].allocateMethod;
        let deallocate = c.types.structs[s as usize].deallocateMethod;
        let allocating = effectsOf(c, e, allocate);
        if (allocating != 0) {
            out.push(effectOp(allocating, opCall(), none(), allocate, allocate))?;
        }
        if (deallocate != none()) {
            let freeing = effectsOf(c, e, deallocate);
            if (freeing != 0) {
                out.push(effectOp(freeing, opCall(), none(), deallocate, deallocate))?;
            }
        }
        return Ok();
    }
    out.push(textOp(allocEffect(), 10))?;
    return Ok();
}

// ---- RefCell guards live across a suspension (ADR 0084 §2.6) ----

/// Does a value of this type hold a lib/core `CellRef` or `CellRefMut` (a RefCell guard, type-system.md §41.3): the
/// guard itself, or a struct (a closure's environment included), enum, optional, array, box, vector or slot map holding
/// one? A guard reached only through a reference is held by the place the reference points to, a local of its own.
fn holdsCellGuard(c: borrow Checker, typ: u32, depth: u32) -> bool {
    if (depth > 16) {
        return false;
    }
    let info = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Struct)) {
        let definition = info.structDef;
        let file = c.types.structs[definition as usize].file;
        let name = c.typeName(typ);
        if (file != none() && c.fileIsLibrary[file as usize] &&
            ((name.length > 8 && sameText(name[0..8], "CellRef<")) ||
                (name.length > 11 && sameText(name[0..11], "CellRefMut<")))) {
            return true;
        }
        for (field in c.types.structs[definition as usize].fields.view()) {
            if (holdsCellGuard(c, c.types.fields[field as usize].typ, depth + 1)) {
                return true;
            }
        }
        return false;
    }
    if (c.types.is(typ, TypeKind.Enum)) {
        let definition = info.enumDef;
        let option = c.types.enums[definition as usize].optionType;
        if (option != none()) {
            return holdsCellGuard(c, option, depth + 1);
        }
        for (variant in c.types.enums[definition as usize].variants.view()) {
            for (field in c.types.variants[variant as usize].payload.view()) {
                if (holdsCellGuard(c, c.types.fields[field as usize].typ, depth + 1)) {
                    return true;
                }
            }
        }
        return false;
    }
    if (c.types.is(typ, TypeKind.Array) || c.types.is(typ, TypeKind.SlotMap)) {
        return info.element != none() && holdsCellGuard(c, info.element, depth + 1);
    }
    if (c.types.is(typ, TypeKind.Box)) {
        return info.pointee != none() && holdsCellGuard(c, info.pointee, depth + 1);
    }
    if ((c.types.is(typ, TypeKind.Vector) || c.types.is(typ, TypeKind.StableVector)) && info.pointee != none()) {
        let element = c.types.info(info.pointee).element; // the unsized [T]'s T
        return element != none() && holdsCellGuard(c, element, depth + 1);
    }
    return false;
}

/// N0405, a warning: statement `s` may suspend the task while a guard local is live, so another task resumed meanwhile
/// panics on the same cell ("cell already borrowed").
fn guardAcrossSuspension(
    c: borrow mut Checker,
    n: borrow NirProgram,
    e: borrow mut Effects,
    function: u32,
    s: u32,
    guards: borrow Vector<bool>,
    live: borrow Vector<bool>,
) -> Result<void, AllocError> {
    var killed = Vector<u32>.create();
    killedHolders(n, s, guards, mut killed)?;
    var first: u32 = none();
    for (k in 0..live.length) {
        if (live[k] && !containsU32(killed, truncate<u32>(k))) {
            first = truncate<u32>(k);
            break;
        }
    }
    if (first == none()) {
        return Ok();
    }
    var ops = Vector<EffectOp>.create();
    statementOperations(c, n, e, s, mut ops)?;
    var suspends = false;
    for (op in ops.view()) {
        if ((op.effects & suspendEffect()) != 0) {
            suspends = true;
        }
    }
    if (!suspends) {
        return Ok();
    }
    let source = n.functions[function as usize].source;
    let file = c.hir.functions[source as usize].file;
    let span = n.statementSpans[s as usize];
    var message = Vector<u8>.create();
    appendText(mut message, "a RefCell guard, ")?;
    appendQuotedType(mut message, c, n.functions[function as usize].locals[first as usize].typ)?;
    appendText(
        mut message,
        ", is live where the task may suspend: another task resumed meanwhile panics on the same cell; drop the guard before the 'await' (type-system.md §41.3; ADR 0084 §2.6)",
    )?;
    return c.front.diagnostics.warning(guardAcrossAwait(), file, span.start, span.end, message);
}

fn guardAcrossAwait() -> u32 => 405; // its own code since ADR 0132 (N0402 is the unused `Result`, ADR 0105)
