// Patterns (formatting.md §4, ADR 0085): guards, or-patterns, ranges, `@`, names, strings and slices, `is`.
fn f(o: u32?) -> u32 {
    match (o) {
        Some(n) if (n > 3) => { return n; }
        Some(n) if (n == 0) => {
            return 1;
        }
        _ => {}
    }
    return match (o) { Some(n) if (n > 1) => n, _ => 0 };
}

fn g(c: u8, o: u32?) -> bool {
    match (o) {
        Some(1 | 2) | null => {}
        | Some(3) | Some(4) => {}
        _ => {}
    }
    return match (c) { ' ' | '\t' | '\n' => true, _ => false };
}

fn h(c: u8, x: i32) -> u32 {
    match (x) {
        -10..=-1 => {}
        0..10 => {}
        _ => {}
    }
    return match (c) { 'a'..='z' | '0'..'9' => 1, _ => 0 };
}

fn k(c: u8, r: Result<u8, u8>) -> u32 {
    match (r) {
        Ok(d @ '0'..='9') => {}
        whole @ Err(_) => {}
        _ => {}
    }
    return match (c) { q @ ('"' | '\'') => 1, _ => 0 };
}

fn m(c: u8) -> u32 => match (c) { LF => 1, var other => 0 };

fn n(s: Slice<u8>, w: StringView) -> u32 {
    match (s) {
        [] => {}
        ['"', inner @ .., '"'] => {}
        [a, .., z] => {}
        [rest @ .., 0] => {}
        _ => {}
    }
    return match (w) { "get" | "put" => 1, _ => 0 };
}

fn p(c: u8, o: u32?) -> bool {
    if (o is Some(n) && n > 3) {
        return true;
    }
    while (o is Some(_)) {}
    return c is 'a'..='z' | '_';
}
