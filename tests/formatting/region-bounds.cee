// Bounds on region parameters (type-system.md §25.8): kept as written, one space after the colon and around `+`.
fn pick<region a,region b:a>(x: StringView<a>, y: StringView<b>) -> StringView<a> => x;
fn either<region a, region b, region c  :  a+b, T:Copy>(x: StringView<a>, y: StringView<b>, z: StringView<c>, t: T) {}
struct Parser<region scratch,
    region input: scratch> {
    text: StringView<input>;
    fn label<region l:scratch>(borrow this, name: StringView<l>) -> StringView<scratch> => name;
}
enum Source<region a, region b :a> { Near(StringView<a>), Far(StringView<b>) }
impl<region scratch, region input:scratch> Parser<scratch, input> {
    fn first(borrow this) -> StringView<input> => this.text;
}
fn longest<region first, region second: first, region third: first + second, region fourth: first + second + third>(a: StringView<first>, b: StringView<second>, c: StringView<third>, d: StringView<fourth>) -> StringView<first> => d;
