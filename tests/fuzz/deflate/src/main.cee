// A mutational fuzzer for lib/std's deflate decoder and encoder (ADR 0196 §4.3), built natively with ASan and UBSan:
//
//   ceesafec build --cflag -fsanitize=address,undefined --cflag -fno-sanitize-recover=all
//   CEESAFE_FUZZ_SECONDS=600 CEESAFE_FUZZ_SEED=1 out/fuzz_deflate
//
// (CEESAFE_FUZZ_SECONDS defaults to 60, CEESAFE_FUZZ_SEED to 1; CEESAFE_ALLOC_REPORT=1 checks that nothing leaks.)
// Seeds: streams Python's zlib wrote (raw deflate at level 1, level 9 with fixed codes, Huffman only and RLE; zlib
// and gzip framing), and lib/std's own output at every level. Each mutant (bits flipped, bytes changed, inserted,
// deleted, repeated, zeroed, the end cut) is decoded, and none of these may fail:
//  1. no input panics the decoder, nor makes the sanitizers report (either ends the run by itself);
//  2. the output is never above the limit, and a refused input leaves `out` as it was;
//  3. decoded in steps of random sizes, in and out, a mutant gives what the whole-buffer call gives: the same bytes,
//     or the same refusal;
//  4. raw deflate: CosmoStore's decoder (src/puff.cee, zlib's `puff` algorithm, a second implementation) gives the
//     same bytes, or both refuse;
//  5. now and then, random and structured data at a random level and format, compressed whole or streamed with sync
//     flushes, decodes to itself, and its stream joins the seeds.
// A broken invariant prints the input in hex and exits 1.

/// xorshift64*.
struct Rng {
    s: u64;

    fn next(borrow mut this) -> u64 {
        this.s = this.s ^ (this.s >> 12);
        this.s = this.s ^ (this.s << 25);
        this.s = this.s ^ (this.s >> 27);
        return this.s.wrappingMul(2685821657736338717);
    }

    fn below(borrow mut this, n: usize) -> usize => if (n == 0) 0 else truncate<usize>(this.next() % (n as u64));
}

fn setting(name: StringView, otherwise: u64) -> u64 {
    let text = match (Environment.variable(name)) {
        Some(t) => t,
        null => { return otherwise; },
    };
    return text.parseInt<u64>() ?? otherwise;
}

fn fail(what: StringView, format: u8, input: Slice<u8>) -> never {
    Console.write("fuzz_deflate: invariant broken: ");
    Console.writeLine(what);
    Console.write("format ");
    Console.writeLine(format);
    var line = Vector<u8>.create();
    let digits = "0123456789abcdef".bytes();
    for (b in input) {
        let _ = line.push(digits[(b >> 4) as usize]);
        let _ = line.push(digits[(b & 15) as usize]);
    }
    Console.writeLine(StringView.fromUtf8(line.view()) ?? "");
    Process.exit(1);
}

fn hexDigit(c: u8) -> u8 => if (c >= 97) c - 87 else c - 48;

fn unhex(pieces: Slice<StringView>) -> Vector<u8> {
    var v = Vector<u8>.create();
    for (p in pieces) {
        let b = p.bytes();
        var k: usize = 0;
        while (k + 1 < b.length) {
            v.push((hexDigit(b[k]) << 4) | hexDigit(b[k + 1]))!;
            k += 2;
        }
    }
    return v;
}

struct Seed {
    format: u8;
    bytes: Vector<u8>;
}

fn formatOf(code: u8) -> DeflateFormat {
    if (code == 1) { return DeflateFormat.Zlib; }
    if (code == 2) { return DeflateFormat.Gzip; }
    return DeflateFormat.Raw;
}

fn codeOf(r: Result<void, DecodeError>) -> u32 => match (r) {
    Ok() => 0,
    Err(e) => match (e) {
        DecodeError.Malformed => 1,
        DecodeError.TooLarge => 2,
        DecodeError.Unsupported => 3,
        DecodeError.ChecksumMismatch => 4,
        DecodeError.OutOfMemory(_) => 5,
    },
};

fn same(a: Slice<u8>, b: Slice<u8>) -> bool => a == b;

fn whole(format: u8, input: Slice<u8>, limit: usize, out: borrow mut Vector<u8>) -> Result<void, DecodeError> {
    if (format == 1) { return Zlib.decompress(input, limit, out); }
    if (format == 2) { return Gzip.decompress(input, limit, out); }
    return Deflate.decompress(input, limit, out);
}

/// How a stream decoded in steps ended: the result, and the input read when it was done.
struct Stepped {
    result: Result<void, DecodeError>;
    read: usize;
}

/// Decodes in steps of random sizes. With `exact`, bytes after the stream (after the last gzip member) are refused,
/// as the whole-buffer calls refuse them; without, decoding stops at the end of the stream.
fn stepped(
    rng: borrow mut Rng,
    format: u8,
    input: Slice<u8>,
    limit: usize,
    exact: bool,
    out: borrow mut Vector<u8>,
) -> Stepped {
    var inflater = match (Inflater.create(formatOf(format), limit as u64)) {
        Ok(i) => i,
        Err(e) => { return Stepped { result: Err(DecodeError.OutOfMemory(e)), read: 0 }; },
    };
    var buffer = [0u8; 1024];
    var at: usize = 0;
    while (true) {
        let size = 1 + rng.below(if (rng.below(4) == 0) 3 else 700);
        let room = 1 + rng.below(if (rng.below(4) == 0) 3 else 1023);
        let end = if (input.length - at < size) input.length else at + size;
        let chunk = input[at..end];
        let p = match (inflater.step(chunk, mut buffer[0..room])) {
            Ok(p) => p,
            Err(e) => { return Stepped { result: Err(e), read: at }; },
        };
        if (p.read > chunk.length || p.written > room) { fail("a step read or wrote past its slices", format, input); }
        match (out.extend(buffer[0..p.written])) {
            Ok() => {}
            Err(e) => { return Stepped { result: Err(DecodeError.OutOfMemory(e)), read: at }; }
        }
        at += p.read;
        if (p.done) {
            if (!exact || at == input.length) { return Stepped { result: Ok(), read: at }; }
            if (format != 2) { return Stepped { result: Err(DecodeError.Malformed), read: at }; }
        } else if (p.read == 0 && p.written == 0 && end == input.length) {
            return Stepped { result: Err(DecodeError.Malformed), read: at };
        }
    }
    return Stepped { result: Ok(), read: at };
}

/// Random bytes, runs, and copies of earlier bytes from up to 40,000 back: data an encoder finds matches in.
fn structured(rng: borrow mut Rng, out: borrow mut Vector<u8>) {
    let n = if (rng.below(8) == 0) rng.below(150000) else rng.below(3000);
    let alphabet = 2 + rng.below(255);
    while (out.length < n) {
        let kind = rng.below(4);
        if (kind == 0 || out.length < 4) {
            for (k in 0..1 + rng.below(30)) {
                out.push(truncate<u8>(rng.below(alphabet)))!;
            }
        } else if (kind == 1) {
            let b = truncate<u8>(rng.below(alphabet));
            for (k in 0..1 + rng.below(400)) {
                out.push(b)!;
            }
        } else {
            let back = 1 + rng.below(if (out.length < 40000) out.length else 40000);
            let length = 3 + rng.below(300);
            for (k in 0..length) {
                let b = out[out.length - back];
                out.push(b)!;
            }
        }
    }
    out.truncate(n);
}

fn mutate(rng: borrow mut Rng, from: Slice<u8>, out: borrow mut Vector<u8>) {
    out.extend(from)!;
    let edits = 1 + rng.below(if (rng.below(3) == 0) 12 else 3);
    for (e in 0..edits) {
        let n = out.length;
        let kind = rng.below(8);
        if (n == 0 || kind == 0) {
            let at = rng.below(n + 1);
            out.insert(at, truncate<u8>(rng.next()))!;
        } else if (kind == 1) {
            let at = rng.below(n);
            out[at] ^= truncate<u8>(1u64 << (rng.next() % 8));
        } else if (kind == 2) {
            let at = rng.below(n);
            out[at] = truncate<u8>(rng.next());
        } else if (kind == 3) {
            let at = rng.below(n);
            let count = 1 + rng.below(if (n - at < 16) n - at else 16);
            for (k in 0..count) {
                let _ = out.remove(at);
            }
        } else if (kind == 4) {
            out.truncate(rng.below(n));
        } else if (kind == 5) {
            let at = rng.below(n);
            let count = 1 + rng.below(if (n - at < 64) n - at else 64);
            let to = rng.below(out.length + 1);
            for (k in 0..count) {
                let b = out[at + k];
                out.insert(to + k, b)!;
            }
        } else if (kind == 6) {
            let at = rng.below(n);
            let count = 1 + rng.below(if (n - at < 8) n - at else 8);
            let b: u8 = if (rng.below(2) == 0) 0 else 255;
            for (k in 0..count) {
                out[at + k] = b;
            }
        } else {
            // A bit flipped in the first bytes, where the headers are.
            let at = rng.below(if (n < 12) n else 12);
            out[at] ^= truncate<u8>(1u64 << (rng.next() % 8));
        }
    }
}

fn encodeWhole(format: u8, input: Slice<u8>, level: u32, out: borrow mut Vector<u8>) {
    if (format == 1) {
        Zlib.compress(input, level, out)!;
    } else if (format == 2) {
        Gzip.compress(input, level, out)!;
    } else {
        Deflate.compress(input, level, out)!;
    }
}

fn encodeStreamed(rng: borrow mut Rng, format: u8, input: Slice<u8>, level: u32, out: borrow mut Vector<u8>) {
    var d = Deflater.create(formatOf(format), level)!;
    var at: usize = 0;
    while (at < input.length) {
        let size = 1 + rng.below(if (rng.below(3) == 0) 20 else 20000);
        let end = if (input.length - at < size) input.length else at + size;
        d.update(input[at..end], out)!;
        at = end;
        if (rng.below(4) == 0) { d.flush(out)!; }
    }
    d.finish(out)!;
}

/// Invariant 5: random data at a random level and format decodes to itself; returns the stream.
fn roundTrip(rng: borrow mut Rng, format: u8, level: u32, out: borrow mut Vector<u8>) {
    var data = Vector<u8>.create();
    structured(rng, mut data);
    if (rng.below(2) == 0) {
        encodeWhole(format, data.view(), level, out);
    } else {
        encodeStreamed(rng, format, data.view(), level, out);
    }
    var back = Vector<u8>.create();
    let r = whole(format, out.view(), data.length, mut back);
    if (codeOf(r) != 0 || !same(back.view(), data.view())) { fail("a round trip, decoded whole", format, data.view()); }
    var again = Vector<u8>.create();
    let s = stepped(rng, format, out.view(), data.length, true, mut again);
    if (codeOf(s.result) != 0 || !same(again.view(), data.view())) {
        fail("a round trip, decoded in steps", format, data.view());
    }
}

/// Invariants 2 to 4 for one input.
fn check(rng: borrow mut Rng, format: u8, input: Slice<u8>) {
    let limit = if (rng.below(4) == 0) rng.below(3000) else 1 << 20;
    var a = Vector<u8>.create();
    a.push(7)!; // something already in `out`, which must survive
    let ra = whole(format, input, limit, mut a);
    let ca = codeOf(ra);
    if (a.length - 1 > limit) { fail("more output than the limit", format, input); }
    if (a[0] != 7) { fail("the bytes before the output changed", format, input); }
    if (ca != 0 && a.length != 1) { fail("a refusal left output behind", format, input); }
    var b = Vector<u8>.create();
    let sb = stepped(rng, format, input, limit, true, mut b);
    let cb = codeOf(sb.result);
    if (b.length > limit) { fail("more output than the limit, in steps", format, input); }
    if (ca != cb) { fail("in steps, another result", format, input); }
    if (ca == 0 && !same(a[1..], b.view())) { fail("in steps, other bytes", format, input); }
    if (format == 0) {
        var c = Vector<u8>.create();
        let sc = stepped(rng, 0, input, limit, false, mut c);
        var p = Vector<u8>.create();
        let ok = match (puffInflate(input, limit, mut p)) {
            Ok() => true,
            Err(_) => false,
        };
        let ours = codeOf(sc.result) == 0;
        if (ours != ok) {
            fail(if (ours) "puff refuses what lib/std decodes" else "puff decodes what lib/std refuses", 0, input);
        }
        if (ours && !same(c.view(), p.view())) { fail("puff decodes other bytes", 0, input); }
    }
}

fn main() {
    let seconds = setting("CEESAFE_FUZZ_SECONDS", 60);
    let seed = setting("CEESAFE_FUZZ_SEED", 1);
    var rng = Rng { s: seed.wrappingMul(2654435761).wrappingAdd(1) };
    var seeds = Vector<Seed>.create();
    // zlib's level 1
    let s1 = [
        "0bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7eb29",
        "848c2a2637341898d93879f8854425a4e51455d4b5740d8ccd2c6dec9d5c3dbcfd0243c2a3621392d33273f2",
        "8b4a2baaeb1a5bdabb7a274c9e3673cefc454b57ac5eb771cbf65d7b0f1c3e76f2ccf94b576fdcbef7f0c9f3",
        "576f3f7cfef6f3cfffc4a464184a8131802234670300",
    ];
    seeds.push(Seed { format: 0, bytes: unhex(s1[..]) })!;
    // zlib's level 9 fixed
    let s4 = [
        "0bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7eb29",
        "848c2a26573103331b270fbf90a884b49ca28aba96ae81b199a58dbd93ab87b75f604878546c42725a664e7e",
        "516945755d634b7b57ef84c9d366ce99bf68e98ad5eb366ed9be6bef81c3c74e9e397fe9ea8ddbf71e3e79fe",
        "eaed87cfdf7efef99f98940c4329f4640300",
    ];
    seeds.push(Seed { format: 0, bytes: unhex(s4[..]) })!;
    // zlib's Huffman only
    let s7 = [
        "05c10d04165b1006e04b5c22e212117923225a1111111111114b4434336776cffece7e67f7ec5f4444444444",
        "44444444444444444444444444444444c4ed7952afd8c4422a70b0a9456633cad8743d6cd480c12b6a5a1738",
        "cb13a45eb1898554e060538bcc6694b1e97ad8a8018357d4b42e70962748bd62130ba9c0c1a61699cd2863d3",
        "f5b0510306afa8695de02c4f907ac526165281834d2d329b51c6a6eb61a3060c5e51d3bac0599e20f58a4d2c",
        "a402079b5a6436a38c4dd7c3460d18bca2a67581b33c41ea159b5848050e36b5c86c46199bae878d1a307845",
        "4deb02677982d42b36b1900a1c6c6a91d98c32365d0f1b3560f08a9ad605cef204a9576c62211538d8d422b3",
        "19656cba1e366ac0e01535ad0b9ce509fed9f2efd66ddbffdbb173d7ee3d7bf7ed3f70f0d0e123478f1d3f71",
        "f2d4e933e9d973e72f4856d416e27cf1d2e52b57af5dbf71f3d6ed3b77efdd7ff0f0d1e3274f9f3d7ff1f2d5",
        "eb376fdfbdfff0f1d3e72f5fbf7dfff1f3d7ef3fff130bb1100bb1231662211662472cc4422cc48e58888558",
        "881db1100bb1103b622116622176c4422cc442ec8885588885d8110bb1100bb1231662211662f717",
    ];
    seeds.push(Seed { format: 0, bytes: unhex(s7[..]) })!;
    // zlib's RLE
    let s10 = [
        "05c10d04165b1006e04b5c22e212117923225a1111111111114b4434336776cffece7e67f7ec5f4444444444",
        "44444444444444444444444444444444c4ed7952afd8c4422a70b0a9456633cad8743d6cd480c12b6a5a1738",
        "cb13a45eb1898554e060538bcc6694b1e97ad8a8018357d4b42e70962748bd62130ba9c0c1a61699cd2863d3",
        "f5b0510306afa8695de02c4f907ac526165281834d2d329b51c6a6eb61a3060c5e51d3bac0599e20f58a4d2c",
        "a402079b5a6436a38c4dd7c3460d18bca2a67581b33c41ea159b5848050e36b5c86c46199bae878d1a307845",
        "4deb02677982d42b36b1900a1c6c6a91d98c32365d0f1b3560f08a9ad605cef204a9576c62211538d8d422b3",
        "19656cba1e366ac0e01535ad0b9ce509fed9f2efd66ddbffdbb173d7ee3d7bf7ed3f70f0d0e123478f1d3f71",
        "f2d4e933e9d973e72f4856d416e27cf1d2e52b57af5dbf71f3d6ed3b77efdd7ff0f0d1e3274f9f3d7ff1f2d5",
        "eb376fdfbdfff0f1d3e72f5fbf7dfff1f3d7ef3fff130bb1100bb1231662211662472cc4422cc48e58888558",
        "881db1100bb1103b622116622176c4422cc442ec8885588885d8110bb1100bb1231662211662f717",
    ];
    seeds.push(Seed { format: 0, bytes: unhex(s10[..]) })!;
    // zlib's zlib
    let s13 = [
        "789c0bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7",
        "eb29848c2a26573103331b270fbf90a884b49ca28aba96ae81b199a58dbd93ab87b75f604878546c42725a66",
        "4e7e516945755d634b7b57ef84c9d366ce99bf68e98ad5eb366ed9be6bef81c3c74e9e397fe9ea8ddbf71e3e",
        "79feeaed87cfdf7efef99f98940c4329f4640300344ada08",
    ];
    seeds.push(Seed { format: 1, bytes: unhex(s13[..]) })!;
    // zlib's gzip
    let s16 = [
        "1f8b08000000000000130bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014a",
        "e72456552aa4e4a7eb29848c2a26573103331b270fbf90a884b49ca28aba96ae81b199a58dbd93ab87b75f60",
        "4878546c42725a664e7e516945755d634b7b57ef84c9d366ce99bf68e98ad5eb366ed9be6bef81c3c74e9e39",
        "7fe9ea8ddbf71e3e79feeaed87cfdf7efef99f98940c4329f46403008ac6d4dc36020000",
    ];
    seeds.push(Seed { format: 2, bytes: unhex(s16[..]) })!;
    for (level in 0u32..10) {
        for (format in 0u8..3) {
            var out = Vector<u8>.create();
            roundTrip(mut rng, format, level, mut out);
            seeds.push(Seed { format: format, bytes: out })!;
        }
    }
    let start = Clock.monotonicNanos();
    var inputs: u64 = 0;
    var trips: u64 = 0;
    while (Clock.monotonicNanos() - start < seconds * 1000000000) {
        for (k in 0..64) {
            let pick = rng.below(seeds.length);
            let format = seeds[pick].format;
            var mutant = Vector<u8>.create();
            mutate(mut rng, seeds[pick].bytes.view(), mut mutant);
            check(mut rng, format, mutant.view());
            inputs += 1;
        }
        if (rng.below(4) == 0) {
            let format = truncate<u8>(rng.below(3));
            let level = truncate<u32>(rng.below(10));
            var out = Vector<u8>.create();
            roundTrip(mut rng, format, level, mut out);
            trips += 1;
            if (out.length < 200000) {
                let at = 6 + rng.below(seeds.length - 6);
                seeds[at] = Seed { format: format, bytes: out };
            }
        }
    }
    Console.write("fuzz_deflate: ");
    Console.write(inputs);
    Console.write(" inputs, ");
    Console.write(trips + 30);
    Console.write(" round trips, seed ");
    Console.write(seed);
    Console.write(", ");
    Console.write(seconds);
    Console.writeLine(" seconds: no invariant broken");
}
