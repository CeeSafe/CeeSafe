// A second snappy decoder, for the fuzzer's differential check (ADR 0196 §4.3): written from snappy's
// format_description.txt alone, as tools/oracles/snappy_model.py is, a byte at a time and onto a growing vector, so it
// shares nothing with lib/std's but the format: no preallocation, no bound on the ratio, no eight-byte copies.

/// The length a block's preamble states and the bytes it took, or a refusal.
struct ReferencePreamble {
    valid: bool;
    value: u64;
    size: usize;
}

fn referencePreamble(block: Slice<u8>) -> ReferencePreamble {
    var value: u64 = 0;
    for (k in 0..5) {
        if (k >= block.length) { break; }
        let b = block[k];
        if (k == 4 && b >= 16) { break; }
        value = value | (((b & 127) as u64) << (7 * k as u64));
        if (b < 128) { return ReferencePreamble { valid: true, value: value, size: k + 1 }; }
    }
    return ReferencePreamble { valid: false, value: 0, size: 0 };
}

/// The little-endian number in `count` bytes from `block[at..]`.
fn referenceNumber(block: Slice<u8>, at: usize, count: usize) -> u64 {
    var v: u64 = 0;
    for (k in 0..count) {
        v = v | ((block[at + k] as u64) << (8 * k as u64));
    }
    return v;
}

/// Decodes `block` onto `out` (empty), at most `limit` bytes: true if it is a valid block whose length is at most the
/// limit. A refusal may leave output behind.
fn referenceDecode(block: Slice<u8>, limit: usize, out: borrow mut Vector<u8>) -> bool {
    let p = referencePreamble(block);
    if (!p.valid || p.value > limit as u64) { return false; }
    let n = p.value;
    var at = p.size;
    while (at < block.length) {
        let tag = block[at];
        at += 1;
        var length: u64 = 0;
        if ((tag & 3) == 0) {
            length = ((tag >> 2) as u64) + 1;
            if (length > 60) {
                let extra = truncate<usize>(length - 60);
                if (block.length - at < extra) { return false; }
                length = referenceNumber(block, at, extra) + 1;
                at += extra;
            }
            if (length > n - out.length as u64 || length > (block.length - at) as u64) { return false; }
            for (k in 0..truncate<usize>(length)) {
                out.push(block[at + k])!;
            }
            at += truncate<usize>(length);
        } else {
            var offset: u64 = 0;
            if ((tag & 3) == 1) {
                if (block.length - at < 1) { return false; }
                length = 4 + (((tag >> 2) & 7) as u64);
                offset = (((tag >> 5) as u64) << 8) | (block[at] as u64);
                at += 1;
            } else if ((tag & 3) == 2) {
                if (block.length - at < 2) { return false; }
                length = ((tag >> 2) as u64) + 1;
                offset = referenceNumber(block, at, 2);
                at += 2;
            } else {
                if (block.length - at < 4) { return false; }
                length = ((tag >> 2) as u64) + 1;
                offset = referenceNumber(block, at, 4);
                at += 4;
            }
            if (offset == 0 || offset > out.length as u64 || length > n - out.length as u64) { return false; }
            for (k in 0..truncate<usize>(length)) {
                let b = out[out.length - truncate<usize>(offset)];
                out.push(b)!;
            }
        }
    }
    return out.length as u64 == n;
}
