// A mutational fuzzer for lib/std's zstd decoder (ADR 0196 §4.3), built natively with ASan and UBSan:
//
//   ceesafec build --cflag -fsanitize=address,undefined --cflag -fno-sanitize-recover=all
//   CEESAFE_FUZZ_SECONDS=600 CEESAFE_FUZZ_SEED=1 out/fuzz_zstd
//
// (CEESAFE_FUZZ_SECONDS defaults to 60, CEESAFE_FUZZ_SEED to 1; CEESAFE_ALLOC_REPORT=1 checks that nothing leaks.)
// Seeds: frames libzstd 1.5.7 wrote (levels -5 to 19, streamed with windows of 1 and 2 KiB, so that a stream
// decoder's ring wraps many times, with checksums, FSE tables of integers) and frames tools/oracles/zstd_model.py's
// writers made (Huffman literals in four streams then treeless, repeated offsets, skippable frames among frames);
// each seed's content is known by its CRC-32. Each mutant (bits flipped, bytes changed, inserted, deleted, repeated,
// zeroed, the end cut, a header byte changed) is decoded, and none of these may fail:
//  1. no input panics the decoder, nor makes the sanitizers report (either ends the run by itself);
//  2. the output is never above the limit, the bytes already in `out` are kept, and a refusal adds none;
//  3. a ZstdDecoder fed the input in steps of random sizes, into slices of random sizes, with a window limit of
//     2^17, gives the same verdict and the same bytes as `Zstd.decompress`, except that it may refuse as TooLarge a
//     frame whose window is above its limit.
// zstd has no encoder here yet (ADR 0196 phase 4), so there are no round trips. A broken invariant prints the input in
// hex and exits 1.

/// xorshift64*.
struct Rng {
    s: u64;

    fn next(borrow mut this) -> u64 {
        this.s = this.s ^ (this.s >> 12);
        this.s = this.s ^ (this.s << 25);
        this.s = this.s ^ (this.s >> 27);
        return this.s.wrappingMul(2685821657736338717);
    }

    fn below(borrow mut this, n: usize) -> usize => if (n == 0) 0 else truncate<usize>(this.next() % (n as u64));
}

fn setting(name: StringView, otherwise: u64) -> u64 {
    let text = match (Environment.variable(name)) {
        Some(t) => t,
        null => { return otherwise; },
    };
    return text.parseInt<u64>() ?? otherwise;
}

fn fail(what: StringView, input: Slice<u8>) -> never {
    Console.write("fuzz_zstd: invariant broken: ");
    Console.writeLine(what);
    var line = Vector<u8>.create();
    let digits = "0123456789abcdef".bytes();
    for (b in input) {
        let _ = line.push(digits[(b >> 4) as usize]);
        let _ = line.push(digits[(b & 15) as usize]);
    }
    Console.writeLine(StringView.fromUtf8(line.view()) ?? "");
    Process.exit(1);
}

fn hexDigit(c: u8) -> u8 => if (c >= 97) c - 87 else c - 48;

fn unhex(pieces: Slice<StringView>) -> Vector<u8> {
    var v = Vector<u8>.create();
    for (p in pieces) {
        let b = p.bytes();
        var k: usize = 0;
        while (k + 1 < b.length) {
            v.push((hexDigit(b[k]) << 4) | hexDigit(b[k + 1]))!;
            k += 2;
        }
    }
    return v;
}

/// 0 for success, else the error's code: 1 Malformed, 2 TooLarge, 3 Unsupported, 4 ChecksumMismatch, 5 OutOfMemory.
fn code(r: Result<void, DecodeError>) -> u32 => match (r) {
    Ok() => 0,
    Err(e) => match (e) {
        DecodeError.Malformed => 1,
        DecodeError.TooLarge => 2,
        DecodeError.Unsupported => 3,
        DecodeError.ChecksumMismatch => 4,
        DecodeError.OutOfMemory(_) => 5,
    },
};

/// The largest window of the frames at the start of `input` that can be walked (headers and block sizes read, nothing
/// decoded); a walk stops at anything it cannot read.
fn largestWindow(input: Slice<u8>) -> u64 {
    var at: usize = 0;
    var largest: u64 = 0;
    while (input.length - at >= 4) {
        let magic = input.readLE<u32>(at);
        if ((magic & 0xFFFFFFF0) == 0x184D2A50) {
            if (input.length - at < 8) { break; }
            let size = input.readLE<u32>(at + 4) as usize;
            if (input.length - at - 8 < size) { break; }
            at += 8 + size;
            continue;
        }
        if (magic != 0xFD2FB528 || input.length - at < 6) { break; }
        let fhd = input[at + 4];
        let single = ((fhd >> 5) & 1) == 1;
        let dictionary: usize = match (fhd & 3) {
            0 => 0,
            1 => 1,
            2 => 2,
            _ => 4,
        };
        let fcs: usize = match (fhd >> 6) {
            0 => if (single) 1usize else 0usize,
            1 => 2,
            2 => 4,
            _ => 8,
        };
        let size = 5 + (if (single) 0usize else 1) + dictionary + fcs;
        if (input.length - at < size) { break; }
        var window: u64 = 0;
        if (single) {
            let p = at + size - fcs;
            var v: u64 = 0;
            for (k in 0..fcs) {
                v = v | ((input[p + k] as u64) << truncate<u32>(8 * k));
            }
            window = if (fcs == 2) v + 256 else v;
        } else {
            let wd = input[at + 5] as u32;
            let log = 10 + (wd >> 3);
            if (log > 41) { break; }
            window = (1u64 << log) + ((1u64 << log) >> 3) * ((wd & 7) as u64);
        }
        if (window > largest) { largest = window; }
        at += size;
        var last = false;
        while (!last) {
            if (input.length - at < 3) { return largest; }
            let bh = (input[at] as u32) | ((input[at + 1] as u32) << 8) | ((input[at + 2] as u32) << 16);
            at += 3;
            last = (bh & 1) == 1;
            let n = if (((bh >> 1) & 3) == 1) 1usize else (bh >> 3) as usize;
            if (input.length - at < n) { return largest; }
            at += n;
        }
        if (((fhd >> 2) & 1) == 1) { at += if (input.length - at < 4) input.length - at else 4; }
    }
    return largest;
}

fn mutate(rng: borrow mut Rng, from: Slice<u8>, out: borrow mut Vector<u8>) {
    out.extend(from)!;
    let edits = 1 + rng.below(if (rng.below(3) == 0) 12 else 3);
    for (e in 0..edits) {
        let n = out.length;
        let kind = rng.below(8);
        if (n == 0 || kind == 0) {
            let at = rng.below(n + 1);
            out.insert(at, truncate<u8>(rng.next()))!;
        } else if (kind == 1) {
            let at = rng.below(n);
            out[at] ^= truncate<u8>(1u64 << (rng.next() % 8));
        } else if (kind == 2) {
            let at = rng.below(n);
            out[at] = truncate<u8>(rng.next());
        } else if (kind == 3) {
            let at = rng.below(n);
            let count = 1 + rng.below(if (n - at < 16) n - at else 16);
            for (k in 0..count) {
                let _ = out.remove(at);
            }
        } else if (kind == 4) {
            out.truncate(rng.below(n));
        } else if (kind == 5) {
            let at = rng.below(n);
            let count = 1 + rng.below(if (n - at < 64) n - at else 64);
            let to = rng.below(out.length + 1);
            for (k in 0..count) {
                let b = out[at + k];
                out.insert(to + k, b)!;
            }
        } else if (kind == 6) {
            let at = rng.below(n);
            let count = 1 + rng.below(if (n - at < 8) n - at else 8);
            let b: u8 = if (rng.below(2) == 0) 0 else 255;
            for (k in 0..count) {
                out[at + k] = b;
            }
        } else {
            // A byte of the frame header or the first block header.
            let at = 4 + rng.below(if (n < 16) n else 12);
            if (at < n) { out[at] = truncate<u8>(rng.next()); }
        }
    }
}

/// Decodes in steps of random sizes into slices of random sizes.
fn steps(rng: borrow mut Rng, input: Slice<u8>, limit: usize, out: borrow mut Vector<u8>) -> Result<void, DecodeError> {
    var d = ZstdDecoder.create(limit as u64, 1 << 17)?;
    var buffer = [0u8; 4096];
    var at: usize = 0;
    let most = if (rng.below(2) == 0) 16usize else 4096usize;
    while (true) {
        let si = 1 + rng.below(most);
        let so = 1 + rng.below(most);
        let end = if (input.length - at < si) input.length else at + si;
        let p = d.step(input[at..end], mut buffer[0..so])?;
        out.extend(buffer[0..p.written])!;
        at += p.read;
        if (p.done && at == input.length) { return Ok(); }
        if (!p.done && p.read == 0 && p.written == 0 && end == input.length) { return Err(DecodeError.Malformed); }
    }
    return Ok();
}

/// Invariants 2 and 3 for one input.
fn check(rng: borrow mut Rng, input: Slice<u8>) {
    let limit = if (rng.below(4) == 0) rng.below(50000) else 1 << 20;
    var a = Vector<u8>.create();
    a.push(7)!;
    let ra = code(Zstd.decompress(input, limit, mut a));
    if (a.length - 1 > limit) { fail("more output than the limit", input); }
    if (a[0] != 7) { fail("the bytes before the output changed", input); }
    if (ra != 0 && a.length != 1) { fail("a refusal left output behind", input); }
    var b = Vector<u8>.create();
    let rb = code(steps(rng, input, limit, mut b));
    if (b.length > limit) { fail("more output than the limit, in steps", input); }
    if (ra == rb) {
        if (ra == 0 && a[1..] != b.view()) { fail("the decoder in steps writes other bytes", input); }
        return;
    }
    if (rb == 2 && largestWindow(input) > (1 << 17)) { return; }
    fail("the decoder in steps gives another verdict", input);
}

