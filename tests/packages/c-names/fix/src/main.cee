// `ceesafec fix` removes a declaration identical to its dependency's, and leaves the others (ADR 0081 §2.2;
// package_tests.py §15).
extern "C" {
    /// Identical to sys's: removed.
    fn strlen(s: *CChar) -> usize;
    /// Another parameter type: kept.
    fn memcmp(a: *u8, b: *u8, n: usize) -> i32;
    /// Another `@cname`, so not identical to sys's `strlen`: kept.
    @cname("strlen")
    fn length(s: *CChar) -> usize;
}

/// Safety: the literal ends in a zero byte.
fn main() {
    let text = "hello\0";
    Console.writeLine(unsafe { sys.strlen(text.ptr as *CChar) });
}
