// A C name its dependency `sys` declares without `public`: N0201 here, and the hint to make sys's declaration public
// (ADR 0081 §2.2; package_tests.py §15).
extern "C" {
    fn abs(n: i32) -> i32;
}

/// Safety: abs only reads its argument.
fn main() {
    Console.writeLine(unsafe { abs(-3) });
}
