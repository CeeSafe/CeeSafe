// A C name its dependency `sys` declares, declared again: N0201 here, with a note at sys's declaration and the hint to
// call `sys.strlen` (ADR 0081 §2.2; package_tests.py §15).
extern "C" {
    fn strlen(s: *CChar) -> usize;
}

/// Safety: the literal ends in a zero byte.
fn main() {
    let text = "hello\0";
    Console.writeLine(unsafe { strlen(text.ptr as *CChar) });
}
