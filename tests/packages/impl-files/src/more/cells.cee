// The methods of Cells, merged from this file's `impl` block (ADR 0064 §1).
//
// tools/package_tests.py checks that a method merged from an `impl` block keeps this file as its own:
// the bounds check below must report src/more/cells.cee:24, and a diagnostic in it must name this file.
// Before the fix, the method took the struct's file (src/main.cee), and positions past that file's end
// made ceesafec panic (index out of bounds in src/support/source.cee) during check, build and run.
//
// This header is long on purpose: it puts the method's offsets past the end of src/main.cee.
// ................................................................................................
// ................................................................................................
// ................................................................................................
// ................................................................................................
// ................................................................................................
// ................................................................................................
// ................................................................................................
// ................................................................................................
// ................................................................................................

impl Cells {
    /// The cell at `i`, of three: an index past the end stops the program with its position.
    fn at(borrow this, i: usize) -> i32 {
        let cells = [10, 20, 30];
        let n = this.base;
        return n * cells[i];
    }
}
