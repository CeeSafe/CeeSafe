@effects()
fn pure(n: u64) -> u64 => mid.twice(n) + mid.calm(n);

@effects(alloc)
fn quietly(n: u64) -> u64 => mid.loud(n);

/// Through base's private helper, which its record names as a dependent does: 'base.helper'.
@effects(alloc)
fn speaks(n: u64) -> u64 => base.noisy(n);

@effects()
fn generic(n: u64) -> u64 => mid.either(n, n + 1) + base.listed(n) as u64;

@effects()
fn withClosure(n: u64) -> u64 => base.applyTwice(n, (x) => base.grow(x));

@effects()
fn shapes(n: u64) -> u64 {
    let c: Box<dyn base.Shape> = Box.create(base.Square { side: n })!;
    return c.area();
}

async fn waiting(n: u64) -> u64 => await mid.laterTwice(n);

fn main() {
    Console.writeLine(pure(3) + quietly(1) + speaks(1) + generic(2) + withClosure(1) + shapes(2) + Async.run(waiting(1)));
}
