// An `impl` block in a file of its own (ADR 0064 §1): its private function is private to this file, not to the file
// that declares the struct (ADR 0109 §2.2), so src/shapes.cee could not call it either.
impl Open {
    private fn mine(borrow this) -> i32 => 7;
    private const EXTRA: i32 = 8;
    fn viaMine(borrow this) -> i32 => this.mine() + Open.EXTRA;
}
