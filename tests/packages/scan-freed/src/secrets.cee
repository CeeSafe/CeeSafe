// The guarantees of ADR 0197 §3, each a test run with `ceesafec test --scan-freed` (natively and with --interp):
// every SecretHeap block is all zeros when it is freed, by a free, by growth or by a container's drop. Each test
// leaves its secret only in SecretHeap blocks, so no freed block may hold it, except the first two, which show what
// the scan finds: the system heap's old buffers keep the keys (CosmoStore's G42), and its freed blocks their bytes.

/// The `n`th secret of 32 distinctive bytes (keyBytes in main.cee), told apart from the others by `n`.
fn secret(n: u8) -> [u8; 32] => keyBytes(n ^ 0x80);

fn freedHoldsSecret(n: u8) -> bool {
    let bytes = secret(n);
    return Testing.freedHolds(bytes[..]);
}

@test
fn systemHeapGrowthLeavesKeys() -> Result<void, TestFailure> {
    {
        var keys = Vector<Key>.create();
        for (k in 0..16u8) {
            keys.push(Key { bytes: secret(1) })!;
        }
    }
    return Check.isTrue(freedHoldsSecret(1), "the system heap's old buffers keep the keys (G42)");
}

@test
fn systemHeapFreeKeepsBytes() -> Result<void, TestFailure> {
    {
        var one = Vector<[u8; 32]>.create();
        one.push(secret(2))!;
    }
    return Check.isTrue(freedHoldsSecret(2), "a system heap block's bytes are left when it is freed");
}

@test
fn secretVectorGrowthAndDrop() -> Result<void, TestFailure> {
    {
        var keys = Vector<Key, SecretHeap>.create();
        for (k in 0..64u8) {
            keys.push(Key { bytes: secret(3) })!;
        }
    }
    return Check.isFalse(freedHoldsSecret(3), "a secret vector's old buffers and its last");
}

@test
fn secretVectorGivesSlotsUp() -> Result<void, TestFailure> {
    {
        var bytes = Vector<u8, SecretHeap>.create();
        for (round in 0..6u32) {
            bytes.extend(secret(4)[..])!;
        }
        let _ = bytes.pop();
        bytes.truncate(100);
        let _ = bytes.remove(3);
        let _ = bytes.swapRemove(0);
        bytes.resize(40, 0)!;
        bytes.retain((b: borrow u8) => *b != 0);
        bytes.clear();
        bytes.extend(secret(4)[..])!;
    }
    return Check.isFalse(freedHoldsSecret(4), "a secret vector after pop, truncate, remove, resize and clear");
}

@test
fn secretStringGrows() -> Result<void, TestFailure> {
    {
        var text = String<SecretHeap>.create();
        for (k in 0..20u32) {
            text.append("correct horse battery staple, the passphrase")!;
        }
        let copy = text.clone()!;
        let _ = copy.length;
    }
    let phrase = "correct horse battery staple, the passphrase";
    return Check.isFalse(Testing.freedHolds(phrase.bytes()), "a secret string's old buffers");
}

@test
fn secretBox() -> Result<void, TestFailure> {
    {
        let b = Box.createIn(SecretHeap {}, secret(5))!;
        let _ = b[0];
    }
    return Check.isFalse(freedHoldsSecret(5), "a secret box, freed");
}

@test
fn secretSlotMapAndStableVector() -> Result<void, TestFailure> {
    {
        var map = SlotMap<[u8; 32], SecretHeap>.create();
        var handles = Vector<Handle<[u8; 32]>>.create();
        for (k in 0..20u32) {
            handles.push(map.insert(secret(6))!)!;
        }
        for (h in handles.view()) {
            let _ = map.remove(h);
        }
        var stable = StableVector<[u8; 32], SecretHeap>.create();
        for (k in 0..40u32) {
            stable.push(secret(6))!;
        }
    }
    return Check.isFalse(freedHoldsSecret(6), "a secret slot map's and stable vector's blocks");
}

@test
fn keyHoldersInSecretBoxes() -> Result<void, TestFailure> {
    let key = secret(7);
    {
        let cipher = Box.createIn(SecretHeap {}, Aes256Gcm.create(key[..])!)!;
        var data = [0u8; 32];
        let _ = cipher.seal([0u8; 12], "".bytes(), mut data[..]);
        var mac = Box.createIn(SecretHeap {}, HmacSha256.create(key[..]))!;
        mac.update("message".bytes());
        let _ = mac.finish();
    }
    // The HMAC holds the key XOR 0x5C; the cipher's schedule begins with the key itself.
    var outer = [0u8; 32];
    for (i in 0..32usize) { outer[i] = key[i] ^ 0x5C; }
    Check.isFalse(Testing.freedHolds(key[..16]), "Aes256Gcm's schedule in a secret box")?;
    return Check.isFalse(Testing.freedHolds(outer[..]), "HmacSha256's key in a secret box");
}
