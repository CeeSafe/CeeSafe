// data-oriented (benchmarks/suite/README.md): particles as separate arrays, reflecting at the walls.
const N: usize = 1000000;
const W: i32 = 1000;

fn main() -> i32 {
    var x = Vector<i32>.create();
    var y = Vector<i32>.create();
    var vx = Vector<i32>.create();
    var vy = Vector<i32>.create();
    x.resize(N, 0)!;
    y.resize(N, 0)!;
    vx.resize(N, 0)!;
    vy.resize(N, 0)!;
    for (i in 0..N) {
        let k = truncate<i32>(i);
        x[i] = k % 1000;
        y[i] = 3 * k % 1000;
        vx[i] = k % 7 - 3;
        vy[i] = k % 5 - 2;
    }
    for (s in 0..100) {
        for (i in 0..N) {
            x[i] += vx[i];
            if (x[i] < 0) {
                x[i] = -x[i];
                vx[i] = -vx[i];
            } else if (x[i] >= W) {
                x[i] = 2 * (W - 1) - x[i];
                vx[i] = -vx[i];
            }
            y[i] += vy[i];
            if (y[i] < 0) {
                y[i] = -y[i];
                vy[i] = -vy[i];
            } else if (y[i] >= W) {
                y[i] = 2 * (W - 1) - y[i];
                vy[i] = -vy[i];
            }
        }
    }
    var sum: u64 = 0;
    for (i in 0..N) { sum += truncate<u64>(x[i] + y[i]); }
    Console.writeLine(sum);
    return 0;
}
