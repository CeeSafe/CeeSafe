// SecretHeap's blocks never go to C (ADR 0197 §2.3): `Vector.intoForeign` and `Vector.fromForeign` of a SecretHeap
// vector are N0263, since C would free the block with its own `free`, unwiped and past its header. `SecretHeap` is a
// reserved name, as the other built-in allocators' are (N0201).

struct SecretHeap {} // error[N0201]

/// Safety: the buffer goes nowhere; the call is refused.
fn give(v: Vector<u8, SecretHeap>) -> VectorParts<u8> => unsafe { Vector.intoForeign(v) }; // error[N0263]

/// Safety: the parts go nowhere; the call is refused.
fn take(p: *mut u8, n: usize) -> Vector<u8, SecretHeap> => unsafe { Vector.fromForeign(p, n, n) }; // error[N0263]

fn main() {}
