// Secret.wipe takes only a zeroable place (ADR 0197 §2.2): all zero bytes must be a value of its type, so the place
// stays readable and nothing is unsafe. An enum, an optional, a box, a vector, a reference, a type parameter and a
// struct with a `drop` or with such a field are N0365, which names the first field that is not zeroable. The argument
// is a place the call changes, written with `mut` (N0249).

struct Holder {
    id: u32;
    bytes: Vector<u8>;
}

struct Inner {
    slot: u32?;
}

struct Outer {
    n: u8;
    inner: Inner;
}

struct Keyed {
    k: [u8; 4];

    drop {}
}

enum Mode { On, Off }

fn generic<T>(x: borrow mut T) {
    Secret.wipe(mut x); // error[N0365]
}

fn main() {
    var h = Holder { id: 1, bytes: Vector<u8>.create() };
    Secret.wipe(mut h); // error[N0365]
    var o = Outer { n: 1, inner: Inner { slot: null } };
    Secret.wipe(mut o); // error[N0365]
    var k = Keyed { k: [1, 2, 3, 4] };
    Secret.wipe(mut k); // error[N0365]
    Secret.wipe(mut k.k);
    var m = Mode.On;
    Secret.wipe(mut m); // error[N0365]
    var b = Box.create(4u32)!;
    Secret.wipe(mut b); // error[N0365]
    let n: u32 = 4;
    Secret.wipe(n);      // error[N0249]
    Secret.clear(mut m); // error[N0200]
}
