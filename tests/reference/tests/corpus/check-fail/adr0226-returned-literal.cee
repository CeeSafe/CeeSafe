// ADR 0226 §2.4: a slice of an array literal is a slice of a temporary, even when the elements are constants, so it
// cannot be returned (N0244, whose message names a `static` table); the static is what works.
static TABLE: [i32; 3] = [1, 2, 3];

fn nums() -> Slice<static, i32> => [1, 2, 3][..]; // error[N0244]

fn table() -> Slice<static, i32> => TABLE[..];

fn main() {
    Console.writeLine(nums()[0] + table()[0]);
}
