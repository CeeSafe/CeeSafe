// What an array length may be (type-system.md §16.1, ADR 0083 §2.7, ADR 0143): a constant expression of type `usize`
// or a `usize` const parameter, from 1 to 2^48 − 1. A constant of another type is N0205, a run-time value N0353, a
// constant 0 or any other form (a call written bare) N0259. `SIZE + 1` was N0259 before ADR 0143.
const NARROW: u32 = 4;
const EMPTY: usize = 0;
const SIZE: usize = 4;

fn five() -> usize => 5;

fn main() {
    let a: [u8; NARROW] = [0u8; 4]; // error[N0205]
    let n: usize = 4;
    let b = [0u8; n];              // error[N0353]
    let c: [u8; EMPTY] = [0u8; 1]; // error[N0259]
    let d: [u8; SIZE + 1] = [0u8; 5];
    let f = [0u8; five()]; // error[N0259]
    let e: [u8; SIZE] = [0u8; SIZE];
}
