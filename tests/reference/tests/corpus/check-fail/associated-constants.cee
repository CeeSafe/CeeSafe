// Associated constants (type-system.md §10, ADR 0074 §2.7): none in a generic struct or impl yet (N0216); a name the
// type already has, as a field, a method, a variant or a constant, is N0228; an enum's impl holds constants only
// (N0267); `Type.NAME` without such a constant is still N0210.
struct Holder<T> {
    value: T;
    const LIMIT: u32 = 4; // error[N0216]
}

impl<T> Holder<T> {
    const OTHER: u32 = 1; // error[N0216]
}

struct Counter {
    count: u32;
    const count: u32 = 1; // error[N0228]
    const reset: u32 = 0; // error[N0228]
    const MAX: u32 = 9;

    fn reset(borrow mut this) {
        this.count = 0;
    }
}

impl Counter {
    const MAX: u32 = 10; // error[N0228]
}

enum Mode {
    Plain,
    Tls,
}

impl Mode {
    const Tls: u32 = 1; // error[N0228]
}

impl Mode { // error[N0267]
    fn port() -> u32 => 25;
}

fn main() {
    Console.writeLine(Counter.MAX);
    Console.writeLine(Counter.NOPE); // error[N0210]
}
