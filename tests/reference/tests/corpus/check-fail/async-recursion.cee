// profile: freestanding
// Recursion through `await` would make a frame contain itself (type-system.md §40.1, N0343). The freestanding profile
// has no frame stack, so it stays an error there (ADR 0056 §3.4); hosted code stacks these awaits
// (run-pass/async-recursion-stacked).

async fn walk(n: u32) -> u32 {
    if (n == 0) {
        return 0;
    }
    return await walk(n - 1) + 1; // error[N0343]
}

async fn ping(n: u32) -> u32 => if (n == 0) 0 else await pong(n - 1); // error[N0343]
async fn pong(n: u32) -> u32 => if (n == 0) 0 else await ping(n - 1); // error[N0343]
