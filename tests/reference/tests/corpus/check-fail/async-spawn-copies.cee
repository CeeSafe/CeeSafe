// What a child cannot copy (type-system.md §40.5, ADR 0033): a body local that is not Copy, or that the child
// changes, is captured by reference and ends with the body (N0344). Copied borrows: check-fail/async-spawn-loans.

async fn use(x: borrow u32) -> Result<void, AsyncError> => Ok();

async fn work(values: borrow Vector<u32>) -> Result<void, AsyncError> {
    await Async.scope(AsyncError.Cancelled, (s) => {
        var names = Vector<u32>.create();
        s.spawn(async () => { // error[N0344]
            let n = names.length;
            return Ok();
        });
        var count: u32 = 0;
        s.spawn(async () => { // error[N0344]
            count += 1;
            return Ok();
        });
    })?;
    return Ok();
}

fn main() {
    var values = Vector<u32>.create();
    match (Async.run(work(borrow values))) {
        Ok() => {}
        Err(_) => {}
    }
}
