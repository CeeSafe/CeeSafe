// A run-once body moves each capture out at most once (ADR 0074 §2.3): a second move is N0250. A boxed move literal
// may be called again, so it still cannot move a capture out (N0251). A capture whose type has a drop block cannot
// be partly moved (N0252).

struct Big { v: Vector<u8>; }
struct Guarded {
    v: Vector<u8>;
    drop {}
}

async fn serve(b: Big) -> Result<void, AsyncError> => Ok();
async fn keep(v: Vector<u8>) -> Result<void, AsyncError> => Ok();
fn eat(b: Big) {}

async fn twice() -> Result<void, AsyncError> {
    let b = Big { v: Vector<u8>.create() };
    await Async.scope(AsyncError.Cancelled, (s) => {
        s.spawn(async move () => {
            await serve(b)?;
            return await serve(b); // error[N0250]
        });
    })?;
    return Ok();
}

async fn part() -> Result<void, AsyncError> {
    let g = Guarded { v: Vector<u8>.create() };
    return await Async.timeout(5, AsyncError.TimedOut, async move () => await keep(g.v)); // error[N0252]
}

fn boxed() {
    let b = Big { v: Vector<u8>.create() };
    let f: Box<dyn fn()> = Box.create(move () => eat(b))!; // error[N0251]
    f();
}

fn main() {
    match (Async.run(twice())) { Ok() => {} Err(_) => {} }
    match (Async.run(part())) { Ok() => {} Err(_) => {} }
    boxed();
}
