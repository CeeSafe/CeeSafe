// Where tasks and `await` may appear (type-system.md §40.1, §40.2, §40.4; ADR 0031).

async fn add(a: i32, b: i32) -> i32 => a + b;
fn plain() -> i32 => 1;
fn take(x: i32) -> i32 => x;

fn sync() -> i32 {
    let t = await add(1, 2); // error[N0341]
    return t;
}

async fn misuse() -> i32 {
    let x = add(1, 2);       // error[N0342]
    let y = await plain();   // error[N0342]
    let z = take(add(1, 2)); // error[N0342]
    defer {
        await add(3, 4); // error[N0341]
    }
    await Async.park(); // error[N0345]
    return x + y + z;
}

fn main() {
    let v = Async.run(plain()); // error[N0342]
    Console.writeLine(v);
}

async fn shields() -> Result<void, AsyncError> {
    Async.shield(5, async () => await Timer.sleep(1)); // error[N0342]
    await Async.shield(5, () => 1);                    // error[N0209]
    Async.checkpoint();                                // error[N0209]
    return Ok();
}

async fn joins() -> Result<void, AsyncError> {
    var shared: u32 = 0;
    Async.all(async () => await Timer.sleep(1), async () => await Timer.sleep(2)); // error[N0342]
    await Async.all(async () => {
        shared += 1;
        return Ok();
    }, async () => { // error[N0241]
        shared += 2;
        return Ok();
    })?;
    let unknown = await Async.race(async () => { // error[N0236]
        return Ok(1);
    }, async () => Ok(2));
    await Async.race(1, 2); // error[N0209]
    return Ok();
}

async fn workers() -> Result<void, AsyncError> {
    let raw = 0 as *mut u8;
    await Async.blocking(() => { let r = raw; });        // error[N0334]
    let back = await Async.blocking(() => 0 as *mut u8); // error[N0334]
    Async.blocking(() => 1);                             // error[N0342]
    await Async.blocking(async () => Ok());              // error[N0209]
    return Ok();
}
