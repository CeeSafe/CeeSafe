// Store built-ins: swap, replace, arena allocation, slot maps, stable vectors; concrete and generic.
struct Holder<region r> {
    text: StringView<r>;
}
fn finish(d: StringView) {
    let fresh = String.from("FRESH FRESH FRESH FRESH FRESH FRESH FRESH FRESH!")!;
    Console.writeLine(d);
    Console.writeLine(fresh.view());
}
fn local() -> String => String.from("local local local local local local local local")!;
fn rp<T>(a: borrow mut Vector<T>, mk: fn(StringView) -> T) {
    let t = local();
    let old = replace(mut a[0], mk(t.view())); // error[N0272]
}
fn same(x: StringView) -> StringView => x;
fn main() {
    var keep = Vector<StringView>.create();
    keep.push("static")!;
    rp<StringView>(mut keep, same);
    finish(keep[0]);
}
