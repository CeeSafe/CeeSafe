// An instance of a generic function whose body does not check for its const arguments is N0222 at its use, naming
// the values (type-system.md §20.4, §20.5; ADR 0083 §2.6): here `[0u8; N]` with N = 0, which N0259 refuses.
fn zeros<const N: usize>() -> usize {
    let a = [0u8; N];
    return a.length;
}

fn main() {
    Console.writeLine(zeros<2>());
    Console.writeLine(zeros<0>()); // error[N0222]
}
