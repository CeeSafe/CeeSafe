// Constant concatenation has embed's limit (ADR 0087 §2.7, §9): a `+` whose result is longer than 16 MiB
// (16,777,216 bytes) is N0217 in a constant and N0338 in a static, so a chain that doubles a view cannot take
// gigabytes. B18 is exactly 16 MiB, and fine.
const B0: StringView = "abcdefghabcdefghabcdefghabcdefghabcdefghabcdefghabcdefghabcdefgh";
const B1: StringView = B0 + B0;
const B2: StringView = B1 + B1;
const B3: StringView = B2 + B2;
const B4: StringView = B3 + B3;
const B5: StringView = B4 + B4;
const B6: StringView = B5 + B5;
const B7: StringView = B6 + B6;
const B8: StringView = B7 + B7;
const B9: StringView = B8 + B8;
const B10: StringView = B9 + B9;
const B11: StringView = B10 + B10;
const B12: StringView = B11 + B11;
const B13: StringView = B12 + B12;
const B14: StringView = B13 + B13;
const B15: StringView = B14 + B14;
const B16: StringView = B15 + B15;
const B17: StringView = B16 + B16;
const B18: StringView = B17 + B17;
const B19: StringView = B18 + B18; // error[N0217]
static OVER: StringView = B18 + "!"; // error[N0338]
const EXACT: StringView = B17 + B17;

fn main() {
    Console.writeLine(EXACT.length);
}
