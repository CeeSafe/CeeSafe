// `dyn … + Share` needs a Share value (type-system.md §38.4; ADR 0084 §2.5): a struct holding a cell, or a closure
// capturing one, cannot become one (N0334), and a `dyn I + Send` does not convert to `dyn I + Share` (N0205).
interface Shape {
    fn area(borrow this) -> u32;
}

struct Counted {
    side: u32;
    calls: Cell<u32>;
}

impl Shape for Counted {
    fn area(borrow this) -> u32 {
        this.calls.set(this.calls.get() + 1);
        return this.side * this.side;
    }
}

struct Square {
    side: u32;
}

impl Shape for Square {
    fn area(borrow this) -> u32 => this.side * this.side;
}

fn main() {
    let counted: Box<dyn Shape + Share> = Box.create(Counted { side: 1, calls: Cell<u32>.create(0) })!; // error[N0334]
    let seen = Cell<u32>.create(0);
    let f: Box<dyn fn() -> u32 + Share> = Box.create(move () => seen.get())!; // error[N0334]
    let sent: Box<dyn Shape + Send> = Box.create(Square { side: 2 })!;
    let shared: Box<dyn Shape + Share> = sent; // error[N0205]
    let fine: Box<dyn Shape + Send> = Box.create(Counted { side: 1, calls: Cell<u32>.create(0) })!;
}
