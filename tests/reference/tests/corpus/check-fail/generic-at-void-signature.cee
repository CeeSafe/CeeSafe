// A type parameter that is `void` in an instance cannot be an element of a type in the instance's signature
// (type-system.md §20.4, ADR 0213 §7): N0226 at the call. Before, `check` passed and the C compiler failed.
fn returned<T>(r: Result<T, i32>) -> Vector<T> {
    return Vector<T>.create();
}

fn main() {
    let c: Result<void, i32> = Ok();
    Console.writeLine(returned(c).length); // error[N0226]
}
