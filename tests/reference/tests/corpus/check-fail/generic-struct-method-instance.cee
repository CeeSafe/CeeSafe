// An error in a method of a struct instance (§20.4) is N0222 at the method's first call, naming the instance.
struct Grid<const N: usize> {
    cells: [u64; N];

    fn first(borrow this) -> u64 => match (this.cells) {
        [x] => x,
        _ => 0,
    };
}

fn main() {
    let g = Grid<3> { cells: [1u64, 2, 3] };
    let one = Grid<1> { cells: [4u64] };
    Console.writeLine(one.first());
    Console.writeLine(g.first()); // error[N0222]
}
