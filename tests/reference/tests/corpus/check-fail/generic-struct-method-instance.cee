// An error in a method of a struct instance (§20.4) is N0222 at the method's first call, naming the instance: here
// `Grid<0>.scratch` makes a `[u8; 0]` (§16.1).
struct Grid<const N: usize> {
    v: u32;

    fn scratch(borrow this) -> usize {
        let a: [u8; N] = [0; N];
        return a.length;
    }
}

fn main() {
    let one = Grid<1> { v: 3 };
    Console.writeLine(one.scratch());
    let none = Grid<0> { v: 3 };
    Console.writeLine(none.scratch()); // error[N0222]
}
