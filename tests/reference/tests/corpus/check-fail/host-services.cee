// ADR 0028 (M15 S7): the host services' arguments (type-system.md §26.7-§26.10).

fn main() {
    let kind = File.kind(1);                 // error[N0205]
    let output = Process.capture("program"); // error[N0209]
    let names = Directory.list(7);           // error[N0205]
    let value = Environment.variable();      // error[N0209]
    let removed = Directory.delete("x");     // error[N0200]
}

// ADR 0106: Console.readLine takes a String as `mut` and answers whether it read a line; Random.below is a Result.
fn lines() {
    var bytes = Vector<u8>.create();
    let first = Console.readLine(mut bytes); // error[N0205]
    var text = String.create();
    let second = Console.readLine(text);                            // error[N0249]
    let count: Result<usize, IoError> = Console.readLine(mut text); // error[N0205]
    let none = Console.readLine();                                  // error[N0209]
    let secret: u32 = Random.below(10);                             // error[N0205]
}
