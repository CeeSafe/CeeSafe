// Instance flows against generic flows: a result that names a region in the instance, so elision does not apply.
struct Owner {
    text: String;
}
fn same(x: StringView) -> StringView => x;
struct Tagged<region r, U> {
    tag: StringView<r>;
    value: U;
}
struct Pair<A, B> {
    a: A;
    b: B;
}
fn apply<region r, U>(o: borrow Owner, tag: StringView<r>, f: fn(StringView) -> U) -> Result<U, StringView<r>> =>
    Ok(f(o.text.view()));
fn main() {
    var keep = Vector<StringView>.create();
    if (true) {
        let o = Owner { text: String.from("local local local local local local local local")! };
        let t = apply<StringView>(o, "tag", same);
        keep.push(t!)!;
    } // error[N0243]
    let fresh = String.from("FRESH FRESH FRESH FRESH FRESH FRESH FRESH FRESH!")!;
    Console.writeLine(keep[0]);
    Console.writeLine(fresh.view());
}
