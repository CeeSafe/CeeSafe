// The dyn-compatibility rule (type-system.md §37.1, ADR 0086 §2.3): `dyn I` is N0331, naming the member, when a method
// of `I` has no receiver, has type parameters of its own or names `Self` outside its receiver; defaults do not
// matter. An impl's method keeps the interface's receiver and type parameters (N0267).
interface Maker {
    fn make() -> u32;
}
interface Visit {
    fn visit<T>(borrow this, x: T);
}
interface Cloner {
    fn copyOf(borrow this) -> Self;
}
interface Taker {
    fn take(borrow this, other: borrow Self) -> bool;
}
interface Fine {
    fn get(borrow this) -> u32;
    fn twice(borrow this) -> u32 => this.get() * 2;
}
struct S {
    x: u32;
}
impl Maker for S {
    fn make(borrow this) -> u32 => 1; // error[N0267]
}
impl Visit for S {
    fn visit(borrow this, x: u32) {} // error[N0267]
}
fn a(m: borrow dyn Maker) {}  // error[N0331]
fn b(v: borrow dyn Visit) {}  // error[N0331]
fn c(v: borrow dyn Cloner) {} // error[N0331]
fn d(v: borrow dyn Taker) {}  // error[N0331]
fn e(v: borrow dyn Fine) -> u32 => v.twice();
fn main() {}
