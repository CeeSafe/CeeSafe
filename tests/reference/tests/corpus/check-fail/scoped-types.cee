// E3/E4 for slices (M2d): slices are scoped like references.
struct View { items: Slice<i32>; }        // error[N0270]
enum Maybe { Some(SliceMut<u8>), None }   // error[N0270]
const EMPTY: Slice<i32> = 0;              // error[N0246]
fn nested(a: [Slice<i32>; 2]) {}          // an array of slices: allowed since ADR 0064 §2 (was N0246)
fn sliceOfSlices(a: Slice<Slice<i32>>) {} // a slice of slices: allowed since ADR 0064 §2 (was N0246)
fn sliceOfRefs(a: Slice<borrow i32>) {}   // error[N0246]
fn varSlice(a: Slice<i32>) {
    var s = a; // a shared slice in a `var`: allowed since ADR 0138 §4 (was N0246)
}
fn borrowSlice(a: Slice<i32>) {
    let r = borrow a; // error[N0246]
}
