// Struct patterns (ADR 0123, type-system.md §15.2): what the checker refuses. A field must exist, once; every field
// is named unless the pattern ends with `..`; the name is the value's struct; a `let` without `else` cannot fail;
// exhaustiveness and unreachable arms go through the fields; a struct with a `drop` block is taken apart only by a
// pattern that names every field.
struct Point {
    x: i32;
    y: i32;
}

struct Other {
    x: i32;
}

struct Named {
    name: Vector<u8>;
    n: u32;
}

struct Guard {
    name: Vector<u8>;
    n: u32;

    drop {}
}

struct Outer {
    guard: Guard;
    n: u32;

    drop {}
}

struct Borrowed<region r> {
    at: borrow(r) Point;
}

enum Shape {
    Dot(Point),
    Empty,
}

const LIMIT: u32 = 3;

fn unknownField(p: Point) -> i32 {
    let Point { x, z } = p; // error[N0230]
    return x;
}

fn twice(p: Point) -> i32 {
    let Point { x, x: 0, y: _ } = p else { // error[N0231]
        return 0;
    };
    return x;
}

fn leftOut(p: Point) -> i32 {
    let Point { x } = p; // error[N0229]
    return x;
}

fn anotherType(p: Point) -> i32 {
    if (p is Other { .. }) { // error[N0205]
        return 1;
    }
    return 0;
}

fn fieldTypes(p: Point, v: Named) -> i32 {
    if (p is Point { x: "a", .. }) { // error[N0205]
        return 1;
    }
    if (p is Point { x: null, .. }) { // error[N0205]
        return 1;
    }
    if (p is Point { x: LIMIT, .. }) { // error[N0205]
        return 1;
    }
    if (v is Named { name: Point { .. }, .. }) { // error[N0205]
        return 1;
    }
    return 0;
}

fn notStruct(n: u32, s: Shape) -> u32 {
    if (n is Point { .. }) { // error[N0205]
        return 1;
    }
    if (s is Shape { .. }) { // error[N0205]
        return 1;
    }
    return 0;
}

fn referenceField(b: Borrowed) -> i32 {
    if (b is Borrowed { at: Point { x: 0, .. } }) { // error[N0205]
        return 1;
    }
    let Borrowed { at } = b;
    return at.x;
}

fn refutableLet(p: Point, s: Shape) -> i32 {
    let Point { x: 0, y } = p; // error[N0256]
    return y;
}

fn nonExhaustive(p: Point) -> i32 {
    match (p) { // error[N0256]
        Point { x: 0, y } => { return y; }
        Point { x, y: 0 } => { return x; }
    }
}

fn nonExhaustiveNested(s: Shape) -> i32 {
    match (s) { // error[N0256]
        Shape.Dot(Point { x: 0..=9, y: _ }) => { return 1; }
        Shape.Empty => { return 0; }
    }
}

fn unreachable(p: Point) -> i32 {
    match (p) {
        Point { x, .. } => { return x; }
        Point { x: 0, y } => { return y; } // error[N0257]
    }
}

fn unreachableByTwo(p: Point) -> i32 {
    match (p) {
        Point { x: 0, y: _ } => { return 1; }
        Point { x: _, y: 0 } => { return 2; }
        Point { x: 0, y: 0 } => { return 3; } // error[N0257]
        Point { .. } => { return 4; }
    }
}

fn dropWithRest(g: Guard) -> usize {
    let Guard { name, .. } = g; // error[N0252]
    return name.length;
}

fn nestedApart(o: Outer) -> u32 {
    if (o is Outer { guard: Guard { name: _, n }, .. }) { // error[N0252]
        return n;
    }
    return 0;
}

fn atAndApart(g: Guard) -> u32 {
    match (g) {
        w @ Guard { name: _, n } => { return n + w.n; } // error[N0250]
    }
}

fn atAndMove(v: Named) -> usize {
    match (v) {
        w @ Named { name, .. } => { return name.length + w.name.length; } // error[N0250]
    }
}

fn varByReference(v: borrow Named) -> u32 {
    let Named { var n, .. } = v; // error[N0246]
    return *n;
}

fn main() {}
