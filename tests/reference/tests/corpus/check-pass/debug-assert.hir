(program
  (fn first ((values#0: Slice<u32>)) -> u32
    (block
      (expr (debugAssert (> (length values#0):usize 0:usize):bool "no values"))
      (expr (debugAssert (value (match (length values#0):usize (arm 1 (block (yield true))) (arm (n#1: usize) (block (var sum#2: usize = 0:usize) (for k#3 in 0:usize .. n#1 (block (+= sum#2 k#3))) (yield (> sum#2 0:usize):bool))))):bool))
      (return (index (deref values#0):[u32] 0:usize):u32)
    )
  )
  (fn main () -> void
    (block
      (let values#0: [u32; 2] = (array 3:u32 4:u32):[u32; 2])
      (expr (Console.writeLine (call first (slice values#0 _ _):Slice<u32>):u32))
    )
  )
)
