// profile: freestanding
// option: kernel cosmoos
// option: no-float
// lib/kernel (ADR 0025): a static spinlock and a static per-CPU counter, built at compile time with CosmoOS's
// SPINLOCK_INIT (type-system.md §39), used under their guards; a lock in a kernel-heap box; a kernel object.
struct Table {
    count: u64;
}

static TABLE: SpinLock<Table> = SpinLock<Table>.constant("safe.table\0".ptr as *CChar, Table { count: 0 });
static TICKS: PerCpu<u64> = PerCpu<u64>.constant(0);

@export("kl_bump")
fn bump() -> u64 {
    var guard = TABLE.lock();
    let table = guard.data();
    table.count += 1;
    return table.count;
}

@export("kl_tick")
fn tick() -> u64 {
    var mine = TICKS.local(IrqGuard.enter());
    let value = mine.get();
    value += 1;
    return value;
}

@export("kl_boxed")
fn boxed() -> u64 {
    match (SpinLock<u64>.create("safe.boxed\0".ptr as *CChar, 7)) {
        Ok(lock) => {
            var guard = lock.lock();
            return guard.data();
        }
        Err(e) => { return 0; }
    }
}

@export("kl_object")
fn object() -> u32 {
    match (KRef<u64>.create("safe.object\0".ptr as *CChar, 9)) {
        Ok(first) => {
            let second = first.clone();
            return second.count();
        }
        Err(e) => { return 0; }
    }
}

/// A line for the kernel log, built with lib/core's TextWriter and sent with lib/kernel's KernelLog (ADR 0041 §3.3).
@export("kl_log")
fn log(packets: u64, delta: i64, flags: u32) -> usize {
    var buffer: [u8; 256] = [0; 256]; // LOG_LINE_MAX
    var line = TextWriter.create(mut buffer[..]);
    line.text("safe: packets ");
    line.decimal(packets);
    line.text(" delta ");
    line.signed(delta);
    line.text(" flags 0x");
    line.hex(flags as u64, 8);
    KernelLog.send(LogLevel.Info, line);
    KernelLog.write(LogLevel.Debug, "safe: fixed");
    if (line.truncated()) {
        KernelLog.panic(line);
    }
    return line.wanted();
}
