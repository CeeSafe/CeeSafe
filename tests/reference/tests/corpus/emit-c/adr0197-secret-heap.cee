// SecretHeap's id is CEE_ALLOC_SECRET (ADR 0197 §2.3), and a SecretHeap vector's pop moves the element out, then
// wipes its slot; a SystemHeap vector's pop does not.

fn main() -> i32 {
    var secret = Vector<u32, SecretHeap>.create();
    secret.push(7)!;
    let a = secret.pop()!;
    var plain = Vector<u32>.create();
    plain.push(5)!;
    let b = plain.pop()!;
    return truncate<i32>(a + b);
}
