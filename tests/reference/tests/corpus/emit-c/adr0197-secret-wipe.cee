// Secret.wipe lowers to the runtime's ceesafe_wipe of the place's address and size, or of a slice's pointer and its
// length times its element's size (ADR 0197 §2.2): a call the C compiler keeps, where a loop of stores would be dead.

struct Key {
    bytes: [u8; 32];
    rounds: u64;

    drop {
        Secret.wipe(mut this.bytes);
        Secret.wipe(mut this.rounds);
    }
}

fn main() -> i32 {
    let k = Key { bytes: [7u8; 32], rounds: 14 };
    var tail = [1u32, 2, 3, 4];
    Secret.wipe(mut tail[1..3]);
    return truncate<i32>(k.rounds + tail[0] as u64);
}
