// Temporary forwarding (optimisations.md §6, ADR 0162): a value is not copied through a temporary it only passes
// through. Each function is one case; the snapshot shows which temporaries are left.

struct Pair {
    a: i32;
    b: i32;
}

fn make(n: i32) -> Result<Pair, AllocError> {
    if (n < 0) {
        return Err(AllocError.OutOfMemory);
    }
    return Ok(Pair { a: n, b: n + 1 });
}

fn twice(p: Pair) -> Pair => Pair { a: p.a * 2, b: p.b * 2 };

/// Forwarded: the call's result goes straight to the match's scrutinee; the match's value, assigned in the arm, goes
/// straight to `p`; and each `return` returns its constant. `r` and `p` are named, and stay.
fn matchValue() -> i32 {
    let p = match (make(1)) {
        Ok(r) => r,
        Err(_) => { return -1; }
    };
    return p.a;
}

/// Forwarded: an `if` used as a value assigns `x` in each branch (two assignments of one temporary).
fn ifValue(c: bool) -> i32 {
    let x = if (c) 1 else 2;
    return x + 1;
}

/// Forwarded: a chain. The inner `if`'s value goes through the outer's to `x`.
fn chain(c: bool, d: bool) -> i32 {
    let x = if (c) (if (d) 1 else 2) else 3;
    return x;
}

/// Not forwarded: the temporaries are read by an operation, not moved on whole (rule 2).
fn readByAnOperation() -> i32 {
    return twice(Pair { a: 1, b: 2 }).a + twice(Pair { a: 3, b: 4 }).b;
}

/// Not forwarded: the call reads the local it is assigned to (rule 4).
fn targetReadByTheCall() -> i32 {
    var p = Pair { a: 1, b: 2 };
    p = twice(p);
    return p.a;
}

async fn later(n: i32) -> i32 {
    return n + 1;
}

/// Not forwarded: an awaited call's result (rule 3). The addition's temporary is, into `v`'s return.
async fn awaited() -> i32 {
    let v = await later(1);
    return v;
}

fn main() -> i32 {
    let a = matchValue() + ifValue(true) + chain(true, false) + readByAnOperation() + targetReadByTheCall();
    return a + Async.run(awaited());
}
