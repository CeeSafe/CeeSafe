// --explain-frames for async instances (ADR 0037 §3.3): each is reported at the call that made it, a user's
// function's and lib/core's alike, its frame embedding the async closure's.

async fn later(v: u32) -> u32 {
    await Timer.sleep(1)!;
    return v;
}

@effectsOf(op)
fn twice(op: borrow fn(u32) -> u32, x: u32) -> u32 => op(op(x));

async fn work() -> u32 {
    var values = Vector<u32>.create();
    values.push(4)!;
    var sum: u32 = 0;
    await values.forEach(async (v) => { sum += await later(v); });
    return await twice(async (v) => await later(v) + sum, 1);
}

fn main() {
    Console.writeLine(Async.run(work()));
}
