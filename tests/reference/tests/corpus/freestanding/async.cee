// Async tasks in the freestanding profile (ADR 0039): the executor over the environment's hooks (async.c), children
// from its allocator through Async.scopeIn, timers, a race, a cancelled sleeper, and an AsyncSignal raised from
// another context, as an interrupt handler would (env_start_irq starts it).
extern "C" {
    @effects(alloc)
    fn env_alloc(size: usize, align: usize) -> *mut void;
    @effects()
    fn env_free(p: *mut void);
    @effects()
    fn env_start_irq(ms: u32); // calls raise_ready() from another context after ms
}

struct EnvHeap {}

impl Allocator for EnvHeap {
    /// Safety: env_alloc returns null or a block of layout.size bytes aligned to layout.align.
    fn allocate(borrow this, layout: Layout) -> Result<*mut u8, AllocError> {
        let p = unsafe { env_alloc(layout.size, layout.align) } as *mut u8;
        return if (p.isNull()) Err(AllocError.OutOfMemory) else Ok(p);
    }

    /// Safety: the blocks come back from allocate, once each.
    unsafe fn deallocate(borrow this, p: *mut u8, layout: Layout) { env_free(p as *mut void); }
}

static READY: AsyncSignal = AsyncSignal.constant();

@export("raise_ready")
@context(irq)
fn raiseReady() { READY.raise(); }

async fn tick(n: u32, ms: u64) -> Result<u32, AsyncError> {
    await Timer.sleep(ms)?;
    return Ok(n);
}

async fn breaker() -> Result<void, AsyncError> {
    await Timer.sleep(5)?;
    return Err(AsyncError.TimedOut);
}

async fn sleeper(done: borrow mut u32) -> Result<void, AsyncError> {
    await Timer.sleep(10000)?; // cancelled long before
    done += 1;
    return Ok();
}

/// Safety: env_start_irq only arms the environment's timer, which calls raise_ready later.
async fn work() -> Result<u32, AsyncError> {
    var total: u32 = 0;
    var a: u32 = 0;
    var b: u32 = 0;
    await Async.scopeIn(EnvHeap {}, AsyncError.Cancelled, (s) => {
        s.spawn(async () => { a = await tick(1, 3)?; return Ok(); });
        s.spawn(async () => { b = await tick(2, 6)?; return Ok(); });
    })?;
    total += a + b;
    let r = await Async.race(async () => await tick(10, 2), async () => await tick(20, 50));
    total += r?.value;
    var never: u32 = 0;
    let cancelled = await Async.scopeIn(EnvHeap {}, AsyncError.Cancelled, (s) => {
        s.spawn(async () => await sleeper(mut never));
        s.spawn(async () => await breaker());
    });
    match (cancelled) {
        Err(AsyncError.TimedOut) => { total += 100; }
        _ => {}
    }
    unsafe { env_start_irq(5); }
    await READY.wait()?;
    total += 1000;
    return Ok(total + never * 10000);
}

@export("async_selftest")
fn selftest() -> u32 => match (Async.run(work())) {
    Ok(v) => v,
    Err(_) => 0,
};
// expect-stdout: async 1113
