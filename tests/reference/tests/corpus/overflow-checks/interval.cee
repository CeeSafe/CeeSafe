// The interval of a checked result (optimisations.md §2.4, ADR 0238): after `x = a * b`, a signed `+` or `-`, or a
// negation, `x` lies between the operation's values at the corners of its operands' bounds. The .oce snapshot lists
// each checked operation; the near misses must keep theirs.

const M: usize = 64;

// Removed: `i * M` is at most 63 * 64, so `i * M + j` is at most 4095 (the benchmarks' `numeric`).
fn cell(i: usize, j: usize) -> usize {
    if (i < M && j < M) {
        return i * M + j;
    }
    return 0;
}

// Removed: `7 * i` is at most 6993 (the benchmarks' `hash-map`).
fn spread(i: u32) -> u32 {
    if (i < 1000) {
        return 7 * i + 1;
    }
    return 0;
}

// Removed: signed, `x * x` is between -10000 and 10000, and so is its negation; the sum is at most 10001.
fn square(x: i32) -> i32 {
    if (x >= -100 && x <= 100) {
        let s = x * x;
        return -s + 1;
    }
    return 0;
}

// Removed: a signed difference of bounded values, then a product of it.
fn spanTimes(a: i64, b: i64) -> i64 {
    if (a >= 0 && a <= 1000 && b >= 0 && b <= 1000) {
        let d = a - b;
        return d * 3;
    }
    return 0;
}

// Kept: `a` has no upper bound, so neither has `a * 2`, and the `+` keeps its check too.
fn unbounded(a: u32) -> u32 {
    return a * 2 + 1;
}

// Kept: `x * 2` may be 200, past i8.
fn pastTheType(x: i8) -> i8 {
    if (x >= 0 && x <= 100) {
        return x * 2;
    }
    return 0;
}

// Kept: `-x` may be -MIN; the sum after it may then be anything.
fn negation(x: i32) -> i32 {
    let y = -x;
    return y + 1;
}

const LIMIT: usize = 1000;

// Removed: a loop's end of two constants has its exact value, 1001 (ADR 0238 §2.2), so `i * i` is at most 10⁶; the
// counter keeps its check.
fn squaresBelow() -> usize {
    var count: usize = 0;
    for (i in 2..LIMIT + 1) {
        if (i * i <= LIMIT) {
            count += 1;
        }
    }
    return count;
}

fn main() {
    Console.writeLine(cell(63, 63));
    Console.writeLine(cell(2, 5));
    Console.writeLine(spread(999));
    Console.writeLine(square(-100));
    Console.writeLine(square(7));
    Console.writeLine(spanTimes(3, 1000));
    Console.writeLine(unbounded(41));
    Console.writeLine(pastTheType(60));
    Console.writeLine(negation(41));
    Console.writeLine(squaresBelow());
}

// expect-stdout: 4095
// expect-stdout: 133
// expect-stdout: 6994
// expect-stdout: -9999
// expect-stdout: -48
// expect-stdout: -2991
// expect-stdout: 83
// expect-stdout: 120
// expect-stdout: -40
// expect-stdout: 30
