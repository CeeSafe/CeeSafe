// An enum's body holds its variants (grammar.md §2, ADR 0107): its functions are written in an `impl` block, and one
// in the body is N0100 with that advice, once: the rest of the body is passed over.
enum Shape {
    Circle(f64),
    Empty,

    fn area(borrow this) -> f64 => 0.0; // error[N0100]
}

fn main() {
}
