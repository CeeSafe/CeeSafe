(unit
  (fn default f (params (c u8) (x i32)) (returns u32)
    (block
      (match x
        (arm (..= (neg 10) (neg 1))
          (block)
        )
        (arm (.. 0 10)
          (block)
        )
        (arm _
          (block)
        )
      )
      (return (match-expr c (arm (or (..= 'a' 'z') (.. '0' '9')) 1) (arm _ 0)))
    )
  )
)
