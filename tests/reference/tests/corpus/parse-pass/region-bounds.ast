(unit
  (fn default pick (type-params (region a) (region b a)) (params (x (StringView a)) (y (StringView b))) (returns (StringView a))
    (=> x)
  )
  (fn default either (type-params (region a) (region b) (region c a b) (T Copy)) (params (x (StringView a)) (y (StringView b)) (z (StringView c)) (t T))
    (block)
  )
  (struct default Parser (type-params (region scratch) (region input scratch))
    (field default text (StringView input))
    (fn default label (type-params (region l scratch)) (params (borrow this) (name (StringView l))) (returns (StringView scratch))
      (=> name)
    )
  )
  (enum default Source (type-params (region a) (region b a))
    (variant Near (StringView a))
    (variant Far (StringView b))
  )
  (impl (Parser scratch input) (type-params (region scratch) (region input scratch))
    (fn default first (params (borrow this)) (returns (StringView input))
      (=> (. this text))
    )
  )
)
