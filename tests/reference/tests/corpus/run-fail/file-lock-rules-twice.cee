// CEESAFE_LOCK_RULES=strict (ADR 0256 §2.2, 1): the same range locked twice by one File, the finding's recovery that
// locks the checkpointer's byte again. POSIX keeps one lock; Windows waits for ever on its own lock.
// env: CEESAFE_LOCK_RULES=strict
fn main() {
    let dir = Directory.temporary()!;
    var path = String.create();
    path.append(dir.view())!;
    path.append("/db")!;
    let f = File.createReadWrite(path.view())!;
    f.lock(FileLock.Exclusive, 0x40000001, 1)!;
    Console.writeLine("locked once");
    f.lock(FileLock.Exclusive, 0x40000001, 1)!; // expect-library-panic: FileLocks.lock: the File already holds a lock on bytes of this range, which Windows refuses (CEESAFE_LOCK_RULES)
    Console.writeLine("after");
}
// expect-stdout: locked once
