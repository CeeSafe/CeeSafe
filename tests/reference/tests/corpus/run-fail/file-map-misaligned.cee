// An atomic in a shared mapping must be aligned to its size in the file (ADR 0232 §2.1): the mapping starts at byte 2
// of the file, so its byte 2 is the file's byte 4, aligned, and its byte 0 is not.
fn main() {
    let dir = Directory.temporary()!;
    var path = String.create();
    path.append(dir.view())!;
    path.append("/m")!;
    let f = File.createReadWrite(path.view())!;
    let m = f.mapShared(2, 30)!;
    m.store32(2, 1, StoreOrdering.Relaxed);
    Console.writeLine(m.load32(2, LoadOrdering.Relaxed));
    m.store32(0, 1, StoreOrdering.Relaxed); // expect-library-panic: SharedMapping: the atomic is not aligned to its size
    Console.writeLine("after");
}
// expect-stdout: 1
