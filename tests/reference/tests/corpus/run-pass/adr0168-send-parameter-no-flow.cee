// ADR 0168: a type parameter bounded by `Send` or `Share` is no flow name, so a method that is handed a context can
// pass it on to a handler whose interface shares that parameter with it: nothing of the handler can be stored in it.
struct Ctx<region r, S> {
    state: borrow(r) S;
    seen: u32;
}

interface Handler<S: Send + Share> {
    fn handle(borrow this, ctx: borrow mut Ctx<S>) -> u32;
}

struct Adds {
    by: u32;
}

impl Handler<u32> for Adds {
    fn handle(borrow this, ctx: borrow mut Ctx<u32>) -> u32 {
        ctx.seen += this.by;
        return ctx.state + ctx.seen;
    }
}

struct Server<S: Send + Share> {
    state: S;
    handlers: Vector<Box<dyn Handler<S> + Send + Share>>;
}

impl<S: Send + Share> Server<S> {
    fn handler(borrow this, index: usize) -> borrow Box<dyn Handler<S> + Send + Share> => borrow this.handlers[index];

    // Handed the context, it calls each handler with it.
    fn dispatch(borrow this, ctx: borrow mut Ctx<S>) -> u32 {
        var last: u32 = 0;
        for (i in 0..this.handlers.length) {
            last = this.handler(i).handle(mut ctx);
        }
        return last;
    }

    fn serve(borrow this) -> u32 {
        var ctx = Ctx { state: borrow this.state, seen: 0 };
        let last = this.dispatch(mut ctx);
        return last * 100 + ctx.seen;
    }
}

fn main() {
    var handlers = Vector<Box<dyn Handler<u32> + Send + Share>>.create();
    let one: Box<dyn Handler<u32> + Send + Share> = Box.create(Adds { by: 2 })!;
    let two: Box<dyn Handler<u32> + Send + Share> = Box.create(Adds { by: 5 })!;
    handlers.push(one)!;
    handlers.push(two)!;
    let server = Server { state: 40u32, handlers: handlers };
    Console.writeLine(server.serve() as u64);
}
// expect-stdout: 4707
