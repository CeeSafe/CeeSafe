// ADR 0195 §2.1 (G36): 300 statement `match`es in one function, each with an arm that returns. The C nested once
// per `match`; with §2.1.1 and §2.1.2 it is flat.
fn step(i: i32, stop: i32) -> Result<void, i32> {
    if (i == stop) {
        return Err(i);
    }
    return Ok();
}

