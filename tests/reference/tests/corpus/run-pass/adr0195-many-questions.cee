// ADR 0195 §2.1 (G36): 300 `?` in one function. Each `?`'s `Ok` case held the rest of the function, so the C nested
// once per `?` and failed clang's default -fbracket-depth=256; the switch guard clause (§2.1.2) prints it flat.
fn step(i: i32, stop: i32) -> Result<i32, i32> {
    if (i == stop) {
        return Err(i);
    }
    return Ok(i);
}

