// SecretHeap, the third built-in allocator (ADR 0197 §2.3): every container that takes a built-in allocator takes it,
// and behaves as with SystemHeap. Its growth allocates, copies and frees (wiping the old block), and its vacated
// slots are wiped; neither changes a value the program can still name. A box keeps a key in one block, so a vector
// of key holders moves pointers only. Aes256Gcm and HmacSha256 go in a SecretHeap box as any value does.

struct MasterKey {
    id: u32;
    key: Box<[u8; 32], SecretHeap>;
}

fn sum(bytes: Slice<u8>) -> u64 {
    var total: u64 = 0;
    for (b in bytes) { total += b as u64; }
    return total;
}

fn total(values: Slice<u64>) -> u64 {
    var t: u64 = 0;
    for (v in values) { t += v; }
    return t;
}

fn main() {
    // A box: the key's bytes in one secret block.
    let boxed = Box.createIn(SecretHeap {}, [7u8; 32])!;
    Console.writeLine(sum(boxed[..]));

    // A vector that grows (4, 8, 16, 32, 64, 128 elements), then gives slots up every way it can.
    var v = Vector<u64, SecretHeap>.create();
    for (i in 0..100u64) { v.push(i)!; }
    Console.writeLine(total(v.view()));
    Console.writeLine(v.pop()!);
    v.truncate(50);
    Console.writeLine(v.remove(10));
    Console.writeLine(v.swapRemove(0));
    v.insert(0, 1000)!;
    v.resize(20, 0)!;
    v.retain((x: borrow u64) => *x % 2 == 0);
    Console.writeLine(v.length);
    Console.writeLine(total(v.view()));
    let copy = v.clone()!;
    v.clear();
    Console.writeLine(v.length);
    Console.writeLine(total(copy.view()));
    v.extend(copy.view())!;
    v.push(0x0102)!;
    Console.writeLine(v.length);

    // Bytes and text.
    var bytes = Vector<u8, SecretHeap>.withCapacity(2)!;
    bytes.pushBE(0x01020304u32)!;
    Console.writeLine(sum(bytes.view()));
    var text = String<SecretHeap>.from("key text")!;
    text.append(", longer than its first block")!;
    Console.writeLine(text.view());
    Console.writeLine(text.clone()!.length);

    // A slot map and a stable vector.
    var map = SlotMap<u64, SecretHeap>.create();
    let a = map.insert(11)!;
    let b = map.insert(22)!;
    Console.writeLine(map.remove(a)!);
    Console.writeLine(map.get(b)!);
    Console.writeLine(map.get(a).isNull());
    var stable = StableVector<u64, SecretHeap>.create();
    for (i in 0..40u64) { stable.push(i * 3)!; }
    Console.writeLine(stable[39]);

    // Key holders: a vector of them moves only their boxes' pointers when it grows.
    var keys = Vector<MasterKey>.create();
    for (i in 0..10u32) {
        keys.push(MasterKey { id: i, key: Box.createIn(SecretHeap {}, [truncate<u8>(i); 32])! })!;
    }
    Console.writeLine(sum(keys[9].key[..]) + keys[9].id as u64);

    // lib/std's key holders in a secret box.
    let cipher = Box.createIn(SecretHeap {}, Aes256Gcm.create([1u8; 32][..])!)!;
    var data = [0u8; 16];
    let tag = cipher.seal([0u8; 12], "".bytes(), mut data[..]);
    Console.writeLine(tag.length);
    var mac = Box.createIn(SecretHeap {}, HmacSha256.create("key".bytes()))!;
    mac.update("message".bytes());
    Console.writeLine(mac.finish().length);

    // An arena of secret chunks.
    using arena = Arena.create(SecretHeap {}, 4096u64);
    let slot = arena.alloc(41u64)!;
    *slot += 1;
    Console.writeLine(*slot);
}
// expect-stdout: 224
// expect-stdout: 4950
// expect-stdout: 99
// expect-stdout: 10
// expect-stdout: 0
// expect-stdout: 9
// expect-stdout: 1080
// expect-stdout: 0
// expect-stdout: 1080
// expect-stdout: 10
// expect-stdout: 10
// expect-stdout: key text, longer than its first block
// expect-stdout: 37
// expect-stdout: 11
// expect-stdout: 22
// expect-stdout: true
// expect-stdout: 117
// expect-stdout: 297
// expect-stdout: 16
// expect-stdout: 32
// expect-stdout: 42
