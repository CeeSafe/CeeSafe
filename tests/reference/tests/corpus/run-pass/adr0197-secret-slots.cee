// A SecretHeap vector's slots given up are wiped (ADR 0197 §2.3): after `pop`, `truncate`, `clear`, `remove`,
// `swapRemove` and `resize` down, the bytes past the length, which the buffer still holds, are zero. They are read
// through the vector's raw parts, as a debugger would see them; a SystemHeap vector keeps them.

/// The `count` elements of `v`'s buffer from `from` (past its length), summed.
/// Safety: the buffer has `capacity` initialised elements, every one written before.
fn spare(v: borrow mut Vector<u64, SecretHeap>, from: usize, count: usize) -> u64 {
    let p = v.viewMut().ptr;
    var sum: u64 = 0;
    for (i in from..from + count) {
        sum += unsafe { p.add(i).read() };
    }
    return sum;
}

/// The same for a SystemHeap vector.
/// Safety: as `spare`.
fn spareSystem(v: borrow mut Vector<u64>, from: usize, count: usize) -> u64 {
    let p = v.viewMut().ptr;
    var sum: u64 = 0;
    for (i in from..from + count) {
        sum += unsafe { p.add(i).read() };
    }
    return sum;
}

fn filled() -> Vector<u64, SecretHeap> {
    var v = Vector<u64, SecretHeap>.withCapacity(16)!;
    for (i in 1..17u64) { v.push(i)!; }
    return v;
}

fn main() {
    var v = filled();
    let _ = v.pop();
    Console.writeLine(spare(mut v, 15, 1)); // 16 was there
    v.truncate(10);
    Console.writeLine(spare(mut v, 10, 5)); // 11 to 15
    let _ = v.remove(0);
    Console.writeLine(spare(mut v, 9, 1)); // the last moved down, its old slot wiped
    let _ = v.swapRemove(0);
    Console.writeLine(spare(mut v, 8, 1));
    v.resize(4, 0)!;
    Console.writeLine(spare(mut v, 4, 4));
    v.clear();
    Console.writeLine(spare(mut v, 0, 16));

    var w = Vector<u64>.withCapacity(16)!;
    for (i in 1..17u64) { w.push(i)!; }
    w.truncate(10);
    Console.writeLine(spareSystem(mut w, 10, 6)); // 11 + … + 16, as they were
}
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 81
