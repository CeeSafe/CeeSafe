// Secret.wipe (ADR 0197 §2.2): a zeroable place set to zero bytes, by the runtime's wipe, which the C compiler keeps:
// an array, a scalar, a struct of zeroable fields, a slice of an array, a `borrow mut` parameter's referent, and the
// fields of a value in its own `drop`. The place stays a value of its type and is read after.

struct Pair {
    a: u64;
    b: [u8; 4];
    ok: bool;
    ratio: f32;
}

struct Key {
    bytes: [u8; 8];
    id: u32;

    drop {
        Secret.wipe(mut this.bytes);
        Secret.wipe(mut this.id);
    }
}

fn wipeThrough(p: borrow mut Pair) {
    Secret.wipe(mut p);
}

fn sum(bytes: Slice<u8>) -> u32 {
    var total: u32 = 0;
    for (b in bytes) { total += b as u32; }
    return total;
}

fn main() {
    var key: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    Secret.wipe(mut key[2..5]);
    Console.writeLine(sum(key[..])); // 1 + 2 + 6 + 7 + 8
    Secret.wipe(mut key);
    Console.writeLine(sum(key[..]));
    var n: u64 = 0xFFFF;
    Secret.wipe(mut n);
    Console.writeLine(n);
    var p = Pair { a: 7, b: [9, 9, 9, 9], ok: true, ratio: 1.5 };
    Secret.wipe(mut p.b);
    Console.writeLine(sum(p.b[..]));
    Console.writeLine(p.a);
    wipeThrough(mut p);
    Console.writeLine(p.a);
    Console.writeLine(p.ok);
    Console.writeLine(p.ratio == 0.0);
    var k = Key { bytes: [3, 3, 3, 3, 3, 3, 3, 3], id: 9 };
    Console.writeLine(sum(k.bytes[..]) + k.id);
    k.id = 10;
    Console.writeLine(k.id);
}
// expect-stdout: 24
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 0
// expect-stdout: 7
// expect-stdout: 0
// expect-stdout: false
// expect-stdout: true
// expect-stdout: 33
// expect-stdout: 10
