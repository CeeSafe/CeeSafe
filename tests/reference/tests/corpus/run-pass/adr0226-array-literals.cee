// ADR 0226: an array literal takes its element type from an expected slice (§2.1), and constant arrays and statics
// hold floats (§2.3). Expected values worked by hand: 1 + 2 + 3 = 6 and 4 + 5 = 9 as u64 beyond i32's range;
// 0.5 + 0.25 + 1000.0 = 1000.75; the f32 static's 1.5 + 0.125 = 1.625; -0.0 keeps its sign (1 / -0.0 is -Infinity); 4.9e-324 (the least
// subnormal) and 1.0e300 keep their exact values through C's hexadecimal literals.
fn sum(xs: Slice<u64>) -> u64 {
    var total: u64 = 0;
    for (x in xs) {
        total += x;
    }
    return total;
}

fn big() -> Slice<static, u64> => BIG[..];

fn firstOf(xs: Slice<u64>) -> u64 => xs[0];

const FACTORS: [f64; 3] = [0.5, 0.25, 1000.0];
static TABLE: [f64; 4] = [1.5, -0.0, 4.9e-324, 1.0e300];
static SMALL: [f32; 2] = [1.5, 0.125];
static ONE: f64 = 1.0;
static BIG: [u64; 2] = [4000000000, 5000000000];

fn main() {
    Console.writeLine(sum([1, 2, 3][..]));
    Console.writeLine(firstOf([4000000000, 5][..]) + 5000000000);
    Console.writeLine(sum(big()));
    var total = 0.0;
    for (f in FACTORS) {
        total += f;
    }
    Console.writeLine(total);
    Console.writeLine(TABLE[0] + ONE);
    Console.writeLine(1.0 / TABLE[1]);
    Console.writeLine(TABLE[2] > 0.0 && TABLE[2] == 4.9e-324);
    Console.writeLine(TABLE[3] == 1.0e300);
    Console.writeLine(SMALL[0] + SMALL[1]);
}
// expect-stdout: 6
// expect-stdout: 9000000000
// expect-stdout: 9000000000
// expect-stdout: 1000.75
// expect-stdout: 2.5
// expect-stdout: -Infinity
// expect-stdout: true
// expect-stdout: true
// expect-stdout: 1.625
