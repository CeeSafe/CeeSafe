// An array of a `@noncopy` struct of plain data (ADR 0198 phase 1): a move type that needs no drop, moved whole into
// and out of a function and into a boxed closure's captures; `for` borrows its elements; a generic `[T; N]` with
// `T: Copy` is unchanged.
@noncopy
struct Block {
    bytes: [u8; 4];
    tag: u32;
}

fn pass(blocks: [Block; 2]) -> [Block; 2] => blocks;

fn sum(blocks: borrow [Block; 2]) -> u32 {
    var t: u32 = 0;
    for (b in blocks) {
        t += b.tag + (b.bytes[3] as u32);
    }
    return t;
}

fn firstOf<T: Copy>(a: [T; 2]) -> T => a[0];

fn main() {
    let blocks = pass([Block { bytes: [1, 2, 3, 4], tag: 10 }, Block { bytes: [5, 6, 7, 8], tag: 20 }]);
    let later: Box<dyn fn() -> u32> = Box.create(move () => sum(borrow blocks))!;
    Console.writeLine(later()); // expect-stdout: 42
    let built: [Block; 3] = arrayFrom((i) => Block { bytes: [truncate<u8>(i); 4], tag: 100 });
    Console.writeLine(built[2].bytes[0]); // expect-stdout: 2
    Console.writeLine(firstOf([3, 4]));   // expect-stdout: 3
}
