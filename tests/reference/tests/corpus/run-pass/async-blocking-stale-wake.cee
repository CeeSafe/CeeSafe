// A stale wake from Async.blocking (the mail server's findings, §1.4): the blocking thread sets `done`, then wakes the
// task, so a task that sees `done` first is woken after it has moved on. The run loop readied it on that wake at its
// next suspension, here an Async.timeout's join, while it was still its scope's waiter: a returning child then readied
// it a second time, and the ready queue looped (a stall) or a finished task ran again (a crash); a stale descriptor
// aborted a later wait. A wake now counts only for a task that registered one in that resume. Without the fix this
// crashes or hangs in every run.
enum E { T }

async fn quick() -> Result<u32, E> {
    return Ok(1);
}

async fn worker() -> Result<void, E> {
    for (i in 0..2000) {
        let n: u32 = await Async.blocking(() => 1u32);
        let r = await Async.timeout(1000, E.T, async () => await quick());
        match (r) {
            Ok(v) => {
                if (v + n != 2) {
                    return Err(E.T);
                }
            }
            Err(e) => { return Err(e); }
        }
    }
    return Ok();
}

async fn all() -> Result<void, AllocError> {
    await Async.scope(AllocError.OutOfMemory, (s) => {
        for (k in 0..4) {
            s.spawn(async () => {
                match (await worker()) {
                    Ok() => {}
                    Err(_) => { return Err(AllocError.OutOfMemory); }
                }
                return Ok();
            });
        }
    })?;
    return Ok();
}

fn main() {
    match (Async.run(all())) {
        Ok() => { Console.writeLine("ok"); }
        Err(_) => { Console.writeLine("oom"); }
    }
}
// expect-stdout: ok
