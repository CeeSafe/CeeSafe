// Bug B3 (CeeSafe.Web, found 2026-11-02): a race child that lends a captured array as `mut buf[..]` captures it
// mutably, so its environment holds a mutable pointer; the C used to discard a const qualifier, which the contract
// suite's -Werror run rejects.
async fn fill(buffer: SliceMut<u8>) -> Result<usize, AsyncError> {
    buffer[0] = 7;
    return Ok(1);
}

async fn later() -> Result<usize, AsyncError> {
    await Timer.sleep(1000)?;
    return Ok(0);
}

async fn run() -> Result<u8, AsyncError> {
    var buf = [0u8; 4];
    let r: Result<Raced<usize>, AsyncError> = await Async.race(
        async () => await fill(mut buf[..]),
        async () => await later(),
    );
    let raced = r?;
    return Ok(buf[0] + truncate<u8>(raced.value));
}

fn main() {
    match (Async.run(run())) {
        Ok(v) => { Console.writeLine(v); }
        Err(_) => { Console.writeLine("failed"); }
    }
}
// expect-stdout: 8
