    out[7] = await sendOnce(borrow listener, port, 0, one0[..])?;
    let one1 = [1usize];
    out[8] = await sendOnce(borrow listener, port, 1, one1[..])?;
    let one2 = [5usize, 0usize, 7usize];
    out[9] = await sendOnce(borrow listener, port, 2, one2[..])?;
    let one3 = [0usize, 0usize, 3usize];
    out[10] = await sendOnce(borrow listener, port, 3, one3[..])?;
    let one4 = [1usize, 2usize, 3usize, 4usize, 5usize, 6usize, 7usize, 8usize];
    out[11] = await sendOnce(borrow listener, port, 4, one4[..])?;
    let one5 = [70000usize, 1usize, 130000usize];
    out[12] = await sendOnce(borrow listener, port, 5, one5[..])?;
    let one6 = [3usize, 100000usize, 0usize, 2usize];
    out[13] = await sendOnce(borrow listener, port, 6, one6[..])?;
