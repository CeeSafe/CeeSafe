fn showAfter(sizes: Slice<usize>, skip: usize) {
    let n = total(sizes);
    let bytes = match (content(0, n)) {
        Ok(v) => v,
        Err(_) => { return; },
    };
    let all = bytes.view();
    let parts = partsOf(all, sizes);
    let rest = parts.after(skip);
    if (rest.count() == 0) {
        Console.writeLine("none");
        return;
    }
    for (i in 0..rest.count()) {
        if (i > 0) {
            Console.write(",");
        }
        Console.write(rest.part(i).length);
    }
    Console.writeLine("");
}

fn main() {
    match (Async.run(run())) {
        Ok(lines) => {
            for (k in 0..lines.length) {
                let v = lines[k];
                if (k < 7) {
                    Console.write(v / 4294967296);
                    Console.write(" ");
                    Console.writeLine(v % 4294967296);
                } else {
                    Console.writeLine(v);
                }
            }
        }
        Err(AsyncError.Io(e)) => { Console.writeLine(e.message()); }
        Err(_) => { Console.writeLine("failed"); }
    }
    let sizes0 = [5usize, 0usize, 7usize];
    showAfter(sizes0[..], 0);
    showAfter(sizes0[..], 3);
    showAfter(sizes0[..], 5);
    showAfter(sizes0[..], 6);
    showAfter(sizes0[..], 12);
    showAfter(sizes0[..], 13);
    let sizes1 = [1usize, 2usize, 3usize, 4usize, 5usize, 6usize, 7usize, 8usize];
    showAfter(sizes1[..], 0);
    showAfter(sizes1[..], 1);
    showAfter(sizes1[..], 10);
    showAfter(sizes1[..], 35);
    showAfter(sizes1[..], 36);
    let eight = [0u8; 8];
    let all = eight[..];
    let ones = [1usize; 8];
    let full = partsOf(all, ones[..]);
    Console.writeLine(if (full.then(all[0..1]) == null) "full" else "room");
}
