    let all5 = [70000usize, 1usize, 130000usize];
    out[5] = await sendAll(borrow listener, port, 5, all5[..])?;
    let all6 = [3usize, 100000usize, 0usize, 2usize];
    out[6] = await sendAll(borrow listener, port, 6, all6[..])?;
