// GENERATED by tools/oracles/gen_udp_cases.py: edit that, not this file.
// lib/std's AsyncUdpSocket (ADR 0050) on loopback: datagrams on IPv4 and IPv6, an empty one, a truncated one, the peer
// and the local address reported, and a send in segments whose parts the segments cross. Each expected line is the
// generator's (the bytes each datagram must carry, computed in Python).

fn io<T>(r: Result<T, IoError>) -> Result<T, AsyncError> => match (r) {
    Ok(v) => Ok(v),
    Err(e) => Err(AsyncError.Io(e)),
};

fn fnv(bytes: Slice<u8>) -> u64 {
    var x: u32 = 2166136261;
    for (b in bytes) {
        x = truncate<u32>((x ^ (b as u32)) as u64 * 16777619);
    }
    return x as u64;
}

/// The case's bytes: byte i is (7 i + case) mod 251.
fn content(case: u32, total: usize) -> Result<Vector<u8>, AsyncError> {
    var v = Vector<u8>.create();
    for (i in 0..total) {
        match (v.push(truncate<u8>((7 * i as u64 + case as u64) % 251))) {
            Ok() => {}
            Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }
        }
    }
    return Ok(v);
}

fn same(a: SocketAddress, b: SocketAddress) -> bool {
    match (a) {
        SocketAddress.V4(x, p) => {
            match (b) {
                SocketAddress.V4(y, q) => {
                    return p == q && x[0] == y[0] && x[1] == y[1] && x[2] == y[2] && x[3] == y[3];
                }
                _ => { return false; }
            }
        }
        SocketAddress.V6(x, p, s) => {
            match (b) {
                SocketAddress.V6(y, q, t) => {
                    var equal = p == q && s == t;
                    for (k in 0..16usize) {
                        if (x[k] != y[k]) {
                            equal = false;
                        }
                    }
                    return equal;
                }
                _ => { return false; }
            }
        }
    }
}

fn sameLocal(to: SocketAddress?, address: SocketAddress) -> bool => match (to) {
    Some(t) => same(t, address),
    null => false,
};

/// A line: a datagram's length and FNV-1a, packed as length * 2^32 + FNV-1a.
fn add(out: borrow mut Vector<u64>, value: u64) -> Result<void, AsyncError> {
    match (out.push(value)) {
        Ok() => { return Ok(); }
        Err(_) => { return Err(AsyncError.Io(IoError.OutOfMemory)); }
    }
}

fn datagram(bytes: Slice<u8>) -> u64 => (bytes.length as u64) * 4294967296 + fnv(bytes);

async fn run() -> Result<Vector<u64>, AsyncError> {
    var out = Vector<u64>.create();
    var local = UdpOptions.defaults();
    local.receiveLocal = true;
    let a = io(AsyncUdpSocket.bind(SocketAddresses.v4Loopback(0), local))?;
    let b = io(AsyncUdpSocket.bind(SocketAddresses.v4Loopback(0), UdpOptions.defaults()))?;
    let aAddress = io(a.localAddress())?;
    let bAddress = io(b.localAddress())?;
    var buffer = [0u8; 4096];

    // 1. IPv4, and the peer.
    let first = content(0, 100)?;
    await b.sendTo(first.view(), aAddress)?;
    let got = await a.recvFrom(mut buffer[..])?;
    add(mut out, datagram(buffer[0..got.length]))?;
    add(mut out, if (same(got.from, bAddress)) 1 else 0)?;

    // 2. An empty datagram.
    let none = first.view();
    await b.sendTo(none[0..0], aAddress)?;
    let empty = await a.recvFrom(mut buffer[..])?;
    add(mut out, datagram(buffer[0..empty.length]))?;

    // 3. Truncated.
    let long = content(1, 1000)?;
    await b.sendTo(long.view(), aAddress)?;
    let cut = await a.recvFrom(mut buffer[0..100])?;
    add(mut out, datagram(buffer[0..cut.length]))?;
    add(mut out, if (cut.truncated) 1 else 0)?;

    // 4. The local address.
    let small = content(2, 10)?;
    await b.sendTo(small.view(), aAddress)?;
    let message = await a.recvMsg(mut buffer[..])?;
    add(mut out, datagram(buffer[0..message.length]))?;
    add(mut out, if (sameLocal(message.to, aAddress)) 1 else 0)?;

    // 5. Segments that cross the parts.
    let whole = content(4, 2500)?;
    let all = whole.view();
    let parts = match (IoParts.of(all[0..700]).then(all[700..2500])) {
        Some(p) => p,
        null => { return Err(AsyncError.Io(IoError.InvalidInput)); }
    };
    let segmented = UdpMessage { parts: parts, to: aAddress, from: null, ecn: 0, segmentSize: 1000 };
    let sent = await b.sendMsg(borrow segmented)?;
    add(mut out, sent as u64)?;
    for (k in 0..3) {
        let piece = await a.recvFrom(mut buffer[..])?;
        add(mut out, datagram(buffer[0..piece.length]))?;
    }

    // 6. IPv6.
    let c = io(AsyncUdpSocket.bind(SocketAddresses.v6Loopback(0), local))?;
    let d = io(AsyncUdpSocket.bind(SocketAddresses.v6Loopback(0), UdpOptions.defaults()))?;
    let cAddress = io(c.localAddress())?;
    let dAddress = io(d.localAddress())?;
    let six = content(3, 300)?;
    await d.sendTo(six.view(), cAddress)?;
    let v6 = await c.recvMsg(mut buffer[..])?;
    add(mut out, datagram(buffer[0..v6.length]))?;
    add(mut out, if (same(v6.from, dAddress)) 1 else 0)?;
    add(mut out, if (sameLocal(v6.to, cAddress)) 1 else 0)?;
    return Ok(out);
}

fn main() {
    match (Async.run(run())) {
        Ok(out) => {
            // Which lines are datagrams (length and FNV-1a) and which are numbers.
            let kinds = [1u8, 0, 1, 1, 2, 1, 0, 0, 1, 1, 1, 1, 0, 0];
            for (k in 0..out.length) {
                let v = out[k];
                if (kinds[k] == 1) {
                    Console.write(v / 4294967296);
                    Console.write(" ");
                    Console.writeLine(v % 4294967296);
                } else if (kinds[k] == 2) {
                    Console.write("truncated ");
                    Console.writeLine(v);
                } else {
                    Console.writeLine(v);
                }
            }
        }
        Err(AsyncError.Io(e)) => { Console.writeLine(e.message()); }
        Err(_) => { Console.writeLine("failed"); }
    }
}
