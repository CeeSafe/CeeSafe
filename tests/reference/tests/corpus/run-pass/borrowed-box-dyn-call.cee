// Bug B11 (found by CeeSafe.Web, its probe tests/probes/borrowed-box-dyn-call-bug.cee on ceesafec 0.9.1); see ROADMAP §10's row.
interface Run {
    fn run(borrow this) -> u32;
}

struct Seven {}

impl Run for Seven {
    fn run(borrow this) -> u32 => 7;
}

struct Holder {
    items: Vector<Box<dyn Run>>;

    fn item(borrow this, i: usize) -> borrow Box<dyn Run> => borrow this.items[i];
}

fn main() {
    var h = Holder { items: Vector<Box<dyn Run>>.create() };
    let b: Box<dyn Run> = Box.create(Seven {})!;
    h.items.push(b)!;
    Console.writeLine(h.item(0).run());
}
// expect-stdout: 7
