// Console.readLine (ADR 0106): a line of standard input into a String, without its ending. The input (`// stdin:`,
// at the end) has lines ended by `\n` and by `\r\n`, empty lines, a line that is not UTF-8 (InvalidInput: it is
// consumed, and the next call reads the line after it), a line of 5,200 bytes (52 directives of 100; longer than the
// runtime's block and lib/std's chunk), bytes taken by Console.read between two lines (it takes what readLine's block holds first), and
// a last line without an ending; then the end of the input, which stays the end.

fn show(text: StringView) {
    Console.write("[");
    Console.write(text);
    Console.write("] ");
    Console.writeLine(text.length);
}

fn main() {
    var line = String.create();
    for (k in 0..6) {
        if (Console.readLine(mut line)!) {
            show(line.view());
        }
    }
    // A carriage return that does not end the line stays in it.
    let inside = Console.readLine(mut line)!;
    Console.writeLine(line.length);
    match (Console.readLine(mut line)) {
        Ok(_) => { Console.writeLine("accepted"); }
        Err(e) => {
            Console.write(e.message());
            Console.write(" ");
            Console.writeLine(line.length);
        }
    }
    let after = Console.readLine(mut line)!;
    show(line.view());
    let long = Console.readLine(mut line)!;
    let text = line.view();
    let bytes = text.bytes();
    var digits = inside && after && long;
    for (k in 0..bytes.length) {
        if (bytes[k] != 48 + truncate<u8>(k % 10)) {
            digits = false;
        }
    }
    Console.write(bytes.length);
    Console.write(" ");
    Console.writeLine(digits);
    // Console.read between two lines: the next three bytes, in order.
    var three = [0u8; 3];
    var got: usize = 0;
    while (got < 3) {
        let n = Console.read(mut three[got..])!;
        if (n == 0) {
            break;
        }
        got += n;
    }
    Console.write(got);
    Console.write(" ");
    Console.writeLine(StringView.fromUtf8(three[..got])!);
    while (Console.readLine(mut line)!) {
        show(line.view());
    }
    Console.write(Console.readLine(mut line)!);
    Console.write(" ");
    Console.writeLine(line.length);
    Console.writeLine(Console.read(mut three[..])!);
}
