// Slice and array patterns on `[T; N]` with N a const parameter (ADR 0083 §7): the generic version matches it as a
// slice, each instance with its own length. An arm one instance cannot reach (`_` when N is 2) is no error of that
// instance; a pattern whose count its length cannot have is (check-fail/const-generics-array-patterns.cee).
fn firstTwo<const N: usize>(a: [u8; N]) -> u32 => match (a) {
    [x, y, ..] => (x as u32) * 10 + (y as u32),
    _ => 99,
};

fn lastOf<const N: usize>(a: [i32; N]) -> i32 => match (a) {
    [.., z] => z,
    _ => -1,
};

fn restLength<const N: usize>(a: [i32; N]) -> usize => match (a[..]) {
    [_, rest @ ..] => rest.length,
    [] => 0,
};

fn startsWithOne<const N: usize>(a: [i32; N]) -> bool => a is [1, ..];

fn ends<const N: usize>(a: [u64; N]) -> u64 => match (a) {
    [x, .., y] => x * 10 + y,
    _ => 0,
};

fn main() {
    Console.writeLine(firstTwo([1u8, 2u8, 3u8]));
    Console.writeLine(firstTwo([4u8, 5u8]));
    Console.writeLine(lastOf([4, 5, 6]));
    Console.writeLine(restLength([4, 5, 6]));
    Console.writeLine(startsWithOne([1, 2]));
    Console.writeLine(startsWithOne([2, 1]));
    Console.writeLine(ends([7u64, 9]));
    Console.writeLine(ends([7u64, 8, 9]));
}
// expect-stdout: 12
// expect-stdout: 45
// expect-stdout: 6
// expect-stdout: 2
// expect-stdout: true
// expect-stdout: false
// expect-stdout: 79
// expect-stdout: 79
