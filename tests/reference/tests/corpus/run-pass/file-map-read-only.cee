// Read-only shared mappings and 16-bit atomics (ADR 0235), the same output natively and in the interpreter: a
// read-only mapping of a file opened for reading only sees what a read-write mapping and the file's own writes put
// there (copies, load16, load32, an offset not on a page); store16, compareExchange16 (success and failure) and
// fetchAdd16 (wrapping) change their two bytes only; four threads count to 40 000 with compareExchange16 loops through
// two mappings; a read-write File may be mapped read-only too; the errors: a range past the file's end (never
// extended), length 0, a range past 2^63 - 1, a File open only for writing. Integers are in the host's byte order,
// little-endian on every host CeeSafe runs on. Python's mmap, another process and SQLite's -shm are
// tools/file_map_check.py's.

fn counted() -> u16 => 10000;

/// Adds 1 to the u16 at byte `at`, `times` times, by compare-exchange loops.
fn count(m: borrow SharedMapping, at: usize, times: u16) {
    var left = times;
    while (left > 0) {
        left -= 1;
        var seen = m.load16(at, LoadOrdering.Relaxed);
        loop {
            match (m.compareExchange16(at, seen, seen + 1, Ordering.AcquireRelease)) {
                Ok(_) => { break; }
                Err(now) => { seen = now; }
            }
        }
    }
}

fn shown(r: Result<u16, u16>) -> StringView => match (r) {
    Ok(_) => "Ok",
    Err(_) => "Err",
};

fn basics(path: StringView) -> Result<void, IoError> {
    let f = File.createReadWrite(path)?;
    let w = f.mapShared(0, 8192)?;
    let reader = File.open(path)?;
    let r = reader.mapSharedReadOnly(0, 8192)?;
    Console.writeLine(r.length());
    Console.writeLine(r.offset());
    // A copy written through the read-write mapping, read through the read-only one.
    w.writeAt(100, "hello".bytes());
    var got = [0u8; 5];
    r.readAt(100, mut got[..]);
    Console.writeLine(StringView.fromUtf8(got[..]) ?? "?");
    // 16-bit atomics: a slot and its neighbour.
    w.store16(200, 0xBEEF, StoreOrdering.Release);
    Console.writeLine(r.load16(200, LoadOrdering.Acquire));
    Console.writeLine(r.load32(200, LoadOrdering.SequentiallyConsistent));
    w.store16(202, 1, StoreOrdering.SequentiallyConsistent);
    Console.writeLine(r.load32(200, LoadOrdering.Relaxed));
    let first = w.compareExchange16(202, 1, 2, Ordering.SequentiallyConsistent);
    Console.writeLine(shown(first));
    match (w.compareExchange16(202, 1, 3, Ordering.Acquire)) {
        Ok(v) => { Console.writeLine(v); }
        Err(v) => { Console.writeLine(v); }
    }
    Console.writeLine(w.load16(202, LoadOrdering.Relaxed));
    Console.writeLine(w.fetchAdd16(204, 0xFFFF, Ordering.Relaxed));
    Console.writeLine(w.fetchAdd16(204, 2, Ordering.Release));
    Console.writeLine(r.load16(204, LoadOrdering.Acquire));
    Console.writeLine(r.load16(200, LoadOrdering.Acquire));
    Console.writeLine(r.load16(206, LoadOrdering.Acquire));
    // What the file is written with.
    let bytes = [0x34u8, 0x12];
    f.writeAt(bytes[..], 300)?;
    Console.writeLine(r.load16(300, LoadOrdering.Acquire));
    // An offset not on a page: file byte 4200 is its byte 102.
    w.store16(4200, 777, StoreOrdering.Release);
    let s = reader.mapSharedReadOnly(4098, 200)?;
    Console.writeLine(s.load16(102, LoadOrdering.Acquire));
    SharedMapping.fence();
    // A File open for reading and writing may be mapped read-only.
    let t = f.mapSharedReadOnly(0, 16)?;
    Console.writeLine(t.length());
    Console.writeLine(f.length()?);
    return Ok();
}

/// Four threads, two through each of two mappings of the same bytes, counting at one u16 slot; its neighbours stay.
fn counting(path: StringView) -> Result<void, IoError> {
    let f = File.openReadWrite(path)?;
    let a = Arc<SharedMapping>.create(f.mapShared(6144, 64)?)!;
    let b = Arc<SharedMapping>.create(f.mapShared(6144, 64)?)!;
    a.get().store16(8, 0x5555, StoreOrdering.Relaxed);
    a.get().store16(12, 0xAAAA, StoreOrdering.Relaxed);
    let m0 = a.clone();
    let m1 = b.clone();
    let m2 = a.clone();
    let m3 = b.clone();
    let t0 = Thread.spawn(move () => { count(m0.get(), 10, counted()); })!;
    let t1 = Thread.spawn(move () => { count(m1.get(), 10, counted()); })!;
    let t2 = Thread.spawn(move () => { count(m2.get(), 10, counted()); })!;
    let t3 = Thread.spawn(move () => { count(m3.get(), 10, counted()); })!;
    t0.join();
    t1.join();
    t2.join();
    t3.join();
    let reader = File.open(path)?;
    let r = reader.mapSharedReadOnly(6144, 64)?;
    Console.writeLine(r.load16(10, LoadOrdering.SequentiallyConsistent));
    Console.writeLine(r.load16(8, LoadOrdering.SequentiallyConsistent));
    Console.writeLine(r.load16(12, LoadOrdering.SequentiallyConsistent));
    return Ok();
}

fn errors(path: StringView, other: StringView) -> Result<void, IoError> {
    let reader = File.open(path)?;
    match (reader.mapSharedReadOnly(8190, 4)) {
        Ok(_) => { Console.writeLine("past the end mapped"); }
        Err(e) => { Console.writeLine(e.message()); }
    }
    Console.writeLine(reader.length()?);
    match (reader.mapSharedReadOnly(0, 0)) {
        Ok(_) => { Console.writeLine("length 0 mapped"); }
        Err(e) => { Console.writeLine(e.message()); }
    }
    match (reader.mapSharedReadOnly(0x7FFFFFFFFFFFFFFF, 1)) {
        Ok(_) => { Console.writeLine("past 2^63 mapped"); }
        Err(e) => { Console.writeLine(e.message()); }
    }
    var writer = File.create(other)?;
    writer.write("sixteen bytes...".bytes())?;
    match (writer.mapSharedReadOnly(0, 16)) {
        Ok(_) => { Console.writeLine("a write-only file mapped"); }
        Err(IoError.BadDescriptor) => { Console.writeLine("BadDescriptor"); }
        Err(e) => { Console.writeLine(e.message()); }
    }
    return Ok();
}

fn main() {
    let dir = Directory.temporary()!;
    var path = String.create();
    path.append(dir.view())!;
    path.append("/db-shm")!;
    var other = String.create();
    other.append(dir.view())!;
    other.append("/written")!;
    match (basics(path.view())) {
        Ok() => {}
        Err(e) => { Console.writeLine(e.message()); }
    }
    match (counting(path.view())) {
        Ok() => {}
        Err(e) => { Console.writeLine(e.message()); }
    }
    match (errors(path.view(), other.view())) {
        Ok() => {}
        Err(e) => { Console.writeLine(e.message()); }
    }
    File.remove(path.view())!;
    File.remove(other.view())!;
    Directory.remove(dir.view())!;
}
