struct Tally {
    cases: u32;
    failed: u32;
}

fn show(x: f64) {
    if (x == 0.0 && x.bits() != 0) {
        Console.write("-0");
    } else {
        Console.write(x);
    }
}

fn line(label: StringView, x: f64) {
    Console.write(label);
    Console.write(" = ");
    show(x);
    Console.writeLine("");
}

/// The bits of `b` in the order of the values they stand for, so that neighbours differ by one.
fn ordered(b: u64) -> u64 =>
    if (b >= 0x8000000000000000) 0x8000000000000000 - (b - 0x8000000000000000) else 0x8000000000000000 + b;

fn near(t: borrow mut Tally, label: StringView, x: f64, expected: u64) {
    t.cases += 1;
    let e = f64.fromBits(expected);
    var ok = x != x && e != e;
    if (x == x && e == e) {
        let a = ordered(x.bits());
        let b = ordered(expected);
        ok = (if (a > b) a - b else b - a) <= 4;
    }
    if (!ok) {
        t.failed += 1;
        Console.write(label);
        Console.write(" = ");
        show(x);
        Console.write(", expected ");
        show(e);
        Console.writeLine("");
    }
}

fn done(t: borrow mut Tally, name: StringView) {
    Console.write(name);
    Console.write(": ");
    Console.write(t.cases - t.failed);
    Console.write(" of ");
    Console.write(t.cases);
    Console.writeLine(" within 4 ulps");
    t.cases = 0;
    t.failed = 0;
}

