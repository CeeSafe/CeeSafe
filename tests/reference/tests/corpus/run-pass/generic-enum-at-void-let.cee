// A generic enum at `void` whose first use is a written type of a local, a field or an element (type-system.md §20.4,
// ADR 0213): the payloads are declared on their own, whatever type made the instance.
// expect-stdout: done
// expect-stdout: nothing
// expect-stdout: 1
// expect-stdout: some

enum First<T> {
    Done(T),
    Nothing,
}

enum Second<T> {
    Done(T),
    Nothing,
}

enum Third<T> {
    Done(T),
    Nothing,
}

enum Fourth<T> {
    Done(T),
    Nothing,
}

struct Holds {
    value: Second<void>;
}

fn main() {
    let a: First<void> = First<void>.Done();
    Console.writeLine(if (a is First.Done()) "done" else "nothing");
    let b = Holds { value: Second.Nothing };
    Console.writeLine(if (b.value is Second.Done()) "done" else "nothing");
    var v = Vector<Third<void>>.create();
    v.push(Third.Done())!;
    Console.writeLine(v.length);
    let o: Fourth<void>? = Some(Fourth.Nothing);
    Console.writeLine(if (o.isSome()) "some" else "null");
}
