// Match guards (ADR 0085 §2.2, type-system.md §15.2): arms tried in order, the guard after the pattern and its
// bindings, a false guard going on to the next arm; in a consuming match the guard reads a payload in place, and an
// arm whose guard fails has moved nothing.

struct Res { id: u32; drop { Console.write("drop "); Console.writeLine(this.id); } }
enum Slot { Full(Res), Spare }
enum Shape { Circle(u32), Rect(u32, u32) }

fn size(x: u32?) -> StringView {
    match (x) {
        Some(n) if (n > 3) => { return "big"; }
        Some(n) if (n == 0) => { return "zero"; }
        Some(_) => { return "small"; }
        null => { return "none"; }
    }
}

fn magnitude(x: i32?) -> i32 => match (x) {
    Some(n) if (n < 0) => -n,
    Some(n) => n,
    null => 0,
};

fn noted(r: borrow Res, wanted: u32) -> bool {
    Console.write("guard ");
    Console.writeLine(r.id);
    return r.id == wanted;
}

// The first arm's guard fails for 8: nothing moved, the second arm takes the payload.
fn take(s: Slot) -> u32 {
    match (s) {
        Slot.Full(r) if (noted(r, 7)) => { return r.id + 100; }
        Slot.Full(r) => { return r.id; }
        Slot.Spare => { return 0; }
    }
}

// A guard of a consuming match reading the scrutinee itself.
fn spare(s: Slot) -> u32 {
    match (s) {
        Slot.Full(r) if (isSeven(s)) => { return r.id * 2; }
        Slot.Full(r) => { return r.id; }
        Slot.Spare => { return 0; }
    }
}

fn isSeven(s: borrow Slot) -> bool => match (s) {
    Slot.Full(r) => r.id == 7,
    Slot.Spare => false,
};

// A guard on a reference scrutinee: the bindings are references.
fn area(s: borrow Shape) -> u32 => match (s) {
    Shape.Rect(w, h) if (w == h) => 1000 + w * h,
    Shape.Rect(w, h) => w * h,
    Shape.Circle(r) if (r > 10) => 999,
    Shape.Circle(r) => 3 * r * r,
};

// A guard may write other places.
fn counted(n: u32, calls: borrow mut u32) -> bool {
    calls += 1;
    return n % 2 == 0;
}

fn main() {
    Console.writeLine(size(Some(5)));
    Console.writeLine(size(Some(0)));
    Console.writeLine(size(Some(2)));
    Console.writeLine(size(null));
    Console.writeLine(magnitude(Some(-4)));
    Console.writeLine(magnitude(Some(6)));
    Console.writeLine(take(Slot.Full(Res { id: 7 })));
    Console.writeLine(take(Slot.Full(Res { id: 8 })));
    Console.writeLine(take(Slot.Spare));
    Console.writeLine(spare(Slot.Full(Res { id: 7 })));
    Console.writeLine(spare(Slot.Full(Res { id: 9 })));
    let square = Shape.Rect(3, 3);
    let wide = Shape.Rect(2, 5);
    let big = Shape.Circle(11);
    let small = Shape.Circle(2);
    Console.writeLine(area(square));
    Console.writeLine(area(wide));
    Console.writeLine(area(big));
    Console.writeLine(area(small));
    // Guards run in arm order, only for arms whose pattern matched.
    var total: u32 = 0;
    var calls: u32 = 0;
    for (i in 0..5u32) {
        let o: u32? = if (i == 4) null else Some(i);
        match (o) {
            Some(n) if (counted(n, mut calls)) => { total += n; }
            Some(_) => { total += 100; }
            null => { total += 1000; }
        }
    }
    Console.writeLine(total);
    Console.writeLine(calls);
}

// expect-stdout: big
// expect-stdout: zero
// expect-stdout: small
// expect-stdout: none
// expect-stdout: 4
// expect-stdout: 6
// expect-stdout: guard 7
// expect-stdout: drop 7
// expect-stdout: 107
// expect-stdout: guard 8
// expect-stdout: drop 8
// expect-stdout: 8
// expect-stdout: 0
// expect-stdout: drop 7
// expect-stdout: 14
// expect-stdout: drop 9
// expect-stdout: 9
// expect-stdout: 1009
// expect-stdout: 10
// expect-stdout: 999
// expect-stdout: 12
// expect-stdout: 1202
// expect-stdout: 4
