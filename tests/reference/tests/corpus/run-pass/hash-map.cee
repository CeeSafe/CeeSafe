            });
        } else if (kinds[i] == 1) {
            h = fnv(h, match (map.get(borrow k)) {
                Some(v) => 1 + v,
                null => 0,
            });
        } else if (kinds[i] == 2) {
            h = fnv(h, match (map.remove(borrow k)) {
                Some(old) => 1 + old,
                null => 0,
            });
        } else {
            h = fnv(h, if (map.contains(borrow k)) 1 else 0);
        }
    }
    Console.write(h);
    Console.write(" ");
    Console.writeLine(map.length());
    for (i in 0..(if (map.length() < 40) map.length() else 40)) {
        if (i > 0) {
            Console.write(" ");
        }
        Console.write(map.keyAt(i));
        Console.write("=");
        Console.write(map.valueAt(i));
    }
    Console.writeLine("");

    // 3. String keys, under the process's random key: the output does not depend on it.
    var names = HashMap<String, u64>.create();
    showPut(mut names, "host", 1);
    showPut(mut names, "accept", 2);
    showPut(mut names, "user-agent", 3);
    showPut(mut names, "content-length", 4);
    showPut(mut names, "cookie", 5);
    showRemove(mut names, "accept");
    showPut(mut names, "x-trace", 6);
    showPut(mut names, "host", 7);
    showRemove(mut names, "zzz");
    showRemove(mut names, "user-agent");
    for (i in 0..names.length()) {
        if (i > 0) {
            Console.write(" ");
        }
        let name = names.keyAt(i);
        Console.write(name.view());
        Console.write("=");
        Console.write(names.valueAt(i));
    }
    Console.writeLine("");
}
