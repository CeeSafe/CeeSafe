// An impl's method has the interface's flows (type-system.md §21.1, ADR 0131 §2.3): its signature names one region
// for the value it keeps and for the tag it only reads, as the interface's argument makes it, so by its regions it
// could keep the tag; its body does not, and that is no error. The caller's tag then dies before the bag does.
interface Sink<T> {
    fn put(borrow mut this, v: T, tag: StringView) -> Result<usize, AllocError>;
}
struct Bag<region r> {
    kept: Vector<StringView<r>>;
    tagged: usize;
}
impl<region r> Sink<StringView<r>> for Bag<r> {
    fn put(borrow mut this, v: StringView<r>, tag: StringView<r>) -> Result<usize, AllocError> {
        this.kept.push(v)?;
        this.tagged += tag.length;
        return Ok(this.kept.length);
    }
}
fn fill<T, K: Sink<T>>(sink: borrow mut K, v: T) -> Result<usize, AllocError> {
    // The tag is a local: the sink keeps the value, not the tag.
    let tag = String.from("generic")!;
    return sink.put(v, tag.view());
}
fn direct<region r>(bag: borrow mut Bag<r>, v: StringView<r>) -> Result<usize, AllocError> {
    let tag = String.from("direct")!;
    return bag.put(v, tag.view());
}
fn main() {
    let text = String.from("one two")!;
    var bag = Bag { kept: Vector<StringView>.create(), tagged: 0 };
    Console.writeLine(fill<StringView, Bag>(mut bag, text.view()[0..3])!);
    Console.writeLine(direct(mut bag, text.view()[4..7])!);
    Console.writeLine(bag.tagged);
    Console.writeLine(bag.kept[0]);
    Console.writeLine(bag.kept[1]);
}

// expect-stdout: 1
// expect-stdout: 2
// expect-stdout: 13
// expect-stdout: one
// expect-stdout: two
