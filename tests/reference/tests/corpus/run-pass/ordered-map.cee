// GENERATED by tools/oracles/gen_ordered_map_cases.py: edit that, not this file.
// lib/std's OrderedMap (ADR 0075 §2.4) against the generator's model (a sorted list beside a dict), the operations
// drawn from the same xorshift64 in both.

struct Rng {
    x: u64;

    fn next(borrow mut this) -> u64 {
        this.x = this.x ^ (this.x << 13);
        this.x = this.x ^ (this.x >> 7);
        this.x = this.x ^ (this.x << 17);
        return this.x;
    }
}

fn fnv(h: u64, value: u64) -> u64 {
    var x = h;
    for (k in 0..8u64) {
        x = (x ^ ((value >> (8 * k)) & 0xFF)).wrappingMul(0x100000001B3);
    }
    return x;
}

fn some(h: u64, value: u64?) -> u64 => match (value) {
    Some(v) => fnv(h, 1 + v),
    null => fnv(h, 0),
};

fn showLength(map: borrow OrderedMap<u64, u64>) {
    Console.write(" ");
    Console.write(map.length());
}

fn ends(map: borrow OrderedMap<u64, u64>) {
    Console.write(" ");
    Console.write(map.keyAt(map.first()!));
    Console.write(" ");
    Console.write(map.keyAt(map.last()!));
}

fn wholeHash(map: borrow OrderedMap<u64, u64>) -> u64 {
    var h: u64 = 0xCBF29CE484222325;
    var c = map.first();
    while (c != null) {
        let at = c!;
        h = fnv(fnv(h, map.keyAt(at)), map.valueAt(at));
        c = map.next(at);
    }
    return h;
}

fn u64Cases() {
    var rng = Rng { x: 0x9E3779B97F4A7C15 };
    var map = OrderedMap<u64, u64>.create();
    var h: u64 = 0xCBF29CE484222325;
    // 1. fill
    for (i in 0..10000u64) {
        h = some(h, map.put(4 * i, rng.next() >> 1)!);
    }
    Console.write("fill ");
    Console.write(h);
    showLength(borrow map);
    Console.writeLine("");
    // 2. mixed
    for (i in 0..8000u64) {
        let op = rng.next() % 10;
        let k = (rng.next() >> 3) % 40000;
        if (op < 4) {
            h = some(h, map.put(k, rng.next() >> 1)!);
        } else if (op < 6) {
            h = some(h, map.remove(borrow k));
        } else if (op == 6) {
            match (map.get(borrow k)) {
                Some(v) => {
                    h = fnv(h, 1 + v);
                }
                null => {
                    h = fnv(h, 0);
                }
            }
        } else if (op == 7 || op == 8) {
            let found = if (op == 7) map.seek(borrow k) else map.seekAfter(borrow k);
            match (found) {
                Some(at) => {
                    h = fnv(h, 1 + map.keyAt(at));
                    h = fnv(h, 1 + map.valueAt(at));
                }
                null => {
                    h = fnv(h, 0);
                }
            }
        } else {
            h = fnv(h, if (map.contains(borrow k)) 1 else 0);
        }
        if ((i + 1) % 1000 == 0) {
            Console.write("mixed ");
            Console.write(i + 1);
            Console.write(" ");
            Console.write(h);
            showLength(borrow map);
            ends(borrow map);
            Console.writeLine("");
        }
    }
    // 3. scans
    Console.write("forward ");
    Console.write(wholeHash(borrow map));
    showLength(borrow map);
    Console.writeLine("");
    h = 0xCBF29CE484222325;
    var back = map.last();
    var n: usize = 0;
    while (back != null) {
        let at = back!;
        h = fnv(fnv(h, map.keyAt(at)), map.valueAt(at));
        n += 1;
        back = map.previous(at);
    }
    Console.write("backward ");
    Console.write(h);
    Console.write(" ");
    Console.writeLine(n);
    for (r in 0..30) {
        let lo = rng.next() % 40000;
        let hi = lo + rng.next() % 3000;
        var count: u64 = 0;
        var sum: u64 = 0;
        var c = map.seek(borrow lo);
        while (c != null) {
            let at = c!;
            if (map.keyAt(at).compareKey(borrow hi) >= 0) {
                break;
            }
            count += 1;
            sum += map.keyAt(at);
            c = map.next(at);
        }
        Console.write("range ");
        Console.write(lo);
        Console.write(" ");
        Console.write(hi);
        Console.write(" ");
        Console.write(count);
        Console.write(" ");
        Console.writeLine(sum);
    }
    // 4. changes in place: a cursor walk that writes, then getMut
    var w = map.first();
    while (w != null) {
        let at = w!;
        if (map.keyAt(at) % 7 == 0) {
            let v = map.valueAtMut(at);
            v = v ^ 0x5555;
        }
        w = map.next(at);
    }
    for (r in 0..100) {
        let k = rng.next() % 40000;
        match (map.getMut(borrow k)) {
            Some(v) => {
                v += 1;
            }
            null => {}
        }
    }
    Console.write("changed ");
    Console.writeLine(wholeHash(borrow map));
    // 5. drain
    h = 0xCBF29CE484222325;
    for (i in 0..40000u64) {
        let k = (i * 7919) % 40000;
        h = some(h, map.remove(borrow k));
    }
    Console.write("drained ");
    Console.write(h);
    showLength(borrow map);
    Console.write(" ");
    Console.writeLine(map.isEmpty());
    if (map.first() == null && map.last() == null && map.seek(borrow h) == null) {
        Console.writeLine("first null");
    }
    // 6. refill, clear
    for (i in 0..500u64) {
        let old = map.put(1000 - 2 * i, i)!;
    }
    Console.write("refill");
    showLength(borrow map);
    ends(borrow map);
    Console.write(" ");
    let mid: u64 = 500;
    Console.writeLine(map.valueAt(map.seek(borrow mid)!));
    map.clear();
    Console.write("cleared");
    showLength(borrow map);
    Console.write(" ");
    Console.write(map.isEmpty());
    Console.writeLine(if (map.first() == null) " null" else " some");
    let again = map.put(3, 7)!;
    Console.write("after clear");
    showLength(borrow map);
    Console.write(" ");
    let three: u64 = 3;
    Console.writeLine(map.get(borrow three)!);
}

fn text(s: StringView) -> String {
    var t = String.create();
    t.append(s)!;
    return t;
}

fn showText(map: borrow OrderedMap<String, u32>, at: OrderedCursor?) {
    Console.write(" ");
    match (at) {
        Some(c) => {
            Console.write("[");
            let key = map.keyAt(c);
            Console.write(key.view());
            Console.write("]");
        }
        null => {
            Console.write("-");
        }
    }
}

fn textSeek(map: borrow OrderedMap<String, u32>, probe: StringView) {
    let key = text(probe);
    Console.write("text seek ");
    Console.write(probe);
    showText(map, map.seek(borrow key));
    showText(map, map.seekAfter(borrow key));
    Console.writeLine("");
}

fn textCases() {
    var map = OrderedMap<String, u32>.create();
    let words = ["pear", "", "apple", "app", "Zebra", "apples", "banana", "a", "zebra", "\u{E9}clair", "Apple", "b"];
    for (i in 0..words.length) {
        let old = map.put(text(words[i]), truncate<u32>(i))!;
    }
    let replaced = map.put(text("app"), 100)!;
    Console.write("text");
    var c = map.first();
    while (c != null) {
        let at = c!;
        Console.write(" [");
        let key = map.keyAt(at);
        Console.write(key.view());
        Console.write("]=");
        Console.write(map.valueAt(at));
        c = map.next(at);
    }
    Console.writeLine("");
    Console.write("text back");
    c = map.last();
    while (c != null) {
        let at = c!;
        Console.write(" [");
        let key = map.keyAt(at);
        Console.write(key.view());
        Console.write("]");
        c = map.previous(at);
    }
    Console.writeLine("");
    textSeek(borrow map, "apple");
    textSeek(borrow map, "apq");
    textSeek(borrow map, "c");
    textSeek(borrow map, "zz");
}

fn byteCases() {
    var map = OrderedMap<Vector<u8>, bool>.create();
    var key0 = Vector<u8>.create();
    let old0 = map.put(key0, true)!;
    var key1 = Vector<u8>.create();
    key1.push(0u8)!;
    let old1 = map.put(key1, true)!;
    var key2 = Vector<u8>.create();
    key2.push(0u8)!;
    key2.push(0u8)!;
    let old2 = map.put(key2, true)!;
    var key3 = Vector<u8>.create();
    key3.push(1u8)!;
    let old3 = map.put(key3, true)!;
    var key4 = Vector<u8>.create();
    key4.push(0u8)!;
    key4.push(255u8)!;
    let old4 = map.put(key4, true)!;
    var key5 = Vector<u8>.create();
    key5.push(255u8)!;
    let old5 = map.put(key5, true)!;
    var key6 = Vector<u8>.create();
    key6.push(1u8)!;
    key6.push(2u8)!;
    key6.push(3u8)!;
    let old6 = map.put(key6, true)!;
    var key7 = Vector<u8>.create();
    key7.push(1u8)!;
    key7.push(2u8)!;
    let old7 = map.put(key7, true)!;
    var key8 = Vector<u8>.create();
    key8.push(0u8)!;
    key8.push(0u8)!;
    key8.push(0u8)!;
    let old8 = map.put(key8, true)!;
    var key9 = Vector<u8>.create();
    key9.push(128u8)!;
    let old9 = map.put(key9, true)!;
    Console.write("bytes");
    var c = map.first();
    while (c != null) {
        let at = c!;
        let key = map.keyAt(at);
        Console.write(" [");
        for (k in 0..key.length) {
            if (k > 0) {
                Console.write(",");
            }
            Console.write(key[k]);
        }
        Console.write("]");
        c = map.next(at);
    }
    Console.writeLine("");
}

fn intCases() {
    var small = OrderedMap<i8, u8>.create();
    let smallKeys = [5i8, -1i8, 127i8, -127i8 - 1i8, 0i8, 64i8, -64i8, 1i8, -2i8];
    for (i in 0..smallKeys.length) {
        let old = small.put(smallKeys[i], 0)!;
    }
    Console.write("i8");
    var c = small.first();
    while (c != null) {
        let at = c!;
        Console.write(" ");
        Console.write(small.keyAt(at));
        c = small.next(at);
    }
    Console.writeLine("");
    var wide = OrderedMap<i64, u8>.create();
    let wideKeys = [3i64, -9000000000i64, 9000000000i64, 0i64, -1i64, 1i64];
    for (i in 0..wideKeys.length) {
        let old = wide.put(wideKeys[i], 0)!;
    }
    Console.write("i64");
    var d = wide.first();
    while (d != null) {
        let at = d!;
        Console.write(" ");
        Console.write(wide.keyAt(at));
        d = wide.next(at);
    }
    Console.writeLine("");
    var flags = OrderedMap<bool, u32>.create();
    let t = flags.put(true, 1)!;
    let f = flags.put(false, 2)!;
    let first = flags.first()!;
    let second = flags.next(first)!;
    Console.write("bool ");
    Console.write(flags.keyAt(first));
    Console.write("=");
    Console.write(flags.valueAt(first));
    Console.write(" ");
    Console.write(flags.keyAt(second));
    Console.write("=");
    Console.writeLine(flags.valueAt(second));
}

fn main() {
    u64Cases();
    textCases();
    byteCases();
    intCases();
}
