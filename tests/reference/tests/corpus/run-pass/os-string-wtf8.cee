// GENERATED by tools/oracles/gen_os_string_cases.py: lib/core's OsString and OsStringView (ADR 0257) against Python's
// `surrogatepass` codecs. Each case prints its units or bytes, the WTF-8 or UTF-16 made of them, `isWtf8`, `isUtf8`
// and the lossy text's bytes, in hex; then seeded cases (an LCG the generator runs too) summarised with FNV-1a.

fn hexBytes(bytes: Slice<u8>) -> String {
    var out = String.create();
    if (bytes.length == 0) {
        out.append("-")!;
    }
    for (b in bytes) {
        out.appendHex(b as u64, 2, false)!;
    }
    return out;
}

fn hexUnits(units: Slice<u16>) -> String {
    var out = String.create();
    if (units.length == 0) {
        out.append("-")!;
    }
    for (i in 0..units.length) {
        if (i > 0) {
            out.append(" ")!;
        }
        out.appendHex(units[i] as u64, 4, false)!;
    }
    return out;
}

fn showWide(units: Slice<u16>) {
    let name = OsString.fromWide(units)!;
    Console.write("wide ");
    Console.write(hexUnits(units).view());
    Console.write(" -> ");
    Console.write(hexBytes(name.bytes()).view());
    Console.write(" ");
    Console.write(name.isWtf8());
    Console.write(" ");
    Console.writeLine(name.isUtf8());
}

fn showBytes(bytes: Slice<u8>) {
    let name = OsStringView.fromBytes(bytes);
    let wide = name.toWide()!;
    Console.write("bytes ");
    Console.write(hexBytes(bytes).view());
    Console.write(" -> ");
    Console.write(name.isWtf8());
    Console.write(" ");
    match (wide) {
        Some(units) => { Console.write(hexUnits(units.view()).view()); }
        null => { Console.write("null"); }
    }
    Console.write(" ");
    Console.write(name.isUtf8());
    Console.write(" ");
    let text = name.toUtf8Lossy()!;
    Console.writeLine(hexBytes(text.view().bytes()).view());
}

fn next(state: borrow mut u64) -> u64 {
    state = state.wrappingMul(6364136223846793005).wrappingAdd(1442695040888963407);
    return state >> 33;
}

fn fnv(h: u64, bytes: Slice<u8>) -> u64 {
    var hash = h;
    for (b in bytes) {
        hash = (hash ^ (b as u64)).wrappingMul(0x100000001B3);
    }
    return hash;
}

fn randomUnits(state: borrow mut u64) -> Vector<u16> {
    let pool = [
        0x0061u16,
        0x007Au16,
        0x00E9u16,
        0x20ACu16,
        0xD800u16,
        0xDBFFu16,
        0xDC00u16,
        0xDFFFu16,
        0xD83Du16,
        0xDE00u16,
        0xFFFDu16,
        0x0800u16,
        0x07FFu16,
    ];
    var units = Vector<u16>.create();
    let count = next(mut state) % 9;
    for (k in 0..count) {
        let x = next(mut state);
        units.push(if (x % 10 < 7) pool[((x >> 4) % 13) as usize] else truncate<u16>((x >> 4) % 0x10000))!;
    }
    return units;
}

fn addPiece(k: u64, bytes: borrow mut Vector<u8>) {
    match (k) {
        0 => { bytes.extend([0x61u8][..])!; }
        1 => { bytes.extend([0xC3u8, 0xA9u8][..])!; }
        2 => { bytes.extend([0xEDu8, 0xA0u8, 0x80u8][..])!; }
        3 => { bytes.extend([0xEDu8, 0xB0u8, 0x80u8][..])!; }
        4 => { bytes.extend([0xF0u8, 0x9Fu8, 0x98u8, 0x80u8][..])!; }
        5 => { bytes.extend([0xEDu8][..])!; }
        6 => { bytes.extend([0xFFu8][..])!; }
        7 => { bytes.extend([0x80u8][..])!; }
        8 => { bytes.extend([0xE2u8, 0x82u8][..])!; }
        _ => { bytes.extend([0xEDu8, 0xBFu8, 0xBFu8][..])!; }
    }
}

fn randomBytes(state: borrow mut u64) -> Vector<u8> {
    var bytes = Vector<u8>.create();
    let count = next(mut state) % 7;
    for (k in 0..count) {
        addPiece(next(mut state) % 10, mut bytes);
    }
    return bytes;
}

fn main() {
    showWide(Vector<u16>.create().view());
    showWide([0x0061u16][..]);
    showWide([0x00E9u16][..]);
    showWide([0x20ACu16][..]);
    showWide([0xD83Du16, 0xDE00u16][..]);
    showWide([0xD800u16][..]);
    showWide([0xDC00u16][..]);
    showWide([0xDBFFu16, 0xDFFFu16][..]);
    showWide([0xDC00u16, 0xD800u16][..]);
    showWide([0xD800u16, 0x0061u16][..]);
    showWide([0x0061u16, 0xDFFFu16][..]);
    showWide([0xD800u16, 0xD800u16, 0xDC00u16][..]);
    showWide([0xD83Du16, 0xDE00u16, 0xDE00u16][..]);
    showWide([0xFFFFu16][..]);
    showWide([0xFEFFu16, 0x0000u16][..]);
    showWide([0x007Fu16, 0x0080u16, 0x07FFu16, 0x0800u16][..]);
    showWide([0xD7FFu16, 0xE000u16][..]);
    showWide([0x0061u16, 0xDC80u16, 0x0062u16][..]);
    showBytes(Vector<u8>.create().view());
    showBytes([0x61u8][..]);
    showBytes([0xC3u8, 0xA9u8][..]);
    showBytes([0xEDu8, 0xA0u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xBFu8, 0xBFu8][..]);
    showBytes([0xEDu8, 0xB0u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xA0u8, 0x80u8, 0xEDu8, 0xB0u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xB0u8, 0x80u8, 0xEDu8, 0xA0u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xA0u8, 0x80u8, 0x61u8, 0xEDu8, 0xB0u8, 0x80u8][..]);
    showBytes([0xF0u8, 0x9Fu8, 0x98u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xA0u8][..]);
    showBytes([0xEDu8][..]);
    showBytes([0xEDu8, 0x9Fu8, 0xBFu8][..]);
    showBytes([0xEEu8, 0x80u8, 0x80u8][..]);
    showBytes([0xFFu8][..]);
    showBytes([0xC0u8, 0xAFu8][..]);
    showBytes([0xE0u8, 0x80u8][..]);
    showBytes([0xF4u8, 0x90u8, 0x80u8, 0x80u8][..]);
    showBytes([0x61u8, 0xEDu8, 0xA0u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xA0u8, 0x80u8, 0xEDu8, 0xA0u8, 0x80u8][..]);
    showBytes([0xEDu8, 0xAFu8, 0xBFu8, 0xEDu8, 0xB0u8, 0x80u8][..]);
    showBytes([0x61u8, 0x62u8, 0x63u8, 0xEDu8, 0xA0u8, 0x80u8, 0xFFu8, 0x62u8][..]);
    showBytes([0xE2u8, 0x82u8][..]);
    showBytes([0xF0u8, 0x9Fu8, 0x98u8][..]);
    showBytes([0xEDu8, 0xA0u8, 0x80u8, 0xE2u8, 0x82u8][..]);
    showBytes([0xC3u8, 0x28u8, 0xEDu8, 0xA0u8, 0x80u8][..]);
    var state: u64 = 257;
    var wideHash: u64 = 0xCBF29CE484222325;
    var roundTrips = 0;
    let end = [0u8];
    for (i in 0..2000) {
        let units = randomUnits(mut state);
        let name = OsString.fromWide(units.view())!;
        wideHash = fnv(fnv(wideHash, name.bytes()), end[..]);
        match (name.view().toWide()!) {
            Some(back) => {
                if (back == units) {
                    roundTrips += 1;
                }
            }
            null => {}
        }
    }
    Console.write("random wide 2000 ");
    Console.write(roundTrips);
    Console.write(" ");
    Console.writeLine(wideHash);
    var byteHash: u64 = 0xCBF29CE484222325;
    var lossyHash: u64 = 0xCBF29CE484222325;
    var well = 0;
    var utf8 = 0;
    let separator = [0xFFu8, 0xFF];
    for (i in 0..2000) {
        let bytes = randomBytes(mut state);
        let name = OsStringView.fromBytes(bytes.view());
        match (name.toWide()!) {
            Some(units) => {
                well += 1;
                for (u in units) {
                    let pair = [truncate<u8>(u & 0xFF), truncate<u8>(u >> 8)];
                    byteHash = fnv(byteHash, pair[..]);
                }
                byteHash = fnv(byteHash, separator[..]);
            }
            null => {}
        }
        if (name.isUtf8()) {
            utf8 += 1;
        }
        let text = name.toUtf8Lossy()!;
        lossyHash = fnv(fnv(lossyHash, text.view().bytes()), end[..]);
    }
    Console.write("random bytes 2000 ");
    Console.write(well);
    Console.write(" ");
    Console.write(utf8);
    Console.write(" ");
    Console.write(byteHash);
    Console.write(" ");
    Console.writeLine(lossyHash);
}
