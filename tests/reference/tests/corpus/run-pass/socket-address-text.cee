// addresses dotted).
fn show(a: SocketAddress?) {
    var buffer = [0u8; 80];
    var w = TextWriter.create(mut buffer[..]);
    match (a) {
        Some(address) => { address.write(mut w); }
        null => { w.text("null"); }
    }
    match (StringView.fromUtf8(w.written())) {
        Some(t) => { Console.writeLine(t); }
        null => { Console.writeLine("not UTF-8"); }
    }
}

