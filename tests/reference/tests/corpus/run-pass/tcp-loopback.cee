// TcpListener and TcpStream over loopback (type-system.md §26), on one thread: the connection completes against the
// listen backlog before accept. Runs on every hosted target, Windows' Winsock included (c-backend.md §1.1, L1 A4a).
fn main() {
    let listener = TcpListener.bind("127.0.0.1", 0u16)!;
    let port = listener.port()!;
    Console.writeLine(port > 0u16);
    var client = TcpStream.connect("127.0.0.1", port)!;
    var server = listener.accept()!;
    client.write("ping".bytes())!;
    client.shutdownWrite()!;
    var got = [0u8; 16];
    let k = server.read(mut got[..])!;
    Console.writeBytes(got[..k]);
    Console.writeLine("");
    Console.writeLine(server.read(mut got[..])!); // the client shut down its side: end of stream
    server.write("pong".bytes())!;
    let m = client.read(mut got[..])!;
    Console.writeBytes(got[..m]);
    Console.writeLine("");
    match (TcpStream.connect("not an address", 1u16)) {
        Ok(_) => { Console.writeLine("unexpected"); }
        Err(e) => { Console.writeLine(e.message()); }
    }
}
// expect-stdout: true
// expect-stdout: ping
// expect-stdout: 0
// expect-stdout: pong
// expect-stdout: Invalid argument
