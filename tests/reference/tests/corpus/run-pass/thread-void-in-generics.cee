// A `Thread<void>` as a type argument (SQLite port finding 35): a thread's argument is its body's result, so
// `Thread<void>` has `void` where a return type may (type-system.md §20.4, §38.2), and an instance whose signature
// takes or returns one is no N0226. Before, every call whose signature named a `Thread<void>` was refused: a plain
// function returning one, `swapRemove`, `remove`, `pop` through a generic function, `HashMap.put` and `remove`,
// `SlotMap.insert`. Each thread is joined before the next line is printed, so the output is the program's order.
fn idle() {}

fn pass<T>(x: T) -> T => x;

fn lastOf<T>(v: borrow mut Vector<T>) -> T? => v.pop();

fn start() -> Thread<void> {
    match (Thread.spawn(move () => idle())) {
        Ok(t) => { return t; }
        Err(_) => { Process.exit(1); }
    }
}

fn main() {
    var threads = Vector<Thread<void>>.create();
    let _ = threads.push(start());
    let _ = threads.push(start());
    let _ = threads.insert(0, start());
    let first = threads.swapRemove(0);
    pass(first).join();
    Console.writeLine("swapRemove");
    let second = threads.remove(0);
    second.join();
    Console.writeLine("remove");
    match (lastOf(mut threads)) {
        Some(t) => {
            t.join();
            Console.writeLine("pop");
        }
        null => {}
    }
    Console.writeLine(threads.length);
    var byKey = HashMap<u32, Thread<void>>.create();
    let _ = byKey.put(1, start());
    let key: u32 = 1;
    match (byKey.remove(key)) {
        Some(t) => {
            t.join();
            Console.writeLine("HashMap");
        }
        null => {}
    }
    var slots = SlotMap<Thread<void>>.create();
    match (slots.insert(start())) {
        Ok(h) => {
            match (slots.remove(h)) {
                Some(t) => {
                    t.join();
                    Console.writeLine("SlotMap");
                }
                null => {}
            }
        }
        Err(_) => {}
    }
    let maybe: Thread<void>? = start();
    match (maybe) {
        Some(t) => {
            t.join();
            Console.writeLine("optional");
        }
        null => {}
    }
    var counts = Vector<Thread<u64>>.create();
    match (Thread.spawn(move () => 4u64)) {
        Ok(t) => { let _ = counts.push(t); }
        Err(_) => {}
    }
    Console.writeLine(counts.swapRemove(0).join());
}
// expect-stdout: swapRemove
// expect-stdout: remove
// expect-stdout: pop
// expect-stdout: 0
// expect-stdout: HashMap
// expect-stdout: SlotMap
// expect-stdout: optional
// expect-stdout: 4
