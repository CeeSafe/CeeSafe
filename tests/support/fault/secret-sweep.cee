// Allocation failure in a SecretHeap vector's growth (ADR 0197 §2.3, §4.3): tools/fault_sweep.py runs this once to
// count allocation attempts, then once per attempt with that attempt failing. SecretHeap grows by allocating a new
// block, copying and wiping the old one, never by `realloc`; a failed growth must come back as an AllocError with
// the old block live and unchanged (one attempt), and nothing may leak. The program checks every element pushed
// before the failure, then prints "consistent" and how far it got, or "consistent complete".

struct SweepKey {
    bytes: [u8; 16];
}

fn keyOf(n: u64) -> SweepKey {
    var bytes = [0u8; 16];
    for (i in 0..16usize) {
        bytes[i] = truncate<u8>(n * 7 + i as u64);
    }
    return SweepKey { bytes: bytes };
}

/// Whether `keys` holds exactly keys 0 to count - 1.
fn holds(keys: borrow Vector<SweepKey, SecretHeap>, count: u64) -> bool {
    if (keys.length as u64 != count) {
        return false;
    }
    for (k in 0..count) {
        let want = keyOf(k);
        for (i in 0..16usize) {
            if (keys[k as usize].bytes[i] != want.bytes[i]) {
                return false;
            }
        }
    }
    return true;
}

fn main() {
    var keys = Vector<SweepKey, SecretHeap>.create();
    var text = String<SecretHeap>.create();
    for (k in 0..100u64) {
        match (keys.push(keyOf(k))) {
            Ok() => {}
            Err(_) => {
                Console.write(if (holds(keys, k)) "consistent" else "inconsistent");
                Console.write(" keys ");
                Console.writeLine(k);
                return;
            }
        }
    }
    for (k in 0..40u64) {
        let before = text.length;
        match (text.append("a secret passphrase ")) {
            Ok() => {}
            Err(_) => {
                Console.write(if (text.length == before && holds(keys, 100)) "consistent" else "inconsistent");
                Console.write(" text ");
                Console.writeLine(k);
                return;
            }
        }
    }
    let box = match (Box.createIn(SecretHeap {}, keyOf(1))) {
        Ok(b) => b,
        Err(_) => {
            Console.writeLine(if (holds(keys, 100)) "consistent box" else "inconsistent box");
            return;
        }
    };
    Console.writeLine(if (holds(keys, 100) && text.length == 800 && box.bytes[0] == 7) "consistent complete"
        else "inconsistent complete");
}
